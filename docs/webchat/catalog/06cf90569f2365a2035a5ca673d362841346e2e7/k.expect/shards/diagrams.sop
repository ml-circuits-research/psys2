@k.expect.make.flowchart k.expect.make thing=flowchart made_in=diagram unit=node min=5 max=9 typical=7 kinds_min=2 kinds_max=3 layout=flow extent=default diagram=flowchart varies=count varies=kinds varies=colour about="a flowchart of k.diagrams: 5 to 9 nodes, drawn as oval, rectangle, diamond, parallelogram, document, double_rectangle, circle, cylinder, laid out flow, edges directed" core.source="hand-core 1"
@k.expect.part.flowchart.start k.expect.part of=flowchart part=start group=node min=1 max=1 typical=1 needed=yes shape=oval role=start core.source="hand-core 1"
@k.expect.part.flowchart.end k.expect.part of=flowchart part=end group=node min=1 max=1 typical=1 needed=yes shape=oval role=end core.source="hand-core 1"
