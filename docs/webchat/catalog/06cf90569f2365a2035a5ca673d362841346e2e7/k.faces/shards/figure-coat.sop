# script: tools/figures-core.mjs

# coat: jacket
@k.faces.figure.coat.jacket k.faces.variant slot=coat name=jacket style=figure length=short kind=jacket core.source="hand-core 1"
@k.faces.figure.coat.jacket.left_side k.faces.part slot=coat of=jacket name=left_side shape=polygon x=28 y=30 w=21 h=34 z=1 colour=brown colour=black colour=blue colour=green colour=grey colour=red rgb="#7A5230" core.source="hand-core 1"
