# k.faces/shards/figure-shoes: the variants of the slot `shoes` in the style `figure`: features, and parts with a primitive shape, a box in the frame of the figure, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/figures-core.mjs

# shoes: shoes
@k.faces.figure.shoes.shoes k.faces.variant slot=shoes name=shoes style=figure kind=shoes core.source="hand-core 1"
@k.faces.figure.shoes.shoes.left_shoe k.faces.part slot=shoes of=shoes name=left_shoe shape=oval x=37 y=88 w=12 h=5 z=1 colour=brown colour=black colour=red colour=white colour=blue rgb="#3A2A20" core.source="hand-core 1"
@k.faces.figure.shoes.shoes.right_shoe k.faces.part slot=shoes of=shoes name=right_shoe shape=oval x=51 y=88 w=12 h=5 z=1 colour=brown colour=black colour=red colour=white colour=blue rgb="#3A2A20" core.source="hand-core 1"

