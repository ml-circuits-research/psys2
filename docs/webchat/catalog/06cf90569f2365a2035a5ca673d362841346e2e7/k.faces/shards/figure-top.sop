# license: CC0-1.0
# script: tools/figures-core.mjs

# top: t-shirt
@k.faces.figure.top.t-shirt k.faces.variant slot=top name=t-shirt style=figure length=short kind=t-shirt core.source="hand-core 1"
@k.faces.figure.top.t-shirt.shirt k.faces.part slot=top of=t-shirt name=shirt shape=polygon x=33 y=31 w=34 h=31 z=1 colour=red tint=clothes core.source="hand-core 1"
