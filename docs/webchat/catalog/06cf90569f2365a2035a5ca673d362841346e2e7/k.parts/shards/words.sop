# k.parts/shards/words: the English words of k.parts (its types, keys and values), stored beside the world (owner's
# decision 2026-11-15 08:10); tools/build-catalog.mjs reads them as the world's own words.
# sources: hand-core 1 (written in this repository; the block at the end by tools/key-words.mjs)
# license: CC0-1.0
# script: none (hand-written); the block of word wires for keys: tools/key-words.mjs

# Words for the types and keys of this world.
@k.parts.word.whole core.word text=part text=parts text="made up of" text=consists means=k.parts.whole core.source="hand-core 1"
@k.parts.word.has core.word text=has text=have text=with means=k.parts.whole.has core.source="hand-core 1"
@k.parts.word.name core.word text="part name" text="name of a part" means=k.parts.name core.source="hand-core 1"
@k.parts.word.name.name core.word text=name means=k.parts.name.name core.source="hand-core 1"
@k.parts.word.name.of core.word text="part of" text=whole means=k.parts.name.of core.source="hand-core 1"
@k.parts.word.name.slot core.word text=slot text="drawn as" means=k.parts.name.slot core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@k.parts.word.key.whole.gloss core.word text=gloss means=k.parts.whole.gloss core.source="hand-core 1"
@k.parts.word.key.whole.has core.word text=built text=inside means=k.parts.whole.has core.source="hand-core 1"
@k.parts.word.key.whole.plain core.word text=plain text=has text=have means=k.parts.whole.plain core.source="hand-core 1"
@k.parts.word.key.inherited core.word text=part text=parts means=k.parts.inherited core.source="hand-core 1"
@k.parts.word.key.inherited.from core.word text=from means=k.parts.inherited.from core.source="hand-core 1"
@k.parts.word.key.inherited.steps core.word text=steps means=k.parts.inherited.steps core.source="hand-core 1"
@k.parts.word.key.inherited.has core.word text=has text=have text=with means=k.parts.inherited.has core.source="hand-core 1"
@k.parts.word.key.inherited.plain core.word text=plain means=k.parts.inherited.plain core.source="hand-core 1"
@k.parts.word.key.usual core.word text=part text=parts means=k.parts.usual core.source="hand-core 1"
@k.parts.word.key.usual.has core.word text=has text=have text=with text=built text=inside means=k.parts.usual.has core.source="hand-core 1"
@k.parts.word.key.usual.named core.word text=named means=k.parts.usual.named core.source="hand-core 1"
@k.parts.word.key.called.part core.word text=part means=k.parts.called.part core.source="hand-core 1"
@k.parts.word.key.called.also core.word text=also means=k.parts.called.also core.source="hand-core 1"
