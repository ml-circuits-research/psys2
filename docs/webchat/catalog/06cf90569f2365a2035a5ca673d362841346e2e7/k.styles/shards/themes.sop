@k.styles.role.flowchart.data k.styles.role theme=flowchart role=data fill="#d4e6ff" outline="#3e6db5" text="#132f5c" core.source="hand-core 1"
@k.styles.role.flowchart.document k.styles.role theme=flowchart role=document fill="#f3e3ff" outline="#8a5bb5" text="#3b1f52" core.source="hand-core 1"
@k.styles.role.flowchart.subprocess k.styles.role theme=flowchart role=subprocess fill="#e8eef7" outline="#3e5068" text="#1f2933" core.source="hand-core 1"
@k.styles.role.flowchart.database k.styles.role theme=flowchart role=database fill="#e0f2f1" outline="#2a7f78" text="#0f3936" core.source="hand-core 1"
@k.styles.role.flowchart.connector k.styles.role theme=flowchart role=connector fill="#ffffff" outline="#3e5068" text="#1f2933" core.source="hand-core 1"
