# k.styles/shards/themes: 11 colour themes (fill, outline, text, line, background, frame, label weight, line width), the colours of 8 roles in one of them, and 76 palette colours.
# sources: hand-core 1 (hand-written in this repository; palettes after common visualisation practice)
# license: CC0-1.0
# script: none (hand-written)

@k.styles.theme.classic k.styles.theme name=classic about="light blue shapes with slate outlines on a white page: the editor's own colours" fill="#dce8f8" outline="#3e5068" text="#1f2933" edge="#52606d" background="#ffffff" group="#f2f5fa" weight=normal width=2 core.source="hand-core 1"
@k.styles.theme.pastel k.styles.theme name=pastel about="soft light tints with gentle outlines" fill="#ece6f7" outline="#9b8ec4" text="#3d3553" edge="#8a8fa8" background="#fcfbff" group="#f4f1fb" weight=normal width=1.5 core.source="hand-core 1"
@k.styles.theme.dark k.styles.theme name=dark about="light text and lines on dark shapes and a dark page" fill="#2d3748" outline="#718096" text="#f7fafc" edge="#a0aec0" background="#1a202c" group="#252f3f" weight=normal width=2 core.source="hand-core 1"
@k.styles.theme.blueprint k.styles.theme name=blueprint about="white lines and text on deep blue, like an architect's blueprint" fill="#1f4f8f" outline="#e6f0ff" text="#ffffff" edge="#cfe3ff" background="#163a6b" group="#1b4580" weight=normal width=1.5 core.source="hand-core 1"
@k.styles.theme.monochrome k.styles.theme name=monochrome about="black and white: white shapes, black outlines, text and lines" fill="#ffffff" outline="#111111" text="#111111" edge="#111111" background="#ffffff" group="#f2f2f2" weight=normal width=1.5 core.source="hand-core 1"
@k.styles.theme.highlight k.styles.theme name=highlight about="a bright yellow fill with an amber outline and bold text, to make things stand out" fill="#fff3b0" outline="#e8a200" text="#3b2f00" edge="#e8a200" background="#ffffff" group="#fff9db" weight=bold width=3 core.source="hand-core 1"
@k.styles.theme.vivid k.styles.theme name=vivid about="strong distinct colours with white text" fill="#4e79a7" outline="#2f4b6c" text="#ffffff" edge="#3b4a5a" background="#ffffff" group="#eef2f7" weight=bold width=2 core.source="hand-core 1"
@k.styles.theme.ocean k.styles.theme name=ocean about="sea blues and teals" fill="#cce7f0" outline="#2b7a99" text="#08384d" edge="#2b7a99" background="#f2fafc" group="#e3f3f8" weight=normal width=2 core.source="hand-core 1"
@k.styles.theme.forest k.styles.theme name=forest about="leaf and moss greens" fill="#d8ead3" outline="#3b7a3b" text="#1e3d1e" edge="#4f7f4f" background="#f5faf3" group="#e9f3e6" weight=normal width=2 core.source="hand-core 1"
@k.styles.theme.sunset k.styles.theme name=sunset about="warm oranges and reds" fill="#ffe0cc" outline="#d9603b" text="#4a1f0e" edge="#c0583a" background="#fff8f2" group="#fff0e5" weight=normal width=2 core.source="hand-core 1"
@k.styles.theme.flowchart k.styles.theme name=flowchart about="the classic colours with a colour for each flowchart role: green terminals, amber decisions, blue data" fill="#e8eef7" outline="#3e5068" text="#1f2933" edge="#52606d" background="#ffffff" group="#f2f5fa" weight=normal width=2 core.source="hand-core 1"
@k.styles.role.flowchart.start k.styles.role theme=flowchart role=start fill="#c6f0c2" outline="#2f8a3e" text="#173d1c" core.source="hand-core 1"
@k.styles.role.flowchart.end k.styles.role theme=flowchart role=end fill="#c6f0c2" outline="#2f8a3e" text="#173d1c" core.source="hand-core 1"
