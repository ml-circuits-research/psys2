# w.drawing: a drawing made of placed objects, each a kind of k.objects (or a basic shape), with groups and edits of parts
# sources: hand-core 1 (own project declarations; sources/hand-core/SOURCE.md)
# license: CC0-1.0
# script: none (hand-written)
# needs: pinned sopworld std.schema/std.acts; no new runtime capability

@w.drawing core.module name=w.drawing version=1 exports=object exports=group exports=part core.source="hand-core 1"
@w.drawing.world std.schema.world name=w.drawing doc="a drawing of placed objects with sizes, colours, labels, groups and edited parts" core.source="hand-core 1"

# An object on the page. `code` is the identifier tools and people use ("o1"); `drawing` names a k.objects object or a
# basic shape; `x` and `y` are its centre in page units, `size` its larger extent; `width` and `height`, when
# given, override the shape's own proportions. `colour` paints the parts that take a colour; `z` orders drawing.
# `look` (many): the w.face faces the object is drawn with, over its drawing: a person's face (style plain, on the part
# that bears a face: its head) and its figure (style figure: its body and clothes, k.faces.frame), or a face put on a
# thing (eyes on the sun's disc). `seed`: the number a host picks a look by when nothing asks for one (two people of
# one kind look different; a "different" one takes another seed); when absent, the host uses `z`.
@w.drawing.object core.type of=w.drawing.object extends=std.schema.thing closed=true core.source="hand-core 1"
@w.drawing.object.code core.slot of=w.drawing.object key=code required=true kind=atom kind=string core.source="hand-core 1"
@w.drawing.object.drawing core.slot of=w.drawing.object key=drawing required=true kind=atom kind=string core.source="hand-core 1"
@w.drawing.object.x core.slot of=w.drawing.object key=x required=true kind=number core.source="hand-core 1"
@w.drawing.object.y core.slot of=w.drawing.object key=y required=true kind=number core.source="hand-core 1"
@w.drawing.object.size core.slot of=w.drawing.object key=size required=true kind=number min=1 core.source="hand-core 1"
@w.drawing.object.width core.slot of=w.drawing.object key=width kind=number min=1 core.source="hand-core 1"
@w.drawing.object.height core.slot of=w.drawing.object key=height kind=number min=1 core.source="hand-core 1"
@w.drawing.object.colour core.slot of=w.drawing.object key=colour kind=atom kind=string core.source="hand-core 1"
@w.drawing.object.label core.slot of=w.drawing.object key=label kind=string core.source="hand-core 1"
@w.drawing.object.name core.slot of=w.drawing.object key=name kind=string core.source="hand-core 1"
@w.drawing.object.z core.slot of=w.drawing.object key=z kind=integer core.source="hand-core 1"
@w.drawing.object.look core.slot of=w.drawing.object key=look type=w.face.face many=true core.source="hand-core 1"
@w.drawing.object.seed core.slot of=w.drawing.object key=seed kind=integer core.source="hand-core 1"

# A group keeps objects together under one code.
@w.drawing.group core.type of=w.drawing.group extends=std.schema.thing closed=true core.source="hand-core 1"
@w.drawing.group.code core.slot of=w.drawing.group key=code required=true kind=atom kind=string core.source="hand-core 1"
@w.drawing.group.member core.slot of=w.drawing.group key=member type=w.drawing.object many=true core.source="hand-core 1"
@w.drawing.group.label core.slot of=w.drawing.group key=label kind=string core.source="hand-core 1"

# An edited part of an object: the part at `index` (in the order its kind draws them) recoloured, moved,
# resized, reshaped or removed. `shape` draws the part with another outline in its box: a basic shape of k.shapes
# (circle, oval, rectangle, triangle) or an outline of k.layouts (irregular, wavy, star). A part the drawing does not
# have is added with `drawing` (the k.objects drawing it draws, at an index after the drawing's own parts) and
# `anchor` (the k.layouts anchor of the object's kind it sits at: a chimney on the roof).
@w.drawing.part core.type of=w.drawing.part extends=std.schema.thing closed=true core.source="hand-core 1"
@w.drawing.part.object core.slot of=w.drawing.part key=object required=true type=w.drawing.object core.source="hand-core 1"
@w.drawing.part.index core.slot of=w.drawing.part key=index required=true kind=integer min=0 core.source="hand-core 1"
@w.drawing.part.colour core.slot of=w.drawing.part key=colour kind=atom kind=string core.source="hand-core 1"
@w.drawing.part.dx core.slot of=w.drawing.part key=dx kind=number core.source="hand-core 1"
@w.drawing.part.dy core.slot of=w.drawing.part key=dy kind=number core.source="hand-core 1"
@w.drawing.part.width core.slot of=w.drawing.part key=width kind=number min=0 core.source="hand-core 1"
@w.drawing.part.height core.slot of=w.drawing.part key=height kind=number min=0 core.source="hand-core 1"
@w.drawing.part.removed core.slot of=w.drawing.part key=removed kind=boolean core.source="hand-core 1"
@w.drawing.part.shape core.slot of=w.drawing.part key=shape kind=atom kind=string core.source="hand-core 1"
@w.drawing.part.drawing core.slot of=w.drawing.part key=drawing kind=atom kind=string core.source="hand-core 1"
@w.drawing.part.anchor core.slot of=w.drawing.part key=anchor kind=atom kind=string core.source="hand-core 1"

# One thing of each kind per code; one edit per part of an object.
@w.drawing.code.first std.schema.thing kind=?kind code=?code
@w.drawing.code.second std.schema.thing kind=?kind code=?code
@w.drawing.code.other core.check fn=neq args=$w.drawing.code.first args=$w.drawing.code.second
@w.drawing.code.unique core.deny when=$w.drawing.code.first when=$w.drawing.code.second if=$w.drawing.code.other why="The code ?code is already used by another ?kind." core.source="hand-core 1"
@w.drawing.edit.first w.drawing.part object=?o index=?i
@w.drawing.edit.second w.drawing.part object=?o index=?i
@w.drawing.edit.other core.check fn=neq args=$w.drawing.edit.first args=$w.drawing.edit.second
@w.drawing.edit.unique core.deny when=$w.drawing.edit.first when=$w.drawing.edit.second if=$w.drawing.edit.other why="That part already has its edit." core.source="hand-core 1"

@w.drawing.kind.object std.schema.kind of=w.drawing.object world=w.drawing acts=make acts=remove acts=change acts=place acts=pick acts=ask acts=group core.source="hand-core 1"
@w.drawing.kind.group std.schema.kind of=w.drawing.group world=w.drawing acts=make acts=remove acts=change acts=pick acts=ask core.source="hand-core 1"
@w.drawing.kind.part std.schema.kind of=w.drawing.part world=w.drawing acts=make acts=remove acts=change core.source="hand-core 1"
@w.drawing.limit.object std.schema.limit of=w.drawing.object max=2000 core.source="hand-core 1"
