# making tea
@k.procedures.howto.making_tea k.procedures.howto name="making tea" about="a cup of tea with a tea bag, as it is usually made" basis=own core.source="hand-core 1"
@k.procedures.howto_step.making_tea.1 k.procedures.howto_step howto="making tea" n=1 about="Boil water" role=process core.source="hand-core 1"
@k.procedures.howto_step.making_tea.2 k.procedures.howto_step howto="making tea" n=2 about="Put a tea bag in a cup" role=process after=1 core.source="hand-core 1"
@k.procedures.howto_step.making_tea.3 k.procedures.howto_step howto="making tea" n=3 about="Pour the hot water into the cup" role=process after=2 core.source="hand-core 1"
@k.procedures.howto_step.making_tea.4 k.procedures.howto_step howto="making tea" n=4 about="Let it steep for a few minutes" role=process after=3 core.source="hand-core 1"
@k.procedures.howto_step.making_tea.5 k.procedures.howto_step howto="making tea" n=5 about="Take out the tea bag" role=process after=4 core.source="hand-core 1"
@k.procedures.howto_step.making_tea.6 k.procedures.howto_step howto="making tea" n=6 about="Milk or sugar?" role=decision after=5 core.source="hand-core 1"
@k.procedures.howto_step.making_tea.7 k.procedures.howto_step howto="making tea" n=7 about="Add milk or sugar" role=process after=6 branch=yes core.source="hand-core 1"
@k.procedures.howto_step.making_tea.8 k.procedures.howto_step howto="making tea" n=8 about="Drink the tea" role=process after=6 after=7 branch=no core.source="hand-core 1"
