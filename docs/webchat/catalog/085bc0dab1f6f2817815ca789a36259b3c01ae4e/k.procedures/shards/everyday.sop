# washing hands
@k.procedures.howto.washing_hands k.procedures.howto name="washing hands" about="washing hands with soap and water, in the five steps of the CDC (wet, lather, scrub, rinse, dry)" basis=cited cite="Centers for Disease Control and Prevention (CDC), \"When and How to Wash Your Hands\", Handwashing in Community Settings (2023)" core.source="hand-core 1"
@k.procedures.howto_step.washing_hands.1 k.procedures.howto_step howto="washing hands" n=1 about="Wet your hands" role=process detail="Wet your hands with clean, running water (warm or cold), turn off the tap, and apply soap." core.source="hand-core 1"
@k.procedures.howto_step.washing_hands.2 k.procedures.howto_step howto="washing hands" n=2 about="Lather with soap" role=process after=1 detail="Lather your hands by rubbing them together with the soap. Lather the backs of your hands, between your fingers, and under your nails." core.source="hand-core 1"
@k.procedures.howto_step.washing_hands.3 k.procedures.howto_step howto="washing hands" n=3 about="Scrub for 20 seconds" role=process after=2 detail="Scrub your hands for at least 20 seconds." core.source="hand-core 1"
@k.procedures.howto_step.washing_hands.4 k.procedures.howto_step howto="washing hands" n=4 about="Rinse your hands" role=process after=3 detail="Rinse your hands well under clean, running water." core.source="hand-core 1"
@k.procedures.howto_step.washing_hands.5 k.procedures.howto_step howto="washing hands" n=5 about="Dry your hands" role=process after=4 detail="Dry your hands using a clean towel or an air dryer." core.source="hand-core 1"
@k.procedures.word.howto.washing_hands core.word text="washing your hands" text=handwashing text="hand washing" text="how to wash your hands" text="how to wash hands" means="washing hands" of=k.procedures.howto.name core.source="hand-core 1"

# planting a seed
@k.procedures.howto.planting_a_seed k.procedures.howto name="planting a seed" about="a seed sown in a pot, as it is usually done" basis=own core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.1 k.procedures.howto_step howto="planting a seed" n=1 about="Fill a pot with soil" role=process core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.2 k.procedures.howto_step howto="planting a seed" n=2 about="Make a small hole in the soil" role=process after=1 core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.3 k.procedures.howto_step howto="planting a seed" n=3 about="Put the seed in the hole" role=process after=2 core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.4 k.procedures.howto_step howto="planting a seed" n=4 about="Cover the seed with soil" role=process after=3 core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.5 k.procedures.howto_step howto="planting a seed" n=5 about="Water the soil" role=process after=4 core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.6 k.procedures.howto_step howto="planting a seed" n=6 about="Put the pot in a warm, light place" role=process after=5 core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.7 k.procedures.howto_step howto="planting a seed" n=7 about="Is the soil dry?" role=decision after=6 core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.8 k.procedures.howto_step howto="planting a seed" n=8 about="Water the soil again" role=process after=7 branch=yes core.source="hand-core 1"
@k.procedures.howto_step.planting_a_seed.9 k.procedures.howto_step howto="planting a seed" n=9 about="Wait for the seed to sprout" role=process after=7 after=8 branch=no core.source="hand-core 1"
