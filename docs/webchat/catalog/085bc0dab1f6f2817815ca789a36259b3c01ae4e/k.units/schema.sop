# k.units: units of measure: what each unit measures, and how to convert it: a value in the unit, times `factor`,
# plus `offset` (temperatures only), is the value in the base unit of its quantity. And, for the numbers of the
# other knowledge worlds, which unit each number is in (k.units.measure), so that numbers can be compared and drawn.
# sources: hand-core 1 (hand-written in this repository); cldr 48 (the currencies: shard currencies)
# license: CC0-1.0
# script: none (hand-written)

@k.units core.module name=k.units version=2 exports=quantity exports=unit exports=measure exports=currency core.source="hand-core 1"

# What is measured (length, mass, ...), and the unit every other unit of it converts to.
@k.units.quantity core.type of=k.units.quantity shared=true closed=true core.source="hand-core 1"
@k.units.quantity.name core.slot of=k.units.quantity key=name id=true required=true kind=atom core.source="hand-core 1"
@k.units.quantity.base core.slot of=k.units.quantity key=base required=true kind=atom kind=string type=k.units.unit by=name core.source="hand-core 1"

# A unit. base value = value * factor + offset. `system` says where it is used.
@k.units.unit core.type of=k.units.unit shared=true closed=true core.source="hand-core 1"
@k.units.unit.name core.slot of=k.units.unit key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.units.unit.symbol core.slot of=k.units.unit key=symbol kind=atom kind=string core.source="hand-core 1"
@k.units.unit.quantity core.slot of=k.units.unit key=quantity required=true kind=atom type=k.units.quantity by=name core.source="hand-core 1"
@k.units.unit.factor core.slot of=k.units.unit key=factor required=true kind=number core.source="hand-core 1"
@k.units.unit.offset core.slot of=k.units.unit key=offset kind=number core.source="hand-core 1"
@k.units.unit.system core.slot of=k.units.unit key=system enum=metric enum=imperial enum=other core.source="hand-core 1"


# In which unit a number of another world is given (Round 9). `world`, `type` and `key` name the slot (`k.geo`,
# `mountain`, `elevation`); `unit` names a k.units.unit (`metre`). A number that counts things has `counts` instead
# (the kind of thing counted: `person`, `leg`, `moon`); a number that is a place in an order has `ordinal=true`
# (the third planet from the Sun, the draw order of a part); a position or a length in a frame of coordinates that
# runs from 0 to 100 has `frame`, the name of the frame (`object`: the frame of a k.objects drawing); a number that
# is itself what is meant (the value of a number word) has `plain=true`. `approximate=true` says that the value is
# only about right (a key with the suffix `_about`). One fact per numeric slot of every knowledge world.
@k.units.measure core.type of=k.units.measure shared=true closed=true core.source="hand-core 1"
@k.units.measure.world core.slot of=k.units.measure key=world id=true required=true kind=atom core.source="hand-core 1"
@k.units.measure.type core.slot of=k.units.measure key=type id=true required=true kind=atom core.source="hand-core 1"
@k.units.measure.key core.slot of=k.units.measure key=key id=true required=true kind=atom core.source="hand-core 1"
@k.units.measure.unit core.slot of=k.units.measure key=unit kind=atom kind=string type=k.units.unit by=name core.source="hand-core 1"
@k.units.measure.counts core.slot of=k.units.measure key=counts kind=atom kind=string core.source="hand-core 1"
@k.units.measure.frame core.slot of=k.units.measure key=frame kind=atom kind=string core.source="hand-core 1"
@k.units.measure.plain core.slot of=k.units.measure key=plain kind=boolean core.source="hand-core 1"
@k.units.measure.ordinal core.slot of=k.units.measure key=ordinal kind=boolean core.source="hand-core 1"
@k.units.measure.approximate core.slot of=k.units.measure key=approximate kind=boolean core.source="hand-core 1"
@k.units.measure.both.unit k.units.measure world=?world type=?type key=?key unit=?unit
@k.units.measure.both.counts k.units.measure world=?world type=?type key=?key counts=?thing
@k.units.measure.both core.deny when=$k.units.measure.both.unit when=$k.units.measure.both.counts why="The number ?key of ?world ?type is said both to be in ?unit and to count ?thing." core.source="hand-core 1"

# A currency (block 03:20 item 3), by its ISO 4217 `code` (USD, EUR, GBP, RON): `name` and `name_plural` (US dollar,
# US dollars), the everyday `unit` and `unit_plural` (dollar, dollars; leu, lei), its `symbol` ($, €, £; the one
# English text uses, never the code) and `narrow` symbol (the short sign where it differs: $ for the Canadian dollar),
# `decimals` (the digits after the point: 2, 0 for the yen), the `minor` unit and `minor_plural` (cent, cents; penny,
# pence; ban, bani) where a source names them, and the countries that use it (`country`, names of k.geo countries).
# A currency has no factor: the value of money in another currency changes every day and is no fact here. Everyday
# names (buck, quid, greenback) and the usual reading of a unit word alone (dollar: the US dollar) are core.word facts.
@k.units.currency core.type of=k.units.currency shared=true closed=true core.source="hand-core 1"
@k.units.currency.code core.slot of=k.units.currency key=code id=true required=true kind=atom core.source="hand-core 1"
@k.units.currency.name core.slot of=k.units.currency key=name kind=atom kind=string core.source="hand-core 1"
@k.units.currency.name_plural core.slot of=k.units.currency key=name_plural kind=atom kind=string core.source="hand-core 1"
@k.units.currency.unit core.slot of=k.units.currency key=unit kind=atom kind=string core.source="hand-core 1"
@k.units.currency.unit_plural core.slot of=k.units.currency key=unit_plural kind=atom kind=string core.source="hand-core 1"
@k.units.currency.symbol core.slot of=k.units.currency key=symbol kind=atom kind=string core.source="hand-core 1"
@k.units.currency.narrow core.slot of=k.units.currency key=narrow kind=atom kind=string core.source="hand-core 1"
@k.units.currency.decimals core.slot of=k.units.currency key=decimals kind=integer min=0 max=4 core.source="hand-core 1"
@k.units.currency.minor core.slot of=k.units.currency key=minor kind=atom kind=string core.source="hand-core 1"
@k.units.currency.minor_plural core.slot of=k.units.currency key=minor_plural kind=atom kind=string core.source="hand-core 1"
@k.units.currency.country core.slot of=k.units.currency key=country many=true kind=atom kind=string type=k.geo.country by=name core.source="hand-core 1"

# Words for the types and keys of this world.
@k.units.word.unit core.word text=unit text=units text=measure means=k.units.unit core.source="hand-core 1"
@k.units.word.currency core.word text=currency text=currencies text=money means=k.units.currency core.source="hand-core 1"
@k.units.word.symbol core.word text=symbol text=abbreviation means=k.units.unit.symbol core.source="hand-core 1"
@k.units.word.factor core.word text=convert text=conversion text=factor means=k.units.unit.factor core.source="hand-core 1"
@k.units.word.quantity core.word text=quantity text=measures means=k.units.unit.quantity core.source="hand-core 1"
@k.units.word.measure core.word text=measured text="in which unit" means=k.units.measure core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@k.units.word.key.quantity core.word text=quantity means=k.units.quantity core.source="hand-core 1"
@k.units.word.key.quantity.base core.word text=base means=k.units.quantity.base core.source="hand-core 1"
@k.units.word.key.unit.quantity core.word text=measure text=kind means=k.units.unit.quantity core.source="hand-core 1"
@k.units.word.key.unit.offset core.word text=offset means=k.units.unit.offset core.source="hand-core 1"
@k.units.word.key.unit.system core.word text=system means=k.units.unit.system core.source="hand-core 1"
@k.units.word.key.measure.type core.word text=type means=k.units.measure.type core.source="hand-core 1"
@k.units.word.key.measure.key core.word text=key means=k.units.measure.key core.source="hand-core 1"
@k.units.word.key.measure.unit core.word text=unit means=k.units.measure.unit core.source="hand-core 1"
@k.units.word.key.measure.counts core.word text=counts means=k.units.measure.counts core.source="hand-core 1"
@k.units.word.key.measure.frame core.word text=frame means=k.units.measure.frame core.source="hand-core 1"
@k.units.word.key.measure.plain core.word text=plain means=k.units.measure.plain core.source="hand-core 1"
@k.units.word.key.measure.ordinal core.word text=ordinal means=k.units.measure.ordinal core.source="hand-core 1"
@k.units.word.key.measure.approximate core.word text=approximate means=k.units.measure.approximate core.source="hand-core 1"
@k.units.word.key.currency.name core.word text=name means=k.units.currency.name core.source="hand-core 1"
@k.units.word.key.currency.name_plural core.word text="name plural" means=k.units.currency.name_plural core.source="hand-core 1"
@k.units.word.key.currency.unit core.word text=unit text=money means=k.units.currency.unit core.source="hand-core 1"
@k.units.word.key.currency.unit_plural core.word text="unit plural" means=k.units.currency.unit_plural core.source="hand-core 1"
@k.units.word.key.currency.symbol core.word text=symbol text=sign means=k.units.currency.symbol core.source="hand-core 1"
@k.units.word.key.currency.narrow core.word text=narrow means=k.units.currency.narrow core.source="hand-core 1"
@k.units.word.key.currency.decimals core.word text=decimals means=k.units.currency.decimals core.source="hand-core 1"
@k.units.word.key.currency.minor core.word text=minor text=cent text=cents means=k.units.currency.minor core.source="hand-core 1"
@k.units.word.key.currency.minor_plural core.word text="minor plural" means=k.units.currency.minor_plural core.source="hand-core 1"
@k.units.word.key.currency.country core.word text=country text=where text=used means=k.units.currency.country core.source="hand-core 1"
