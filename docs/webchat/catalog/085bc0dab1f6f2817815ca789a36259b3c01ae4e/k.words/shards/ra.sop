@k.words.ra.noun.1 k.words.sense word=Ra pos=noun n=1 supersense=noun.substance gloss="an intensely radioactive metallic element that occurs in minute amounts in uranium ores" synonym=radium synonym="atomic number 88" is_a="metallic element" core.source="wordnet 3.1"
