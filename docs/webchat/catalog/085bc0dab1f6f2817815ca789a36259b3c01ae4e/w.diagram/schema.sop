# w.diagram: a reusable world: diagrams of nodes, edges and groups (a flowchart of a recipe, the life cycle of a frog
# as a cycle, a tree of kinds of animals, a Venn diagram of what cats and dogs share, a mind map of a topic). Declared
# as data in the library's std.schema format; the acts of std.acts drive it; it has no rule and no function of its
# own. What each kind of diagram is (its structure, layout, shapes and the knowledge that fills it) is k.diagrams'.
# sources: hand-core 1 (hand-written in this repository; block "04:40")
# license: CC0-1.0
# script: none (hand-written)
# needs: sopworld with std.schema and std.acts (tools/sopworld/VERSION)

@w.diagram core.module name=w.diagram version=1 exports=diagram exports=node exports=edge exports=group core.source="hand-core 1"
@w.diagram.world std.schema.world name=w.diagram doc="diagrams of nodes joined by edges, in groups, laid out by the diagram's kind" core.source="hand-core 1"

# A diagram. `title` what it shows; `form` its kind (the names of k.diagrams.kind form=: flowchart, tree, cycle, timeline,
# mind_map, venn, org_chart, network, pipeline, table; not `kind`, which the act `make` reads as the kind of thing to
# make); `layout` how its nodes are laid out (top_down, left_right, radial, circular, grid, overlapping, free); `topic`
# what the diagram is about (a name of the catalog: frog, water cycle).
@w.diagram.diagram core.type of=w.diagram.diagram extends=std.schema.thing closed=true core.source="hand-core 1"
@w.diagram.diagram.title core.slot of=w.diagram.diagram key=title kind=atom kind=string core.source="hand-core 1"
@w.diagram.diagram.form core.slot of=w.diagram.diagram key=form enum=flowchart enum=tree enum=cycle enum=timeline enum=mind_map enum=venn enum=org_chart enum=network enum=pipeline enum=table default=flowchart core.source="hand-core 1"
@w.diagram.diagram.layout core.slot of=w.diagram.diagram key=layout enum=top_down enum=left_right enum=radial enum=circular enum=grid enum=overlapping enum=free core.source="hand-core 1"
@w.diagram.diagram.topic core.slot of=w.diagram.diagram key=topic kind=atom kind=string core.source="hand-core 1"

# A node: `label` its text, `diagram` its diagram, `role` what it is in the diagram (a flowchart's start, end, process,
# decision, data, document, subprocess, connector; a tree's root and item; a cycle's stage; a timeline's event; a mind
# map's centre and branch; a Venn diagram's item; an org chart's post; a network's node; a table's row, column, cell);
# `shape` how it is drawn (k.diagrams.shape gives the usual one for each kind and role); `parent` the node it hangs
# from (a tree, an org chart, a mind map); `group` the groups it is in (a Venn diagram's sets: one or several); `n` its
# place in order (a step, a stage, an event), from 1; `x`, `y` where the layout put it; `colour`.
@w.diagram.node core.type of=w.diagram.node extends=std.schema.thing closed=true core.source="hand-core 1"
@w.diagram.node.label core.slot of=w.diagram.node key=label required=true kind=atom kind=string core.source="hand-core 1"
@w.diagram.node.diagram core.slot of=w.diagram.node key=diagram type=w.diagram.diagram core.source="hand-core 1"
@w.diagram.node.role core.slot of=w.diagram.node key=role enum=start enum=end enum=process enum=decision enum=data enum=document enum=subprocess enum=connector enum=root enum=item enum=stage enum=event enum=centre enum=branch enum=post enum=node enum=row enum=column enum=cell core.source="hand-core 1"
@w.diagram.node.shape core.slot of=w.diagram.node key=shape enum=oval enum=rectangle enum=rounded_rectangle enum=diamond enum=parallelogram enum=document enum=double_rectangle enum=circle enum=ellipse enum=dot enum=chevron core.source="hand-core 1"
@w.diagram.node.parent core.slot of=w.diagram.node key=parent type=w.diagram.node core.source="hand-core 1"
@w.diagram.node.group core.slot of=w.diagram.node key=group many=true type=w.diagram.group core.source="hand-core 1"
@w.diagram.node.n core.slot of=w.diagram.node key=n kind=integer min=1 step=1 core.source="hand-core 1"
@w.diagram.node.x core.slot of=w.diagram.node key=x kind=number core.source="hand-core 1"
@w.diagram.node.y core.slot of=w.diagram.node key=y kind=number core.source="hand-core 1"
@w.diagram.node.colour core.slot of=w.diagram.node key=colour kind=atom kind=string core.source="hand-core 1"

# An edge from one node to another: `label` what the link says (yes, no, then, eats), `direction` forward (an arrow from
# `from` to `to`; the default), both, or none (a line: a tree's branch, a network's link); `diagram` its diagram.
@w.diagram.edge core.type of=w.diagram.edge extends=std.schema.thing closed=true core.source="hand-core 1"
@w.diagram.edge.from core.slot of=w.diagram.edge key=from required=true type=w.diagram.node core.source="hand-core 1"
@w.diagram.edge.to core.slot of=w.diagram.edge key=to required=true type=w.diagram.node core.source="hand-core 1"
@w.diagram.edge.label core.slot of=w.diagram.edge key=label kind=atom kind=string core.source="hand-core 1"
@w.diagram.edge.direction core.slot of=w.diagram.edge key=direction enum=forward enum=both enum=none default=forward core.source="hand-core 1"
@w.diagram.edge.diagram core.slot of=w.diagram.edge key=diagram type=w.diagram.diagram core.source="hand-core 1"

# A group of nodes drawn as one shape around them (a set of a Venn diagram, a lane, a cluster): `label`, `diagram`,
# `shape` (circle, ellipse, rectangle, rounded_rectangle), `parent` the group it lies in (nested groups).
@w.diagram.group core.type of=w.diagram.group extends=std.schema.thing closed=true core.source="hand-core 1"
@w.diagram.group.label core.slot of=w.diagram.group key=label required=true kind=atom kind=string core.source="hand-core 1"
@w.diagram.group.diagram core.slot of=w.diagram.group key=diagram type=w.diagram.diagram core.source="hand-core 1"
@w.diagram.group.shape core.slot of=w.diagram.group key=shape enum=circle enum=ellipse enum=rectangle enum=rounded_rectangle default=circle core.source="hand-core 1"
@w.diagram.group.parent core.slot of=w.diagram.group key=parent type=w.diagram.group core.source="hand-core 1"

# The kinds and the acts that apply to them. At most 20 diagrams, 500 nodes, 1,000 edges and 100 groups.
@w.diagram.kind.diagram std.schema.kind of=w.diagram.diagram world=w.diagram acts=make acts=remove acts=change acts=pick acts=ask acts=copy core.source="hand-core 1"
@w.diagram.kind.node std.schema.kind of=w.diagram.node world=w.diagram acts=make acts=remove acts=change acts=place acts=connect acts=group acts=pick acts=ask acts=copy core.source="hand-core 1"
@w.diagram.kind.edge std.schema.kind of=w.diagram.edge world=w.diagram acts=make acts=remove acts=change acts=pick acts=ask core.source="hand-core 1"
@w.diagram.kind.group std.schema.kind of=w.diagram.group world=w.diagram acts=make acts=remove acts=change acts=pick acts=ask acts=copy core.source="hand-core 1"
@w.diagram.limit.diagram std.schema.limit of=w.diagram.diagram max=20 core.source="hand-core 1"
@w.diagram.limit.node std.schema.limit of=w.diagram.node max=500 core.source="hand-core 1"
@w.diagram.limit.edge std.schema.limit of=w.diagram.edge max=1000 core.source="hand-core 1"
@w.diagram.limit.group std.schema.limit of=w.diagram.group max=100 core.source="hand-core 1"

# Words: for the world (how a host finds it by name), its kinds and its keys.
@w.diagram.word.world core.word text=diagram text=diagrams text=flowchart text="flow chart" text="cycle diagram" text="tree diagram" text="mind map" text="venn diagram" text="org chart" text="organisation chart" text="organization chart" text="network diagram" text="process diagram" text="concept map" means=w.diagram of=std.schema.world.name core.source="hand-core 1"
@w.diagram.word.diagram core.word text=diagram text=diagrams text=flowchart text=scheme means=w.diagram.diagram core.source="hand-core 1"
@w.diagram.word.node core.word text=node text=nodes text=box text=boxes text=step text=steps text=stage text=stages text=bubble text=bubbles means=w.diagram.node core.source="hand-core 1"
@w.diagram.word.edge core.word text=edge text=edges text=arrow text=arrows text=link text=links text=line text=lines text=connector means=w.diagram.edge core.source="hand-core 1"
@w.diagram.word.group core.word text=group text=groups text=set text=sets text=cluster text=lane means=w.diagram.group core.source="hand-core 1"
@w.diagram.word.title core.word text=title text=called text=name means=w.diagram.diagram.title core.source="hand-core 1"
@w.diagram.word.form core.word text=kind text=type text=form means=w.diagram.diagram.form core.source="hand-core 1"
@w.diagram.word.layout core.word text=layout text=arrangement text=arranged text=direction means=w.diagram.diagram.layout core.source="hand-core 1"
@w.diagram.word.topic core.word text=topic text=about text=subject means=w.diagram.diagram.topic core.source="hand-core 1"
@w.diagram.word.label core.word text=label text=text text=says text=called means=w.diagram.node.label core.source="hand-core 1"
@w.diagram.word.node.diagram core.word text=on text=in text=belongs means=w.diagram.node.diagram core.source="hand-core 1"
@w.diagram.word.role core.word text=role text=start text=end text=decision text=process means=w.diagram.node.role core.source="hand-core 1"
@w.diagram.word.shape core.word text=shape text=oval text=diamond text=rectangle text=circle means=w.diagram.node.shape core.source="hand-core 1"
@w.diagram.word.parent core.word text=parent text=under text=below means=w.diagram.node.parent core.source="hand-core 1"
@w.diagram.word.node.group core.word text=in text=inside text=member means=w.diagram.node.group core.source="hand-core 1"
@w.diagram.word.n core.word text=place text=position text=order text=number means=w.diagram.node.n core.source="hand-core 1"
@w.diagram.word.x core.word text=x text=horizontal means=w.diagram.node.x core.source="hand-core 1"
@w.diagram.word.y core.word text=y text=vertical means=w.diagram.node.y core.source="hand-core 1"
@w.diagram.word.colour core.word text=colour text=color means=w.diagram.node.colour core.source="hand-core 1"
@w.diagram.word.from core.word text=from text=start means=w.diagram.edge.from core.source="hand-core 1"
@w.diagram.word.to core.word text=to text=end means=w.diagram.edge.to core.source="hand-core 1"
@w.diagram.word.edge.label core.word text=label text=says means=w.diagram.edge.label core.source="hand-core 1"
@w.diagram.word.direction core.word text=direction text=arrow text=both text=undirected means=w.diagram.edge.direction core.source="hand-core 1"
@w.diagram.word.edge.diagram core.word text=on text=in means=w.diagram.edge.diagram core.source="hand-core 1"
@w.diagram.word.group.label core.word text=label text=called text=name means=w.diagram.group.label core.source="hand-core 1"
@w.diagram.word.group.diagram core.word text=on text=in means=w.diagram.group.diagram core.source="hand-core 1"
@w.diagram.word.group.shape core.word text=shape text=circle text=ellipse means=w.diagram.group.shape core.source="hand-core 1"
@w.diagram.word.group.parent core.word text=inside text=within means=w.diagram.group.parent core.source="hand-core 1"
