# w.lang.en/shards/replies: what the assistant says back (reviewer block 14:25 item 2: real, the owner read a machine-translated
# reply): done (drew, added, moved, removed, changed N things, in the shape of X, connected, undid), not understood naming the
# unread words, did you mean, and the answers to a greeting, thanks and a goodbye; first person, informal singular. The same
# names (counts: CLDR plural categories) as the replies of the other language worlds, so a host picks by language.
# sources: hand-core 1 (written by hand in this repository)
# license: CC0-1.0
# script: none (hand-written)

@w.lang.en.reply.done.make.one w.lang.en.reply name=done.make count=one act=make role=kind text="I drew a {kind}." example="I drew a house." core.source="hand-core 1"
@w.lang.en.reply.done.make.other w.lang.en.reply name=done.make count=other act=make role=kind role=number text="I drew {number} {kind:num=pl}." example="I drew 3 houses." core.source="hand-core 1"
@w.lang.en.reply.done.make.value.one w.lang.en.reply name=done.make.value count=one act=make role=kind role=value text="I drew a {value} {kind}." example="I drew a red house." core.source="hand-core 1"
@w.lang.en.reply.done.make.value.other w.lang.en.reply name=done.make.value count=other act=make role=kind role=number role=value text="I drew {number} {value} {kind:num=pl}." example="I drew 3 red houses." core.source="hand-core 1"
@w.lang.en.reply.done.make.shape.one w.lang.en.reply name=done.make.shape count=one act=make role=kind role=shape text="I drew a {kind} in the shape of a {shape}." example="I drew a cloud in the shape of a heart." core.source="hand-core 1"
@w.lang.en.reply.done.add.one w.lang.en.reply name=done.add count=one act=make role=kind text="I added a {kind}." example="I added a house." core.source="hand-core 1"
@w.lang.en.reply.done.add.other w.lang.en.reply name=done.add count=other act=make role=kind role=number text="I added {number} {kind:num=pl}." example="I added 3 houses." core.source="hand-core 1"
@w.lang.en.reply.done.place.one w.lang.en.reply name=done.place count=one act=place role=thing text="I moved the {thing}." example="I moved the house." core.source="hand-core 1"
@w.lang.en.reply.done.place.other w.lang.en.reply name=done.place count=other act=place role=thing role=number text="I moved {number} {thing:num=pl}." example="I moved 3 houses." core.source="hand-core 1"
@w.lang.en.reply.done.remove.one w.lang.en.reply name=done.remove count=one act=remove role=thing text="I removed the {thing}." example="I removed the house." core.source="hand-core 1"
@w.lang.en.reply.done.remove.other w.lang.en.reply name=done.remove count=other act=remove role=thing role=number text="I removed {number} {thing:num=pl}." example="I removed 3 houses." core.source="hand-core 1"
@w.lang.en.reply.done.change.one w.lang.en.reply name=done.change count=one act=change role=thing role=value text="The {thing} is {value} now." example="The house is red now." core.source="hand-core 1"
@w.lang.en.reply.done.change.other w.lang.en.reply name=done.change count=other act=change role=thing role=number role=value text="The {number} {thing:num=pl} are {value} now." example="The 3 houses are red now." core.source="hand-core 1"
@w.lang.en.reply.done.connect.one w.lang.en.reply name=done.connect count=one act=connect role=thing role=target text="I connected the {thing} to the {target}." example="I connected the house to the tree." core.source="hand-core 1"
@w.lang.en.reply.done.undo.one w.lang.en.reply name=done.undo count=one act=undo text="I undid the last change." example="I undid the last change." core.source="hand-core 1"
@w.lang.en.reply.not_understood.one w.lang.en.reply name=not_understood count=one role=words text="I did not understand: {words}." example="I did not understand: blorp." core.source="hand-core 1"
@w.lang.en.reply.not_understood.all.one w.lang.en.reply name=not_understood.all count=one text="I did not understand what you mean." example="I did not understand what you mean." core.source="hand-core 1"
@w.lang.en.reply.did_you_mean.one w.lang.en.reply name=did_you_mean count=one role=request text="Did you mean: {request}?" example="Did you mean: add a house?" core.source="hand-core 1"
@w.lang.en.reply.welcome.one w.lang.en.reply name=welcome count=one act=thank text="You're welcome." example="You're welcome." core.source="hand-core 1"
@w.lang.en.reply.hello.one w.lang.en.reply name=hello count=one act=greet text="Hello!" example="Hello!" core.source="hand-core 1"
@w.lang.en.reply.goodbye.one w.lang.en.reply name=goodbye count=one act=farewell text="Goodbye!" example="Goodbye!" core.source="hand-core 1"
