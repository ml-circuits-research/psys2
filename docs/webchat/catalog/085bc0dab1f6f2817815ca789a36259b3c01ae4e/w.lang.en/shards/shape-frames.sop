# a new thing laid out in the shape of an outline
@w.lang.en.frame.shape.make.of w.lang.en.frame name=shape.make.of act=make set=acts priority=17 needs=layout role=kind role=arrangement example="Make a diagram in the shape of a house." core.source="hand-core 1"
