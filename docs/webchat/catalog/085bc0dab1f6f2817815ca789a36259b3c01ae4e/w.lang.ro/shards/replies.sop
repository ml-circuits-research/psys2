# w.lang.ro/shards/replies: what the assistant says back (reviewer block 14:25 item 2: real, the owner read a machine-translated
# reply): done (drew, added, moved, removed, changed N things, in the shape of X, connected, undid), not understood naming the
# unread words, did you mean, and the answers to a greeting, thanks and a goodbye; first person, informal singular. The same
# names and counts (CLDR plural categories) as w.lang.en.reply, so a host picks by language.
# sources: hand-core 1 (written by hand in this repository)
# license: CC0-1.0
# script: none (hand-written)

@w.lang.ro.reply.done.make.one w.lang.ro.reply name=done.make count=one act=make role=kind text="am desenat {art@kind} {kind}." example="Am desenat o casă." core.source="hand-core 1"
@w.lang.ro.reply.done.make.few w.lang.ro.reply name=done.make count=few act=make role=kind role=number text="am desenat {number} {kind:num=pl}." example="Am desenat 3 case." core.source="hand-core 1"
@w.lang.ro.reply.done.make.other w.lang.ro.reply name=done.make count=other act=make role=kind role=number text="am desenat {number} de {kind:num=pl}." example="Am desenat 20 de case." core.source="hand-core 1"
@w.lang.ro.reply.done.make.value.one w.lang.ro.reply name=done.make.value count=one act=make role=kind role=value text="am desenat {art@kind} {kind} {value@kind}." example="Am desenat o casă roșie." core.source="hand-core 1"
@w.lang.ro.reply.done.make.value.few w.lang.ro.reply name=done.make.value count=few act=make role=kind role=number role=value text="am desenat {number} {kind:num=pl} {value:num=pl@kind}." example="Am desenat 3 case roșii." core.source="hand-core 1"
@w.lang.ro.reply.done.make.value.other w.lang.ro.reply name=done.make.value count=other act=make role=kind role=number role=value text="am desenat {number} de {kind:num=pl} {value:num=pl@kind}." example="Am desenat 20 de case roșii." core.source="hand-core 1"
@w.lang.ro.reply.done.make.shape.one w.lang.ro.reply name=done.make.shape count=one act=make role=kind role=shape text="am desenat {art@kind} {kind} în formă de {shape}." example="Am desenat un nor în formă de inimă." core.source="hand-core 1"
@w.lang.ro.reply.done.add.one w.lang.ro.reply name=done.add count=one act=make role=kind text="am adăugat {art@kind} {kind}." example="Am adăugat o casă." core.source="hand-core 1"
@w.lang.ro.reply.done.add.few w.lang.ro.reply name=done.add count=few act=make role=kind role=number text="am adăugat {number} {kind:num=pl}." example="Am adăugat 3 case." core.source="hand-core 1"
@w.lang.ro.reply.done.add.other w.lang.ro.reply name=done.add count=other act=make role=kind role=number text="am adăugat {number} de {kind:num=pl}." example="Am adăugat 20 de case." core.source="hand-core 1"
@w.lang.ro.reply.done.place.one w.lang.ro.reply name=done.place count=one act=place role=thing text="am mutat {thing:def=yes}." example="Am mutat casa." core.source="hand-core 1"
@w.lang.ro.reply.done.place.few w.lang.ro.reply name=done.place count=few act=place role=thing role=number text="am mutat {number} {thing:num=pl}." example="Am mutat 3 case." core.source="hand-core 1"
@w.lang.ro.reply.done.place.other w.lang.ro.reply name=done.place count=other act=place role=thing role=number text="am mutat {number} de {thing:num=pl}." example="Am mutat 20 de case." core.source="hand-core 1"
@w.lang.ro.reply.done.remove.one w.lang.ro.reply name=done.remove count=one act=remove role=thing text="am șters {thing:def=yes}." example="Am șters casa." core.source="hand-core 1"
@w.lang.ro.reply.done.remove.few w.lang.ro.reply name=done.remove count=few act=remove role=thing role=number text="am șters {number} {thing:num=pl}." example="Am șters 3 case." core.source="hand-core 1"
@w.lang.ro.reply.done.remove.other w.lang.ro.reply name=done.remove count=other act=remove role=thing role=number text="am șters {number} de {thing:num=pl}." example="Am șters 20 de case." core.source="hand-core 1"
@w.lang.ro.reply.done.change.one w.lang.ro.reply name=done.change count=one act=change role=thing role=value text="{thing:def=yes} este acum {value@thing}." example="Casa este acum roșie." core.source="hand-core 1"
@w.lang.ro.reply.done.change.few w.lang.ro.reply name=done.change count=few act=change role=thing role=number role=value text="cele {number} {thing:num=pl} sunt acum {value:num=pl@thing}." example="Cele 3 case sunt acum roșii." core.source="hand-core 1"
@w.lang.ro.reply.done.change.other w.lang.ro.reply name=done.change count=other act=change role=thing role=number role=value text="cele {number} de {thing:num=pl} sunt acum {value:num=pl@thing}." example="Cele 20 de case sunt acum roșii." core.source="hand-core 1"
@w.lang.ro.reply.done.connect.one w.lang.ro.reply name=done.connect count=one act=connect role=thing role=target text="am conectat {thing:def=yes} cu {target:def=yes}." example="Am conectat casa cu copacul." core.source="hand-core 1"
@w.lang.ro.reply.done.undo.one w.lang.ro.reply name=done.undo count=one act=undo text="am anulat ultima schimbare." example="Am anulat ultima schimbare." core.source="hand-core 1"
@w.lang.ro.reply.not_understood.one w.lang.ro.reply name=not_understood count=one role=words text="nu am înțeles: {words}." example="Nu am înțeles: blorp." core.source="hand-core 1"
@w.lang.ro.reply.not_understood.all.one w.lang.ro.reply name=not_understood.all count=one text="nu am înțeles ce vrei să spui." example="Nu am înțeles ce vrei să spui." core.source="hand-core 1"
@w.lang.ro.reply.did_you_mean.one w.lang.ro.reply name=did_you_mean count=one role=request text="ai vrut să spui: {request}?" example="Ai vrut să spui: adaugă o casă?" core.source="hand-core 1"
@w.lang.ro.reply.welcome.one w.lang.ro.reply name=welcome count=one act=thank text="cu plăcere." example="Cu plăcere." core.source="hand-core 1"
@w.lang.ro.reply.hello.one w.lang.ro.reply name=hello count=one act=greet text="salut!" example="Salut!" core.source="hand-core 1"
@w.lang.ro.reply.goodbye.one w.lang.ro.reply name=goodbye count=one act=farewell text="la revedere!" example="La revedere!" core.source="hand-core 1"

# the indefinite article: the lemma un of w.lang.ro (det.art), its form chosen by the gender and number of the noun
# (o casă, un copac): the template says it, a caller gives no article (the library's Q79)
@w.lang.ro.fill.done_make.art w.lang.ro.fill template=done.make role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.done_make_value.art w.lang.ro.fill template=done.make.value role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.done_make_shape.art w.lang.ro.fill template=done.make.shape role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.done_add.art w.lang.ro.fill template=done.add role=art lemma=un core.source="hand-core 1"
