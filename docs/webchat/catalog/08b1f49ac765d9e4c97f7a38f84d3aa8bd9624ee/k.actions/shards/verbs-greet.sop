@k.actions.verb.greet.greet k.actions.verb text=greet act=greet core.source="hand-core 1"
@k.actions.verb.greet.say_hello k.actions.verb text="say hello" act=greet core.source="hand-core 1"
@k.actions.verb.greet.say_hi k.actions.verb text="say hi" act=greet core.source="hand-core 1"
@k.actions.verb.greet.welcome k.actions.verb text=welcome act=greet core.source="hand-core 1"
