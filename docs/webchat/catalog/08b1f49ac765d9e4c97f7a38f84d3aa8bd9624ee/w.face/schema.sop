@w.face.limit.hands std.schema.limit of=w.face.hands max=200 core.source="hand-core 1"

# Which k.faces slot each kind of part draws: an explicit join, so a rule that reads a part's variant
# from k.faces matches the slot by a declared fact, not by the spelling of the type name.
@w.face.slot.type core.type of=w.face.slot closed=true core.source="hand-core 1"
@w.face.slot.part core.slot of=w.face.slot key=part kind=atom core.source="hand-core 1"
@w.face.slot.slot core.slot of=w.face.slot key=slot kind=atom core.source="hand-core 1"
# `group`: the kinds of part a person names together as one thing ("her hair": the back hair and the front hair; "his
# clothes": what a figure wears on the upper body, the legs and the feet, and over them);
# a feature of the group (its length) is the feature of its parts together.
@w.face.slot.group core.slot of=w.face.slot key=group kind=atom core.source="hand-core 1"
@w.face.slot.hair_back w.face.slot part=w.face.hair_back slot=hair_back group=hair core.source="hand-core 1"
@w.face.slot.shoulders w.face.slot part=w.face.shoulders slot=shoulders core.source="hand-core 1"
@w.face.slot.clothes w.face.slot part=w.face.clothes slot=clothes core.source="hand-core 1"
@w.face.slot.neck w.face.slot part=w.face.neck slot=neck core.source="hand-core 1"
@w.face.slot.ears w.face.slot part=w.face.ears slot=ears core.source="hand-core 1"
@w.face.slot.head w.face.slot part=w.face.head slot=head core.source="hand-core 1"
@w.face.slot.cheeks w.face.slot part=w.face.cheeks slot=cheeks core.source="hand-core 1"
@w.face.slot.beard w.face.slot part=w.face.beard slot=beard core.source="hand-core 1"
@w.face.slot.mouth w.face.slot part=w.face.mouth slot=mouth core.source="hand-core 1"
@w.face.slot.moustache w.face.slot part=w.face.moustache slot=moustache core.source="hand-core 1"
@w.face.slot.nose w.face.slot part=w.face.nose slot=nose core.source="hand-core 1"
@w.face.slot.eyes w.face.slot part=w.face.eyes slot=eyes core.source="hand-core 1"
@w.face.slot.eyebrows w.face.slot part=w.face.eyebrows slot=eyebrows core.source="hand-core 1"
@w.face.slot.glasses w.face.slot part=w.face.glasses slot=glasses core.source="hand-core 1"
@w.face.slot.hair_front w.face.slot part=w.face.hair_front slot=hair_front group=hair core.source="hand-core 1"
@w.face.slot.earrings w.face.slot part=w.face.earrings slot=earrings core.source="hand-core 1"
@w.face.slot.hat w.face.slot part=w.face.hat slot=hat core.source="hand-core 1"
@w.face.slot.accessories w.face.slot part=w.face.accessories slot=accessories core.source="hand-core 1"
@w.face.slot.body w.face.slot part=w.face.body slot=body core.source="hand-core 1"
@w.face.slot.top w.face.slot part=w.face.top slot=top group=clothes core.source="hand-core 1"
@w.face.slot.bottom w.face.slot part=w.face.bottom slot=bottom group=clothes core.source="hand-core 1"
@w.face.slot.shoes w.face.slot part=w.face.shoes slot=shoes group=clothes core.source="hand-core 1"
@w.face.slot.coat w.face.slot part=w.face.coat slot=coat group=clothes core.source="hand-core 1"
@w.face.slot.back w.face.slot part=w.face.back slot=back group=clothes core.source="hand-core 1"
@w.face.slot.neckwear w.face.slot part=w.face.neckwear slot=neckwear group=clothes core.source="hand-core 1"
