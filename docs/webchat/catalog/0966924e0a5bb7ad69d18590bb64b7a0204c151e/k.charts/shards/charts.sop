@k.charts.kind.bar_chart k.charts.kind name="bar chart" form=bar mark=bar encoding=length x=nominal x=ordinal x=time y=quantitative about="one bar per category, its length the value; the most accurate way to compare values of categories after position" source=cleveland1984 source=few2012 core.source="hand-core 1"
@k.charts.kind.grouped_bar_chart k.charts.kind name="grouped bar chart" form=bar mark=bar encoding=length x=nominal x=ordinal x=time y=quantitative about="bars of several series side by side in each category" source=few2012 core.source="hand-core 1"
@k.charts.kind.stacked_bar_chart k.charts.kind name="stacked bar chart" form=bar mark=bar encoding=length x=nominal x=ordinal x=time y=quantitative whole=true about="one bar per whole, divided into its parts; compares the parts of several wholes" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.kind.line_chart k.charts.kind name="line chart" form=line mark=line encoding=position x=time x=ordinal x=quantitative y=quantitative about="values joined in the order of the axis; its slope shows the change" source=few2012 source=cleveland1984 core.source="hand-core 1"
@k.charts.kind.area_chart k.charts.kind name="area chart" form=area mark=area encoding=position x=time x=ordinal x=quantitative y=quantitative whole=true about="a line chart filled below; stacked, the parts of a whole over time" source=few2012 core.source="hand-core 1"
@k.charts.kind.pie_chart k.charts.kind name="pie chart" form=pie mark=slice encoding=angle x=nominal y=quantitative whole=true about="one slice per part of one whole, its angle the share" source=few2007 source=cleveland1984 core.source="hand-core 1"
@k.charts.kind.scatter_plot k.charts.kind name="scatter plot" form=scatter mark=point encoding=position x=quantitative y=quantitative about="one point per item at its two values; shows whether two quantities vary together" source=few2012 source=cleveland1984 core.source="hand-core 1"
@k.charts.kind.dot_plot k.charts.kind name="dot plot" form=scatter mark=point encoding=position x=nominal x=ordinal y=quantitative about="one dot per category at its value on a common scale" source=cleveland1984 source=few2012 core.source="hand-core 1"
@k.charts.kind.histogram k.charts.kind name=histogram form=bar mark=bar encoding=length x=quantitative y=quantitative about="bars over ranges of a quantity, their length how many values fall in each" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.relationship.time_series k.charts.relationship name="time series" about="how values change over time" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.relationship.ranking k.charts.relationship name=ranking about="values in order of size" source=few2012 core.source="hand-core 1"
@k.charts.relationship.part-to-whole k.charts.relationship name=part-to-whole about="the shares of a whole" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.relationship.deviation k.charts.relationship name=deviation about="how values differ from a reference (a target, an average)" source=few2012 core.source="hand-core 1"
@k.charts.relationship.distribution k.charts.relationship name=distribution about="how many values fall in each range of a quantity" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.relationship.correlation k.charts.relationship name=correlation about="whether two quantities vary together" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.relationship.nominal_comparison k.charts.relationship name="nominal comparison" about="the values of categories that have no order" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.rule.time_series.line_chart k.charts.rule relationship="time series" kind="line chart" rank=1 points_min=3 about="the slope between points shows the change; position is read most accurately" source=few2012 source=cleveland1984 core.source="hand-core 1"
@k.charts.rule.time_series.bar_chart k.charts.rule relationship="time series" kind="bar chart" rank=2 about="bars for a few separate periods, when the values themselves matter more than the trend" source=few2012 core.source="hand-core 1"
@k.charts.rule.time_series.area_chart k.charts.rule relationship="time series" kind="area chart" rank=3 about="a filled line, for one series or the parts of a whole over time" source=few2012 core.source="hand-core 1"
@k.charts.rule.ranking.bar_chart k.charts.rule relationship=ranking kind="bar chart" rank=1 about="bars sorted by length make the order plain" source=few2012 source=cleveland1984 core.source="hand-core 1"
@k.charts.rule.ranking.dot_plot k.charts.rule relationship=ranking kind="dot plot" rank=2 about="dots on a common scale, sorted" source=few2012 source=cleveland1984 core.source="hand-core 1"
@k.charts.rule.part-to-whole.pie_chart k.charts.rule relationship=part-to-whole kind="pie chart" rank=1 categories_max=5 series=one about="a few parts of one whole: the slices say \"share of a whole\" at a glance; with more parts angles are hard to compare" source=few2007 source=cleveland1984 core.source="hand-core 1"
@k.charts.rule.part-to-whole.stacked_bar_chart k.charts.rule relationship=part-to-whole kind="stacked bar chart" rank=1 series=several about="the parts of several wholes, one bar per whole" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.rule.part-to-whole.bar_chart k.charts.rule relationship=part-to-whole kind="bar chart" rank=2 series=one about="the parts as bars: lengths are read more accurately than angles" source=few2007 source=cleveland1984 core.source="hand-core 1"
@k.charts.rule.deviation.bar_chart k.charts.rule relationship=deviation kind="bar chart" rank=1 about="bars above and below the reference line" source=few2012 core.source="hand-core 1"
@k.charts.rule.deviation.line_chart k.charts.rule relationship=deviation kind="line chart" rank=2 points_min=3 about="the deviation over time, the reference as a line" source=few2012 core.source="hand-core 1"
@k.charts.rule.distribution.histogram k.charts.rule relationship=distribution kind=histogram rank=1 about="bars over ranges of the quantity" source=few2012 source=zelazny1985 core.source="hand-core 1"
@k.charts.rule.correlation.scatter_plot k.charts.rule relationship=correlation kind="scatter plot" rank=1 about="one point per item at its two values" source=few2012 source=zelazny1985 source=cleveland1984 core.source="hand-core 1"
@k.charts.rule.nominal_comparison.bar_chart k.charts.rule relationship="nominal comparison" kind="bar chart" rank=1 about="one bar per category; length on a common baseline" source=few2012 source=cleveland1984 core.source="hand-core 1"
@k.charts.rule.nominal_comparison.grouped_bar_chart k.charts.rule relationship="nominal comparison" kind="grouped bar chart" rank=1 series=several about="the categories of several series side by side" source=few2012 core.source="hand-core 1"
@k.charts.rule.nominal_comparison.dot_plot k.charts.rule relationship="nominal comparison" kind="dot plot" rank=2 about="dots on a common scale when bars would not start at zero" source=cleveland1984 source=few2012 core.source="hand-core 1"
