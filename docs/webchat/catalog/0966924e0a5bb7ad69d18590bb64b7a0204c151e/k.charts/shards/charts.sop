# k.charts/shards/charts: which chart fits which data: 9 kinds of chart, 14 encodings ranked in 4 rankings, 7 relationships of data, 15 selection rules, and the 5 works they rest on.
# sources: hand-core 1 (hand-written in this repository: tools/charts-core.mjs; the works cited are the k.charts.source facts)
# license: CC0-1.0
# script: tools/charts-core.mjs

@k.charts.source.mackinlay1986 k.charts.source name=mackinlay1986 cite="Mackinlay, J. (1986). Automating the design of graphical presentations of relational information. ACM Transactions on Graphics, 5(2), 110-141." year=1986 core.source="hand-core 1"
@k.charts.source.cleveland1984 k.charts.source name=cleveland1984 cite="Cleveland, W. S., and McGill, R. (1984). Graphical perception: theory, experimentation, and application to the development of graphical methods. Journal of the American Statistical Association, 79(387), 531-554." year=1984 core.source="hand-core 1"
@k.charts.source.few2012 k.charts.source name=few2012 cite="Few, S. (2012). Show Me the Numbers: Designing Tables and Graphs to Enlighten (2nd ed.). Analytics Press." year=2012 core.source="hand-core 1"
@k.charts.source.few2007 k.charts.source name=few2007 cite="Few, S. (2007). Save the pies for dessert. Visual Business Intelligence Newsletter, August 2007." year=2007 core.source="hand-core 1"
@k.charts.source.zelazny1985 k.charts.source name=zelazny1985 cite="Zelazny, G. (1985). Say It with Charts: The Executive's Guide to Visual Communication. Dow Jones-Irwin." year=1985 core.source="hand-core 1"
@k.charts.encoding.position k.charts.encoding name=position about="where a mark stands along an axis" core.source="hand-core 1"
@k.charts.encoding.position_unaligned k.charts.encoding name="position unaligned" about="where a mark stands along one of several scales that are not aligned" core.source="hand-core 1"
@k.charts.encoding.length k.charts.encoding name=length about="how long a mark is" core.source="hand-core 1"
@k.charts.encoding.angle k.charts.encoding name=angle about="the angle a mark makes (a slice of a pie)" core.source="hand-core 1"
@k.charts.encoding.slope k.charts.encoding name=slope about="how steep a line is" core.source="hand-core 1"
@k.charts.encoding.area k.charts.encoding name=area about="how large a surface is" core.source="hand-core 1"
@k.charts.encoding.volume k.charts.encoding name=volume about="how large a solid is" core.source="hand-core 1"
@k.charts.encoding.density k.charts.encoding name=density about="how dark a shade of grey is" core.source="hand-core 1"
@k.charts.encoding.colour_saturation k.charts.encoding name="colour saturation" about="how strong a colour is" core.source="hand-core 1"
@k.charts.encoding.colour_hue k.charts.encoding name="colour hue" about="which colour a mark has" core.source="hand-core 1"
@k.charts.encoding.texture k.charts.encoding name=texture about="the pattern that fills a mark" core.source="hand-core 1"
@k.charts.encoding.connection k.charts.encoding name=connection about="a line joining marks" core.source="hand-core 1"
@k.charts.encoding.containment k.charts.encoding name=containment about="a mark inside another" core.source="hand-core 1"
@k.charts.encoding.shape k.charts.encoding name=shape about="the shape of a mark" core.source="hand-core 1"
