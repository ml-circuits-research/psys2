@k.diagrams.word.key.shape.role core.word text=role means=k.diagrams.shape.role core.source="hand-core 1"
@k.diagrams.word.key.shape.shape core.word text=shape means=k.diagrams.shape.shape core.source="hand-core 1"
@k.diagrams.word.key.shape.about core.word text=about means=k.diagrams.shape.about core.source="hand-core 1"
@k.diagrams.word.key.shape.source core.word text=source means=k.diagrams.shape.source core.source="hand-core 1"
@k.diagrams.word.key.fill.type core.word text=type means=k.diagrams.fill.type core.source="hand-core 1"
@k.diagrams.word.key.fill.key core.word text=key means=k.diagrams.fill.key core.source="hand-core 1"
