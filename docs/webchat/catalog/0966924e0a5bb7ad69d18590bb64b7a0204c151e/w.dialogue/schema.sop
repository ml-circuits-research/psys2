# w.dialogue: a reusable world: the conversation of one session as state (owner's GO, reviewer block 2026-11-15
# 14:00, item 2). One live instance per session: its tabs, each with its last request (a w.request request) and the
# result that request produced (the things made or changed, by id), the turns, the assumptions said, the open
# questions. A reaction is a turn whose act is on the last result (reject, reduce, enlarge, refine, redo, put_back,
# thanks, frustration): it revises the last request (the revision facts below say how: add, flip or step a
# constraint) and the tab's world redoes it, the last result replaced, not piled on.
# Declared as data in the library's std.schema format; the acts of std.acts drive it; it has no rule and no function.
# sources: hand-core 1 (hand-written in this repository; own)
# license: CC0-1.0
# script: none (hand-written)
# needs: sopworld with std.schema and std.acts (tools/sopworld/VERSION)

@w.dialogue core.module name=w.dialogue version=1 imports=w.request exports=session exports=tab exports=turn exports=result exports=assumption exports=question exports=revision core.source="hand-core 1"
@w.dialogue.world std.schema.world name=w.dialogue doc="the conversation of a session as state: last request and result per tab, reactions, assumptions, open questions" core.source="hand-core 1"

# A session: `name` its id as the host knows it, `language` the language the person writes in (en, ro: a message in
# another language than English is translated at the boundary).
@w.dialogue.session core.type of=w.dialogue.session extends=std.schema.thing closed=true core.source="hand-core 1"
@w.dialogue.session.name core.slot of=w.dialogue.session key=name required=true kind=atom kind=string core.source="hand-core 1"
@w.dialogue.session.language core.slot of=w.dialogue.session key=language kind=atom default=en core.source="hand-core 1"

# A tab of a session: `name` (diagram, drawing, documents, map, chart, music ...), `holds` the world it holds (the
# world id: w.diagram ...), `last_request` its last request and `last_result` the result it produced (the one a
# reaction acts on).
@w.dialogue.tab core.type of=w.dialogue.tab extends=std.schema.thing closed=true core.source="hand-core 1"
@w.dialogue.tab.session core.slot of=w.dialogue.tab key=session type=w.dialogue.session core.source="hand-core 1"
@w.dialogue.tab.name core.slot of=w.dialogue.tab key=name required=true kind=atom kind=string core.source="hand-core 1"
@w.dialogue.tab.holds core.slot of=w.dialogue.tab key=holds kind=atom kind=string core.source="hand-core 1"
@w.dialogue.tab.last_request core.slot of=w.dialogue.tab key=last_request type=w.request.request core.source="hand-core 1"
@w.dialogue.tab.last_result core.slot of=w.dialogue.tab key=last_result type=w.dialogue.result core.source="hand-core 1"

# A turn: what the person said at `n` (from 1) in `tab`. `sort`: request (a new request), reaction (on the last
# result), question (asks something), answer (answers an open question of the assistant), talk (greeting, small
# talk). `request` the w.request request it was read as (a new one, or the revision a reaction made); `reaction` the
# reaction it is, for a reaction; `on_result` the result it reacts to.
@w.dialogue.turn core.type of=w.dialogue.turn extends=std.schema.thing closed=true core.source="hand-core 1"
@w.dialogue.turn.tab core.slot of=w.dialogue.turn key=tab type=w.dialogue.tab core.source="hand-core 1"
@w.dialogue.turn.n core.slot of=w.dialogue.turn key=n required=true kind=integer min=1 step=1 core.source="hand-core 1"
@w.dialogue.turn.text core.slot of=w.dialogue.turn key=text kind=string core.source="hand-core 1"
@w.dialogue.turn.sort core.slot of=w.dialogue.turn key=sort required=true enum=request enum=reaction enum=question enum=answer enum=talk core.source="hand-core 1"
@w.dialogue.turn.request core.slot of=w.dialogue.turn key=request type=w.request.request core.source="hand-core 1"
@w.dialogue.turn.reaction core.slot of=w.dialogue.turn key=reaction enum=reject enum=reduce enum=enlarge enum=refine enum=redo enum=put_back enum=thanks enum=frustration core.source="hand-core 1"
@w.dialogue.turn.on_result core.slot of=w.dialogue.turn key=on_result type=w.dialogue.result core.source="hand-core 1"

# A result: what a request produced in a tab. `request` the request it satisfies; `thing` (many) the ids of the things
# made or changed in the tab's world; `effect` what was done (made, changed, removed, arranged); `status` current (the
# last result of its tab), replaced (a revision redid it: `replaces` on the new one names it), undone (put back).
# `seed` the number a "random" plan drew with (two redos differ: a new seed).
@w.dialogue.result core.type of=w.dialogue.result extends=std.schema.thing closed=true core.source="hand-core 1"
@w.dialogue.result.request core.slot of=w.dialogue.result key=request required=true type=w.request.request core.source="hand-core 1"
@w.dialogue.result.tab core.slot of=w.dialogue.result key=tab type=w.dialogue.tab core.source="hand-core 1"
@w.dialogue.result.thing core.slot of=w.dialogue.result key=thing many=true kind=atom kind=string core.source="hand-core 1"
@w.dialogue.result.effect core.slot of=w.dialogue.result key=effect enum=made enum=changed enum=removed enum=arranged default=made core.source="hand-core 1"
@w.dialogue.result.status core.slot of=w.dialogue.result key=status enum=current enum=replaced enum=undone default=current core.source="hand-core 1"
@w.dialogue.result.replaces core.slot of=w.dialogue.result key=replaces type=w.dialogue.result core.source="hand-core 1"
@w.dialogue.result.seed core.slot of=w.dialogue.result key=seed kind=integer min=0 core.source="hand-core 1"

# An assumption: a constraint the planner filled from k.expect because the person did not say it (a w.request
# constraint with origin=default). `said=yes` once the reply has told it ("I assumed 7 nodes").
@w.dialogue.assumption core.type of=w.dialogue.assumption extends=std.schema.thing closed=true core.source="hand-core 1"
@w.dialogue.assumption.result core.slot of=w.dialogue.assumption key=result type=w.dialogue.result core.source="hand-core 1"
@w.dialogue.assumption.constraint core.slot of=w.dialogue.assumption key=constraint required=true type=w.request.constraint core.source="hand-core 1"
@w.dialogue.assumption.said core.slot of=w.dialogue.assumption key=said enum=yes enum=no default=no core.source="hand-core 1"

# An open question the assistant asked: `asks` what it asks about (a constraint `on` of w.request: count, kind,
# about ...), `text` as said, `option` (many) the choices offered, `status` open, answered or dropped.
@w.dialogue.question core.type of=w.dialogue.question extends=std.schema.thing closed=true core.source="hand-core 1"
@w.dialogue.question.tab core.slot of=w.dialogue.question key=tab type=w.dialogue.tab core.source="hand-core 1"
@w.dialogue.question.request core.slot of=w.dialogue.question key=request type=w.request.request core.source="hand-core 1"
@w.dialogue.question.asks core.slot of=w.dialogue.question key=asks kind=atom core.source="hand-core 1"
@w.dialogue.question.text core.slot of=w.dialogue.question key=text kind=string core.source="hand-core 1"
@w.dialogue.question.option core.slot of=w.dialogue.question key=option many=true kind=atom kind=string core.source="hand-core 1"
@w.dialogue.question.status core.slot of=w.dialogue.question key=status enum=open enum=answered enum=dropped default=open core.source="hand-core 1"

# How a reaction revises the last request (data, read by the library's revise): one fact per reaction and change.
# `reaction` the reaction; `does`: flip (the constraints `on` of the last request, or the kinds of the last result
# where none was said, turn to want=no: "not this", "wrong"), step (the `on` constraint moves one scale step of k.expect
# in `direction` down or up, or its count by the scale's count factor: "too much", "bigger"), add (the constraints said
# in the reaction are added, replacing those `on` the same key: "not all circles, better layout"), keep (the request is
# done again unchanged with a new seed: "redo", "another one"), undo (the last result is put back: "put it back"),
# none (nothing changes: "thanks"). `replaces=yes`: the new result replaces the last one (it is not piled on). `reply`
# the w.lang.* reply name the reply opens with (an apology for a frustration).
@w.dialogue.revision core.type of=w.dialogue.revision shared=true closed=true core.source="hand-core 1"
@w.dialogue.revision.reaction core.slot of=w.dialogue.revision key=reaction id=true required=true enum=reject enum=reduce enum=enlarge enum=refine enum=redo enum=put_back enum=thanks enum=frustration core.source="hand-core 1"
@w.dialogue.revision.does core.slot of=w.dialogue.revision key=does id=true required=true enum=flip enum=step enum=add enum=keep enum=undo enum=none core.source="hand-core 1"
@w.dialogue.revision.on core.slot of=w.dialogue.revision key=on id=true kind=atom core.source="hand-core 1"
@w.dialogue.revision.direction core.slot of=w.dialogue.revision key=direction enum=up enum=down core.source="hand-core 1"
@w.dialogue.revision.replaces core.slot of=w.dialogue.revision key=replaces enum=yes enum=no core.source="hand-core 1"
@w.dialogue.revision.reply core.slot of=w.dialogue.revision key=reply kind=atom core.source="hand-core 1"
@w.dialogue.revision.about core.slot of=w.dialogue.revision key=about required=true kind=string core.source="hand-core 1"

@w.dialogue.revision.reject.flip w.dialogue.revision reaction=reject does=flip on=kind replaces=yes about="not this, wrong: the kinds said (or the kinds of the last result) become not wanted, and the request is done again" core.source="hand-core 1"
@w.dialogue.revision.reduce.count w.dialogue.revision reaction=reduce does=step on=count direction=down replaces=yes about="too much, you overdid it: fewer things (the count down by the scale's factor)" core.source="hand-core 1"
@w.dialogue.revision.reduce.extent w.dialogue.revision reaction=reduce does=step on=extent direction=down replaces=yes about="too big, too much: the result takes one scale step less of the canvas" core.source="hand-core 1"
@w.dialogue.revision.enlarge.count w.dialogue.revision reaction=enlarge does=step on=count direction=up replaces=yes about="more, too few: more things (the count up by the scale's factor)" core.source="hand-core 1"
@w.dialogue.revision.enlarge.size w.dialogue.revision reaction=enlarge does=step on=size direction=up replaces=yes about="bigger, too small: each thing one scale step bigger" core.source="hand-core 1"
@w.dialogue.revision.refine.add w.dialogue.revision reaction=refine does=add replaces=yes about="not all circles, better layout, with arrows: the constraints said are added to the last request, replacing those on the same key" core.source="hand-core 1"
@w.dialogue.revision.redo.keep w.dialogue.revision reaction=redo does=keep replaces=yes about="redo, again, another one: the same request with a new seed" core.source="hand-core 1"
@w.dialogue.revision.put_back.undo w.dialogue.revision reaction=put_back does=undo replaces=no about="put it back, as it was: the last result is undone and the one before is current again" core.source="hand-core 1"
@w.dialogue.revision.thanks.none w.dialogue.revision reaction=thanks does=none replaces=no reply=welcome about="thanks, great: nothing changes" core.source="hand-core 1"
@w.dialogue.revision.frustration.flip w.dialogue.revision reaction=frustration does=flip on=kind replaces=yes reply=sorry about="an insult or frustration: an apology, and the last result is treated as rejected (redone without its kinds unless the person says more)" core.source="hand-core 1"

# The kinds and the acts that apply to them.
@w.dialogue.kind.session std.schema.kind of=w.dialogue.session world=w.dialogue acts=make acts=change acts=ask core.source="hand-core 1"
@w.dialogue.kind.tab std.schema.kind of=w.dialogue.tab world=w.dialogue acts=make acts=change acts=ask core.source="hand-core 1"
@w.dialogue.kind.turn std.schema.kind of=w.dialogue.turn world=w.dialogue acts=make acts=change acts=ask core.source="hand-core 1"
@w.dialogue.kind.result std.schema.kind of=w.dialogue.result world=w.dialogue acts=make acts=change acts=ask core.source="hand-core 1"
@w.dialogue.kind.assumption std.schema.kind of=w.dialogue.assumption world=w.dialogue acts=make acts=change acts=remove acts=ask core.source="hand-core 1"
@w.dialogue.kind.question std.schema.kind of=w.dialogue.question world=w.dialogue acts=make acts=change acts=remove acts=ask core.source="hand-core 1"
@w.dialogue.limit.tab std.schema.limit of=w.dialogue.tab max=20 core.source="hand-core 1"
@w.dialogue.limit.turn std.schema.limit of=w.dialogue.turn max=1000 core.source="hand-core 1"
@w.dialogue.limit.result std.schema.limit of=w.dialogue.result max=1000 core.source="hand-core 1"

# Words: for the world, its kinds and its keys.
@w.dialogue.word.world core.word text=dialogue text=conversation text=session text=chat means=w.dialogue of=std.schema.world.name core.source="hand-core 1"
@w.dialogue.word.session core.word text=session text=conversation means=w.dialogue.session core.source="hand-core 1"
@w.dialogue.word.session.name core.word text=name text=id means=w.dialogue.session.name core.source="hand-core 1"
@w.dialogue.word.language core.word text=language means=w.dialogue.session.language core.source="hand-core 1"
@w.dialogue.word.tab core.word text=tab text=tabs text=page means=w.dialogue.tab core.source="hand-core 1"
@w.dialogue.word.tab.session core.word text=session text="in session" means=w.dialogue.tab.session core.source="hand-core 1"
@w.dialogue.word.tab.name core.word text=name text=called means=w.dialogue.tab.name core.source="hand-core 1"
@w.dialogue.word.holds core.word text=holds text=world means=w.dialogue.tab.holds core.source="hand-core 1"
@w.dialogue.word.last_request core.word text="last request" text="what I asked" means=w.dialogue.tab.last_request core.source="hand-core 1"
@w.dialogue.word.last_result core.word text="last result" text="what you made" text="what you did" means=w.dialogue.tab.last_result core.source="hand-core 1"
@w.dialogue.word.turn core.word text=turn text=turns text=message means=w.dialogue.turn core.source="hand-core 1"
@w.dialogue.word.turn.tab core.word text=tab text="in tab" means=w.dialogue.turn.tab core.source="hand-core 1"
@w.dialogue.word.turn.n core.word text=number text="turn number" means=w.dialogue.turn.n core.source="hand-core 1"
@w.dialogue.word.turn.text core.word text=text text=said means=w.dialogue.turn.text core.source="hand-core 1"
@w.dialogue.word.turn.sort core.word text=sort text=kind means=w.dialogue.turn.sort core.source="hand-core 1"
@w.dialogue.word.turn.request core.word text=request text="read as" means=w.dialogue.turn.request core.source="hand-core 1"
@w.dialogue.word.reaction core.word text=reaction text=reacts text=response means=w.dialogue.turn.reaction core.source="hand-core 1"
@w.dialogue.word.on_result core.word text="reacts to" text="on result" means=w.dialogue.turn.on_result core.source="hand-core 1"
@w.dialogue.word.result core.word text=result text=results text=outcome means=w.dialogue.result core.source="hand-core 1"
@w.dialogue.word.result.request core.word text=request text="made for" means=w.dialogue.result.request core.source="hand-core 1"
@w.dialogue.word.result.tab core.word text=tab text="in tab" means=w.dialogue.result.tab core.source="hand-core 1"
@w.dialogue.word.result.thing core.word text=thing text=things text=made means=w.dialogue.result.thing core.source="hand-core 1"
@w.dialogue.word.effect core.word text=effect text=done means=w.dialogue.result.effect core.source="hand-core 1"
@w.dialogue.word.result.status core.word text=status text=current text=replaced text=undone means=w.dialogue.result.status core.source="hand-core 1"
@w.dialogue.word.replaces core.word text=replaces text=instead means=w.dialogue.result.replaces core.source="hand-core 1"
@w.dialogue.word.seed core.word text=seed text=random means=w.dialogue.result.seed core.source="hand-core 1"
@w.dialogue.word.assumption core.word text=assumption text=assumptions text=assumed means=w.dialogue.assumption core.source="hand-core 1"
@w.dialogue.word.assumption.result core.word text=result text="assumed for" means=w.dialogue.assumption.result core.source="hand-core 1"
@w.dialogue.word.assumption.constraint core.word text=constraint text=what means=w.dialogue.assumption.constraint core.source="hand-core 1"
@w.dialogue.word.said core.word text=said text=told means=w.dialogue.assumption.said core.source="hand-core 1"
@w.dialogue.word.question core.word text=question text=questions text="open question" means=w.dialogue.question core.source="hand-core 1"
@w.dialogue.word.question.tab core.word text=tab text="in tab" means=w.dialogue.question.tab core.source="hand-core 1"
@w.dialogue.word.question.request core.word text=request text="asked for" means=w.dialogue.question.request core.source="hand-core 1"
@w.dialogue.word.asks core.word text=asks text="asks about" means=w.dialogue.question.asks core.source="hand-core 1"
@w.dialogue.word.question.text core.word text=text text=said means=w.dialogue.question.text core.source="hand-core 1"
@w.dialogue.word.option core.word text=option text=options text=choice text=choices means=w.dialogue.question.option core.source="hand-core 1"
@w.dialogue.word.question.status core.word text=status text=answered text=open means=w.dialogue.question.status core.source="hand-core 1"
@w.dialogue.word.revision core.word text=revision text=revise text=correction means=w.dialogue.revision core.source="hand-core 1"
@w.dialogue.word.revision.reaction core.word text=reaction means=w.dialogue.revision.reaction core.source="hand-core 1"
@w.dialogue.word.does core.word text=does text=change means=w.dialogue.revision.does core.source="hand-core 1"
@w.dialogue.word.revision.on core.word text=on text=key means=w.dialogue.revision.on core.source="hand-core 1"
@w.dialogue.word.direction core.word text=direction text=up text=down means=w.dialogue.revision.direction core.source="hand-core 1"
@w.dialogue.word.revision.replaces core.word text=replaces text="replaces the last result" means=w.dialogue.revision.replaces core.source="hand-core 1"
@w.dialogue.word.reply core.word text=reply text=answer means=w.dialogue.revision.reply core.source="hand-core 1"
@w.dialogue.word.revision.about core.word text=about text=meaning means=w.dialogue.revision.about core.source="hand-core 1"
