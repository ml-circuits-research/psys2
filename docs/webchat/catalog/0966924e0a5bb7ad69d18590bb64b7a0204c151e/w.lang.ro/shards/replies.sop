# w.lang.ro/shards/replies: what the assistant says back (reviewer block 14:25 item 2: real, the owner read a machine-translated
# reply): done (drew, added, moved, removed, changed N things, in the shape of X, connected, undid), not understood naming the
# unread words, did you mean, and the answers to a greeting, thanks and a goodbye; first person, informal singular. The same
# names and counts (CLDR plural categories) as w.lang.en.reply, so a host picks by language.
# Also the kit's reply names (the library's Q82: done.redo, nothing.*, ask.*, refused.*, too_complex.*, why.*, answer.no) and
# person.know.none (psys2 Q32).
# sources: hand-core 1 (written by hand in this repository)
# license: CC0-1.0
# script: none (hand-written)

@w.lang.ro.reply.done.make.one w.lang.ro.reply name=done.make count=one act=make role=kind text="am desenat {art@kind} {kind}." example="Am desenat o casă." core.source="hand-core 1"
@w.lang.ro.reply.done.make.few w.lang.ro.reply name=done.make count=few act=make role=kind role=number text="am desenat {number} {kind:num=pl}." example="Am desenat 3 case." core.source="hand-core 1"
@w.lang.ro.reply.done.make.other w.lang.ro.reply name=done.make count=other act=make role=kind role=number text="am desenat {number} de {kind:num=pl}." example="Am desenat 20 de case." core.source="hand-core 1"
@w.lang.ro.reply.done.make.value.one w.lang.ro.reply name=done.make.value count=one act=make role=kind role=value text="am desenat {art@kind} {kind} {value@kind}." example="Am desenat o casă roșie." core.source="hand-core 1"
@w.lang.ro.reply.done.make.value.few w.lang.ro.reply name=done.make.value count=few act=make role=kind role=number role=value text="am desenat {number} {kind:num=pl} {value:num=pl@kind}." example="Am desenat 3 case roșii." core.source="hand-core 1"
@w.lang.ro.reply.done.make.value.other w.lang.ro.reply name=done.make.value count=other act=make role=kind role=number role=value text="am desenat {number} de {kind:num=pl} {value:num=pl@kind}." example="Am desenat 20 de case roșii." core.source="hand-core 1"
@w.lang.ro.reply.done.make.shape.one w.lang.ro.reply name=done.make.shape count=one act=make role=kind role=shape text="am desenat {art@kind} {kind} în formă de {shape}." example="Am desenat un nor în formă de inimă." core.source="hand-core 1"
@w.lang.ro.reply.done.add.one w.lang.ro.reply name=done.add count=one act=make role=kind text="am adăugat {art@kind} {kind}." example="Am adăugat o casă." core.source="hand-core 1"
@w.lang.ro.reply.done.add.few w.lang.ro.reply name=done.add count=few act=make role=kind role=number text="am adăugat {number} {kind:num=pl}." example="Am adăugat 3 case." core.source="hand-core 1"
@w.lang.ro.reply.done.add.other w.lang.ro.reply name=done.add count=other act=make role=kind role=number text="am adăugat {number} de {kind:num=pl}." example="Am adăugat 20 de case." core.source="hand-core 1"
@w.lang.ro.reply.done.place.one w.lang.ro.reply name=done.place count=one act=place role=thing text="am mutat {thing:def=yes}." example="Am mutat casa." core.source="hand-core 1"
@w.lang.ro.reply.done.place.few w.lang.ro.reply name=done.place count=few act=place role=thing role=number text="am mutat {number} {thing:num=pl}." example="Am mutat 3 case." core.source="hand-core 1"
@w.lang.ro.reply.done.place.other w.lang.ro.reply name=done.place count=other act=place role=thing role=number text="am mutat {number} de {thing:num=pl}." example="Am mutat 20 de case." core.source="hand-core 1"
@w.lang.ro.reply.done.remove.one w.lang.ro.reply name=done.remove count=one act=remove role=thing text="am șters {thing:def=yes}." example="Am șters casa." core.source="hand-core 1"
@w.lang.ro.reply.done.remove.few w.lang.ro.reply name=done.remove count=few act=remove role=thing role=number text="am șters {number} {thing:num=pl}." example="Am șters 3 case." core.source="hand-core 1"
@w.lang.ro.reply.done.remove.other w.lang.ro.reply name=done.remove count=other act=remove role=thing role=number text="am șters {number} de {thing:num=pl}." example="Am șters 20 de case." core.source="hand-core 1"
@w.lang.ro.reply.done.change.one w.lang.ro.reply name=done.change count=one act=change role=thing role=value text="{thing:def=yes} este acum {value@thing}." example="Casa este acum roșie." core.source="hand-core 1"
@w.lang.ro.reply.done.change.few w.lang.ro.reply name=done.change count=few act=change role=thing role=number role=value text="cele {number} {thing:num=pl} sunt acum {value:num=pl@thing}." example="Cele 3 case sunt acum roșii." core.source="hand-core 1"
@w.lang.ro.reply.done.change.other w.lang.ro.reply name=done.change count=other act=change role=thing role=number role=value text="cele {number} de {thing:num=pl} sunt acum {value:num=pl@thing}." example="Cele 20 de case sunt acum roșii." core.source="hand-core 1"
@w.lang.ro.reply.done.connect.one w.lang.ro.reply name=done.connect count=one act=connect role=thing role=target text="am conectat {thing:def=yes} cu {target:def=yes}." example="Am conectat casa cu copacul." core.source="hand-core 1"
@w.lang.ro.reply.done.undo.one w.lang.ro.reply name=done.undo count=one act=undo text="am anulat ultima schimbare." example="Am anulat ultima schimbare." core.source="hand-core 1"
@w.lang.ro.reply.not_understood.one w.lang.ro.reply name=not_understood count=one role=words text="nu am înțeles: {words}." example="Nu am înțeles: blorp." core.source="hand-core 1"
@w.lang.ro.reply.not_understood.all.one w.lang.ro.reply name=not_understood.all count=one text="nu am înțeles ce vrei să spui." example="Nu am înțeles ce vrei să spui." core.source="hand-core 1"
@w.lang.ro.reply.did_you_mean.one w.lang.ro.reply name=did_you_mean count=one role=request text="ai vrut să spui: {request}?" example="Ai vrut să spui: adaugă o casă?" core.source="hand-core 1"
@w.lang.ro.reply.welcome.one w.lang.ro.reply name=welcome count=one act=thank text="cu plăcere." example="Cu plăcere." core.source="hand-core 1"
@w.lang.ro.reply.hello.one w.lang.ro.reply name=hello count=one act=greet text="salut!" example="Salut!" core.source="hand-core 1"
@w.lang.ro.reply.goodbye.one w.lang.ro.reply name=goodbye count=one act=farewell text="la revedere!" example="La revedere!" core.source="hand-core 1"

# the kit's reply names (the library's Q82: KIT_REPLIES of src/kit.mjs) and person.know.none (psys2 Q32)
@w.lang.ro.reply.done.redo.one w.lang.ro.reply name=done.redo count=one text="am refăcut ultima schimbare." core.source="hand-core 1"
@w.lang.ro.reply.nothing.undo.one w.lang.ro.reply name=nothing.undo count=one text="nu am nimic de anulat." core.source="hand-core 1"
@w.lang.ro.reply.nothing.redo.one w.lang.ro.reply name=nothing.redo count=one text="nu am nimic de refăcut." core.source="hand-core 1"
@w.lang.ro.reply.ask.key.one w.lang.ro.reply name=ask.key count=one role=key text="ce {key}?" core.source="hand-core 1"
@w.lang.ro.reply.ask.make_missing.one w.lang.ro.reply name=ask.make_missing count=one role=name role=kind text="încă nu există {kind:def=yes} {name}. Să adaug {art@kind} {kind} {name}?" core.source="hand-core 1"
@w.lang.ro.reply.ask.which_world.one w.lang.ro.reply name=ask.which_world count=one role=worlds text="la care te referi: {worlds}?" core.source="hand-core 1"
@w.lang.ro.reply.ask.count.one w.lang.ro.reply name=ask.count count=one role=given role=number text="asta înseamnă {given}; îmi trebuie {number}." core.source="hand-core 1"
@w.lang.ro.reply.ask.count.few w.lang.ro.reply name=ask.count count=few role=given role=number text="asta înseamnă {given}; îmi trebuie {number}." core.source="hand-core 1"
@w.lang.ro.reply.ask.count.other w.lang.ro.reply name=ask.count count=other role=given role=number text="asta înseamnă {given}; îmi trebuie {number}." core.source="hand-core 1"
@w.lang.ro.reply.not_understood.fragment.one w.lang.ro.reply name=not_understood.fragment count=one text="acesta este doar un fragment." core.source="hand-core 1"
@w.lang.ro.reply.not_understood.statement.one w.lang.ro.reply name=not_understood.statement count=one text="am luat asta drept o afirmație, nu drept o cerere." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_place.one w.lang.ro.reply name=refused.no_place count=one role=kind role=rel role=place text="{art@kind} {kind} nu are loc {rel} {place}." core.source="hand-core 1"
@w.lang.ro.reply.refused.cannot_be.one w.lang.ro.reply name=refused.cannot_be count=one role=thing role=value text="{thing:def=yes} nu poate fi {value@thing}." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_such.one w.lang.ro.reply name=refused.no_such count=one role=thing text="aici nu există {art@thing} {thing}." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_world.one w.lang.ro.reply name=refused.no_world count=one text="nicio lume de aici nu primește asta." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_host.one w.lang.ro.reply name=refused.no_host count=one text="niciun program de aici nu primește asta." core.source="hand-core 1"
@w.lang.ro.reply.refused.fragment.one w.lang.ro.reply name=refused.fragment count=one role=value text="{value} este doar un fragment." core.source="hand-core 1"
@w.lang.ro.reply.refused.value.one w.lang.ro.reply name=refused.value count=one role=key role=value role=values text="{key:def=yes} poate fi doar {values}, nu {value}." core.source="hand-core 1"
@w.lang.ro.reply.refused.one w.lang.ro.reply name=refused count=one role=why text="{why}" core.source="hand-core 1"
@w.lang.ro.reply.too_complex.none.one w.lang.ro.reply name=too_complex.none count=one text="a durat prea mult; nu am schimbat nimic." core.source="hand-core 1"
@w.lang.ro.reply.too_complex.rest.one w.lang.ro.reply name=too_complex.rest count=one text="a durat prea mult; restul nu l-am făcut." core.source="hand-core 1"
@w.lang.ro.reply.answer.no.one w.lang.ro.reply name=answer.no count=one text="bine." core.source="hand-core 1"
@w.lang.ro.reply.why.asked.one w.lang.ro.reply name=why.asked count=one role=request text="ai cerut: {request}." core.source="hand-core 1"
@w.lang.ro.reply.why.told.one w.lang.ro.reply name=why.told count=one role=key role=value text="{key:def=yes} este {value} pentru că așa ai spus." core.source="hand-core 1"
@w.lang.ro.reply.why.default.one w.lang.ro.reply name=why.default count=one role=key role=value text="{key:def=yes} este {value} implicit." core.source="hand-core 1"
@w.lang.ro.reply.why.other.one w.lang.ro.reply name=why.other count=one role=key role=value role=tier text="{key:def=yes} este {value} ({tier})." core.source="hand-core 1"
@w.lang.ro.reply.why.nothing.one w.lang.ro.reply name=why.nothing count=one text="nu s-a schimbat nimic." core.source="hand-core 1"
@w.lang.ro.reply.why.none.one w.lang.ro.reply name=why.none count=one text="nu am făcut nimic." core.source="hand-core 1"
@w.lang.ro.reply.refused.not_allowed.one w.lang.ro.reply name=refused.not_allowed count=one role=kind text="asta nu se poate face cu {art@kind} {kind} aici." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_world_kind.one w.lang.ro.reply name=refused.no_world_kind count=one role=kind text="nicio lume de aici nu are {art@kind} {kind}." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_key.one w.lang.ro.reply name=refused.no_key count=one role=kind role=key text="{art@kind} {kind} nu are {key}." core.source="hand-core 1"
@w.lang.ro.reply.refused.not_a_number.one w.lang.ro.reply name=refused.not_a_number count=one role=key role=thing text="{key:def=yes} {thing:def=yes,case=gendat} nu este un număr." core.source="hand-core 1"
@w.lang.ro.reply.refused.missing_value.one w.lang.ro.reply name=refused.missing_value count=one role=key text="ce {key} să fie?" core.source="hand-core 1"
@w.lang.ro.reply.refused.which.one w.lang.ro.reply name=refused.which count=one role=kind text="care {kind}?" core.source="hand-core 1"
@w.lang.ro.reply.refused.which.few w.lang.ro.reply name=refused.which count=few role=kind role=number text="care {kind}? sunt {number}." core.source="hand-core 1"
@w.lang.ro.reply.refused.which.other w.lang.ro.reply name=refused.which count=other role=kind role=number text="care {kind}? sunt {number}." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_room.one w.lang.ro.reply name=refused.no_room count=one role=kind text="nu mai este loc pentru încă {art@kind} {kind}." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_world_named.one w.lang.ro.reply name=refused.no_world_named count=one role=world text="nu există lumea {world}." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_kind_in.one w.lang.ro.reply name=refused.no_kind_in count=one role=kind role=world text="în {world} nu există {art@kind} {kind}." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_relation.one w.lang.ro.reply name=refused.no_relation count=one role=relation text="aici nu există relația {relation}." core.source="hand-core 1"
@w.lang.ro.reply.refused.no_aspect.one w.lang.ro.reply name=refused.no_aspect count=one role=kind role=aspect text="{art@kind} {kind} nu are {aspect}." core.source="hand-core 1"
@w.lang.ro.reply.refused.nothing_to_show.one w.lang.ro.reply name=refused.nothing_to_show count=one role=view text="nimic de aici nu are ce arată vederea {view}." core.source="hand-core 1"
@w.lang.ro.reply.refused.bad_value.one w.lang.ro.reply name=refused.bad_value count=one role=key text="aici asta nu este {art@key} {key}." core.source="hand-core 1"
@w.lang.ro.reply.person.know.none.one w.lang.ro.reply name=person.know.none count=one text="încă nu știu nimic despre tine." core.source="hand-core 1"

# the indefinite article: the lemma un of w.lang.ro (det.art), its form chosen by the gender and number of the noun
# (o casă, un copac): the template says it, a caller gives no article (the library's Q79)
@w.lang.ro.fill.done_make.art w.lang.ro.fill template=done.make role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.done_make_value.art w.lang.ro.fill template=done.make.value role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.done_make_shape.art w.lang.ro.fill template=done.make.shape role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.done_add.art w.lang.ro.fill template=done.add role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.ask_make_missing.art w.lang.ro.fill template=ask.make_missing role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_no_place.art w.lang.ro.fill template=refused.no_place role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_no_such.art w.lang.ro.fill template=refused.no_such role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_not_allowed.art w.lang.ro.fill template=refused.not_allowed role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_no_world_kind.art w.lang.ro.fill template=refused.no_world_kind role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_no_key.art w.lang.ro.fill template=refused.no_key role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_no_room.art w.lang.ro.fill template=refused.no_room role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_no_kind_in.art w.lang.ro.fill template=refused.no_kind_in role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_no_aspect.art w.lang.ro.fill template=refused.no_aspect role=art lemma=un core.source="hand-core 1"
@w.lang.ro.fill.refused_bad_value.art w.lang.ro.fill template=refused.bad_value role=art lemma=un core.source="hand-core 1"

# The replies of a request and its revision (reviewer block 2026-11-15 14:00: w.request, w.dialogue): the same names as w.lang.en.
@w.lang.ro.reply.sorry.one w.lang.ro.reply name=sorry count=one text="îmi pare rău, mai încerc o dată." example="Îmi pare rău, mai încerc o dată." core.source="hand-core 1"
@w.lang.ro.reply.assumed.one w.lang.ro.reply name=assumed count=one role=key role=value text="am presupus {value} pentru {key:def=yes}." example="Am presupus 7 pentru numărul." core.source="hand-core 1"
@w.lang.ro.reply.not_honoured.one w.lang.ro.reply name=not_honoured count=one role=words role=why text="nu am putut face {words}: {why}." example="Nu am putut face în colț: o diagramă nu are colțuri." core.source="hand-core 1"
@w.lang.ro.reply.unread.one w.lang.ro.reply name=unread count=one role=words text="nu am folosit: {words}." example="Nu am folosit: blorp." core.source="hand-core 1"
@w.lang.ro.reply.done.revise.one w.lang.ro.reply name=done.revise count=one text="am refăcut-o, cum ai spus." example="Am refăcut-o, cum ai spus." core.source="hand-core 1"
