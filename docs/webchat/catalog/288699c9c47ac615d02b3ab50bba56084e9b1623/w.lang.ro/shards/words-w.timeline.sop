# w.lang.ro/shards/words-w.timeline: the Romanian word for each kind of the world schema w.timeline (the library's Q79, reviewer 16:45),
# so a host names a kind in Romanian with no wordOf of its own; the word is a lemma of the hand dictionary where it has
# one (its gender and plural from its class: masă, mese). Not in English vocab.json (an English index).
# sources: hand-core 1 (written by hand in this repository)
# license: CC0-1.0
# script: none (hand-written)

@w.lang.ro.word.w.timeline.world core.word text="cronologie" means=w.timeline of=std.schema.world.name core.source="hand-core 1"
@w.lang.ro.word.w.timeline.timeline core.word text="cronologie" means=w.timeline.timeline core.source="hand-core 1"
@w.lang.ro.word.w.timeline.event core.word text="eveniment" means=w.timeline.event core.source="hand-core 1"
