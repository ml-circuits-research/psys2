@k.layouts.handle.lake.shore_point_6_variant_3 k.layouts.handle of=lake name=shore_point_6_variant_3 n=5 role=outline variant=3 x=22 y=72 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_7_variant_3 k.layouts.handle of=lake name=shore_point_7_variant_3 n=6 role=outline variant=3 x=4 y=52 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_8_variant_3 k.layouts.handle of=lake name=shore_point_8_variant_3 n=7 role=outline variant=3 x=20 y=32 w=0 h=0 core.source="hand-core 1"
@k.layouts.terrain_part.lake.shore k.layouts.terrain_part of=lake name=shore form=shore grow=8 colour=beige rgb="#dccb98" z=0 core.source="hand-core 1"
@k.layouts.terrain_part.lake.water k.layouts.terrain_part of=lake name=water form=fill colour=blue rgb="#4f9fdc" z=1 core.source="hand-core 1"
@k.layouts.terrain_part.lake.deep_water k.layouts.terrain_part of=lake name=deep_water form=shore grow=-50 colour=blue rgb="#3f8bc9" z=2 core.source="hand-core 1"

# pond: a small round water with a muddy rim.
@k.layouts.terrain.pond k.layouts.terrain name=pond form=area lies=ground variants=2 core.source="hand-core 1"
@k.layouts.handle.pond.rim_point_1_variant_1 k.layouts.handle of=pond name=rim_point_1_variant_1 n=0 role=outline variant=1 x=50 y=25 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.pond.rim_point_2_variant_1 k.layouts.handle of=pond name=rim_point_2_variant_1 n=1 role=outline variant=1 x=78 y=30 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.pond.rim_point_3_variant_1 k.layouts.handle of=pond name=rim_point_3_variant_1 n=2 role=outline variant=1 x=92 y=50 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.pond.rim_point_4_variant_1 k.layouts.handle of=pond name=rim_point_4_variant_1 n=3 role=outline variant=1 x=80 y=70 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.pond.rim_point_5_variant_1 k.layouts.handle of=pond name=rim_point_5_variant_1 n=4 role=outline variant=1 x=50 y=76 w=0 h=0 core.source="hand-core 1"
