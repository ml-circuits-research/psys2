# hill: a rounded ridge standing on the horizon, closed along its foot.
@k.layouts.terrain.hill k.layouts.terrain name=hill form=silhouette lies=horizon core.source="hand-core 1"
@k.layouts.handle.hill.left_foot k.layouts.handle of=hill name=left_foot n=0 role=outline x=0 y=100 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.hill.left_slope k.layouts.handle of=hill name=left_slope n=1 role=outline x=20 y=62 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.hill.top k.layouts.handle of=hill name=top n=2 role=peak x=46 y=40 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.hill.right_slope k.layouts.handle of=hill name=right_slope n=3 role=outline x=74 y=55 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.hill.right_foot k.layouts.handle of=hill name=right_foot n=4 role=outline x=100 y=100 w=0 h=0 core.source="hand-core 1"
@k.layouts.terrain_part.hill.slope k.layouts.terrain_part of=hill name=slope form=fill colour=green rgb="#7db455" z=1 core.source="hand-core 1"

# mountain: a ridge with a high peak on the horizon, snow on the peak.
@k.layouts.terrain.mountain k.layouts.terrain name=mountain form=silhouette lies=horizon core.source="hand-core 1"
@k.layouts.handle.mountain.left_foot k.layouts.handle of=mountain name=left_foot n=0 role=outline x=0 y=100 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.mountain.left_ridge k.layouts.handle of=mountain name=left_ridge n=1 role=outline x=28 y=48 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.mountain.peak k.layouts.handle of=mountain name=peak n=2 role=peak x=46 y=10 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.mountain.saddle k.layouts.handle of=mountain name=saddle n=3 role=outline x=62 y=40 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.mountain.shoulder k.layouts.handle of=mountain name=shoulder n=4 role=outline x=76 y=28 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.mountain.right_foot k.layouts.handle of=mountain name=right_foot n=5 role=outline x=100 y=100 w=0 h=0 core.source="hand-core 1"
@k.layouts.terrain_part.mountain.rock k.layouts.terrain_part of=mountain name=rock form=fill colour=grey rgb="#8a8d99" z=1 core.source="hand-core 1"
@k.layouts.terrain_part.mountain.snow k.layouts.terrain_part of=mountain name=snow form=cap grow=24 colour=white rgb="#ffffff" z=2 core.source="hand-core 1"
