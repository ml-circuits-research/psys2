# k.layouts/shards/terrain: terrain features drawn from handles (owner, 2026-11-20): the view (sky and ground with
# its horizon), river, road, lake, pond, hill, mountain: their form, where they lie in depth, their handles and drawn parts.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# landscape: the whole view; raising its horizon makes more sky and less ground.
@k.layouts.terrain.landscape k.layouts.terrain name=landscape form=view lies=view core.source="hand-core 1"
@k.layouts.handle.landscape.horizon k.layouts.handle of=landscape name=horizon n=0 role=horizon x=50 y=50 w=100 h=0 core.source="hand-core 1"
@k.layouts.terrain_part.landscape.sky_high k.layouts.terrain_part of=landscape name=sky_high form=above from=0 to=40 colour="light blue" rgb="#7fbfee" z=0 core.source="hand-core 1"
@k.layouts.terrain_part.landscape.sky_middle k.layouts.terrain_part of=landscape name=sky_middle form=above from=40 to=75 colour="light blue" rgb="#a3d3f4" z=1 core.source="hand-core 1"
@k.layouts.terrain_part.landscape.sky_low k.layouts.terrain_part of=landscape name=sky_low form=above from=75 to=100 colour="light blue" rgb="#c8e5f8" z=2 core.source="hand-core 1"
@k.layouts.terrain_part.landscape.ground_far k.layouts.terrain_part of=landscape name=ground_far form=below from=0 to=25 colour="light green" rgb="#bddc90" z=3 core.source="hand-core 1"
@k.layouts.terrain_part.landscape.ground_middle k.layouts.terrain_part of=landscape name=ground_middle form=below from=25 to=60 colour="light green" rgb="#a4cf74" z=4 core.source="hand-core 1"
@k.layouts.terrain_part.landscape.ground_near k.layouts.terrain_part of=landscape name=ground_near form=below from=60 to=100 colour=green rgb="#8cc15c" z=5 core.source="hand-core 1"

# river: a band from the horizon (narrow, far away) bending towards the front (wide); its banks follow the water.
@k.layouts.terrain.river k.layouts.terrain name=river form=band lies=through core.source="hand-core 1"
@k.layouts.handle.river.source k.layouts.handle of=river name=source n=0 role=start x=50 y=0 w=5 h=0 core.source="hand-core 1"
@k.layouts.handle.river.bend k.layouts.handle of=river name=bend n=1 role=bend x=38 y=48 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.river.mouth k.layouts.handle of=river name=mouth n=2 role=end x=56 y=100 w=36 h=0 core.source="hand-core 1"
@k.layouts.terrain_part.river.water k.layouts.terrain_part of=river name=water form=fill colour=blue rgb="#4f9fdc" z=1 core.source="hand-core 1"
@k.layouts.terrain_part.river.left_bank k.layouts.terrain_part of=river name=left_bank form=edge side=left colour=olive rgb="#6d8c3e" z=2 core.source="hand-core 1"
@k.layouts.terrain_part.river.right_bank k.layouts.terrain_part of=river name=right_bank form=edge side=right colour=olive rgb="#6d8c3e" z=2 core.source="hand-core 1"
@k.layouts.terrain_part.river.current k.layouts.terrain_part of=river name=current form=middle colour=white rgb="#d4ecfb" z=3 core.source="hand-core 1"

# road: a band from the horizon to the front, with kerbs on both sides and dashed lane marks in the middle.
@k.layouts.terrain.road k.layouts.terrain name=road form=band lies=through core.source="hand-core 1"
@k.layouts.handle.road.far_end k.layouts.handle of=road name=far_end n=0 role=start x=50 y=0 w=4 h=0 core.source="hand-core 1"
@k.layouts.handle.road.bend k.layouts.handle of=road name=bend n=1 role=bend x=50 y=50 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.road.near_end k.layouts.handle of=road name=near_end n=2 role=end x=50 y=100 w=46 h=0 core.source="hand-core 1"
@k.layouts.terrain_part.road.surface k.layouts.terrain_part of=road name=surface form=fill colour=grey rgb="#7f858d" z=1 core.source="hand-core 1"
@k.layouts.terrain_part.road.left_kerb k.layouts.terrain_part of=road name=left_kerb form=edge side=left colour=beige rgb="#e2dbca" z=2 core.source="hand-core 1"
@k.layouts.terrain_part.road.right_kerb k.layouts.terrain_part of=road name=right_kerb form=edge side=right colour=beige rgb="#e2dbca" z=2 core.source="hand-core 1"
@k.layouts.terrain_part.road.lane k.layouts.terrain_part of=road name=lane form=middle colour=white rgb="#ffffff" z=3 core.source="hand-core 1"

# lake: water inside an irregular outline (three variants), a sandy shore around it that follows the water, a deeper middle.
@k.layouts.terrain.lake k.layouts.terrain name=lake form=area lies=ground variants=3 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_1_variant_1 k.layouts.handle of=lake name=shore_point_1_variant_1 n=0 role=outline variant=1 x=50 y=22 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_2_variant_1 k.layouts.handle of=lake name=shore_point_2_variant_1 n=1 role=outline variant=1 x=74 y=25 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_3_variant_1 k.layouts.handle of=lake name=shore_point_3_variant_1 n=2 role=outline variant=1 x=95 y=40 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_4_variant_1 k.layouts.handle of=lake name=shore_point_4_variant_1 n=3 role=outline variant=1 x=90 y=62 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_5_variant_1 k.layouts.handle of=lake name=shore_point_5_variant_1 n=4 role=outline variant=1 x=68 y=78 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_6_variant_1 k.layouts.handle of=lake name=shore_point_6_variant_1 n=5 role=outline variant=1 x=40 y=75 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_7_variant_1 k.layouts.handle of=lake name=shore_point_7_variant_1 n=6 role=outline variant=1 x=12 y=64 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_8_variant_1 k.layouts.handle of=lake name=shore_point_8_variant_1 n=7 role=outline variant=1 x=8 y=38 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_1_variant_2 k.layouts.handle of=lake name=shore_point_1_variant_2 n=0 role=outline variant=2 x=40 y=24 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_2_variant_2 k.layouts.handle of=lake name=shore_point_2_variant_2 n=1 role=outline variant=2 x=66 y=20 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_3_variant_2 k.layouts.handle of=lake name=shore_point_3_variant_2 n=2 role=outline variant=2 x=92 y=34 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_4_variant_2 k.layouts.handle of=lake name=shore_point_4_variant_2 n=3 role=outline variant=2 x=94 y=56 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_5_variant_2 k.layouts.handle of=lake name=shore_point_5_variant_2 n=4 role=outline variant=2 x=76 y=74 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_6_variant_2 k.layouts.handle of=lake name=shore_point_6_variant_2 n=5 role=outline variant=2 x=52 y=64 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_7_variant_2 k.layouts.handle of=lake name=shore_point_7_variant_2 n=6 role=outline variant=2 x=28 y=78 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_8_variant_2 k.layouts.handle of=lake name=shore_point_8_variant_2 n=7 role=outline variant=2 x=6 y=56 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_1_variant_3 k.layouts.handle of=lake name=shore_point_1_variant_3 n=0 role=outline variant=3 x=55 y=26 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_2_variant_3 k.layouts.handle of=lake name=shore_point_2_variant_3 n=1 role=outline variant=3 x=85 y=30 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_3_variant_3 k.layouts.handle of=lake name=shore_point_3_variant_3 n=2 role=outline variant=3 x=97 y=50 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.lake.shore_point_4_variant_3 k.layouts.handle of=lake name=shore_point_4_variant_3 n=3 role=outline variant=3 x=80 y=72 w=0 h=0 core.source="hand-core 1"
