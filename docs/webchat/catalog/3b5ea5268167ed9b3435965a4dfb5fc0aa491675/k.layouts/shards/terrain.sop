@k.layouts.handle.pond.rim_point_1_variant_2 k.layouts.handle of=pond name=rim_point_1_variant_2 n=0 role=outline variant=2 x=45 y=22 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.pond.rim_point_2_variant_2 k.layouts.handle of=pond name=rim_point_2_variant_2 n=1 role=outline variant=2 x=75 y=26 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.pond.rim_point_3_variant_2 k.layouts.handle of=pond name=rim_point_3_variant_2 n=2 role=outline variant=2 x=94 y=46 w=0 h=0 core.source="hand-core 1"
@k.layouts.handle.pond.rim_point_4_variant_2 k.layouts.handle of=pond name=rim_point_4_variant_2 n=3 role=outline variant=2 x=84 y=70 w=0 h=0 core.source="hand-core 1"
