@w.lang.en.count.other w.lang.en.count class=other samples="@integer 0, 2~16, 100, 1000, 10000, 100000, 1000000, … @decimal 0.0~1.5, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, …" core.source="cldr 48"
