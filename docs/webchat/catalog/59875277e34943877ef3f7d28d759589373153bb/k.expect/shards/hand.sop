# k.expect/shards/hand: the named amounts (a few, several, many, about N), the scale of size and extent (tiny to huge) and the makes of common things (diagram, pond, house, tree, garden, street, story, poem, essay, bar chart, list, song, face) with their parts, hand-checked.
# sources: hand-core 1 (hand-written in this repository: tools/expect-core.mjs)
# license: CC0-1.0
# script: tools/expect-core.mjs

# The named amounts.
@k.expect.amount.one k.expect.amount name=one min=1 max=1 typical=1 about="a single one" core.source="hand-core 1"
@k.expect.amount.couple k.expect.amount name=couple min=2 max=3 typical=2 about="a couple: two, at most three" core.source="hand-core 1"
@k.expect.amount.few k.expect.amount name=few min=2 max=4 typical=3 about="a few: more than one, fewer than five" core.source="hand-core 1"
@k.expect.amount.some k.expect.amount name=some min=2 max=5 typical=3 about="some: a few, not counted" core.source="hand-core 1"
@k.expect.amount.handful k.expect.amount name=handful min=3 max=6 typical=5 about="a handful: about five" core.source="hand-core 1"
@k.expect.amount.several k.expect.amount name=several min=3 max=7 typical=5 about="several: more than a few, fewer than many" core.source="hand-core 1"
@k.expect.amount.many k.expect.amount name=many min=6 max=12 typical=8 about="many, lots of: clearly more than usual" core.source="hand-core 1"
@k.expect.amount.dozen k.expect.amount name=dozen min=12 max=12 typical=12 about="a dozen: twelve" core.source="hand-core 1"
@k.expect.amount.about k.expect.amount name=about min_factor=0.8 max_factor=1.25 about="about N, around N, N or so: from 0.8 to 1.25 times N" core.source="hand-core 1"

# The scale of size and extent.
@k.expect.scale.tiny k.expect.scale step=tiny order=1 count_factor=0.4 size_factor=0.4 extent=0.1 about="tiny: very few parts, each very small, a tenth of the canvas" core.source="hand-core 1"
@k.expect.scale.small k.expect.scale step=small order=2 count_factor=0.6 size_factor=0.7 extent=0.25 about="small, in a corner: fewer parts, smaller, a quarter of the canvas" core.source="hand-core 1"
@k.expect.scale.default k.expect.scale step=default order=3 count_factor=1 size_factor=1 extent=0.6 about="what is made when no size is said: the typical count, most of the canvas with a margin" core.source="hand-core 1"
@k.expect.scale.big k.expect.scale step=big order=4 count_factor=1.5 size_factor=1.4 extent=0.85 about="big, large: more parts, bigger, almost the whole canvas" core.source="hand-core 1"
@k.expect.scale.huge k.expect.scale step=huge order=5 count_factor=2.2 size_factor=2 extent=1 about="huge, the whole page: many more parts, the whole canvas" core.source="hand-core 1"

# The makes of common things, hand-checked.
@k.expect.make.diagram k.expect.make thing=diagram made_in=diagram unit=node min=5 max=9 typical=7 kinds_min=2 kinds_max=3 layout=top_down extent=default varies=count varies=kinds varies=layout varies=colour about="a diagram with no kind said: 5 to 9 nodes (seven plus or minus two, what a reader takes in at once) of two or three shapes, joined by links, in a named layout" core.source="hand-core 1"
@k.expect.part.diagram.node k.expect.part of=diagram part=node group=node min=5 max=9 typical=7 needed=yes shape=rectangle shape=rounded_rectangle shape=circle shape=diamond shape=oval core.source="hand-core 1"
@k.expect.part.diagram.link k.expect.part of=diagram part=link group=link min=4 max=12 typical=7 needed=yes core.source="hand-core 1"
@k.expect.make.pond k.expect.make thing=pond made_in=drawing unit=part min=4 max=9 typical=6 kinds_min=3 kinds_max=4 layout=free extent=default scene=pond varies=count varies=kinds varies=place about="a pond: water, a few water plants and one or two animals, a stone or grass at the edge" core.source="hand-core 1"
@k.expect.part.pond.water k.expect.part of=pond part=water group=water min=1 max=1 typical=1 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.pond.water_lily k.expect.part of=pond part="water lily" group=plant min=2 max=5 typical=3 where=water core.source="hand-core 1"
@k.expect.part.pond.reed k.expect.part of=pond part=reed group=plant min=0 max=4 typical=2 where=water core.source="hand-core 1"
@k.expect.part.pond.duck k.expect.part of=pond part=duck group=animal min=0 max=2 typical=1 where=water core.source="hand-core 1"
@k.expect.part.pond.frog k.expect.part of=pond part=frog group=animal min=0 max=2 typical=1 where=water core.source="hand-core 1"
@k.expect.part.pond.goldfish k.expect.part of=pond part=goldfish group=animal min=0 max=3 typical=1 where=water core.source="hand-core 1"
@k.expect.part.pond.stone k.expect.part of=pond part=stone group=ground min=0 max=3 typical=2 where=foreground core.source="hand-core 1"
@k.expect.part.pond.grass k.expect.part of=pond part=grass group=ground min=0 max=5 typical=3 where=foreground core.source="hand-core 1"
@k.expect.make.house k.expect.make thing=house made_in=drawing unit=part min=4 max=9 typical=6 kinds_min=4 kinds_max=6 layout=free extent=default varies=colour varies=kinds varies=size about="a house: walls, a roof, a door and two to four windows; a chimney often" core.source="hand-core 1"
@k.expect.part.house.wall k.expect.part of=house part=wall group=body min=1 max=1 typical=1 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.house.roof k.expect.part of=house part=roof group=body min=1 max=1 typical=1 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.house.door k.expect.part of=house part=door group=opening min=1 max=2 typical=1 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.house.window k.expect.part of=house part=window group=opening min=1 max=6 typical=2 where=ground core.source="hand-core 1"
@k.expect.part.house.chimney k.expect.part of=house part=chimney group=body min=0 max=1 typical=1 where=ground core.source="hand-core 1"
@k.expect.make.tree k.expect.make thing=tree made_in=drawing unit=part min=2 max=4 typical=2 kinds_min=2 kinds_max=3 layout=free extent=default varies=colour varies=size about="a tree: a trunk and a crown of leaves; fruit or a bird sometimes" core.source="hand-core 1"
@k.expect.part.tree.trunk k.expect.part of=tree part=trunk group=body min=1 max=1 typical=1 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.tree.crown k.expect.part of=tree part=crown group=body min=1 max=1 typical=1 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.tree.fruit k.expect.part of=tree part=fruit group=extra min=0 max=8 typical=0 where=ground core.source="hand-core 1"
@k.expect.make.garden k.expect.make thing=garden made_in=drawing unit=part min=5 max=14 typical=9 kinds_min=3 kinds_max=5 layout=free extent=default scene=garden varies=count varies=kinds varies=place varies=colour about="a garden: grass, flowers, a tree or a bush, maybe a fence and a bench, a butterfly or a bird" core.source="hand-core 1"
@k.expect.part.garden.grass k.expect.part of=garden part=grass group=ground min=1 max=1 typical=1 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.garden.flower k.expect.part of=garden part=flower group=plant min=3 max=10 typical=5 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.garden.tree k.expect.part of=garden part=tree group=plant min=0 max=2 typical=1 where=ground core.source="hand-core 1"
@k.expect.part.garden.bush k.expect.part of=garden part=bush group=plant min=0 max=3 typical=1 where=ground core.source="hand-core 1"
@k.expect.part.garden.fence k.expect.part of=garden part=fence group=building min=0 max=1 typical=1 where=background core.source="hand-core 1"
@k.expect.part.garden.bench k.expect.part of=garden part=bench group=building min=0 max=1 typical=0 where=ground core.source="hand-core 1"
@k.expect.part.garden.butterfly k.expect.part of=garden part=butterfly group=animal min=0 max=3 typical=1 where=sky core.source="hand-core 1"
@k.expect.part.garden.bird k.expect.part of=garden part=bird group=animal min=0 max=2 typical=1 where=sky core.source="hand-core 1"
@k.expect.make.street k.expect.make thing=street made_in=drawing unit=part min=5 max=14 typical=9 kinds_min=3 kinds_max=5 layout=row extent=default scene="city street" varies=count varies=kinds varies=colour about="a street: a road, houses or shops along it, a car or two, a tree, a lamp" core.source="hand-core 1"
@k.expect.part.street.road k.expect.part of=street part=road group=ground min=1 max=1 typical=1 needed=yes where=ground core.source="hand-core 1"
@k.expect.part.street.house k.expect.part of=street part=house group=building min=2 max=6 typical=3 needed=yes where=background core.source="hand-core 1"
@k.expect.part.street.car k.expect.part of=street part=car group=vehicle min=0 max=3 typical=2 where=ground core.source="hand-core 1"
@k.expect.part.street.tree k.expect.part of=street part=tree group=plant min=0 max=4 typical=2 where=background core.source="hand-core 1"
@k.expect.part.street.street_lamp k.expect.part of=street part="street lamp" group=building min=0 max=3 typical=1 where=ground core.source="hand-core 1"
@k.expect.make.story k.expect.make thing=story made_in=document unit=chapter min=1 max=5 typical=3 kinds_min=3 kinds_max=5 extent=default length_unit=word length=400 varies=topic varies=count about="a short story: a beginning, a problem, an end; about 400 words in three chapters or paragraphs, a hero and one or two other characters" core.source="hand-core 1"
@k.expect.part.story.chapter k.expect.part of=story part=chapter group=text min=1 max=5 typical=3 needed=yes core.source="hand-core 1"
@k.expect.part.story.character k.expect.part of=story part=character group=person min=1 max=4 typical=2 needed=yes core.source="hand-core 1"
@k.expect.make.poem k.expect.make thing=poem made_in=document unit=stanza min=2 max=6 typical=3 kinds_min=1 kinds_max=2 extent=default length_unit=line length=12 varies=topic about="a short poem: three stanzas of four lines" core.source="hand-core 1"
@k.expect.part.poem.stanza k.expect.part of=poem part=stanza group=text min=2 max=6 typical=3 needed=yes core.source="hand-core 1"
@k.expect.make.essay k.expect.make thing=essay made_in=document unit=paragraph min=3 max=7 typical=5 kinds_min=3 kinds_max=3 extent=default length_unit=word length=600 varies=topic about="an essay: an introduction, three body paragraphs, a conclusion; about 600 words" core.source="hand-core 1"
@k.expect.part.essay.paragraph k.expect.part of=essay part=paragraph group=text min=3 max=7 typical=5 needed=yes core.source="hand-core 1"
@k.expect.make.bar_chart k.expect.make thing="bar chart" made_in=chart unit=bar min=3 max=10 typical=6 kinds_min=1 kinds_max=1 extent=default varies=count varies=colour about="a bar chart: 3 to 10 bars, one per category, an axis and labels" core.source="hand-core 1"
@k.expect.part.bar_chart.bar k.expect.part of="bar chart" part=bar group=mark min=3 max=10 typical=6 needed=yes core.source="hand-core 1"
@k.expect.make.list k.expect.make thing=list made_in=list unit=item min=3 max=12 typical=6 kinds_min=1 kinds_max=1 extent=default varies=count about="a list: about six entries" core.source="hand-core 1"
@k.expect.part.list.item k.expect.part of=list part=item group=item min=3 max=12 typical=6 needed=yes core.source="hand-core 1"
@k.expect.make.song k.expect.make thing=song made_in=music unit=bar min=8 max=32 typical=16 kinds_min=1 kinds_max=3 extent=default varies=count about="a short tune: 16 bars of four beats" core.source="hand-core 1"
@k.expect.part.song.bar k.expect.part of=song part=bar group=music min=8 max=32 typical=16 needed=yes core.source="hand-core 1"
@k.expect.make.face k.expect.make thing=face made_in=face unit=part min=5 max=9 typical=7 kinds_min=5 kinds_max=9 extent=default varies=colour varies=kinds about="a face: head, eyes, nose, mouth, hair; ears and eyebrows often" core.source="hand-core 1"
@k.expect.part.face.head k.expect.part of=face part=head group=face min=1 max=1 typical=1 needed=yes slot=head core.source="hand-core 1"
@k.expect.part.face.eye k.expect.part of=face part=eye group=face min=2 max=2 typical=2 needed=yes slot=eyes core.source="hand-core 1"
@k.expect.part.face.mouth k.expect.part of=face part=mouth group=face min=1 max=1 typical=1 needed=yes slot=mouth core.source="hand-core 1"
@k.expect.part.face.nose k.expect.part of=face part=nose group=face min=0 max=1 typical=1 slot=nose core.source="hand-core 1"
@k.expect.part.face.hair k.expect.part of=face part=hair group=face min=0 max=1 typical=1 slot=hair_front slot=hair_back core.source="hand-core 1"
@k.expect.part.face.ear k.expect.part of=face part=ear group=face min=0 max=2 typical=2 slot=ears core.source="hand-core 1"
@k.expect.part.face.eyebrow k.expect.part of=face part=eyebrow group=face min=0 max=2 typical=2 slot=eyebrows core.source="hand-core 1"
