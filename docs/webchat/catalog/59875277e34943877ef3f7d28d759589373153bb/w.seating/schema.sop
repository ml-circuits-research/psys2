# w.seating: a reusable world: a seating plan: tables, their seats, and the guests who sit on them (a wedding, a
# class, a dinner). Declared as data in the library's std.schema format; the acts of std.acts drive it; it has no
# rule and no function of its own but one deny. Version 3 (reviewer 16:45, Q82): a guest is at a table, the seat
# optional; tables and guests have a colour.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)
# needs: sopworld with std.schema and std.acts (tools/sopworld/VERSION, 0.30.0 or later; 0.33.0 for a guest placed on a seat)

@w.seating core.module name=w.seating version=3 exports=table exports=seat exports=guest core.source="hand-core 1"
@w.seating.world std.schema.world name=w.seating doc="a seating plan: tables, seats and the guests on them" core.source="hand-core 1"

# A table. `name` is what it is called (family, 1); `shape` its shape; `seats` how many seats it has room for (a
# table with no `seats` takes any number; a host's usual size is the typical range of k.attributes, 4 to 10, not a
# schema default); `colour` its colour (a basic colour of k.colours, by name; the list of the 11 stays until the library refuses a
# value that meets no join target, reviewer 14:45); `x` and `y` where it stands in the room (the act
# `place` sets `x`).
@w.seating.table core.type of=w.seating.table extends=std.schema.thing closed=true core.source="hand-core 1"
@w.seating.table.name core.slot of=w.seating.table key=name required=true kind=atom kind=string core.source="hand-core 1"
@w.seating.table.shape core.slot of=w.seating.table key=shape enum=round enum=square enum=long default=round core.source="hand-core 1"
@w.seating.table.seats core.slot of=w.seating.table key=seats kind=integer min=1 max=40 step=1 core.source="hand-core 1"
@w.seating.table.colour core.slot of=w.seating.table key=colour enum=black enum=white enum=grey enum=red enum=orange enum=yellow enum=green enum=blue enum=purple enum=pink enum=brown kind=atom type=k.colours.basic by=name core.source="hand-core 1"
@w.seating.table.x core.slot of=w.seating.table key=x kind=number core.source="hand-core 1"
@w.seating.table.y core.slot of=w.seating.table key=y kind=number core.source="hand-core 1"

# A seat at a table. `table` refers to its table; `n` is its place at the table, from 1, going round or along it.
@w.seating.seat core.type of=w.seating.seat extends=std.schema.thing closed=true core.source="hand-core 1"
@w.seating.seat.table core.slot of=w.seating.seat key=table required=true type=w.seating.table core.source="hand-core 1"
@w.seating.seat.n core.slot of=w.seating.seat key=n kind=integer min=1 step=1 core.source="hand-core 1"

# A guest. `name`; `table` refers to the table the guest is at (none: not seated yet); `seat`, where a host has
# seats, refers to the seat the guest sits on, a seat of that same table (a deny says so; the act `place` with a seat
# as `at` puts a guest on it through this slot, sopworld 0.33 or later); `party` names the people the
# guest came with (a family, the bride's side); `needs` (many) what the seat or the meal must allow for
# (vegetarian, "high chair", wheelchair); `colour` the colour the guest is drawn in (a k.colours colour); `note`
# anything else.
@w.seating.guest core.type of=w.seating.guest extends=std.schema.thing closed=true core.source="hand-core 1"
@w.seating.guest.name core.slot of=w.seating.guest key=name required=true kind=atom kind=string core.source="hand-core 1"
@w.seating.guest.table core.slot of=w.seating.guest key=table type=w.seating.table core.source="hand-core 1"
@w.seating.guest.seat core.slot of=w.seating.guest key=seat type=w.seating.seat core.source="hand-core 1"
@w.seating.guest.party core.slot of=w.seating.guest key=party kind=atom kind=string core.source="hand-core 1"
@w.seating.guest.needs core.slot of=w.seating.guest key=needs many=true kind=atom kind=string core.source="hand-core 1"
@w.seating.guest.colour core.slot of=w.seating.guest key=colour enum=black enum=white enum=grey enum=red enum=orange enum=yellow enum=green enum=blue enum=purple enum=pink enum=brown kind=atom type=k.colours.basic by=name core.source="hand-core 1"
@w.seating.guest.note core.slot of=w.seating.guest key=note kind=string core.source="hand-core 1"

# The kinds and the acts that apply to them. Tables can be placed in the room, linked (connect: next to, far from)
# and grouped (the tables in the garden); guests can be linked (next to, not next to), grouped, copied and placed on
# a seat. A table holds at most its `seats` guests (std.schema.capacity: one guest more at it is refused, and so
# is a `seats` below the guests at it; version 2 counted seats, and the engine takes one capacity per kind: guests are
# what "a table for 4" counts). At most 50 tables, 500 seats and 500 guests.
@w.seating.kind.table std.schema.kind of=w.seating.table world=w.seating acts=make acts=remove acts=change acts=place acts=connect acts=group acts=pick acts=ask acts=copy core.source="hand-core 1"
@w.seating.kind.seat std.schema.kind of=w.seating.seat world=w.seating acts=make acts=remove acts=change acts=pick acts=ask acts=copy core.source="hand-core 1"
@w.seating.kind.guest std.schema.kind of=w.seating.guest world=w.seating acts=make acts=remove acts=change acts=place acts=connect acts=group acts=pick acts=ask acts=copy core.source="hand-core 1"
@w.seating.room std.schema.capacity of=w.seating.table key=seats holds=w.seating.guest via=table core.source="hand-core 1"
# A guest on a seat is at the table of that seat (a host that has seats sets both; one without seats sets the table).
@w.seating.same.seat w.seating.seat table=?seat_table
@w.seating.same.guest w.seating.guest seat=$w.seating.same.seat table=?guest_table
@w.seating.same.differ core.check fn=neq args=?seat_table args=?guest_table
@w.seating.same core.deny when=$w.seating.same.seat when=$w.seating.same.guest if=$w.seating.same.differ why="A guest on a seat is at the table of that seat." core.source="hand-core 1"
@w.seating.limit.table std.schema.limit of=w.seating.table max=50 core.source="hand-core 1"
@w.seating.limit.seat std.schema.limit of=w.seating.seat max=500 core.source="hand-core 1"
@w.seating.limit.guest std.schema.limit of=w.seating.guest max=500 core.source="hand-core 1"

# Words: for the world (how a host finds it by name), its kinds and its keys.
