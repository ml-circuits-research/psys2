# k.motion/shards/words: the owned English vocabulary, separate from the schema.
# sources: hand-core 1 (hand-written declarations and deterministic key vocabulary)
# license: CC0-1.0
# script: none (hand-written; generated key block maintained by tools/key-words.mjs)

@k.motion.word.motion core.word text=motion text=animation text=animate text=move text=moves means=k.motion.rule core.source="hand-core 1"
