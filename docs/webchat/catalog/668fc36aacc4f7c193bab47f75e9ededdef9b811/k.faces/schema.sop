@k.faces.preset.shoulders core.slot of=k.faces.preset key=shoulders kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.skin core.slot of=k.faces.preset key=skin required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.hair_colour core.slot of=k.faces.preset key=hair_colour required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.eye_colour core.slot of=k.faces.preset key=eye_colour required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.clothes core.slot of=k.faces.preset key=clothes required=true kind=atom kind=string type=k.colours.colour by=name core.source="hand-core 1"

# An expression: the variants of mouth, eyebrows and eyes a face switches to (a key left out stays as the face has
# it). `one_eye`: the variant for the eye on the viewer's right only (a wink). `mouth_alt`: the second mouth of a
# pair that alternates (talking: open, closed).
@k.faces.expression core.type of=k.faces.expression shared=true closed=true core.source="hand-core 1"
@k.faces.expression.name core.slot of=k.faces.expression key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.style core.slot of=k.faces.expression key=style required=true kind=atom kind=string type=k.faces.canon by=style core.source="hand-core 1"
@k.faces.expression.mouth core.slot of=k.faces.expression key=mouth kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.mouth_alt core.slot of=k.faces.expression key=mouth_alt kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.eyebrows core.slot of=k.faces.expression key=eyebrows kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.eyes core.slot of=k.faces.expression key=eyes kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.one_eye core.slot of=k.faces.expression key=one_eye kind=atom kind=string core.source="hand-core 1"

# Sparse cartoon expression goals select compatible constituent features, not one fixed whole face.
@k.faces.expression.goal core.type of=k.faces.expression.goal shared=true closed=true core.source="hand-core 1"
@k.faces.expression.goal.expression core.slot of=k.faces.expression.goal key=expression required=true kind=atom type=k.faces.expression by=name core.source="hand-core 1"
@k.faces.expression.goal.slot core.slot of=k.faces.expression.goal key=slot required=true kind=atom type=k.faces.slot by=name core.source="hand-core 1"
@k.faces.expression.goal.property core.slot of=k.faces.expression.goal key=property required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.goal.value core.slot of=k.faces.expression.goal key=value required=true kind=atom kind=string core.source="hand-core 1"

# The proportion canon of a style (Q47): where the eyes, brows, nose, mouth and ears of its faces go, as fractions of
# the box of the style's slot `head` (0 at its top or left, 1 at its bottom or right). `eye_line`, `nose_line` (the
# bottom of the nose), `mouth_line`: heights; `eye_width`: a fraction of the head's width; `eye_gap` (the space
# between the eyes) and `brow_above` (the brow line above the eye line): in eye widths. The ears lie between the
# brow line and the nose line. A host that draws a new part for the style places it by these lines.
@k.faces.canon core.type of=k.faces.canon shared=true closed=true core.source="hand-core 1"
@k.faces.canon.style core.slot of=k.faces.canon key=style id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.canon.name core.slot of=k.faces.canon key=name required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.canon.eye_line core.slot of=k.faces.canon key=eye_line required=true kind=number min=0 max=1 core.source="hand-core 1"
@k.faces.canon.nose_line core.slot of=k.faces.canon key=nose_line required=true kind=number min=0 max=1 core.source="hand-core 1"
@k.faces.canon.mouth_line core.slot of=k.faces.canon key=mouth_line required=true kind=number min=0 max=1 core.source="hand-core 1"
@k.faces.canon.eye_width core.slot of=k.faces.canon key=eye_width required=true kind=number min=0 max=1 core.source="hand-core 1"
@k.faces.canon.eye_gap core.slot of=k.faces.canon key=eye_gap required=true kind=number min=0 core.source="hand-core 1"
@k.faces.canon.brow_above core.slot of=k.faces.canon key=brow_above required=true kind=number min=0 core.source="hand-core 1"
@k.faces.canon.about core.slot of=k.faces.canon key=about kind=string core.source="hand-core 1"

# Words for the types and keys of this world.
# the kinds of being a face shows (psys2 Q31): "a person", "a human", "a robot" pick presets by kind
# The names of the slots and the words a person says for each: the slot keeps the style data name (eyes, hair_front), the part kind keeps its singular name (k.expect.part eye, hair; its `slot` key names the slot), the other name is a word here.
