@w.lang.en.phrasing.of core.slot of=w.lang.en.phrasing key=of kind=atom core.source="hand-core 1"
@w.lang.en.phrasing.polarity core.slot of=w.lang.en.phrasing key=polarity enum=yes enum=no core.source="hand-core 1"
@w.lang.en.phrasing.role core.slot of=w.lang.en.phrasing key=role many=true kind=atom core.source="hand-core 1"
@w.lang.en.phrasing.frame core.slot of=w.lang.en.phrasing key=frame required=true kind=atom core.source="hand-core 1"
@w.lang.en.phrasing.text core.slot of=w.lang.en.phrasing key=text required=true kind=string core.source="hand-core 1"
