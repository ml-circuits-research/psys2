# Frames that are variants a general alternation will cover (block "21:05" item 2; the library applies the
# alternations to every canonical frame once): `frame`, `alternation` (a w.lang.en.alternation_family: request
# wrapper, passive, dative shift, verb ellipsis), `canonical` (many) the frames of the same act and mode with none of
# these that take every role the variant takes. Marked, never deleted here: the frames are retired when the library's
# curve says so. Written by tools/lang-en-variants.mjs (shard variants), by rule from the frames' parts.
@w.lang.en.variant core.type of=w.lang.en.variant shared=true closed=true core.source="hand-core 1"
@w.lang.en.variant.frame core.slot of=w.lang.en.variant key=frame id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.variant.alternation core.slot of=w.lang.en.variant key=alternation id=true required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.variant.canonical core.slot of=w.lang.en.variant key=canonical many=true kind=atom core.source="hand-core 1"

# Words a request skips (block "21:05" item 5, asked by the first host): around the content of a request they carry
# no role. `class`: politeness (please), desire (want, like: a wish before the thing asked for), filler (also, just,
# um), conjunction (and, where it joins two things of one role), copula (be), reflexive (yourself, myself: the
# addressee or the speaker as the thing changed), request_preposition (of, on, to, for, with: skipped only by a reader
# that fills the parts of a thing and has no role marked by them). `text` (many) the words; `doc`.
@w.lang.en.skip core.type of=w.lang.en.skip shared=true closed=true core.source="hand-core 1"
@w.lang.en.skip.class core.slot of=w.lang.en.skip key=class id=true required=true enum=politeness enum=desire enum=filler enum=conjunction enum=copula enum=reflexive enum=request_preposition core.source="hand-core 1"
@w.lang.en.skip.text core.slot of=w.lang.en.skip key=text many=true required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.skip.doc core.slot of=w.lang.en.skip key=doc kind=string core.source="hand-core 1"

# A cue (reviewer block 2026-11-15 14:00, w.request and w.dialogue): a phrasing that sets a constraint of a w.request
# request, or marks a turn as a reaction of w.dialogue. `on` what it sets: a constraint `on` of w.request (kind,
# count, size, extent, attribute, place, manner, layout, with, about, length) or `reaction` (a w.dialogue reaction,
# `value` the reaction: reject, reduce ...). `want` the w.request `want` it gives (no: "not", "without", "instead of";
# not_all: "not all"). `attribute` the k.attributes attribute a value is of (colour: "in red"). `value` the value it gives (a k.expect scale step: small, big; a manner: tidy; a place:
# corner; a reaction). `bound` for a count or a length: exact, min ("at least"), max ("at most"), range ("between 5 and
# 10"), about ("about 5": a range around the number, the k.expect amount `about`). `amount` a k.expect amount by name
# ("a few": few). `step` up or down: a comparative or a reaction moves the constraint one scale step ("bigger",
# "too much"). How it is said: `lead` (many: alternatives) the words before the operand, `between` (many) the words
# between the two operands of a range, `trail` (many) the words after it; a cue with no operand (`takes=none`) is
# said by its lead alone. `takes` what follows the lead: none, number, range (two numbers), kind (a noun phrase: the
# kind), value (a word: an adjective, a colour), topic (the rest of the sentence), thing (a thing of the world).
# `unit` for a length (word, sentence, paragraph, chapter, page). `priority` where two cues read the same words, the
# higher wins (the longer phrase). `example` (many) sentences it reads.
@w.lang.en.cue core.type of=w.lang.en.cue shared=true closed=true core.source="hand-core 1"
@w.lang.en.cue.name core.slot of=w.lang.en.cue key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.cue.on core.slot of=w.lang.en.cue key=on required=true enum=kind enum=count enum=size enum=extent enum=attribute enum=place enum=manner enum=layout enum=with enum=about enum=length enum=reaction core.source="hand-core 1"
@w.lang.en.cue.want core.slot of=w.lang.en.cue key=want enum=yes enum=no enum=not_all core.source="hand-core 1"
@w.lang.en.cue.value core.slot of=w.lang.en.cue key=value kind=atom kind=string core.source="hand-core 1"
@w.lang.en.cue.relation core.slot of=w.lang.en.cue key=relation kind=atom core.source="hand-core 1"
@w.lang.en.cue.attribute core.slot of=w.lang.en.cue key=attribute kind=atom core.source="hand-core 1"
@w.lang.en.cue.bound core.slot of=w.lang.en.cue key=bound enum=exact enum=min enum=max enum=range enum=about core.source="hand-core 1"
@w.lang.en.cue.amount core.slot of=w.lang.en.cue key=amount kind=atom core.source="hand-core 1"
@w.lang.en.cue.step core.slot of=w.lang.en.cue key=step enum=up enum=down core.source="hand-core 1"
@w.lang.en.cue.lead core.slot of=w.lang.en.cue key=lead many=true kind=string core.source="hand-core 1"
@w.lang.en.cue.between core.slot of=w.lang.en.cue key=between many=true kind=string core.source="hand-core 1"
@w.lang.en.cue.trail core.slot of=w.lang.en.cue key=trail many=true kind=string core.source="hand-core 1"
@w.lang.en.cue.takes core.slot of=w.lang.en.cue key=takes required=true enum=none enum=number enum=range enum=kind enum=value enum=topic enum=thing core.source="hand-core 1"
@w.lang.en.cue.unit core.slot of=w.lang.en.cue key=unit kind=atom core.source="hand-core 1"
