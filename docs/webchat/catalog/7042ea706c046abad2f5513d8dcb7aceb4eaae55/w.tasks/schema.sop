# w.tasks: a reusable world: tasks to do (homework, call grandma, water the plants), each open or done, with a due
# date, an owner and a reminder, standing in order on a to-do list of w.list. Declared as data in the library's
# std.schema format; the acts of std.acts drive it (make, remove, change, pick, ask, copy); it has no rule and no
# function of its own (PSys2 Q18 K2). Terms after iCalendar's to-do (RFC 5545, VTODO): `text` is its SUMMARY,
# `status` its STATUS (open = NEEDS-ACTION, done = COMPLETED), `due` its DUE, `reminder` the TRIGGER of its VALARM,
# `owner` its ATTENDEE (who is to do it); `n` is the position on the list (w.list's name for a place in an order).
# sources: hand-core 1 (hand-written in this repository; own)
# license: CC0-1.0
# script: none (hand-written)
# needs: sopworld with std.schema and std.acts (tools/sopworld/VERSION, 0.30.0 or later); imports w.list

@w.tasks core.module name=w.tasks version=1 imports=w.list exports=task core.source="hand-core 1"
@w.tasks.world std.schema.world name=w.tasks doc="tasks to do, each open or done, with a due date, an owner and a reminder" core.source="hand-core 1"

# A task. `text` is what is to be done, as the user said it (call grandma, my homework). `status`: open, or done; it is
# a state that acts change: the act `change` sets it ("I finished my homework": status done; "I didn't finish it":
# status open), `pick` and `ask` read it ("what is left to do": the open tasks). `list` is the list it stands on (a
# w.list list, sort to-do; one home for lists), `n` its place on that list, from 1. `due` is when it is to be done by,
# `reminder` when to remind of it: an ISO 8601 date, time or date and time (2026-11-20, 17:00, 2026-11-20T17:00), or a
# word of k.time (Friday, tomorrow, evening) that the library's std.time reads. `owner` is who is to do it (a name:
# Ana; me). `note` anything else.
@w.tasks.task core.type of=w.tasks.task extends=std.schema.thing closed=true core.source="hand-core 1"
@w.tasks.task.text core.slot of=w.tasks.task key=text required=true kind=atom kind=string core.source="hand-core 1"
@w.tasks.task.status core.slot of=w.tasks.task key=status enum=open enum=done default=open core.source="hand-core 1"
@w.tasks.task.list core.slot of=w.tasks.task key=list type=w.list.list core.source="hand-core 1"
@w.tasks.task.n core.slot of=w.tasks.task key=n kind=integer min=1 step=1 core.source="hand-core 1"
@w.tasks.task.due core.slot of=w.tasks.task key=due kind=atom kind=string core.source="hand-core 1"
@w.tasks.task.reminder core.slot of=w.tasks.task key=reminder kind=atom kind=string core.source="hand-core 1"
@w.tasks.task.owner core.slot of=w.tasks.task key=owner kind=atom kind=string core.source="hand-core 1"
@w.tasks.task.note core.slot of=w.tasks.task key=note kind=string core.source="hand-core 1"

# The kind and the acts that apply to it. Tasks can be grouped (a project, the chores of a day). At most 1,000 tasks.
@w.tasks.kind.task std.schema.kind of=w.tasks.task world=w.tasks acts=make acts=remove acts=change acts=group acts=pick acts=ask acts=copy core.source="hand-core 1"
@w.tasks.limit.task std.schema.limit of=w.tasks.task max=1000 core.source="hand-core 1"

# Words: for the world (how a host finds it by name), its kind and its keys.
@w.tasks.word.world core.word text=tasks text="task list" text=chores text=reminders text="things to do" text=to-dos text=todos means=w.tasks of=std.schema.world.name core.source="hand-core 1"
@w.tasks.word.task core.word text=task text=tasks text=chore text=chores text=job text=jobs text=to-do text=todo text=reminder text=reminders means=w.tasks.task core.source="hand-core 1"
@w.tasks.word.text core.word text=text text=what text=says means=w.tasks.task.text core.source="hand-core 1"
@w.tasks.word.status core.word text=status text=done text=open text=finished text=completed text=left text=still means=w.tasks.task.status core.source="hand-core 1"
@w.tasks.word.list core.word text=on text=list means=w.tasks.task.list core.source="hand-core 1"
@w.tasks.word.n core.word text=place text=position text=order text=first text=next means=w.tasks.task.n core.source="hand-core 1"
@w.tasks.word.due core.word text=due text=by text=deadline text=until text=when means=w.tasks.task.due core.source="hand-core 1"
@w.tasks.word.reminder core.word text=reminder text=remind text=alarm text=alert means=w.tasks.task.reminder core.source="hand-core 1"
@w.tasks.word.owner core.word text=owner text=who text=assigned text=for means=w.tasks.task.owner core.source="hand-core 1"
@w.tasks.word.note core.word text=note text=notes text=comment means=w.tasks.task.note core.source="hand-core 1"
