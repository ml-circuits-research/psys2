# back: cape
@k.faces.figure.back.cape k.faces.variant slot=back name=cape style=figure length=long kind=cape core.source="hand-core 1"
@k.faces.figure.back.cape.cape k.faces.part slot=back of=cape name=cape shape=polygon x=30 y=30 w=40 h=50 z=1 colour=red colour=blue colour=black colour=purple colour=green rgb="#B22234" core.source="hand-core 1"
@k.faces.figure.back.cape.lining k.faces.part slot=back of=cape name=lining shape=polygon x=34 y=31 w=32 h=48 z=2 colour=red colour=blue colour=black colour=purple colour=green rgb="#7A1520" core.source="hand-core 1"
@k.faces.figure.back.cape.cape.p1 k.faces.point part=$k.faces.figure.back.cape.cape n=1 x=39 y=30 core.source="hand-core 1"
