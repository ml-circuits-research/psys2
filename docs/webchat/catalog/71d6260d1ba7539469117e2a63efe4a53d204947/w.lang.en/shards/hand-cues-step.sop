# w.lang.en/shards/hand-cues-step: cues for the next and the previous variant of a thing ("the next mouth", "another nose"): `step=next` or `step=previous` on a variant (psys2 Q99 (4), a real failing turn: "the next mouth" read no act).
# sources: hand-core 1 (written by a language model from that turn; general words, not one sentence's row)
# license: CC0-1.0
# script: none (hand-written)

@w.lang.en.cue.attribute.variant_next w.lang.en.cue name=attribute.variant_next on=attribute attribute=variant step=next lead="the next" lead="next" lead="the following" lead="another" lead="a different" lead="switch to the next" takes=thing priority=3 example="the next mouth" example="another nose" example="show the next hairstyle" core.source="hand-core 1"
@w.lang.en.cue.attribute.variant_previous w.lang.en.cue name=attribute.variant_previous on=attribute attribute=variant step=previous lead="the previous" lead="previous" lead="the one before" lead="the last one" lead="go back to the previous" takes=thing priority=3 example="the previous mouth" example="go back to the previous hairstyle" core.source="hand-core 1"
