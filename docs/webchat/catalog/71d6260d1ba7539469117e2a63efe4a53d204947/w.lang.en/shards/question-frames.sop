# w.lang.en/shards/question-frames: question frames in other word orders over facts that exist (reviewer block 2026-11-15 09:20, PSys2 Q18 K10): 7 frames, needs=facts ("April has how many days?", "Friday is how many days away?", "Which months are in summer?", "Name all the seasons of the year."); "how many legs has a cow" (real row r0244) is read by acts.facts.ask.count.does.
# sources: hand-core 1 (written in this repository, own: tools/lang-en-question-frames.mjs)
# license: CC0-1.0
# script: tools/lang-en-question-frames.mjs

# acts.facts.ask.count.tail: the number asked last
@w.lang.en.frame.acts.facts.ask.count.tail w.lang.en.frame name=acts.facts.ask.count.tail act=ask mode=count set=acts.facts priority=15 needs=facts role=thing role=attribute example="April has how many days?" core.source="hand-core 1"
@w.lang.en.part.acts.facts.ask.count.tail.1 w.lang.en.part frame=acts.facts.ask.count.tail at=1 is=det optional=yes core.source="hand-core 1"
@w.lang.en.part.acts.facts.ask.count.tail.2 w.lang.en.part frame=acts.facts.ask.count.tail at=2 is=role role=thing takes=words core.source="hand-core 1"
@w.lang.en.part.acts.facts.ask.count.tail.3 w.lang.en.part frame=acts.facts.ask.count.tail at=3 is=word word="has" word="have" word="has got" word="have got" word="gets" word="get" core.source="hand-core 1"
@w.lang.en.part.acts.facts.ask.count.tail.4 w.lang.en.part frame=acts.facts.ask.count.tail at=4 is=word word="how many" core.source="hand-core 1"
@w.lang.en.part.acts.facts.ask.count.tail.5 w.lang.en.part frame=acts.facts.ask.count.tail at=5 is=role role=attribute takes=lexicon lexicon=attribute core.source="hand-core 1"
# acts.facts.ask.count.in: over acts.facts.ask.live (14), which read it as "how many people live in"
@w.lang.en.frame.acts.facts.ask.count.in w.lang.en.frame name=acts.facts.ask.count.in act=ask mode=count set=acts.facts priority=15 needs=facts role=attribute role=thing example="How many days are in April?" core.source="hand-core 1"
@w.lang.en.part.acts.facts.ask.count.in.1 w.lang.en.part frame=acts.facts.ask.count.in at=1 is=lead phrase=lead.polite optional=yes core.source="hand-core 1"
