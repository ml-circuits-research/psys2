# k.charts/shards/measures: 22 measures charts usually show, each with its kind, unit, a plausible range and step for one category, and the dimensions it is usually broken down by: conventional orders of magnitude for invented ("random", "plausible") values, said to be invented.
# sources: hand-core 1 (hand-written in this repository: tools/charts-core.mjs)
# license: CC0-1.0
# script: tools/charts-core.mjs

@k.charts.measure.sales k.charts.measure name=sales kind=money unit="EUR" min=2000 max=20000 step=500 dimension=month dimension=quarter dimension=region dimension=product dimension=channel dimension=year about="the money taken from sales in one period, region or product of a small business" core.source="hand-core 1"
@k.charts.measure.revenue k.charts.measure name=revenue kind=money unit="EUR" min=10000 max=90000 step=1000 dimension=quarter dimension=year dimension=department dimension=region about="the money a small company takes in one quarter, year, department or region" core.source="hand-core 1"
@k.charts.measure.expenses k.charts.measure name=expenses kind=money unit="EUR" min=1000 max=15000 step=500 dimension=month dimension=quarter dimension=department about="the money spent in one period or department of a small company" core.source="hand-core 1"
@k.charts.measure.orders k.charts.measure name=orders kind=count unit="orders" min=20 max=400 step=5 dimension=weekday dimension=month dimension=channel dimension="payment method" dimension=product about="the orders a small shop receives in one day, month, channel or way of paying" core.source="hand-core 1"
@k.charts.measure.visitors k.charts.measure name=visitors kind=count unit="visitors" min=100 max=5000 step=50 dimension=weekday dimension=month dimension=source dimension=device dimension=browser dimension=platform about="the visitors of a website in one day or month, or from one source or device" core.source="hand-core 1"
@k.charts.measure.downloads k.charts.measure name=downloads kind=count unit="downloads" min=50 max=3000 step=50 dimension=month dimension=platform dimension=week about="the downloads of an app in one month, week or platform" core.source="hand-core 1"
@k.charts.measure.customers k.charts.measure name=customers kind=count unit="customers" min=10 max=300 step=5 dimension=weekday dimension=region dimension="age group" dimension=channel about="the customers a shop serves in one day, region, age group or channel" core.source="hand-core 1"
@k.charts.measure.employees k.charts.measure name=employees kind=count unit="people" min=3 max=60 step=1 dimension=department dimension=role dimension=team dimension=rank about="the people working in one department, role, team or rank of a small company" core.source="hand-core 1"
@k.charts.measure.students k.charts.measure name=students kind=count unit="students" min=10 max=120 step=1 dimension=grade dimension=subject dimension=course dimension=level dimension=year about="the students with one grade, in one subject, course, level or year of a school" core.source="hand-core 1"
@k.charts.measure.tasks k.charts.measure name=tasks kind=count unit="tasks" min=1 max=30 step=1 dimension=status dimension=priority dimension=team about="the tasks of a project with one status or priority, or of one team" core.source="hand-core 1"
@k.charts.measure.votes k.charts.measure name=votes kind=count unit="votes" min=5 max=80 step=1 dimension=colour dimension=genre dimension=rating dimension=product about="the votes of a class or a club for each option" core.source="hand-core 1"
@k.charts.measure.rainfall k.charts.measure name=rainfall kind=amount unit="mm" min=10 max=120 step=5 dimension=month dimension=season about="the rain that falls in a month or season in a temperate place" core.source="hand-core 1"
@k.charts.measure.temperature k.charts.measure name=temperature kind=temperature unit="°C" min=-5 max=30 step=1 dimension=month dimension=season about="the average temperature of a month or season in a temperate place" core.source="hand-core 1"
@k.charts.measure.hours_of_sunshine k.charts.measure name="hours of sunshine" kind=amount unit="hours" min=40 max=300 step=10 dimension=month dimension=season about="the hours of sunshine of a month or season in a temperate place" core.source="hand-core 1"
@k.charts.measure.steps k.charts.measure name=steps kind=count unit="steps" min=2000 max=15000 step=500 dimension=weekday dimension=day about="the steps a person walks in one day" core.source="hand-core 1"
@k.charts.measure.hours_of_sleep k.charts.measure name="hours of sleep" kind=amount unit="hours" min=5 max=10 step=0.5 dimension=weekday dimension=day about="the hours a person sleeps in one night" core.source="hand-core 1"
@k.charts.measure.score k.charts.measure name=score kind=score unit="points" min=40 max=100 step=1 dimension=subject dimension=course dimension=team dimension=level about="the average test score, out of 100, in one subject, course, team or level" core.source="hand-core 1"
@k.charts.measure.satisfaction k.charts.measure name=satisfaction kind=score unit="points" min=1 max=10 step=0.5 dimension=department dimension=channel dimension=product dimension="age group" about="the average satisfaction, out of 10, of one department, channel, product or age group" core.source="hand-core 1"
@k.charts.measure.conversion_rate k.charts.measure name="conversion rate" kind=rate unit="%" min=1 max=12 step=0.5 dimension=source dimension=device dimension=channel dimension=month about="the share of the visitors who buy, in percent, by source, device, channel or month" core.source="hand-core 1"
@k.charts.measure.population k.charts.measure name=population kind=count unit="thousand people" min=200 max=4000 step=50 dimension=city dimension=region about="the people living in one city or region, in thousands" core.source="hand-core 1"
@k.charts.measure.tourists k.charts.measure name=tourists kind=count unit="thousand tourists" min=50 max=900 step=10 dimension=country dimension=continent dimension=month dimension=season about="the tourists a place receives in one year or month, in thousands" core.source="hand-core 1"
@k.charts.measure.books_read k.charts.measure name="books read" kind=count unit="books" min=0 max=12 step=1 dimension=month dimension=genre dimension=language about="the books a reader reads in one month, genre or language" core.source="hand-core 1"
