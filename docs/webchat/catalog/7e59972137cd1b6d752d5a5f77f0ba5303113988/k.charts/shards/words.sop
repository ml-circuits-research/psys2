# k.charts/shards/words: the English words of k.charts (its types, keys and values), stored beside the world (owner's
# decision 2026-11-15 08:10); tools/build-catalog.mjs reads them as the world's own words.
# sources: hand-core 1 (written in this repository; the block at the end by tools/key-words.mjs)
# license: CC0-1.0
# script: none (hand-written); the block of word wires for keys: tools/key-words.mjs

# Words for the types of this world.
@k.charts.word.kind core.word text="kind of chart" text="kinds of chart" text="chart type" text="type of chart" text="type of graph" means=k.charts.kind core.source="hand-core 1"
@k.charts.word.encoding core.word text=encoding text="visual encoding" text="visual channel" means=k.charts.encoding core.source="hand-core 1"
@k.charts.word.relationship core.word text="what the data shows" text="data relationship" means=k.charts.relationship core.source="hand-core 1"
@k.charts.word.rule core.word text="which chart" text="best chart" text="right chart" text="chart choice" means=k.charts.rule core.source="hand-core 1"
@k.charts.word.rank core.word text="ranking of encodings" text="most accurate" means=k.charts.rank core.source="hand-core 1"

# Words for the kinds of chart and the relationships (another name a request uses for them).
@k.charts.word.name.bar_chart core.word text="bar graph" text="column chart" text="bar diagram" means="bar chart" of=k.charts.kind.name core.source="hand-core 1"
@k.charts.word.name.line_chart core.word text="line graph" text="line plot" text="trend chart" means="line chart" of=k.charts.kind.name core.source="hand-core 1"
