# k.values/shards/words: the owned English vocabulary, separate from the schema.
# sources: hand-core 1 (hand-written declarations and deterministic key vocabulary)
# license: CC0-1.0
# script: none (hand-written; generated key block maintained by tools/key-words.mjs)

@k.values.word.direction core.word text=direction text=directions means=k.values.direction core.source="hand-core 1"
@k.values.word.position core.word text=position text=positions means=k.values.position core.source="hand-core 1"
@k.values.word.scale core.word text=scale text=scales means=k.values.scale core.source="hand-core 1"
@k.values.word.fill core.word text=fill text=filled text=pattern means=k.values.fill core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
