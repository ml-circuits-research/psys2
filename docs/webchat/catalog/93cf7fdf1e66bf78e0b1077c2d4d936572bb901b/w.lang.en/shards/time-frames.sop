# w.lang.en/shards/time-frames: frames that state and ask the date and the time (block 09:20 K7, PSys2 r0586): 9 statements (change set, set acts.state, the thing and attribute fixed) and 4 questions, with the 6 lexicons they name, derived from k.time (weekdays, months, seasons, hours, clock phrases) and w.lang.en's numerals.
# sources: hand-core 1 (written in this repository: tools/lang-en-time-frames.mjs; the lexicons derived from k.time and w.lang.en)
# license: CC0-1.0
# script: tools/lang-en-time-frames.mjs

# Lexicons (derived).
@w.lang.en.lex.time.weekday w.lang.en.lex name=time.weekday doc="The days of the week: the names of k.time.weekday; derived by tools/lang-en-time-frames.mjs." item="friday" item="monday" item="saturday" item="sunday" item="thursday" item="tuesday" item="wednesday" core.source="hand-core 1"
@w.lang.en.lex.time.month w.lang.en.lex name=time.month doc="The months: the names of k.time.month; derived by tools/lang-en-time-frames.mjs." item="april" item="august" item="december" item="february" item="january" item="july" item="june" item="march" item="may" item="november" item="october" item="september" core.source="hand-core 1"
@w.lang.en.lex.time.season w.lang.en.lex name=time.season doc="The seasons: the names of k.time.season; derived by tools/lang-en-time-frames.mjs." item="autumn" item="spring" item="summer" item="winter" core.source="hand-core 1"
@w.lang.en.lex.time.clock_phrase w.lang.en.lex name=time.clock_phrase doc="How the clock names a time by an hour (half past, quarter to, five past): the names of k.time.clock_phrase but o'clock, which follows the hour; derived by tools/lang-en-time-frames.mjs." item="a quarter past" item="a quarter to" item="five past" item="five to" item="half past" item="quarter past" item="quarter to" item="ten past" item="ten to" item="twenty past" item="twenty to" item="twenty-five past" item="twenty-five to" core.source="hand-core 1"
@w.lang.en.lex.time.hour.named w.lang.en.lex name=time.hour.named doc="The hours of the clock said by a name, not a number: noon and midnight and their words (midday, twelve noon); derived from k.time by tools/lang-en-time-frames.mjs." item="12 midnight" item="12 noon" item="midday" item="midnight" item="noon" item="twelve at night" item="twelve midnight" item="twelve noon" core.source="hand-core 1"
@w.lang.en.lex.time.hour w.lang.en.lex name=time.hour doc="An hour as the clock says it: 0 to 23, the 12-hour numbers in words (one to twelve), the hours of k.time.hour by name (noon, midnight, 3 pm) and their words (midday, 12 am); derived by tools/lang-en-time-frames.mjs." item="0" item="1" item="1 am" item="1 pm" item="10" item="10 am" item="10 pm" item="11" item="11 am" item="11 pm" item="12" item="12 am" item="12 midnight" item="12 noon" item="12 pm" item="13" item="14" item="15" item="16" item="17" item="18" item="19" item="2" item="2 am" item="2 pm" item="20" item="21" item="22" item="23" item="3" item="3 am" item="3 pm" item="4" item="4 am" item="4 pm" item="5" item="5 am" item="5 pm" item="6" item="6 am" item="6 pm" item="7" item="7 am" item="7 pm" item="8" item="8 am" item="8 pm" item="9" item="9 am" item="9 pm" item="eight" item="eleven" item="five" item="four" item="midday" item="midnight" item="nine" item="noon" item="one" item="seven" item="six" item="ten" item="three" item="twelve" item="twelve at night" item="twelve midnight" item="twelve noon" item="two" core.source="hand-core 1"

# the day of the week today
@w.lang.en.frame.time.state.today w.lang.en.frame name=time.state.today act=change mode=set set=acts.state priority=16 role=value example="I should tell you, today is Friday." core.source="hand-core 1"
