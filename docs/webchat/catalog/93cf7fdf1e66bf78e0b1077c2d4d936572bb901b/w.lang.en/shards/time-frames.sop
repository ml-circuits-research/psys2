@w.lang.en.part.time.state.today.2 w.lang.en.part frame=time.state.today at=2 is=word word="i should tell you" word="i need to tell you" word="i have to tell you" word="i want to tell you" word="just so you know" word="fyi" word="by the way" word="btw" word="remember" word="note that" word="you should know" optional=yes core.source="hand-core 1"
@w.lang.en.part.time.state.today.3 w.lang.en.part frame=time.state.today at=3 is=word word="today is" word="today it is" word="today its" word="it is" word="its" word="it s" core.source="hand-core 1"
@w.lang.en.part.time.state.today.4 w.lang.en.part frame=time.state.today at=4 is=role role=value takes=lexicon lexicon=time.weekday core.source="hand-core 1"
