# w.lang.en/shards/diagram-frames: frames for the diagram edits and requests PSys2 measured (DIAG-GAP, reviewer block 06:00 item 1): 15 frames (layout direction, edge labels, a diagram of a kind about a topic) and the 9 lexicons they name, derived from k.diagrams (kind names and words), w.diagram (words for an edge) and the arrangement phrases.
# sources: hand-core 1 (written in this repository: tools/lang-en-diagram-frames.mjs; the lexicons derived from k.diagrams, w.diagram and w.lang.en hand-arrangements)
# license: CC0-1.0
# script: tools/lang-en-diagram-frames.mjs

# Lexicons (derived).
@w.lang.en.lex.diagram.kind w.lang.en.lex name=diagram.kind doc="Kinds of diagram: the names of k.diagrams.kind and their words (core.word of=k.diagrams.kind.name); derived by tools/lang-en-diagram-frames.mjs." item="circle diagram" item="circular diagram" item="comparison chart" item="comparison grid" item="comparison matrix" item="comparison table" item="concept map" item="cycle" item="cycle chart" item="cycle diagram" item="flow chart" item="flow diagram" item="flowchart" item="hierarchy" item="hierarchy chart" item="hierarchy diagram" item="idea map" item="mind map" item="mind-map" item="mindmap" item="network" item="network diagram" item="network graph" item="node diagram" item="org chart" item="organigram" item="organisation chart" item="organisational chart" item="organization chart" item="organizational chart" item="pipeline" item="pipeline diagram" item="process chart" item="process diagram" item="process flow" item="set diagram" item="spider diagram" item="stage diagram" item="time line" item="timeline" item="timeline chart" item="timeline diagram" item="tree" item="tree chart" item="tree diagram" item="venn" item="venn chart" item="venn diagram" core.source="hand-core 1"
@w.lang.en.lex.diagram.edge w.lang.en.lex name=diagram.edge doc="Words for an edge of a diagram: w.diagram's words for w.diagram.edge, singular (a reader takes the plural too); derived by tools/lang-en-diagram-frames.mjs." item="arrow" item="connector" item="edge" item="line" item="link" core.source="hand-core 1"
@w.lang.en.lex.diagram.edge.from w.lang.en.lex name=diagram.edge.from doc="Words that begin the two ends of an edge after its noun (\"the arrow from A to B\", \"the line between A and B\")." item="between" item="from" item="going from" item="leading from" item="that goes from" item="which goes from" core.source="hand-core 1"
@w.lang.en.lex.diagram.kind.only w.lang.en.lex name=diagram.kind.only doc="Kinds of diagram whose words name no drawing of k.objects (all of diagram.kind but tree): \"draw the planets on a timeline\" is a timeline, \"draw a bird in a tree\" a bird in a tree; derived by tools/lang-en-diagram-frames.mjs." item="circle diagram" item="circular diagram" item="comparison chart" item="comparison grid" item="comparison matrix" item="comparison table" item="concept map" item="cycle" item="cycle chart" item="cycle diagram" item="flow chart" item="flow diagram" item="flowchart" item="hierarchy" item="hierarchy chart" item="hierarchy diagram" item="idea map" item="mind map" item="mind-map" item="mindmap" item="network" item="network diagram" item="network graph" item="node diagram" item="org chart" item="organigram" item="organisation chart" item="organisational chart" item="organization chart" item="organizational chart" item="pipeline" item="pipeline diagram" item="process chart" item="process diagram" item="process flow" item="set diagram" item="spider diagram" item="stage diagram" item="time line" item="timeline" item="timeline chart" item="timeline diagram" item="tree chart" item="tree diagram" item="venn" item="venn chart" item="venn diagram" core.source="hand-core 1"
@w.lang.en.lex.diagram.topic.head w.lang.en.lex name=diagram.topic.head doc="Nouns that name what a fill of k.diagrams gives, said before \"of\" in a topic (\"the parts of a car\", \"the stages of a frog's life\"): each joined to the type of a k.diagrams.fill (TOPIC_HEADS in tools/lang-en-diagram-frames.mjs)." item="cities" item="elements" item="kinds" item="life cycle" item="main parts" item="months" item="neighbors" item="neighbours" item="parts" item="phases" item="seasons" item="stages" item="steps" item="types" core.source="hand-core 1"
@w.lang.en.lex.diagram.topic.of w.lang.en.lex name=diagram.topic.of doc="The word that joins a topic head to its whole (\"the parts of a car\")." item="of" core.source="hand-core 1"
@w.lang.en.lex.name.letter.after w.lang.en.lex name=name.letter.after doc="Words after which a capital single letter is a name, not the article (block 07:45 item 3): \"connect A to C\", \"the arrow from A to B\", \"box A\"; a letter after such a name is a name too (\"A, B and C\"). Read by the reference reader (tools/lib/lang-en.mjs)." item="and" item="arrow" item="between" item="box" item="bubble" item="called" item="connect" item="connector" item="edge" item="from" item="join" item="line" item="link" item="named" item="node" item="or" item="point" item="stage" item="step" item="to" item="with" core.source="hand-core 1"
@w.lang.en.lex.order.criterion w.lang.en.lex name=order.criterion doc="Attributes that can put things in order, the criterion of make, place and group (k.actions): the names of the k.attributes attributes that hold a number, a size or a step of a scale, and their words (core.word of=k.attributes.attribute.name); derived by tools/lang-en-diagram-frames.mjs." item="closeness to the sun" item="distance" item="distance from the sun" item="height" item="how big" item="how cold" item="how expensive" item="how far" item="how far away" item="how far from the sun" item="how fast" item="how heavy" item="how high" item="how hot" item="how large" item="how long" item="how much it costs" item="how tall" item="legs" item="length" item="number of legs" item="number of sides" item="number of wheels" item="price" item="sides" item="size" item="speed" item="temperature" item="weight" item="wheels" core.source="hand-core 1"
@w.lang.en.lex.diagram.direction w.lang.en.lex name=diagram.direction doc="Directions of a layout: the arrangement phrases (w.lang.en.arrangement) of a row or column in one direction whose diagram layout is left_right or top_down; derived by tools/lang-en-diagram-frames.mjs." item="across the page" item="bottom to top" item="down the page" item="downwards" item="from bottom to top" item="from left to right" item="from right to left" item="from top to bottom" item="horizontally" item="left to right" item="one above the other" item="one below the other" item="one under the other" item="right to left" item="top to bottom" item="upwards" item="vertically" core.source="hand-core 1"

# layout direction: what goes which way
@w.lang.en.frame.acts.place.layout.go w.lang.en.frame name=acts.place.layout.go act=place mode=layout set=acts priority=15 needs=layout role=thing role=rel example="Make the arrows go left to right." core.source="hand-core 1"
