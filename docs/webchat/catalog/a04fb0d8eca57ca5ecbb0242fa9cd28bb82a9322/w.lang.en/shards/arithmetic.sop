@w.lang.en.calc.aggregate.in_all w.lang.en.calc text="in all" kind=aggregate calc=sum example="How many apples are there in all?" core.source="hand-core 1"
@w.lang.en.calc.aggregate.together w.lang.en.calc text="together" kind=aggregate calc=sum example="How many apples do they have together?" core.source="hand-core 1"
