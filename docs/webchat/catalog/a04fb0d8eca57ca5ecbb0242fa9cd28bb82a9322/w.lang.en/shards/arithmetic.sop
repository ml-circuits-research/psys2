# Lexicons of the frames, from the words.
@w.lang.en.lex.calc.infix w.lang.en.lex name=calc.infix doc="Arithmetic operators said between two numbers (\"3 plus 4\"): the w.lang.en.calc words of kind operator, form infix." item="added to" item="and" item="divided by" item="less" item="minus" item="multiplied by" item="plus" item="take away" item="times" core.source="hand-core 1"
@w.lang.en.lex.calc.prefix w.lang.en.lex name=calc.prefix doc="Arithmetic operators said before one number, with a factor (\"double 6\", \"half of 10\"): kind operator, form prefix." item="a quarter of" item="double" item="half" item="half of" item="triple" item="twice" core.source="hand-core 1"
@w.lang.en.lex.calc.split w.lang.en.lex name=calc.split doc="Arithmetic verbs said around two numbers with a marker (\"share 12 between 3\", \"subtract 4 from 10\"): kind operator, form split." item="add" item="divide" item="multiply" item="share" item="split" item="subtract" core.source="hand-core 1"
@w.lang.en.lex.calc.marker w.lang.en.lex name=calc.marker doc="The markers of the split operators (\"between\", \"from\", \"by\"): the markers of the w.lang.en.calc words of form split." item="among" item="and" item="between" item="by" item="from" item="into" item="to" core.source="hand-core 1"
@w.lang.en.lex.calc.comparative w.lang.en.lex name=calc.comparative doc="Comparative words of a question (\"how many more\"): kind comparison, form question." item="fewer" item="less" item="more" core.source="hand-core 1"
@w.lang.en.lex.calc.aggregate w.lang.en.lex name=calc.aggregate doc="Words that ask for the sum of every owner's quantity (\"in total\", \"altogether\"): kind aggregate." item="all together" item="altogether" item="in all" item="in total" item="together" core.source="hand-core 1"
@w.lang.en.lex.calc.extreme w.lang.en.lex name=calc.extreme doc="Words that ask for the owner with the largest or smallest quantity (\"the most\"): kind extreme." item="the fewest" item="the least" item="the most" core.source="hand-core 1"
@w.lang.en.lex.calc.state w.lang.en.lex name=calc.state doc="Words that say which state of a story's quantity a question asks for (\"left\", \"at first\"): kind state." item="at first" item="at the start" item="in the beginning" item="left" item="now" item="to begin with" item="to start with" core.source="hand-core 1"

# Frames.
