# Role maps of these frames.
@w.lang.en.role_map.calc.ask.number w.lang.en.role_map name=calc.ask.number act=ask role=number act_role=thing doc="The first number of a calculation (\"3 plus 4\": 3)" core.source="hand-core 1"
