# w.lang.en/shards/arithmetic: arithmetic words and frames (reviewer block 2026-11-15 09:20, PSys2 Q18 K4): 48 words of arithmetic with the core.calc function each names (operators, comparisons, aggregates, extremes, states of a quantity), 8 lexicons drawn from them, and 9 frames of the act ask in the mode calc ("what is 3 plus 4", "how many apples does Tom have left", "who has the most apples", "how many more apples does Ana have than Tom"), needs=calc.
# sources: hand-core 1 (written in this repository, own: tools/lang-en-arithmetic.mjs; the function names are the core.calc builtins of sopworld)
# license: CC0-1.0
# script: tools/lang-en-arithmetic.mjs

# Words of arithmetic.
@w.lang.en.calc.operator.infix.plus w.lang.en.calc text="plus" kind=operator form=infix calc=add example="What is 3 plus 4?" core.source="hand-core 1"
@w.lang.en.calc.operator.split.add w.lang.en.calc text="add" kind=operator form=split calc=add marker=to marker=and example="Add 3 to 4." core.source="hand-core 1"
@w.lang.en.calc.operator.infix.added_to w.lang.en.calc text="added to" kind=operator form=infix calc=add example="What is 3 added to 4?" core.source="hand-core 1"
@w.lang.en.calc.operator.infix.and w.lang.en.calc text="and" kind=operator form=infix calc=add example="What do 3 and 4 make?" core.source="hand-core 1"
@w.lang.en.calc.operator.infix.minus w.lang.en.calc text="minus" kind=operator form=infix calc=sub example="What is 10 minus 4?" core.source="hand-core 1"
@w.lang.en.calc.operator.infix.take_away w.lang.en.calc text="take away" kind=operator form=infix calc=sub example="What is 10 take away 4?" core.source="hand-core 1"
@w.lang.en.calc.operator.infix.less w.lang.en.calc text="less" kind=operator form=infix calc=sub example="What is 10 less 4?" core.source="hand-core 1"
@w.lang.en.calc.operator.split.subtract w.lang.en.calc text="subtract" kind=operator form=split calc=sub marker=from example="Subtract 4 from 10." core.source="hand-core 1"
@w.lang.en.calc.operator.infix.times w.lang.en.calc text="times" kind=operator form=infix calc=mul example="What is 3 times 4?" core.source="hand-core 1"
@w.lang.en.calc.operator.infix.multiplied_by w.lang.en.calc text="multiplied by" kind=operator form=infix calc=mul example="What is 3 multiplied by 4?" core.source="hand-core 1"
@w.lang.en.calc.operator.split.multiply w.lang.en.calc text="multiply" kind=operator form=split calc=mul marker=by example="Multiply 3 by 4." core.source="hand-core 1"
@w.lang.en.calc.operator.infix.divided_by w.lang.en.calc text="divided by" kind=operator form=infix calc=div example="What is 12 divided by 3?" core.source="hand-core 1"
@w.lang.en.calc.operator.split.divide w.lang.en.calc text="divide" kind=operator form=split calc=div marker=by marker=between marker=among marker=into example="Divide 12 by 3." core.source="hand-core 1"
@w.lang.en.calc.operator.split.share w.lang.en.calc text="share" kind=operator form=split calc=div marker=between marker=among marker=by example="Share 12 between 3." core.source="hand-core 1"
@w.lang.en.calc.operator.split.split w.lang.en.calc text="split" kind=operator form=split calc=div marker=between marker=among marker=into example="Split 12 between 3." core.source="hand-core 1"
@w.lang.en.calc.operator.prefix.double w.lang.en.calc text="double" kind=operator form=prefix calc=mul factor=2 example="What is double 6?" core.source="hand-core 1"
@w.lang.en.calc.operator.prefix.twice w.lang.en.calc text="twice" kind=operator form=prefix calc=mul factor=2 example="What is twice 6?" core.source="hand-core 1"
@w.lang.en.calc.operator.prefix.triple w.lang.en.calc text="triple" kind=operator form=prefix calc=mul factor=3 example="What is triple 4?" core.source="hand-core 1"
@w.lang.en.calc.operator.prefix.half w.lang.en.calc text="half" kind=operator form=prefix calc=mul factor=0.5 example="What is half 10?" core.source="hand-core 1"
@w.lang.en.calc.operator.prefix.half_of w.lang.en.calc text="half of" kind=operator form=prefix calc=mul factor=0.5 example="What is half of 10?" core.source="hand-core 1"
@w.lang.en.calc.operator.prefix.a_quarter_of w.lang.en.calc text="a quarter of" kind=operator form=prefix calc=mul factor=0.25 example="What is a quarter of 12?" core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.more_than w.lang.en.calc text="more than" kind=comparison form=relation calc=add example="Ana has 3 more apples than Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.fewer_than w.lang.en.calc text="fewer than" kind=comparison form=relation calc=sub example="Ana has 2 fewer apples than Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.less_than w.lang.en.calc text="less than" kind=comparison form=relation calc=sub example="Ana has 2 less money than Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.times_as_many_as w.lang.en.calc text="times as many as" kind=comparison form=relation calc=mul example="Ana has 3 times as many apples as Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.times_as_much_as w.lang.en.calc text="times as much as" kind=comparison form=relation calc=mul example="Ana has 3 times as much money as Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.twice_as_many_as w.lang.en.calc text="twice as many as" kind=comparison form=relation calc=mul factor=2 example="Ana has twice as many apples as Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.twice_as_much_as w.lang.en.calc text="twice as much as" kind=comparison form=relation calc=mul factor=2 example="Ana has twice as much money as Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.half_as_many_as w.lang.en.calc text="half as many as" kind=comparison form=relation calc=mul factor=0.5 example="Ana has half as many apples as Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.relation.as_many_as w.lang.en.calc text="as many as" kind=comparison form=relation calc=eq example="Ana has as many apples as Tom." core.source="hand-core 1"
@w.lang.en.calc.comparison.question.more w.lang.en.calc text="more" kind=comparison form=question calc=sub example="How many more apples does Ana have than Tom?" core.source="hand-core 1"
@w.lang.en.calc.comparison.question.fewer w.lang.en.calc text="fewer" kind=comparison form=question calc=sub example="How many fewer apples does Tom have than Ana?" core.source="hand-core 1"
@w.lang.en.calc.comparison.question.less w.lang.en.calc text="less" kind=comparison form=question calc=sub example="How much less money does Tom have than Ana?" core.source="hand-core 1"
