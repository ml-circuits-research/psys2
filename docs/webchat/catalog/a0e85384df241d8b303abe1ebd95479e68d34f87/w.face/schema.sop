@w.face.limit.ears std.schema.limit of=w.face.ears max=10 core.source="hand-core 1"
@w.face.limit.head std.schema.limit of=w.face.head max=10 core.source="hand-core 1"
@w.face.limit.cheeks std.schema.limit of=w.face.cheeks max=10 core.source="hand-core 1"
