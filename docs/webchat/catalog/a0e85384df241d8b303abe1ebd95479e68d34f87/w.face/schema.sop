@w.face.limit.mouth std.schema.limit of=w.face.mouth max=10 core.source="hand-core 1"
@w.face.limit.moustache std.schema.limit of=w.face.moustache max=10 core.source="hand-core 1"
@w.face.limit.nose std.schema.limit of=w.face.nose max=10 core.source="hand-core 1"
@w.face.limit.eyes std.schema.limit of=w.face.eyes max=10 core.source="hand-core 1"
@w.face.limit.eyebrows std.schema.limit of=w.face.eyebrows max=10 core.source="hand-core 1"
@w.face.limit.glasses std.schema.limit of=w.face.glasses max=10 core.source="hand-core 1"
@w.face.limit.hair_front std.schema.limit of=w.face.hair_front max=10 core.source="hand-core 1"
@w.face.limit.earrings std.schema.limit of=w.face.earrings max=10 core.source="hand-core 1"
@w.face.limit.hat std.schema.limit of=w.face.hat max=10 core.source="hand-core 1"
@w.face.limit.accessories std.schema.limit of=w.face.accessories max=10 core.source="hand-core 1"

# Words: for the world (how a host finds it by name), its kinds and its keys.
