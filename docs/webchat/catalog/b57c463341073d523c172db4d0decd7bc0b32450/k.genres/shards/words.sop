# k.genres/shards/words: the English words of k.genres (its types, keys and values), stored beside the world (owner's
# decision 2026-11-15 08:10); tools/build-catalog.mjs reads them as the world's own words.
# sources: hand-core 1 (written in this repository; the block at the end by tools/key-words.mjs)
# license: CC0-1.0
# script: none (hand-written); the block of word wires for keys: tools/key-words.mjs

# Words for the types of this world.
@k.genres.word.genre core.word text=genre text=genres text="document type" text="kind of text" text="type of text" means=k.genres.genre core.source="hand-core 1"
@k.genres.word.move core.word text=move text=moves text="rhetorical move" text="rhetorical moves" means=k.genres.move core.source="hand-core 1"
