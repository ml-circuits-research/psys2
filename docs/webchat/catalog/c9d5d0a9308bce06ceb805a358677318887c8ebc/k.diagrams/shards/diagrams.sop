# k.diagrams/shards/diagrams: 10 kinds of diagram (structure, layout, arrangement, edges, roles, uses), 23 shape conventions, 25 ways the catalog's knowledge fills them, and the 10 works they rest on.
# sources: hand-core 1 (hand-written in this repository: tools/diagrams-core.mjs; the works cited are the k.diagrams.source facts)
# license: CC0-1.0
# script: tools/diagrams-core.mjs

@k.diagrams.source.gilbreth1921 k.diagrams.source name=gilbreth1921 cite="Gilbreth, F. B. and Gilbreth, L. M. (1921). Process charts. Transactions of the American Society of Mechanical Engineers 43, 1029-1050." year=1921 core.source="hand-core 1"
@k.diagrams.source.iso5807 k.diagrams.source name=iso5807 cite="ISO 5807:1985. Information processing: documentation symbols and conventions for data, program and system flowcharts, program network charts and system resources charts. International Organization for Standardization." year=1985 core.source="hand-core 1"
@k.diagrams.source.venn1880 k.diagrams.source name=venn1880 cite="Venn, J. (1880). On the diagrammatic and mechanical representation of propositions and reasonings. The London, Edinburgh, and Dublin Philosophical Magazine and Journal of Science 10(59), 1-18." year=1880 core.source="hand-core 1"
@k.diagrams.source.buzan1974 k.diagrams.source name=buzan1974 cite="Buzan, T. (1974). Use Your Head. London: BBC Books." year=1974 core.source="hand-core 1"
@k.diagrams.source.priestley1765 k.diagrams.source name=priestley1765 cite="Priestley, J. (1765). A Chart of Biography. London." year=1765 core.source="hand-core 1"
@k.diagrams.source.mccallum1855 k.diagrams.source name=mccallum1855 cite="McCallum, D. C. (1855). Diagram representing a plan of organization of the New York and Erie Railroad. New York." year=1855 core.source="hand-core 1"
@k.diagrams.source.reingold1981 k.diagrams.source name=reingold1981 cite="Reingold, E. M. and Tilford, J. S. (1981). Tidier drawings of trees. IEEE Transactions on Software Engineering SE-7(2), 223-228." year=1981 core.source="hand-core 1"
@k.diagrams.source.sugiyama1981 k.diagrams.source name=sugiyama1981 cite="Sugiyama, K., Tagawa, S. and Toda, M. (1981). Methods for visual understanding of hierarchical system structures. IEEE Transactions on Systems, Man, and Cybernetics 11(2), 109-125." year=1981 core.source="hand-core 1"
@k.diagrams.source.fruchterman1991 k.diagrams.source name=fruchterman1991 cite="Fruchterman, T. M. J. and Reingold, E. M. (1991). Graph drawing by force-directed placement. Software: Practice and Experience 21(11), 1129-1164." year=1991 core.source="hand-core 1"
@k.diagrams.source.novak1984 k.diagrams.source name=novak1984 cite="Novak, J. D. and Gowin, D. B. (1984). Learning How to Learn. Cambridge University Press." year=1984 core.source="hand-core 1"
@k.diagrams.kind.flowchart k.diagrams.kind name=flowchart form=flowchart about="the steps of a process and the decisions between them, joined by arrows from one step to the next; a decision has an arrow for each answer" structure=graph structure=sequence layout=top_down layout=left_right arranged=flow arranged=column edges=directed role=start role=end role=process role=decision role=data role=document role=subprocess role=connector groups=no usual_for="the steps of a method or a recipe" usual_for="how a program decides" usual_for="what to do when something happens" source=gilbreth1921 source=iso5807 source=sugiyama1981 core.source="hand-core 1"
@k.diagrams.kind.tree k.diagrams.kind name=tree form=tree about="one thing at the top and the things under it below, each again the top of a smaller tree; a line joins each thing to the one it is under" structure="whole with parts" structure=graph layout=top_down arranged=tree edges=undirected role=root role=item groups=no usual_for="kinds and their sub-kinds" usual_for="the parts of a thing and their parts" usual_for="a family tree" usual_for="the places of a country" source=reingold1981 core.source="hand-core 1"
@k.diagrams.kind.cycle k.diagrams.kind name=cycle form=cycle about="stages that follow each other and come round: an arrow from each stage to the next, and from the last back to the first" structure=cycle layout=circular arranged=ring arranged=flow edges=directed role=stage groups=no usual_for="a life cycle" usual_for="the water cycle" usual_for="the seasons" usual_for="a process that repeats" core.source="hand-core 1"
@k.diagrams.kind.timeline k.diagrams.kind name=timeline form=timeline about="events in order of time along a line, each at its date or place in the order" structure=sequence layout=left_right layout=top_down arranged=row arranged=column edges=none role=event groups=no usual_for="the events of a story or a life" usual_for="history" usual_for="the months of a year" usual_for="the plan of a project" source=priestley1765 core.source="hand-core 1"
@k.diagrams.kind.mind_map k.diagrams.kind name="mind map" form=mind_map about="a topic in the middle and its ideas on branches around it, each idea with branches of its own" structure="whole with parts" layout=radial arranged=radial edges=undirected role=centre role=branch groups=no usual_for="what one knows about a topic" usual_for="the aspects of a thing" usual_for="ideas for a story or an essay" source=buzan1974 source=novak1984 core.source="hand-core 1"
@k.diagrams.kind.Venn_diagram k.diagrams.kind name="Venn diagram" form=venn about="a circle for each set, the circles overlapping; a thing inside two circles belongs to both sets, a thing outside all of them to none" structure="whole with parts" layout=overlapping edges=none role=item groups=yes usual_for="what two or three things share and what each has alone" usual_for="kinds that overlap" usual_for="sorting things by two features" source=venn1880 core.source="hand-core 1"
@k.diagrams.kind.org_chart k.diagrams.kind name="org chart" form=org_chart about="the posts or people of an organisation, each under the one it reports to" structure="whole with parts" structure=graph layout=top_down arranged=tree edges=undirected role=post groups=no usual_for="who reports to whom in a company or a school" usual_for="the departments of an organisation" source=mccallum1855 core.source="hand-core 1"
@k.diagrams.kind.network k.diagrams.kind name=network form=network about="nodes joined by links, with no top and no order: what is joined to what" structure=graph layout=free arranged=scatter edges=undirected role=node groups=no usual_for="countries and their neighbours" usual_for="who knows whom" usual_for="what is joined to what in a machine" usual_for="how ideas relate" source=fruchterman1991 source=novak1984 core.source="hand-core 1"
@k.diagrams.kind.pipeline k.diagrams.kind name=pipeline form=pipeline about="stages a thing passes through one after the other, each stage handing what it makes to the next" structure=sequence layout=left_right arranged=flow arranged=row edges=directed role=stage role=start role=end groups=no usual_for="how a product is made" usual_for="the parts of a genre in order" usual_for="the stages of a project" core.source="hand-core 1"
@k.diagrams.kind.comparison_table k.diagrams.kind name="comparison table" form=table about="the things compared in rows, their features in columns, the value of each feature for each thing in its cell" structure="values by category" layout=grid arranged=grid edges=none role=row role=column role=cell groups=no usual_for="comparing animals, countries or products feature by feature" usual_for="pros and cons" core.source="hand-core 1"
@k.diagrams.shape.flowchart.start k.diagrams.shape kind=flowchart role=start shape=oval about="the terminal symbol: where the process starts" source=iso5807 core.source="hand-core 1"
@k.diagrams.shape.flowchart.end k.diagrams.shape kind=flowchart role=end shape=oval about="the terminal symbol: where the process ends" source=iso5807 core.source="hand-core 1"
@k.diagrams.shape.flowchart.process k.diagrams.shape kind=flowchart role=process shape=rectangle about="a step that does something" source=iso5807 core.source="hand-core 1"
@k.diagrams.shape.flowchart.decision k.diagrams.shape kind=flowchart role=decision shape=diamond about="a question with an arrow out for each answer (yes, no)" source=iso5807 core.source="hand-core 1"
@k.diagrams.shape.flowchart.data k.diagrams.shape kind=flowchart role=data shape=parallelogram about="data put in or given out" source=iso5807 core.source="hand-core 1"
@k.diagrams.shape.flowchart.document k.diagrams.shape kind=flowchart role=document shape=document about="a document, a rectangle with a wavy bottom edge" source=iso5807 core.source="hand-core 1"
@k.diagrams.shape.flowchart.subprocess k.diagrams.shape kind=flowchart role=subprocess shape=double_rectangle about="a predefined process, told elsewhere: a rectangle with double sides" source=iso5807 core.source="hand-core 1"
@k.diagrams.shape.flowchart.connector k.diagrams.shape kind=flowchart role=connector shape=circle about="a small circle where a flow line continues elsewhere" source=iso5807 core.source="hand-core 1"
@k.diagrams.shape.tree.root k.diagrams.shape kind=tree role=root shape=rectangle about="the thing at the top" core.source="hand-core 1"
@k.diagrams.shape.tree.item k.diagrams.shape kind=tree role=item shape=rectangle about="a thing under another" core.source="hand-core 1"
@k.diagrams.shape.cycle.stage k.diagrams.shape kind=cycle role=stage shape=circle about="a stage, its arrows going round" core.source="hand-core 1"
@k.diagrams.shape.timeline.event k.diagrams.shape kind=timeline role=event shape=dot about="a dot on the line at the event's time, its label beside it" source=priestley1765 core.source="hand-core 1"
@k.diagrams.shape.mind_map.centre k.diagrams.shape kind="mind map" role=centre shape=ellipse about="the topic in the middle, larger than its branches" source=buzan1974 core.source="hand-core 1"
@k.diagrams.shape.mind_map.branch k.diagrams.shape kind="mind map" role=branch shape=rounded_rectangle about="an idea on a branch" source=buzan1974 core.source="hand-core 1"
@k.diagrams.shape.Venn_diagram.item k.diagrams.shape kind="Venn diagram" role=item shape=dot about="a thing, inside the circles of the sets it belongs to (the sets are groups drawn as circles)" source=venn1880 core.source="hand-core 1"
@k.diagrams.shape.org_chart.post k.diagrams.shape kind="org chart" role=post shape=rectangle about="a post or a person, the name and the title in a box" source=mccallum1855 core.source="hand-core 1"
@k.diagrams.shape.network.node k.diagrams.shape kind=network role=node shape=circle about="a node, its links as lines" source=fruchterman1991 core.source="hand-core 1"
@k.diagrams.shape.pipeline.stage k.diagrams.shape kind=pipeline role=stage shape=chevron about="a stage, pointing to the next" core.source="hand-core 1"
@k.diagrams.shape.pipeline.start k.diagrams.shape kind=pipeline role=start shape=chevron about="the first stage" core.source="hand-core 1"
@k.diagrams.shape.pipeline.end k.diagrams.shape kind=pipeline role=end shape=chevron about="the last stage" core.source="hand-core 1"
@k.diagrams.shape.comparison_table.row k.diagrams.shape kind="comparison table" role=row shape=rectangle about="the header of a row: a thing compared" core.source="hand-core 1"
@k.diagrams.shape.comparison_table.column k.diagrams.shape kind="comparison table" role=column shape=rectangle about="the header of a column: a feature" core.source="hand-core 1"
@k.diagrams.shape.comparison_table.cell k.diagrams.shape kind="comparison table" role=cell shape=rectangle about="the value of a feature for a thing" core.source="hand-core 1"
@k.diagrams.fill.flowchart.k_procedures_step.after k.diagrams.fill kind=flowchart type=k.procedures.step key=after gives=edges topic=method about="the steps of a method of k.procedures, each joined to the steps it comes after" core.source="hand-core 1"
@k.diagrams.fill.flowchart.k_procedures_step.n k.diagrams.fill kind=flowchart type=k.procedures.step key=n gives=order topic=method about="the steps of a method in their order" core.source="hand-core 1"
@k.diagrams.fill.tree.k_kinds_parent.is_a k.diagrams.fill kind=tree type=k.kinds.parent key=is_a gives=edges topic=is_a about="kinds under their kinds (the up edges of k.kinds: a cow under farm animal and under mammal)" core.source="hand-core 1"
@k.diagrams.fill.tree.k_parts_usual.has k.diagrams.fill kind=tree type=k.parts.usual key=has gives=edges topic=name about="a thing and its usual parts" core.source="hand-core 1"
@k.diagrams.fill.tree.k_parts_whole.has k.diagrams.fill kind=tree type=k.parts.whole key=has gives=edges topic=name about="a thing and its own parts as WordNet lists them (a car: accelerator, air bag, bumper, car door ...)" core.source="hand-core 1"
@k.diagrams.fill.tree.k_geo_city.country k.diagrams.fill kind=tree type=k.geo.city key=country gives=edges topic=country about="a country and its cities" core.source="hand-core 1"
@k.diagrams.fill.cycle.k_time_ordered.next k.diagrams.fill kind=cycle type=k.time.ordered key=next gives=edges topic=cycle about="the stages of a cycle of k.time, each joined to the next: the seasons, the months, the life cycle of a frog, the water cycle" core.source="hand-core 1"
@k.diagrams.fill.cycle.k_time_ordered.n k.diagrams.fill kind=cycle type=k.time.ordered key=n gives=order topic=cycle about="the stages of a cycle in their order from where it is said to start" core.source="hand-core 1"
@k.diagrams.fill.timeline.k_time_ordered.n k.diagrams.fill kind=timeline type=k.time.ordered key=n gives=order topic=cycle about="the times of a cycle in order (months, weekdays)" core.source="hand-core 1"
@k.diagrams.fill.timeline.k_story_element.n k.diagrams.fill kind=timeline type=k.story.element key=n gives=order about="the elements of a story in the order told" core.source="hand-core 1"
@k.diagrams.fill.timeline.k_space_body.order k.diagrams.fill kind=timeline type=k.space.body key=order gives=order topic=kind about="the planets in their order from the Sun, Mercury to Neptune" by=distance core.source="hand-core 1"
@k.diagrams.fill.timeline.k_space_body.size_rank k.diagrams.fill kind=timeline type=k.space.body key=size_rank gives=order topic=kind about="the planets from the largest to the smallest, Jupiter to Mercury" by=size core.source="hand-core 1"
@k.diagrams.fill.flowchart.k_procedures_howto_step.after k.diagrams.fill kind=flowchart type=k.procedures.howto_step key=after gives=edges topic=howto about="the steps of an everyday procedure (making tea, washing hands, planting a seed), each joined to the steps it comes after; a decision is a question with the answers yes and no" core.source="hand-core 1"
@k.diagrams.fill.flowchart.k_procedures_howto_step.n k.diagrams.fill kind=flowchart type=k.procedures.howto_step key=n gives=order topic=howto about="the steps of an everyday procedure in their order" core.source="hand-core 1"
@k.diagrams.fill.mind_map.k_parts_usual.has k.diagrams.fill kind="mind map" type=k.parts.usual key=has gives=edges topic=name about="a thing in the middle, its parts on branches" core.source="hand-core 1"
@k.diagrams.fill.mind_map.k_parts_whole.has k.diagrams.fill kind="mind map" type=k.parts.whole key=has gives=edges topic=name about="a thing in the middle, its own parts (as WordNet lists them) on branches" core.source="hand-core 1"
@k.diagrams.fill.mind_map.k_attributes_aspect.name k.diagrams.fill kind="mind map" type=k.attributes.aspect key=name gives=values about="the aspects of a thing (what it is, looks like, does, where it lives) as branches" core.source="hand-core 1"
@k.diagrams.fill.Venn_diagram.k_kinds_parent.is_a k.diagrams.fill kind="Venn diagram" type=k.kinds.parent key=is_a gives=members topic=is_a about="things in the sets of their kinds; a thing of two kinds lies in the overlap" core.source="hand-core 1"
@k.diagrams.fill.network.k_geo_country.neighbour k.diagrams.fill kind=network type=k.geo.country key=neighbour gives=edges about="countries joined to their neighbours" core.source="hand-core 1"
@k.diagrams.fill.network.k_layouts_joins.b k.diagrams.fill kind=network type=k.layouts.joins key=b gives=edges about="what is joined to what (a part of, attaches to, sits on)" core.source="hand-core 1"
@k.diagrams.fill.network.k_kinds_relation.object k.diagrams.fill kind=network type=k.kinds.relation key=object gives=edges about="the typed relations of the catalog: a key of a kind of thing joined to the kind of its values" core.source="hand-core 1"
@k.diagrams.fill.pipeline.k_genres_part.n k.diagrams.fill kind=pipeline type=k.genres.part key=n gives=order topic=genre about="the parts of a genre in order" core.source="hand-core 1"
@k.diagrams.fill.pipeline.k_procedures_step.n k.diagrams.fill kind=pipeline type=k.procedures.step key=n gives=order topic=method about="the steps of a method, one after the other" core.source="hand-core 1"
@k.diagrams.fill.pipeline.k_procedures_howto_step.n k.diagrams.fill kind=pipeline type=k.procedures.howto_step key=n gives=order topic=howto about="the steps of an everyday procedure, one after the other" core.source="hand-core 1"
@k.diagrams.fill.comparison_table.k_attributes_number.name k.diagrams.fill kind="comparison table" type=k.attributes.number key=name gives=values about="things in rows, their numbers (legs, size, weight, speed) in columns" core.source="hand-core 1"
