# The request template that mirrors w.lang.en's make.for (w.lang.ro's requests are one to one with the English act templates).
@w.lang.ro.request.make.for w.lang.ro.request name=make.for act=make shape=kind.value.seats role=kind role=value text="adaugă {art@kind} {kind} pentru {value}." example="Adaugă o masă pentru 4." core.source="hand-core 1"
@w.lang.ro.fill.make_for.art w.lang.ro.fill template=make.for role=art lemma=un core.source="hand-core 1"
