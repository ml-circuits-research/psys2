@k.attributes.thing.glosses.pendant k.attributes.thing name=pendant can=hang core.source="wordnet 3.1"
# popsicle: ice cream or water ice on a small wooden stick
@k.attributes.thing.glosses.popsicle k.attributes.thing name=popsicle material=ice core.source="wordnet 3.1"
