@k.attributes.thing.glosses.refrigerator k.attributes.thing name=refrigerator colour=white core.source="wordnet 3.1"
# rhubarb: long pinkish sour leafstalks usually eaten cooked and sweetened
@k.attributes.thing.glosses.rhubarb k.attributes.thing name=rhubarb colour=pink core.source="wordnet 3.1"
# rod: a long thin implement made of metal or wood
@k.attributes.thing.glosses.rod k.attributes.thing name=rod material=metal material=wood core.source="wordnet 3.1"
# roof: a protective covering that covers or forms the top of a building
@k.attributes.thing.glosses.roof k.attributes.thing name=roof can=cover core.source="wordnet 3.1"
# sarcophagus: a stone coffin (usually bearing sculpture or inscriptions)
@k.attributes.thing.glosses.sarcophagus k.attributes.thing name=sarcophagus material=stone core.source="wordnet 3.1"
# sash: a framework that holds the panes of a window in the window frame
@k.attributes.thing.glosses.sash k.attributes.thing name=sash can=hold core.source="wordnet 3.1"
# screen: a white or silvered surface where pictures can be projected for viewing
@k.attributes.thing.glosses.screen k.attributes.thing name=screen colour=white core.source="wordnet 3.1"
