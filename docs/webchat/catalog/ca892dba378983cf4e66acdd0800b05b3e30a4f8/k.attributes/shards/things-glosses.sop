@k.attributes.thing.glosses.mozzarella k.attributes.thing name=mozzarella colour=white core.source="wordnet 3.1"
# nog: a wooden pin pushed or driven into a surface
@k.attributes.thing.glosses.nog k.attributes.thing name=nog material=wood core.source="wordnet 3.1"
# paisley: a soft wool fabric with a colorful swirled pattern of curved shapes
