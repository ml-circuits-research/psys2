# hutch: a cage (usually made of wood and wire mesh) for small animals
@k.attributes.thing.glosses.hutch k.attributes.thing name=hutch material=wood core.source="wordnet 3.1"
# icebox: white goods in which food can be stored at low temperatures
@k.attributes.thing.glosses.icebox k.attributes.thing name=icebox colour=white core.source="wordnet 3.1"
# jewel: a precious or semiprecious stone incorporated into a piece of jewelry
@k.attributes.thing.glosses.jewel k.attributes.thing name=jewel material=stone core.source="wordnet 3.1"
# kelp: large brown seaweeds having fluted leathery fronds
@k.attributes.thing.glosses.kelp k.attributes.thing name=kelp colour=brown core.source="wordnet 3.1"
# lemon: yellow oval fruit with juicy acidic flesh
@k.attributes.thing.glosses.lemon k.attributes.thing name=lemon colour=yellow core.source="wordnet 3.1"
