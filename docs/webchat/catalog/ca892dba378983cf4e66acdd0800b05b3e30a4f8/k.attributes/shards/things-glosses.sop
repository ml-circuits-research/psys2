# k.attributes/shards/things-glosses: the usual colour (17 things), material (25) and abilities (24) of common things that the catalog lacked, read from the WordNet gloss of the sense kept by the rules of tools/attributes-glosses.mjs (KR6); every proposed value checked by hand (sources/coverage/kr6-audit.tsv: colour 3 of 22 wrong, material 8 of 38 wrong, can 7 of 31 wrong); only the right ones are here.
# sources: wordnet 3.1 (Princeton WordNet 3.1: the glosses of the senses kept by tools/coverage.mjs)
# license: WordNet-3.0
# script: tools/attributes-glosses.mjs

# antenna: an electrical device that sends or receives radio or television signals
@k.attributes.thing.glosses.antenna k.attributes.thing name=antenna can=send core.source="wordnet 3.1"
# bagging: coarse fabric used for bags or sacks
@k.attributes.thing.glosses.bagging k.attributes.thing name=bagging material=cloth core.source="wordnet 3.1"
# bandage: a piece of soft material that covers and protects an injured part of the body
@k.attributes.thing.glosses.bandage k.attributes.thing name=bandage can=cover core.source="wordnet 3.1"
# bellows: (used in the plural) a mechanical device that blows a strong current of air
@k.attributes.thing.glosses.bellows k.attributes.thing name=bellows can=blow core.source="wordnet 3.1"
# binder: a machine that cuts grain and binds it in sheaves
@k.attributes.thing.glosses.binder k.attributes.thing name=binder can=cut core.source="wordnet 3.1"
# blackberry: large sweet black or very dark purple edible aggregate fruit of any of various bushes of the genus Rubus
@k.attributes.thing.glosses.blackberry k.attributes.thing name=blackberry colour=black colour=purple core.source="wordnet 3.1"
# blindfold: a cloth used to cover the eyes
@k.attributes.thing.glosses.blindfold k.attributes.thing name=blindfold material=cloth core.source="wordnet 3.1"
# blowtorch: a burner that mixes air and gas to produce a very hot flame
@k.attributes.thing.glosses.blowtorch k.attributes.thing name=blowtorch can=mix core.source="wordnet 3.1"
# boardwalk: a walkway made of wooden boards
@k.attributes.thing.glosses.boardwalk k.attributes.thing name=boardwalk material=wood core.source="wordnet 3.1"
# bomber: a military aircraft that drops bombs during flight
@k.attributes.thing.glosses.bomber k.attributes.thing name=bomber can=drop core.source="wordnet 3.1"
# boot: footwear that covers the whole foot and lower leg
@k.attributes.thing.glosses.boot k.attributes.thing name=boot can=cover core.source="wordnet 3.1"
# boutique: a shop that sells women's clothes and jewelry
@k.attributes.thing.glosses.boutique k.attributes.thing name=boutique can=sell core.source="wordnet 3.1"
# buffalo: large shaggy-haired brown bison of North American plains
@k.attributes.thing.glosses.buffalo k.attributes.thing name=buffalo colour=brown core.source="wordnet 3.1"
# bugle: a brass instrument without valves
@k.attributes.thing.glosses.bugle k.attributes.thing name=bugle material=metal core.source="wordnet 3.1"
# canister: a metallic cylinder packed with shot and used as ammunition in a firearm
@k.attributes.thing.glosses.canister k.attributes.thing name=canister material=metal core.source="wordnet 3.1"
# carrot: deep orange edible root of the cultivated carrot plant
@k.attributes.thing.glosses.carrot k.attributes.thing name=carrot colour=orange core.source="wordnet 3.1"
# cassette: a container that holds a magnetic tape used for recording or playing sound or video
@k.attributes.thing.glosses.cassette k.attributes.thing name=cassette can=hold core.source="wordnet 3.1"
# chip: a triangular wooden float attached to the end of a log line
@k.attributes.thing.glosses.chip k.attributes.thing name=chip material=wood core.source="wordnet 3.1"
# clip: a metal frame or container holding cartridges
@k.attributes.thing.glosses.clip k.attributes.thing name=clip material=metal core.source="wordnet 3.1"
# cloak: anything that covers or conceals
@k.attributes.thing.glosses.cloak k.attributes.thing name=cloak can=cover core.source="wordnet 3.1"
# coconut: the edible white meat of a coconut
@k.attributes.thing.glosses.coconut k.attributes.thing name=coconut colour=white core.source="wordnet 3.1"
# commissary: a retail store that sells equipment and provisions (usually to military personnel)
@k.attributes.thing.glosses.commissary k.attributes.thing name=commissary can=sell core.source="wordnet 3.1"
# corkscrew: a bottle opener that pulls corks
@k.attributes.thing.glosses.corkscrew k.attributes.thing name=corkscrew can=pull core.source="wordnet 3.1"
# cowl: protective covering consisting of a metal part that covers the engine
@k.attributes.thing.glosses.cowl k.attributes.thing name=cowl can=cover core.source="wordnet 3.1"
# crate: a rugged box (usually made of wood)
@k.attributes.thing.glosses.crate k.attributes.thing name=crate material=wood core.source="wordnet 3.1"
# creeper: any plant (as ivy or periwinkle) that grows by creeping
@k.attributes.thing.glosses.creeper k.attributes.thing name=creeper can=grow core.source="wordnet 3.1"
# crowbar: a heavy iron lever with one end forged into a wedge
@k.attributes.thing.glosses.crowbar k.attributes.thing name=crowbar material=metal core.source="wordnet 3.1"
# crutch: a wooden or metal staff that fits under the armpit and reaches to the ground
@k.attributes.thing.glosses.crutch k.attributes.thing name=crutch material=wood material=metal core.source="wordnet 3.1"
# dobson: large brown aquatic larva of the dobsonfly
@k.attributes.thing.glosses.dobson k.attributes.thing name=dobson colour=brown core.source="wordnet 3.1"
# espresso: strong black coffee brewed by forcing hot water under pressure through finely ground coffee beans
@k.attributes.thing.glosses.espresso k.attributes.thing name=espresso colour=black core.source="wordnet 3.1"
