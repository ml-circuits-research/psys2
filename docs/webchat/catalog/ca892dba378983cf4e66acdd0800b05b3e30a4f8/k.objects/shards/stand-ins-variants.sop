# k.objects/shards/stand-ins-variants: variants of kinds a drawing names (a storm cloud, a sports car, an oak tree, a brick
# house): each drawn by the object of its kind, with the colour, the size against its kind and the material that tell it
# from the kind (psys2 drawn.variant).
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

@k.objects.variant.apple_tree k.objects.stand_in name="apple tree" drawing=tree core.source="hand-core 1"
@k.objects.variant.birch_tree k.objects.stand_in name="birch tree" drawing=tree core.source="hand-core 1"
@k.objects.variant.willow_tree k.objects.stand_in name="willow tree" drawing=tree scale=1.1 core.source="hand-core 1"
@k.objects.variant.maple_tree k.objects.stand_in name="maple tree" drawing=tree colour=orange core.source="hand-core 1"
@k.objects.variant.race_car k.objects.stand_in name="race car" drawing=car colour=red scale=0.9 core.source="hand-core 1"
@k.objects.variant.electric_car k.objects.stand_in name="electric car" drawing=car colour=white core.source="hand-core 1"
@k.objects.variant.luxury_sedan k.objects.stand_in name="luxury sedan" drawing=car colour=black scale=1.1 core.source="hand-core 1"
