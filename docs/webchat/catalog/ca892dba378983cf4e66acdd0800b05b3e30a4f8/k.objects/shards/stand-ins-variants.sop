@k.objects.variant.motorboat k.objects.stand_in name=motorboat drawing=speedboat core.source="hand-core 1"
@k.objects.variant.fishing_boat k.objects.stand_in name="fishing boat" drawing=boat core.source="hand-core 1"
@k.objects.variant.sailing_boat k.objects.stand_in name="sailing boat" drawing=sailboat core.source="hand-core 1"
@k.objects.variant.tabby_cat k.objects.stand_in name="tabby cat" drawing=cat colour=orange core.source="hand-core 1"
@k.objects.variant.siamese_cat k.objects.stand_in name="siamese cat" drawing=cat colour=beige core.source="hand-core 1"
@k.objects.variant.ginger_cat k.objects.stand_in name="ginger cat" drawing=cat colour=orange core.source="hand-core 1"
@k.objects.variant.brick_house k.objects.stand_in name="brick house" drawing=house material=brick core.source="hand-core 1"
@k.objects.variant.stone_house k.objects.stand_in name="stone house" drawing=house material=stone core.source="hand-core 1"
@k.objects.variant.wooden_house k.objects.stand_in name="wooden house" drawing=house material=wood core.source="hand-core 1"
