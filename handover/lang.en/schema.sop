# w.lang.en: what is known about English grammar, as facts and rules, independent of any application. Extracted from what PSys2 has today (worlds/acts FORMS, worlds/lang.common, src/dialog, src/formalizer/rules,
# src/knowledge/values.mjs), 2026-11-14. Open-class words (nouns, verbs, adjectives) are NOT here: they are k.words, k.actions and the worlds' own lexicons. Numbers and colours are k.values.
# Applied by sopworld `std.grammar` (a chart parser over these wires; proposal in std-grammar.md). Types are closed where the values are a fixed list of English, open where the lists grow.
# sources: PSys2 (hand-written, collected from seven modules, see README); license: CC0-1.0

@w.lang.en core.module name=w.lang.en version=1 exports=det exports=pron exports=anaphor exports=prep exports=ordinal exports=numeral exports=inflect exports=irregular exports=contraction exports=rule exports=frame exports=phrase exports=lex exports=joiner exports=frame-lead exports=correction exports=answer exports=wh exports=aux exports=qframe exports=neg exports=ellipsis exports=coord core.source="psys2 2026-11-14"

# ---- closed word classes ----
# A determiner or quantifier. `in` names the PSys2 view (one hand-made list) the word belongs to: acts, acts.lexicon, acts.number-start, expand, dialogue, discourse, routing.
@lang.en.det core.type of=lang.en.det shared=true closed=true
@lang.en.det.text core.slot of=lang.en.det key=text id=true required=true kind=atom
@lang.en.det.kind core.slot of=lang.en.det key=kind required=true enum=article enum=demonstrative enum=possessive enum=quantifier enum=numeral enum=modifier
@lang.en.det.definite core.slot of=lang.en.det key=definite enum=yes enum=no
@lang.en.det.number core.slot of=lang.en.det key=number enum=sg enum=pl enum=any
@lang.en.det.person core.slot of=lang.en.det key=person kind=integer min=1 max=3
@lang.en.det.gender core.slot of=lang.en.det key=gender enum=m enum=f enum=n
@lang.en.det.distance core.slot of=lang.en.det key=distance enum=near enum=far
@lang.en.det.value core.slot of=lang.en.det key=value kind=integer
@lang.en.det.variant-of core.slot of=lang.en.det key=variant-of kind=atom
@lang.en.det.register core.slot of=lang.en.det key=register enum=chat
@lang.en.det.meaning core.slot of=lang.en.det key=meaning kind=atom
@lang.en.det.note core.slot of=lang.en.det key=note kind=string
@lang.en.det.in core.slot of=lang.en.det key=in kind=atom

# A pronoun. `refers` says what it stands for: thing (an item of the scene or the dialogue focus), place, an agent by gender (m, f, any), or the user / the assistant.
@lang.en.pron core.type of=lang.en.pron shared=true closed=true
@lang.en.pron.text core.slot of=lang.en.pron key=text id=true required=true kind=atom
@lang.en.pron.case core.slot of=lang.en.pron key=case required=true kind=atom
@lang.en.pron.person core.slot of=lang.en.pron key=person kind=integer min=1 max=3
@lang.en.pron.number core.slot of=lang.en.pron key=number enum=sg enum=pl
@lang.en.pron.gender core.slot of=lang.en.pron key=gender enum=m enum=f enum=n
@lang.en.pron.refers core.slot of=lang.en.pron key=refers required=true enum=thing enum=place enum=m enum=f enum=any enum=user enum=assistant
@lang.en.pron.distance core.slot of=lang.en.pron key=distance enum=near enum=far
@lang.en.pron.deictic core.slot of=lang.en.pron key=deictic kind=atom
@lang.en.pron.in core.slot of=lang.en.pron key=in kind=atom

# An anaphoric noun phrase of the dialogue ("that one", "this animal"): `order` is the order they are tried, `head` the word that is its noun.
@lang.en.anaphor core.type of=lang.en.anaphor shared=true closed=true
@lang.en.anaphor.text core.slot of=lang.en.anaphor key=text id=true required=true kind=string
@lang.en.anaphor.order core.slot of=lang.en.anaphor key=order required=true kind=integer min=1
@lang.en.anaphor.head core.slot of=lang.en.anaphor key=head kind=atom
@lang.en.anaphor.in core.slot of=lang.en.anaphor key=in kind=atom

# A preposition as a relation: the space and time modules read `rel`.
@lang.en.prep core.type of=lang.en.prep shared=true closed=true
@lang.en.prep.text core.slot of=lang.en.prep key=text id=true required=true kind=atom
@lang.en.prep.rel core.slot of=lang.en.prep key=rel required=true kind=atom
@lang.en.prep.space core.slot of=lang.en.prep key=space enum=static enum=direction enum=source enum=path
@lang.en.prep.role core.slot of=lang.en.prep key=role kind=atom
@lang.en.prep.support core.slot of=lang.en.prep key=support enum=yes
@lang.en.prep.contain core.slot of=lang.en.prep key=contain enum=yes
@lang.en.prep.arity core.slot of=lang.en.prep key=arity kind=integer
@lang.en.prep.note core.slot of=lang.en.prep key=note kind=string
@lang.en.prep.in core.slot of=lang.en.prep key=in kind=atom

# Ordinals and the small cardinals the act reader needs before the catalog is reachable (k.values.number is the whole system; these must agree with it).
@lang.en.ordinal core.type of=lang.en.ordinal shared=true closed=true
@lang.en.ordinal.text core.slot of=lang.en.ordinal key=text id=true required=true kind=atom
@lang.en.ordinal.value core.slot of=lang.en.ordinal key=value required=true kind=integer
@lang.en.ordinal.in core.slot of=lang.en.ordinal key=in kind=atom
@lang.en.numeral core.type of=lang.en.numeral shared=true closed=true
@lang.en.numeral.text core.slot of=lang.en.numeral key=text id=true required=true kind=atom
@lang.en.numeral.value core.slot of=lang.en.numeral key=value required=true kind=integer
@lang.en.numeral.in core.slot of=lang.en.numeral key=in kind=atom

# ---- morphology ----
# A rule of inflection. `set` names the user (act: the schema-world reader, lemma: the formalizer's lemmatizer). The first rule of a set, by `order`, whose suffix matches applies.
@lang.en.inflect core.type of=lang.en.inflect shared=true closed=true
@lang.en.inflect.op core.slot of=lang.en.inflect key=op required=true enum=singular enum=plural
@lang.en.inflect.set core.slot of=lang.en.inflect key=set enum=act enum=lemma enum=plural
@lang.en.inflect.order core.slot of=lang.en.inflect key=order required=true kind=integer min=1
@lang.en.inflect.suffix core.slot of=lang.en.inflect key=suffix kind=atom
@lang.en.inflect.unless-suffix core.slot of=lang.en.inflect key=unless-suffix kind=atom
@lang.en.inflect.suffix-pattern core.slot of=lang.en.inflect key=suffix-pattern kind=atom
@lang.en.inflect.pattern core.slot of=lang.en.inflect key=pattern kind=atom
@lang.en.inflect.drop core.slot of=lang.en.inflect key=drop kind=integer min=0
@lang.en.inflect.replace core.slot of=lang.en.inflect key=replace kind=atom
@lang.en.inflect.replace-suffix core.slot of=lang.en.inflect key=replace-suffix kind=atom
@lang.en.inflect.add core.slot of=lang.en.inflect key=add kind=atom
@lang.en.inflect.min-length core.slot of=lang.en.inflect key=min-length kind=integer
@lang.en.inflect.unless-is-singular core.slot of=lang.en.inflect key=unless-is-singular enum=yes
@lang.en.irregular core.type of=lang.en.irregular shared=true closed=true
@lang.en.irregular.singular core.slot of=lang.en.irregular key=singular id=true required=true kind=atom
@lang.en.irregular.plural core.slot of=lang.en.irregular key=plural required=true kind=atom
@lang.en.noun.exception core.type of=lang.en.noun.exception shared=true closed=true
@lang.en.noun.exception.kind core.slot of=lang.en.noun.exception key=kind required=true enum=is-plural enum=us-plural-suffix enum=us-plural-word
@lang.en.noun.exception.stem core.slot of=lang.en.noun.exception key=stem kind=atom
@lang.en.noun.exception.word core.slot of=lang.en.noun.exception key=word kind=atom
@lang.en.contraction core.type of=lang.en.contraction shared=true closed=true
@lang.en.contraction.text core.slot of=lang.en.contraction key=text id=true required=true kind=string
@lang.en.contraction.expands core.slot of=lang.en.contraction key=expands required=true kind=string
@lang.en.contraction.rule core.type of=lang.en.contraction.rule shared=true closed=true
@lang.en.contraction.rule.pattern core.slot of=lang.en.contraction.rule key=pattern required=true kind=string
@lang.en.contraction.rule.expands core.slot of=lang.en.contraction.rule key=expands required=true kind=string

# ---- the grammar: categories, rules, argument frames ----
@lang.en.cat core.type of=lang.en.cat shared=true closed=true
@lang.en.cat.name core.slot of=lang.en.cat key=name id=true required=true kind=atom
@lang.en.cat.doc core.slot of=lang.en.cat key=doc kind=string
# A rule of the chart grammar: lhs built from rhs in order (suffix ? * + for optional, any, one or more; "[a|b]" one of; "NP.1" the first NP). `head` the rhs the phrase is about, `agree` the features that must match,
# `emit` what the reading carries to the act, `status=hole` an English construction PSys2 does not read yet, `from` the PSys2 code that does the same today.
@lang.en.rule core.type of=lang.en.rule shared=true closed=true
@lang.en.rule.lhs core.slot of=lang.en.rule key=lhs required=true kind=atom
@lang.en.rule.rhs core.slot of=lang.en.rule key=rhs kind=string
@lang.en.rule.head core.slot of=lang.en.rule key=head kind=atom
@lang.en.rule.agree core.slot of=lang.en.rule key=agree kind=atom
@lang.en.rule.emit core.slot of=lang.en.rule key=emit kind=string
@lang.en.rule.status core.slot of=lang.en.rule key=status enum=hole
@lang.en.rule.from core.slot of=lang.en.rule key=from kind=string
@lang.en.rule.example core.slot of=lang.en.rule key=example kind=string
@lang.en.rule.doc core.slot of=lang.en.rule key=doc kind=string
# An argument frame: one way of saying an act. `pattern` is the PSys2 form notation (shards/frames-acts.sop header); `role` the roles it fills; `needs` what a world's schema must have for the frame to apply.
@lang.en.frame core.type of=lang.en.frame shared=true closed=true
@lang.en.frame.act core.slot of=lang.en.frame key=act required=true kind=atom
@lang.en.frame.mode core.slot of=lang.en.frame key=mode kind=atom
@lang.en.frame.set core.slot of=lang.en.frame key=set required=true enum=acts enum=acts.more
@lang.en.frame.priority core.slot of=lang.en.frame key=priority required=true kind=integer
@lang.en.frame.needs core.slot of=lang.en.frame key=needs kind=atom
@lang.en.frame.role core.slot of=lang.en.frame key=role kind=atom
@lang.en.frame.pattern core.slot of=lang.en.frame key=pattern required=true kind=string
@lang.en.frame.example core.slot of=lang.en.frame key=example kind=string
@lang.en.frame.lit core.slot of=lang.en.frame key=lit kind=string
# Phrase groups and small lexicons re-typed from lang.common (`item` has underscores for spaces, as the matcher's alternatives do).
@lang.en.phrase core.type of=lang.en.phrase shared=true closed=true
@lang.en.phrase.group core.slot of=lang.en.phrase key=group required=true kind=string
@lang.en.phrase.doc core.slot of=lang.en.phrase key=doc kind=string
@lang.en.phrase.item core.slot of=lang.en.phrase key=item required=true kind=atom
@lang.en.lex core.type of=lang.en.lex shared=true closed=true
@lang.en.lex.group core.slot of=lang.en.lex key=group required=true kind=string
@lang.en.lex.doc core.slot of=lang.en.lex key=doc kind=string
@lang.en.lex.item core.slot of=lang.en.lex key=item required=true kind=atom

