# w.lang.en/shards/frames-acts: the argument frames of English, one per way of saying an act (extracted from worlds/acts/acts.mjs FORMS and forms.more.mjs FORMS_MORE, 2026-11-14).
# Notation of `pattern` (PSys2 form notation, to be read by std.grammar as a flat rule over word classes):
#   L lead-in (phrase lang.lead.polite)   D determiner (view det.acts-forms)   V.<act> the verbs of the act (k.actions)   REL a preposition that is a relation (prepositions.sop)
#   [a|b] one of; [a|b]? optional; a_b a fixed multi-word chunk; {role:class} a capture of a role (words = a noun phrase, rest = the remainder, number = a number word or digits,
#   ATTR VALUE KIND MORE LESS TURN NOUN = a word of the world's lexicon of that name; lex.<id> = a named lexicon).
# `needs` is the condition the world's schema must meet (a world with no attributes has no "make it blue"). `mode` is the act's mode, `lit` a fixed argument.
# sources: PSys2 worlds/acts (hand-written, schema-world forms)
# license: CC0-1.0

# `tab-only` (yes / no) and `tab-priority` belong to the reader forms (flag reader): the world's own reader takes a sentence in its open tab only, or recognises its own frame on any tab.
# set=acts.data are the forms of worlds whose things carry named values (flag valued / ordered).

@lang.en.frame.acts.make lang.en.frame act=make set=acts priority=10 role=thing pattern="L V.make D {thing:words}" example="Add a table." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.place lang.en.frame act=make set=acts priority=12 needs=in role=thing role=rel role=place pattern="L V.make D {thing:words} REL D {place:words}" example="Add a guest at table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.n lang.en.frame act=make set=acts priority=12 role=amount role=thing pattern="L V.make {amount:number} {thing:words}" example="Add 3 tables." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.name lang.en.frame act=make set=acts priority=13 needs=named role=thing role=value pattern="L V.make D {thing:words} [called|named] {value:words}" example="Add a guest called Ann." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.name.p lang.en.frame act=make set=acts priority=14 needs=named role=thing role=value pattern="L V.place D {thing:words} [called|named] {value:rest}" example="Place a guest named Ann." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.name.place lang.en.frame act=make set=acts priority=14 needs=in role=thing role=value role=rel role=place pattern="L V.make D {thing:words} [called|named] {value:words} REL D {place:words}" example="Add a guest called Ann at table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove lang.en.frame act=remove set=acts priority=10 role=thing pattern="L V.remove D {thing:words}" example="Remove the guest Ann." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.out lang.en.frame act=remove set=acts priority=11 role=thing pattern="L [kick|throw|take|send|get|put] D {thing:words} [out|away|off_the_list]" example="Kick the guest Ann out." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.place lang.en.frame act=remove set=acts priority=12 needs=in role=thing role=place pattern="L V.remove D {thing:words} [from|out_of|off] D {place:words}" example="Remove the guests from table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.of lang.en.frame act=change mode=set set=acts priority=14 needs=attrs role=attribute role=thing role=value pattern="L V.set D {attribute:ATTR} of D {thing:words} [to|be|as|into]? D {value:words}" example="Change the colour of table 2 to red." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.attr lang.en.frame act=change mode=set set=acts priority=13 needs=attrs role=thing role=attribute role=value pattern="L V.set D {thing:words} {attribute:ATTR} [to|be|as|into] D {value:words}" example="Set table 2 seats to 6." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.value lang.en.frame act=change mode=set set=acts priority=12 needs=values role=thing role=value pattern="L V.set D {thing:words} [to|be|as|into]? {value:VALUE}" example="Make table 2 blue." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.add lang.en.frame act=change mode=more set=acts priority=14 needs=number role=amount role=attribute role=thing pattern="L V.make {amount:number} {attribute:ATTR} to D {thing:words}" example="Add 2 seats to table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.add1 lang.en.frame act=change mode=more set=acts priority=13 needs=number role=attribute role=thing pattern="L V.make {attribute:ATTR} to D {thing:words}" example="Add a seat to table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.less lang.en.frame act=change mode=less set=acts priority=14 needs=number role=amount role=attribute role=thing pattern="L V.remove {amount:number} {attribute:ATTR} from D {thing:words}" example="Remove 2 seats from table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.less1 lang.en.frame act=change mode=less set=acts priority=13 needs=number role=attribute role=thing pattern="L V.remove D {attribute:ATTR} from D {thing:words}" example="Remove a seat from table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.cmp.more lang.en.frame act=change mode=more set=acts priority=12 needs=more role=thing role=value pattern="L V.set D {thing:words} {value:MORE}" example="Make table 1 bigger." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.cmp.less lang.en.frame act=change mode=less set=acts priority=12 needs=less role=thing role=value pattern="L V.set D {thing:words} {value:LESS}" example="Make table 1 smaller." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place lang.en.frame act=place set=acts priority=11 needs=in role=thing role=rel role=place pattern="L V.place D {thing:words} REL D {place:words}" example="Put the guest Ann at table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.connect lang.en.frame act=connect set=acts priority=11 role=thing role=place pattern="L V.connect D {thing:words} [to|with|and] D {place:words}" example="Connect table 1 to table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.group lang.en.frame act=group mode=group set=acts priority=10 role=thing pattern="L V.group D {thing:words} [together]?" example="Group the tables." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.apart lang.en.frame act=group mode=apart set=acts priority=10 role=thing pattern="L V.apart D {thing:words}" example="Take the tables apart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.apart.2 lang.en.frame act=group mode=apart set=acts priority=11 role=thing pattern="L [take|break|pull|split] D {thing:words} [apart|up]" example="Take the tables apart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.bare lang.en.frame act=place set=acts priority=5 needs=in role=thing pattern="L V.place D {thing:words}" example="Move the guest." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.bare lang.en.frame act=change mode=set set=acts priority=5 needs=attrs role=thing pattern="L [change|colour|color|paint|turn|switch|edit] D {thing:words}" example="Change table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.connect.bare lang.en.frame act=connect set=acts priority=5 role=thing pattern="L V.connect D {thing:words}" example="Connect table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.send.bare lang.en.frame act=send set=acts priority=5 role=thing pattern="L V.send D {thing:words}" example="Send table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.pick lang.en.frame act=pick set=acts priority=10 role=thing pattern="L V.pick D {thing:words}" example="Select table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.copy lang.en.frame act=copy set=acts priority=10 role=thing pattern="L V.copy D {thing:words}" example="Copy table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.send lang.en.frame act=send set=acts priority=11 role=thing role=place pattern="L V.send D {thing:words} to D {place:words}" example="Send table 2 to the diagram." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.what lang.en.frame act=ask mode=what set=acts priority=12 needs=attrs role=attribute role=thing pattern="[what|which] [is|are] D {attribute:ATTR} of D {thing:words}" example="What is the colour of table 2?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.what.is lang.en.frame act=ask mode=what set=acts priority=12 needs=attrs role=attribute role=thing pattern="[what|which] {attribute:ATTR} [is|are] D {thing:words}" example="What colour is table 2?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.should lang.en.frame act=change mode=set set=acts priority=12 needs=values role=thing role=value pattern="D {thing:words} [should|must|has_to|needs_to] [be|become|turn] {value:VALUE}" example="Table 2 should be blue." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.needs lang.en.frame act=change mode=set set=acts priority=12 needs=number role=thing role=value role=attribute pattern="L [i_want|i_need|make|let|give]? D {thing:words} [needs|to_have|should_have|must_have|has|gets] {value:number} {attribute:ATTR}" example="Table 1 needs 6 seats." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.at lang.en.frame act=ask mode=what set=acts priority=12 needs=in role=rel role=place pattern="[what|who] [is|are|sits|sit|stands|stand] [there]? REL D {place:words}" example="Who is at table 1?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.count.attr lang.en.frame act=ask mode=what set=acts priority=14 needs=number role=attribute role=thing pattern="how_many {attribute:ATTR} [does|do|has|have] D {thing:words} [have|has|got]?" example="How many seats does table 1 have?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.count lang.en.frame act=ask mode=count set=acts priority=12 role=thing pattern="how_many {thing:words} [are|do_i_have|have_i_got|is]? [there]?" example="How many tables are there?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.count.at lang.en.frame act=ask mode=count set=acts priority=13 needs=in role=thing role=rel role=place pattern="how_many {thing:words} [are|is]? [there]? REL D {place:words}" example="How many guests are at table 1?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.where lang.en.frame act=ask mode=where set=acts priority=12 needs=in role=thing pattern="where [is|are] D {thing:words}" example="Where is Ann?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.why lang.en.frame act=ask mode=why set=acts priority=11 role=rest pattern="why [is|are|did|do|was|were|does] {rest:words}" example="Why is table 2 blue?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.about lang.en.frame act=ask mode=describe set=acts priority=6 needs=thingask role=thing pattern="L [describe|tell_me_about|explain] D {thing:rest}" example="Describe the circle." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.exists lang.en.frame act=ask mode=exists set=acts priority=11 needs=thingask role=thing pattern="[is|are] there [any|a|an|some]? {thing:rest}" example="Is there a circle?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.last lang.en.frame act=ask mode=last set=acts priority=11 pattern="what [did|have] you [just]? [do|done|change|changed]" example="What did you just do?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.undo lang.en.frame act=undo set=acts priority=16 pattern="[$lang.undo]" example="Undo that." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.redo lang.en.frame act=redo set=acts priority=16 pattern="[$lang.redo]" example="Redo that." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.save lang.en.frame act=save set=acts priority=10 role=value pattern="L V.save [it|this|everything]? [as|under|called]? {value:words}" example="Save it as lunch." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.load lang.en.frame act=load set=acts priority=10 role=value pattern="L V.load D {value:words}" example="Load lunch." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.self lang.en.frame act=make set=acts priority=11 needs=self role=thing pattern="L V.make [yourself|myself|urself] D {thing:words}" example="Give yourself a beard." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.put lang.en.frame act=make set=acts priority=9 needs=self role=thing pattern="L [put|place|stick|draw|give] [him|her|it|the_avatar|me|yourself|myself]? D {thing:words}" example="Give him a beard." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.on lang.en.frame act=make set=acts priority=12 needs=self role=thing pattern="L [put|place|add|stick|draw] D {thing:words} [on_yourself|on_your_face|on_your_head|to_yourself|to_your_face|on_you|on_ur_face]" example="Add glasses to your face." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.off lang.en.frame act=remove set=acts priority=12 needs=self role=thing pattern="L [take|put|get|pull] D {thing:words} [off|away|off_yourself|off_your_face|off_your_head]" example="Take the glasses off." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.without lang.en.frame act=remove set=acts priority=11 needs=self role=thing pattern="L [make|be|look|draw|show_me]? [yourself|me|it|the_face]? [without|with_no] D {thing:words}" example="Without a hat." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.another lang.en.frame act=change mode=other set=acts priority=12 needs=self role=thing pattern="L [try|show|give_me|let_me_see|i_want|have|use|put_on|wear]? [another|a_different|a_new|another_one] {thing:words}" example="Try a different hat." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.next lang.en.frame act=change mode=next set=acts priority=12 needs=self role=thing pattern="L [try|show|give_me|let_me_see|use|go_to|switch_to|change_to]? D [next|following|one_more] {thing:words}" example="Try the next hat." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.prev lang.en.frame act=change mode=prev set=acts priority=12 needs=self role=thing pattern="L [try|show|give_me|let_me_see|use|go_to|switch_to|change_to|go_back_to]? D [previous|prior|one_before] {thing:words}" example="Previous nose." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.swap lang.en.frame act=change mode=set set=acts priority=11 needs=be role=thing role=value pattern="L [swap|change|switch|replace|exchange] D {thing:words} [for|with|to|into|by] D {value:words}" example="Change the hat to a crown." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.self lang.en.frame act=change mode=set set=acts priority=12 needs=self role=value pattern="L [make|turn|change|paint] [yourself|urself|the_avatar|the_face|your_face|ur_face] {value:words}" example="Paint yourself green." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.be lang.en.frame act=change mode=be set=acts priority=10 needs=be role=value pattern="L [be|become|look|feel|turn_into|change_into|transform_into|morph_into|look_like|act_like] D {value:words}" example="Look happy." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.be.self lang.en.frame act=change mode=be set=acts priority=11 needs=be role=value pattern="L [make|let|get] [yourself|urself|myself|the_avatar|the_robot|the_face] [look|feel|be|become]? {value:words}" example="Make yourself happy." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.should.self lang.en.frame act=change mode=be set=acts priority=11 needs=be role=value pattern="D [avatar|robot|face] [should|must|has_to|needs_to|shall] [be|become|look|feel] D {value:words}" example="The avatar should be a clown." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.dir lang.en.frame act=place set=acts priority=13 needs=dir role=thing role=rel pattern="L [move|put|bring|push|pull|take|shift|raise|lower|make] D {thing:words} {rel:lex.acts.dir}" example="Move the eyes closer together." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.dir.bare lang.en.frame act=place set=acts priority=6 needs=dir role=thing role=rel pattern="D {thing:words} {rel:lex.acts.dir}" example="Eyes closer together." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.has lang.en.frame act=ask mode=has set=acts priority=12 needs=has role=thing pattern="[do|did|can|could] [you|u] [have|got|wear|see|has] D {thing:words}" example="Do you have glasses?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.has.2 lang.en.frame act=ask mode=has set=acts priority=12 needs=has role=thing pattern="[have|are] [you|u] [got|wearing|having] D {thing:words}" example="Are you wearing a hat?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.options lang.en.frame act=ask mode=options set=acts priority=12 needs=self role=thing pattern="[what|which] {thing:words} [are_there|can_you_have|can_you_wear|can_i_pick|can_i_choose|can_you_draw|can_you_put_on|can_i_try|can_you_show]" example="What hats are there?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.options.all lang.en.frame act=ask mode=options set=acts priority=12 needs=self pattern="[what|which] [can|could] [i|you|u] [change|customize|customise|modify|adjust|tweak|wear|put_on] [about_you|about_yourself|on_you]?" example="What can I change?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.state lang.en.frame act=ask mode=state set=acts priority=12 needs=be pattern="[how_do_you_feel|how_are_you_feeling|what_is_your_mood|what_is_your_expression|what_mood_are_you_in|how_are_you_looking|how_do_you_look_now]" example="What is your expression?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.describe lang.en.frame act=ask mode=describe set=acts priority=12 needs=self pattern="L [describe_yourself|describe_you|what_do_you_look_like|what_do_you_look_like_now|what_are_you_wearing|what_do_you_have_on|how_do_you_look|tell_me_what_you_look_like|describe_your_face|describe_your_look|describe_your_avatar|what_do_you_look_like_today]" example="What are you wearing?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.random lang.en.frame act=make mode=random set=acts priority=11 needs=self pattern="L [surprise|surprise_me|shuffle_yourself|randomise_yourself|randomize_yourself|make_a_random_face|a_random_face|something_random]" example="Surprise me." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.reset lang.en.frame act=remove mode=all set=acts priority=11 needs=self pattern="L [reset|reset_yourself|start_over|start_again|clear_your_face|go_back_to_normal|go_default]" example="Reset." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.call lang.en.frame act=change mode=set set=acts priority=12 needs=name role=value lit.attribute="name" pattern="L [call|name|rename] [yourself|urself|the_avatar] [to|as]? {value:rest}" example="Call yourself Robi." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.call.2 lang.en.frame act=change mode=set set=acts priority=12 needs=name role=value lit.attribute="name" pattern="L [i_will_call_you|i_am_calling_you|i_call_you|we_will_call_you|from_now_on_i_will_call_you|call_you] {value:rest}" example="I will call you Robi." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.name.is lang.en.frame act=change mode=set set=acts priority=12 needs=name role=value lit.attribute="name" pattern="L [from_now_on]? [your|ur] name [is|will_be|shall_be] {value:rest}" example="Your name is Robi." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.name.called lang.en.frame act=change mode=set set=acts priority=12 needs=name role=value lit.attribute="name" pattern="L [from_now_on]? [you|u] [are|r] [called|named] {value:rest}" example="You are called Ziggy." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.name lang.en.frame act=ask mode=what set=acts priority=12 needs=name lit.attribute="name" lit.thing="yourself" pattern="L [what_is_your_name|what_are_you_called|what_do_i_call_you|what_is_ur_name|tell_me_your_name]" example="What is your name?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.rel lang.en.frame act=place set=acts priority=12 needs=rel role=thing role=rel role=place pattern="L V.place D {thing:words} REL D {place:rest}" example="Put the circle next to the square." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.layout lang.en.frame act=place mode=layout set=acts priority=13 needs=layout role=thing role=rel pattern="L [V.place|arrange|lay_out|space_out|distribute|tidy|organise|organize] D {thing:words} [out|up]? [in|into|as|on|along|across]? D {rel:lex.acts.layout}" example="Line up the circles horizontally." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.layout.all lang.en.frame act=place mode=layout set=acts priority=8 needs=layout role=thing pattern="L [arrange|lay_out|tidy|organise|organize|space_out|distribute|align] D {thing:words} [out|up]?" example="Tidy up the circles." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.own lang.en.frame act=own set=acts priority=1 needs=reader role=rest tab-only=yes tab-priority=30 pattern="{rest:rest}" example="Which shape is the largest?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.frame lang.en.frame act=own set=acts priority=30 needs=reader role=pre role=post tab-only=no pattern="{pre:words} diagram {post:rest}" example="Make a diagram shaped like a house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.frame.end lang.en.frame act=own set=acts priority=30 needs=reader role=pre tab-only=no pattern="{pre:words} diagram" example="Add a star to the diagram." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.frame.shaped lang.en.frame act=own set=acts priority=30 needs=reader role=pre role=post tab-only=no pattern="{pre:words} [chart|layout|graph|box|boxes] [shaped|laid_out|arranged] [like|as] {post:rest}" example="Add a box shaped like a guitar." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.frame.form lang.en.frame act=own set=acts priority=30 needs=reader role=pre role=post tab-only=no pattern="{pre:words} [a|an] [shape|box] in_the [shape|form] of {post:rest}" example="Draw a shape in the form of a house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.bare.mod lang.en.frame act=make mode=bare set=acts priority=3 needs=bare role=pre role=thing pattern="L D {pre:words} {thing:KIND} [at_me|a_little|twice]?" example="Round glasses." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.bare lang.en.frame act=make mode=bare set=acts priority=3 needs=bare role=thing pattern="L D {thing:KIND} [at_me|a_little|twice]?" example="Glasses." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.wish lang.en.frame act=make set=acts.more priority=9 needs=wish role=thing pattern="L [$lang.shape.want] D {thing:words}" example="I want a house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.verb lang.en.frame act=make set=acts.more priority=2 needs=wish pattern="L V.make [something|please|pls|plz]?" example="Draw." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.need lang.en.frame act=make set=acts.more priority=9 needs=wish role=thing pattern="L [it_needs|there_should_be|there_must_be|we_need|let_there_be|there_needs_to_be|i_want_there_to_be] D {thing:words}" example="There should be a house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.mods lang.en.frame act=make set=acts.more priority=11 needs=wish role=amount role=m1 role=m2 role=thing pattern="L V.make [me|us]? D {amount:number?} {m1:VALUE?} {m2:VALUE?} {thing:KIND}" example="Draw a big red house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.more lang.en.frame act=make set=acts.more priority=14 needs=wish role=thing role=amount pattern="L [more|some_more|add_more|even_more] {thing:KIND} [like|about|say|make_it|total|so]? {amount:number}" example="More stars, like 4." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.bare.mods lang.en.frame act=make set=acts.more priority=4 needs=wish role=amount role=m1 role=m2 role=thing pattern="L D {amount:number?} {m1:VALUE?} {m2:VALUE?} {thing:KIND} [please|pls|plz|thx|thanks|now]?" example="A big red house please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.wish lang.en.frame act=change mode=set set=acts.more priority=12 needs=wish role=thing role=value pattern="L [$lang.shape.want] D {thing:words} [to_be|to_look|to_become|to_be_a|to_look_like|be]? {value:VALUE}" example="I want the house blue." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.would lang.en.frame act=change mode=set set=acts.more priority=12 needs=wish role=thing role=value pattern="L [i_would_like|i_d_like|id_like|i_want|i_need] D {thing:words} [to_be|to_look|to_become|to_be_a]? {value:VALUE}" example="I would like the sky to be pink." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.would.be lang.en.frame act=change mode=set set=acts.more priority=12 needs=wish role=value role=thing pattern="D {value:VALUE} {thing:words} [would_be_nicer|would_be_nice|would_look_better|would_be_better]" example="A purple sky would be nicer." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.short lang.en.frame act=change mode=set set=acts.more priority=4 needs=wish role=thing role=value pattern="L D {thing:words} {value:VALUE} [please|pls|plz|thx|thanks|only|now]?" example="House huge." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.short.first lang.en.frame act=change mode=set set=acts.more priority=4 needs=wish role=value role=thing pattern="L D {value:VALUE} {thing:words} [please|pls|plz|thx|thanks|now]?" example="Solid star." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.state.sky lang.en.frame act=change mode=set set=acts.more priority=11 needs=wish role=value pattern="[it_is|its|it_s|it_looks|it_gets|it_becomes|it_should_be|it_should_look_like|let_it_be|i_want_it_to_be|i_want_it|make_it|make_it_look_like|make_it_look|make_it_seem_like|turn_it_into|change_it_to|set_it_to] {value:VALUE} [time|mode|now|already|please|pls]? [time|mode]?" example="It is red." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.bare.value lang.en.frame act=change mode=set set=acts.more priority=3 needs=wish role=value pattern="L D {value:VALUE} [time|mode|please|pls]? [time|mode]?" example="Red." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.place.wish lang.en.frame act=place set=acts.more priority=12 needs=wish role=thing role=rel role=place pattern="L [$lang.shape.want] D {thing:words} REL D {place:words}" example="I want the house next to the tree." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.place.needs lang.en.frame act=place set=acts.more priority=11 needs=wish role=thing role=rel role=place pattern="L D {thing:words} [needs_to_be|should_be|must_be|has_to_be|goes|go|belongs|should_go|needs_to_go|should_stand|stands|is] REL D {place:words}" example="The house goes next to the tree." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.give lang.en.frame act=make set=acts.more priority=10 needs=wish role=place role=thing lit.rel="to" pattern="L give D {place:words} D {thing:rest}" example="Give the house a blue door." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.have lang.en.frame act=make set=acts.more priority=10 needs=wish role=place role=thing lit.rel="to" pattern="L [could|can|would|should|may|must] D {place:words} [have] D {thing:rest}" example="Could the house have a yellow door?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.no lang.en.frame act=remove set=acts.more priority=11 needs=wish role=thing pattern="L [i_do_not_want|i_dont_want|i_do_not_need|i_dont_need|no_more|no_longer_want|i_no_longer_need|i_dont_like|i_do_not_like|get_rid_of] D {thing:words} [anymore|any_more|please|pls]?" example="I do not want the house anymore." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.away lang.en.frame act=remove set=acts.more priority=12 needs=wish role=thing pattern="L V.remove D {thing:words} [away|off|out|up]" example="Clear the house away." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists lang.en.frame act=ask mode=has set=acts.more priority=13 needs=list role=thing pattern="[is|are|was] there [any|a|an|some|the]? {thing:words} [in|on|at|of]? [my|the|this|our]? NOUN?" example="Is there a house in my picture?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.have lang.en.frame act=ask mode=has set=acts.more priority=12 needs=list role=thing pattern="L [do|does|did|can] [i|we|you|u]? have D [any|some]? {thing:words} [in|on|at|of]? [my|the|this|our]? NOUN?" example="Do I have a house in my picture?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.noun lang.en.frame act=ask mode=has set=acts.more priority=12 needs=list role=thing pattern="L [does|do] D [my|the|this]? NOUN have D [any|some]? {thing:words}" example="Does my picture have a house?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.any lang.en.frame act=ask mode=has set=acts.more priority=8 needs=list role=thing pattern="[any|some] {thing:words} [in_there|in_here|there|here|in_it]" example="Any houses in there?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.is lang.en.frame act=ask mode=has set=acts.more priority=8 needs=list role=thing pattern="[is|are] D {thing:words} [in_there|in_here|there|here|in_it|in_the_picture|in_my_picture]" example="Is a house in there?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.color lang.en.frame act=ask mode=has set=acts.more priority=9 needs=list role=thing role=value pattern="[is|are] D {thing:words} {value:VALUE}" example="Is the house red?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe lang.en.frame act=ask mode=describe set=acts.more priority=11 needs=list pattern="L [describe|explain|summarise|summarize|list|show|tell_me_about|tell_me] D [my|the|this|our]? [whats_in|what_is_in|whats_on|what_is_on]? NOUN" example="Describe my picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe.whats lang.en.frame act=ask mode=describe set=acts.more priority=14 needs=list pattern="L [describe|explain|summarise|summarize|list|show|tell_me|tell_us] [whats_in|what_is_in|whats_on|what_is_on|what_s_on|what_s_in|what_is_there_in|what_is_there_on] D [my|the|this|our]? NOUN" example="Explain whats on the page." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe.what lang.en.frame act=ask mode=describe set=acts.more priority=14 needs=list pattern="L [tell_me|show_me|let_me_know]? [what|whats|which] [is|are|s|have_i_got|can_you_see|do_you_see|can_i_see|do_i_have]? [in|on|at|of] [my|the|this|our]? NOUN [right_now|now|there]?" example="What is in my picture?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe.made lang.en.frame act=ask mode=describe set=acts.more priority=11 needs=list pattern="L [tell_me|show_me|let_me_know]? [what|whats] [did_i|have_i|i|we|did_we|have_we] [draw|drew|drawn|make|made|add|added|put|do|done|create|created|paint|painted] [so_far|today|here]?" example="What did I draw?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe.see lang.en.frame act=ask mode=describe set=acts.more priority=14 needs=list pattern="L [what|whats|which] [things|objects|shapes]? [can_you_see|do_you_see|can_i_see|do_i_see|are_there|is_there|is_visible|have_i_got] [in|on]? [my|the|this]? NOUN [right_now|now|there]?" example="What can you see in my picture?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options lang.en.frame act=ask mode=options set=acts.more priority=11 needs=list role=thing pattern="L [what|which|list|show|tell_me|show_me|name] [the]? {thing:words} [can_i|could_i|can_you|may_i|do_you_know|are_there|are_available|do_i_have|do_you_have|can_we|is_available|options]" example="What colours can I use?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options.what lang.en.frame act=ask mode=options set=acts.more priority=11 needs=list pattern="L [what|which|whats] [can_i|could_i|can_you|can_u|could_u|can_we|may_i|do_you_know|do_i_have] [draw|add|make|use|paint|do|put|sketch|pick|choose] [to_my_picture|to_the_picture|to_my_drawing|to_it|in_my_picture|here]?" example="What can I draw?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options.show lang.en.frame act=ask mode=options set=acts.more priority=11 needs=list pattern="L [show_me|tell_me|list|name] [what|which] [i|you|we] [can|could] [draw|add|make|use|paint|do|put|sketch]" example="Show me what I can draw." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options.verb lang.en.frame act=ask mode=options set=acts.more priority=6 needs=list role=thing pattern="L [list|show|name|tell_me] D [the|all|all_the|all_of_the|your]? {thing:words} [list|options|available|you_know|i_can_use|i_can_add|i_can_draw|i_can_make]?" example="List the things I can draw." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options.short lang.en.frame act=ask mode=options set=acts.more priority=5 needs=list role=thing pattern="L {thing:words} [list|options|available|are_available|do_i_have|can_i_use]" example="Colour list please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.verb lang.en.frame act=ask mode=count set=acts.more priority=12 needs=say role=thing pattern="L [count|tally|number|total] D {thing:words} [in|on|at|of]? [my|the|this|our]? NOUN?" example="Count the houses." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.number lang.en.frame act=ask mode=count set=acts.more priority=12 needs=say role=thing pattern="L [tell_me|show_me|let_me_know]? [the_number_of|number_of|count_of|total_number_of|the_count_of|the_total_of] D {thing:words} [in|on|at|of]? [my|the|this|our]? NOUN?" example="Number of houses in the picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.tail lang.en.frame act=ask mode=count set=acts.more priority=8 needs=say role=thing pattern="L D {thing:words} [count|total|number]" example="House count?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.first lang.en.frame act=ask mode=count set=acts.more priority=8 needs=say role=thing pattern="L D {thing:words} how_many [are_there|do_i_have|are_in_there|are_in_it]?" example="Houses how many?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.tell lang.en.frame act=ask mode=count set=acts.more priority=13 needs=say role=thing pattern="L [tell_me|show_me|let_me_know|can_you_tell_me|do_you_know] how_many {thing:words} [are|is|there|are_there]? [there]? [in|on|at|of]? [my|the|this|our]? NOUN?" example="Tell me how many houses there are." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.where.did lang.en.frame act=ask mode=where set=acts.more priority=12 needs=say role=thing pattern="L [tell_me|show_me|let_me_know]? [where|which_spot|which_place|which_part|what_place] [is|are|did|do|can_i_see|can_i_find|will_i_find|should_i_look_for|do_i_find]? [i_find|i_see|you_put|you_draw|you_place]? D {thing:words} [go|now|exactly|are|is|in|at|located|live]?" example="Where did the house go?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.where.find lang.en.frame act=ask mode=where set=acts.more priority=11 needs=say role=thing pattern="L [find|locate|point_to|point_at|look_for|spot] D {thing:words}" example="Find the house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.where.of lang.en.frame act=ask mode=where set=acts.more priority=12 needs=say role=thing pattern="L [location_of|position_of|place_of|whereabouts_of|spot_of] D {thing:words}" example="Location of the house?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.where.tail lang.en.frame act=ask mode=where set=acts.more priority=8 needs=say role=thing pattern="L D {thing:words} where [exactly|is_it|are_they|now]?" example="House where?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.attr.of lang.en.frame act=ask mode=what set=acts.more priority=12 needs=say role=attribute role=thing pattern="L [tell_me|show_me|let_me_know|can_you_tell_me]? [what_is|whats|what_s|which_is]? D {attribute:ATTR} of D {thing:words}" example="Tell me the colour of the house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.colour.painted lang.en.frame act=ask mode=what set=acts.more priority=12 needs=say role=thing lit.attribute="colour" pattern="L [what|whats|what_s|what_is|what_colour_is|what_color_is|which_colour_is|which_color_is] D {thing:words} [painted|coloured|colored|drawn|made]" example="Whats the house painted?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.attr.short lang.en.frame act=ask mode=what set=acts.more priority=6 needs=say role=thing role=attribute pattern="L D {thing:words} {attribute:ATTR}" example="House colour?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.copy.another lang.en.frame act=copy set=acts.more priority=11 needs=say role=thing pattern="L [make|get_me|give_me|add|get|i_want|let_me_have]? [me]? [another|one_more|1_more|a_second|a_twin_of|a_copy_of|a_second_copy_of|a_duplicate_of|a_clone_of|yet_another] [one|copy|of_it|of_that|of_them]? {thing:words?}" example="Make another house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.copy.n lang.en.frame act=copy set=acts.more priority=12 needs=say role=amount role=thing pattern="L V.make {amount:number} more [of_them|of_it|of_that]? {thing:words?}" example="Make 2 more." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.copy.short lang.en.frame act=copy set=acts.more priority=6 needs=say role=thing pattern="L D {thing:words} [copy|twin|duplicate|clone] [please|pls|plz]?" example="House copy please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.cmp.more.amt lang.en.frame act=change mode=more set=acts.more priority=13 needs=scale role=thing role=amount role=value pattern="L V.set D {thing:words} {amount:lex.space.amounts?} {value:MORE} {amount2:lex.space.amounts?}" example="Make the house a bit bigger." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.cmp.less.amt lang.en.frame act=change mode=less set=acts.more priority=13 needs=scale role=thing role=amount role=value pattern="L V.set D {thing:words} {amount:lex.space.amounts?} {value:LESS} {amount2:lex.space.amounts?}" example="Make the house a bit smaller." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.cmp.should lang.en.frame act=change mode=more set=acts.more priority=12 needs=scale role=thing role=amount role=value pattern="D {thing:words} [needs_to_be|should_be|must_be|has_to_be|is_too|is_not] {amount:lex.space.amounts?} {value:MORE}" example="The house needs to be a lot bigger." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.cmp.short.more lang.en.frame act=change mode=more set=acts.more priority=4 needs=scale role=thing role=amount role=value pattern="L D {thing:words} {amount:lex.space.amounts?} {value:MORE} [please|pls|plz|thx|thanks]?" example="House a little bigger." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.cmp.short.less lang.en.frame act=change mode=less set=acts.more priority=4 needs=scale role=thing role=amount role=value pattern="L D {thing:words} {amount:lex.space.amounts?} {value:LESS} [please|pls|plz|thx|thanks]?" example="House a little smaller." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.cmp.first.more lang.en.frame act=change mode=more set=acts.more priority=4 needs=scale role=value role=thing pattern="L D {value:MORE} {thing:words} [please|pls|plz|thx|thanks]?" example="Bigger house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.cmp.first.less lang.en.frame act=change mode=less set=acts.more priority=4 needs=scale role=value role=thing pattern="L D {value:LESS} {thing:words} [please|pls|plz|thx|thanks]?" example="Smaller house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.grow lang.en.frame act=change mode=more set=acts.more priority=12 needs=scale role=thing role=amount lit.value="bigger" pattern="L [enlarge|grow|expand|blow_up|inflate|magnify|stretch|make_bigger|scale_up] D {thing:words} {amount:lex.space.amounts?}" example="Enlarge the house a lot." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.shrink lang.en.frame act=change mode=less set=acts.more priority=12 needs=scale role=thing role=amount lit.value="smaller" pattern="L [shrink|reduce|compress|minimise|minimize|deflate|scale_down|make_smaller] D {thing:words} {amount:lex.space.amounts?}" example="Shrink the house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.same lang.en.frame act=change mode=same set=acts.more priority=15 needs=scale role=thing role=value pattern="L V.set D {thing:words} [to_be]? [the_same_size_as|the_same_size_like|same_size_as|as_big_as|as_large_as|as_small_as|as_tall_as|the_same_as|equal_in_size_to] D {value:words}" example="Make the tree the same size as the house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.same.short lang.en.frame act=change mode=same set=acts.more priority=13 needs=scale role=value pattern="L [the_same_size_as|same_size_as|as_big_as|as_large_as|as_small_as|the_same_as] D {value:words}" example="The same size as the house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.times lang.en.frame act=change mode=more set=acts.more priority=12 needs=scale role=thing role=value pattern="L V.set D {thing:words} {value:FACTOR} [as_big|as_large|as_tall|as_wide|as_small|as_big_as_it_is|the_size]" example="Make the house twice as big." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.times.short lang.en.frame act=change mode=more set=acts.more priority=12 needs=scale role=value pattern="L {value:FACTOR} [as_big|as_large|as_tall|as_wide|as_small|the_size]" example="Twice as big." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.place.dir.amt lang.en.frame act=place set=acts.more priority=13 needs=scale role=thing role=amount role=rel role=amount2 pattern="L [V.place|move|put|bring|push|pull|take|shift|raise|lower|make|nudge|needs_to_go|should_go|needs_to_move|should_move|goes|go]? D {thing:words} {amount:lex.space.amounts?} [to_the|to|towards]? {rel:lex.acts.dir} {amount2:lex.space.amounts?}" example="Move the house up a bit." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.turn lang.en.frame act=change mode=turn set=acts.more priority=15 needs=turn role=thing role=value role=amount pattern="L [turn|flip|rotate|spin|mirror|swivel|reverse|swing] D {thing:words} {value:TURN?} {amount:number?} [degrees|degree]?" example="Turn the house around." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.turn.make lang.en.frame act=change mode=turn set=acts.more priority=14 needs=turn role=thing role=value pattern="L [make|let|have|get] D {thing:words} [look|face|turn|go|point]? {value:TURN}" example="Make the house look the other way." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.turn.state lang.en.frame act=change mode=turn set=acts.more priority=5 needs=turn role=thing role=value pattern="L D {thing:words} [turns|turn|goes|go|looks|look|faces|face|should_go|should_look|should_face|should_turn|needs_to_turn|needs_to_look|should_be_turned|to_look|to_face]? {value:TURN}" example="The house should look the other way." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.turn.wish lang.en.frame act=change mode=turn set=acts.more priority=12 needs=turn role=thing role=value pattern="L [$lang.shape.want] D {thing:words} [turned|flipped|rotated|mirrored|reversed|to_turn|to_face|to_look]? {value:TURN}" example="I want the house turned around." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.all lang.en.frame act=remove mode=all set=acts.more priority=12 needs=clear lit.thing="everything" pattern="L [clear|wipe|erase|delete|remove|empty|scrap|clean|get_rid_of|throw_away] [everything|all|it_all|all_of_it|all_off|all_of_this] [off|away|out|ok|okay|please|pls]?" example="Clear everything." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.all.noun lang.en.frame act=remove mode=all set=acts.more priority=12 needs=clear lit.thing="everything" pattern="L [clear|wipe|erase|delete|remove|empty|scrap|clean|get_rid_of|throw_away] [the|my|this|our]? [whole|entire|all_of_the]? NOUN [off|away|out|ok|okay|please|pls]?" example="Clear the picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.new lang.en.frame act=remove mode=new set=acts.more priority=12 needs=clear lit.thing="everything" pattern="L [start|begin|open|get|give_me|make|let_s_start|lets_start|i_want|i_need|show_me]? [a|an|another]? [new|fresh|blank|clean|empty] NOUN? [sheet|sheet_of_paper|of_paper|page|canvas|start]? [of_paper]? [please|pls]?" example="Start a new picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.random lang.en.frame act=make mode=random set=acts.more priority=11 needs=random pattern="L [surprise_me|surprise_us|surprise] [with_a_picture|with_a_drawing|with_something]? [for_me|pls|please|thx]?" example="Surprise me." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.random.picture lang.en.frame act=make mode=random set=acts.more priority=11 needs=random pattern="L [i_want_you_to]? [draw|make|paint|sketch|create|doodle|give_me|show_me|i_want|whip_up] [me|us]? [a|an|the|some]? [random|nice|pretty|beautiful|lovely|new|cool|happy|sunny|surprise|surprising]? [picture|scene|landscape|drawing|painting|masterpiece|surprise] [for_me|pls|please|thx]?" example="Draw me a nice picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.random.any lang.en.frame act=make mode=random set=acts.more priority=11 needs=random pattern="L [i_want_you_to]? [draw|make|paint|sketch|create|doodle|give_me|show_me|whip_up] [me|us]? [something|anything|whatever|something_nice|something_random|something_pretty|anything_nice] [you_like|you_want|you_feel_like]? [for_me|pls|please|thx]?" example="Draw something." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.pick.none lang.en.frame act=pick mode=none set=acts.more priority=12 needs=none pattern="L [deselect|unselect|unpick|unmark|unhighlight|untick|unselected] [everything|all|it|that|this|them|the_selection|the_highlight|the_highlights]? [please|pls|plz]?" example="Deselect everything." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.pick.none.state lang.en.frame act=pick mode=none set=acts.more priority=12 needs=none pattern="L [nothing|no_thing|none] [selected|highlighted|picked|marked] [please|pls|plz|now]?" example="Nothing selected please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.pick.none.clear lang.en.frame act=pick mode=none set=acts.more priority=12 needs=none pattern="L [clear|remove|drop|forget|cancel|stop] D [the|my|this]? [selection|highlight|highlights|highlighting]" example="Clear the selection." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.pick.click lang.en.frame act=pick mode=pick set=acts.more priority=11 needs=none role=thing pattern="L [click|tap|touch|press|click_on|tap_on|touch_on] D {thing:words}" example="Click the second tree." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.save.noun lang.en.frame act=save set=acts.more priority=11 needs=none role=value pattern="L V.save D NOUN [as|in|to|under|called]? D {value:words}" example="Save my picture as SVG." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.save.download lang.en.frame act=save set=acts.more priority=11 needs=none role=value pattern="L [download|export|get] D NOUN [as|in|to|under|called|a]? D {value:words}" example="Download the drawing as a PNG." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.undo.verb lang.en.frame act=undo set=acts.more priority=11 needs=none pattern="L V.undo [that|it|this|the_last|my_last|the|one]? [thing|change|step|action|move|one|drawing]? [back]? [please|pls|plz]?" example="Undo that change." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.part.needs lang.en.frame act=make set=acts.more priority=10 needs=wish role=place role=thing lit.rel="to" pattern="L D {place:words} [needs|should_have|must_have|has_to_have|needs_to_have|ought_to_have] D {thing:rest}" example="The house needs a pink door." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.would lang.en.frame act=make set=acts.more priority=10 needs=ground role=thing pattern="D [bit_of|little|some|lots_of|a_lot_of|more]? {thing:words} [would_be_nice|would_be_nicer|would_be_good|would_look_nice|would_be_cool|would_be_great]" example="A bit of snow would be nice." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.value.size lang.en.frame act=change mode=set set=acts.more priority=14 needs=scale role=thing role=value pattern="L [make|turn|get|let|change|blow_up|scale_up|scale|resize] D {thing:words} [to_be|to|up_to|into|be|as]? [a|an]? {value:VALUE} [size|sized|sized_one|one|in_size]" example="Turn the house into a tiny one." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.value.size.up lang.en.frame act=change mode=set set=acts.more priority=14 needs=scale role=thing role=value pattern="L [blow|scale|build|make|puff|pump|grow] D {thing:words} up [to|into]? [a|an]? {value:VALUE} [size|sized|in_size]?" example="Blow the cat up to huge size." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.should.size lang.en.frame act=change mode=set set=acts.more priority=14 needs=scale role=thing role=value pattern="D {thing:words} [needs_to_be|should_be|must_be|has_to_be|ought_to_be] {value:VALUE} [size|sized|in_size]" example="The house should be medium size." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.with lang.en.frame act=change mode=set set=acts.more priority=15 needs=scale role=thing role=value pattern="L [fill|fill_in|colour|color|paint|cover|colour_in|color_in|dye|tint] D {thing:words} [with|in|using] D {value:VALUE}" example="Fill the sun with yellow." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.in lang.en.frame act=change mode=set set=acts.more priority=6 needs=scale role=thing role=value pattern="L D {thing:words} in {value:VALUE} [please|pls|plz|thx|thanks]?" example="House in teal please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.fill.in lang.en.frame act=change mode=set set=acts.more priority=13 needs=scale role=thing lit.value="crayon" pattern="L [fill_in|colour_in|color_in|fill] D {thing:words} [in|in_please]?" example="Fill in the star." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.near lang.en.frame act=ask mode=what set=acts.more priority=13 needs=say role=place lit.rel="near" pattern="L [what|whats|what_s|anything|is_anything|is_there_anything|what_is|what_things_are|which_things_are] [right|just]? [near|nearby|close_to|around] D {place:words}" example="Whats near the sun?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.beside lang.en.frame act=ask mode=what set=acts.more priority=13 needs=say role=place lit.rel="next to" pattern="L [what|whats|what_s|anything|is_anything|is_there_anything|what_is|what_things_are|which_things_are] [right|just]? [next_to|beside|by|alongside|right_by] D {place:words}" example="Anything next to the cloud?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.value.d lang.en.frame act=change mode=set set=acts.data priority=13 needs=valued role=thing role=value pattern="L V.set D {thing:words} [to|be|as|into]? D {value:VALUE} NOUN?" example="Make it a pie chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.as lang.en.frame act=change mode=set set=acts.data priority=13 needs=valued role=thing role=value pattern="L [show|plot|draw|display|present|chart|switch|convert|change|turn|make] D {thing:words} [as|into|to|in_to] D {value:VALUE} NOUN?" example="Show it as a line." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.value.first lang.en.frame act=change mode=set set=acts.data priority=4 needs=valued role=value pattern="L D {value:VALUE} {thing:KIND?} NOUN? [instead|again|please|pls|now|then]?" example="Line graph instead." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.value.use lang.en.frame act=change mode=set set=acts.data priority=10 needs=valued role=value pattern="L [use|try|give_me|show|show_me|let_me_see|i_want|i_prefer|i_d_prefer] D {value:VALUE} {attribute:ATTR?} NOUN?" example="Use rainbow colors." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.want lang.en.frame act=change mode=set set=acts.data priority=11 needs=valued role=thing role=value pattern="[i_want|i_d_like|i_would_like|i_need|we_want|can_i_have|could_i_have|let_s_have|lets_have] D {thing:words} {value:VALUE}" example="I want the bars green." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.nice lang.en.frame act=change mode=set set=acts.data priority=12 needs=valued role=thing role=value pattern="L V.set D {thing:words} [to|be|as|into]? D [nice|lovely|pretty|good|really|very|sort_of|kind_of|bit_more]? {value:VALUE}" example="Paint the bars a nice green." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.would lang.en.frame act=change mode=set set=acts.data priority=9 needs=valued role=value pattern="L D {value:VALUE} [would_be|is|looks|would_look|will_be|should_be] [nicer|better|best|good|great|prettier|nice|fine]" example="Pink would be nicer." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.is.value lang.en.frame act=change mode=set set=acts.data priority=11 needs=valued role=thing role=value pattern="D {thing:words} [is|are|looks|look|turns|turned|became|become|is_now|are_now|now_is|now_are] {value:VALUE} [now|instead|please]?" example="The bars are teal now." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.like lang.en.frame act=change mode=set set=acts.data priority=12 needs=valued role=thing role=value role=attribute pattern="L V.set D {thing:words} [like|as|in|with] D {value:VALUE} {attribute:ATTR?}" example="Colour it like a rainbow." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.value.attr lang.en.frame act=change mode=set set=acts.data priority=8 needs=valued role=value role=attribute pattern="L D {value:VALUE} {attribute:ATTR} [please|pls|plz|thx|thanks|instead|again]?" example="Pastel colours please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.value.prefer lang.en.frame act=change mode=set set=acts.data priority=10 needs=valued role=value pattern="[i_prefer|i_like|i_d_like|i_would_like|we_prefer] D {value:VALUE} NOUN?" example="I prefer a bar chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.name lang.en.frame act=change mode=name set=acts.data priority=12 needs=valued role=thing role=value pattern="L [call|name|title|label|rename|retitle] D {thing:words} [to|as]? {value:rest}" example="Call it Fruit." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.name.to lang.en.frame act=change mode=name set=acts.data priority=14 needs=valued role=thing role=value pattern="L [rename|relabel|retitle|change_the_name_of] D {thing:words} [to|into|as] {value:rest}" example="Rename pears to cherries." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.swap.for lang.en.frame act=change mode=name set=acts.data priority=12 needs=valued role=thing role=value pattern="L [swap|replace|exchange|trade|switch] D {thing:words} [for|with] D {value:rest}" example="Swap grapes for melons." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.should.text lang.en.frame act=change mode=set set=acts.data priority=12 needs=valued role=attribute role=value pattern="D {attribute:ATTR} [should_be|is|will_be|shall_be|must_be|needs_to_be|becomes] {value:rest}" example="The title should be Snacks." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.use.as lang.en.frame act=change mode=set set=acts.data priority=13 needs=valued role=value role=attribute pattern="L [use|put|set|take|make|have] {value:words} [as|for] D {attribute:ATTR}" example="Use Zoo as the title." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.colon lang.en.frame act=change mode=set set=acts.data priority=4 needs=valued role=attribute role=value pattern="D {attribute:ATTR} {value:rest}" example="Title: My fruit." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.on lang.en.frame act=change mode=set set=acts.data priority=12 needs=valued role=attribute lit.value="on" pattern="L [show|display|bring|turn_on|enable|switch_on|put_on|give_me|show_me|bring_back|add] D {attribute:ATTR} [back|on|again]?" example="Show the legend." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.off lang.en.frame act=change mode=set set=acts.data priority=12 needs=valued role=attribute lit.value="off" pattern="L [hide|turn_off|disable|switch_off|stop|kill|remove|drop|delete|get_rid_of|lose|skip|cut] D {attribute:ATTR} [off|away|out|hidden]?" example="Hide the legend." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.turn lang.en.frame act=change mode=set set=acts.data priority=13 needs=valued role=attribute role=value pattern="L [take|turn|switch|put|get|send|bring] D {attribute:ATTR} {value:VALUE}" example="Take the legend off." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.switch lang.en.frame act=change mode=set set=acts.data priority=7 needs=valued role=attribute role=value pattern="D {attribute:ATTR} {value:VALUE}" example="Legend off." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.no lang.en.frame act=change mode=set set=acts.data priority=6 needs=valued role=attribute lit.value="off" pattern="L [no|without|no_more] D {attribute:ATTR}" example="No stacking." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.un lang.en.frame act=change mode=set set=acts.data priority=6 needs=valued role=attribute lit.value="off" pattern="L [un|do_not|dont|stop|no_longer] {attribute:ATTR}" example="Stop stacking." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.ask.what.thing lang.en.frame act=ask mode=what set=acts.data priority=7 needs=valued role=thing pattern="[what_is|whats|what_s|what_are|how_much_is|how_much_are|how_big_is|how_big_are|how_many_is] D {thing:words}" example="What is plums?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.ask.attr.tell lang.en.frame act=ask mode=what set=acts.data priority=8 needs=valued role=thing role=attribute pattern="L [tell_me|show_me|give_me|what_is|whats|what_s] D {thing:words} {attribute:ATTR}" example="Tell me the pears number." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.chart.without lang.en.frame act=change mode=set set=acts.data priority=12 needs=valued role=thing role=attribute lit.value="off" pattern="L D {thing:words} [without|with_no|minus] D {attribute:ATTR}" example="Chart without a title." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.number lang.en.frame act=change mode=set set=acts.data priority=12 needs=valued role=thing role=value pattern="L [V.set|set|put|update|correct|fix|make|put_down] D {thing:words} [to|be|as|at|equal_to|up_to]? {value:number} [now|instead|please|pls]?" example="Change pears to 6." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.is.number lang.en.frame act=change mode=set set=acts.data priority=11 needs=valued role=thing role=value pattern="D {thing:words} [is|are|should_be|must_be|will_be|equals|has|have|is_now|are_now|needs_to_be] {value:number} [now|instead|not_3|not_8|please]?" example="The pears are 4 now." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.is.number.not lang.en.frame act=change mode=set set=acts.data priority=13 needs=valued role=thing role=value pattern="D {thing:words} [is|are|should_be|must_be] {value:number} [not|and_not|instead_of|rather_than] {rest:rest}" example="Plums are 2 not 8." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.fix.number lang.en.frame act=change mode=set set=acts.data priority=13 needs=valued role=thing role=value pattern="L [wait|no|oops|sorry|actually]? D {thing:words} [is|are] {value:number} [not|and_not|instead_of] {rest:rest} [fix_it|correct_it|change_it]?" example="Wait, pears are 6 not 3, fix it." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.bare.number lang.en.frame act=change mode=set set=acts.data priority=3 needs=valued role=thing role=value pattern="{thing:words} {value:number}" example="Pears 7." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.by lang.en.frame act=change mode=more set=acts.data priority=13 needs=valued role=thing role=amount pattern="L [increase|raise|boost|bump|bump_up|push_up|up|grow|add|put_up] D {thing:words} by {amount:number}" example="Increase apples by 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.by.less lang.en.frame act=change mode=less set=acts.data priority=13 needs=valued role=thing role=amount pattern="L [decrease|lower|reduce|cut|drop|take|bring_down|push_down|down|shrink|subtract] D {thing:words} by {amount:number}" example="Lower apples by 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.plus lang.en.frame act=change mode=more set=acts.data priority=6 needs=valued role=thing role=amount pattern="D {thing:words} [plus|and] {amount:number}" example="Apples plus 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.minus lang.en.frame act=change mode=less set=acts.data priority=6 needs=valued role=thing role=amount pattern="D {thing:words} [minus|less] {amount:number}" example="Apples minus 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.fewer lang.en.frame act=change mode=less set=acts.data priority=8 needs=valued role=amount role=thing pattern="L {amount:number} [fewer|less] {thing:words}" example="2 fewer apples." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.more.n lang.en.frame act=change mode=more set=acts.data priority=8 needs=valued role=amount role=thing pattern="L {amount:number} more {thing:words}" example="2 more apples." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.factor lang.en.frame act=change mode=scale set=acts.data priority=13 needs=valued role=value role=thing pattern="L {value:FACTOR} D {thing:words}" example="Double the kiwis." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.halve lang.en.frame act=change mode=scale set=acts.data priority=13 needs=valued role=thing lit.value="half" pattern="L [halve|halfen|cut_in_half|half] D {thing:words}" example="Halve plums." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.times.by lang.en.frame act=change mode=scale set=acts.data priority=13 needs=valued role=thing role=amount lit.value="times" pattern="L [multiply|times] D {thing:words} by {amount:number}" example="Multiply kiwis by 3." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.divide.by lang.en.frame act=change mode=scale set=acts.data priority=13 needs=valued role=thing role=amount lit.value="divide" pattern="L [divide|split|cut] D {thing:words} by {amount:number}" example="Divide kiwis by two." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.cut.half lang.en.frame act=change mode=scale set=acts.data priority=16 needs=valued role=thing lit.value="half" pattern="L [cut|reduce|bring_down] D {thing:words} by half" example="Cut the plums by half." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.remove.nomore lang.en.frame act=remove set=acts.data priority=5 needs=valued role=thing pattern="L [no_more|no] D {thing:words}" example="No more bananas." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.remove.dont lang.en.frame act=remove set=acts.data priority=12 needs=valued role=thing pattern="L [i_dont_want|i_do_not_want|i_no_longer_want|we_dont_need|i_dont_need|dont_want|do_not_want|i_dont_like] D {thing:words} [anymore|any_more|in_it|on_it|in_there]?" example="I don't want pears anymore." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.remove.off lang.en.frame act=remove set=acts.data priority=8 needs=valued role=thing pattern="L D {thing:words} off [the|my|this|that]? NOUN" example="Plums off the chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.remove.out.all lang.en.frame act=remove mode=all set=acts.data priority=11 needs=valued pattern="L [take|get|clear|wipe|pull|throw|empty] D [all|every|everything]? {thing:KIND?} [out|away|off]" example="Take all the values out." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.remove.chart lang.en.frame act=remove set=acts.data priority=14 needs=valued role=thing pattern="L [delete|remove|get_rid_of|throw_away|scrap|trash|drop|bin|lose] D {thing:KIND}" example="Delete this chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.make.in lang.en.frame act=make set=acts.data priority=14 needs=valued role=thing pattern="L [include|put|insert|stick|throw|pop|slip|tuck] D {thing:words} [in|into|on|onto|to] D [the|this|my|that]? NOUN" example="Include 6 grapes in the chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.make.data.as lang.en.frame act=make mode=data set=acts.data priority=13 needs=valued role=rest role=value pattern="L [plot|chart|graph|draw|visualize|visualise|show|display]? {rest:words(14)} [as|in|into|on] D {value:VALUE} NOUN" example="Plot x 1 y 2 z 3 as a pie chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.make.data.as.noun lang.en.frame act=make mode=data set=acts.data priority=12 needs=valued role=rest pattern="L [plot|chart|graph|draw|visualize|visualise|show|display]? {rest:words(14)} [as|in|into|on] D NOUN" example="Bikes 4 scooters 9 as a graph." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.make.data.verb lang.en.frame act=make mode=data set=acts.data priority=9 needs=valued role=rest pattern="L [chart|plot|graph|visualize|visualise] {rest:rest}" example="Chart apples 5, pears 3 and plums 8." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.pick.go lang.en.frame act=pick set=acts.data priority=12 needs=valued role=thing pattern="L [go_to|go_back_to|go_back|switch_to|show|show_me|open|bring_up|back_to|jump_to|flip_to|move_to|take_me_to] D {thing:words}" example="Go to chart 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.pick.ord lang.en.frame act=pick set=acts.data priority=5 needs=valued role=amount role=thing pattern="L D {amount:lex.lang.ordinal} {thing:words?}" example="The second chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.pick.next lang.en.frame act=pick mode=next set=acts.data priority=6 needs=valued role=thing pattern="L [go_to|show|show_me|open|switch_to]? D [next|following|one_after] {thing:words?}" example="The next chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.pick.prev lang.en.frame act=pick mode=prev set=acts.data priority=6 needs=valued role=thing pattern="L [go_to|go_back_to|show|show_me|open|switch_to|back_to]? D [previous|prev|prior|one_before|last_one] {thing:words?}" example="The previous chart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.pick.number lang.en.frame act=pick set=acts.data priority=11 needs=valued role=thing role=amount pattern="L {thing:KIND} [number|no|num|nr]? {amount:number}" example="Chart number 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.sort lang.en.frame act=change mode=order set=acts.data priority=32 needs=ordered role=value pattern="L [sort|order|arrange|rank|rearrange|line_up] [them|it|the_bars|the_items|the_chart]? [from|by|in|according_to|alphabetically]? {value:rest}" example="Sort from biggest to smallest." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.adj lang.en.frame act=change mode=set set=acts.data priority=6 needs=valued role=thing role=attribute lit.value="on" pattern="L V.set D {thing:words} {attribute:ATTR}" example="Make it stacked." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.adj.short lang.en.frame act=change mode=set set=acts.data priority=4 needs=valued role=attribute lit.value="on" pattern="L {attribute:ATTR} [please|pls|plz|thx|thanks|now]" example="Stacked please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.sort.first lang.en.frame act=change mode=order set=acts.data priority=8 needs=ordered role=value pattern="L D {value:words} first" example="Biggest first." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.sort.order lang.en.frame act=change mode=order set=acts.data priority=8 needs=ordered role=value pattern="L [in|by] D {value:words} order" example="In alphabetical order." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.data.change.sort.stop lang.en.frame act=change mode=order set=acts.data priority=11 needs=ordered lit.value="none" pattern="L [stop|do_not|dont|no|undo_the|quit|no_more|forget_the|remove_the] [sorting|sort|ordering|order|sort_it]" example="Stop sorting." core.source="psys2 worlds/acts 2026-11-14"

# set=acts.text are the forms of a world whose things are the blocks of a TEXT (flag textual): a document, notes, a letter. A block is made with its words ("add a heading Shopping"), text is written
# and continued, a verb that is itself a value of an attribute names the value first ("bold the second paragraph", "center the title"), a link or a highlight is a value of its attribute.
@lang.en.frame.acts.text.make.text lang.en.frame act=make mode=text set=acts.text priority=13 needs=textual role=thing role=value pattern="L [V.make|write|type|put_in|put|create|start|begin|new|insert]? [a|an|another|one_more|1_more|some]? [new]? {thing:KIND} [saying|called|named|titled|that_says|that_reads|reading|with_the_text|with|of|containing|including|about|says]? {value:rest}" example="Add a heading Shopping." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.make.blank lang.en.frame act=make mode=blank set=acts.text priority=12 needs=textual role=thing pattern="L [start|begin|add|insert|create|make|open]? D [new|next|blank|empty|another|fresh] {thing:KIND}" example="Start a new chapter." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.make.numbered lang.en.frame act=make mode=numbered set=acts.text priority=12 needs=textual role=thing role=amount role=value pattern="L {thing:KIND} {amount:number} {value:rest?}" example="Chapter 3: The Return." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.make.write lang.en.frame act=make mode=write set=acts.text priority=12 needs=textual role=value pattern="L [write|type|jot_down|note_down|put_down|write_down|add_the_text|add_text|insert_the_text] [the_following|this|the_text|text]? {value:rest(quotes)}" example="Write once upon a time." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.make.continue lang.en.frame act=make mode=continue set=acts.text priority=11 needs=textual role=value pattern="L [continue|carry_on|go_on|keep_going] [with|by]? {value:rest}" example="Continue with the owl flew away." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.change.verb lang.en.frame act=change mode=set set=acts.text priority=12 needs=textual role=value role=thing pattern="L {value:VALUE} D {thing:words}" example="Bold the second paragraph." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.change.highlight lang.en.frame act=change mode=set set=acts.text priority=13 needs=textual lit.attribute="highlight" role=thing role=value pattern="L [highlight|mark|shade|colour|color|put_a_highlight_on|put_highlight_on] D {thing:words} [in|with|using|to|as]? {value:VALUE}" example="Highlight the word milk in green." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.change.highlight.after lang.en.frame act=change mode=set set=acts.text priority=11 needs=textual lit.attribute="highlight" role=thing role=value pattern="L D {thing:words} [should_be|must_be|to_be|be]? [highlighted|marked|shaded] [in|with]? {value:VALUE}" example="Milk should be highlighted green." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.change.link lang.en.frame act=change mode=set set=acts.text priority=14 needs=textual lit.attribute="link" role=value role=thing pattern="L [add|put|insert|make]? D [link|hyperlink] [to|pointing_to] {value:words} [on|for|to] D {thing:words}" example="Add a link to example dot com on the word krill." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.change.link.to lang.en.frame act=change mode=set set=acts.text priority=13 needs=textual lit.attribute="link" role=thing role=value pattern="L [link|hyperlink] D {thing:words} [to|with] {value:rest}" example="Link example to example dot com." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.ask.say lang.en.frame act=ask mode=text set=acts.text priority=12 needs=textual role=thing pattern="[what|which] [does|did|is] D {thing:words} [say|read|contain|have|mean]" example="What does the first paragraph say?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.place.top lang.en.frame act=place mode=order set=acts.text priority=16 needs=textual role=thing role=value pattern="L [move|send|shift|take|bring|push] D {thing:words} [to|at|up_to|down_to|towards]? D {value:VALUE}" example="Move the last list to the top." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.pick.goto lang.en.frame act=pick mode=goto set=acts.text priority=14 needs=textual role=thing pattern="L [go_to|jump_to|scroll_to|take_me_to|navigate_to|skip_to|head_to|get_to] D {thing:words}" example="Go to the second heading." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.change.def lang.en.frame act=change mode=name set=acts.text priority=11 needs=textual role=thing role=value pattern="L [make|set|change|rename|call|name|retitle|put]? [the|my|this|our] {thing:KIND} [to|as|be|is|called|named|says|:]? {value:rest}" example="Make the title Party Plans." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.make.kind lang.en.frame act=make mode=text set=acts.text priority=12 needs=textual role=thing pattern="L [V.make|write|put|create|start|begin|new|insert] [a|an|another|one_more|1_more|some]? [new]? {thing:KIND}" example="Insert a line."
@lang.en.frame.acts.text.undo.n lang.en.frame act=undo set=acts.text priority=14 needs=textual role=amount pattern="L [undo|take_back|revert|roll_back|scratch|go_back] D [last|previous]? {amount:number} [changes|things|steps|edits|actions|times|change|step|edit]?" example="Undo the last 2 changes."
@lang.en.frame.acts.text.undo.times lang.en.frame act=undo set=acts.text priority=14 needs=textual role=amount pattern="L [undo|take_back|revert|roll_back|scratch] [it|that|this]? {amount:number} times" example="Undo it 5 times."
@lang.en.frame.acts.text.undo.twice lang.en.frame act=undo set=acts.text priority=14 needs=textual lit.amount="2" pattern="L [undo|take_back|revert|roll_back|scratch] [it|that|this]? twice" example="Undo twice."
@lang.en.frame.acts.text.undo.last lang.en.frame act=undo set=acts.text priority=13 needs=textual pattern="L [undo|take_back|revert|roll_back|scratch|forget] D [last|previous|latest] [thing|change|edit|action|step|one] [i|we]? [added|did|made|changed|wrote|typed|said]?" example="Scratch the last thing I added."
@lang.en.frame.acts.text.change.thing.value lang.en.frame act=change mode=set set=acts.text priority=7 needs=textual role=thing role=value pattern="L D {thing:words} [in|as|to]? {value:VALUE} [please|pls|plz|now|thanks]?" example="Second paragraph bold please."
@lang.en.frame.acts.text.ask.selected lang.en.frame act=ask mode=selected set=acts.text priority=12 needs=textual pattern="[what|which] [is|are|have_i|did_i|am_i|was|do_i_have] [the|my|currently]? [selected|selecting|select|picked|chosen|selection] [so_far|now|currently|right_now|at_the_moment]?" example="What have I selected so far?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.make.begin lang.en.frame act=make mode=text set=acts.text priority=13 needs=textual role=thing role=value pattern="L [start|begin|open|open_with]  D [document|doc|page|text|notes|file] [with|using]  [a|an|the]? {thing:KIND} [called|named|titled|saying|that_says|about]? {value:rest}" example="Begin the page with a heading Welcome." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.make.blank.at lang.en.frame act=make mode=blank set=acts.text priority=13 needs=textual role=thing role=rel role=place pattern="L [start|begin|add|insert|create|make|put]? D [new|next|blank|empty|another|fresh]? {thing:KIND} REL D {place:words}" example="Insert a new line after the title." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.text.change.unmark lang.en.frame act=change mode=off set=acts.text priority=14 needs=textual role=value role=thing pattern="L [remove|take_off|clear|cancel|drop|get_rid_of|strip|undo|unset] D {value:VALUE} [from|on|off|of]? D {thing:words?}" example="Remove the bold from it."
@lang.en.frame.acts.text.change.unmark.not lang.en.frame act=change mode=off set=acts.text priority=13 needs=textual role=value role=thing pattern="L [not|un|no_longer|no_more|non] {value:VALUE} D {thing:words?}" example="Not bold."
@lang.en.frame.acts.text.change.align.dir lang.en.frame act=change mode=set set=acts.text priority=14 needs=textual lit.attribute="align" role=value role=thing pattern="L {value:VALUE} [align|aligned|alignment] D {thing:words}" example="Right align the heading."
@lang.en.frame.acts.text.change.level lang.en.frame act=change mode=set set=acts.text priority=14 needs=textual lit.attribute="level" role=thing role=value pattern="L V.set D {thing:words} [into|to|as] [a|an]? [heading|header|title] [level|number]? {value:number}" example="Turn it into heading 2."
# set=acts.facts are the forms of worlds whose things carry FACTS that are asked in a question of their own (flag facts): a place, an animal, a food.
@lang.en.frame.acts.facts.ask.what.does lang.en.frame act=ask mode=what set=acts.facts priority=12 needs=facts role=attribute role=thing pattern="L [what|which] {attribute:ATTR} [does|do] D {thing:words} [use|have|speak|got|own|call_its|spend]?" example="What currency does Japan use?" core.source="psys2 worlds/geo.map 2026-11-14"
@lang.en.frame.acts.facts.ask.what.spoken lang.en.frame act=ask mode=what set=acts.facts priority=12 needs=facts role=attribute role=thing pattern="L [what|which] {attribute:ATTR} [is|are] [spoken|used|found|official|written] in D {thing:words}" example="What languages are spoken in Switzerland?" core.source="psys2 worlds/geo.map 2026-11-14"
@lang.en.frame.acts.facts.ask.what.in lang.en.frame act=ask mode=what set=acts.facts priority=12 needs=facts role=attribute role=thing pattern="L [what|which] {attribute:ATTR} [is|are] D {thing:words} [in|part_of|from|on]" example="What continent is Egypt in?" core.source="psys2 worlds/geo.map 2026-11-14"
@lang.en.frame.acts.facts.ask.how lang.en.frame act=ask mode=what set=acts.facts priority=12 needs=facts role=attribute role=thing pattern="L how {attribute:ATTR} [is|are] D {thing:words}" example="How big is Romania?" core.source="psys2 worlds/geo.map 2026-11-14"
@lang.en.frame.acts.facts.ask.is lang.en.frame act=ask mode=what set=acts.facts priority=11 needs=facts role=thing role=attribute pattern="L [is|are] D {thing:words} {attribute:ATTR}" example="Is Hungary landlocked?" core.source="psys2 worlds/geo.map 2026-11-14"
@lang.en.frame.acts.facts.ask.have lang.en.frame act=ask mode=what set=acts.facts priority=11 needs=facts role=thing role=attribute pattern="L [does|do] D {thing:words} have D {attribute:ATTR}" example="Does Spain have a coast?" core.source="psys2 worlds/geo.map 2026-11-14"
@lang.en.frame.acts.facts.ask.whose lang.en.frame act=ask mode=what set=acts.facts priority=11 needs=facts role=thing role=attribute pattern="L [what|which] [is|are] {thing:words} {attribute:ATTR}" example="What is Peru's capital?" core.source="psys2 worlds/geo.map 2026-11-14"

# set=acts.media are the forms of a world whose things are PLAYED (flag playable): music, a sound, a clip. Playing and stopping are a mode of `pick` (the thing becomes the one that runs), looping is a switch of the attribute `loop`,
# moving the pitch is a `change` of the attribute `pitch` with a mode `shift`, composing a melody is `make` of a kind with the notes as its value. The notes themselves are the world's own text (note names, chords, scales).
@lang.en.frame.acts.media.m.pick.play lang.en.frame act=pick mode=play set=acts.media priority=12 needs=playable role=thing pattern="L [play|hear|listen_to|put_on|spin|fire_up|queue|queue_up|give_me|sing|hum|strum|blast|crank|let_me_hear|let_us_hear|i_want_to_hear|i_wanna_hear|i_d_like_to_hear|id_like_to_hear|can_i_hear|could_i_hear|i_want_you_to_play|i_wanna_listen_to|i_want_to_listen_to|play_me|how_about|what_about|tap|hit|try_playing|start_playing|play_back|perform|run_through|go_through|run_up|go_up|arpeggiate|spread|spread_out|ding|ring|ping|tinkle|pluck|bang|press|sound|let_me_hear_the|i_want_to_hear_the|hear_the] D {thing:words}" example="Play Ode to Joy." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.pick.play.sound lang.en.frame act=pick mode=play set=acts.media priority=12 needs=playable role=thing pattern="L [how|what] [does|do|would|will|did] D {thing:words} [sound|sounds|sound_like]" example="How does middle C sound?" core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.pick.play.bare lang.en.frame act=pick mode=play set=acts.media priority=8 needs=playable pattern="L [play_something|play_some_music|play_music|put_some_music_on|put_on_some_music|play_a_song|music|surprise_me|i_want_to_hear_some_music|i_want_some_music|i_wanna_hear_some_music|i_want_to_hear_something|play_me_something|play_me_a_song] [please|pls|plz|now|for_me]?" example="Play." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.pick.stop lang.en.frame act=pick mode=stop set=acts.media priority=13 needs=playable pattern="L [i_want_it_to|make_it|just|please|i_want_you_to|i_wish_it_would|can_you|you_can]? [stop|pause|halt|quit|silence|shut_up|be_quiet|enough|hush|end|cut|kill|mute] [the|that|this|my|your|all_the|all]? [music|song|playing|playback|playing_music|noise|sound|sounds|melody|tune|it|that|this|everything|now|already|please]? [now|please|already|pls]?" example="Stop the music." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.pick.again lang.en.frame act=pick mode=again set=acts.media priority=13 needs=playable pattern="L [again|replay|play_again|play_it_again|play_that_again|once_more|one_more_time|one_more_go|go_again|one_more|encore|repeat_that|repeat_it|do_it_again|run_it_again|say_it_again|another_go|another_time|one_more_round|the_same_again|the_same_one|same_again] [please|pls|plz|now]?" example="Play it again." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.change.loop.on lang.en.frame act=change mode=set set=acts.media priority=13 needs=playable lit.attribute="loop" lit.value="on" pattern="L [loop|keep_looping|keep_on_looping|repeat|keep_repeating|put_on_repeat|play_on_repeat|play_it_on_repeat|put_it_on_repeat|play_it_in_a_loop|put_it_in_a_loop|put_it_on_a_loop|turn_on_the_loop|turn_the_loop_on|turn_looping_on|switch_on_the_loop|set_it_to_loop|make_it_loop|make_it_repeat|have_it_loop|have_it_repeat] [it|that|this|the_song|the_music|the_melody|the_tune|the_chord|the_scale|them|forever|always|on|please|pls]? [forever|continuously|over_and_over|non_stop|nonstop|always|please|pls]?" example="Loop it." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.change.loop.off lang.en.frame act=change mode=set set=acts.media priority=14 needs=playable lit.attribute="loop" lit.value="off" pattern="L [dont|do_not|stop|quit|cancel|no_more|no|turn_off|disable|switch_off|end|cut_out|drop] [the]? [loop|looping|repeating|repeat|loops|repeats] [it|that|this|the_song|the_music|please|pls|anymore|any_more|off]? [anymore|any_more|please|pls|off]?" example="Stop looping." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.change.shift lang.en.frame act=change mode=shift set=acts.media priority=13 needs=playable lit.attribute="pitch" role=value pattern="L [transpose|shift|raise|lower|bump|pitch|move] [it|that|this|the_song|the_melody|the_music|the_tune|the_whole_thing|everything|the_whole_song|the_whole_tune]? {value:rest}" example="Transpose it up a fifth." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.make.melody lang.en.frame act=make mode=compose set=acts.media priority=14 needs=playable role=thing role=value pattern="L [write|compose|create|make|start|enter|record|type|come_up_with|put_down|jot_down|make_up|invent|new] D [new|another]? {thing:KIND} [:|is|with|of|like|using|from|-|as|that_goes|goes|made_of|called|named]? {value:rest}" example="Write a melody C D E F G." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.make.melody.colon lang.en.frame act=make mode=compose set=acts.media priority=14 needs=playable role=thing role=value pattern="{thing:KIND} [:|-]? {value:rest}" example="Melody A A B A." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.make.add lang.en.frame act=make mode=add set=acts.media priority=12 needs=playable role=value pattern="L [add|append|put|stick|tack_on|tack|insert|then|next|and_then|more_notes|more|also|after_that|keep_going_with|go_on_with|carry_on_with|continue_with|follow_with|extend_it_with|extend_my_melody_with|also_add|also_append] [the|these|more|some|another]? [notes|note]? [:]? {value:rest}" example="Add G G A G." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.make.blank lang.en.frame act=make mode=blank set=acts.media priority=14 needs=playable role=thing pattern="L [start|begin|make|create|open|give_me|i_want|let_s_start|lets_start|i_need]? D [new|fresh|blank|empty|another|next] {thing:KIND} [please|pls|plz|now]?" example="Start a new melody." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.pick.play.kind lang.en.frame act=pick mode=play set=acts.media priority=7 needs=playable role=thing role=kind role=value pattern="L D {thing:words} {kind:KIND} {value:rest?}" example="A C major chord please." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.pick.play.kind.of lang.en.frame act=pick mode=play set=acts.media priority=7 needs=playable role=kind role=thing pattern="L D {kind:KIND} [of|in|for|on|from] {thing:words}" example="Scale of F major please." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.pick.play.kind.bare lang.en.frame act=pick mode=play set=acts.media priority=6 needs=playable role=kind pattern="L D {kind:KIND} [please|pls|plz|now|for_me]?" example="Scale please." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.pick.play.note lang.en.frame act=pick mode=play set=acts.media priority=20 needs=playable role=thing pattern="L [just]? [note|the_note|just_the_note|just_note] {thing:words}" example="Note E." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.make.melody.as lang.en.frame act=make mode=compose set=acts.media priority=14 needs=playable role=value role=thing pattern="L {value:words} [as|for|to_be|is|are|will_be|for_the|as_the] [my|the|a|your]? {thing:KIND}" example="C D E F G as my melody." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.make.melody.here lang.en.frame act=make mode=compose set=acts.media priority=14 needs=playable role=thing role=value pattern="L [here_is|here_s|heres|this_is|that_is|thats|it_is|its] [my|the|a|your]? [new]? {thing:KIND} [:|-]? {value:rest}" example="Here is my tune E E E." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.make.blank.over lang.en.frame act=make mode=blank set=acts.media priority=14 needs=playable role=thing pattern="L [start|begin|clear|reset|redo|restart|do] D {thing:KIND} [over|again|from_scratch|afresh|from_the_start|all_over]" example="Start the melody over." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.remove.last lang.en.frame act=remove mode=last set=acts.media priority=15 needs=playable lit.thing="last note" pattern="L [undo|take_back|revert|scratch|erase|delete|remove|drop|cut|pop|backspace|rewind|take_off|get_rid_of|take] D [last|final|previous|latest|that|the_last]? [note|notes] [away|off|out]?" example="Remove the last note." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.ask.which lang.en.frame act=ask mode=what set=acts.media priority=12 needs=playable role=attribute pattern="L [which|what|whats|what_s] {attribute:ATTR} [is|are|do_you_use|are_you_using|am_i_using|is_being_used|is_playing|is_selected|is_on|is_set|is_it_set_to|is_in_use|is_used] [it|this|that|playing|now|right_now|set|selected|used|on|currently]?" example="Which sound is it?" core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.change.want lang.en.frame act=change mode=set set=acts.media priority=12 needs=playable role=attribute role=value pattern="L [i_want|i_would_like|i_d_like|id_like|i_need|let_s_have|lets_have|can_we_have|can_i_have|can_you_make|could_you_make|make|have] D {attribute:ATTR} [to_be|to_become|be|is|should_be|to_equal|equal_to|at|to] [a|an]? {value:rest}" example="I want the key to be D major." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.change.bare.more lang.en.frame act=change mode=more set=acts.media priority=11 needs=playable role=amount role=value pattern="L D {amount:lex.space.amounts?} {value:MORE} [please|pls|plz|thx|thanks|now]?" example="A bit faster." core.source="psys2 worlds/media.music 2026-11-14"
@lang.en.frame.acts.media.m.change.bare.less lang.en.frame act=change mode=less set=acts.media priority=11 needs=playable role=amount role=value pattern="L D {amount:lex.space.amounts?} {value:LESS} [please|pls|plz|thx|thanks|now]?" example="A bit slower." core.source="psys2 worlds/media.music 2026-11-14"
