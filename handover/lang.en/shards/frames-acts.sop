@lang.en.frame.acts.more.change.turn lang.en.frame act=change mode=turn set=acts.more priority=15 needs=turn role=thing role=value role=amount pattern="L [turn|flip|rotate|spin|mirror|swivel|reverse|swing] D {thing:words} {value:TURN?} {amount:number?} [degrees|degree]?" example="Turn the house around." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.turn.make lang.en.frame act=change mode=turn set=acts.more priority=14 needs=turn role=thing role=value pattern="L [make|let|have|get] D {thing:words} [look|face|turn|go|point]? {value:TURN}" example="Make the house look the other way." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.turn.state lang.en.frame act=change mode=turn set=acts.more priority=5 needs=turn role=thing role=value pattern="L D {thing:words} [turns|turn|goes|go|looks|look|faces|face|should_go|should_look|should_face|should_turn|needs_to_turn|needs_to_look|should_be_turned|to_look|to_face]? {value:TURN}" example="The house should look the other way." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.turn.wish lang.en.frame act=change mode=turn set=acts.more priority=12 needs=turn role=thing role=value pattern="L [$lang.shape.want] D {thing:words} [turned|flipped|rotated|mirrored|reversed|to_turn|to_face|to_look]? {value:TURN}" example="I want the house turned around." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.all lang.en.frame act=remove mode=all set=acts.more priority=12 needs=clear lit.thing="everything" pattern="L [clear|wipe|erase|delete|remove|empty|scrap|clean|get_rid_of|throw_away] [everything|all|it_all|all_of_it|all_off|all_of_this] [off|away|out|ok|okay|please|pls]?" example="Clear everything." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.all.noun lang.en.frame act=remove mode=all set=acts.more priority=12 needs=clear lit.thing="everything" pattern="L [clear|wipe|erase|delete|remove|empty|scrap|clean|get_rid_of|throw_away] [the|my|this|our]? [whole|entire|all_of_the]? NOUN [off|away|out|ok|okay|please|pls]?" example="Clear the picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.new lang.en.frame act=remove mode=new set=acts.more priority=12 needs=clear lit.thing="everything" pattern="L [start|begin|open|get|give_me|make|let_s_start|lets_start|i_want|i_need|show_me]? [a|an|another]? [new|fresh|blank|clean|empty] NOUN? [sheet|sheet_of_paper|of_paper|page|canvas|start]? [of_paper]? [please|pls]?" example="Start a new picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.random lang.en.frame act=make mode=random set=acts.more priority=11 needs=random pattern="L [surprise_me|surprise_us|surprise] [with_a_picture|with_a_drawing|with_something]? [for_me|pls|please|thx]?" example="Surprise me." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.random.picture lang.en.frame act=make mode=random set=acts.more priority=11 needs=random pattern="L [i_want_you_to]? [draw|make|paint|sketch|create|doodle|give_me|show_me|i_want|whip_up] [me|us]? [a|an|the|some]? [random|nice|pretty|beautiful|lovely|new|cool|happy|sunny|surprise|surprising]? [picture|scene|landscape|drawing|painting|masterpiece|surprise] [for_me|pls|please|thx]?" example="Draw me a nice picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.random.any lang.en.frame act=make mode=random set=acts.more priority=11 needs=random pattern="L [i_want_you_to]? [draw|make|paint|sketch|create|doodle|give_me|show_me|whip_up] [me|us]? [something|anything|whatever|something_nice|something_random|something_pretty|anything_nice] [you_like|you_want|you_feel_like]? [for_me|pls|please|thx]?" example="Draw something." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.pick.none lang.en.frame act=pick mode=none set=acts.more priority=12 needs=none pattern="L [deselect|unselect|unpick|unmark|unhighlight|untick|unselected] [everything|all|it|that|this|them|the_selection|the_highlight|the_highlights]? [please|pls|plz]?" example="Deselect everything." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.pick.none.state lang.en.frame act=pick mode=none set=acts.more priority=12 needs=none pattern="L [nothing|no_thing|none] [selected|highlighted|picked|marked] [please|pls|plz|now]?" example="Nothing selected please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.pick.none.clear lang.en.frame act=pick mode=none set=acts.more priority=12 needs=none pattern="L [clear|remove|drop|forget|cancel|stop] D [the|my|this]? [selection|highlight|highlights|highlighting]" example="Clear the selection." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.pick.click lang.en.frame act=pick mode=pick set=acts.more priority=11 needs=none role=thing pattern="L [click|tap|touch|press|click_on|tap_on|touch_on] D {thing:words}" example="Click the second tree." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.save.noun lang.en.frame act=save set=acts.more priority=11 needs=none role=value pattern="L V.save D NOUN [as|in|to|under|called]? D {value:words}" example="Save my picture as SVG." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.save.download lang.en.frame act=save set=acts.more priority=11 needs=none role=value pattern="L [download|export|get] D NOUN [as|in|to|under|called|a]? D {value:words}" example="Download the drawing as a PNG." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.undo.verb lang.en.frame act=undo set=acts.more priority=11 needs=none pattern="L V.undo [that|it|this|the_last|my_last|the|one]? [thing|change|step|action|move|one|drawing]? [back]? [please|pls|plz]?" example="Undo that change." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.part.needs lang.en.frame act=make set=acts.more priority=10 needs=wish role=place role=thing lit.rel="to" pattern="L D {place:words} [needs|should_have|must_have|has_to_have|needs_to_have|ought_to_have] D {thing:rest}" example="The house needs a pink door." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.would lang.en.frame act=make set=acts.more priority=10 needs=ground role=thing pattern="D [bit_of|little|some|lots_of|a_lot_of|more]? {thing:words} [would_be_nice|would_be_nicer|would_be_good|would_look_nice|would_be_cool|would_be_great]" example="A bit of snow would be nice." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.value.size lang.en.frame act=change mode=set set=acts.more priority=14 needs=scale role=thing role=value pattern="L [make|turn|get|let|change|blow_up|scale_up|scale|resize] D {thing:words} [to_be|to|up_to|into|be|as]? [a|an]? {value:VALUE} [size|sized|sized_one|one|in_size]" example="Turn the house into a tiny one." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.value.size.up lang.en.frame act=change mode=set set=acts.more priority=14 needs=scale role=thing role=value pattern="L [blow|scale|build|make|puff|pump|grow] D {thing:words} up [to|into]? [a|an]? {value:VALUE} [size|sized|in_size]?" example="Blow the cat up to huge size." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.should.size lang.en.frame act=change mode=set set=acts.more priority=14 needs=scale role=thing role=value pattern="D {thing:words} [needs_to_be|should_be|must_be|has_to_be|ought_to_be] {value:VALUE} [size|sized|in_size]" example="The house should be medium size." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.with lang.en.frame act=change mode=set set=acts.more priority=15 needs=scale role=thing role=value pattern="L [fill|fill_in|colour|color|paint|cover|colour_in|color_in|dye|tint] D {thing:words} [with|in|using] D {value:VALUE}" example="Fill the sun with yellow." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.in lang.en.frame act=change mode=set set=acts.more priority=6 needs=scale role=thing role=value pattern="L D {thing:words} in {value:VALUE} [please|pls|plz|thx|thanks]?" example="House in teal please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.fill.in lang.en.frame act=change mode=set set=acts.more priority=13 needs=scale role=thing lit.value="crayon" pattern="L [fill_in|colour_in|color_in|fill] D {thing:words} [in|in_please]?" example="Fill in the star." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.near lang.en.frame act=ask mode=what set=acts.more priority=13 needs=say role=place lit.rel="near" pattern="L [what|whats|what_s|anything|is_anything|is_there_anything|what_is|what_things_are|which_things_are] [right|just]? [near|nearby|close_to|around] D {place:words}" example="Whats near the sun?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.beside lang.en.frame act=ask mode=what set=acts.more priority=13 needs=say role=place lit.rel="next to" pattern="L [what|whats|what_s|anything|is_anything|is_there_anything|what_is|what_things_are|which_things_are] [right|just]? [next_to|beside|by|alongside|right_by] D {place:words}" example="Anything next to the cloud?" core.source="psys2 worlds/acts 2026-11-14"
