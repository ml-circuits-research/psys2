@lang.en.frame.acts.more.ask.colour.painted lang.en.frame act=ask mode=what set=acts.more priority=12 needs=say role=thing lit.attribute="colour" pattern="L [what|whats|what_s|what_is|what_colour_is|what_color_is|which_colour_is|which_color_is] D {thing:words} [painted|coloured|colored|drawn|made]" example="Whats the house painted?" core.source="psys2 worlds/acts 2026-11-14"
