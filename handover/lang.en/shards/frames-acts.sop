@lang.en.frame.acts.more.ask.where.tail lang.en.frame act=ask mode=where set=acts.more priority=8 needs=say role=thing pattern="L D {thing:words} where [exactly|is_it|are_they|now]?" example="House where?" core.source="psys2 worlds/acts 2026-11-14"
