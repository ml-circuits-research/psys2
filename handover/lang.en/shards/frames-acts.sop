# w.lang.en/shards/frames-acts: the argument frames of English, one per way of saying an act (extracted from worlds/acts/acts.mjs FORMS and forms.more.mjs FORMS_MORE, 2026-11-14).
# Notation of `pattern` (PSys2 form notation, to be read by std.grammar as a flat rule over word classes):
#   L lead-in (phrase lang.lead.polite)   D determiner (view det.acts-forms)   V.<act> the verbs of the act (k.actions)   REL a preposition that is a relation (prepositions.sop)
#   [a|b] one of; [a|b]? optional; a_b a fixed multi-word chunk; {role:class} a capture of a role (words = a noun phrase, rest = the remainder, number = a number word or digits,
#   ATTR VALUE KIND MORE LESS TURN NOUN = a word of the world's lexicon of that name; lex.<id> = a named lexicon).
# `needs` is the condition the world's schema must meet (a world with no attributes has no "make it blue"). `mode` is the act's mode, `lit` a fixed argument.
# sources: PSys2 worlds/acts (hand-written, schema-world forms)
# license: CC0-1.0

@lang.en.frame.acts.make lang.en.frame act=make set=acts priority=10 role=thing pattern="L V.make D {thing:words}" example="Add a table." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.place lang.en.frame act=make set=acts priority=12 needs=in role=thing role=rel role=place pattern="L V.make D {thing:words} REL D {place:words}" example="Add a guest at table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.n lang.en.frame act=make set=acts priority=12 role=amount role=thing pattern="L V.make {amount:number} {thing:words}" example="Add 3 tables." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.name lang.en.frame act=make set=acts priority=13 needs=named role=thing role=value pattern="L V.make D {thing:words} [called|named] {value:words}" example="Add a guest called Ann." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.name.p lang.en.frame act=make set=acts priority=14 needs=named role=thing role=value pattern="L V.place D {thing:words} [called|named] {value:rest}" example="Place a guest named Ann." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.name.place lang.en.frame act=make set=acts priority=14 needs=in role=thing role=value role=rel role=place pattern="L V.make D {thing:words} [called|named] {value:words} REL D {place:words}" example="Add a guest called Ann at table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove lang.en.frame act=remove set=acts priority=10 role=thing pattern="L V.remove D {thing:words}" example="Remove the guest Ann." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.out lang.en.frame act=remove set=acts priority=11 role=thing pattern="L [kick|throw|take|send|get|put] D {thing:words} [out|away|off_the_list]" example="Kick the guest Ann out." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.place lang.en.frame act=remove set=acts priority=12 needs=in role=thing role=place pattern="L V.remove D {thing:words} [from|out_of|off] D {place:words}" example="Remove the guests from table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.of lang.en.frame act=change mode=set set=acts priority=14 needs=attrs role=attribute role=thing role=value pattern="L V.set D {attribute:ATTR} of D {thing:words} [to|be|as|into]? D {value:words}" example="Change the colour of table 2 to red." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.attr lang.en.frame act=change mode=set set=acts priority=13 needs=attrs role=thing role=attribute role=value pattern="L V.set D {thing:words} {attribute:ATTR} [to|be|as|into] D {value:words}" example="Set table 2 seats to 6." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.value lang.en.frame act=change mode=set set=acts priority=12 needs=values role=thing role=value pattern="L V.set D {thing:words} [to|be|as|into]? {value:VALUE}" example="Make table 2 blue." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.add lang.en.frame act=change mode=more set=acts priority=14 needs=number role=amount role=attribute role=thing pattern="L V.make {amount:number} {attribute:ATTR} to D {thing:words}" example="Add 2 seats to table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.add1 lang.en.frame act=change mode=more set=acts priority=13 needs=number role=attribute role=thing pattern="L V.make {attribute:ATTR} to D {thing:words}" example="Add a seat to table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.less lang.en.frame act=change mode=less set=acts priority=14 needs=number role=amount role=attribute role=thing pattern="L V.remove {amount:number} {attribute:ATTR} from D {thing:words}" example="Remove 2 seats from table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.less1 lang.en.frame act=change mode=less set=acts priority=13 needs=number role=attribute role=thing pattern="L V.remove D {attribute:ATTR} from D {thing:words}" example="Remove a seat from table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.cmp.more lang.en.frame act=change mode=more set=acts priority=12 needs=more role=thing role=value pattern="L V.set D {thing:words} {value:MORE}" example="Make table 1 bigger." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.cmp.less lang.en.frame act=change mode=less set=acts priority=12 needs=less role=thing role=value pattern="L V.set D {thing:words} {value:LESS}" example="Make table 1 smaller." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place lang.en.frame act=place set=acts priority=11 needs=in role=thing role=rel role=place pattern="L V.place D {thing:words} REL D {place:words}" example="Put the guest Ann at table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.connect lang.en.frame act=connect set=acts priority=11 role=thing role=place pattern="L V.connect D {thing:words} [to|with|and] D {place:words}" example="Connect table 1 to table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.group lang.en.frame act=group mode=group set=acts priority=10 role=thing pattern="L V.group D {thing:words} [together]?" example="Group the tables." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.apart lang.en.frame act=group mode=apart set=acts priority=10 role=thing pattern="L V.apart D {thing:words}" example="Take the tables apart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.apart.2 lang.en.frame act=group mode=apart set=acts priority=11 role=thing pattern="L [take|break|pull|split] D {thing:words} [apart|up]" example="Take the tables apart." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.bare lang.en.frame act=place set=acts priority=5 needs=in role=thing pattern="L V.place D {thing:words}" example="Move the guest." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.bare lang.en.frame act=change mode=set set=acts priority=5 needs=attrs role=thing pattern="L [change|colour|color|paint|turn|switch|edit] D {thing:words}" example="Change table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.connect.bare lang.en.frame act=connect set=acts priority=5 role=thing pattern="L V.connect D {thing:words}" example="Connect table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.send.bare lang.en.frame act=send set=acts priority=5 role=thing pattern="L V.send D {thing:words}" example="Send table 1." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.pick lang.en.frame act=pick set=acts priority=10 role=thing pattern="L V.pick D {thing:words}" example="Select table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.copy lang.en.frame act=copy set=acts priority=10 role=thing pattern="L V.copy D {thing:words}" example="Copy table 2." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.send lang.en.frame act=send set=acts priority=11 role=thing role=place pattern="L V.send D {thing:words} to D {place:words}" example="Send table 2 to the diagram." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.what lang.en.frame act=ask mode=what set=acts priority=12 needs=attrs role=attribute role=thing pattern="[what|which] [is|are] D {attribute:ATTR} of D {thing:words}" example="What is the colour of table 2?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.what.is lang.en.frame act=ask mode=what set=acts priority=12 needs=attrs role=attribute role=thing pattern="[what|which] {attribute:ATTR} [is|are] D {thing:words}" example="What colour is table 2?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.should lang.en.frame act=change mode=set set=acts priority=12 needs=values role=thing role=value pattern="D {thing:words} [should|must|has_to|needs_to] [be|become|turn] {value:VALUE}" example="Table 2 should be blue." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.needs lang.en.frame act=change mode=set set=acts priority=12 needs=number role=thing role=value role=attribute pattern="L [i_want|i_need|make|let|give]? D {thing:words} [needs|to_have|should_have|must_have|has|gets] {value:number} {attribute:ATTR}" example="Table 1 needs 6 seats." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.at lang.en.frame act=ask mode=what set=acts priority=12 needs=in role=rel role=place pattern="[what|who] [is|are|sits|sit|stands|stand] [there]? REL D {place:words}" example="Who is at table 1?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.count.attr lang.en.frame act=ask mode=what set=acts priority=14 needs=number role=attribute role=thing pattern="how_many {attribute:ATTR} [does|do|has|have] D {thing:words} [have|has|got]?" example="How many seats does table 1 have?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.count lang.en.frame act=ask mode=count set=acts priority=12 role=thing pattern="how_many {thing:words} [are|do_i_have|have_i_got|is]? [there]?" example="How many tables are there?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.count.at lang.en.frame act=ask mode=count set=acts priority=13 needs=in role=thing role=rel role=place pattern="how_many {thing:words} [are|is]? [there]? REL D {place:words}" example="How many guests are at table 1?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.where lang.en.frame act=ask mode=where set=acts priority=12 needs=in role=thing pattern="where [is|are] D {thing:words}" example="Where is Ann?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.why lang.en.frame act=ask mode=why set=acts priority=11 role=rest pattern="why [is|are|did|do|was|were|does] {rest:words}" example="Why is table 2 blue?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.about lang.en.frame act=ask mode=describe set=acts priority=6 needs=thingask role=thing pattern="L [describe|tell_me_about|explain] D {thing:rest}" example="Describe the circle." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.exists lang.en.frame act=ask mode=exists set=acts priority=11 needs=thingask role=thing pattern="[is|are] there [any|a|an|some]? {thing:rest}" example="Is there a circle?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.last lang.en.frame act=ask mode=last set=acts priority=11 pattern="what [did|have] you [just]? [do|done|change|changed]" example="What did you just do?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.undo lang.en.frame act=undo set=acts priority=16 pattern="[$lang.undo]" example="Undo that." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.redo lang.en.frame act=redo set=acts priority=16 pattern="[$lang.redo]" example="Redo that." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.save lang.en.frame act=save set=acts priority=10 role=value pattern="L V.save [it|this|everything]? [as|under|called]? {value:words}" example="Save it as lunch." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.load lang.en.frame act=load set=acts priority=10 role=value pattern="L V.load D {value:words}" example="Load lunch." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.self lang.en.frame act=make set=acts priority=11 needs=self role=thing pattern="L V.make [yourself|myself|urself] D {thing:words}" example="Give yourself a beard." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.put lang.en.frame act=make set=acts priority=9 needs=self role=thing pattern="L [put|place|stick|draw|give] [him|her|it|the_avatar|me|yourself|myself]? D {thing:words}" example="Give him a beard." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.on lang.en.frame act=make set=acts priority=12 needs=self role=thing pattern="L [put|place|add|stick|draw] D {thing:words} [on_yourself|on_your_face|on_your_head|to_yourself|to_your_face|on_you|on_ur_face]" example="Add glasses to your face." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.off lang.en.frame act=remove set=acts priority=12 needs=self role=thing pattern="L [take|put|get|pull] D {thing:words} [off|away|off_yourself|off_your_face|off_your_head]" example="Take the glasses off." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.without lang.en.frame act=remove set=acts priority=11 needs=self role=thing pattern="L [make|be|look|draw|show_me]? [yourself|me|it|the_face]? [without|with_no] D {thing:words}" example="Without a hat." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.another lang.en.frame act=change mode=other set=acts priority=12 needs=self role=thing pattern="L [try|show|give_me|let_me_see|i_want|have|use|put_on|wear]? [another|a_different|a_new|another_one] {thing:words}" example="Try a different hat." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.next lang.en.frame act=change mode=next set=acts priority=12 needs=self role=thing pattern="L [try|show|give_me|let_me_see|use|go_to|switch_to|change_to]? D [next|following|one_more] {thing:words}" example="Try the next hat." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.prev lang.en.frame act=change mode=prev set=acts priority=12 needs=self role=thing pattern="L [try|show|give_me|let_me_see|use|go_to|switch_to|change_to|go_back_to]? D [previous|prior|one_before] {thing:words}" example="Previous nose." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.swap lang.en.frame act=change mode=set set=acts priority=11 needs=be role=thing role=value pattern="L [swap|change|switch|replace|exchange] D {thing:words} [for|with|to|into|by] D {value:words}" example="Change the hat to a crown." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.self lang.en.frame act=change mode=set set=acts priority=12 needs=self role=value pattern="L [make|turn|change|paint] [yourself|urself|the_avatar|the_face|your_face|ur_face] {value:words}" example="Paint yourself green." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.be lang.en.frame act=change mode=be set=acts priority=10 needs=be role=value pattern="L [be|become|look|feel|turn_into|change_into|transform_into|morph_into|look_like|act_like] D {value:words}" example="Look happy." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.be.self lang.en.frame act=change mode=be set=acts priority=11 needs=be role=value pattern="L [make|let|get] [yourself|urself|myself|the_avatar|the_robot|the_face] [look|feel|be|become]? {value:words}" example="Make yourself happy." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.should.self lang.en.frame act=change mode=be set=acts priority=11 needs=be role=value pattern="D [avatar|robot|face] [should|must|has_to|needs_to|shall] [be|become|look|feel] D {value:words}" example="The avatar should be a clown." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.dir lang.en.frame act=place set=acts priority=13 needs=dir role=thing role=rel pattern="L [move|put|bring|push|pull|take|shift|raise|lower|make] D {thing:words} {rel:lex.acts.dir}" example="Move the eyes closer together." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.dir.bare lang.en.frame act=place set=acts priority=6 needs=dir role=thing role=rel pattern="D {thing:words} {rel:lex.acts.dir}" example="Eyes closer together." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.has lang.en.frame act=ask mode=has set=acts priority=12 needs=has role=thing pattern="[do|did|can|could] [you|u] [have|got|wear|see|has] D {thing:words}" example="Do you have glasses?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.has.2 lang.en.frame act=ask mode=has set=acts priority=12 needs=has role=thing pattern="[have|are] [you|u] [got|wearing|having] D {thing:words}" example="Are you wearing a hat?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.options lang.en.frame act=ask mode=options set=acts priority=12 needs=self role=thing pattern="[what|which] {thing:words} [are_there|can_you_have|can_you_wear|can_i_pick|can_i_choose|can_you_draw|can_you_put_on|can_i_try|can_you_show]" example="What hats are there?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.options.all lang.en.frame act=ask mode=options set=acts priority=12 needs=self pattern="[what|which] [can|could] [i|you|u] [change|customize|customise|modify|adjust|tweak|wear|put_on] [about_you|about_yourself|on_you]?" example="What can I change?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.state lang.en.frame act=ask mode=state set=acts priority=12 needs=be pattern="[how_do_you_feel|how_are_you_feeling|what_is_your_mood|what_is_your_expression|what_mood_are_you_in|how_are_you_looking|how_do_you_look_now]" example="What is your expression?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.describe lang.en.frame act=ask mode=describe set=acts priority=12 needs=self pattern="L [describe_yourself|describe_you|what_do_you_look_like|what_do_you_look_like_now|what_are_you_wearing|what_do_you_have_on|how_do_you_look|tell_me_what_you_look_like|describe_your_face|describe_your_look|describe_your_avatar|what_do_you_look_like_today]" example="What are you wearing?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.make.random lang.en.frame act=make mode=random set=acts priority=11 needs=self pattern="L [surprise|surprise_me|shuffle_yourself|randomise_yourself|randomize_yourself|make_a_random_face|a_random_face|something_random]" example="Surprise me." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.remove.reset lang.en.frame act=remove mode=all set=acts priority=11 needs=self pattern="L [reset|reset_yourself|start_over|start_again|clear_your_face|go_back_to_normal|go_default]" example="Reset." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.call lang.en.frame act=change mode=set set=acts priority=12 needs=name role=value lit.attribute="name" pattern="L [call|name|rename] [yourself|urself|the_avatar] [to|as]? {value:rest}" example="Call yourself Robi." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.call.2 lang.en.frame act=change mode=set set=acts priority=12 needs=name role=value lit.attribute="name" pattern="L [i_will_call_you|i_am_calling_you|i_call_you|we_will_call_you|from_now_on_i_will_call_you|call_you] {value:rest}" example="I will call you Robi." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.name.is lang.en.frame act=change mode=set set=acts priority=12 needs=name role=value lit.attribute="name" pattern="L [from_now_on]? [your|ur] name [is|will_be|shall_be] {value:rest}" example="Your name is Robi." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.change.name.called lang.en.frame act=change mode=set set=acts priority=12 needs=name role=value lit.attribute="name" pattern="L [from_now_on]? [you|u] [are|r] [called|named] {value:rest}" example="You are called Ziggy." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.ask.name lang.en.frame act=ask mode=what set=acts priority=12 needs=name lit.attribute="name" lit.thing="yourself" pattern="L [what_is_your_name|what_are_you_called|what_do_i_call_you|what_is_ur_name|tell_me_your_name]" example="What is your name?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.rel lang.en.frame act=place set=acts priority=12 needs=rel role=thing role=rel role=place pattern="L V.place D {thing:words} REL D {place:rest}" example="Put the circle next to the square." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.layout lang.en.frame act=place mode=layout set=acts priority=13 needs=layout role=thing role=rel pattern="L [V.place|arrange|lay_out|space_out|distribute|tidy|organise|organize] D {thing:words} [out|up]? [in|into|as|on|along|across]? D {rel:lex.acts.layout}" example="Line up the circles horizontally." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.place.layout.all lang.en.frame act=place mode=layout set=acts priority=8 needs=layout role=thing pattern="L [arrange|lay_out|tidy|organise|organize|space_out|distribute|align] D {thing:words} [out|up]?" example="Tidy up the circles." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.own lang.en.frame act=own set=acts priority=1 needs=reader role=rest pattern="{rest:rest}" example="Which shape is the largest?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.frame lang.en.frame act=own set=acts priority=30 needs=reader role=pre role=post pattern="{pre:words} diagram {post:rest}" example="Make a diagram shaped like a house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.frame.end lang.en.frame act=own set=acts priority=30 needs=reader role=pre pattern="{pre:words} diagram" example="Add a star to the diagram." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.frame.shaped lang.en.frame act=own set=acts priority=30 needs=reader role=pre role=post pattern="{pre:words} [chart|layout|graph|box|boxes] [shaped|laid_out|arranged] [like|as] {post:rest}" example="Add a box shaped like a guitar." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.read.frame.form lang.en.frame act=own set=acts priority=30 needs=reader role=pre role=post pattern="{pre:words} [a|an] [shape|box] in_the [shape|form] of {post:rest}" example="Draw a shape in the form of a house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.bare.mod lang.en.frame act=make mode=bare set=acts priority=3 needs=bare role=pre role=thing pattern="L D {pre:words} {thing:KIND} [at_me|a_little|twice]?" example="Round glasses." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.bare lang.en.frame act=make mode=bare set=acts priority=3 needs=bare role=thing pattern="L D {thing:KIND} [at_me|a_little|twice]?" example="Glasses." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.wish lang.en.frame act=make set=acts.more priority=9 needs=wish role=thing pattern="L [$lang.shape.want] D {thing:words}" example="I want a house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.verb lang.en.frame act=make set=acts.more priority=2 needs=wish pattern="L V.make [something|please|pls|plz]?" example="Draw." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.need lang.en.frame act=make set=acts.more priority=9 needs=wish role=thing pattern="L [it_needs|there_should_be|there_must_be|we_need|let_there_be|there_needs_to_be|i_want_there_to_be] D {thing:words}" example="There should be a house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.mods lang.en.frame act=make set=acts.more priority=11 needs=wish role=amount role=m1 role=m2 role=thing pattern="L V.make [me|us]? D {amount:number?} {m1:VALUE?} {m2:VALUE?} {thing:KIND}" example="Draw a big red house." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.more lang.en.frame act=make set=acts.more priority=14 needs=wish role=thing role=amount pattern="L [more|some_more|add_more|even_more] {thing:KIND} [like|about|say|make_it|total|so]? {amount:number}" example="More stars, like 4." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.bare.mods lang.en.frame act=make set=acts.more priority=4 needs=wish role=amount role=m1 role=m2 role=thing pattern="L D {amount:number?} {m1:VALUE?} {m2:VALUE?} {thing:KIND} [please|pls|plz|thx|thanks|now]?" example="A big red house please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.wish lang.en.frame act=change mode=set set=acts.more priority=12 needs=wish role=thing role=value pattern="L [$lang.shape.want] D {thing:words} [to_be|to_look|to_become|to_be_a|to_look_like|be]? {value:VALUE}" example="I want the house blue." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.would lang.en.frame act=change mode=set set=acts.more priority=12 needs=wish role=thing role=value pattern="L [i_would_like|i_d_like|id_like|i_want|i_need] D {thing:words} [to_be|to_look|to_become|to_be_a]? {value:VALUE}" example="I would like the sky to be pink." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.would.be lang.en.frame act=change mode=set set=acts.more priority=12 needs=wish role=value role=thing pattern="D {value:VALUE} {thing:words} [would_be_nicer|would_be_nice|would_look_better|would_be_better]" example="A purple sky would be nicer." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.short lang.en.frame act=change mode=set set=acts.more priority=4 needs=wish role=thing role=value pattern="L D {thing:words} {value:VALUE} [please|pls|plz|thx|thanks|only|now]?" example="House huge." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.short.first lang.en.frame act=change mode=set set=acts.more priority=4 needs=wish role=value role=thing pattern="L D {value:VALUE} {thing:words} [please|pls|plz|thx|thanks|now]?" example="Solid star." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.state.sky lang.en.frame act=change mode=set set=acts.more priority=11 needs=wish role=value pattern="[it_is|its|it_s|it_looks|it_gets|it_becomes|it_should_be|it_should_look_like|let_it_be|i_want_it_to_be|i_want_it|make_it|make_it_look_like|make_it_look|make_it_seem_like|turn_it_into|change_it_to|set_it_to] {value:VALUE} [time|mode|now|already|please|pls]? [time|mode]?" example="It is red." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.change.bare.value lang.en.frame act=change mode=set set=acts.more priority=3 needs=wish role=value pattern="L D {value:VALUE} [time|mode|please|pls]? [time|mode]?" example="Red." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.place.wish lang.en.frame act=place set=acts.more priority=12 needs=wish role=thing role=rel role=place pattern="L [$lang.shape.want] D {thing:words} REL D {place:words}" example="I want the house next to the tree." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.place.needs lang.en.frame act=place set=acts.more priority=11 needs=wish role=thing role=rel role=place pattern="L D {thing:words} [needs_to_be|should_be|must_be|has_to_be|goes|go|belongs|should_go|needs_to_go|should_stand|stands|is] REL D {place:words}" example="The house goes next to the tree." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.give lang.en.frame act=make set=acts.more priority=10 needs=wish role=place role=thing lit.rel="to" pattern="L give D {place:words} D {thing:rest}" example="Give the house a blue door." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.make.have lang.en.frame act=make set=acts.more priority=10 needs=wish role=place role=thing lit.rel="to" pattern="L [could|can|would|should|may|must] D {place:words} [have] D {thing:rest}" example="Could the house have a yellow door?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.no lang.en.frame act=remove set=acts.more priority=11 needs=wish role=thing pattern="L [i_do_not_want|i_dont_want|i_do_not_need|i_dont_need|no_more|no_longer_want|i_no_longer_need|i_dont_like|i_do_not_like|get_rid_of] D {thing:words} [anymore|any_more|please|pls]?" example="I do not want the house anymore." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.remove.away lang.en.frame act=remove set=acts.more priority=12 needs=wish role=thing pattern="L V.remove D {thing:words} [away|off|out|up]" example="Clear the house away." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists lang.en.frame act=ask mode=has set=acts.more priority=13 needs=list role=thing pattern="[is|are|was] there [any|a|an|some|the]? {thing:words} [in|on|at|of]? [my|the|this|our]? NOUN?" example="Is there a house in my picture?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.have lang.en.frame act=ask mode=has set=acts.more priority=12 needs=list role=thing pattern="L [do|does|did|can] [i|we|you|u]? have D [any|some]? {thing:words} [in|on|at|of]? [my|the|this|our]? NOUN?" example="Do I have a house in my picture?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.noun lang.en.frame act=ask mode=has set=acts.more priority=12 needs=list role=thing pattern="L [does|do] D [my|the|this]? NOUN have D [any|some]? {thing:words}" example="Does my picture have a house?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.any lang.en.frame act=ask mode=has set=acts.more priority=8 needs=list role=thing pattern="[any|some] {thing:words} [in_there|in_here|there|here|in_it]" example="Any houses in there?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.is lang.en.frame act=ask mode=has set=acts.more priority=8 needs=list role=thing pattern="[is|are] D {thing:words} [in_there|in_here|there|here|in_it|in_the_picture|in_my_picture]" example="Is a house in there?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.exists.color lang.en.frame act=ask mode=has set=acts.more priority=9 needs=list role=thing role=value pattern="[is|are] D {thing:words} {value:VALUE}" example="Is the house red?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe lang.en.frame act=ask mode=describe set=acts.more priority=11 needs=list pattern="L [describe|explain|summarise|summarize|list|show|tell_me_about|tell_me] D [my|the|this|our]? [whats_in|what_is_in|whats_on|what_is_on]? NOUN" example="Describe my picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe.whats lang.en.frame act=ask mode=describe set=acts.more priority=14 needs=list pattern="L [describe|explain|summarise|summarize|list|show|tell_me|tell_us] [whats_in|what_is_in|whats_on|what_is_on|what_s_on|what_s_in|what_is_there_in|what_is_there_on] D [my|the|this|our]? NOUN" example="Explain whats on the page." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe.what lang.en.frame act=ask mode=describe set=acts.more priority=14 needs=list pattern="L [tell_me|show_me|let_me_know]? [what|whats|which] [is|are|s|have_i_got|can_you_see|do_you_see|can_i_see|do_i_have]? [in|on|at|of] [my|the|this|our]? NOUN [right_now|now|there]?" example="What is in my picture?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe.made lang.en.frame act=ask mode=describe set=acts.more priority=11 needs=list pattern="L [tell_me|show_me|let_me_know]? [what|whats] [did_i|have_i|i|we|did_we|have_we] [draw|drew|drawn|make|made|add|added|put|do|done|create|created|paint|painted] [so_far|today|here]?" example="What did I draw?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.describe.see lang.en.frame act=ask mode=describe set=acts.more priority=14 needs=list pattern="L [what|whats|which] [things|objects|shapes]? [can_you_see|do_you_see|can_i_see|do_i_see|are_there|is_there|is_visible|have_i_got] [in|on]? [my|the|this]? NOUN [right_now|now|there]?" example="What can you see in my picture?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options lang.en.frame act=ask mode=options set=acts.more priority=11 needs=list role=thing pattern="L [what|which|list|show|tell_me|show_me|name] [the]? {thing:words} [can_i|could_i|can_you|may_i|do_you_know|are_there|are_available|do_i_have|do_you_have|can_we|is_available|options]" example="What colours can I use?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options.what lang.en.frame act=ask mode=options set=acts.more priority=11 needs=list pattern="L [what|which|whats] [can_i|could_i|can_you|can_u|could_u|can_we|may_i|do_you_know|do_i_have] [draw|add|make|use|paint|do|put|sketch|pick|choose] [to_my_picture|to_the_picture|to_my_drawing|to_it|in_my_picture|here]?" example="What can I draw?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options.show lang.en.frame act=ask mode=options set=acts.more priority=11 needs=list pattern="L [show_me|tell_me|list|name] [what|which] [i|you|we] [can|could] [draw|add|make|use|paint|do|put|sketch]" example="Show me what I can draw." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options.verb lang.en.frame act=ask mode=options set=acts.more priority=6 needs=list role=thing pattern="L [list|show|name|tell_me] D [the|all|all_the|all_of_the|your]? {thing:words} [list|options|available|you_know|i_can_use|i_can_add|i_can_draw|i_can_make]?" example="List the things I can draw." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.options.short lang.en.frame act=ask mode=options set=acts.more priority=5 needs=list role=thing pattern="L {thing:words} [list|options|available|are_available|do_i_have|can_i_use]" example="Colour list please." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.verb lang.en.frame act=ask mode=count set=acts.more priority=12 needs=say role=thing pattern="L [count|tally|number|total] D {thing:words} [in|on|at|of]? [my|the|this|our]? NOUN?" example="Count the houses." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.number lang.en.frame act=ask mode=count set=acts.more priority=12 needs=say role=thing pattern="L [tell_me|show_me|let_me_know]? [the_number_of|number_of|count_of|total_number_of|the_count_of|the_total_of] D {thing:words} [in|on|at|of]? [my|the|this|our]? NOUN?" example="Number of houses in the picture." core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.tail lang.en.frame act=ask mode=count set=acts.more priority=8 needs=say role=thing pattern="L D {thing:words} [count|total|number]" example="House count?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.first lang.en.frame act=ask mode=count set=acts.more priority=8 needs=say role=thing pattern="L D {thing:words} how_many [are_there|do_i_have|are_in_there|are_in_it]?" example="Houses how many?" core.source="psys2 worlds/acts 2026-11-14"
@lang.en.frame.acts.more.ask.count.tell lang.en.frame act=ask mode=count set=acts.more priority=13 needs=say role=thing pattern="L [tell_me|show_me|let_me_know|can_you_tell_me|do_you_know] how_many {thing:words} [are|is|there|are_there]? [there]? [in|on|at|of]? [my|the|this|our]? NOUN?" example="Tell me how many houses there are." core.source="psys2 worlds/acts 2026-11-14"
