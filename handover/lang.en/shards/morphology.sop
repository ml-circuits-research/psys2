@lang.en.noun.is-plural.tsunami lang.en.noun.exception kind=is-plural stem=tsunami core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.salami lang.en.noun.exception kind=is-plural stem=salami core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.chili lang.en.noun.exception kind=is-plural stem=chili core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.wifi lang.en.noun.exception kind=is-plural stem=wifi core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.zucchini lang.en.noun.exception kind=is-plural stem=zucchini core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.broccoli lang.en.noun.exception kind=is-plural stem=broccoli core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.deli lang.en.noun.exception kind=is-plural stem=deli core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.rabbi lang.en.noun.exception kind=is-plural stem=rabbi core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.zombi lang.en.noun.exception kind=is-plural stem=zombi core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.zombie lang.en.noun.exception kind=is-plural stem=zombie core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.cookie lang.en.noun.exception kind=is-plural stem=cookie core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.movie lang.en.noun.exception kind=is-plural stem=movie core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.pixie lang.en.noun.exception kind=is-plural stem=pixie core.source="psys2 closed-class sets 2026-11-14"

# plural -uses of -us nouns (octopuses, buses, viruses, cactuses, walruses; but "causes", "uses", "houses" take -s only): the word ends in one of these stems + es, or is "buses"
@lang.en.noun.us-plural.pus lang.en.noun.exception kind=us-plural-suffix stem=pus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.rus lang.en.noun.exception kind=us-plural-suffix stem=rus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.ctus lang.en.noun.exception kind=us-plural-suffix stem=ctus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.mbus lang.en.noun.exception kind=us-plural-suffix stem=mbus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.mpus lang.en.noun.exception kind=us-plural-suffix stem=mpus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.nus lang.en.noun.exception kind=us-plural-suffix stem=nus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.ngus lang.en.noun.exception kind=us-plural-suffix stem=ngus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.ccus lang.en.noun.exception kind=us-plural-suffix stem=ccus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.rcus lang.en.noun.exception kind=us-plural-suffix stem=rcus core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.us-plural.buses lang.en.noun.exception kind=us-plural-word word=buses core.source="psys2 closed-class sets 2026-11-14"

# singular to plural (lemma.mjs pluralize): the last word of a multi-word name takes the ending; irregulars (singular -> plural) first
@lang.en.inflect.plural.y lang.en.inflect op=plural order=1 suffix-pattern=consonant+y replace-suffix=y drop=1 add=ies core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.plural.es lang.en.inflect op=plural order=2 suffix=s suffix=x suffix=z suffix=ch suffix=sh add=es core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.plural.s lang.en.inflect op=plural order=3 add=s core.source="psys2 closed-class sets 2026-11-14"

# contractions the tokenizer expands before reading (normalize.mjs), and the general forms
@lang.en.contraction.can_t lang.en.contraction text="can't" expands="can not" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.cannot lang.en.contraction text="cannot" expands="can not" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.won_t lang.en.contraction text="won't" expands="will not" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.i_m lang.en.contraction text="i'm" expands="I am" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.let_s lang.en.contraction text="let's" expands="let us" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.what_s lang.en.contraction text="what's" expands="what is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.who_s lang.en.contraction text="who's" expands="who is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.where_s lang.en.contraction text="where's" expands="where is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.how_s lang.en.contraction text="how's" expands="how is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.when_s lang.en.contraction text="when's" expands="when is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.why_s lang.en.contraction text="why's" expands="why is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.that_s lang.en.contraction text="that's" expands="that is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.it_s lang.en.contraction text="it's" expands="it is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.there_s lang.en.contraction text="there's" expands="there is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.here_s lang.en.contraction text="here's" expands="here is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.he_s lang.en.contraction text="he's" expands="he is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.she_s lang.en.contraction text="she's" expands="she is" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.i_ve lang.en.contraction text="i've" expands="I have" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.i_ll lang.en.contraction text="i'll" expands="I will" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.i_d lang.en.contraction text="i'd" expands="I would" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.nt lang.en.contraction.rule pattern="(.+)n't" expands="$1 not" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.rule.re lang.en.contraction.rule pattern="(.+)'re" expands="$1 are" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.rule.ve lang.en.contraction.rule pattern="(.+)'ve" expands="$1 have" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.rule.ll lang.en.contraction.rule pattern="(.+)'ll" expands="$1 will" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.rule.m lang.en.contraction.rule pattern="(.+)'m" expands="$1 am" core.source="psys2 closed-class sets 2026-11-14"
@lang.en.contraction.rule.d lang.en.contraction.rule pattern="(.+)'d" expands="$1 would" core.source="psys2 closed-class sets 2026-11-14"
