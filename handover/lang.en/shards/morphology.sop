# w.lang.en/shards/morphology: inflection. Singular and plural rules in the order they apply (two sets: `act` is the simple one of the schema-world reader, `lemma` the lemmatizer of the rule formalizer), irregular plurals, the nouns that
# look like plurals but are not (and the reverse), the contractions. Open-class words (the nouns themselves) are k.words; these lines only say how an English word changes.
# sources: PSys2 (hand-written): worlds/acts/acts.mjs, src/formalizer/rules/lemma.mjs, src/formalizer/rules/normalize.mjs
# license: CC0-1.0

# plural to singular, in order; the first rule whose suffix matches applies. (acts.mjs singular; the schema-world reader looks a plural up by its singular)
@lang.en.inflect.act.ies lang.en.inflect op=singular set=act order=1 suffix=ies replace=y core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.act.es lang.en.inflect op=singular set=act order=2 suffix=ses suffix=xes suffix=ches suffix=shes drop=2 core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.act.s lang.en.inflect op=singular set=act order=3 suffix=s unless-suffix=ss drop=1 core.source="psys2 closed-class sets 2026-11-14"

# the lemmatizer of the rule formalizer (src/formalizer/rules/lemma.mjs): irregular plurals first (the lexicon `plural=` entries take precedence), then these, in order
@lang.en.irregular.cacti lang.en.irregular singular=cactus plural=cacti core.source="psys2 closed-class sets 2026-11-14"
@lang.en.irregular.octopi lang.en.irregular singular=octopus plural=octopi core.source="psys2 closed-class sets 2026-11-14"
@lang.en.irregular.fungi lang.en.irregular singular=fungus plural=fungi core.source="psys2 closed-class sets 2026-11-14"
@lang.en.irregular.radii lang.en.irregular singular=radius plural=radii core.source="psys2 closed-class sets 2026-11-14"
@lang.en.irregular.nuclei lang.en.irregular singular=nucleus plural=nuclei core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.lemma.ies lang.en.inflect op=singular set=lemma order=1 suffix=ies replace=y min-length=4 core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.lemma.ves lang.en.inflect op=singular set=lemma order=2 suffix=ves replace=f min-length=4 core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.lemma.es lang.en.inflect op=singular set=lemma order=3 suffix=ches suffix=shes suffix=xes suffix=sses drop=2 min-length=4 core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.lemma.us lang.en.inflect op=singular set=lemma order=4 pattern=us-plural drop=2 min-length=5 core.source="psys2 closed-class sets 2026-11-14"
@lang.en.inflect.lemma.s lang.en.inflect op=singular set=lemma order=5 suffix=s unless-suffix=ss unless-suffix=us unless-is-singular=yes drop=1 min-length=3 core.source="psys2 closed-class sets 2026-11-14"

# nouns whose plural is -is+s, not singular -is (iris keeps its s: "iris" is singular, "kiwis" is a plural)
@lang.en.noun.is-plural.kiwi lang.en.noun.exception kind=is-plural stem=kiwi core.source="psys2 closed-class sets 2026-11-14"
@lang.en.noun.is-plural.taxi lang.en.noun.exception kind=is-plural stem=taxi core.source="psys2 closed-class sets 2026-11-14"
