@lex.session.things.abilities core.lexicon
    class=modifier
    doc="TEMPORARY seed (src/knowledge/learned.mjs ABILITY_SEED): the verbs read as an ability when a bare plural says them (ducks float). Deleted when k.actions / k.commonsense carry abilities."
    word=float
    word=floats
    word=fly
    word=flies
    word=swim
    word=swims
    word=sink
    word=sinks
    word=run
    word=runs
    word=climb
    word=climbs
    word=jump
    word=jumps
    word=glow
    word=glows
    word=melt
    word=melts
    word=burn
    word=burns
    word=sing
    word=sings
    word=dance
    word=dances
    word=crawl
    word=crawls
    word=bark
    word=barks
    word=roar
    word=roars
    word=dig
    word=digs
    word=hop
    word=hops
    word=glide
    word=glides

@lex.session.things.did core.lexicon
    class=modifier
    doc="TEMPORARY seed (things.mjs DID_VIEW_TEMPORARY): the verbs of 'what I drew', 'everything we made'. Deleted when k.actions says which tool a verb belongs to."
    word=drew
    word=drawn
    word=made
    word=did
    word=built
    word=added
    word=created
    word=put
    word=placed
    word=said
    word=asked
    word=painted
    word=sketched
    word=seated
    word=planned
    word=wrote
    word=typed

@lex.session.things.views core.lexicon
    class=modifier
    doc="TEMPORARY: the words that name a view in 'a chart of what I drew' (the words each view declares in its `view` operation, repeated here so that a pattern reads only a request for a view: 'number of items on my list' is not one). Generated from the declarations when the lexicon can be built from operations."
    word=chart
    word=graph
    word=plot
    word=document
    word=doc
    word=page
    word=paragraph
    word=summary
    word=report
    word=notes
    word=timeline
    word=calendar
    word=drawing
    word=picture
    word=avatar
    word=seating
    word=conversation
    word=map
    word=atlas
