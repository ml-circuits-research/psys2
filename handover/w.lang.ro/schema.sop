# w.lang.ro: what is known about Romanian grammar, as facts, for any application that reads or writes Romanian. A LANGUAGE WORLD: Romanian words appear in it as data,
# exactly as English words appear in w.lang.en; its keys, type names, comments and structure are English. It joins the domain worlds only through sense ids (k.words,
# k.actions, k.colours, k.geo) and the shared frame vocabulary of w.lang.en (frame names, role names, relation names); no domain world holds a Romanian word.
# Loaded only when Romanian is the selected language. Open-class words are NOT wires: they are the dictionary (dictionary/*.tsv, one row per lemma); forms are
# generated by the paradigm classes below, never listed. Wires hold only what is general (classes, endings, closed words, syntax) or exceptional (irregular forms).
# DRAFT: written against the library's std.morph notation (sopworld 0.52: m.class, m.ending, m.irregular, m.fold, m.split, m.template), type names renamed to w.lang.ro.*
# sources: PSys2 src/translate (the rules translator's lexicon and morphology, hand-written for the app, CC0-1.0); hand-core (this draft)
# license: CC0-1.0

@w.lang.ro core.module name=w.lang.ro version=0 exports=class exports=ending exports=irregular exports=fold exports=split exports=template exports=pron exports=det exports=prep exports=wh exports=neg exports=numeral exports=lead exports=conj exports=frame exports=part core.source="hand-core 1"

# ---- morphology (std.morph) ----
# A paradigm class. `parent` inherits the endings of another class (and may override some); `drop` is what is cut from the lemma to get the stem; `alt` names a stem alternation
# the dictionary row selects (a>ă, ea>e, t>ț, d>z, s>ș ...). Features are the library's: num sg/pl, case nomacc/gendat/voc, def yes/no, gender m/f/n, person 1/2/3,
# tense pres/impf/perf/pqp/subj/imper/inf/ger/part.
@w.lang.ro.class core.type of=w.lang.ro.class shared=true core.source="hand-core 1"
@w.lang.ro.class.name core.slot of=w.lang.ro.class key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.ro.class.pos core.slot of=w.lang.ro.class key=pos required=true enum=noun enum=adj enum=verb core.source="hand-core 1"
@w.lang.ro.class.parent core.slot of=w.lang.ro.class key=parent kind=atom core.source="hand-core 1"
@w.lang.ro.class.drop core.slot of=w.lang.ro.class key=drop kind=string core.source="hand-core 1"
@w.lang.ro.class.alt core.slot of=w.lang.ro.class key=alt many=true kind=atom core.source="hand-core 1"
@w.lang.ro.class.gender core.slot of=w.lang.ro.class key=gender enum=m enum=f enum=n core.source="hand-core 1"

# An ending of a class: the suffix (`_` = none) added to the stem for a combination of features. Several alternations per cell are allowed (carte -> cărți: the dictionary row says which).
@w.lang.ro.ending core.type of=w.lang.ro.ending shared=true core.source="hand-core 1"
@w.lang.ro.ending.class core.slot of=w.lang.ro.ending key=class required=true kind=atom core.source="hand-core 1"
@w.lang.ro.ending.suffix core.slot of=w.lang.ro.ending key=suffix required=true kind=string core.source="hand-core 1"
@w.lang.ro.ending.num core.slot of=w.lang.ro.ending key=num enum=sg enum=pl core.source="hand-core 1"
@w.lang.ro.ending.case core.slot of=w.lang.ro.ending key=case enum=nomacc enum=gendat enum=voc core.source="hand-core 1"
@w.lang.ro.ending.def core.slot of=w.lang.ro.ending key=def enum=yes enum=no core.source="hand-core 1"
@w.lang.ro.ending.gender core.slot of=w.lang.ro.ending key=gender enum=m enum=f enum=n core.source="hand-core 1"
@w.lang.ro.ending.person core.slot of=w.lang.ro.ending key=person kind=integer min=1 max=3 core.source="hand-core 1"
@w.lang.ro.ending.tense core.slot of=w.lang.ro.ending key=tense enum=pres enum=impf enum=perf enum=pqp enum=subj enum=imper enum=inf enum=ger enum=part core.source="hand-core 1"
@w.lang.ro.ending.alt core.slot of=w.lang.ro.ending key=alt kind=atom core.source="hand-core 1"

# A form no paradigm covers (a lemma with its own form for a feature combination).
@w.lang.ro.irregular core.type of=w.lang.ro.irregular shared=true core.source="hand-core 1"
@w.lang.ro.irregular.lemma core.slot of=w.lang.ro.irregular key=lemma required=true kind=atom core.source="hand-core 1"
@w.lang.ro.irregular.form core.slot of=w.lang.ro.irregular key=form required=true kind=atom core.source="hand-core 1"
@w.lang.ro.irregular.num core.slot of=w.lang.ro.irregular key=num enum=sg enum=pl core.source="hand-core 1"
@w.lang.ro.irregular.def core.slot of=w.lang.ro.irregular key=def enum=yes enum=no core.source="hand-core 1"
@w.lang.ro.irregular.case core.slot of=w.lang.ro.irregular key=case enum=nomacc enum=gendat enum=voc core.source="hand-core 1"
@w.lang.ro.irregular.person core.slot of=w.lang.ro.irregular key=person kind=integer min=1 max=3 core.source="hand-core 1"
@w.lang.ro.irregular.tense core.slot of=w.lang.ro.irregular key=tense kind=atom core.source="hand-core 1"

# Diacritics accepted as absent: both spellings analyse to the same lemma (ș/s, ț/t, ă/a, â/î/a ...); the generator writes the diacritic spelling.
@w.lang.ro.fold core.type of=w.lang.ro.fold shared=true core.source="hand-core 1"
@w.lang.ro.fold.from core.slot of=w.lang.ro.fold key=from required=true kind=string core.source="hand-core 1"
@w.lang.ro.fold.to core.slot of=w.lang.ro.fold key=to required=true kind=string core.source="hand-core 1"
# Where a word splits in the written form (the clitic hyphen: spune-mi, fă-ți, dă-i-le).
@w.lang.ro.split core.type of=w.lang.ro.split shared=true core.source="hand-core 1"
@w.lang.ro.split.text core.slot of=w.lang.ro.split key=text required=true kind=string core.source="hand-core 1"
# A realisation template: an act in a shape of its frame is said as a text with role slots; `{role}` the form of the role's filler, `{role:def=yes}` a feature of it, `{role@other}` agreement with another role.
@w.lang.ro.template core.type of=w.lang.ro.template shared=true core.source="hand-core 1"
@w.lang.ro.template.act core.slot of=w.lang.ro.template key=act required=true kind=atom core.source="hand-core 1"
@w.lang.ro.template.shape core.slot of=w.lang.ro.template key=shape required=true kind=atom core.source="hand-core 1"
@w.lang.ro.template.text core.slot of=w.lang.ro.template key=text required=true kind=string core.source="hand-core 1"

# ---- closed word classes ----
# A pronoun. `clitic` marks the short unstressed forms (mi, ți, îl, o, îi ...); `case` nomacc / acc / dat / gen; `refers` as in w.lang.en.pron.
@w.lang.ro.pron core.type of=w.lang.ro.pron shared=true closed=true core.source="hand-core 1"
@w.lang.ro.pron.text core.slot of=w.lang.ro.pron key=text id=true required=true kind=atom core.source="hand-core 1"
@w.lang.ro.pron.case core.slot of=w.lang.ro.pron key=case many=true required=true enum=nomacc enum=acc enum=dat enum=gen core.source="hand-core 1"
@w.lang.ro.pron.person core.slot of=w.lang.ro.pron key=person kind=integer min=1 max=3 core.source="hand-core 1"
@w.lang.ro.pron.number core.slot of=w.lang.ro.pron key=number enum=sg enum=pl core.source="hand-core 1"
@w.lang.ro.pron.gender core.slot of=w.lang.ro.pron key=gender enum=m enum=f enum=n core.source="hand-core 1"
@w.lang.ro.pron.clitic core.slot of=w.lang.ro.pron key=clitic enum=yes enum=no core.source="hand-core 1"
@w.lang.ro.pron.refers core.slot of=w.lang.ro.pron key=refers many=true enum=thing enum=place enum=m enum=f enum=any enum=user enum=assistant core.source="hand-core 1"
@w.lang.ro.pron.same_as core.slot of=w.lang.ro.pron key=same_as kind=atom core.source="hand-core 1"

# A determiner or quantifier; `same_as` names the w.lang.en.det it agrees with in meaning (the join to the shared vocabulary).
@w.lang.ro.det core.type of=w.lang.ro.det shared=true closed=true core.source="hand-core 1"
@w.lang.ro.det.text core.slot of=w.lang.ro.det key=text id=true required=true kind=atom core.source="hand-core 1"
@w.lang.ro.det.kind core.slot of=w.lang.ro.det key=kind required=true enum=article enum=demonstrative enum=possessive enum=quantifier enum=numeral core.source="hand-core 1"
@w.lang.ro.det.definite core.slot of=w.lang.ro.det key=definite enum=yes enum=no core.source="hand-core 1"
@w.lang.ro.det.gender core.slot of=w.lang.ro.det key=gender enum=m enum=f enum=n core.source="hand-core 1"
@w.lang.ro.det.number core.slot of=w.lang.ro.det key=number enum=sg enum=pl core.source="hand-core 1"
@w.lang.ro.det.same_as core.slot of=w.lang.ro.det key=same_as kind=atom core.source="hand-core 1"

# A preposition as a relation. `rel` and `space` are those of w.lang.en.prep (the relation names of k.layouts); `govern` the case of its noun phrase (acc, gen, dat); `needs` a noun the
# preposition is built with (în spatele = "in the back of": the definite noun in the genitive follows).
@w.lang.ro.prep core.type of=w.lang.ro.prep shared=true closed=true core.source="hand-core 1"
@w.lang.ro.prep.text core.slot of=w.lang.ro.prep key=text id=true required=true kind=string core.source="hand-core 1"
@w.lang.ro.prep.rel core.slot of=w.lang.ro.prep key=rel required=true kind=atom core.source="hand-core 1"
@w.lang.ro.prep.space core.slot of=w.lang.ro.prep key=space enum=static enum=direction enum=source enum=path core.source="hand-core 1"
@w.lang.ro.prep.govern core.slot of=w.lang.ro.prep key=govern required=true enum=acc enum=gen enum=dat core.source="hand-core 1"
@w.lang.ro.prep.role core.slot of=w.lang.ro.prep key=role many=true kind=atom core.source="hand-core 1"
@w.lang.ro.prep.same_as core.slot of=w.lang.ro.prep key=same_as kind=atom core.source="hand-core 1"

# A question word. `asks` as in w.lang.en.wh; `agrees` when it inflects (câți / câte / câtă).
@w.lang.ro.wh core.type of=w.lang.ro.wh shared=true closed=true core.source="hand-core 1"
@w.lang.ro.wh.text core.slot of=w.lang.ro.wh key=text id=true required=true kind=string core.source="hand-core 1"
@w.lang.ro.wh.asks core.slot of=w.lang.ro.wh key=asks required=true kind=atom core.source="hand-core 1"
@w.lang.ro.wh.same_as core.slot of=w.lang.ro.wh key=same_as kind=atom core.source="hand-core 1"
@w.lang.ro.wh.agrees core.slot of=w.lang.ro.wh key=agrees many=true enum=gender enum=number core.source="hand-core 1"

# Negation words and what they negate (the verb phrase: nu; a noun phrase: fără; a time: niciodată).
@w.lang.ro.neg core.type of=w.lang.ro.neg shared=true closed=true core.source="hand-core 1"
@w.lang.ro.neg.text core.slot of=w.lang.ro.neg key=text id=true required=true kind=string core.source="hand-core 1"
@w.lang.ro.neg.scope core.slot of=w.lang.ro.neg key=scope required=true enum=verb enum=noun enum=time enum=answer core.source="hand-core 1"
@w.lang.ro.neg.same_as core.slot of=w.lang.ro.neg key=same_as kind=atom core.source="hand-core 1"

# A numeral: the value and its forms by gender (doi / două); numbers above 20 take "de" before the noun (20 de case).
@w.lang.ro.numeral core.type of=w.lang.ro.numeral shared=true closed=true core.source="hand-core 1"
@w.lang.ro.numeral.text core.slot of=w.lang.ro.numeral key=text id=true required=true kind=atom core.source="hand-core 1"
@w.lang.ro.numeral.value core.slot of=w.lang.ro.numeral key=value required=true kind=integer core.source="hand-core 1"
@w.lang.ro.numeral.gender core.slot of=w.lang.ro.numeral key=gender enum=m enum=f enum=n core.source="hand-core 1"

# Words a request skips (politeness, filler, the lead-ins), by class, as in w.lang.en's closed classes.
@w.lang.ro.lead core.type of=w.lang.ro.lead shared=true closed=true core.source="hand-core 1"
@w.lang.ro.lead.text core.slot of=w.lang.ro.lead key=text id=true required=true kind=string core.source="hand-core 1"
@w.lang.ro.lead.kind core.slot of=w.lang.ro.lead key=kind required=true enum=polite enum=desire enum=filler enum=ability enum=greeting core.source="hand-core 1"
@w.lang.ro.conj core.type of=w.lang.ro.conj shared=true closed=true core.source="hand-core 1"
@w.lang.ro.conj.text core.slot of=w.lang.ro.conj key=text id=true required=true kind=atom core.source="hand-core 1"
@w.lang.ro.conj.kind core.slot of=w.lang.ro.conj key=kind required=true enum=and enum=or enum=but enum=then enum=and-also core.source="hand-core 1"

# ---- syntax: the same frames as w.lang.en, in Romanian word order ----
# `frame` names the w.lang.en frame (acts.make, acts.make.place, acts.ask.where ...): the SAME act and roles; the parts say how Romanian orders and inflects them.
@w.lang.ro.frame core.type of=w.lang.ro.frame shared=true core.source="hand-core 1"
@w.lang.ro.frame.name core.slot of=w.lang.ro.frame key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.ro.frame.frame core.slot of=w.lang.ro.frame key=frame required=true kind=atom core.source="hand-core 1"
@w.lang.ro.frame.act core.slot of=w.lang.ro.frame key=act required=true kind=atom core.source="hand-core 1"
@w.lang.ro.frame.role core.slot of=w.lang.ro.frame key=role many=true kind=atom core.source="hand-core 1"
@w.lang.ro.frame.priority core.slot of=w.lang.ro.frame key=priority kind=integer core.source="hand-core 1"
@w.lang.ro.frame.example core.slot of=w.lang.ro.frame key=example kind=string core.source="hand-core 1"
@w.lang.ro.part core.type of=w.lang.ro.part shared=true core.source="hand-core 1"
@w.lang.ro.part.frame core.slot of=w.lang.ro.part key=frame required=true kind=atom core.source="hand-core 1"
@w.lang.ro.part.at core.slot of=w.lang.ro.part key=at required=true kind=integer min=1 core.source="hand-core 1"
@w.lang.ro.part.is core.slot of=w.lang.ro.part key=is required=true enum=lead enum=verb enum=det enum=role enum=prep enum=wh enum=neg enum=adj enum=word core.source="hand-core 1"
@w.lang.ro.part.role core.slot of=w.lang.ro.part key=role kind=atom core.source="hand-core 1"
@w.lang.ro.part.optional core.slot of=w.lang.ro.part key=optional enum=yes enum=no core.source="hand-core 1"
@w.lang.ro.part.case core.slot of=w.lang.ro.part key=case enum=nomacc enum=gendat enum=acc core.source="hand-core 1"
@w.lang.ro.part.def core.slot of=w.lang.ro.part key=def enum=yes enum=no enum=any core.source="hand-core 1"
@w.lang.ro.part.agrees_with core.slot of=w.lang.ro.part key=agrees_with kind=atom core.source="hand-core 1"
@w.lang.ro.part.mood core.slot of=w.lang.ro.part key=mood enum=imperative enum=subjunctive enum=indicative enum=infinitive core.source="hand-core 1"
@w.lang.ro.part.phrase core.slot of=w.lang.ro.part key=phrase kind=atom core.source="hand-core 1"
