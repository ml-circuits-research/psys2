# ---- realisation templates: an act and its roles said in Romanian (generation direction of the same frames) ----
# `{thing}` is the filler in the case and definiteness the frame part asks for; `{value@thing}` an adjective agreeing with the thing; `{rel}` the preposition of the relation and `{place:case=acc}` the place in the case it governs.
@w.lang.ro.template.make w.lang.ro.template act=make shape=bare text="desenează {thing:def=no}" core.source="hand-core 1"
@w.lang.ro.template.make_value w.lang.ro.template act=make shape=value text="desenează {thing:def=no} {value@thing}" core.source="hand-core 1"
@w.lang.ro.template.make_place w.lang.ro.template act=make shape=place text="desenează {thing:def=no} {rel} {place:case=acc}" core.source="hand-core 1"
@w.lang.ro.template.change_value w.lang.ro.template act=change shape=value text="fă {thing:def=yes} {value@thing}" core.source="hand-core 1"
@w.lang.ro.template.place w.lang.ro.template act=place shape=place text="mută {thing:def=yes} {rel} {place:case=acc}" core.source="hand-core 1"
@w.lang.ro.template.remove w.lang.ro.template act=remove shape=bare text="șterge {thing:def=yes}" core.source="hand-core 1"
@w.lang.ro.template.ask_capital w.lang.ro.template act=ask shape=capital text="care este capitala {thing:case=gendat}?" core.source="hand-core 1"
@w.lang.ro.template.ask_calc w.lang.ro.template act=ask shape=calc text="cât face {a} {op} {b}?" core.source="hand-core 1"
@w.lang.ro.template.done_make w.lang.ro.template act=reply.done.make shape=bare text="Am desenat {thing:def=no}." core.source="hand-core 1"
