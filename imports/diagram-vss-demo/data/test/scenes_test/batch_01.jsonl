{"id": "sc3-05-001", "domain": "living room interior", "names": [], "groups": {}, "text": "I'm drawing my living room. Wall first: a faint orange rectangle in the background, 780 by 330, at 400,175, named Wall.", "wires": [{"span": "Wall first: a faint orange rectangle in the background, 780 by 330, at 400,175, named Wall", "trigger": "Wall first", "type": "command", "args": {"action": "create", "color": "orange", "fill": "faint", "shape": "rectangle", "layer": "background", "width": "780", "height": "330", "at": "400,175", "name": "Wall"}}]}
