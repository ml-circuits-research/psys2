{"id": "sc3-10-001", "domain": "town map", "names": [], "groups": {}, "text": "I'm making a little map of our town, Riverton. Background: a faint lime rectangle covering the canvas, 780 by 480, at 400,250, called Land.", "wires": [{"span": "Background: a faint lime rectangle covering the canvas, 780 by 480, at 400,250, called Land", "trigger": "rectangle", "type": "command", "args": {"action": "create", "layer": "background", "color": "lime", "fill": "faint", "shape": "rectangle", "width": "780", "height": "480", "at": "400,250", "name": "Land"}}]}
{"id": "sc3-10-002", "domain": "town map", "names": ["Land"], "groups": {}, "text": "Town hall goes in the middle: a large gray square named Hall, labelled \"Town Hall\".", "wires": [{"span": "Town hall goes in the middle: a large gray square named Hall, labelled \"Town Hall\"", "trigger": "goes", "type": "command", "args": {"action": "create", "position": "center", "size": "large", "color": "gray", "shape": "square", "name": "Hall", "label": "Town Hall"}}]}
{"id": "sc3-10-003", "domain": "town map", "names": ["Land", "Hall"], "groups": {}, "text": "Put the market on its left, a yellow diamond named Market.", "wires": [{"span": "Put the market on its left, a yellow diamond named Market", "trigger": "Put", "type": "command", "args": {"action": "create", "position": "leftOf", "anchor": "Hall", "color": "yellow", "shape": "diamond", "name": "Market"}}]}
{"id": "sc3-10-004", "domain": "town map", "names": ["Land", "Hall", "Market"], "groups": {}, "text": "School is to the right of Hall, about 120 px away, medium blue rectangle, name School", "wires": [{"span": "School is to the right of Hall, about 120 px away, medium blue rectangle, name School", "trigger": "rectangle", "type": "command", "args": {"action": "create", "position": "rightOf", "anchor": "Hall", "distance": "120", "size": "medium", "color": "blue", "shape": "rectangle", "name": "School"}}]}
{"id": "sc3-10-005", "domain": "town map", "names": ["Land", "Hall", "Market", "School"], "groups": {}, "text": "Library: purple square just above the school", "wires": [{"span": "Library: purple square just above the school", "trigger": "square", "type": "command", "args": {"action": "create", "color": "purple", "shape": "square", "position": "above", "anchor": "School", "name": "Library"}}]}
{"id": "sc3-10-006", "domain": "town map", "names": ["Land", "Hall", "Market", "School", "Library"], "groups": {}, "text": "and the hospital under the town hall, a red rectangle called Hospital", "wires": [{"span": "the hospital under the town hall, a red rectangle called Hospital", "trigger": "rectangle", "type": "command", "args": {"action": "create", "position": "below", "anchor": "Hall", "color": "red", "shape": "rectangle", "name": "Hospital"}}]}
