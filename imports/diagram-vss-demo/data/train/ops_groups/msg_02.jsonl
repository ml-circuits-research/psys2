{"id": "g2-036", "domain": "astronomy", "names": ["Sun", "Jupiter", "Saturn", "Pluto"], "groups": {"Giants": ["Jupiter", "Saturn"]}, "text": "The giants are so big, make Giants huge, but Pluto small. And put Giants right of Sun. Then list the members of Giants.", "wires": [{"span": "make Giants huge", "trigger": "huge", "type": "command", "args": {"action": "set", "target": "Giants", "size": "huge"}}, {"span": "Pluto small", "trigger": "small", "type": "command", "args": {"action": "set", "target": "Pluto", "size": "small"}}, {"span": "put Giants right of Sun", "trigger": "right of", "type": "command", "args": {"action": "move", "target": "Giants", "position": "rightOf", "anchor": "Sun"}}, {"span": "list the members of Giants", "trigger": "members of", "type": "question", "args": {"ask": "members", "target": "Giants"}}]}
{"id": "g2-037", "domain": "hospital", "names": ["Er", "Icu", "Lab", "Ward"], "groups": {"Critical": ["Er", "Icu"]}, "text": "Hospital map. Which shapes are in Critical? Add Lab to Critical, it supports both, and move Ward below Critical.", "wires": [{"span": "Which shapes are in Critical", "trigger": "Which shapes are in", "type": "question", "args": {"ask": "members", "target": "Critical"}}, {"span": "Add Lab to Critical", "trigger": "Add", "type": "command", "args": {"action": "group", "target": "Lab,Critical", "name": "Critical"}}, {"span": "move Ward below Critical", "trigger": "move", "type": "command", "args": {"action": "move", "target": "Ward", "position": "below", "anchor": "Critical"}}]}
{"id": "g2-038", "domain": "data science", "names": ["Raw", "Clean", "Model", "Report"], "groups": {"Prep": ["Raw", "Clean"]}, "text": "ML pipeline. Ungroup Prep. Make Raw red and Clean orange, connect Clean to Model, and then put Model and Report together as Final.", "wires": [{"span": "Ungroup Prep", "trigger": "Ungroup", "type": "command", "args": {"action": "ungroup", "target": "Prep"}}, {"span": "Make Raw red", "trigger": "Make", "type": "command", "args": {"action": "set", "target": "Raw", "color": "red"}}, {"span": "Clean orange", "trigger": "orange", "type": "command", "args": {"action": "set", "target": "Clean", "color": "orange"}}, {"span": "connect Clean to Model", "trigger": "connect", "type": "command", "args": {"action": "connect", "from": "Clean", "to": "Model"}}, {"span": "put Model and Report together as Final", "trigger": "together", "type": "command", "args": {"action": "group", "target": "Model,Report", "name": "Final"}}]}
{"id": "g2-039", "domain": "zoo", "names": ["Lion", "Tiger", "Bear", "Monkey"], "groups": {"Cats": ["Lion", "Tiger"]}, "text": "Zoo map. Delete Cats and then delete Monkey as well. Draw a huge green square named Park in the middle. Which group is Bear in? hopefully none", "wires": [{"span": "Delete Cats", "trigger": "Delete", "type": "command", "args": {"action": "delete", "target": "Cats"}}, {"span": "delete Monkey", "trigger": "delete", "type": "command", "args": {"action": "delete", "target": "Monkey"}}, {"span": "Draw a huge green square named Park in the middle", "trigger": "Draw", "type": "command", "args": {"action": "create", "shape": "square", "color": "green", "size": "huge", "name": "Park", "position": "center"}}, {"span": "Which group is Bear in", "trigger": "Which group", "type": "question", "args": {"ask": "groupOf", "target": "Bear"}}]}
{"id": "g2-040", "domain": "city transport", "names": ["Bus1", "Bus2", "Bus3", "Depot"], "groups": {"Fleet": ["Bus1", "Bus2", "Bus3"]}, "text": "Fleet planning. Take Bus3 out of Fleet and send Bus3 to the back. After that, align Fleet vertically, and tell me which group Depot is in, if any.", "wires": [{"span": "Take Bus3 out of Fleet", "trigger": "Take", "type": "command", "args": {"action": "ungroup", "target": "Bus3"}}, {"span": "send Bus3 to the back", "trigger": "send", "type": "command", "args": {"action": "toBack", "target": "Bus3"}}, {"span": "align Fleet vertically", "trigger": "align", "type": "command", "args": {"action": "align", "target": "Fleet", "axis": "vertical"}}, {"span": "which group Depot is in", "trigger": "which group", "type": "question", "args": {"ask": "groupOf", "target": "Depot"}}]}
