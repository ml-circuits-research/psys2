{"id": "g2-033", "domain": "wedding", "names": ["Bride", "Groom", "Priest", "Band"], "groups": {}, "text": "Wedding seating chart!! Group Bride and Groom as Couple, put Couple at the center and Priest above Couple. Band at the bottom right. Is the Band in any group? Please say no. lol", "wires": [{"span": "Group Bride and Groom as Couple", "trigger": "Group", "type": "command", "args": {"action": "group", "target": "Bride,Groom", "name": "Couple"}}, {"span": "put Couple at the center", "trigger": "put", "type": "command", "args": {"action": "move", "target": "Couple", "position": "center"}}, {"span": "Priest above Couple", "trigger": "above", "type": "command", "args": {"action": "move", "target": "Priest", "position": "above", "anchor": "Couple"}}, {"span": "Band at the bottom right", "trigger": "at the bottom right", "type": "command", "args": {"action": "move", "target": "Band", "position": "bottomRight"}}, {"span": "Is the Band in any group", "trigger": "in any group", "type": "question", "args": {"ask": "groupOf", "target": "Band"}}]}
