{"id": "g5-030", "domain": "letters", "names": ["Cc", "Dd", "Ee"], "groups": {"Pair": ["Cc", "Dd"]}, "text": "add Ee to Pair", "wires": [{"span": "add Ee to Pair", "trigger": "add", "type": "command", "args": {"action": "group", "target": "Ee,Pair", "name": "Pair"}}]}
{"id": "g5-031", "domain": "sky", "names": ["Moon", "Sun", "Star"], "groups": {"Sky": ["Moon", "Sun"]}, "text": "list the members of Sky", "wires": [{"span": "list the members of Sky", "trigger": "members of", "type": "question", "args": {"ask": "members", "target": "Sky"}}]}
{"id": "g5-032", "domain": "office move", "names": ["Desk", "Chair", "Plant", "Lamp"], "groups": {}, "text": "We are moving offices and I'm redrawing. Are there any groups on the canvas, I can't remember? If not, put Desk and Chair together as Workstation. The Plant goes left of Workstation and Lamp right of it. Also is Lamp part of a group?", "wires": [{"span": "Are there any groups on the canvas", "trigger": "Are there any groups", "type": "question", "args": {"ask": "exists", "kind": "group"}}, {"span": "put Desk and Chair together as Workstation", "trigger": "together", "type": "command", "args": {"action": "group", "target": "Desk,Chair", "name": "Workstation"}}, {"span": "The Plant goes left of Workstation", "trigger": "left of", "type": "command", "args": {"action": "move", "target": "Plant", "position": "leftOf", "anchor": "Workstation"}}, {"span": "Lamp right of it", "trigger": "right of", "type": "command", "args": {"action": "move", "target": "Lamp", "position": "rightOf", "anchor": "Workstation"}}, {"span": "is Lamp part of a group", "trigger": "part of", "type": "question", "args": {"ask": "groupOf", "target": "Lamp"}}]}
{"id": "g5-033", "domain": "bedtime story", "names": ["Bear", "Bunny", "Fox", "Tree"], "groups": {}, "text": "Bedtime story map. Put Bear and Bunny in a group named Friends and leave Fox alone. Move Friends near Tree, shrink Friends and color Friends yellow. Which group is Fox in? None, i guess.", "wires": [{"span": "Put Bear and Bunny in a group named Friends", "trigger": "Put", "type": "command", "args": {"action": "group", "target": "Bear,Bunny", "name": "Friends"}}, {"span": "Move Friends near Tree", "trigger": "Move", "type": "command", "args": {"action": "move", "target": "Friends", "position": "near", "anchor": "Tree"}}, {"span": "shrink Friends", "trigger": "shrink", "type": "command", "args": {"action": "resize", "target": "Friends"}}, {"span": "color Friends yellow", "trigger": "color", "type": "command", "args": {"action": "set", "target": "Friends", "color": "yellow"}}, {"span": "Which group is Fox in", "trigger": "Which group", "type": "question", "args": {"ask": "groupOf", "target": "Fox"}}]}
{"id": "g5-034", "domain": "mine", "names": ["Pit", "Cart", "Rail", "Lamp"], "groups": {}, "text": "Mine layout. group Cart and Rail together as Line. Duplicate Line twice. Align Line vertically. Lamp near Pit.", "wires": [{"span": "group Cart and Rail together as Line", "trigger": "group", "type": "command", "args": {"action": "group", "target": "Cart,Rail", "name": "Line"}}, {"span": "Duplicate Line twice", "trigger": "Duplicate", "type": "command", "args": {"action": "duplicate", "target": "Line", "count": "2"}}, {"span": "Align Line vertically", "trigger": "Align", "type": "command", "args": {"action": "align", "target": "Line", "axis": "vertical"}}, {"span": "Lamp near Pit", "trigger": "near", "type": "command", "args": {"action": "move", "target": "Lamp", "position": "near", "anchor": "Pit"}}]}
{"id": "g5-035", "domain": "gym", "names": ["Bike", "Treadmill", "Weights", "Desk"], "groups": {}, "text": "Gym floor plan. Bundle Bike and Treadmill as Cardio, and Weights stays alone. Put Cardio left of Weights. Make Cardio larger, hmm, huge. What groups are there?", "wires": [{"span": "Bundle Bike and Treadmill as Cardio", "trigger": "Bundle", "type": "command", "args": {"action": "group", "target": "Bike,Treadmill", "name": "Cardio"}}, {"span": "Put Cardio left of Weights", "trigger": "Put", "type": "command", "args": {"action": "move", "target": "Cardio", "position": "leftOf", "anchor": "Weights"}}, {"span": "Make Cardio larger, hmm, huge", "trigger": "Make", "type": "command", "args": {"action": "set", "target": "Cardio", "size": "huge"}}, {"span": "What groups are there", "trigger": "What groups", "type": "question", "args": {"ask": "list", "kind": "group"}}]}
{"id": "g5-036", "domain": "harbor", "names": ["Ship1", "Ship2", "Ship3", "Crane", "Dock"], "groups": {}, "text": "Harbor. Treat Ship1 and Ship2 and Ship3 as a fleet, name it Fleet. Crane above Dock. Move Fleet 200 pixels left, then arrange Fleet in a row. Bring Dock to the back.", "wires": [{"span": "Treat Ship1 and Ship2 and Ship3 as a fleet, name it Fleet", "trigger": "Treat", "type": "command", "args": {"action": "group", "target": "Ship1,Ship2,Ship3", "name": "Fleet"}}, {"span": "Crane above Dock", "trigger": "above", "type": "command", "args": {"action": "move", "target": "Crane", "position": "above", "anchor": "Dock"}}, {"span": "Move Fleet 200 pixels left", "trigger": "Move", "type": "command", "args": {"action": "move", "target": "Fleet", "direction": "left", "distance": "200"}}, {"span": "arrange Fleet in a row", "trigger": "arrange", "type": "command", "args": {"action": "arrange", "target": "Fleet", "layout": "row"}}, {"span": "Bring Dock to the back", "trigger": "Bring", "type": "command", "args": {"action": "toBack", "target": "Dock"}}]}
{"id": "g5-037", "domain": "staff", "names": ["Jo", "Al", "Bo", "Cy", "Di"], "groups": {"Team": ["Jo", "Al"]}, "text": "Team reshuffle. Add Bo, Cy and Di to Team, all three. Make Team huge and label Team 'All hands'.", "wires": [{"span": "Add Bo, Cy and Di to Team", "trigger": "Add", "type": "command", "args": {"action": "group", "target": "Bo,Cy,Di,Team", "name": "Team"}}, {"span": "Make Team huge", "trigger": "Make", "type": "command", "args": {"action": "set", "target": "Team", "size": "huge"}}, {"span": "label Team 'All hands'", "trigger": "label", "type": "command", "args": {"action": "label", "target": "Team", "label": "All hands"}}]}
{"id": "g5-038", "domain": "ring network", "names": ["A1", "A2", "B1", "B2", "Core"], "groups": {"Ring": ["A1", "A2", "B1", "B2"]}, "text": "Ring topology. Ungroup Ring for a sec and tell me which group A1 is in, I just want to be sure that worked. Then regroup A1 and A2 as RingA, and B1 and B2 as RingB.", "wires": [{"span": "Ungroup Ring", "trigger": "Ungroup", "type": "command", "args": {"action": "ungroup", "target": "Ring"}}, {"span": "tell me which group A1 is in", "trigger": "which group", "type": "question", "args": {"ask": "groupOf", "target": "A1"}}, {"span": "regroup A1 and A2 as RingA", "trigger": "regroup", "type": "command", "args": {"action": "group", "target": "A1,A2", "name": "RingA"}}, {"span": "B1 and B2 as RingB", "trigger": "as", "type": "command", "args": {"action": "group", "target": "B1,B2", "name": "RingB"}}]}
{"id": "g5-039", "domain": "toolbar", "names": ["Btn1", "Btn2", "Btn3", "Label"], "groups": {}, "text": "Toolbar. Group Btn1, Btn2 and Btn3 as Bar. Align Bar horizontally and distribute Bar horizontally. Label Bar 'tools'. Put Label below Bar.", "wires": [{"span": "Group Btn1, Btn2 and Btn3 as Bar", "trigger": "Group", "type": "command", "args": {"action": "group", "target": "Btn1,Btn2,Btn3", "name": "Bar"}}, {"span": "Align Bar horizontally", "trigger": "Align", "type": "command", "args": {"action": "align", "target": "Bar", "axis": "horizontal"}}, {"span": "distribute Bar horizontally", "trigger": "distribute", "type": "command", "args": {"action": "distribute", "target": "Bar", "axis": "horizontal"}}, {"span": "Label Bar 'tools'", "trigger": "Label", "type": "command", "args": {"action": "label", "target": "Bar", "label": "tools"}}, {"span": "Put Label below Bar", "trigger": "Put", "type": "command", "args": {"action": "move", "target": "Label", "position": "below", "anchor": "Bar"}}]}
{"id": "g5-040", "domain": "constellation", "names": ["S1", "S2", "S3", "S4"], "groups": {}, "text": "constellation. combine S1 and S2 as Twins, and combine S3 and S4 as Pair.", "wires": [{"span": "combine S1 and S2 as Twins", "trigger": "combine", "type": "command", "args": {"action": "group", "target": "S1,S2", "name": "Twins"}}, {"span": "combine S3 and S4 as Pair", "trigger": "combine", "type": "command", "args": {"action": "group", "target": "S3,S4", "name": "Pair"}}]}
