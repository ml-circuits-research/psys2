{"id": "g7-039", "domain": "data pipeline", "names": ["Ingest", "Parse", "Store", "Alert"], "groups": {"Flow": ["Ingest", "Parse"]}, "text": "Data pipeline. Add Store to Flow, turn Alert into a red diamond and put Alert below Flow. what's in Flow? Also copy Flow.", "wires": [{"span": "Add Store to Flow", "trigger": "Add", "type": "command", "args": {"action": "group", "target": "Store,Flow", "name": "Flow"}}, {"span": "turn Alert into a red diamond", "trigger": "turn", "type": "command", "args": {"action": "set", "target": "Alert", "shape": "diamond", "color": "red"}}, {"span": "put Alert below Flow", "trigger": "put", "type": "command", "args": {"action": "move", "target": "Alert", "position": "below", "anchor": "Flow"}}, {"span": "what's in Flow", "trigger": "what's in", "type": "question", "args": {"ask": "members", "target": "Flow"}}, {"span": "copy Flow", "trigger": "copy", "type": "command", "args": {"action": "duplicate", "target": "Flow"}}]}
{"id": "g7-040", "domain": "dungeon", "names": ["Rat1", "Rat2", "Rat3", "Boss"], "groups": {}, "text": "Dungeon. Bundle Rat1, Rat2 and Rat3 as Rats, shrink Rats, and convert Boss into a huge purple star. How many groups are there?", "wires": [{"span": "Bundle Rat1, Rat2 and Rat3 as Rats", "trigger": "Bundle", "type": "command", "args": {"action": "group", "target": "Rat1,Rat2,Rat3", "name": "Rats"}}, {"span": "shrink Rats", "trigger": "shrink", "type": "command", "args": {"action": "resize", "target": "Rats"}}, {"span": "convert Boss into a huge purple star", "trigger": "convert", "type": "command", "args": {"action": "set", "target": "Boss", "shape": "star", "color": "purple", "size": "huge"}}, {"span": "How many groups are there", "trigger": "How many groups", "type": "question", "args": {"ask": "count", "kind": "group"}}]}
