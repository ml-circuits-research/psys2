{"id": "g7-031", "domain": "timetable", "names": ["Math", "Art", "Music", "Pe", "Lunch", "Bell"], "groups": {"Core": ["Math", "Art"]}, "text": "Timetable again. I want Music in Core as well, so add Music to Core. Pe is not core but let's group Pe and Lunch as Breaks. Bell should be a star, and Lunch a circle. Make Core blue and Breaks green. Duplicate Breaks. Then how many groups do we have, and what's in Breaks?", "wires": [{"span": "add Music to Core", "trigger": "add", "type": "command", "args": {"action": "group", "target": "Music,Core", "name": "Core"}}, {"span": "group Pe and Lunch as Breaks", "trigger": "group", "type": "command", "args": {"action": "group", "target": "Pe,Lunch", "name": "Breaks"}}, {"span": "Bell should be a star", "trigger": "should be", "type": "command", "args": {"action": "set", "target": "Bell", "shape": "star"}}, {"span": "Lunch a circle", "trigger": "circle", "type": "command", "args": {"action": "set", "target": "Lunch", "shape": "circle"}}, {"span": "Make Core blue", "trigger": "Make", "type": "command", "args": {"action": "set", "target": "Core", "color": "blue"}}, {"span": "Breaks green", "trigger": "green", "type": "command", "args": {"action": "set", "target": "Breaks", "color": "green"}}, {"span": "Duplicate Breaks", "trigger": "Duplicate", "type": "command", "args": {"action": "duplicate", "target": "Breaks"}}, {"span": "how many groups do we have", "trigger": "how many groups", "type": "question", "args": {"ask": "count", "kind": "group"}}, {"span": "what's in Breaks", "trigger": "what's in", "type": "question", "args": {"ask": "members", "target": "Breaks"}}]}
{"id": "g7-032", "domain": "halls", "names": ["H1", "H2"], "groups": {"Wing": ["H1", "H2"]}, "text": "which shapes are in Wing", "wires": [{"span": "which shapes are in Wing", "trigger": "which shapes are in", "type": "question", "args": {"ask": "members", "target": "Wing"}}]}
{"id": "g7-033", "domain": "zoo", "names": ["Lion", "Zebra", "Gate"], "groups": {}, "text": "Transform Lion into a gold star and Zebra into a gray square. Group Lion and Zebra as Safari, please. Gate should be a triangle.", "wires": [{"span": "Transform Lion into a gold star", "trigger": "Transform", "type": "command", "args": {"action": "set", "target": "Lion", "shape": "star", "color": "gold"}}, {"span": "Zebra into a gray square", "trigger": "into", "type": "command", "args": {"action": "set", "target": "Zebra", "shape": "square", "color": "gray"}}, {"span": "Group Lion and Zebra as Safari", "trigger": "Group", "type": "command", "args": {"action": "group", "target": "Lion,Zebra", "name": "Safari"}}, {"span": "Gate should be a triangle", "trigger": "should be", "type": "command", "args": {"action": "set", "target": "Gate", "shape": "triangle"}}]}
{"id": "g7-034", "domain": "operating system", "names": ["Kernel", "Shell", "App1", "App2"], "groups": {"Userland": ["App1", "App2"]}, "text": "Reshape Kernel as a hexagon and Shell as an ellipse. Take App2 out of Userland. Is App2 in a group now? Then delete Userland.", "wires": [{"span": "Reshape Kernel as a hexagon", "trigger": "Reshape", "type": "command", "args": {"action": "set", "target": "Kernel", "shape": "hexagon"}}, {"span": "Shell as an ellipse", "trigger": "as", "type": "command", "args": {"action": "set", "target": "Shell", "shape": "ellipse"}}, {"span": "Take App2 out of Userland", "trigger": "Take", "type": "command", "args": {"action": "ungroup", "target": "App2"}}, {"span": "Is App2 in a group now", "trigger": "in a group", "type": "question", "args": {"ask": "groupOf", "target": "App2"}}, {"span": "delete Userland", "trigger": "delete", "type": "command", "args": {"action": "delete", "target": "Userland"}}]}
