{"id": "g8-038", "domain": "party", "names": ["Balloon", "Cake", "Gift"], "groups": {}, "text": "Party. Convert Balloon to a circle, Cake to a triangle, Gift to a square. Group Cake and Gift as Table, bring Table to the front. How many groups do we have?", "wires": [{"span": "Convert Balloon to a circle", "trigger": "Convert", "type": "command", "args": {"action": "set", "target": "Balloon", "shape": "circle"}}, {"span": "Cake to a triangle", "trigger": "to a triangle", "type": "command", "args": {"action": "set", "target": "Cake", "shape": "triangle"}}, {"span": "Gift to a square", "trigger": "to a square", "type": "command", "args": {"action": "set", "target": "Gift", "shape": "square"}}, {"span": "Group Cake and Gift as Table", "trigger": "Group", "type": "command", "args": {"action": "group", "target": "Cake,Gift", "name": "Table"}}, {"span": "bring Table to the front", "trigger": "bring", "type": "command", "args": {"action": "toFront", "target": "Table"}}, {"span": "How many groups do we have", "trigger": "How many groups", "type": "question", "args": {"ask": "count", "kind": "group"}}]}
