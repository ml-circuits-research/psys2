{"id": "g8-036", "domain": "electrical panel", "names": ["Fuse", "Relay1", "Relay2", "Relay3", "Panel"], "groups": {"Relays": ["Relay1", "Relay2", "Relay3"]}, "text": "Electrical panel, hopefully the last revision. Take Relay3 out of Relays and give it a fresh start: turn Relay3 into a red triangle. Fuse should be a navy square. Put Panel above Relays. What are the members of Relays? Then dissolve Relays, we're replacing them all. Connect Fuse to Panel with a dashed line.", "wires": [{"span": "Take Relay3 out of Relays", "trigger": "Take", "type": "command", "args": {"action": "ungroup", "target": "Relay3"}}, {"span": "turn Relay3 into a red triangle", "trigger": "turn", "type": "command", "args": {"action": "set", "target": "Relay3", "shape": "triangle", "color": "red"}}, {"span": "Fuse should be a navy square", "trigger": "should be", "type": "command", "args": {"action": "set", "target": "Fuse", "shape": "square", "color": "navy"}}, {"span": "Put Panel above Relays", "trigger": "Put", "type": "command", "args": {"action": "move", "target": "Panel", "position": "above", "anchor": "Relays"}}, {"span": "What are the members of Relays", "trigger": "members of", "type": "question", "args": {"ask": "members", "target": "Relays"}}, {"span": "dissolve Relays", "trigger": "dissolve", "type": "command", "args": {"action": "ungroup", "target": "Relays"}}, {"span": "Connect Fuse to Panel with a dashed line", "trigger": "Connect", "type": "command", "args": {"action": "connect", "from": "Fuse", "to": "Panel", "style": "dashed"}}]}
