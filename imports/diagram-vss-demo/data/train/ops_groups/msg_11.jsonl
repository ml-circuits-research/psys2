{"id": "g11-035", "domain": "tournament", "names": ["Red", "Blue", "Green", "Yellow"], "groups": {}, "text": "Tournament. Join Red and Blue into Round1, Green and Yellow into Round2. Align Round1 horizontally, align Round2 horizontally. Round2 below Round1. How many groups, and is Red in one?", "wires": [{"span": "Join Red and Blue into Round1", "trigger": "Join", "type": "command", "args": {"action": "group", "target": "Red,Blue", "name": "Round1"}}, {"span": "Green and Yellow into Round2", "trigger": "into", "type": "command", "args": {"action": "group", "target": "Green,Yellow", "name": "Round2"}}, {"span": "Align Round1 horizontally", "trigger": "Align", "type": "command", "args": {"action": "align", "target": "Round1", "axis": "horizontal"}}, {"span": "align Round2 horizontally", "trigger": "align", "type": "command", "args": {"action": "align", "target": "Round2", "axis": "horizontal"}}, {"span": "Round2 below Round1", "trigger": "below", "type": "command", "args": {"action": "move", "target": "Round2", "position": "below", "anchor": "Round1"}}, {"span": "How many groups", "trigger": "How many groups", "type": "question", "args": {"ask": "count", "kind": "group"}}, {"span": "is Red in one", "trigger": "in one", "type": "question", "args": {"ask": "groupOf", "target": "Red"}}]}
