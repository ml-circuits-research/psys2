{"id": "or2-0301", "domain": "food chain", "names": ["Grass", "Sheep", "Wolf", "Farmer"], "text": "Ugh I clicked something and Wolf turned into a star. undo pls. Then Grass to Sheep, Sheep to Wolf, as a chain.", "wires": [{"span": "undo", "trigger": "undo", "type": "command", "args": {"action": "undo"}}, {"span": "Grass to Sheep, Sheep to Wolf, as a chain", "trigger": "to", "type": "command", "args": {"action": "connect", "from": "Grass,Sheep,Wolf", "pairing": "chain"}}]}
