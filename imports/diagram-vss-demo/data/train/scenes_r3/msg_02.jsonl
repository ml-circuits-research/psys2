{"id": "sc3-02-001", "domain": "city street scene", "names": [], "groups": {}, "text": "City street at night. First a faint navy background rectangle over the whole canvas, 780 by 480, centred at 400,250, named Night.", "wires": [{"span": "First a faint navy background rectangle over the whole canvas, 780 by 480, centred at 400,250, named Night", "trigger": "rectangle", "type": "command", "args": {"action": "create", "shape": "rectangle", "color": "navy", "fill": "faint", "layer": "background", "width": "780", "height": "480", "at": "400,250", "name": "Night"}}]}
