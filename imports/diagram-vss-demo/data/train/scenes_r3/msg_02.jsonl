{"id": "sc3-02-004", "domain": "city street scene", "names": ["Night", "Road"], "groups": {}, "text": "Tall indigo rectangle for the first building: 120 wide, 250 high, at 90,240. Name it Tower1.", "wires": [{"span": "Tall indigo rectangle for the first building: 120 wide, 250 high, at 90,240. Name it Tower1", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "indigo", "shape": "rectangle", "width": "120", "height": "250", "at": "90,240", "name": "Tower1"}}]}
