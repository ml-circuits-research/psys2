{"id": "sc3-03-001", "domain": "space station scene", "names": [], "groups": {}, "text": "Space station scene! Background: dark navy rectangle, 780 by 480, at 400,250, background layer, called Space.", "wires": [{"span": "Background: dark navy rectangle, 780 by 480, at 400,250, background layer, called Space", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "navy", "shape": "rectangle", "width": "780", "height": "480", "at": "400,250", "layer": "background", "name": "Space"}}]}
