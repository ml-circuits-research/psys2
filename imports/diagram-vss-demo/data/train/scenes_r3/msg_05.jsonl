{"id": "sc3-06-001", "domain": "technical drawing of a pump", "names": [], "groups": {}, "text": "Technical drawing of a pump skid. Background sheet: very light gray rectangle, 780 x 480, at 400,250, background layer, name Sheet.", "wires": [{"span": "Background sheet: very light gray rectangle, 780 x 480, at 400,250, background layer, name Sheet", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "gray", "fill": "faint", "shape": "rectangle", "width": "780", "height": "480", "at": "400,250", "layer": "background", "name": "Sheet"}}]}
{"id": "sc3-06-002", "domain": "technical drawing of a pump", "names": ["Sheet"], "groups": {}, "text": "Tank: blue rectangle, 120 wide, 160 tall, at 110,260, called Tank.", "wires": [{"span": "Tank: blue rectangle, 120 wide, 160 tall, at 110,260, called Tank", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "blue", "shape": "rectangle", "width": "120", "height": "160", "at": "110,260", "name": "Tank"}}]}
{"id": "sc3-06-003", "domain": "technical drawing of a pump", "names": ["Sheet", "Tank"], "groups": {}, "text": "label it \"TANK 2000 L\"", "wires": [{"span": "label it \"TANK 2000 L\"", "trigger": "label", "type": "command", "args": {"action": "label", "target": "Tank", "label": "TANK 2000 L"}}]}
{"id": "sc3-06-004", "domain": "technical drawing of a pump", "names": ["Sheet", "Tank"], "groups": {}, "text": "Add a large gray circle named Pump to the right of the tank, labelled P-101.", "wires": [{"span": "Add a large gray circle named Pump to the right of the tank, labelled P-101", "trigger": "Add", "type": "command", "args": {"action": "create", "size": "large", "color": "gray", "shape": "circle", "name": "Pump", "position": "rightOf", "anchor": "Tank", "label": "P-101"}}]}
{"id": "sc3-06-005", "domain": "technical drawing of a pump", "names": ["Sheet", "Tank", "Pump"], "groups": {}, "text": "valve next: medium yellow diamond right of Pump, named Valve, with V1 written on it", "wires": [{"span": "medium yellow diamond right of Pump, named Valve, with V1 written on it", "trigger": "diamond", "type": "command", "args": {"action": "create", "size": "medium", "color": "yellow", "shape": "diamond", "position": "rightOf", "anchor": "Pump", "name": "Valve", "label": "V1"}}]}
{"id": "sc3-06-006", "domain": "technical drawing of a pump", "names": ["Sheet", "Tank", "Pump", "Valve"], "groups": {}, "text": "then a small teal hexagon called Filter to the right of Valve", "wires": [{"span": "then a small teal hexagon called Filter to the right of Valve", "trigger": "then", "type": "command", "args": {"action": "create", "size": "small", "color": "teal", "shape": "hexagon", "name": "Filter", "position": "rightOf", "anchor": "Valve"}}]}
{"id": "sc3-06-007", "domain": "technical drawing of a pump", "names": ["Sheet", "Tank", "Pump", "Valve", "Filter"], "groups": {}, "text": "and finally the outlet, a medium green square named Outlet to the right of Filter.", "wires": [{"span": "the outlet, a medium green square named Outlet to the right of Filter", "trigger": "square", "type": "command", "args": {"action": "create", "size": "medium", "color": "green", "shape": "square", "name": "Outlet", "position": "rightOf", "anchor": "Filter"}}]}
{"id": "sc3-06-008", "domain": "technical drawing of a pump", "names": ["Sheet", "Tank", "Pump", "Valve", "Filter", "Outlet"], "groups": {}, "text": "Connect Tank, Pump, Valve, Filter and Outlet in a chain.", "wires": [{"span": "Connect Tank, Pump, Valve, Filter and Outlet in a chain", "trigger": "Connect", "type": "command", "args": {"action": "connect", "from": "Tank,Pump,Valve,Filter,Outlet", "pairing": "chain"}}]}
{"id": "sc3-06-009", "domain": "technical drawing of a pump", "names": ["Sheet", "Tank", "Pump", "Valve", "Filter", "Outlet"], "groups": {}, "text": "Motor: gray rectangle 100 by 60, below Pump, named Motor", "wires": [{"span": "Motor: gray rectangle 100 by 60, below Pump, named Motor", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "gray", "shape": "rectangle", "width": "100", "height": "60", "position": "below", "anchor": "Pump", "name": "Motor"}}]}
