{"id": "sc3-08-001", "domain": "apartment floor plan", "names": [], "groups": {}, "text": "Floor plan of my apartment. Start with a faint gray rectangle as the background, 780 by 460, at 400,260, named Outline.", "wires": [{"span": "Start with a faint gray rectangle as the background, 780 by 460, at 400,260, named Outline", "trigger": "Start with", "type": "command", "args": {"action": "create", "color": "gray", "fill": "faint", "shape": "rectangle", "layer": "background", "width": "780", "height": "460", "at": "400,260", "name": "Outline"}}]}
{"id": "sc3-08-002", "domain": "apartment floor plan", "names": ["Outline"], "groups": {}, "text": "Living room zone: light orange rectangle 360 by 220 at 210,150, call it Living", "wires": [{"span": "Living room zone: light orange rectangle 360 by 220 at 210,150, call it Living", "trigger": "rectangle", "type": "command", "args": {"action": "create", "layer": "zone", "color": "orange", "fill": "light", "shape": "rectangle", "width": "360", "height": "220", "at": "210,150", "name": "Living"}}]}
{"id": "sc3-08-003", "domain": "apartment floor plan", "names": ["Outline", "Living"], "groups": {}, "text": "kitchen zone to its right, a light yellow rectangle, 190 x 220, centred at 495,150. Name: Kitchen.", "wires": [{"span": "kitchen zone to its right, a light yellow rectangle, 190 x 220, centred at 495,150. Name: Kitchen", "trigger": "kitchen zone", "type": "command", "args": {"action": "create", "layer": "zone", "position": "rightOf", "anchor": "Living", "color": "yellow", "fill": "light", "shape": "rectangle", "width": "190", "height": "220", "at": "495,150", "name": "Kitchen"}}]}
{"id": "sc3-08-004", "domain": "apartment floor plan", "names": ["Outline", "Living", "Kitchen"], "groups": {}, "text": "Bath: a light cyan rectangle zone, 170 by 220, at 685,150, named Bath", "wires": [{"span": "Bath: a light cyan rectangle zone, 170 by 220, at 685,150, named Bath", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "cyan", "fill": "light", "shape": "rectangle", "layer": "zone", "width": "170", "height": "220", "at": "685,150", "name": "Bath"}}]}
{"id": "sc3-08-005", "domain": "apartment floor plan", "names": ["Outline", "Living", "Kitchen", "Bath"], "groups": {}, "text": "bedroom is under the living room: light purple rectangle zone, 360 x 210, at 210,375, called Bedroom", "wires": [{"span": "bedroom is under the living room: light purple rectangle zone, 360 x 210, at 210,375, called Bedroom", "trigger": "rectangle", "type": "command", "args": {"action": "create", "position": "below", "anchor": "Living", "color": "purple", "fill": "light", "shape": "rectangle", "layer": "zone", "width": "360", "height": "210", "at": "210,375", "name": "Bedroom"}}]}
{"id": "sc3-08-006", "domain": "apartment floor plan", "names": ["Outline", "Living", "Kitchen", "Bath", "Bedroom"], "groups": {}, "text": "and the hall: light gray zone rectangle 370 by 210 at 585,375, Hall", "wires": [{"span": "and the hall: light gray zone rectangle 370 by 210 at 585,375, Hall", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "gray", "fill": "light", "layer": "zone", "shape": "rectangle", "width": "370", "height": "210", "at": "585,375", "name": "Hall"}}]}
{"id": "sc3-08-007", "domain": "apartment floor plan", "names": ["Outline", "Living", "Kitchen", "Bath", "Bedroom", "Hall"], "groups": {}, "text": "Put small captions in each room: \"Living\" at 75,58", "wires": [{"span": "Put small captions in each room: \"Living\" at 75,58", "trigger": "Put", "type": "command", "args": {"action": "create", "size": "small", "shape": "text", "label": "Living", "at": "75,58"}}]}
