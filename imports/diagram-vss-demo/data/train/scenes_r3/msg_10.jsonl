{"id": "sc3-12-001", "domain": "abstract geometric composition", "names": [], "groups": {}, "text": "Abstract composition, Bauhaus style. First a faint black background rectangle, 780 by 480, centred, named Canvas.", "wires": [{"span": "First a faint black background rectangle, 780 by 480, centred, named Canvas", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "black", "fill": "faint", "layer": "background", "shape": "rectangle", "width": "780", "height": "480", "position": "center", "name": "Canvas"}}]}
