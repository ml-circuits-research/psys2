{"id": "sc3-15-005", "domain": "emotional drawing", "names": ["Dawn", "Sea", "Sun"], "groups": {}, "text": "make the sun a little bigger", "wires": [{"span": "make the sun a little bigger", "trigger": "bigger", "type": "command", "args": {"action": "resize", "target": "Sun"}}]}
