{"id": "sc3-15-001", "domain": "emotional drawing", "names": [], "groups": {}, "text": "I want to draw a sunrise, something hopeful for a friend who's going through a hard time.", "wires": []}
{"id": "sc3-15-002", "domain": "emotional drawing", "names": [], "groups": {}, "text": "Sky first: a light orange rectangle, 780 by 300, at the top of the canvas, background, called Dawn", "wires": [{"span": "Sky first: a light orange rectangle, 780 by 300, at the top of the canvas, background, called Dawn", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "orange", "fill": "light", "shape": "rectangle", "width": "780", "height": "300", "position": "top", "layer": "background", "name": "Dawn"}}]}
{"id": "sc3-15-003", "domain": "emotional drawing", "names": ["Dawn"], "groups": {}, "text": "the sea under it: a light blue rectangle zone, 780 by 180, in the bottom part, named Sea", "wires": [{"span": "the sea under it: a light blue rectangle zone, 780 by 180, in the bottom part, named Sea", "trigger": "rectangle", "type": "command", "args": {"action": "create", "color": "blue", "fill": "light", "shape": "rectangle", "layer": "zone", "width": "780", "height": "180", "position": "bottom", "name": "Sea"}}]}
