{
  "name": "psys2",
  "version": "0.1.0",
  "description": "PragmaticSystem2: explicit computational worlds, SOP Lang, deterministic C2 operation",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/test-new-engine.mjs",
    "build:lang": "node scripts/build-lang-en.mjs",
    "check:catalog": "node scripts/build-lang-en.mjs --check",
    "test:full": "node scripts/test-new-engine.mjs",
    "test:smoke": "node scripts/test-new-engine.mjs",
    "test:fast": "node scripts/test-new-engine.mjs",
    "test:browser": "node scripts/run-tests.mjs --browser",
    "test:worlds": "node src/cli.mjs test-world all",
    "chat": "node src/cli.mjs chat",
    "serve": "node src/server/index.mjs",
    "build:webchat": "node scripts/build-webchat.mjs",
    "landing": "node scripts/update-cases.mjs && node scripts/build-system-map.mjs --write && node scripts/landing-table.mjs"
  }
}
