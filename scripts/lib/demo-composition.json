{
  "worlds": [
    "core",
    "ui.shell",
    "art.draw",
    "diagram.sketch",
    "time.calendar",
    "docs.editor",
    "ui.avatar"
  ],
  "retiredAreas": [
    {
      "id": "map",
      "world": "geo.map",
      "label": "Map",
      "status": "retired"
    },
    {
      "id": "music",
      "world": "media.music",
      "label": "Music",
      "status": "retired"
    }
  ],
  "profile": "native-editors/1",
  "always": [
    "core",
    "ui.shell",
    "art.draw",
    "diagram.sketch",
    "time.calendar",
    "docs.editor",
    "ui.avatar"
  ],
  "profiles": {
    "core": {
      "sourceFiles": [
        "world.sop",
        "legend.sop",
        "mapping.sop"
      ]
    },
    "ui.shell": {
      "profileFiles": [
        "world.sop",
        "legend.sop"
      ],
      "nativeInitializer": {
        "module": "scripts/lib/native-demo/ui.shell/initial-state.mjs",
        "export": "initialState"
      }
    },
    "art.draw": {
      "profileFiles": [
        "world.sop",
        "legend.sop"
      ],
      "schemaWorld": "pattern.art.draw",
      "schemaFiles": [
        {
          "file": "native-interface.sop",
          "role": "native-tool-interface",
          "completeStateSchema": false
        },
        {
          "file": "instance-schema.sop",
          "role": "authoritative-state-schema",
          "completeStateSchema": true
        }
      ],
      "nativeInitializer": {
        "module": "worlds/art.draw/sop-drawing.mjs",
        "export": "emptyDrawingState"
      },
      "nativeHost": {
        "module": "worlds/art.draw/sop-drawing.mjs",
        "factory": "createDrawingArea"
      },
      "runtimeModules": [
        "worlds/sop-area.mjs",
        "worlds/sop-world-host.mjs",
        "worlds/catalog-world.mjs",
        "worlds/sop-primitives.mjs",
        "worlds/art.draw/area-sources.mjs"
      ]
    },
    "diagram.sketch": {
      "profileFiles": [
        "world.sop",
        "legend.sop"
      ],
      "schemaWorld": "pattern.diagram.sketch",
      "schemaFiles": [
        {
          "file": "instance-schema.sop",
          "role": "authoritative-state-schema",
          "completeStateSchema": true
        },
        {
          "file": "native-interface.sop",
          "role": "native-tool-interface",
          "completeStateSchema": false
        },
        {
          "file": "chart-interface.sop",
          "owner": "data.charts",
          "source": "native-interface.sop",
          "role": "native-tool-interface",
          "completeStateSchema": false
        }
      ],
      "nativeInitializer": {
        "module": "worlds/diagram.sketch/sop-diagram.mjs",
        "export": "emptyDiagramState"
      },
      "nativeHost": {
        "module": "worlds/diagram.sketch/sop-diagram.mjs",
        "factory": "createDiagramArea"
      },
      "runtimeModules": [
        "worlds/sop-area.mjs",
        "worlds/sop-world-host.mjs",
        "worlds/catalog-world.mjs",
        "worlds/sop-primitives.mjs",
        "worlds/diagram.sketch/area-sources.mjs"
      ]
    },
    "time.calendar": {
      "profileFiles": [
        "world.sop",
        "legend.sop"
      ],
      "schemaWorld": "pattern.time.calendar",
      "schemaFiles": [
        {
          "file": "native-interface.sop",
          "role": "native-tool-interface",
          "completeStateSchema": false
        },
        {
          "file": "instance-schema.sop",
          "role": "canonical-state-schema",
          "completeStateSchema": true
        },
        {
          "file": "scheduling-policy.sop",
          "role": "interval-policy",
          "completeStateSchema": false
        }
      ],
      "nativeInitializer": {
        "module": "worlds/time.calendar/sop-calendar.mjs",
        "export": "emptyCalendarArea"
      },
      "nativeHost": {
        "module": "worlds/time.calendar/sop-calendar.mjs",
        "factory": "createCalendarArea"
      },
      "sourceFiles": [
        "instance-schema.sop",
        "scheduling-policy.sop"
      ],
      "runtimeModules": [
        "worlds/sop-area.mjs",
        "worlds/sop-world-host.mjs",
        "worlds/catalog-world.mjs",
        "worlds/sop-primitives.mjs",
        "worlds/time.calendar/area-sources.mjs"
      ]
    },
    "docs.editor": {
      "profileFiles": [
        "world.sop",
        "legend.sop"
      ],
      "schemaWorld": "pattern.docs.editor",
      "sourceFiles": [
        "state-schema.sop"
      ],
      "schemaFiles": [
        {
          "file": "state-schema.sop",
          "role": "canonical-instance-schema",
          "completeStateSchema": true
        },
        {
          "file": "native-interface.sop",
          "role": "native-tool-interface",
          "completeStateSchema": false
        }
      ],
      "nativeInitializer": {
        "module": "worlds/docs.editor/declared-host.mjs",
        "export": "initialCanonicalDocumentState"
      },
      "nativeHost": {
        "module": "worlds/docs.editor/declared-host.mjs",
        "factory": "createDocumentHost"
      }
    },
    "ui.avatar": {
      "profileFiles": [
        "world.sop",
        "legend.sop"
      ],
      "schemaWorld": "pattern.ui.avatar",
      "schemaFiles": [
        {
          "file": "native-interface.sop",
          "role": "native-tool-interface",
          "completeStateSchema": false
        },
        {
          "file": "instance-schema.sop",
          "role": "authoritative-state-schema",
          "completeStateSchema": true
        }
      ],
      "nativeInitializer": {
        "module": "worlds/ui.avatar/sop-avatar.mjs",
        "export": "emptyAvatarState"
      },
      "nativeHost": {
        "module": "worlds/ui.avatar/sop-avatar.mjs",
        "factory": "createAvatarArea"
      },
      "runtimeModules": [
        "worlds/sop-area.mjs",
        "worlds/sop-world-host.mjs",
        "worlds/catalog-world.mjs",
        "worlds/sop-primitives.mjs",
        "worlds/ui.avatar/area-sources.mjs"
      ]
    }
  },
  "excludeAssets": [
    "ui/tabs/map.mjs",
    "ui/tabs/map/",
    "ui/tabs/music.mjs",
    "ui/tabs/music/",
    "vendor/map/",
    "vendor/music/",
    "ui/tabs/charts.mjs"
  ]
}
