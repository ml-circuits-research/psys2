@k.words.chance.noun.1 k.words.sense word=chance pos=noun n=1 gloss="a possibility due to a favorable combination of circumstances" synonym=opportunity is_a=possibility kind_of=possibility kind_of=being kind_of=state kind_of=attribute kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.chance.noun.2 k.words.sense word=chance pos=noun n=2 gloss="an unknown and unpredictable phenomenon that causes an event to result one way rather than another" synonym=luck synonym=fortune synonym=hazard is_a=phenomenon kind_of=phenomenon kind_of=process kind_of="physical entity" kind_of=entity core.source="wordnet 3.1"
@k.words.chance.noun.3 k.words.sense word=chance pos=noun n=3 gloss="a risk involving danger" is_a=risk kind_of=risk kind_of=venture kind_of=undertaking kind_of=work kind_of=activity kind_of=act kind_of=event kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.chance.verb.1 k.words.sense word=chance pos=verb n=1 gloss="be the case by chance" is_a=happen kind_of=happen core.source="wordnet 3.1"
@k.words.chance.verb.2 k.words.sense word=chance pos=verb n=2 gloss="take a risk in the hope of a favorable outcome" synonym=gamble synonym=risk synonym=hazard synonym="take chances" synonym=adventure synonym="run a risk" synonym="take a chance" is_a=try kind_of=try kind_of=act core.source="wordnet 3.1"
@k.words.chance.verb.3 k.words.sense word=chance pos=verb n=3 gloss="come upon, as if by accident; meet with" synonym=find synonym=happen synonym=bump synonym=encounter core.source="wordnet 3.1"
@k.words.chance.adjective.1 k.words.sense word=chance pos=adjective n=1 gloss="occurring or appearing or singled out by chance" synonym=casual near_opposite=planned core.source="wordnet 3.1"
