@k.words.claim.noun.1 k.words.sense word=claim pos=noun n=1 gloss="an assertion of a right (as to money or property)" is_a=assertion kind_of=assertion kind_of=declaration kind_of=statement kind_of=message kind_of=communication kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.claim.noun.2 k.words.sense word=claim pos=noun n=2 gloss="an assertion that something is true or factual" is_a=assertion kind_of=assertion kind_of=declaration kind_of=statement kind_of=message kind_of=communication kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.claim.noun.3 k.words.sense word=claim pos=noun n=3 gloss="demand for something as rightful or due" is_a=demand kind_of=demand kind_of=activity kind_of=act kind_of=event kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
