@k.words.opinion.noun.1 k.words.sense word=opinion pos=noun n=1 gloss="a personal belief or judgment that is not founded on proof or certainty" synonym=sentiment synonym=persuasion synonym=view synonym=thought is_a=belief kind_of=belief kind_of=content kind_of=cognition kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.opinion.noun.2 k.words.sense word=opinion pos=noun n=2 gloss="a message expressing a belief about something; the expression of a belief that is held with confidence but not substantiated by positive knowledge or proof" synonym=view is_a=message kind_of=message kind_of=communication kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.opinion.noun.3 k.words.sense word=opinion pos=noun n=3 gloss="a belief or sentiment shared by most people; the voice of the people" synonym="public opinion" synonym="popular opinion" synonym="vox populi" is_a=belief kind_of=belief kind_of=content kind_of=cognition kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
