@k.words.product.noun.1 k.words.sense word=product pos=noun n=1 gloss="commodities offered for sale" synonym=merchandise synonym=ware is_a=commodity part_of="mercantile establishment" core.source="wordnet 3.1"
@k.words.product.noun.2 k.words.sense word=product pos=noun n=2 gloss="an artifact that has been created by someone or some process" synonym=production is_a=creation core.source="wordnet 3.1"
@k.words.product.noun.3 k.words.sense word=product pos=noun n=3 gloss="a quantity obtained by multiplication" synonym="mathematical product" is_a=quantity core.source="wordnet 3.1"
@k.words.printing.noun.1 k.words.sense word=printing pos=noun n=1 gloss="text handwritten in the style of printed matter" is_a=writing core.source="wordnet 3.1"
