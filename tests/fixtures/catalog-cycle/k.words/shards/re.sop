@k.words.result.noun.1 k.words.sense word=result pos=noun n=1 gloss="a phenomenon that follows and is caused by some previous phenomenon" synonym=consequence synonym=effect synonym=outcome synonym=event synonym=issue synonym=upshot is_a=phenomenon kind_of=phenomenon kind_of=process kind_of="physical entity" kind_of=entity core.source="wordnet 3.1"
@k.words.result.noun.2 k.words.sense word=result pos=noun n=2 gloss="a statement that solves a problem or explains how to solve the problem" synonym=solution synonym=answer synonym=resolution synonym=solvent is_a=statement kind_of=statement kind_of=message kind_of=communication kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.result.noun.3 k.words.sense word=result pos=noun n=3 gloss="something that results" synonym=resultant synonym="final result" synonym=outcome synonym=termination is_a=ending kind_of=ending kind_of=happening kind_of=event kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.result.verb.1 k.words.sense word=result pos=verb n=1 gloss="issue or terminate (in a specified way, state, etc.); end" synonym=ensue is_a=prove kind_of=prove kind_of=be core.source="wordnet 3.1"
@k.words.result.verb.2 k.words.sense word=result pos=verb n=2 gloss="produce as a result or residue" synonym=leave synonym=lead is_a=produce kind_of=produce kind_of=make core.source="wordnet 3.1"
