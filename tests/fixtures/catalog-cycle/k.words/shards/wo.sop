@k.words.work.noun.1 k.words.sense word=work pos=noun n=1 gloss="activity directed toward making or doing something" is_a=activity kind_of=activity kind_of=act kind_of=event kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.work.noun.2 k.words.sense word=work pos=noun n=2 gloss="a product produced or accomplished through the effort or activity or agency of a person or thing" synonym="piece of work" is_a=product kind_of=product kind_of=creation kind_of=artifact kind_of=whole kind_of=object kind_of="physical entity" kind_of=entity core.source="wordnet 3.1"
@k.words.work.noun.3 k.words.sense word=work pos=noun n=3 gloss="the occupation for which you are paid" synonym=employment is_a=occupation kind_of=occupation kind_of=activity kind_of=act kind_of=event kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
