# script: tools/scenes-core.mjs

@k.scenes.thing.dog k.scenes.thing name=dog place=ground size=medium named=model core.source="hand-core 1"
@k.scenes.thing.door k.scenes.thing name=door place=on_thing on=wall size=large named=model core.source="hand-core 1"
@k.scenes.thing.duck k.scenes.thing name=duck place=water size=small named=model core.source="hand-core 1"
