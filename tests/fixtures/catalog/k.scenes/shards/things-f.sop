@k.scenes.thing.fish k.scenes.thing name=fish place=water size=small named=model core.source="hand-core 1"
@k.scenes.thing.flower k.scenes.thing name=flower place=ground size=small named=model core.source="hand-core 1"
@k.scenes.thing.frog k.scenes.thing name=frog place=ground size=small named=model core.source="hand-core 1"
