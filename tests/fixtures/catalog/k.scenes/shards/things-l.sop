# k.scenes/shards/things-l: the usual place (sky, ground, water, indoors, on another thing) and the relative size (tiny to huge) of 76 drawable things whose name starts with "l"; labelled by a language model from the names (named=model), a sample checked against the drawings.
# sources: hand-core 1 (hand-written in this repository: sources/hand-core/place-size.tsv)
# license: CC0-1.0
# script: tools/scenes-core.mjs

@k.scenes.thing.ladder k.scenes.thing name=ladder place=ground size=large named=model core.source="hand-core 1"
@k.scenes.thing.lamp k.scenes.thing name=lamp place=indoors on=table size=small named=model core.source="hand-core 1"
@k.scenes.thing.lighthouse k.scenes.thing name=lighthouse place=ground size=huge named=model core.source="hand-core 1"
@k.scenes.thing.lion k.scenes.thing name=lion place=ground size=large named=model core.source="hand-core 1"
