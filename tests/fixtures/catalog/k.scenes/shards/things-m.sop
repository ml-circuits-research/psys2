@k.scenes.thing.Mars k.scenes.thing name=Mars place=sky size=huge named=model core.source="hand-core 1"
@k.scenes.thing.Mercury k.scenes.thing name=Mercury place=sky size=huge named=model core.source="hand-core 1"
@k.scenes.thing.milk k.scenes.thing name=milk place=indoors on=table size=small named=model core.source="hand-core 1"
@k.scenes.thing.moon k.scenes.thing name=moon place=sky size=huge named=model core.source="hand-core 1"
