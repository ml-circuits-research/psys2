# script: tools/scenes-core.mjs

@k.scenes.thing.penguin k.scenes.thing name=penguin place=ground size=medium named=model core.source="hand-core 1"
@k.scenes.thing.pizza k.scenes.thing name=pizza place=indoors on=table size=small named=model core.source="hand-core 1"
@k.scenes.thing.plane k.scenes.thing name=plane place=sky size=huge named=model core.source="hand-core 1"
@k.scenes.thing.planet k.scenes.thing name=planet place=sky size=huge named=model core.source="hand-core 1"
@k.scenes.thing.plant k.scenes.thing name=plant place=ground size=small named=model core.source="hand-core 1"
