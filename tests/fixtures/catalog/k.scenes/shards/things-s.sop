# k.scenes/shards/things-s: the usual place (sky, ground, water, indoors, on another thing) and the relative size (tiny to huge) of 258 drawable things whose name starts with "s"; labelled by a language model from the names (named=model), a sample checked against the drawings.
# sources: hand-core 1 (hand-written in this repository: sources/hand-core/place-size.tsv)
# license: CC0-1.0
# script: tools/scenes-core.mjs

@k.scenes.thing.Saturn k.scenes.thing name=Saturn place=sky size=huge named=model core.source="hand-core 1"
@k.scenes.thing.shell k.scenes.thing name=shell place=ground size=tiny named=model core.source="hand-core 1"
@k.scenes.thing.snake k.scenes.thing name=snake place=ground size=small named=model core.source="hand-core 1"
@k.scenes.thing.snowman k.scenes.thing name=snowman place=ground size=medium named=model core.source="hand-core 1"
@k.scenes.thing.soup k.scenes.thing name=soup place=indoors on=table size=small named=model core.source="hand-core 1"
@k.scenes.thing.spider k.scenes.thing name=spider place=ground size=tiny named=model core.source="hand-core 1"
@k.scenes.thing.star k.scenes.thing name=star place=sky size=huge named=model core.source="hand-core 1"
@k.scenes.thing.sun k.scenes.thing name=sun place=sky size=huge named=model core.source="hand-core 1"
