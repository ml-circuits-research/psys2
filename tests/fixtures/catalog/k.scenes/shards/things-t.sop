# k.scenes/shards/things-t: the usual place (sky, ground, water, indoors, on another thing) and the relative size (tiny to huge) of 133 drawable things whose name starts with "t"; labelled by a language model from the names (named=model), a sample checked against the drawings.
# sources: hand-core 1 (hand-written in this repository: sources/hand-core/place-size.tsv)
# license: CC0-1.0
# script: tools/scenes-core.mjs

@k.scenes.thing.table k.scenes.thing name=table place=indoors size=medium named=model core.source="hand-core 1"
@k.scenes.thing.tent k.scenes.thing name=tent place=ground size=large named=model core.source="hand-core 1"
@k.scenes.thing.tomato k.scenes.thing name=tomato place=indoors on=table size=small named=model core.source="hand-core 1"
@k.scenes.thing.train k.scenes.thing name=train place=ground size=huge named=model core.source="hand-core 1"
@k.scenes.thing.tree k.scenes.thing name=tree place=ground size=huge named=model core.source="hand-core 1"
@k.scenes.thing.tulip k.scenes.thing name=tulip place=ground size=small named=model core.source="hand-core 1"
