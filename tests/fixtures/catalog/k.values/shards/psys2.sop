# k.values/shards/psys2: from the PSys2 drawing world and lexicon: 6 shade words with how they change a colour, and the words for yes (26) and no (16).
# sources: psys2-worlds 6b63b2ba (the hand-written knowledge of the PSys2 tab worlds, the project's own data)
# license: CC0-1.0
# script: tools/import/psys2.mjs

@k.values.psys2.shade.light k.values.shade name=light lightness=0.2 saturation=-0.05 core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.shade.pale k.values.shade name=pale lightness=0.3 saturation=-0.25 core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.shade.soft k.values.shade name=soft lightness=0.14 saturation=-0.12 core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.shade.bright k.values.shade name=bright lightness=0.05 saturation=0.25 core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.shade.dark k.values.shade name=dark lightness=-0.2 saturation=0 core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.shade.deep k.values.shade name=deep lightness=-0.12 saturation=0.1 core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.word.shade.dk core.word text=dk means=dark of=k.values.shade.name core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.word.shade.lt core.word text=lt means=light of=k.values.shade.name core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.reply.yes k.values.reply name=yes opposite=no core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.reply.no k.values.reply name=no opposite=yes core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.word.reply.yes core.word text="that is right" text="that is correct" text="sure thing" text="yes please" text="of course" text="you bet" text="for sure" text=yeah text=yep text=yup text=yea text=yah text=ya text=sure text=ok text=okay text=please text=correct text=right text=absolutely text=definitely text=certainly text=affirmative text=exactly text=indeed means=yes of=k.values.reply.name core.source="psys2-worlds 6b63b2ba"
@k.values.psys2.word.reply.no core.word text="no thank you" text="of course not" text="not at all" text="nuh uh" text="no thanks" text="no way" text="not really" text="absolutely not" text="definitely not" text="certainly not" text=nope text=nah text=nay text=naw text=negative means=no of=k.values.reply.name core.source="psys2-worlds 6b63b2ba"
