# k.words/shards/al: senses of the words from "al" to "always" (first letters "al").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent, and the common things of tools/coverage.mjs)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.all.adjective.1 k.words.sense word=all pos=adjective n=1 gloss="(quantifier) used with either mass or count nouns to indicate the whole number or amount of or every one of a class" opposite=some opposite=no core.source="wordnet 3.1"
@k.words.all.adjective.2 k.words.sense word=all pos=adjective n=2 gloss="completely given to or absorbed by" near_opposite=incomplete core.source="wordnet 3.1"
@k.words.all.adverb.1 k.words.sense word=all pos=adverb n=1 gloss="to a complete degree or to the full or entire extent (`whole' is often used informally for `wholly')" synonym=wholly synonym=entirely synonym=completely synonym=totally synonym=altogether synonym=whole synonym=right core.source="wordnet 3.1"
