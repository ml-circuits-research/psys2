@k.words.bee.noun.1 k.words.sense word=bee pos=noun n=1 gloss="any of numerous hairy-bodied insects including social and solitary species" is_a="hymenopterous insect" core.source="wordnet 3.1"
@k.words.bee.noun.2 k.words.sense word=bee pos=noun n=2 gloss="a social gathering to carry out some communal task or to hold competitions" is_a="social gathering" core.source="wordnet 3.1"
