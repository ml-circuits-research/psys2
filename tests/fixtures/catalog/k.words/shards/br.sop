@k.words.brain.noun.1 k.words.sense word=brain pos=noun n=1 gloss="that part of the central nervous system that includes all the higher nervous centers; enclosed within the skull; continuous with the spinal cord" synonym=encephalon is_a="neural structure" part_of=head part_of="central nervous system" core.source="wordnet 3.1"
@k.words.brain.noun.2 k.words.sense word=brain pos=noun n=2 gloss="mental ability" synonym=brainpower synonym="learning ability" synonym="mental capacity" synonym=mentality synonym=wit is_a=intelligence core.source="wordnet 3.1"
@k.words.brain.noun.3 k.words.sense word=brain pos=noun n=3 gloss="that which is responsible for one's thoughts, feelings, and conscious brain functions; the seat of the faculty of reason" synonym=mind synonym=head synonym=psyche synonym=nous is_a=cognition core.source="wordnet 3.1"
@k.words.brain.verb.1 k.words.sense word=brain pos=verb n=1 gloss="hit on the head" is_a=hit core.source="wordnet 3.1"
