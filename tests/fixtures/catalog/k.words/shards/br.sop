@k.words.brazil.noun.1 k.words.sense word=Brazil pos=noun n=1 gloss="the largest Latin American country and the largest Portuguese speaking country in the world; located in the central and northeastern part of South America; world's leading coffee exporter" synonym="Federative Republic of Brazil" synonym=Brasil instance_of="South American country" part_of="South America" core.source="wordnet 3.1"
@k.words.brazil.noun.2 k.words.sense word=brazil pos=noun n=2 gloss="three-sided tropical American nut with white oily meat and hard brown shell" synonym="brazil nut" is_a="edible nut" part_of="brazil nut" core.source="wordnet 3.1"
@k.words.bread.noun.1 k.words.sense word=bread pos=noun n=1 gloss="food made from dough of flour or meal and usually raised with yeast or baking powder and then baked" synonym=breadstuff synonym="staff of life" is_a="baked goods" is_a=starches part_of=sandwich core.source="wordnet 3.1"
