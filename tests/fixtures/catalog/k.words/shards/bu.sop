@k.words.bus.noun.1 k.words.sense word=bus pos=noun n=1 gloss="a vehicle carrying many passengers; used for public transport" synonym=autobus synonym=coach synonym=charabanc synonym=double-decker synonym=jitney synonym=motorbus synonym=motorcoach synonym=omnibus synonym="passenger vehicle" is_a="public transport" core.source="wordnet 3.1"
@k.words.bus.noun.2 k.words.sense word=bus pos=noun n=2 gloss="the topology of a network whose components are connected by a busbar" synonym="bus topology" is_a=topology core.source="wordnet 3.1"
@k.words.bus.noun.3 k.words.sense word=bus pos=noun n=3 gloss="an electrical conductor that makes a common connection between several circuits" synonym=busbar is_a=conductor part_of="power station" part_of=computer part_of="local area network" core.source="wordnet 3.1"
@k.words.bus.verb.1 k.words.sense word=bus pos=verb n=1 gloss="send or move around by bus" is_a=transport core.source="wordnet 3.1"
@k.words.bus.verb.2 k.words.sense word=bus pos=verb n=2 gloss="ride in a bus" is_a=ride core.source="wordnet 3.1"
