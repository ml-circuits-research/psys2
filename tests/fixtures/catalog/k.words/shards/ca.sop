@k.words.car.noun.1 k.words.sense word=car pos=noun n=1 gloss="a motor vehicle with four wheels; usually propelled by an internal combustion engine" synonym=auto synonym=automobile synonym=machine synonym=motorcar is_a="motor vehicle" core.source="wordnet 3.1"
@k.words.car.noun.2 k.words.sense word=car pos=noun n=2 gloss="a wheeled vehicle adapted to the rails of railroad" synonym=railcar synonym="railway car" synonym="railroad car" is_a="wheeled vehicle" core.source="wordnet 3.1"
