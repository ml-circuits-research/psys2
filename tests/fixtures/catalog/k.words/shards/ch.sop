@k.words.chair.noun.1 k.words.sense word=chair pos=noun n=1 gloss="a seat for one person, with a support for the back" is_a=seat core.source="wordnet 3.1"
@k.words.chair.noun.2 k.words.sense word=chair pos=noun n=2 gloss="the position of professor" synonym=professorship is_a=position core.source="wordnet 3.1"
@k.words.chair.noun.3 k.words.sense word=chair pos=noun n=3 gloss="the officer who presides at the meetings of an organization" synonym=president synonym=chairman synonym=chairwoman synonym=chairperson is_a="presiding officer" core.source="wordnet 3.1"
@k.words.chair.verb.1 k.words.sense word=chair pos=verb n=1 gloss="act or preside as chair, as of an academic department in a university" synonym=chairman is_a=head core.source="wordnet 3.1"
@k.words.chair.verb.2 k.words.sense word=chair pos=verb n=2 gloss="preside over" synonym=moderate synonym=lead is_a="hash out" core.source="wordnet 3.1"
@k.words.cheese.noun.1 k.words.sense word=cheese pos=noun n=1 gloss="a solid food prepared from the pressed curd of milk" is_a="dairy product" is_a=food core.source="wordnet 3.1"
@k.words.cheese.noun.2 k.words.sense word=cheese pos=noun n=2 gloss="erect or decumbent Old World perennial with axillary clusters of rosy-purple flowers; introduced in United States" synonym="tall mallow" synonym="high mallow" synonym=cheeseflower synonym="Malva sylvestris" is_a=mallow core.source="wordnet 3.1"
@k.words.cheese.verb.1 k.words.sense word=cheese pos=verb n=1 gloss="used in the imperative (get away, or stop it)" is_a=discontinue core.source="wordnet 3.1"
@k.words.cheese.verb.2 k.words.sense word=cheese pos=verb n=2 gloss="wind onto a cheese" is_a=spool core.source="wordnet 3.1"
