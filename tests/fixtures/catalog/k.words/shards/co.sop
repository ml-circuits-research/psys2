@k.words.cows.noun.1 k.words.sense word=cows pos=noun n=1 gloss="domesticated bovine animals as a group regardless of sex or age" synonym=cattle synonym=kine synonym=oxen synonym="Bos taurus" is_a=bovine core.source="wordnet 3.1"
