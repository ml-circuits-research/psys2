@k.words.colour.noun.1 k.words.sense word=colour pos=noun n=1 gloss="any material used for its color" synonym="coloring material" synonym="colouring material" synonym=color is_a=material core.source="wordnet 3.1"
@k.words.colour.noun.2 k.words.sense word=colour pos=noun n=2 gloss="(physics) the characteristic of quarks that determines their role in the strong interaction" synonym=color is_a=kind core.source="wordnet 3.1"
@k.words.colour.noun.3 k.words.sense word=colour pos=noun n=3 gloss="interest and variety and intensity" synonym=color synonym=vividness is_a=interest core.source="wordnet 3.1"
@k.words.colour.verb.1 k.words.sense word=colour pos=verb n=1 gloss="modify or bias" synonym=color is_a=influence core.source="wordnet 3.1"
@k.words.colour.verb.2 k.words.sense word=colour pos=verb n=2 gloss="decorate with colors" synonym=color synonym=emblazon is_a=decorate core.source="wordnet 3.1"
@k.words.colour.verb.3 k.words.sense word=colour pos=verb n=3 gloss="give a deceptive explanation or excuse for" synonym=color synonym=gloss is_a=apologize core.source="wordnet 3.1"
@k.words.come.noun.1 k.words.sense word=come pos=noun n=1 gloss="the thick white fluid containing spermatozoa that is ejaculated by the male genital tract" synonym=semen synonym=seed synonym="seminal fluid" synonym=ejaculate synonym=cum is_a="liquid body substance" core.source="wordnet 3.1"
@k.words.come.verb.1 k.words.sense word=come pos=verb n=1 gloss="move toward, travel toward something or somebody or approach something or somebody" synonym="come up" is_a=travel core.source="wordnet 3.1"
@k.words.come.verb.2 k.words.sense word=come pos=verb n=2 gloss="reach a destination; arrive by movement or progress" synonym=arrive synonym=get core.source="wordnet 3.1"
@k.words.come.verb.3 k.words.sense word=come pos=verb n=3 gloss="come to pass; arrive, as in due course" is_a=happen core.source="wordnet 3.1"
@k.words.comet.noun.1 k.words.sense word=comet pos=noun n=1 gloss="(astronomy) a relatively small extraterrestrial body consisting of a frozen mass that travels around the sun in a highly elliptical orbit" is_a="extraterrestrial object" core.source="wordnet 3.1"
@k.words.correction.noun.1 k.words.sense word=correction pos=noun n=1 gloss="the act of offering an improvement to replace a mistake; setting right" synonym=rectification is_a=improvement core.source="wordnet 3.1"
@k.words.correction.noun.2 k.words.sense word=correction pos=noun n=2 gloss="a quantity that is added or subtracted in order to increase the accuracy of a scientific measure" synonym="fudge factor" is_a="indefinite quantity" core.source="wordnet 3.1"
@k.words.correction.noun.3 k.words.sense word=correction pos=noun n=3 gloss="something substituted for an error" is_a=editing core.source="wordnet 3.1"
@k.words.country.noun.1 k.words.sense word=country pos=noun n=1 gloss="a politically organized body of people under a single government" synonym=state synonym=nation synonym=land synonym=commonwealth synonym="res publica" synonym="body politic" is_a="political unit" core.source="wordnet 3.1"
@k.words.country.noun.2 k.words.sense word=country pos=noun n=2 gloss="the territory occupied by a nation" synonym=state synonym=land is_a="administrative district" core.source="wordnet 3.1"
@k.words.country.noun.3 k.words.sense word=country pos=noun n=3 gloss="the people who live in a nation or country" synonym=nation synonym=land is_a=people core.source="wordnet 3.1"
@k.words.cow.noun.1 k.words.sense word=cow pos=noun n=1 gloss="female of domestic cattle: \"`moo-cow' is a child's term\"" synonym=moo-cow is_a=cattle core.source="wordnet 3.1"
@k.words.cow.noun.2 k.words.sense word=cow pos=noun n=2 gloss="mature female of mammals of which the male is called `bull'" is_a=placental core.source="wordnet 3.1"
