@k.words.cup.noun.1 k.words.sense word=cup pos=noun n=1 gloss="a small open container usually used for drinking; usually has a handle" is_a=crockery is_a=container core.source="wordnet 3.1"
@k.words.cup.noun.2 k.words.sense word=cup pos=noun n=2 gloss="the quantity a cup will hold" synonym=cupful is_a=containerful core.source="wordnet 3.1"
@k.words.cup.noun.3 k.words.sense word=cup pos=noun n=3 gloss="any cup-shaped concavity" is_a="concave shape" core.source="wordnet 3.1"
@k.words.cup.verb.1 k.words.sense word=cup pos=verb n=1 gloss="form into the shape of a cup" is_a=shape core.source="wordnet 3.1"
@k.words.cup.verb.2 k.words.sense word=cup pos=verb n=2 gloss="put into a cup" is_a=insert core.source="wordnet 3.1"
@k.words.cup.verb.3 k.words.sense word=cup pos=verb n=3 gloss="treat by applying evacuated cups to the patient's skin" synonym=transfuse is_a=treat core.source="wordnet 3.1"
