@k.words.day.noun.1 k.words.sense word=day pos=noun n=1 gloss="time for Earth to make a complete rotation on its axis" synonym="twenty-four hours" synonym="twenty-four hour period" synonym="24-hour interval" synonym="solar day" synonym="mean solar day" is_a="time unit" core.source="wordnet 3.1"
@k.words.day.noun.2 k.words.sense word=day pos=noun n=2 gloss="some point or period in time" is_a=time core.source="wordnet 3.1"
@k.words.day.noun.3 k.words.sense word=day pos=noun n=3 gloss="a day assigned to a particular purpose or observance" is_a="calendar day" core.source="wordnet 3.1"
@k.words.days.noun.1 k.words.sense word=days pos=noun n=1 gloss="the time during which someone's life continues" synonym=years is_a=life core.source="wordnet 3.1"
