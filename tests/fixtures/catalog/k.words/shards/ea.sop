@k.words.earth.noun.1 k.words.sense word=Earth pos=noun n=1 gloss="the 3rd planet from the sun; the planet we live on" synonym=earth synonym=world synonym=globe instance_of="terrestrial planet" core.source="wordnet 3.1"
