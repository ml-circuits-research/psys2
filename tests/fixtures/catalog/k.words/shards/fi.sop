@k.words.fifth.noun.1 k.words.sense word=fifth pos=noun n=1 gloss="a quantity of liquor equal to one fifth of a United States gallon" is_a="United States liquid unit" core.source="wordnet 3.1"
@k.words.fifth.noun.2 k.words.sense word=fifth pos=noun n=2 gloss="position five in a countable series of things" is_a=rank core.source="wordnet 3.1"
@k.words.fifth.noun.3 k.words.sense word=fifth pos=noun n=3 gloss="one part in five equal parts" synonym=one-fifth synonym="fifth part" synonym="twenty percent" is_a="common fraction" core.source="wordnet 3.1"
@k.words.first.noun.1 k.words.sense word=first pos=noun n=1 gloss="the first or highest in an ordering or series" synonym="number one" is_a=rank core.source="wordnet 3.1"
@k.words.first.noun.2 k.words.sense word=first pos=noun n=2 gloss="the first element in a countable series" synonym="number one" synonym="number 1" is_a="ordinal number" core.source="wordnet 3.1"
@k.words.first.noun.3 k.words.sense word=first pos=noun n=3 gloss="the time at which something is supposed to begin" synonym=beginning synonym=commencement synonym=outset synonym=get-go synonym=start synonym=kickoff synonym="starting time" synonym=showtime synonym=offset is_a=point core.source="wordnet 3.1"
@k.words.fish.noun.1 k.words.sense word=fish pos=noun n=1 gloss="any of various mostly cold-blooded aquatic vertebrates usually having scales and breathing through gills" is_a="aquatic vertebrate" core.source="wordnet 3.1"
@k.words.fish.noun.2 k.words.sense word=fish pos=noun n=2 gloss="the flesh of fish used as food" is_a=food core.source="wordnet 3.1"
@k.words.fish.noun.3 k.words.sense word=Fish pos=noun n=3 gloss="(astrology) a person who is born while the sun is in Pisces" synonym=Pisces is_a=person core.source="wordnet 3.1"
@k.words.fish.verb.1 k.words.sense word=fish pos=verb n=1 gloss="seek indirectly" synonym=angle is_a=search core.source="wordnet 3.1"
@k.words.fish.verb.2 k.words.sense word=fish pos=verb n=2 gloss="catch or try to catch fish or shellfish" is_a=catch core.source="wordnet 3.1"
