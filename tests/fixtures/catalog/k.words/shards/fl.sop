@k.words.flower.noun.1 k.words.sense word=flower pos=noun n=1 gloss="a plant cultivated for its blooms or blossoms" is_a=angiosperm core.source="wordnet 3.1"
@k.words.flower.noun.2 k.words.sense word=flower pos=noun n=2 gloss="reproductive organ of angiosperm plants especially one having showy or colorful parts" synonym=bloom synonym=blossom is_a="reproductive structure" part_of=angiosperm core.source="wordnet 3.1"
@k.words.flower.noun.3 k.words.sense word=flower pos=noun n=3 gloss="the period of greatest prosperity or productivity" synonym=prime synonym=peak synonym=heyday synonym=bloom synonym=blossom synonym=efflorescence synonym=flush is_a="time period" core.source="wordnet 3.1"
@k.words.flower.verb.1 k.words.sense word=flower pos=verb n=1 gloss="produce or yield flowers" synonym=bloom synonym=blossom is_a=develop core.source="wordnet 3.1"
