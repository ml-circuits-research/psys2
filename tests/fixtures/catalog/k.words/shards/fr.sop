@k.words.france.noun.1 k.words.sense word=France pos=noun n=1 gloss="a republic in western Europe; the largest country wholly in Europe" synonym="French Republic" instance_of="European country" part_of=Europe core.source="wordnet 3.1"
@k.words.france.noun.2 k.words.sense word=France pos=noun n=2 gloss="French writer of sophisticated novels and short stories (1844-1924)" synonym="Anatole France" synonym="Jacques Anatole Francois Thibault" instance_of=writer core.source="wordnet 3.1"
@k.words.free.noun.1 k.words.sense word=free pos=noun n=1 gloss="people who are free" synonym="free people" is_a=people core.source="wordnet 3.1"
@k.words.free.verb.1 k.words.sense word=free pos=verb n=1 gloss="grant freedom to; free from confinement" synonym=liberate synonym=release synonym=unloose synonym=unloosen synonym=loose core.source="wordnet 3.1"
