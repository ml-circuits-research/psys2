@k.words.giant.noun.1 k.words.sense word=giant pos=noun n=1 gloss="any creature of exceptional size" is_a=animal core.source="wordnet 3.1"
@k.words.giant.noun.2 k.words.sense word=giant pos=noun n=2 gloss="a person of exceptional importance and reputation" synonym=colossus synonym=behemoth synonym=heavyweight synonym=titan is_a="important person" core.source="wordnet 3.1"
@k.words.giant.noun.3 k.words.sense word=giant pos=noun n=3 gloss="an unusually large enterprise" is_a=enterprise core.source="wordnet 3.1"
