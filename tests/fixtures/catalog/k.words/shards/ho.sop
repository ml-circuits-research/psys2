@k.words.horse.noun.1 k.words.sense word=horse pos=noun n=1 gloss="solid-hoofed herbivorous quadruped domesticated since prehistoric times" synonym="Equus caballus" is_a=equine core.source="wordnet 3.1"
@k.words.horse.noun.2 k.words.sense word=horse pos=noun n=2 gloss="a padded gymnastic apparatus on legs" synonym="gymnastic horse" is_a="gymnastic apparatus" core.source="wordnet 3.1"
@k.words.horse.noun.3 k.words.sense word=horse pos=noun n=3 gloss="troops trained to fight on horseback" synonym=cavalry synonym="horse cavalry" is_a="military personnel" core.source="wordnet 3.1"
@k.words.horse.verb.1 k.words.sense word=horse pos=verb n=1 gloss="provide with a horse or horses" is_a=provide core.source="wordnet 3.1"
@k.words.hour.noun.1 k.words.sense word=hour pos=noun n=1 gloss="a period of time equal to 1/24th of a day" synonym=hr synonym="60 minutes" is_a="time unit" part_of=day core.source="wordnet 3.1"
@k.words.hour.noun.2 k.words.sense word=hour pos=noun n=2 gloss="clock time" synonym="time of day" is_a="clock time" core.source="wordnet 3.1"
@k.words.hour.noun.3 k.words.sense word=hour pos=noun n=3 gloss="a special and memorable period" is_a="time period" core.source="wordnet 3.1"
@k.words.house.noun.1 k.words.sense word=house pos=noun n=1 gloss="a dwelling that serves as living quarters for one or more families" is_a=dwelling is_a=building core.source="wordnet 3.1"
@k.words.house.noun.2 k.words.sense word=house pos=noun n=2 gloss="the members of a business organization that owns or operates one or more establishments" synonym=firm synonym="business firm" is_a=business core.source="wordnet 3.1"
@k.words.house.noun.3 k.words.sense word=house pos=noun n=3 gloss="the members of a religious community living together" is_a=community core.source="wordnet 3.1"
@k.words.house.verb.1 k.words.sense word=house pos=verb n=1 gloss="contain or cover" is_a=accommodate core.source="wordnet 3.1"
