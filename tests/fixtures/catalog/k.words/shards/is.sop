# script: tools/import/wordnet.mjs

@k.words.island.noun.1 k.words.sense word=island pos=noun n=1 gloss="a land mass (smaller than a continent) that is surrounded by water" is_a=land core.source="wordnet 3.1"
@k.words.island.noun.2 k.words.sense word=island pos=noun n=2 gloss="a zone or area resembling an island" is_a=zone core.source="wordnet 3.1"
