# script: tools/import/wordnet.mjs

@k.words.july.noun.1 k.words.sense word=July pos=noun n=1 gloss="the month following June and preceding August" is_a="Gregorian calendar month" part_of="Gregorian calendar" core.source="wordnet 3.1"
@k.words.jupiter.noun.1 k.words.sense word=Jupiter pos=noun n=1 gloss="the largest planet and the 5th from the sun; has many satellites and is one of the brightest objects in the night sky" instance_of="Jovian planet" instance_of="superior planet" instance_of="outer planet" core.source="wordnet 3.1"
@k.words.jupiter.noun.2 k.words.sense word=Jupiter pos=noun n=2 gloss="(Roman mythology) supreme god of Romans; counterpart of Greek Zeus" synonym=Jove instance_of="Roman deity" core.source="wordnet 3.1"
