@k.words.mansion.noun.1 k.words.sense word=mansion pos=noun n=1 gloss="a large and stately house" is_a=house core.source="fixture 1"
@k.words.make.noun.1 k.words.sense word=make pos=noun n=1 gloss="a recognizable kind" synonym=brand is_a=kind core.source="wordnet 3.1"
@k.words.make.noun.2 k.words.sense word=make pos=noun n=2 gloss="the act of mixing cards haphazardly" synonym=shuffle synonym=shuffling is_a=reordering part_of="card game" core.source="wordnet 3.1"
@k.words.make.verb.1 k.words.sense word=make pos=verb n=1 gloss="engage in" synonym=do core.source="wordnet 3.1"
@k.words.make.verb.2 k.words.sense word=make pos=verb n=2 gloss="give certain properties to something" synonym=get is_a=change core.source="wordnet 3.1"
@k.words.make.verb.3 k.words.sense word=make pos=verb n=3 gloss="make or cause to be or to become" synonym=create core.source="wordnet 3.1"
@k.words.march.noun.1 k.words.sense word=March pos=noun n=1 gloss="the month following February and preceding April" synonym=Mar is_a="Gregorian calendar month" part_of="Gregorian calendar" core.source="wordnet 3.1"
@k.words.march.noun.2 k.words.sense word=march pos=noun n=2 gloss="the act of marching; walking with regular steps (especially in a procession of some kind)" synonym=marching is_a=walk core.source="wordnet 3.1"
@k.words.march.noun.3 k.words.sense word=march pos=noun n=3 gloss="a steady advance" is_a=progress core.source="wordnet 3.1"
@k.words.march.verb.1 k.words.sense word=march pos=verb n=1 gloss="march in a procession" synonym=process is_a=walk core.source="wordnet 3.1"
@k.words.march.verb.2 k.words.sense word=march pos=verb n=2 gloss="force to march" is_a=walk core.source="wordnet 3.1"
@k.words.march.verb.3 k.words.sense word=march pos=verb n=3 gloss="walk fast, with regular or measured steps; walk with a stride" is_a=walk core.source="wordnet 3.1"
@k.words.mars.noun.1 k.words.sense word=Mars pos=noun n=1 gloss="a small reddish planet that is the 4th from the sun and is periodically visible to the naked eye; minerals rich in iron cover its surface and are responsible for its characteristic color" synonym="Red Planet" instance_of="terrestrial planet" instance_of="superior planet" core.source="wordnet 3.1"
@k.words.mars.noun.2 k.words.sense word=Mars pos=noun n=2 gloss="(Roman mythology) Roman god of war and agriculture; father of Romulus and Remus; counterpart of Greek Ares" instance_of="Roman deity" core.source="wordnet 3.1"
@k.words.matrix.noun.1 k.words.sense word=matrix pos=noun n=1 gloss="(mathematics) a rectangular array of quantities or expressions set out by rows and columns; treated as a single element and manipulated according to rules" is_a=array core.source="wordnet 3.1"
@k.words.matrix.noun.2 k.words.sense word=matrix pos=noun n=2 gloss="(geology) a mass of fine-grained rock in which fossils, crystals, or gems are embedded" is_a=rock core.source="wordnet 3.1"
@k.words.matrix.noun.3 k.words.sense word=matrix pos=noun n=3 gloss="an enclosure within which something originates or develops (from the Latin for womb)" is_a=enclosure core.source="wordnet 3.1"
@k.words.may.noun.1 k.words.sense word=May pos=noun n=1 gloss="the month following April and preceding June" is_a="Gregorian calendar month" part_of="Gregorian calendar" core.source="wordnet 3.1"
@k.words.may.noun.2 k.words.sense word=may pos=noun n=2 gloss="thorny Eurasian shrub of small tree having dense clusters of white to scarlet flowers followed by deep red berries; established as an escape in eastern North America" synonym=whitethorn synonym="English hawthorn" synonym="Crataegus laevigata" synonym="Crataegus oxycantha" is_a=hawthorn core.source="wordnet 3.1"
