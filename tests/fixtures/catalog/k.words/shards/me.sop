# k.words/shards/me: noun and verb senses of the words from "me" to "mexico" (first letters "me").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.mean.noun.1 k.words.sense word=mean pos=noun n=1 gloss="an average of n numbers computed by adding some function of the numbers and dividing by some function of n" synonym="mean value" is_a=average core.source="wordnet 3.1"
@k.words.mean.verb.1 k.words.sense word=mean pos=verb n=1 gloss="mean or intend to express or convey" synonym=intend is_a=convey core.source="wordnet 3.1"
@k.words.mean.verb.2 k.words.sense word=mean pos=verb n=2 gloss="have as a logical consequence" synonym=entail synonym=imply is_a=necessitate core.source="wordnet 3.1"
@k.words.mean.verb.3 k.words.sense word=mean pos=verb n=3 gloss="denote or connote" synonym=intend synonym=signify synonym="stand for" core.source="wordnet 3.1"
@k.words.mercury.noun.1 k.words.sense word=mercury pos=noun n=1 gloss="a heavy silvery toxic univalent and bivalent metallic element; the only metal that is liquid at ordinary temperatures" synonym=quicksilver synonym=hydrargyrum synonym=Hg synonym="atomic number 80" is_a="metallic element" core.source="wordnet 3.1"
@k.words.mercury.noun.2 k.words.sense word=Mercury pos=noun n=2 gloss="(Roman mythology) messenger of Jupiter and god of commerce; counterpart of Greek Hermes" instance_of="Roman deity" core.source="wordnet 3.1"
@k.words.mercury.noun.3 k.words.sense word=Mercury pos=noun n=3 gloss="the smallest planet and the nearest to the sun" instance_of="terrestrial planet" instance_of="inferior planet" core.source="wordnet 3.1"
@k.words.metre.noun.1 k.words.sense word=metre pos=noun n=1 gloss="the basic unit of length adopted under the Systeme International d'Unites (approximately 1.094 yards)" synonym=meter synonym=m is_a="metric linear unit" part_of=decameter core.source="wordnet 3.1"
@k.words.metre.noun.2 k.words.sense word=metre pos=noun n=2 gloss="(prosody) the accent in a metrical foot of verse" synonym=meter synonym=measure synonym=beat synonym=cadence is_a="poetic rhythm" core.source="wordnet 3.1"
@k.words.metre.noun.3 k.words.sense word=metre pos=noun n=3 gloss="rhythm as given by division into parts of equal duration" synonym=meter synonym=time is_a=rhythmicity core.source="wordnet 3.1"
