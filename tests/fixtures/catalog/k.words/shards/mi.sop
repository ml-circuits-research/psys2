@k.words.mile.noun.1 k.words.sense word=mile pos=noun n=1 gloss="a unit of length equal to 1,760 yards or 5,280 feet; exactly 1609.344 meters" synonym="statute mile" synonym="stat mi" synonym="land mile" synonym="international mile" synonym=mi is_a="linear unit" part_of=league core.source="wordnet 3.1"
@k.words.mile.noun.2 k.words.sense word=mile pos=noun n=2 gloss="a unit of length used in navigation; exactly 1,852 meters; historically based on the distance spanned by one minute of arc in latitude" synonym="nautical mile" synonym=mi synonym="naut mi" synonym="international nautical mile" synonym="air mile" is_a="nautical linear unit" core.source="wordnet 3.1"
@k.words.mile.noun.3 k.words.sense word=mile pos=noun n=3 gloss="a large distance" is_a="large indefinite quantity" core.source="wordnet 3.1"
@k.words.milk.noun.1 k.words.sense word=milk pos=noun n=1 gloss="a white nutritious liquid secreted by mammals and used as food by human beings" is_a="dairy product" is_a=beverage core.source="wordnet 3.1"
@k.words.milk.noun.2 k.words.sense word=milk pos=noun n=2 gloss="produced by mammary glands of female mammals for feeding their young" is_a="liquid body substance" is_a=nutriment core.source="wordnet 3.1"
@k.words.milk.noun.3 k.words.sense word=Milk pos=noun n=3 gloss="a river that rises in the Rockies in northwestern Montana and flows eastward to become a tributary of the Missouri River" synonym="Milk River" instance_of=river part_of=Montana core.source="wordnet 3.1"
@k.words.milk.verb.1 k.words.sense word=milk pos=verb n=1 gloss="take milk from female mammals" is_a=draw core.source="wordnet 3.1"
@k.words.milk.verb.2 k.words.sense word=milk pos=verb n=2 gloss="exploit as much as possible" is_a=exploit core.source="wordnet 3.1"
@k.words.milk.verb.3 k.words.sense word=milk pos=verb n=3 gloss="add milk to" is_a=add core.source="wordnet 3.1"
