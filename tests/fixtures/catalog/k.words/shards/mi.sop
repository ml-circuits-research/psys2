@k.words.minute.noun.2 k.words.sense word=minute pos=noun n=2 gloss="an indefinitely short time" synonym=moment synonym=mo synonym=second synonym=bit is_a=time core.source="wordnet 3.1"
@k.words.minute.noun.3 k.words.sense word=minute pos=noun n=3 gloss="a particular point in time" synonym=moment synonym=second synonym=instant is_a=point core.source="wordnet 3.1"
