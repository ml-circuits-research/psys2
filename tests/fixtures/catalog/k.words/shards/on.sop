@k.words.one.noun.1 k.words.sense word=one pos=noun n=1 gloss="the smallest whole number or a numeral representing this number" synonym=1 synonym=I synonym=ace synonym=single synonym=unity is_a=digit kind_of=digit kind_of=integer kind_of=number kind_of="definite quantity" kind_of=measure kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.one.noun.2 k.words.sense word=one pos=noun n=2 gloss="a single person or thing" is_a=unit kind_of=unit kind_of=whole kind_of=concept kind_of=idea kind_of=content kind_of=cognition kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.one.adjective.1 k.words.sense word=one pos=adjective n=1 gloss="used of a single unit or thing; not two or more" synonym=1 synonym=i synonym=ane near_opposite=ordinal core.source="wordnet 3.1"
@k.words.one.adjective.2 k.words.sense word=one pos=adjective n=2 gloss="having the indivisible character of a unit" synonym=unitary near_opposite=divided core.source="wordnet 3.1"
