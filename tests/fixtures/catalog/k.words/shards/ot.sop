@k.words.other.adjective.1 k.words.sense word=other pos=adjective n=1 gloss="not the same one or ones already mentioned or implied" opposite=same core.source="wordnet 3.1"
@k.words.other.adjective.2 k.words.sense word=other pos=adjective n=2 gloss="recently past" near_opposite=present near_opposite=future core.source="wordnet 3.1"
