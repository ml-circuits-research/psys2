# k.words/shards/pl: noun and verb senses of the words from "place" to "plymouth" (first letters "pl").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.plain.noun.1 k.words.sense word=plain pos=noun n=1 gloss="extensive tract of level open land" synonym=field synonym=champaign is_a=land core.source="wordnet 3.1"
@k.words.plain.noun.2 k.words.sense word=plain pos=noun n=2 gloss="a basic knitting stitch made by putting the needle through the front of the stitch from the lefthand side" synonym=knit synonym="knit stitch" synonym="plain stitch" is_a="knitting stitch" core.source="wordnet 3.1"
@k.words.plain.verb.1 k.words.sense word=plain pos=verb n=1 gloss="express complaints, discontent, displeasure, or unhappiness" synonym=complain synonym=kick synonym="sound off" synonym=quetch synonym=kvetch core.source="wordnet 3.1"
@k.words.plane.noun.1 k.words.sense word=plane pos=noun n=1 gloss="an aircraft that has a fixed wing and is powered by propellers or jets" synonym=airplane synonym=aeroplane is_a="heavier-than-air craft" core.source="wordnet 3.1"
@k.words.plane.noun.2 k.words.sense word=plane pos=noun n=2 gloss="(mathematics) an unbounded two-dimensional shape" synonym=sheet is_a=shape core.source="wordnet 3.1"
@k.words.plane.noun.3 k.words.sense word=plane pos=noun n=3 gloss="a level of existence or development" is_a=degree core.source="wordnet 3.1"
@k.words.plane.verb.1 k.words.sense word=plane pos=verb n=1 gloss="cut or remove with or as if with a plane" synonym=shave is_a=cut core.source="wordnet 3.1"
@k.words.plane.verb.2 k.words.sense word=plane pos=verb n=2 gloss="travel on the surface of water" synonym=skim is_a=glide core.source="wordnet 3.1"
@k.words.plane.verb.3 k.words.sense word=plane pos=verb n=3 gloss="make even or smooth, with or as with a carpenter's plane" is_a=smooth core.source="wordnet 3.1"
@k.words.planet.noun.1 k.words.sense word=planet pos=noun n=1 gloss="(astronomy) any of the nine large celestial bodies in the solar system that revolve around the sun and shine by reflected light; Mercury, Venus, Earth, Mars, Jupiter, Saturn, Uranus, Neptune, and Pluto in order of their proximity to the sun; viewed from the constellation Hercules, all the planets rotate around the sun in a counterclockwise direction" synonym="major planet" is_a="celestial body" core.source="wordnet 3.1"
@k.words.planet.noun.2 k.words.sense word=planet pos=noun n=2 gloss="a person who follows or serves another" synonym=satellite is_a=follower core.source="wordnet 3.1"
@k.words.planet.noun.3 k.words.sense word=planet pos=noun n=3 gloss="any celestial body (other than comets or satellites) that revolves around a star" is_a="celestial body" core.source="wordnet 3.1"
@k.words.plant.noun.1 k.words.sense word=plant pos=noun n=1 gloss="buildings for carrying on industrial labor" synonym=works synonym="industrial plant" is_a="building complex" core.source="wordnet 3.1"
@k.words.plant.noun.2 k.words.sense word=plant pos=noun n=2 gloss="(botany) a living organism lacking the power of locomotion" synonym=flora synonym="plant life" is_a=organism core.source="wordnet 3.1"
@k.words.plant.noun.3 k.words.sense word=plant pos=noun n=3 gloss="an actor situated in the audience whose acting is rehearsed but seems spontaneous to the audience" is_a=actor core.source="wordnet 3.1"
@k.words.plant.verb.1 k.words.sense word=plant pos=verb n=1 gloss="put or set (seeds, seedlings, or plants) into the ground" synonym=set is_a=put core.source="wordnet 3.1"
@k.words.plant.verb.2 k.words.sense word=plant pos=verb n=2 gloss="fix or set securely or deeply" synonym=implant synonym=engraft synonym=embed synonym=imbed is_a=insert core.source="wordnet 3.1"
@k.words.plant.verb.3 k.words.sense word=plant pos=verb n=3 gloss="set up or lay the groundwork for" synonym=establish synonym=found synonym=constitute synonym=institute is_a=initiate core.source="wordnet 3.1"
