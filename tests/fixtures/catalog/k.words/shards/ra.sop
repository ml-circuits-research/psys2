@k.words.rabbit.noun.1 k.words.sense word=rabbit pos=noun n=1 gloss="any of various burrowing animals of the family Leporidae having long ears and short tails; some domesticated and raised for pets or food" synonym=coney synonym=cony is_a=leporid core.source="wordnet 3.1"
@k.words.rabbit.noun.2 k.words.sense word=rabbit pos=noun n=2 gloss="the fur of a rabbit" synonym=lapin is_a=fur core.source="wordnet 3.1"
@k.words.rabbit.noun.3 k.words.sense word=rabbit pos=noun n=3 gloss="flesh of any of various rabbits or hares (wild or domesticated) eaten as food" synonym=hare is_a=game part_of="wood rabbit" part_of="European rabbit" part_of=hare core.source="wordnet 3.1"
@k.words.rabbit.verb.1 k.words.sense word=rabbit pos=verb n=1 gloss="hunt rabbits" is_a=hunt core.source="wordnet 3.1"
