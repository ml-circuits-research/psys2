@k.words.red.noun.1 k.words.sense word=red pos=noun n=1 gloss="red color or pigment; the chromatic color resembling the hue of blood" synonym=redness is_a="chromatic color" core.source="wordnet 3.1"
@k.words.red.noun.2 k.words.sense word=Red pos=noun n=2 gloss="a tributary of the Mississippi River that flows eastward from Texas along the southern boundary of Oklahoma and through Louisiana" synonym="Red River" instance_of=river part_of=Texas part_of=Oklahoma part_of=Louisiana core.source="wordnet 3.1"
@k.words.red.noun.3 k.words.sense word=red pos=noun n=3 gloss="emotionally charged terms used to refer to extreme radicals or revolutionaries" synonym=Bolshevik synonym=Marxist synonym=bolshie synonym=bolshy is_a=radical core.source="wordnet 3.1"
