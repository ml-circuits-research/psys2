@k.words.run.verb.1 k.words.sense word=run pos=verb n=1 gloss="move fast by using one's feet, with one foot off the ground at any given time" is_a="travel rapidly" core.source="wordnet 3.1"
@k.words.run.verb.2 k.words.sense word=run pos=verb n=2 gloss="flee; take to one's heels; cut and run" synonym=scat synonym=scarper synonym="turn tail" synonym=lam synonym="run away" synonym="hightail it" synonym=bunk synonym="head for the hills" synonym="take to the woods" synonym=escape synonym="fly the coop" synonym="break away" is_a=leave core.source="wordnet 3.1"
