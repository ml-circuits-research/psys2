@k.words.sahara.noun.1 k.words.sense word=Sahara pos=noun n=1 gloss="the world's largest desert (3,500,000 square miles) in northern Africa" synonym="Sahara Desert" instance_of=desert part_of=Africa core.source="wordnet 3.1"
@k.words.saturn.noun.1 k.words.sense word=Saturn pos=noun n=1 gloss="a giant planet that is surrounded by three planar concentric rings of ice particles; the 6th planet from the sun" instance_of="Jovian planet" instance_of="superior planet" instance_of="outer planet" core.source="wordnet 3.1"
@k.words.saturn.noun.2 k.words.sense word=Saturn pos=noun n=2 gloss="(Roman mythology) god of agriculture and vegetation; counterpart of Greek Cronus" instance_of="Roman deity" core.source="wordnet 3.1"
