@k.words.shell.noun.1 k.words.sense word=shell pos=noun n=1 gloss="ammunition consisting of a cylindrical metal casing containing an explosive charge and a projectile; fired from a large gun" is_a=ammunition core.source="wordnet 3.1"
@k.words.shell.noun.2 k.words.sense word=shell pos=noun n=2 gloss="the material that forms the hard outer covering of many animals" is_a="animal material" core.source="wordnet 3.1"
@k.words.shell.noun.3 k.words.sense word=shell pos=noun n=3 gloss="hard outer covering or case of certain organisms such as arthropods and turtles" synonym=carapace synonym=cuticle synonym=shield is_a=scute part_of=mollusk part_of=arthropod part_of=turtle core.source="wordnet 3.1"
@k.words.shell.verb.1 k.words.sense word=shell pos=verb n=1 gloss="use explosives on" synonym=blast is_a=bombard core.source="wordnet 3.1"
@k.words.shell.verb.2 k.words.sense word=shell pos=verb n=2 gloss="create by using explosives" synonym=blast is_a=make core.source="wordnet 3.1"
@k.words.shell.verb.3 k.words.sense word=shell pos=verb n=3 gloss="fall out of the pod or husk" is_a=emerge core.source="wordnet 3.1"
@k.words.show.noun.1 k.words.sense word=show pos=noun n=1 gloss="the act of publicly exhibiting or entertaining" is_a=entertainment core.source="wordnet 3.1"
@k.words.show.noun.2 k.words.sense word=show pos=noun n=2 gloss="something intended to communicate a particular impression" synonym=display is_a=demonstration core.source="wordnet 3.1"
@k.words.show.noun.3 k.words.sense word=show pos=noun n=3 gloss="a social event involving a public performance or entertainment" is_a="social event" core.source="wordnet 3.1"
@k.words.show.verb.1 k.words.sense word=show pos=verb n=1 gloss="give an exhibition of to an interested audience" synonym=demo synonym=exhibit synonym=present synonym=demonstrate is_a=show core.source="wordnet 3.1"
@k.words.show.verb.2 k.words.sense word=show pos=verb n=2 gloss="establish the validity of something, as by an example, explanation or experiment" synonym=prove synonym=demonstrate synonym=establish synonym=shew is_a=confirm core.source="wordnet 3.1"
@k.words.show.verb.3 k.words.sense word=show pos=verb n=3 gloss="provide evidence for" synonym=testify synonym="bear witness" synonym=prove synonym=evidence is_a=inform core.source="wordnet 3.1"
