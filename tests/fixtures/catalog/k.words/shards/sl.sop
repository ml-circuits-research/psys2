@k.words.sleep.noun.1 k.words.sense word=sleep pos=noun n=1 gloss="a natural and periodic state of rest during which consciousness of the world is suspended" synonym=slumber is_a="physical condition" kind_of="physical condition" kind_of=condition kind_of=state kind_of=attribute kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.sleep.noun.2 k.words.sense word=sleep pos=noun n=2 gloss="a torpid state resembling deep sleep" synonym=sopor is_a="physical condition" kind_of="physical condition" kind_of=condition kind_of=state kind_of=attribute kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.sleep.noun.3 k.words.sense word=sleep pos=noun n=3 gloss="a period of time spent sleeping" synonym=nap is_a="time period" kind_of="time period" kind_of="fundamental quantity" kind_of=measure kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.sleep.verb.1 k.words.sense word=sleep pos=verb n=1 gloss="be asleep" synonym=kip synonym=slumber synonym="log Z's" synonym="catch some Z's" is_a=rest opposite=wake kind_of=rest kind_of=recumb kind_of=lie core.source="wordnet 3.1"
