@k.words.space.noun.1 k.words.sense word=space pos=noun n=1 gloss="the unlimited expanse in which everything is located" synonym=infinite is_a=attribute core.source="wordnet 3.1"
@k.words.space.noun.2 k.words.sense word=space pos=noun n=2 gloss="an empty area (usually bounded in some way between things)" is_a="amorphous shape" is_a=location core.source="wordnet 3.1"
