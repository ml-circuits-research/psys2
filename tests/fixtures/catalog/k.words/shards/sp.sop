@k.words.spain.noun.1 k.words.sense word=Spain pos=noun n=1 gloss="a parliamentary monarchy in southwestern Europe on the Iberian Peninsula; a former colonial power" synonym="Kingdom of Spain" synonym=Espana instance_of="European country" part_of="Iberian Peninsula" part_of=Europe core.source="wordnet 3.1"
@k.words.spider.noun.1 k.words.sense word=spider pos=noun n=1 gloss="predatory arachnid with eight legs, two poison fangs, two feelers, and usually two silk-spinning organs at the back end of the body; they spin silk to make cocoons for eggs or traps for prey" is_a=arachnid core.source="wordnet 3.1"
@k.words.spider.noun.2 k.words.sense word=spider pos=noun n=2 gloss="a computer program that prowls the internet looking for publicly accessible resources that can be added to a database; the database can then be searched with a search engine" synonym=wanderer is_a=program core.source="wordnet 3.1"
@k.words.spider.noun.3 k.words.sense word=spider pos=noun n=3 gloss="a skillet made of cast iron" is_a="frying pan" core.source="wordnet 3.1"
