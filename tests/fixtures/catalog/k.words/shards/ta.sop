# k.words/shards/ta: noun and verb senses of the words from "ta" to "taylor" (first letters "ta").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.table.noun.1 k.words.sense word=table pos=noun n=1 gloss="a set of data arranged in rows and columns" synonym="tabular array" is_a=array core.source="wordnet 3.1"
@k.words.table.noun.2 k.words.sense word=table pos=noun n=2 gloss="a piece of furniture having a smooth flat top that is usually supported by one or more vertical legs" is_a=furniture core.source="wordnet 3.1"
@k.words.table.noun.3 k.words.sense word=table pos=noun n=3 gloss="a piece of furniture with tableware for a meal laid out on it" is_a=furniture core.source="wordnet 3.1"
@k.words.table.verb.1 k.words.sense word=table pos=verb n=1 gloss="hold back to a later time" synonym=postpone synonym=prorogue synonym="hold over" synonym="put over" synonym=shelve synonym="set back" synonym=defer synonym=remit synonym="put off" is_a=delay core.source="wordnet 3.1"
@k.words.table.verb.2 k.words.sense word=table pos=verb n=2 gloss="arrange or enter in tabular form" synonym=tabularize synonym=tabularise synonym=tabulate is_a=arrange core.source="wordnet 3.1"
@k.words.tail.noun.1 k.words.sense word=tail pos=noun n=1 gloss="the posterior part of the body of a vertebrate especially when elongated and extending beyond the trunk or main part of the body" is_a=process part_of=vertebrate core.source="wordnet 3.1"
@k.words.tail.noun.2 k.words.sense word=tail pos=noun n=2 gloss="the time of the last part of something" synonym="fag end" synonym="tail end" is_a=end core.source="wordnet 3.1"
@k.words.tail.noun.3 k.words.sense word=tail pos=noun n=3 gloss="any projection that resembles the tail of an animal" synonym="tail end" is_a=projection core.source="wordnet 3.1"
@k.words.tail.verb.1 k.words.sense word=tail pos=verb n=1 gloss="go after with the intent to catch" synonym=chase synonym="chase after" synonym=trail synonym=tag synonym="give chase" synonym=dog synonym="go after" synonym=track is_a=pursue core.source="wordnet 3.1"
@k.words.tail.verb.2 k.words.sense word=tail pos=verb n=2 gloss="remove or shorten the tail of an animal" synonym=dock synonym=bob is_a=cut core.source="wordnet 3.1"
@k.words.tail.verb.3 k.words.sense word=tail pos=verb n=3 gloss="remove the stalk of fruits or berries" is_a=top core.source="wordnet 3.1"
@k.words.talk.noun.1 k.words.sense word=talk pos=noun n=1 gloss="an exchange of ideas via conversation" synonym=talking is_a=conversation core.source="wordnet 3.1"
@k.words.talk.noun.2 k.words.sense word=talk pos=noun n=2 gloss="discussion; (`talk about' is a less formal alternative for `discussion of')" is_a=discussion core.source="wordnet 3.1"
@k.words.talk.noun.3 k.words.sense word=talk pos=noun n=3 gloss="the act of giving a talk to an audience" is_a=lecture core.source="wordnet 3.1"
@k.words.talk.verb.1 k.words.sense word=talk pos=verb n=1 gloss="exchange thoughts; talk with" synonym=speak is_a=communicate core.source="wordnet 3.1"
@k.words.talk.verb.2 k.words.sense word=talk pos=verb n=2 gloss="express in speech" synonym=speak synonym=utter synonym=mouth synonym=verbalize synonym=verbalise is_a=communicate core.source="wordnet 3.1"
@k.words.talk.verb.3 k.words.sense word=talk pos=verb n=3 gloss="use language" synonym=speak is_a=communicate core.source="wordnet 3.1"
