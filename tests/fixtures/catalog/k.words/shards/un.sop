@k.words.undo.verb.1 k.words.sense word=undo pos=verb n=1 gloss="cancel, annul, or reverse an action or its effect" is_a="change by reversal" core.source="wordnet 3.1"
@k.words.undo.verb.2 k.words.sense word=undo pos=verb n=2 gloss="deprive of certain characteristics" synonym=unmake core.source="wordnet 3.1"
@k.words.undo.verb.3 k.words.sense word=undo pos=verb n=3 gloss="cause the ruin or downfall of" is_a=ruin core.source="wordnet 3.1"
