@k.words.windows.noun.1 k.words.sense word=Windows pos=noun n=1 gloss="(trademark) an operating system with a graphical user interface" is_a="operating system" core.source="wordnet 3.1"
@k.words.winter.noun.1 k.words.sense word=winter pos=noun n=1 gloss="the coldest season of the year; in the northern hemisphere it extends from the winter solstice to the vernal equinox" synonym=wintertime is_a=season core.source="wordnet 3.1"
@k.words.winter.verb.1 k.words.sense word=winter pos=verb n=1 gloss="spend the winter" synonym=overwinter is_a=spend core.source="wordnet 3.1"
