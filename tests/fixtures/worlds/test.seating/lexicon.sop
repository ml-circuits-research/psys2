@gen.test.seating.note core.note
    text="Generated from schema.sop by scripts/build-schema-world.mjs (spec 21). Never edited by hand; tests/acts.test.mjs fails when it is stale."

@lex.test.seating.kinds core.lexicon
    class=noun
    doc="Kinds of things of this world (from schema.sop)"
    word=table
    word=tables
    word=guest
    word=guests
    word=person
    word=people

@lex.test.seating.attrs core.lexicon
    class=modifier
    doc="Attributes (from schema.sop)"
    word=seats
    word=seat
    word=colour
    word=color

@lex.test.seating.values core.lexicon
    class=modifier
    doc="Values the attributes take (from schema.sop; a colour attribute with no listed values takes the shared colour lexicon)"
    extends=$lex.lang.colour


@lex.test.seating.more core.lexicon
    class=modifier
    doc="Comparatives that mean more of an attribute"
    word=bigger

@lex.test.seating.less core.lexicon
    class=modifier
    doc="Comparatives that mean less of an attribute"
    word=smaller
