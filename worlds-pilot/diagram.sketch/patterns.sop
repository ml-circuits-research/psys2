@pat.diagram.sketch.place.dir core.pattern
    match="[$lang.lead.polite]? [move|put|bring|push|pull|take|shift|raise|lower|make] [$acts.det]? {thing:words} {rel:lex.acts.dir}"
    emit="@{_} core.request action=diagram.sketch.place arg.thing=\"{thing}\" arg.rel=\"{rel}\" arg.text=\"{segment}\""
