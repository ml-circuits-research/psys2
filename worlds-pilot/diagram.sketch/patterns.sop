@gen.diagram.sketch.note core.note
    text="Generated from schema.sop by scripts/build-schema-world.mjs (spec 21). Never edited by hand; tests/acts.test.mjs fails when it is stale."

@pat.diagram.sketch.make core.pattern
    match="[$lang.lead.polite]? [$acts.verb.make] [$acts.det]? {thing:rest}"
    emit="@{_} core.request action=diagram.sketch.make arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=request
    priority=10
    tabPriority=18
    example="Add a circle."

@pat.diagram.sketch.make.n core.pattern
    match="[$lang.lead.polite]? [$acts.verb.make] {amount:number} {thing:rest}"
    emit="@{_} core.request action=diagram.sketch.make arg.amount=\"{amount}\" arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=request
    priority=12
    tabPriority=20
    example="Add 3 circles."

@pat.diagram.sketch.remove core.pattern
    match="[$lang.lead.polite]? [$acts.verb.remove] [$acts.det]? {thing:rest}"
    emit="@{_} core.request action=diagram.sketch.remove arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=request
    priority=10
    tabPriority=18
    example="Remove the guest Ann."

@pat.diagram.sketch.remove.out core.pattern
    match="[$lang.lead.polite]? [kick|throw|take|send|get|put] [$acts.det]? {thing:words} [out|away|off_the_list]"
    emit="@{_} core.request action=diagram.sketch.remove arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=request
    priority=11
    tabPriority=19
    example="Kick the guest Ann out."

@pat.diagram.sketch.change.of core.pattern
    match="[$lang.lead.polite]? [$acts.verb.set] [$acts.det]? {attribute:lex.diagram.sketch.attrs} of [$acts.det]? {thing:words} [to|be|as|into]? [$acts.det]? {value:rest}"
    emit="@{_} core.request action=diagram.sketch.change arg.mode=set arg.attribute=\"{attribute}\" arg.thing=\"{thing}\" arg.value=\"{value}\" arg.text=\"{segment}\""
    kind=request
    priority=14
    tabPriority=22
    example="Change the colour of circle to red."

@pat.diagram.sketch.change.attr core.pattern
    match="[$lang.lead.polite]? [$acts.verb.set] [$acts.det]? {thing:words} {attribute:lex.diagram.sketch.attrs} [to|be|as|into] [$acts.det]? {value:rest}"
    emit="@{_} core.request action=diagram.sketch.change arg.mode=set arg.thing=\"{thing}\" arg.attribute=\"{attribute}\" arg.value=\"{value}\" arg.text=\"{segment}\""
