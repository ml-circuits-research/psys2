@pat.diagram.sketch.ask.what core.pattern
    match="[what|which] [is|are] [$acts.det]? {attribute:lex.diagram.sketch.attrs} of [$acts.det]? {thing:rest}"
    emit="@{_} core.request action=diagram.sketch.ask arg.mode=what arg.attribute=\"{attribute}\" arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=question
    priority=12
    tabPriority=20
    example="What is the colour of circle?"

@pat.diagram.sketch.ask.what.is core.pattern
    match="[what|which] {attribute:lex.diagram.sketch.attrs} [is|are] [$acts.det]? {thing:rest}"
    emit="@{_} core.request action=diagram.sketch.ask arg.mode=what arg.attribute=\"{attribute}\" arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=question
    priority=12
    tabPriority=20
    example="What colour is circle?"

@pat.diagram.sketch.change.should core.pattern
    match="[$acts.det]? {thing:words} [should|must|has_to|needs_to] [be|become|turn] {value:lex.diagram.sketch.values}"
    emit="@{_} core.request action=diagram.sketch.change arg.mode=set arg.thing=\"{thing}\" arg.value=\"{value}\" arg.text=\"{segment}\""
    kind=request
    priority=12
    tabPriority=20
    example="circle should be blue."

@pat.diagram.sketch.change.needs core.pattern
    match="[$lang.lead.polite]? [i_want|i_need|make|let|give]? [$acts.det]? {thing:words} [needs|to_have|should_have|must_have|has|gets] {value:number} {attribute:lex.diagram.sketch.attrs}"
    emit="@{_} core.request action=diagram.sketch.change arg.mode=set arg.thing=\"{thing}\" arg.value=\"{value}\" arg.attribute=\"{attribute}\" arg.text=\"{segment}\""
    kind=request
    priority=12
    tabPriority=20
    example="circle needs 6 seats."

@pat.diagram.sketch.ask.count.attr core.pattern
    match="how_many {attribute:lex.diagram.sketch.attrs} [does|do|has|have] [$acts.det]? {thing:words} [have|has|got]?"
    emit="@{_} core.request action=diagram.sketch.ask arg.mode=what arg.attribute=\"{attribute}\" arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=question
    priority=14
    tabPriority=22
    example="How many seats does circle have?"

@pat.diagram.sketch.ask.count core.pattern
    match="how_many {thing:words} [are|do_i_have|have_i_got|is]? [there]?"
    emit="@{_} core.request action=diagram.sketch.ask arg.mode=count arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=question
    priority=12
    tabPriority=20
    example="How many circles are there?"

@pat.diagram.sketch.ask.why core.pattern
