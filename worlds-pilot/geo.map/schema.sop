@map acts.schema
    noun="map"
    doc="The map as a schema (spec 21 section 12): places (any place of k.geo, found by lookup), pins, routes, labels and the view of the map; a place has a name, a colour (highlighted), a capital, a population ...; the view has a zoom and a centre. The renderer (Leaflet over the offline outlines, docs/webchat/ui/tabs/map.mjs), the projection and zoom fitting, the distances and the geolocation stay the world's own (map.mjs); the places come from the catalog (places.mjs). Hand-built platform fixture, not produced by the C1 workflow."
    hooks=hooks.mjs
    own=showPlace:geo.show
    own=coords:geo.coords
    own=zoom:geo.zoom
    own=zoomTo:geo.zoomTo
    own=pan:geo.pan
    own=world:geo.world
    own=reset:geo.reset
    own=markHere:geo.markHere
    own=markSet:geo.markSet
    own=layer:geo.layer
    own=locate:geo.locate
    own=here:geo.here
    own=distance:geo.distance
    own=distanceFrom:geo.distanceFrom
    own=compare:geo.compare
    own=compareYN:geo.compareYN
    own=borderYN:geo.borderYN
    own=isIn:geo.isIn
    own=isCapital:geo.isCapital
    own=capitalOfWhich:geo.capitalOfWhich
    own=superlative:geo.superlative
    own=listOp:geo.listOp
    own=count:geo.count
    own=info:geo.info
    own=markers:geo.markers
    own=highlights:geo.highlights
    own=describe:geo.describe
    own=askPlace:geo.askPlace
    own=unknown:geo.unknown
    own=view:geo.map.view
    own=adopt:geo.map.adopt
    own=mapUndo:geo.undo
    own=mapRedo:geo.redo
    sample=pin
    boost=5
    say=yes
    list=yes
    rel=yes
    facts=yes
    clear=yes
    opencolour=yes
    acts=make
    acts=remove
    acts=change
    acts=place
    acts=pick
    acts=ask
    acts=send
    acts=undo
    acts=redo
    limit.items=200
    limit.history=30

@map.place acts.kind
    plural=places
    named=yes
    in=view
    word=country
    word=countries
    word=nation
    word=city
    word=cities
    word=town
    word=towns
    word=capital
    word=capitals
    word=river
    word=rivers
    word=mountain
    word=mountains
    word=continent
    word=continents
    word=region
    word=regions
    word=lake
    word=lakes
    word=highlight
    word=highlights
    word=sea
    word=seas

@map.pin acts.kind
    plural=pins
    in=view
    word=marker
    word=markers
    word=flag
    word=flags

@map.route acts.kind
    plural=routes
    word=line
    word=lines
    word=path
    word=distance_line

@map.label acts.kind
    plural=labels
    word=caption
    word=note

@map.view acts.kind
    plural=views
    word=map
    word=maps
    word=atlas
    word=globe

@map.name acts.attr
    of=place
    of=pin
    of=label
    type=text
    word=label

@map.colour acts.attr
    of=place
    of=pin
    of=route
    type=colour
    word=color
    word=colors
    word=colours

@map.zoom acts.attr
    of=view
    type=number
    min=1
    max=18
    default=2
    more=closer
    less=farther
    word=magnification

@map.centre acts.attr
    of=view
    type=text
    word=center
    word=middle

@map.layer acts.attr
    of=view
    type=enum
    values=offline
    values=street
    values=osm
    word=layers

@map.capital acts.attr
    of=place
    type=text
    word=capitals

@map.population acts.attr
    of=place
    type=number
    word=inhabitants
    word=people

@map.area acts.attr
    of=place
    type=number
    word=size
    word=big
    word=large

@map.currency acts.attr
    of=place
    type=text
    word=money

@map.language acts.attr
    of=place
    type=text
    word=languages

@map.continent acts.attr
    of=place
    type=text

@map.neighbours acts.attr
    of=place
    type=text
    word=neighbors
    word=neighbour
    word=neighbor
    word=borders

@map.landlocked acts.attr
    of=place
    type=bool
    word=coast
    word=sea
