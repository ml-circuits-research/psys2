@gen.ui.avatar.note core.note
    text="Generated from schema.sop by scripts/build-schema-world.mjs (spec 21). Never edited by hand; tests/acts.test.mjs fails when it is stale."

@pat.ui.avatar.make core.pattern
    match="[$lang.lead.polite]? [$acts.verb.make] [$acts.det]? {thing:words}"
    emit="@{_} core.request action=ui.avatar.make arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=request
    priority=10
    example="Add a hat."

