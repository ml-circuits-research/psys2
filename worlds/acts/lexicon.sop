@gen.acts.note core.note
    text="Generated by scripts/build-acts-lexicon.mjs from the seed words of acts.mjs. SEED: temporary, deleted when k.actions of the knowledge repo is read through the catalog (spec 21)."

@phrase.acts.verb.make core.phrase
    frame=false
    doc="Seed words of the act make (temporary, to be replaced by k.actions)."
    alt=add
    alt=make
    alt=create
    alt=build
    alt=insert
    alt=put_up
    alt=set_up
    alt=i_need
    alt=i_want
    alt=give_me

