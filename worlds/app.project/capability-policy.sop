@mode.make std.capability.mode act=make target=new
@mode.change std.capability.mode act=change target=existing requireResult=true selector=true selectorUnique=true
@mode.place std.capability.mode act=place target=existing requireResult=true selector=true selectorUnique=true
@mode.remove std.capability.mode act=remove target=existing selector=true
@mode.arrange std.capability.mode act=arrange target=existing selector=true selectorUnique=true

# The kind a target names fills a tool's kind parameter when one of its words is a declared value of it. A family
# word ("box", "node") names no value: a declared default for that family may fill it (execution-policy.sop), and an
# operation whose kind parameter stays empty is refused for its missing required argument.
@seed.kind std.capability.seed parameter="kind" source=kind phase=initial order=10 replace=true
@seed.identities std.capability.seed parameter="ids" source=target.list phase=initial order=11 replace=true
@seed.identity std.capability.seed parameter="id" source=target.id phase=initial order=12 unlessParameter="ids" replace=true
@seed.allocation std.capability.seed act=make parameter="id" source=fresh.id phase=initial order=13 parameterRequired=true replace=true
@seed.name std.capability.seed parameter="name" source=target.name phase=initial order=30
@seed.title std.capability.seed act=make parameter="title" source=name.or.label phase=missing order=100 parameterRequired=true notice="I used {value} as the title."
@seed.label std.capability.seed act=make parameter="label" source=name.or.label phase=missing order=101 parameterRequired=true notice="I used {value} as the name."

@guard.document std.capability.guard operation="document.write" when=active.signal signal=document.populated reason=overwrite-needs-stricter-admission message="The document already has content. I left it unchanged."
@guard.calendar std.capability.guard operation="calendar.meeting.add" when=incomplete.coverage reason=unapplied-scheduling-details message="I understood a meeting, but could not apply its scheduling details. Nothing changed."

@document std.capability.object on="docs.editor.document" scope=?scope
@document.title std.capability.field object=$document key="title" value=?title
@document.named core.check fn=neq args=?title args=""
@document.block std.capability.object on="docs.editor.block" scope=?scope
@document.section std.capability.object on="docs.editor.section" scope=?scope
@document.occupied std.capability.signal scope=?scope name=document.populated
@document.by.title core.rule when=$document when=$document.title if=$document.named then=$document.occupied
@document.by.block core.rule when=$document.block then=$document.occupied
@document.by.section core.rule when=$document.section then=$document.occupied

# Bind an authored observed property to each matching live tool scope.
@observed.mapping app.execution.observedProperty concept=?concept sourceType=?on parameter=?parameter binding=?binding codec=?codec order=?order
@observed.scope std.capability.operation on=?on scope=?scope
@observed.property std.capability.property scope=?scope concept=?concept on=?on parameter=?parameter binding=?binding codec=?codec order=?order
@observed.install core.rule when=$observed.mapping when=$observed.scope then=$observed.property

# An observed measure (a size, a width, a duration) binds like an observed property, with plain values.
@measure.mapping app.execution.observedMeasure concept=?concept sourceType=?on parameter=?parameter binding=?binding order=?order
@measure.scope std.capability.operation on=?on scope=?scope
@measure.property std.capability.property scope=?scope concept=?concept on=?on parameter=?parameter binding=?binding order=?order
@measure.install core.rule when=$measure.mapping when=$measure.scope then=$measure.property

# The catalog owns the scale of size (k.expect: tiny to huge, each with its size factor). A degree word
# ("big", "small") scales the value the tool would otherwise choose by the factor of its step.
@degree.source app.execution.values concept=?concept valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@degree.row k.expect.scale step=?step size_factor=?factor
@degree.label core.calc fn=matches args=?step args="^[\\s\\S]*$" out=?label
@degree.value std.capability.degree concept=?concept label=?label factor=?factor
@degree.install core.rule when=$degree.source when=$degree.row with=$degree.label then=$degree.value

# What the tool would choose without the request's value: the measures of the object a preview of the
# compiled call creates (app.execution.preview), for the parameter its property binds.
@base.preview app.execution.preview scope=?scope operation=?operation kind=?kind on=?on binding=?binding value=?value
@base.tool std.capability.operation scope=?scope name=?operation on=?on
@base.property std.capability.property scope=?scope on=?on parameter=?parameter binding=?binding
@base.value std.capability.base scope=?scope operation=?operation kind=?kind parameter=?parameter value=?value
@base.install core.rule when=$base.preview when=$base.tool when=$base.property then=$base.value

# The catalog owns exact colour names and RGB values. Keep uppercase observations
# comparable to the same values after normalizing both sides.
@colour.source app.execution.values concept=?concept valueType="k.colours.colour" nameKey="name" valueKey="rgb"
@colour.row k.colours.colour name=?name rgb=?rgb
@colour.label core.calc fn=matches args=?name args="^[\\s\\S]*$" out=?label
@colour.normal core.calc fn=lower args=?rgb out=?value
@colour.value std.capability.value concept=?concept label=?label value=?value
@colour.install core.rule when=$colour.source when=$colour.row with=$colour.label with=$colour.normal then=$colour.value

# An ordinal concept: each step of its catalog scale (k.values.step) is a value of its own name, and each
# comparative step (more, less) a relative value the tool resolves against the target's own step.
@ordinal.source app.execution.ordinal concept=?concept scale=?scale
@ordinal.row k.values.step scale=?scale name=?name
@ordinal.label core.calc fn=matches args=?name args="^[\\s\\S]*$" out=?label
@ordinal.value std.capability.value concept=?concept label=?label value=?label
@ordinal.install core.rule when=$ordinal.source when=$ordinal.row with=$ordinal.label then=$ordinal.value
@ordinal.step app.execution.comparative step=?step
@ordinal.step.label core.calc fn=matches args=?step args="^[\\s\\S]*$" out=?label
@ordinal.step.value std.capability.value concept=?concept label=?label value=?label
@ordinal.step.install core.rule when=$ordinal.source when=$ordinal.step with=$ordinal.step.label then=$ordinal.step.value

@observed.rgb app.execution.observedProperty binding=?binding format=rgb
@observed.raw app.execution.observedField object=?object binding=?binding key=?key value=?raw
@observed.hex core.calc fn=matches args=?raw args="^#[0-9a-fA-F]{6}$" out=?hex
@observed.lower core.calc fn=lower args=?hex out=?canonical
@observed.normal std.capability.field object=?object binding=?binding key=?key value=?canonical
@observed.rgb.install core.rule when=$observed.rgb when=$observed.raw with=$observed.hex with=$observed.lower then=$observed.normal

# A reference concept (app.execution.reference) names an observed object by its code, its name or its kind; each
# is a lookup value of the concept whose value is the object's code. Shared names and kinds stay ambiguous.
@ref.source app.execution.reference concept=?concept sourceType=?on
@ref.object std.capability.object id=?id on=?on
@ref.by.id std.capability.value concept=?concept label=?id value=?id
@ref.id.install core.rule when=$ref.source when=$ref.object then=$ref.by.id
@ref.named std.capability.object id=?id on=?on name=?name
@ref.by.name std.capability.value concept=?concept label=?name value=?id
@ref.name.install core.rule when=$ref.source when=$ref.named then=$ref.by.name
@ref.kinded std.capability.object id=?id on=?on kind=?kind
@ref.by.kind std.capability.value concept=?concept label=?kind value=?id
@ref.kind.install core.rule when=$ref.source when=$ref.kinded then=$ref.by.kind

# An operation declared to answer another act (app.execution.actOperation) is offered for that act on its own source type.
@actop.source app.execution.actOperation operation=?name act=?act
@actop.tool std.capability.operation scope=?scope name=?name on=?on order=?order
@actop.alias std.capability.operation scope=?scope name=?name on=?on act=?act order=?order eligible=true
@actop.install core.rule when=$actop.source when=$actop.tool then=$actop.alias
