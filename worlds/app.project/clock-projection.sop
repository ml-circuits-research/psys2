# Clock times for instants. A request that gives a clock time ("3pm", "15:00", "noon", "half past 3 pm") for a
# concept the execution policy declares an instant (app.execution.instant: milliseconds since the Unix epoch on the
# objects of one source type, in a clock offset from UTC) gets the instant that time names on the day the request
# speaks of: the day of the target's own instant (the focused object's, else the one every observed object of that
# type shares), or today for a new object. The clock is read with knowledge only: the hours of k.time.hour by name
# (noon, midnight, "3 pm") and by the 12-hour clock (hour12, am_pm), the 24 hours by number, and the clock
# phrases of k.time.clock_phrase ("half past", "quarter to": minutes added to the hour named). The result is an
# std.capability.value of the said label, so the request compiler resolves it as any declared value; a time that
# names more than one instant (objects on different days, "half past 3" am or pm) stays unresolved.

@clock.request app.execution.requestValue concept=?concept label=?label
@clock.declared app.execution.instant concept=?concept
@clock.lower core.calc fn=lower args=?label out=?low

# By name: "noon", "midnight", "3 pm". A one-word name is an atom of the knowledge and a longer one a string, so
# the said text is compared in both spellings.
@clock.name.row k.time.hour name=?name n=?n
@clock.name.same core.check fn=eq args=?low args=?name
@clock.name.minute core.calc fn=mul args=?n args=60 out=?minute
@clock.name.time app.execution.clockTime label=?label minute=?minute
@clock.name core.rule when=$clock.request when=$clock.declared when=$clock.name.row with=$clock.lower if=$clock.name.same with=$clock.name.minute then=$clock.name.time
@clock.word.text core.calc fn=concat args=?low out=?word
@clock.word.same core.check fn=eq args=?word args=?name
@clock.word core.rule when=$clock.request when=$clock.declared when=$clock.name.row with=$clock.lower with=$clock.word.text if=$clock.word.same with=$clock.name.minute then=$clock.name.time

# The 12-hour clock: "3pm", "3 pm", "3:30 pm" (the hour by hour12 and am_pm of k.time.hour).
@clock.h12.hour core.calc fn=matches args=?low args="^\\s*(\\d{1,2})\\s*([ap]m)\\s*$" args=1 out=?hour
@clock.h12.number core.calc fn=add args=?hour args=0 out=?h12
@clock.h12.row k.time.hour hour12=?h12 am_pm=?half n=?n
@clock.h12.said core.calc fn=matches args=?low args="^\\s*(\\d{1,2})\\s*([ap]m)\\s*$" args=2 out=?saidHalf
@clock.h12.side core.calc fn=concat args=?saidHalf out=?side
@clock.h12.same core.check fn=eq args=?side args=?half
@clock.h12.minute core.calc fn=mul args=?n args=60 out=?minute
@clock.h12.time app.execution.clockTime label=?label minute=?minute
@clock.h12 core.rule when=$clock.request when=$clock.declared with=$clock.lower with=$clock.h12.hour with=$clock.h12.number when=$clock.h12.row with=$clock.h12.said with=$clock.h12.side if=$clock.h12.same with=$clock.h12.minute then=$clock.h12.time
@clock.h12m.hour core.calc fn=matches args=?low args="^\\s*(\\d{1,2})[:.](\\d{2})\\s*([ap]m)\\s*$" args=1 out=?hour
@clock.h12m.number core.calc fn=add args=?hour args=0 out=?h12
@clock.h12m.row k.time.hour hour12=?h12 am_pm=?half n=?n
@clock.h12m.said core.calc fn=matches args=?low args="^\\s*(\\d{1,2})[:.](\\d{2})\\s*([ap]m)\\s*$" args=3 out=?saidHalf
@clock.h12m.side core.calc fn=concat args=?saidHalf out=?side
@clock.h12m.same core.check fn=eq args=?side args=?half
@clock.h12m.minutes core.calc fn=matches args=?low args="^\\s*(\\d{1,2})[:.](\\d{2})\\s*([ap]m)\\s*$" args=2 out=?mm
@clock.h12m.within core.check fn=lt args=?mm args=60
@clock.h12m.hours core.calc fn=mul args=?n args=60 out=?base
@clock.h12m.minute core.calc fn=add args=?base args=?mm out=?minute
@clock.h12m.time app.execution.clockTime label=?label minute=?minute
@clock.h12m core.rule when=$clock.request when=$clock.declared with=$clock.lower with=$clock.h12m.hour with=$clock.h12m.number when=$clock.h12m.row with=$clock.h12m.said with=$clock.h12m.side if=$clock.h12m.same with=$clock.h12m.minutes if=$clock.h12m.within with=$clock.h12m.hours with=$clock.h12m.minute then=$clock.h12m.time

# The 24-hour clock: "15:00", "9.30" (the hour by n of k.time.hour).
@clock.h24.hour core.calc fn=matches args=?low args="^\\s*(\\d{1,2})[:.](\\d{2})\\s*$" args=1 out=?hour
@clock.h24.number core.calc fn=add args=?hour args=0 out=?h
@clock.h24.row k.time.hour n=?h
@clock.h24.minutes core.calc fn=matches args=?low args="^\\s*(\\d{1,2})[:.](\\d{2})\\s*$" args=2 out=?mm
@clock.h24.within core.check fn=lt args=?mm args=60
@clock.h24.hours core.calc fn=mul args=?h args=60 out=?base
@clock.h24.minute core.calc fn=add args=?base args=?mm out=?minute
@clock.h24.time app.execution.clockTime label=?label minute=?minute
@clock.h24 core.rule when=$clock.request when=$clock.declared with=$clock.lower with=$clock.h24.hour with=$clock.h24.number when=$clock.h24.row with=$clock.h24.minutes if=$clock.h24.within with=$clock.h24.hours with=$clock.h24.minute then=$clock.h24.time

# A clock phrase before an hour: "half past 3 pm", "quarter to 4pm" (the phrase's minutes, negative for "to", are
# added to the hour it names). Without am or pm the hour of the 12-hour clock is both halves of the day ("half past
# 3": 3:30 and 15:30); both are derived, so such a label stays unresolved instead of guessing.
@clock.phrase.text core.calc fn=matches args=?low args="^\\s*([a-z' -]+?)\\s+(\\d{1,2})\\s*([ap]m)?\\s*$" args=1 out=?phrase
@clock.phrase.row k.time.clock_phrase name=?phrase minutes=?shift
@clock.phrase.hour core.calc fn=matches args=?low args="^\\s*([a-z' -]+?)\\s+(\\d{1,2})\\s*([ap]m)?\\s*$" args=2 out=?hour
@clock.phrase.number core.calc fn=add args=?hour args=0 out=?h12
@clock.phrase.hourRow k.time.hour hour12=?h12 am_pm=?half n=?n
@clock.phrase.hours core.calc fn=mul args=?n args=60 out=?base
@clock.phrase.minute core.calc fn=add args=?base args=?shift out=?minute
@clock.phrase.time app.execution.clockTime label=?label minute=?minute
@clock.phrase.said core.calc fn=matches args=?low args="^\\s*([a-z' -]+?)\\s+(\\d{1,2})\\s*([ap]m)\\s*$" args=3 out=?saidHalf
@clock.phrase.side core.calc fn=concat args=?saidHalf out=?side
@clock.phrase.same core.check fn=eq args=?side args=?half
@clock.phrase core.rule when=$clock.request when=$clock.declared with=$clock.lower when=$clock.phrase.row with=$clock.phrase.text with=$clock.phrase.hour with=$clock.phrase.number when=$clock.phrase.hourRow with=$clock.phrase.said with=$clock.phrase.side if=$clock.phrase.same with=$clock.phrase.hours with=$clock.phrase.minute then=$clock.phrase.time
@clock.phrase12.halfless core.calc fn=matches args=?low args="^\\s*([a-z' -]+?)\\s+(\\d{1,2})\\s*$" out=?bare
@clock.phrase12 core.rule when=$clock.request when=$clock.declared with=$clock.lower when=$clock.phrase.row with=$clock.phrase12.halfless with=$clock.phrase.text with=$clock.phrase.hour with=$clock.phrase.number when=$clock.phrase.hourRow with=$clock.phrase.hours with=$clock.phrase.minute then=$clock.phrase.time

# The day spoken of. An existing target: the focused object's own instant when it is of the declared type, else
# the instant of each observed object of that type (one day when they share it). A new target: the clock.
@day.declared app.execution.instant concept=?concept sourceType=?on binding=?binding
@day.existing app.execution.requestValue scope=$day.scope concept=?concept mode=existing
@day.scope std.capability.scope focus=?focus
@day.focused std.capability.object scope=$day.scope id=?focus on=?on
@day.focused.field std.capability.field object=$day.focused binding=?binding value=?at
@day.focus.base app.execution.instantBase scope=$day.scope concept=?concept value=?at
@day.focus.mark app.execution.instantFocus scope=$day.scope concept=?concept
@day.focus core.rule when=$day.declared when=$day.existing when=$day.scope when=$day.focused when=$day.focused.field then=$day.focus.base
@day.focus.marked core.rule when=$day.declared when=$day.existing when=$day.scope when=$day.focused when=$day.focused.field then=$day.focus.mark
@day.any.request app.execution.requestValue scope=?scope concept=?concept mode=existing
@day.any.object std.capability.object scope=?scope on=?on
@day.any.field std.capability.field object=$day.any.object binding=?binding value=?at
@day.any.focus app.execution.instantFocus scope=?scope concept=?concept
@day.any.base app.execution.instantBase scope=?scope concept=?concept value=?at
@day.any core.rule when=$day.declared when=$day.any.request when=$day.any.object when=$day.any.field not=$day.any.focus then=$day.any.base
@day.new.request app.execution.requestValue scope=$day.new.scope concept=?concept mode=new
@day.new.scope std.capability.scope clock=?at
@day.new.base app.execution.instantBase scope=$day.new.scope concept=?concept value=?at
@day.new core.rule when=$day.declared when=$day.new.request when=$day.new.scope then=$day.new.base

# The instant: the start of the base's day on the declared clock, plus the said minutes.
@at.declared app.execution.instant concept=?concept zoneOffset=?zone
@at.request app.execution.requestValue scope=?scope concept=?concept label=?label
@at.time app.execution.clockTime label=?label minute=?minute
@at.base app.execution.instantBase scope=?scope concept=?concept value=?base
@at.offset core.calc fn=mul args=?zone args=60000 out=?offset
@at.local core.calc fn=add args=?base args=?offset out=?local
@at.into core.calc fn=mod args=?local args=86400000 out=?into
@at.day core.calc fn=sub args=?base args=?into out=?day
@at.after core.calc fn=mul args=?minute args=60000 out=?after
@at.value core.calc fn=add args=?day args=?after out=?value
@at.out std.capability.value concept=?concept label=?label value=?value
@at.install core.rule when=$at.declared when=$at.request when=$at.time when=$at.base with=$at.offset with=$at.local with=$at.into with=$at.day with=$at.after with=$at.value then=$at.out
