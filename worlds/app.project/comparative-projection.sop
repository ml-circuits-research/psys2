# Comparatives ("bigger", "make it smaller", "a bit larger") reach the reader as a change of a property by a step,
# with no number: operator=delta step=more|less. The catalog owns the scale (k.expect.scale: tiny, small, default,
# big, huge, each with its size factor) and says that a reaction "bigger" moves one step up it and "smaller" one step
# down. A comparative step therefore has the factor of the step that many places from the default one, over the
# default's own. The projection holds for each concept whose degree values the same scale gives (app.execution.values
# codec=degree), and the raw-structure bridge turns the step into a factor of the value the target has now
# (operator=factor baseline=before, the library's relative change), so "bigger" scales the house as it is.
# Intensity ("much bigger", "a bit smaller") would be another offset; the reader does not label it yet.
@step.more app.execution.comparative step=more offset=1
@step.less app.execution.comparative step=less offset=-1

@comparative.source app.execution.values concept=?concept valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@comparative.step app.execution.comparative step=?step offset=?offset
@comparative.default k.expect.scale step=default order=?order size_factor=?base
@comparative.order core.calc fn=add args=?order args=?offset out=?next
@comparative.next k.expect.scale order=?next size_factor=?scaled
@comparative.ratio core.calc fn=div args=?scaled args=?base out=?factor
@comparative.value app.execution.comparativeFactor concept=?concept step=?step factor=?factor
@comparative.install core.rule when=$comparative.source when=$comparative.step when=$comparative.default with=$comparative.order when=$comparative.next with=$comparative.ratio then=$comparative.value
