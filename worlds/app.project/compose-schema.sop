# The types of the composition policy (compose-policy.sop): random, surprise and conversation-grounded content of the
# Drawing and Diagram tabs, composed from catalog knowledge by declared rules with the library's seeded sampling
# (sopworld rand, rand_between, sample_key). The host (src/dialog/compose-execution.mjs) states the reading, the
# request, the preferences, what the conversation mentioned and the knowledge the policy declares to load; it executes
# the calls the rules conclude, through the area's own declared operations, as one undoable turn.
@compose.module core.module name=app.compose exports=app.compose.reading exports=app.compose.constraint exports=app.compose.word exports=app.compose.free exports=app.compose.random exports=app.compose.blocked exports=app.compose.asked exports=app.compose.last exports=app.compose.open exports=app.compose.trigger exports=app.compose.start exports=app.compose.away exports=app.compose.kindless exports=app.compose.areaWord exports=app.compose.option exports=app.compose.optionKey exports=app.compose.optionValue exports=app.compose.typeForm exports=app.compose.kindForm exports=app.compose.openValue exports=app.compose.openSaid exports=app.compose.openForm exports=app.compose.request exports=app.compose.preference exports=app.compose.variantLevel exports=app.compose.levelByVariant exports=app.compose.level exports=app.compose.detail exports=app.compose.load exports=app.compose.weight exports=app.compose.form exports=app.compose.candidate exports=app.compose.eligible exports=app.compose.keyed exports=app.compose.chosen exports=app.compose.step exports=app.compose.topic exports=app.compose.call exports=app.compose.list exports=app.compose.mention exports=app.compose.number exports=app.compose.said exports=app.compose.reply exports=app.compose.fallback exports=app.compose.limit exports=app.compose.measure exports=app.compose.notice exports=app.compose.found

# What the reader read (one request of the turn) and what the area last composed.
@compose.reading.type core.type of=app.compose.reading
@compose.reading.area core.slot of=app.compose.reading key=area kind=atom present=true
@compose.reading.act core.slot of=app.compose.reading key=act kind=atom
@compose.reading.mode core.slot of=app.compose.reading key=mode kind=atom
@compose.reading.type.slot core.slot of=app.compose.reading key=type kind=atom
@compose.reading.word core.slot of=app.compose.reading key=word kind=string
@compose.reading.bound core.slot of=app.compose.reading key=bound kind=boolean
@compose.reading.canonical core.slot of=app.compose.reading key=canonical kind=string
@compose.reading.parts core.slot of=app.compose.reading key=parts kind=integer
# What the reading specifies about the result (a constraint key), the words of its request span, the declared keys
# that leave the content open and the declared words that ask for random content; derived: a reading that specifies
# its content (blocked) and one that asks for random content (asked).
@compose.constraint.type core.type of=app.compose.constraint
@compose.word.type core.type of=app.compose.word
@compose.free.type core.type of=app.compose.free
@compose.random.type core.type of=app.compose.random
@compose.blocked.type core.type of=app.compose.blocked
@compose.asked.type core.type of=app.compose.asked
@compose.last.type core.type of=app.compose.last
@compose.open.type core.type of=app.compose.open
@compose.trigger.type core.type of=app.compose.trigger
@compose.start.type core.type of=app.compose.start
# A reading word that another editor composes (derived): the composition starts there, not in the shown editor.
@compose.away.type core.type of=app.compose.away
@compose.kindless.type core.type of=app.compose.kindless
@compose.kindless.area core.slot of=app.compose.kindless key=area kind=atom present=true
# A word of a request with no kind word that names the editor composing it (its verb: "draw" for the Drawing).
@compose.areaWord.type core.type of=app.compose.areaWord
# The reader's composition keys (spec 25; reader v12): which constraint key says which request option (optionKey),
# its closed values (optionValue), the option concluded (option); the form a composition target makes in an area
# (typeForm) or by its kind word (kindForm); a value of a content key that leaves the content open (openValue), said by
# the reading (openSaid), and the form it composes (openForm).
@compose.option.type core.type of=app.compose.option
@compose.optionKey.type core.type of=app.compose.optionKey
@compose.optionValue.type core.type of=app.compose.optionValue
@compose.typeForm.type core.type of=app.compose.typeForm
@compose.kindForm.type core.type of=app.compose.kindForm
@compose.openValue.type core.type of=app.compose.openValue
@compose.openSaid.type core.type of=app.compose.openSaid
@compose.openForm.type core.type of=app.compose.openForm

# The composition asked for, its detail level, the preferences in force.
@compose.request.type core.type of=app.compose.request
@compose.request.area core.slot of=app.compose.request key=area kind=atom present=true
@compose.request.form core.slot of=app.compose.request key=form enum=scene enum=diagram enum=chart present=true
@compose.request.seed core.slot of=app.compose.request key=seed kind=integer present=true
@compose.request.source core.slot of=app.compose.request key=source enum=random enum=conversation present=true
@compose.request.subject core.slot of=app.compose.request key=subject kind=string
@compose.request.with core.slot of=app.compose.request key=with kind=string
@compose.request.variant core.slot of=app.compose.request key=variant enum=another enum=similar enum=simpler enum=richer
@compose.preference.type core.type of=app.compose.preference
@compose.variantLevel.type core.type of=app.compose.variantLevel
@compose.levelByVariant.type core.type of=app.compose.levelByVariant
@compose.level.type core.type of=app.compose.level
@compose.detail.type core.type of=app.compose.detail

# Declared data: which knowledge to load, weights, diagram forms, limits, fallbacks, reply wording.
@compose.load.type core.type of=app.compose.load
@compose.weight.type core.type of=app.compose.weight
@compose.form.type core.type of=app.compose.form
@compose.limit.type core.type of=app.compose.limit
@compose.fallback.type core.type of=app.compose.fallback
@compose.reply.type core.type of=app.compose.reply
@compose.notice.type core.type of=app.compose.notice
@compose.measure.type core.type of=app.compose.measure

# Derived: candidates, keys, the choice, the steps and topics of a diagram, the calls and their list arguments.
@compose.candidate.type core.type of=app.compose.candidate
@compose.eligible.type core.type of=app.compose.eligible
@compose.keyed.type core.type of=app.compose.keyed
@compose.chosen.type core.type of=app.compose.chosen
@compose.step.type core.type of=app.compose.step
@compose.topic.type core.type of=app.compose.topic
@compose.call.type core.type of=app.compose.call
@compose.list.type core.type of=app.compose.list
@compose.found.type core.type of=app.compose.found

# What the conversation mentioned, from the reader's own outputs of earlier turns.
@compose.mention.type core.type of=app.compose.mention
@compose.number.type core.type of=app.compose.number
@compose.said.type core.type of=app.compose.said
