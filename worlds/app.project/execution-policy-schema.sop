@linkPatternNote.text core.slot of=app.execution.linkPatternNote key=text kind=string present=true
# A made object named after the kind asked for and observed as another kind (a stand-in, the closest drawable relative):
# key= the observed field holding the asked name; text= the reply, {asked} and {drawn} each with its article.
@standInNote.type core.type of=app.execution.standInNote closed=true
@standInNote.key core.slot of=app.execution.standInNote key=key kind=string present=true
@standInNote.text core.slot of=app.execution.standInNote key=text kind=string present=true
# An operation that also answers another act: "improve the layout", "tidy it up" (arrange with nothing more said) is
# the page's declared best-effort improvement, an operation with no parameters of its own.
@actOperation.type core.type of=app.execution.actOperation closed=true
@actOperation.operation core.slot of=app.execution.actOperation key=operation kind=string present=true
@actOperation.act core.slot of=app.execution.actOperation key=act kind=atom present=true
# A catalog kind drawn by a native operation with one fixed argument (a chart kind and the chart group's layout), for
# kinds the deployed binding table names without a native family binding. Every lemma of the kind in the table takes it.
# Without parameter and value the operation makes the class itself (a chart series: diagram.chart.series.add).
@kindBinding.type core.type of=app.execution.kindBinding closed=true
@kindBinding.area core.slot of=app.execution.kindBinding key=area kind=atom present=true
@kindBinding.kind core.slot of=app.execution.kindBinding key=kind kind=atom present=true
@kindBinding.operation core.slot of=app.execution.kindBinding key=operation kind=string present=true
@kindBinding.parameter core.slot of=app.execution.kindBinding key=parameter kind=string
@kindBinding.value core.slot of=app.execution.kindBinding key=value kind=string
# A reader key aligned with a native parameter of another name (the reader's chart.grid is the chart group's
# gridlines), for keys the deployed binding table leaves unbound or binds to a retired source type. The key binds to
# that parameter of the operation's own source type (declared-bindings.mjs). Its said values (app.execution.keyValue)
# are the reader's class values of the key, each given to the tool as the declared parameter value; a key without
# declared values takes the parameter's own (a closed list, a number).
@keyBinding.type core.type of=app.execution.keyBinding closed=true
@keyBinding.area core.slot of=app.execution.keyBinding key=area kind=atom present=true
@keyBinding.key core.slot of=app.execution.keyBinding key=key kind=string present=true
@keyBinding.operation core.slot of=app.execution.keyBinding key=operation kind=string present=true
@keyBinding.parameter core.slot of=app.execution.keyBinding key=parameter kind=string present=true
# `codec` how a said list is read for a list parameter: its items as numbers or as strings.
@keyBinding.codec core.slot of=app.execution.keyBinding key=codec kind=string enum="number-list" enum="string-list"
@keyValue.type core.type of=app.execution.keyValue closed=true
@keyValue.area core.slot of=app.execution.keyValue key=area kind=atom present=true
@keyValue.key core.slot of=app.execution.keyValue key=key kind=string present=true
@keyValue.said core.slot of=app.execution.keyValue key=said kind=string present=true
@keyValue.value core.slot of=app.execution.keyValue key=value kind=string present=true
# An additive change of a numeric property said with its amount ("bump Thu up by 70", "March should drop by 4": the
# reader's operator delta with a step and a number) is the operation's amount parameter for that direction: the key
# said with the step reads as the key `as`, bound like any key (app.execution.keyBinding), its value the amount
# (declared-value-readings.mjs).
@amount.type core.type of=app.execution.amount closed=true
@amount.area core.slot of=app.execution.amount key=area kind=atom present=true
@amount.key core.slot of=app.execution.amount key=key kind=string present=true
@amount.step core.slot of=app.execution.amount key=step kind=atom enum=more enum=less present=true
@amount.as core.slot of=app.execution.amount key=as kind=string present=true
# A pair of keys that bound one range ("run the y axis from 0 to 10": the floor and the top of the value axis): a span
# that spells two numbers said for either key gives the first to `low` and the second to `high`
# (declared-value-readings.mjs), each with its own words as evidence.
@range.type core.type of=app.execution.range closed=true
@range.area core.slot of=app.execution.range key=area kind=atom present=true
@range.low core.slot of=app.execution.range key=low kind=string present=true
@range.high core.slot of=app.execution.range key=high kind=string present=true
# A family whose members have an order (a chart's categories, its series) is picked by its place in that order ("the
# third bar", "the second series"): a target ordinal reads as a selector on `key` (declared-value-readings.mjs), the
# key the members' observed place (`binding` on `sourceType`, counted from 1), its values the ordinal numbers of
# k.values (declared-bindings.mjs).
@position.type core.type of=app.execution.position closed=true
@position.area core.slot of=app.execution.position key=area kind=atom present=true
@position.type_ core.slot of=app.execution.position key=type kind=string present=true
@position.key core.slot of=app.execution.position key=key kind=string present=true
@position.on core.slot of=app.execution.position key=sourceType kind=string present=true
@position.binding core.slot of=app.execution.position key=binding kind=string present=true

# Lengths said with a unit ("150 pixels wide", "2 cm"): the canvas's own unit (canvas.pixel, the unit the native
# interfaces declare for coordinates) with its words, and the length units of k.units it converts from (pixels per
# unit, at the CSS reference of 96 pixels to the inch). A unit without a row is not converted (the value stays unapplied).
@canvasUnit.type core.type of=app.execution.canvasUnit closed=true
@canvasUnit.unit core.slot of=app.execution.canvasUnit key=unit kind=string present=true
@canvasUnit.word core.slot of=app.execution.canvasUnit key=word kind=string many=true present=true
@lengthUnit.type core.type of=app.execution.lengthUnit closed=true
@lengthUnit.unit core.slot of=app.execution.lengthUnit key=unit kind=atom present=true
@lengthUnit.to core.slot of=app.execution.lengthUnit key=to kind=string present=true
@lengthUnit.factor core.slot of=app.execution.lengthUnit key=factor kind=number present=true

# The flow a container lays its members out in ("add a step after Review"): the observed field of the object of
