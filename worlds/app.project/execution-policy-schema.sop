# An act that compiles as another act when its target has a mode: "connect A to B" with a new target makes the line
# that joins them (k.actions.act.connect: "a line runs between them"), so it is compiled as making that line.
@actForm.type core.type of=app.execution.actForm closed=true
@actForm.act core.slot of=app.execution.actForm key=act kind=atom present=true
@actForm.mode core.slot of=app.execution.actForm key=mode kind=atom enum=new enum=existing present=true
@actForm.as core.slot of=app.execution.actForm key=as kind=atom present=true
@actForm.results core.slot of=app.execution.actForm key=results kind=atom enum=some enum=none
# `of`: the canonical kinds the act's new theme can be (the joining line); a new target of another kind ("connect
# circles" read with the circles as a new node) is not compiled as making it.
@actForm.of core.slot of=app.execution.actForm key=of kind=atom many=true
# A concept whose values name observed objects of `sourceType` (a line's ends): an object is named by its code, by
# its name (its label) or by its kind, and the value given to the tool is its code. A name or kind that several
# objects share names none of them (the lookup stays ambiguous and the value is not applied).
@reference.type core.type of=app.execution.reference closed=true
@reference.concept core.slot of=app.execution.reference key=concept kind=atom present=true
@reference.on core.slot of=app.execution.reference key=sourceType kind=string present=true
# A population joined by lines: when one end of a line names several observed objects ("connect the circles": every
# circle), the line is made between them by a declared pattern: chain (each to the next in reading order: top to
# bottom, left to right) when the other end is not said, star (the said end to each of them) when it names one object.
@linkPattern.type core.type of=app.execution.linkPattern closed=true
@linkPattern.from core.slot of=app.execution.linkPattern key=from kind=atom present=true
@linkPattern.to core.slot of=app.execution.linkPattern key=to kind=atom present=true
@linkPattern.open core.slot of=app.execution.linkPattern key=open kind=atom enum=chain present=true
@linkPattern.hub core.slot of=app.execution.linkPattern key=hub kind=atom enum=star present=true
@linkPattern.max core.slot of=app.execution.linkPattern key=max kind=integer min=2 max=16 present=true
# patternConcept: the concept a request names its pattern by (chain, cycle, star, all: every pair); without it the
# open and hub patterns above apply.
@linkPattern.patternConcept core.slot of=app.execution.linkPattern key=patternConcept kind=atom
# named: the patterns a request may name by patternConcept (the sopworld library's POPULATION_PATTERNS); another named
# pattern reads as open. hubName: the observed fields whose value names the hub (besides its code).
@linkPattern.named core.slot of=app.execution.linkPattern key=named kind=atom enum=chain enum=cycle enum=all enum=star many=true
@linkPattern.hubName core.slot of=app.execution.linkPattern key=hubName kind=string many=true
# The reply's words for the lines made over a population: {members} the joined objects, {count} the lines, {pattern}
# the pattern's wording (app.execution.linkPatternNote); one= for one line, many= for several.
@populationNote.type core.type of=app.execution.populationNote closed=true
@populationNote.case core.slot of=app.execution.populationNote key=case kind=atom enum=lines enum=targets present=true
@populationNote.one core.slot of=app.execution.populationNote key=one kind=string
@populationNote.many core.slot of=app.execution.populationNote key=many kind=string present=true
