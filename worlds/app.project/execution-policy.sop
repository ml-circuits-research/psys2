@chart.key.chart_precision app.execution.keyBinding area=diagram key="chart.precision" operation="diagram.chart.format" parameter="precision"
# The decimals are said in words ("whole numbers", "one decimal place"): the drops write the number of decimals as the value.
@chart.key.chart_precision.d0 app.execution.keyValue area=diagram key="chart.precision" said="0" value="0"
@chart.key.chart_precision.d1 app.execution.keyValue area=diagram key="chart.precision" said="1" value="1"
@chart.key.chart_precision.d2 app.execution.keyValue area=diagram key="chart.precision" said="2" value="2"
