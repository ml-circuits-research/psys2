@chart.key.chart_barHeight app.execution.keyBinding area=diagram key="chart.barHeight" operation="diagram.chart.format" parameter="barWidth"
@chart.key.chart_axisSide app.execution.keyBinding area=diagram key="chart.axisSide" operation="diagram.chart.format" parameter="axisSide"
@chart.key.chart_titleWeight app.execution.keyBinding area=diagram key="chart.titleWeight" operation="diagram.chart.format" parameter="titleWeight"
@chart.key.chart_titlePosition app.execution.keyBinding area=diagram key="chart.titlePosition" operation="diagram.chart.format" parameter="titlePosition"
@chart.key.chart_titlePosition.top app.execution.keyValue area=diagram key="chart.titlePosition" said="top" value="top"
@chart.key.chart_titlePosition.top_left app.execution.keyValue area=diagram key="chart.titlePosition" said="top_left" value="top_left"
@chart.key.chart_titlePosition.top_left_words app.execution.keyValue area=diagram key="chart.titlePosition" said="top left" value="top_left"
@chart.key.chart_titlePosition.left app.execution.keyValue area=diagram key="chart.titlePosition" said="left" value="top_left"
@chart.key.chart_titlePosition.bottom app.execution.keyValue area=diagram key="chart.titlePosition" said="bottom" value="bottom"
@chart.key.chart_invert app.execution.keyBinding area=diagram key="chart.invert" operation="diagram.chart.format" parameter="invert"
@chart.key.chart_invert.x app.execution.keyValue area=diagram key="chart.invert" said="x" value="x"
@chart.key.chart_invert.y app.execution.keyValue area=diagram key="chart.invert" said="y" value="y"
@chart.key.chart_invert.off app.execution.keyValue area=diagram key="chart.invert" said="off" value="none"
@chart.key.chart_invert.none app.execution.keyValue area=diagram key="chart.invert" said="none" value="none"
@chart.key.chart_axisScale app.execution.keyBinding area=diagram key="chart.axisScale" operation="diagram.chart.format" parameter="axisScale"
@chart.key.chart_axisScale.log app.execution.keyValue area=diagram key="chart.axisScale" said="log" value="log"
@chart.key.chart_axisScale.linear app.execution.keyValue area=diagram key="chart.axisScale" said="linear" value="linear"
@chart.key.chart_axisScale.both_log app.execution.keyValue area=diagram key="chart.axisScale" said="both log" value="log"
@chart.key.chart_tickFormat app.execution.keyBinding area=diagram key="chart.tickFormat" operation="diagram.chart.format" parameter="tickFormat"
@chart.key.chart_tickFormat.plain app.execution.keyValue area=diagram key="chart.tickFormat" said="plain" value="plain"
@chart.key.chart_tickFormat.magnitude app.execution.keyValue area=diagram key="chart.tickFormat" said="magnitude" value="magnitude"
@chart.key.chart_tickFormat.magnitudes app.execution.keyValue area=diagram key="chart.tickFormat" said="magnitudes" value="magnitude"
@chart.key.chart_tickFormat.power app.execution.keyValue area=diagram key="chart.tickFormat" said="power" value="power"
@chart.key.chart_tickFormat.powers_of_ten app.execution.keyValue area=diagram key="chart.tickFormat" said="powers of ten" value="power"
@chart.key.chart_lineStyle app.execution.keyBinding area=diagram key="chart.lineStyle" operation="diagram.chart.format" parameter="lineStyle"
@chart.key.chart_lineStyle.solid app.execution.keyValue area=diagram key="chart.lineStyle" said="solid" value="solid"
@chart.key.chart_lineStyle.dashed app.execution.keyValue area=diagram key="chart.lineStyle" said="dashed" value="dashed"
@chart.key.chart_lineStyle.dotted app.execution.keyValue area=diagram key="chart.lineStyle" said="dotted" value="dotted"
@chart.key.chart_lineStyle.dash_dot app.execution.keyValue area=diagram key="chart.lineStyle" said="dash_dot" value="dash_dot"
@chart.key.chart_lineStyle.dash_dot_hyphen app.execution.keyValue area=diagram key="chart.lineStyle" said="dash-dot" value="dash_dot"
# Error bars, the category axis on top, a chart placed by a region of the page, the categories kept and a histogram's bins.
@chart.key.chart_errorBars app.execution.keyBinding area=diagram key="chart.errorBars" operation="diagram.chart.format" parameter="errorBars"
@chart.key.chart_errorBars.show app.execution.keyValue area=diagram key="chart.errorBars" said="show" value="true"
@chart.key.chart_errorBars.hide app.execution.keyValue area=diagram key="chart.errorBars" said="hide" value="false"
@chart.key.chart_errorBars.remove app.execution.keyValue area=diagram key="chart.errorBars" said="remove" value="false"
@chart.key.chart_errorCap app.execution.keyBinding area=diagram key="chart.errorCap" operation="diagram.chart.format" parameter="errorCap"
@chart.errorCap.values app.execution.values concept=diagram.sketch.group.errorCap valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.errorCap.measure app.execution.observedMeasure concept=diagram.sketch.group.errorCap sourceType="diagram.sketch.group" parameter="errorCap" binding="diagram.group.errorCap" order=16
@chart.key.chart_xAxis app.execution.keyBinding area=diagram key="chart.xAxis" operation="diagram.chart.format" parameter="xAxis"
@chart.key.chart_at app.execution.keyBinding area=diagram key="chart.at" operation="diagram.group.place" parameter="at"
@chart.key.chart_bins app.execution.keyBinding area=diagram key="chart.bins" operation="diagram.group.chart.make" parameter="bins"
@chart.key.chart_only app.execution.keyBinding area=diagram key="chart.only" operation="diagram.group.chart.make" parameter="only" codec="string-list"
@chart.key.chart_errors app.execution.keyBinding area=diagram key="chart.errors" operation="diagram.group.chart.make" parameter="errors" codec="number-list"
@chart.key.legend.top_right app.execution.keyValue area=diagram key="chart.legend" said="top right" value="right"
@chart.key.chart_gridStyle app.execution.keyBinding area=diagram key="chart.gridStyle" operation="diagram.chart.format" parameter="gridStyle"
@chart.key.chart_dimension app.execution.keyBinding area=diagram key="chart.dimension" operation="diagram.group.chart.make" parameter="dimension"
@chart.key.chart_measure app.execution.keyBinding area=diagram key="chart.measure" operation="diagram.group.chart.make" parameter="measure"
@chart.key.chart_aggregate app.execution.keyBinding area=diagram key="chart.aggregate" operation="diagram.group.chart.make" parameter="aggregate"
@chart.key.chart_top app.execution.keyBinding area=diagram key="chart.top" operation="diagram.group.chart.make" parameter="top"
@chart.key.chart_above app.execution.keyBinding area=diagram key="chart.above" operation="diagram.group.chart.make" parameter="above"
@chart.key.chart_below app.execution.keyBinding area=diagram key="chart.below" operation="diagram.group.chart.make" parameter="below"
# A chart's shape (worlds/diagram.sketch/chart-shape.sop): the axis minimum is the value axis floor; bars "horizontal"
# lie on their side (off: they stand); "stacked" sets the series on top of each other (off: side by side; percent: as
# shares); the chart's width and height size its plot in pixels; a shadow or a glow round its frame. An effect the
# chart has no drawing for (a gradient, 3d) has no declared counterpart and is reported as not applied.
@chart.key.chart_min app.execution.keyBinding area=diagram key="chart.min" operation="diagram.chart.format" parameter="yMin"
# The floor and the top of the value axis bound one range: "run the y axis from 0 to 10" gives 0 to the floor and 10 to
# the top, said for either key.
@chart.range.axis app.execution.range area=diagram low="chart.min" high="chart.max"
@chart.key.chart_horizontal app.execution.keyBinding area=diagram key="chart.horizontal" operation="diagram.chart.format" parameter="orientation"
@chart.key.chart_horizontal.on app.execution.keyValue area=diagram key="chart.horizontal" said="on" value="horizontal"
@chart.key.chart_horizontal.true app.execution.keyValue area=diagram key="chart.horizontal" said="true" value="horizontal"
@chart.key.chart_horizontal.horizontal app.execution.keyValue area=diagram key="chart.horizontal" said="horizontal" value="horizontal"
@chart.key.chart_horizontal.off app.execution.keyValue area=diagram key="chart.horizontal" said="off" value="vertical"
@chart.key.chart_horizontal.false app.execution.keyValue area=diagram key="chart.horizontal" said="false" value="vertical"
@chart.key.chart_horizontal.vertical app.execution.keyValue area=diagram key="chart.horizontal" said="vertical" value="vertical"
@chart.key.chart_stacked app.execution.keyBinding area=diagram key="chart.stacked" operation="diagram.chart.format" parameter="stacking"
@chart.key.chart_stacked.stacked app.execution.keyValue area=diagram key="chart.stacked" said="stacked" value="stacked"
@chart.key.chart_stacked.on app.execution.keyValue area=diagram key="chart.stacked" said="on" value="stacked"
@chart.key.chart_stacked.true app.execution.keyValue area=diagram key="chart.stacked" said="true" value="stacked"
@chart.key.chart_stacked.off app.execution.keyValue area=diagram key="chart.stacked" said="off" value="none"
@chart.key.chart_stacked.false app.execution.keyValue area=diagram key="chart.stacked" said="false" value="none"
@chart.key.chart_stacked.grouped app.execution.keyValue area=diagram key="chart.stacked" said="grouped" value="none"
@chart.key.chart_stacked.percent app.execution.keyValue area=diagram key="chart.stacked" said="percent" value="percent"
@chart.key.chart_stacked.hundred app.execution.keyValue area=diagram key="chart.stacked" said="100%" value="percent"
@chart.key.chart_width app.execution.keyBinding area=diagram key="chart.width" operation="diagram.chart.format" parameter="width"
@chart.key.chart_height app.execution.keyBinding area=diagram key="chart.height" operation="diagram.chart.format" parameter="height"
@chart.key.chart_effect app.execution.keyBinding area=diagram key="chart.effect" operation="diagram.chart.format" parameter="effect"
@chart.key.chart_effect.shadow app.execution.keyValue area=diagram key="chart.effect" said="shadow" value="shadow"
@chart.key.chart_effect.glow app.execution.keyValue area=diagram key="chart.effect" said="glow" value="glow"
@chart.key.chart_effect.none app.execution.keyValue area=diagram key="chart.effect" said="none" value="none"
@chart.key.chart_effect.off app.execution.keyValue area=diagram key="chart.effect" said="off" value="none"
# A comparative of a chart's size ("make the chart wider", "taller") is one step of the scale of size from the size the
# plot is observed with (its own or the usual room).
@chart.width.values app.execution.values concept=diagram.sketch.group.width valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.width.measure app.execution.observedMeasure concept=diagram.sketch.group.width sourceType="diagram.sketch.group" parameter="width" binding="diagram.group.width" order=16
@chart.height.values app.execution.values concept=diagram.sketch.group.height valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.height.measure app.execution.observedMeasure concept=diagram.sketch.group.height sourceType="diagram.sketch.group" parameter="height" binding="diagram.group.height" order=17
# A chart's series beyond its first (w.diagram.series) is made by diagram.chart.series.add, changed and removed by its
# series operations; its values are numbers said as a list; the chart a new series belongs to is the one named.
@series.kind app.execution.kindBinding area=diagram kind=w.diagram.series operation="diagram.chart.series.add"
@series.key.values app.execution.keyBinding area=diagram key="series.values" operation="diagram.chart.series.add" parameter="values" codec="number-list"
@series.key.chart app.execution.keyBinding area=diagram key="series.chart" operation="diagram.chart.series.add" parameter="chart"
# A series named by its label ("make the Target series gray") is picked by the label it is observed with.
@series.label.observed app.execution.observedMeasure concept=diagram.sketch.series.label sourceType="diagram.sketch.series" parameter="label" binding="diagram.series.label" order=18
# A chart point (worlds/diagram.sketch/chart-shape.sop) is made by diagram.chart.point.add and changed and removed by
# its point operations; its value is a number; the chart it lies in is named by its title (point.chart), and the
# category it is (chart.labels) is the label it is observed with, so "in Revenue, set March to 40" picks the point.
@point.kind app.execution.kindBinding area=diagram kind=w.diagram.datum operation="diagram.chart.point.add"
@point.key.value app.execution.keyBinding area=diagram key="point.value" operation="diagram.chart.point.change" parameter="value"
# A point's value changed by an amount ("bump Thu up by 70", "March should drop by 4") is the point operation's amount
# for that direction (add, subtract), from the value the point has.
@point.amount.more app.execution.amount area=diagram key="point.value" step=more as="point.add"
@point.amount.less app.execution.amount area=diagram key="point.value" step=less as="point.subtract"
@point.key.add app.execution.keyBinding area=diagram key="point.add" operation="diagram.chart.point.change" parameter="add"
@point.key.subtract app.execution.keyBinding area=diagram key="point.subtract" operation="diagram.chart.point.change" parameter="subtract"
@chart.key.point app.execution.keyBinding area=diagram key="point.chart" operation="diagram.chart.point.add" parameter="chart"
@point.chart.observed app.execution.observedMeasure concept=diagram.sketch.point.chart sourceType="diagram.sketch.point" parameter="chart" binding="diagram.point.chart" order=19
@point.label.observed app.execution.observedMeasure concept=diagram.sketch.group.labels sourceType="diagram.sketch.point" parameter="label" binding="diagram.point.label" order=20
# A chart's categories and its series are in order: "the third bar", "the first month" pick a point by its place among
# its chart's categories; "the second series" a series by its place among its chart's series (the members are the
# first). The place is observed on each as its index.
@point.position app.execution.position area=diagram type="point" key="point.index" sourceType="diagram.sketch.point" binding="diagram.point.index"
@series.position app.execution.position area=diagram type="series" key="series.index" sourceType="diagram.sketch.series" binding="diagram.series.index"
@chart.key.diagram_background app.execution.keyBinding area=diagram key="diagram.background" operation="diagram.page.change" parameter="background"
@chart.key.page_background app.execution.keyBinding area=diagram key="page.background" operation="diagram.page.change" parameter="background"
@chart.key.page_title app.execution.keyBinding area=diagram key="page.title" operation="diagram.page.change" parameter="title"
# A chart asked for without values starts from three sample values, which the reply names; the data can then be
# edited ("set 1 to 5") or the chart undone. Categories not given are numbered after the values (given or sample),
# so values said alone ("a bar chart with values 4, 9") keep their own count.
@chart.sample.1 std.capability.item index=0 value=3
@chart.sample.2 std.capability.item index=1 value=5
@chart.sample.3 std.capability.item index=2 value=2
@chart.sample.values std.capability.list member=$chart.sample.1 member=$chart.sample.2 member=$chart.sample.3
@chart.values std.capability.seed operation="diagram.group.chart.make" parameter="values" source=value value=$chart.sample.values phase=missing order=126 notice="I used sample values; you can change them or undo."
@chart.labels std.capability.seed operation="diagram.group.chart.make" parameter="labels" source=ordinal.list from="values" phase=missing order=127 notice="I numbered the categories because no labels were supplied."

# The canvas unit and the length units said with a number on Drawing and Diagram (96 pixels to the inch).
@unit.canvas app.execution.canvasUnit unit="canvas.pixel" word="pixel" word="pixels" word="px"
@unit.inch app.execution.lengthUnit unit=k.units.unit.inch to="canvas.pixel" factor=96
@unit.centimetre app.execution.lengthUnit unit=k.units.unit.centimetre to="canvas.pixel" factor=37.7952755906
@unit.millimetre app.execution.lengthUnit unit=k.units.unit.millimetre to="canvas.pixel" factor=3.77952755906

# The diagram page's flow direction (diagram.layout direction): "after" and "before" are a side of the anchor in it.
@flow.page app.execution.flow sourceType="diagram.sketch.page" field="direction"
# "what colour is the house?": its fill #ffa500 is said as orange.
@answer.rgbName app.execution.codeName prefix="#" channels=3 width=2 radix=16 values=colour
