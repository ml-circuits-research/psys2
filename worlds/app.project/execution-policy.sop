@policy.schema core.use world=app.execution prefix=false
@empty std.capability.list
@document.blocks std.capability.seed operation="document.write" parameter="blocks" source=value value=$empty phase=missing order=120
@calendar.start std.capability.seed operation="calendar.meeting.add" parameter="start" source=clock phase=missing order=121 notice="I scheduled it starting now."
@calendar.duration std.capability.seed operation="calendar.meeting.add" parameter="duration" source=value value=1800000 phase=missing order=122 notice="I used a 30-minute duration."
@calendar.participants std.capability.seed operation="calendar.meeting.add" parameter="participants" source=value value=$empty phase=missing order=123
@calendar.room std.capability.seed operation="calendar.meeting.add" parameter="room" source=value value=null phase=missing order=124
# A diagram node named only by its family ("a box", "a node", "a step") is drawn with the usual shape of a step of the
# diagram's default form: a flowchart (w.diagram.diagram.form default) draws a process step as a rectangle
# (k.diagrams.shape.flowchart.process). The reply says so; the shape can be changed or the step undone.
@diagram.node.shape std.capability.seed operation="diagram.node.make" kind=w.diagram.node parameter="kind" source=value value="rectangle" phase=missing order=125 notice="I chose the shape; you can change it or undo."
@colour app.execution.values concept=colour valueType="k.colours.colour" nameKey="name" valueKey="rgb" codec=lookup
@drawing.colour app.execution.observedProperty concept=colour sourceType="art.draw.object" parameter="color" binding="drawing.object.color" format=rgb codec=lookup order=0
# A chart's values are observed on the chart group (its members' values, diagram act-rules.sop observe.group.values).
@observed.chart.values app.execution.observedProperty concept=diagram.sketch.group.values sourceType="diagram.sketch.group" parameter="values" binding="diagram.group.values" codec=number.list order=2
@size app.execution.values concept=size valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@drawing.size app.execution.observedMeasure concept=size sourceType="art.draw.object" parameter="size" binding="drawing.object.size" order=1
# A side of a drawn object (its width, its height) is a measure on the same scale of size: a comparative of it
# ("wider", "taller") scales the side the object has now (comparative-projection.sop) and leaves the other.
@width app.execution.values concept=w.drawing.object.width valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@drawing.width app.execution.observedMeasure concept=w.drawing.object.width sourceType="art.draw.object" parameter="width" binding="drawing.object.width" order=2
@height app.execution.values concept=w.drawing.object.height valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
# A part's length on the Avatar tab (k.faces.variant.length) is a step of the catalog's scale of length (short <
# medium < long): "long hair" names the step, "shorter" moves one step down from the part's own length; the tab
# chooses the variant (worlds/ui.avatar/act-rules.sop).
@length app.execution.values concept=k.faces.variant.length valueType="k.values.step" nameKey="name" valueKey="name" codec=lookup
@length.scale app.execution.ordinal concept=k.faces.variant.length scale=length
# One step up or down an ordered scale (comparative-projection.sop: "bigger" as a factor of size, "longer" as a step).
@step.more app.execution.comparative step=more offset=1
@step.less app.execution.comparative step=less offset=-1
@drawing.height app.execution.observedMeasure concept=w.drawing.object.height sourceType="art.draw.object" parameter="height" binding="drawing.object.height" order=3
# A meeting's start is an instant (milliseconds since the Unix epoch) and the calendar keeps its clock in UTC
# (its frame is unix, its views say UTC). A clock time said for it ("3pm", "15:00", "noon", "half past 3 pm")
# is read with the clock knowledge of k.time (hours by name and by the 12-hour clock, clock phrases) and placed on
# the meeting's own day (clock-projection.sop).
@start app.execution.values concept=w.calendar.event.start valueType="k.time.hour" nameKey="name" valueKey="n" codec=lookup
@start.phrases app.execution.knowledge concept=w.calendar.event.start valueType="k.time.clock_phrase"
@start.instant app.execution.instant concept=w.calendar.event.start sourceType="time.calendar.meeting" binding="calendar.meeting.start" zoneOffset=0
# "connect" with a new target makes the joining line; the ends of a diagram line name observed diagram nodes.
@act.connect app.execution.actForm act=connect mode=new as=make of=w.diagram.edge
@edge.from app.execution.reference concept=w.diagram.edge.from sourceType="diagram.sketch.node"
@edge.to app.execution.reference concept=w.diagram.edge.to sourceType="diagram.sketch.node"
# "connect the circles": a chain over every circle in reading order; "connect Start to all circles": a star from Start.
@edge.population app.execution.linkPattern from=w.diagram.edge.from to=w.diagram.edge.to open=chain hub=star max=16 patternConcept=diagram.sketch.link.pattern named=chain named=cycle named=all hubName="label" hubName="name"
@note.population.lines app.execution.populationNote case=lines one="I joined {members} with 1 line ({pattern})." many="I joined {members} with {count} lines ({pattern})."
@note.population.targets app.execution.populationNote case=targets many="I applied it to all {count} matching objects ({members})."
@note.pattern.chain app.execution.linkPatternNote pattern=chain text="a chain in reading order"
@note.pattern.star app.execution.linkPatternNote pattern=star text="a star from the named one"
@note.pattern.all app.execution.linkPatternNote pattern=all text="every pair"
@note.pattern.cycle app.execution.linkPatternNote pattern=cycle text="a cycle in reading order"
@note.standIn app.execution.standInNote key="name" text="There is no drawing of {asked}, so I drew {drawn}."
# "arrange" with what to arrange it as ("lay it out as a tree") changes the layout; with nothing more said ("improve the
# layout", "tidy it up") it is the page's declared improvement (diagram.layout.improve), disclosed and undoable.
@act.arrange app.execution.actForm act=arrange mode=existing as=change results=some
@arrange.improve app.execution.actOperation operation="diagram.layout.improve" act=arrange
# Charts in the Diagram tab are chart groups (diagram.group.chart.make). Each chart kind of the catalog (k.charts.kind)
# is drawn with the chart layout of its form; a chart named only as "a chart" or "a graph" (w.chart.chart) is a bar
# chart. A scatter plot and a dot plot are drawn as scatter charts (chart-shape.sop: points at their x values, else at
# their places); a treemap by its own layout (rectangles as large as their shares); a radar chart has no kind in the
# catalog's chart kinds and is reached by its layout (chart.type).
@chart.kind.chart app.execution.kindBinding area=diagram kind=w.chart.chart operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.bar app.execution.kindBinding area=diagram kind=k.charts.kind.bar_chart operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.grouped app.execution.kindBinding area=diagram kind=k.charts.kind.grouped_bar_chart operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.stacked app.execution.kindBinding area=diagram kind=k.charts.kind.stacked_bar_chart operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.histogram app.execution.kindBinding area=diagram kind=k.charts.kind.histogram operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.line app.execution.kindBinding area=diagram kind=k.charts.kind.line_chart operation="diagram.group.chart.make" parameter="layout" value="line"
@chart.kind.area app.execution.kindBinding area=diagram kind=k.charts.kind.area_chart operation="diagram.group.chart.make" parameter="layout" value="area"
@chart.kind.pie app.execution.kindBinding area=diagram kind=k.charts.kind.pie_chart operation="diagram.group.chart.make" parameter="layout" value="pie"
@chart.kind.scatter app.execution.kindBinding area=diagram kind=k.charts.kind.scatter_plot operation="diagram.group.chart.make" parameter="layout" value="scatter"
@chart.kind.dot app.execution.kindBinding area=diagram kind=k.charts.kind.dot_plot operation="diagram.group.chart.make" parameter="layout" value="scatter"
@chart.kind.treemap app.execution.kindBinding area=diagram kind=k.charts.kind.treemap operation="diagram.group.chart.make" parameter="layout" value="treemap"
# A person's pose, expression and trait (figure-rules.sop) are named by the knowledge: the reader's class value of each
# is one of the names k.faces gives them (k.faces.pose style=figure, k.faces.expression and k.faces.trait style=plain),
# said by any of its words (the mention is the evidence; the tool also takes the words themselves, figure-rules.sop).
# The list repeats those names so the binding completion can read it (keep it equal to k.faces/shards/figure-poses.sop,
# presets.sop and traits.sop).
# A direction said for a move ("move the house left") is the move operation's direction.
@drawing.key.direction app.execution.keyBinding area=drawing key="drawn.direction" operation="drawing.object.move" parameter="direction"
@drawing.key.direction.left app.execution.keyValue area=drawing key="drawn.direction" said="left" value="left"
@drawing.key.direction.right app.execution.keyValue area=drawing key="drawn.direction" said="right" value="right"
@drawing.key.direction.up app.execution.keyValue area=drawing key="drawn.direction" said="up" value="up"
@drawing.key.direction.down app.execution.keyValue area=drawing key="drawn.direction" said="down" value="down"
@drawing.key.pose app.execution.keyBinding area=drawing key="drawn.pose" operation="drawing.object.change" parameter="pose"
@drawing.key.pose.standing app.execution.keyValue area=drawing key="drawn.pose" said="standing" value="standing"
@drawing.key.pose.arms_up app.execution.keyValue area=drawing key="drawn.pose" said="arms up" value="arms up"
@drawing.key.pose.waving app.execution.keyValue area=drawing key="drawn.pose" said="waving" value="waving"
@drawing.key.pose.pointing app.execution.keyValue area=drawing key="drawn.pose" said="pointing" value="pointing"
@drawing.key.pose.holding app.execution.keyValue area=drawing key="drawn.pose" said="holding" value="holding"
@drawing.key.pose.reaching_up app.execution.keyValue area=drawing key="drawn.pose" said="reaching up" value="reaching up"
@drawing.key.pose.hands_on_hips app.execution.keyValue area=drawing key="drawn.pose" said="hands on hips" value="hands on hips"
@drawing.key.pose.clapping app.execution.keyValue area=drawing key="drawn.pose" said="clapping" value="clapping"
@drawing.key.pose.sitting app.execution.keyValue area=drawing key="drawn.pose" said="sitting" value="sitting"
@drawing.key.pose.seated app.execution.keyValue area=drawing key="drawn.pose" said="seated" value="seated"
@drawing.key.pose.cross_legged app.execution.keyValue area=drawing key="drawn.pose" said="cross legged" value="cross legged"
@drawing.key.pose.kicking app.execution.keyValue area=drawing key="drawn.pose" said="kicking" value="kicking"
@drawing.key.pose.running app.execution.keyValue area=drawing key="drawn.pose" said="running" value="running"
@drawing.key.pose.walking app.execution.keyValue area=drawing key="drawn.pose" said="walking" value="walking"
@drawing.key.pose.jumping app.execution.keyValue area=drawing key="drawn.pose" said="jumping" value="jumping"
@drawing.key.pose.dancing app.execution.keyValue area=drawing key="drawn.pose" said="dancing" value="dancing"
@drawing.key.expression app.execution.keyBinding area=drawing key="drawn.expression" operation="drawing.object.change" parameter="expression"
@drawing.key.expression.happy app.execution.keyValue area=drawing key="drawn.expression" said="happy" value="happy"
@drawing.key.expression.sad app.execution.keyValue area=drawing key="drawn.expression" said="sad" value="sad"
@drawing.key.expression.angry app.execution.keyValue area=drawing key="drawn.expression" said="angry" value="angry"
@drawing.key.expression.surprised app.execution.keyValue area=drawing key="drawn.expression" said="surprised" value="surprised"
@drawing.key.expression.sleepy app.execution.keyValue area=drawing key="drawn.expression" said="sleepy" value="sleepy"
@drawing.key.expression.wink app.execution.keyValue area=drawing key="drawn.expression" said="wink" value="wink"
@drawing.key.expression.talking app.execution.keyValue area=drawing key="drawn.expression" said="talking" value="talking"
@drawing.key.expression.smiling app.execution.keyValue area=drawing key="drawn.expression" said="smiling" value="smiling"
@drawing.key.expression.laughing app.execution.keyValue area=drawing key="drawn.expression" said="laughing" value="laughing"
@drawing.key.expression.crying app.execution.keyValue area=drawing key="drawn.expression" said="crying" value="crying"
@drawing.key.expression.shocked app.execution.keyValue area=drawing key="drawn.expression" said="shocked" value="shocked"
@drawing.key.expression.scared app.execution.keyValue area=drawing key="drawn.expression" said="scared" value="scared"
@drawing.key.expression.frowning app.execution.keyValue area=drawing key="drawn.expression" said="frowning" value="frowning"
@drawing.key.trait app.execution.keyBinding area=drawing key="drawn.trait" operation="drawing.object.change" parameter="trait"
@drawing.key.trait.ginger app.execution.keyValue area=drawing key="drawn.trait" said="ginger" value="ginger"
@drawing.key.trait.blond app.execution.keyValue area=drawing key="drawn.trait" said="blond" value="blond"
@drawing.key.trait.dark_haired app.execution.keyValue area=drawing key="drawn.trait" said="dark-haired" value="dark-haired"
@drawing.key.trait.brown_haired app.execution.keyValue area=drawing key="drawn.trait" said="brown-haired" value="brown-haired"
@drawing.key.trait.grey_haired app.execution.keyValue area=drawing key="drawn.trait" said="grey-haired" value="grey-haired"
@drawing.key.trait.bald app.execution.keyValue area=drawing key="drawn.trait" said="bald" value="bald"
@drawing.key.trait.bearded app.execution.keyValue area=drawing key="drawn.trait" said="bearded" value="bearded"
@drawing.key.trait.moustached app.execution.keyValue area=drawing key="drawn.trait" said="moustached" value="moustached"
@drawing.key.trait.beard_and_moustache app.execution.keyValue area=drawing key="drawn.trait" said="beard and moustache" value="beard and moustache"
@drawing.key.trait.freckled app.execution.keyValue area=drawing key="drawn.trait" said="freckled" value="freckled"
@drawing.key.trait.curly_haired app.execution.keyValue area=drawing key="drawn.trait" said="curly-haired" value="curly-haired"
@drawing.key.trait.mohawk app.execution.keyValue area=drawing key="drawn.trait" said="mohawk" value="mohawk"
@drawing.key.trait.ponytail app.execution.keyValue area=drawing key="drawn.trait" said="ponytail" value="ponytail"
@drawing.key.trait.long_haired app.execution.keyValue area=drawing key="drawn.trait" said="long-haired" value="long-haired"
@drawing.key.trait.short_haired app.execution.keyValue area=drawing key="drawn.trait" said="short-haired" value="short-haired"
@drawing.key.trait.spectacled app.execution.keyValue area=drawing key="drawn.trait" said="spectacled" value="spectacled"
@drawing.key.trait.pale_skinned app.execution.keyValue area=drawing key="drawn.trait" said="pale-skinned" value="pale-skinned"
@drawing.key.trait.light_skinned app.execution.keyValue area=drawing key="drawn.trait" said="light-skinned" value="light-skinned"
@drawing.key.trait.tanned app.execution.keyValue area=drawing key="drawn.trait" said="tanned" value="tanned"
@drawing.key.trait.olive_skinned app.execution.keyValue area=drawing key="drawn.trait" said="olive-skinned" value="olive-skinned"
@drawing.key.trait.brown_skinned app.execution.keyValue area=drawing key="drawn.trait" said="brown-skinned" value="brown-skinned"
@drawing.key.trait.dark_skinned app.execution.keyValue area=drawing key="drawn.trait" said="dark-skinned" value="dark-skinned"
# The reader's chart keys name the chart group's formatting by other names (app.execution.keyBinding): the grid is
# the group's gridlines, the shown values its value labels, the scale's top its yMax, the order its sort, the type its
# layout, the palette the colours of its categories, and the chart a point lies in the group's id. Each said value of
# such a key is the parameter value declared for it (app.execution.keyValue); a value with no declared counterpart
# (a legend on top, a scatter chart) is not applied and the reply says so.
@chart.key.grid app.execution.keyBinding area=diagram key="chart.grid" operation="diagram.chart.format" parameter="gridlines"
@chart.key.grid.show app.execution.keyValue area=diagram key="chart.grid" said="show" value="true"
@chart.key.grid.hide app.execution.keyValue area=diagram key="chart.grid" said="hide" value="false"
@chart.key.grid.on app.execution.keyValue area=diagram key="chart.grid" said="on" value="true"
@chart.key.grid.off app.execution.keyValue area=diagram key="chart.grid" said="off" value="false"
@chart.key.values app.execution.keyBinding area=diagram key="chart.show_values" operation="diagram.chart.format" parameter="valueLabels"
@chart.key.values.show app.execution.keyValue area=diagram key="chart.show_values" said="show" value="true"
@chart.key.values.hide app.execution.keyValue area=diagram key="chart.show_values" said="hide" value="false"
@chart.key.values.on app.execution.keyValue area=diagram key="chart.show_values" said="on" value="true"
@chart.key.values.off app.execution.keyValue area=diagram key="chart.show_values" said="off" value="false"
@chart.key.values2 app.execution.keyBinding area=diagram key="chart.showValues" operation="diagram.chart.format" parameter="valueLabels"
@chart.key.values2.show app.execution.keyValue area=diagram key="chart.showValues" said="show" value="true"
@chart.key.values2.hide app.execution.keyValue area=diagram key="chart.showValues" said="hide" value="false"
@chart.key.values2.true app.execution.keyValue area=diagram key="chart.showValues" said="true" value="true"
@chart.key.values2.false app.execution.keyValue area=diagram key="chart.showValues" said="false" value="false"
@chart.key.legend app.execution.keyBinding area=diagram key="chart.legend" operation="diagram.chart.format" parameter="legend"
@chart.key.legend.show app.execution.keyValue area=diagram key="chart.legend" said="show" value="right"
@chart.key.legend.hide app.execution.keyValue area=diagram key="chart.legend" said="hide" value="none"
@chart.key.legend.right app.execution.keyValue area=diagram key="chart.legend" said="right" value="right"
@chart.key.legend.bottom app.execution.keyValue area=diagram key="chart.legend" said="bottom" value="bottom"
@chart.key.legend.none app.execution.keyValue area=diagram key="chart.legend" said="none" value="none"
@chart.key.legend2 app.execution.keyBinding area=diagram key="chart.showLegend" operation="diagram.chart.format" parameter="legend"
@chart.key.legend2.show app.execution.keyValue area=diagram key="chart.showLegend" said="show" value="right"
@chart.key.legend2.hide app.execution.keyValue area=diagram key="chart.showLegend" said="hide" value="none"
@chart.key.legend2.true app.execution.keyValue area=diagram key="chart.showLegend" said="true" value="right"
@chart.key.legend2.false app.execution.keyValue area=diagram key="chart.showLegend" said="false" value="none"
@chart.key.max app.execution.keyBinding area=diagram key="chart.max" operation="diagram.chart.format" parameter="yMax"
@chart.key.sort app.execution.keyBinding area=diagram key="chart.sort" operation="diagram.chart.sort" parameter="order"
@chart.key.sort.desc app.execution.keyValue area=diagram key="chart.sort" said="desc" value="descending"
@chart.key.sort.asc app.execution.keyValue area=diagram key="chart.sort" said="asc" value="ascending"
@chart.key.sort.alpha app.execution.keyValue area=diagram key="chart.sort" said="alpha" value="label"
@chart.key.type app.execution.keyBinding area=diagram key="chart.type" operation="diagram.chart.format" parameter="layout"
@chart.key.palette app.execution.keyBinding area=diagram key="chart.palette" operation="diagram.chart.format" parameter="palette"
@chart.key.palette.pastel app.execution.keyValue area=diagram key="chart.palette" said="pastel" value="pastel"
@chart.key.palette.monochrome app.execution.keyValue area=diagram key="chart.palette" said="monochrome" value="monochrome"
@chart.key.palette.sunset app.execution.keyValue area=diagram key="chart.palette" said="sunset" value="sunset"
@chart.key.palette.dark app.execution.keyValue area=diagram key="chart.palette" said="dark" value="dark"
@chart.key.palette.forest app.execution.keyValue area=diagram key="chart.palette" said="forest" value="forest"
@chart.key.palette.ocean app.execution.keyValue area=diagram key="chart.palette" said="ocean" value="ocean"
@chart.key.palette.classic app.execution.keyValue area=diagram key="chart.palette" said="classic" value="classic"
@chart.key.palette.vivid app.execution.keyValue area=diagram key="chart.palette" said="vivid" value="vivid"
# Palette names the themes do not carry: the nearest theme palette, disclosed by the reply's effect.
@chart.key.palette.warm app.execution.keyValue area=diagram key="chart.palette" said="warm" value="sunset"
@chart.key.palette.cool app.execution.keyValue area=diagram key="chart.palette" said="cool" value="ocean"
@chart.key.palette.rainbow app.execution.keyValue area=diagram key="chart.palette" said="rainbow" value="vivid"
@chart.key.palette.default app.execution.keyValue area=diagram key="chart.palette" said="default" value="vivid"
# A chart's values are numbers: a said list of them ("27, 32") is read as numbers.
@chart.key.numbers app.execution.keyBinding area=diagram key="chart.values" operation="diagram.group.chart.make" parameter="values" codec="number-list"
@group.key.numbers app.execution.keyBinding area=diagram key="group.values" operation="diagram.group.chart.make" parameter="values" codec="number-list"
# A chart's title is its group's label: the label a new chart is made with, the label a format or a change sets.
@chart.key.title app.execution.keyBinding area=diagram key="chart.title" operation="diagram.group.chart.make" parameter="label"
@chart.key.id app.execution.keyBinding area=diagram key="chart.id" operation="diagram.chart.format" parameter="id"
# The chart formatting and the chart-by-dimension keys (the data drops' chart frames, declared for reader v9) bind to
# the chart group's own parameters (worlds/diagram.sketch/chart-format.sop, act-rules.sop): a number property takes the
# said number or the word that moves it (bigger, thinner, medium); named properties their closed values, with the said
# forms the drops write declared as those values. The page's background and title are the page's.
# A comparative of a chart's number property ("bigger font", "thinner line") is one step of the scale of size from the
# value the chart group is observed with (its own or the usual one), as for a drawn object's size.
@chart.fontSize.values app.execution.values concept=diagram.sketch.group.fontSize valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.fontSize.measure app.execution.observedMeasure concept=diagram.sketch.group.fontSize sourceType="diagram.sketch.group" parameter="fontSize" binding="diagram.group.fontSize" order=10
@chart.lineWidth.values app.execution.values concept=diagram.sketch.group.lineWidth valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.lineWidth.measure app.execution.observedMeasure concept=diagram.sketch.group.lineWidth sourceType="diagram.sketch.group" parameter="lineWidth" binding="diagram.group.lineWidth" order=11
@chart.markerSize.values app.execution.values concept=diagram.sketch.group.markerSize valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.markerSize.measure app.execution.observedMeasure concept=diagram.sketch.group.markerSize sourceType="diagram.sketch.group" parameter="markerSize" binding="diagram.group.markerSize" order=12
@chart.markerEdge.values app.execution.values concept=diagram.sketch.group.markerEdge valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.markerEdge.measure app.execution.observedMeasure concept=diagram.sketch.group.markerEdge sourceType="diagram.sketch.group" parameter="markerEdge" binding="diagram.group.markerEdge" order=13
@chart.barWidth.values app.execution.values concept=diagram.sketch.group.barWidth valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.barWidth.measure app.execution.observedMeasure concept=diagram.sketch.group.barWidth sourceType="diagram.sketch.group" parameter="barWidth" binding="diagram.group.barWidth" order=14
@chart.pieRadius.values app.execution.values concept=diagram.sketch.group.pieRadius valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@chart.pieRadius.measure app.execution.observedMeasure concept=diagram.sketch.group.pieRadius sourceType="diagram.sketch.group" parameter="pieRadius" binding="diagram.group.pieRadius" order=15
@chart.key.chart_fontSize app.execution.keyBinding area=diagram key="chart.fontSize" operation="diagram.chart.format" parameter="fontSize"
@chart.key.chart_lineWidth app.execution.keyBinding area=diagram key="chart.lineWidth" operation="diagram.chart.format" parameter="lineWidth"
@chart.key.chart_markerSize app.execution.keyBinding area=diagram key="chart.markerSize" operation="diagram.chart.format" parameter="markerSize"
@chart.key.chart_markerEdge app.execution.keyBinding area=diagram key="chart.markerEdge" operation="diagram.chart.format" parameter="markerEdge"
@chart.key.chart_barWidth app.execution.keyBinding area=diagram key="chart.barWidth" operation="diagram.chart.format" parameter="barWidth"
