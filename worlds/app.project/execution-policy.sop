@policy.schema core.use world=app.execution prefix=false
@empty app.execution.list
@document.blocks app.execution.default operation="document.write" parameter="blocks" value=$empty
@calendar.start app.execution.default operation="calendar.meeting.add" parameter="start" source=clock.now notice="I scheduled it starting now."
@calendar.duration app.execution.default operation="calendar.meeting.add" parameter="duration" value=1800000 notice="I used a 30-minute duration."
@calendar.participants app.execution.default operation="calendar.meeting.add" parameter="participants" value=$empty
@calendar.room app.execution.default operation="calendar.meeting.add" parameter="room" value=null
@colour app.execution.values concept="colour" valueType="k.colours.colour" nameKey="name" valueKey="rgb"
