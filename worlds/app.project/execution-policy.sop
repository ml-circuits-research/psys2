@policy.schema core.use world=app.execution prefix=false
@empty std.capability.list
@document.blocks std.capability.seed operation="document.write" parameter="blocks" source=value value=$empty phase=missing order=120
@calendar.start std.capability.seed operation="calendar.meeting.add" parameter="start" source=clock phase=missing order=121 notice="I scheduled it starting now."
@calendar.duration std.capability.seed operation="calendar.meeting.add" parameter="duration" source=value value=1800000 phase=missing order=122 notice="I used a 30-minute duration."
@calendar.participants std.capability.seed operation="calendar.meeting.add" parameter="participants" source=value value=$empty phase=missing order=123
@calendar.room std.capability.seed operation="calendar.meeting.add" parameter="room" source=value value=null phase=missing order=124
# A diagram node named only by its family ("a box", "a node", "a step") is drawn with the usual shape of a step of the
# diagram's default form: a flowchart (w.diagram.diagram.form default) draws a process step as a rectangle
# (k.diagrams.shape.flowchart.process). The reply says so; the shape can be changed or the step undone.
@diagram.node.shape std.capability.seed operation="diagram.node.make" kind=w.diagram.node parameter="kind" source=value value="rectangle" phase=missing order=125 notice="I chose the shape; you can change it or undo."
@colour app.execution.values concept=colour valueType="k.colours.colour" nameKey="name" valueKey="rgb" codec=lookup
@drawing.colour app.execution.observedProperty concept=colour sourceType="art.draw.object" parameter="color" binding="drawing.object.color" format=rgb codec=lookup order=0
@size app.execution.values concept=size valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@drawing.size app.execution.observedMeasure concept=size sourceType="art.draw.object" parameter="size" binding="drawing.object.size" order=1
# A side of a drawn object (its width, its height) is a measure on the same scale of size: a comparative of it
# ("wider", "taller") scales the side the object has now (comparative-projection.sop) and leaves the other.
@width app.execution.values concept=w.drawing.object.width valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@drawing.width app.execution.observedMeasure concept=w.drawing.object.width sourceType="art.draw.object" parameter="width" binding="drawing.object.width" order=2
@height app.execution.values concept=w.drawing.object.height valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
# A part's length on the Avatar tab (k.faces.variant.length) is a step of the catalog's scale of length (short <
# medium < long): "long hair" names the step, "shorter" moves one step down from the part's own length; the tab
# chooses the variant (worlds/ui.avatar/act-rules.sop).
@length app.execution.values concept=k.faces.variant.length valueType="k.values.step" nameKey="name" valueKey="name" codec=lookup
@length.scale app.execution.ordinal concept=k.faces.variant.length scale=length
# One step up or down an ordered scale (comparative-projection.sop: "bigger" as a factor of size, "longer" as a step).
@step.more app.execution.comparative step=more offset=1
@step.less app.execution.comparative step=less offset=-1
@drawing.height app.execution.observedMeasure concept=w.drawing.object.height sourceType="art.draw.object" parameter="height" binding="drawing.object.height" order=3
# A meeting's start is an instant (milliseconds since the Unix epoch) and the calendar keeps its clock in UTC
# (its frame is unix, its views say UTC). A clock time said for it ("3pm", "15:00", "noon", "half past 3 pm")
# is read with the clock knowledge of k.time (hours by name and by the 12-hour clock, clock phrases) and placed on
# the meeting's own day (clock-projection.sop).
@start app.execution.values concept=w.calendar.event.start valueType="k.time.hour" nameKey="name" valueKey="n" codec=lookup
@start.phrases app.execution.knowledge concept=w.calendar.event.start valueType="k.time.clock_phrase"
@start.instant app.execution.instant concept=w.calendar.event.start sourceType="time.calendar.meeting" binding="calendar.meeting.start" zoneOffset=0
# "connect" with a new target makes the joining line; the ends of a diagram line name observed diagram nodes.
@act.connect app.execution.actForm act=connect mode=new as=make of=w.diagram.edge
@edge.from app.execution.reference concept=w.diagram.edge.from sourceType="diagram.sketch.node"
@edge.to app.execution.reference concept=w.diagram.edge.to sourceType="diagram.sketch.node"
# "arrange" with what to arrange it as ("lay it out as a tree") changes the layout; with nothing more said ("improve the
# layout", "tidy it up") it is the page's declared improvement (diagram.layout.improve), disclosed and undoable.
@act.arrange app.execution.actForm act=arrange mode=existing as=change results=some
@arrange.improve app.execution.actOperation operation="diagram.layout.improve" act=arrange
# Charts in the Diagram tab are chart groups (diagram.group.chart.make). Each chart kind of the catalog (k.charts.kind)
# is drawn with the chart layout of its form; a chart named only as "a chart" or "a graph" (w.chart.chart) is a bar
# chart. Kinds with no native layout (scatter plot, dot plot) stay unbound and are reported as such.
@chart.kind.chart app.execution.kindBinding area=diagram kind=w.chart.chart operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.bar app.execution.kindBinding area=diagram kind=k.charts.kind.bar_chart operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.grouped app.execution.kindBinding area=diagram kind=k.charts.kind.grouped_bar_chart operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.stacked app.execution.kindBinding area=diagram kind=k.charts.kind.stacked_bar_chart operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.histogram app.execution.kindBinding area=diagram kind=k.charts.kind.histogram operation="diagram.group.chart.make" parameter="layout" value="bar"
@chart.kind.line app.execution.kindBinding area=diagram kind=k.charts.kind.line_chart operation="diagram.group.chart.make" parameter="layout" value="line"
@chart.kind.area app.execution.kindBinding area=diagram kind=k.charts.kind.area_chart operation="diagram.group.chart.make" parameter="layout" value="area"
@chart.kind.pie app.execution.kindBinding area=diagram kind=k.charts.kind.pie_chart operation="diagram.group.chart.make" parameter="layout" value="pie"
# The reader's chart keys name the chart group's formatting by other names (app.execution.keyBinding): the grid is
# the group's gridlines, the shown values its value labels, the scale's top its yMax, the order its sort, the type its
# layout, the palette the colours of its categories, and the chart a point lies in the group's id. Each said value of
# such a key is the parameter value declared for it (app.execution.keyValue); a value with no declared counterpart
# (a legend on top, a scatter chart) is not applied and the reply says so.
@chart.key.grid app.execution.keyBinding area=diagram key="chart.grid" operation="diagram.chart.format" parameter="gridlines"
@chart.key.grid.show app.execution.keyValue area=diagram key="chart.grid" said="show" value="true"
@chart.key.grid.hide app.execution.keyValue area=diagram key="chart.grid" said="hide" value="false"
@chart.key.grid.on app.execution.keyValue area=diagram key="chart.grid" said="on" value="true"
@chart.key.grid.off app.execution.keyValue area=diagram key="chart.grid" said="off" value="false"
@chart.key.values app.execution.keyBinding area=diagram key="chart.show_values" operation="diagram.chart.format" parameter="valueLabels"
@chart.key.values.show app.execution.keyValue area=diagram key="chart.show_values" said="show" value="true"
@chart.key.values.hide app.execution.keyValue area=diagram key="chart.show_values" said="hide" value="false"
@chart.key.values.on app.execution.keyValue area=diagram key="chart.show_values" said="on" value="true"
@chart.key.values.off app.execution.keyValue area=diagram key="chart.show_values" said="off" value="false"
@chart.key.values2 app.execution.keyBinding area=diagram key="chart.showValues" operation="diagram.chart.format" parameter="valueLabels"
@chart.key.values2.show app.execution.keyValue area=diagram key="chart.showValues" said="show" value="true"
@chart.key.values2.hide app.execution.keyValue area=diagram key="chart.showValues" said="hide" value="false"
@chart.key.values2.true app.execution.keyValue area=diagram key="chart.showValues" said="true" value="true"
@chart.key.values2.false app.execution.keyValue area=diagram key="chart.showValues" said="false" value="false"
@chart.key.legend app.execution.keyBinding area=diagram key="chart.legend" operation="diagram.chart.format" parameter="legend"
@chart.key.legend.show app.execution.keyValue area=diagram key="chart.legend" said="show" value="right"
@chart.key.legend.hide app.execution.keyValue area=diagram key="chart.legend" said="hide" value="none"
@chart.key.legend.right app.execution.keyValue area=diagram key="chart.legend" said="right" value="right"
@chart.key.legend.bottom app.execution.keyValue area=diagram key="chart.legend" said="bottom" value="bottom"
@chart.key.legend.none app.execution.keyValue area=diagram key="chart.legend" said="none" value="none"
@chart.key.legend2 app.execution.keyBinding area=diagram key="chart.showLegend" operation="diagram.chart.format" parameter="legend"
@chart.key.legend2.show app.execution.keyValue area=diagram key="chart.showLegend" said="show" value="right"
@chart.key.legend2.hide app.execution.keyValue area=diagram key="chart.showLegend" said="hide" value="none"
@chart.key.legend2.true app.execution.keyValue area=diagram key="chart.showLegend" said="true" value="right"
@chart.key.legend2.false app.execution.keyValue area=diagram key="chart.showLegend" said="false" value="none"
@chart.key.max app.execution.keyBinding area=diagram key="chart.max" operation="diagram.chart.format" parameter="yMax"
@chart.key.sort app.execution.keyBinding area=diagram key="chart.sort" operation="diagram.chart.sort" parameter="order"
@chart.key.sort.desc app.execution.keyValue area=diagram key="chart.sort" said="desc" value="descending"
@chart.key.sort.asc app.execution.keyValue area=diagram key="chart.sort" said="asc" value="ascending"
@chart.key.sort.alpha app.execution.keyValue area=diagram key="chart.sort" said="alpha" value="label"
@chart.key.type app.execution.keyBinding area=diagram key="chart.type" operation="diagram.chart.format" parameter="layout"
@chart.key.palette app.execution.keyBinding area=diagram key="chart.palette" operation="diagram.chart.format" parameter="palette"
@chart.key.palette.pastel app.execution.keyValue area=diagram key="chart.palette" said="pastel" value="pastel"
@chart.key.palette.monochrome app.execution.keyValue area=diagram key="chart.palette" said="monochrome" value="monochrome"
@chart.key.palette.sunset app.execution.keyValue area=diagram key="chart.palette" said="sunset" value="sunset"
@chart.key.palette.dark app.execution.keyValue area=diagram key="chart.palette" said="dark" value="dark"
@chart.key.palette.forest app.execution.keyValue area=diagram key="chart.palette" said="forest" value="forest"
@chart.key.palette.ocean app.execution.keyValue area=diagram key="chart.palette" said="ocean" value="ocean"
@chart.key.palette.classic app.execution.keyValue area=diagram key="chart.palette" said="classic" value="classic"
@chart.key.palette.vivid app.execution.keyValue area=diagram key="chart.palette" said="vivid" value="vivid"
# Palette names the themes do not carry: the nearest theme palette, disclosed by the reply's effect.
@chart.key.palette.warm app.execution.keyValue area=diagram key="chart.palette" said="warm" value="sunset"
@chart.key.palette.cool app.execution.keyValue area=diagram key="chart.palette" said="cool" value="ocean"
@chart.key.palette.rainbow app.execution.keyValue area=diagram key="chart.palette" said="rainbow" value="vivid"
@chart.key.palette.default app.execution.keyValue area=diagram key="chart.palette" said="default" value="vivid"
@chart.key.id app.execution.keyBinding area=diagram key="chart.id" operation="diagram.chart.format" parameter="id"
@chart.key.point app.execution.keyBinding area=diagram key="point.chart" operation="diagram.chart.value" parameter="id"
# A chart asked for without data starts from three sample categories, which the reply names; the data can then be
# edited ("set A to 5") or the chart undone.
@chart.sample.a std.capability.item index=0 value="A"
@chart.sample.b std.capability.item index=1 value="B"
@chart.sample.c std.capability.item index=2 value="C"
@chart.sample.labels std.capability.list member=$chart.sample.a member=$chart.sample.b member=$chart.sample.c
@chart.sample.1 std.capability.item index=0 value=3
@chart.sample.2 std.capability.item index=1 value=5
@chart.sample.3 std.capability.item index=2 value=2
@chart.sample.values std.capability.list member=$chart.sample.1 member=$chart.sample.2 member=$chart.sample.3
@chart.labels std.capability.seed operation="diagram.group.chart.make" parameter="labels" source=value value=$chart.sample.labels phase=missing order=126 notice="I used sample data; you can change it or undo."
@chart.values std.capability.seed operation="diagram.group.chart.make" parameter="values" source=value value=$chart.sample.values phase=missing order=127
