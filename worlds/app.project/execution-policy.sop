@policy.schema core.use world=app.execution prefix=false
@empty std.capability.list
@document.blocks std.capability.seed operation="document.write" parameter="blocks" source=value value=$empty phase=missing order=120
@calendar.start std.capability.seed operation="calendar.meeting.add" parameter="start" source=clock phase=missing order=121 notice="I scheduled it starting now."
@calendar.duration std.capability.seed operation="calendar.meeting.add" parameter="duration" source=value value=1800000 phase=missing order=122 notice="I used a 30-minute duration."
@calendar.participants std.capability.seed operation="calendar.meeting.add" parameter="participants" source=value value=$empty phase=missing order=123
@calendar.room std.capability.seed operation="calendar.meeting.add" parameter="room" source=value value=null phase=missing order=124
# A diagram node named only by its family ("a box", "a node", "a step") is drawn with the usual shape of a step of the
# diagram's default form: a flowchart (w.diagram.diagram.form default) draws a process step as a rectangle
# (k.diagrams.shape.flowchart.process). The reply says so; the shape can be changed or the step undone.
@diagram.node.shape std.capability.seed operation="diagram.node.make" kind=w.diagram.node parameter="kind" source=value value="rectangle" phase=missing order=125 notice="I chose the shape; you can change it or undo."
@colour app.execution.values concept=colour valueType="k.colours.colour" nameKey="name" valueKey="rgb" codec=lookup
@drawing.colour app.execution.observedProperty concept=colour sourceType="art.draw.object" parameter="color" binding="drawing.object.color" format=rgb codec=lookup order=0
@size app.execution.values concept=size valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@drawing.size app.execution.observedMeasure concept=size sourceType="art.draw.object" parameter="size" binding="drawing.object.size" order=1
# A side of a drawn object (its width, its height) is a measure on the same scale of size: a comparative of it
# ("wider", "taller") scales the side the object has now (comparative-projection.sop) and leaves the other.
@width app.execution.values concept=w.drawing.object.width valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
@drawing.width app.execution.observedMeasure concept=w.drawing.object.width sourceType="art.draw.object" parameter="width" binding="drawing.object.width" order=2
@height app.execution.values concept=w.drawing.object.height valueType="k.expect.scale" nameKey="step" valueKey="size_factor" codec=degree
# A part's length on the Avatar tab (k.faces.variant.length) is a step of the catalog's scale of length (short <
# medium < long): "long hair" names the step, "shorter" moves one step down from the part's own length; the tab
# chooses the variant (worlds/ui.avatar/act-rules.sop).
@length app.execution.values concept=k.faces.variant.length valueType="k.values.step" nameKey="name" valueKey="name" codec=lookup
@length.scale app.execution.ordinal concept=k.faces.variant.length scale=length
# One step up or down an ordered scale (comparative-projection.sop: "bigger" as a factor of size, "longer" as a step).
@step.more app.execution.comparative step=more offset=1
@step.less app.execution.comparative step=less offset=-1
@drawing.height app.execution.observedMeasure concept=w.drawing.object.height sourceType="art.draw.object" parameter="height" binding="drawing.object.height" order=3
# A meeting's start is an instant (milliseconds since the Unix epoch) and the calendar keeps its clock in UTC
# (its frame is unix, its views say UTC). A clock time said for it ("3pm", "15:00", "noon", "half past 3 pm")
# is read with the clock knowledge of k.time (hours by name and by the 12-hour clock, clock phrases) and placed on
# the meeting's own day (clock-projection.sop).
@start app.execution.values concept=w.calendar.event.start valueType="k.time.hour" nameKey="name" valueKey="n" codec=lookup
@start.phrases app.execution.knowledge concept=w.calendar.event.start valueType="k.time.clock_phrase"
@start.instant app.execution.instant concept=w.calendar.event.start sourceType="time.calendar.meeting" binding="calendar.meeting.start" zoneOffset=0
# "connect" with a new target makes the joining line; the ends of a diagram line name observed diagram nodes.
@act.connect app.execution.actForm act=connect mode=new as=make
@edge.from app.execution.reference concept=w.diagram.edge.from sourceType="diagram.sketch.node"
@edge.to app.execution.reference concept=w.diagram.edge.to sourceType="diagram.sketch.node"
# "arrange" with what to arrange it as ("lay it out as a tree") changes the layout; with nothing more said ("improve the
# layout", "tidy it up") it is the page's declared improvement (diagram.layout.improve), disclosed and undoable.
@act.arrange app.execution.actForm act=arrange mode=existing as=change results=some
@arrange.improve app.execution.actOperation operation="diagram.layout.improve" act=arrange
