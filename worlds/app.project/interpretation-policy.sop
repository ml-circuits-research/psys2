@interpret.schema core.use world=app.interpret prefix=false

# The previous utterance and the observed objects are priors for the reader. While the reading conditioned on them
# stays incomplete, the same text is read without the previous message, then also without the observed objects.
# Every attempt (also an unavailable or failed one) is a world-activity event (app.reader.retry) and a trace entry;
# the first complete one is routed and the reply names the context it actually left out. A re-reading the provider
# cannot make (no previous message) shows that its drop was vacuous for later re-readings.
@interpret.retry.independent app.interpret.retry profile=independent method=proposeIndependent order=1 when=incomplete drops=previous label="Read the request without the previous message"
@interpret.retry.literal app.interpret.retry profile=literal method=proposeLiteral order=2 when=incomplete drops=previous drops=objects label="Read the request without the previous message or the observed objects"
@interpret.note.previous app.interpret.note drops=previous text="I read this message on its own, without the previous one."
@interpret.note.objects app.interpret.note drops=objects text="I read this message on its own, without the objects on the page."
@interpret.note.both app.interpret.note drops=previous drops=objects text="I read this message on its own, without the previous one or the objects on the page."

# Several admitted readings are compared by the declared interpreter only in uncalibrated best-effort mode and only
# for a bounded number of proposals; outside the bounds the admitted top reading is routed (trace: readingComparison absent).
@interpret.compare.best-effort app.interpret.compare mode=uncalibrated-best-effort min=2 max=16

# A single make request is first offered to the coordination reader (noun phrases joined by and/commas).
@interpret.coordination.make app.interpret.coordination act=make requests=1

# A browser-detected input language replaces the selected one at or above this confidence.
@interpret.language.detect app.interpret.language role=detect min.confidence=0.8

# Partial admission is the default (owner, Review29; specs/semantic-frame.md §5). A reading whose roles cannot all be
# bound executes its consistent part when its act class is reversible (reader-admission-policy.sop
# reader.permit.partial); the reply names each dropped role and why, and undo covers the whole message.

# Fields the reader left out. A request with no act whose theme is new states that the thing exists (a scene
# description: "a small sun in the top right corner"), so it is made; a new theme is made, any other is existing.
@interpret.default.mood app.interpret.default field=mood value=do
@interpret.default.act.new app.interpret.default field=act when=target.new value=make
@interpret.default.mode.make app.interpret.default field=mode when=act.make value=new
@interpret.default.mode app.interpret.default field=mode value=existing
@interpret.default.phase app.interpret.default field=phase value=result
@interpret.default.operator app.interpret.default field=operator value=eq
@interpret.default.character app.interpret.default field=character value=requirement
@interpret.default.polarity app.interpret.default field=polarity value=positive

# Reply wording per drop reason.
@interpret.drop.generic app.interpret.drop reason=generic text="I could not read it"
@interpret.drop.property app.interpret.drop reason=unresolved-canonical-property-binding text="no tool here takes that property"
@interpret.drop.value app.interpret.drop reason=unresolved-source-value-normalization text="I could not read its value"
@interpret.drop.representation app.interpret.drop reason=unresolved-value-representation text="I could not read its value"
@interpret.drop.relation app.interpret.drop reason=undeclared-relation-value text="that relation is not declared here"
@interpret.drop.anchor app.interpret.drop reason=unresolved-anchor-reference text="I could not find what it is relative to"
@interpret.drop.operator app.interpret.drop reason=requires-operator-reference-projection text="I cannot apply that kind of change yet"
@interpret.drop.context app.interpret.drop reason=context-reference-not-bound text="I used the most likely object"
@interpret.drop.population app.interpret.drop reason=unprojected-population-reference text="I applied it to one object, not to all"
@interpret.drop.ordinal app.interpret.drop reason=requires-declared-ordinal-projection text="I could not use the position in the list"
@interpret.drop.count app.interpret.drop reason=requires-declared-count-projection text="I could not read the number"
@interpret.drop.host app.interpret.drop reason=refused-by-host text="the editor could not apply it together with the rest"
@interpret.drop.several app.interpret.drop reason=several-kind-mentions text="I made only the first thing named; ask for the others one at a time"

# When the editor refuses an admitted partial reading: make the thing with its placement, then change its other
# properties; then without the placement; then the thing alone.
@interpret.fallback.split app.interpret.fallback step=split order=1 text="I placed it first and then changed it."
@interpret.fallback.placement app.interpret.fallback step=without-placement order=2 text="I could not apply the placement."
@interpret.fallback.theme app.interpret.fallback step=theme-only order=3 text="I applied only the thing itself."

# A diagram node read without a kind word ("remove shape 2", "move it up") is a graph node (w.diagram.node): the
# focused or most recent one when it exists, a new step otherwise. Bars and slices are chart points of a chart group,
# which the reader names by the chart family.
@interpret.family.diagram.node app.interpret.family area=diagram family=node kind=w.diagram.node

# Diagram nodes placed relative to another node ("put Review below Draft", "a box called Deliver under Bake"): the
# node.position / node.anchor pair reads as the drawing's relation pair does (like= names the area key whose canonical
# relation concept and anchor role it shares); its values name the placement method's relations. "after"/"before"
# depend on the flow direction and "between" on two anchors: not declared, so they stay disclosed.
@interpret.relation.diagram.node app.interpret.relation area=diagram key="node.position" anchor="node.anchor" like="drawn.relation"
@interpret.relation.diagram.node.above app.interpret.relationValue of=$interpret.relation.diagram.node value="above" relation=above
@interpret.relation.diagram.node.top app.interpret.relationValue of=$interpret.relation.diagram.node value="on top of" relation=above
@interpret.relation.diagram.node.below app.interpret.relationValue of=$interpret.relation.diagram.node value="below" relation=below
@interpret.relation.diagram.node.under app.interpret.relationValue of=$interpret.relation.diagram.node value="under" relation=below
@interpret.relation.diagram.node.leftof app.interpret.relationValue of=$interpret.relation.diagram.node value="left_of" relation=left
@interpret.relation.diagram.node.left app.interpret.relationValue of=$interpret.relation.diagram.node value="left" relation=left
@interpret.relation.diagram.node.rightof app.interpret.relationValue of=$interpret.relation.diagram.node value="right_of" relation=right
@interpret.relation.diagram.node.right app.interpret.relationValue of=$interpret.relation.diagram.node value="right" relation=right
@interpret.relation.diagram.node.nextto app.interpret.relationValue of=$interpret.relation.diagram.node value="next_to" relation=near
@interpret.relation.diagram.node.near app.interpret.relationValue of=$interpret.relation.diagram.node value="near" relation=near
