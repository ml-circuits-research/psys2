@interpret.module core.module name=app.interpret version=1 exports=app.interpret.retry exports=app.interpret.compare exports=app.interpret.coordination exports=app.interpret.areaRetry exports=app.interpret.language exports=app.interpret.note exports=app.interpret.default exports=app.interpret.drop exports=app.interpret.fallback exports=app.interpret.family exports=app.interpret.familyOperation exports=app.interpret.parameterAct exports=app.interpret.spelling exports=app.interpret.spellingStep exports=app.interpret.numberJoiner exports=app.interpret.relation exports=app.interpret.relationValue exports=app.interpret.controlVerb exports=app.interpret.controlModifier

# A re-reading of the same text under a reduced context, tried in order while the reading stays incomplete.
@interpret.retry.type core.type of=app.interpret.retry closed=true
@interpret.retry.profile core.slot of=app.interpret.retry key=profile kind=atom id=true present=true
@interpret.retry.method core.slot of=app.interpret.retry key=method kind=atom present=true
@interpret.retry.order core.slot of=app.interpret.retry key=order kind=integer min=0 present=true
@interpret.retry.when core.slot of=app.interpret.retry key=when kind=atom enum=incomplete present=true
@interpret.retry.label core.slot of=app.interpret.retry key=label kind=string present=true
@interpret.retry.drops core.slot of=app.interpret.retry key=drops kind=atom enum=previous enum=objects many=true present=true

# The reply sentence for the context a used re-reading actually left out (its drops that no earlier available
# re-reading had already shown to be absent).
@interpret.note.type core.type of=app.interpret.note closed=true
@interpret.note.drops core.slot of=app.interpret.note key=drops kind=atom enum=previous enum=objects many=true present=true
@interpret.note.text core.slot of=app.interpret.note key=text kind=string present=true

# Comparing several admitted readings of one text through the declared interpreter.
@interpret.compare.type core.type of=app.interpret.compare closed=true
@interpret.compare.mode core.slot of=app.interpret.compare key=mode kind=atom id=true present=true
@interpret.compare.min core.slot of=app.interpret.compare key=min kind=integer min=2 present=true
@interpret.compare.max core.slot of=app.interpret.compare key=max kind=integer min=2 present=true

# A request read in the active editor that no tool there can take, for one of these reasons, is read again in each other
# live editor whose reader bindings bind a kind word the reading saw (declared area registry order); the first reading an editor fully applies
# is used and that editor is shown.
@interpret.areaRetry.type core.type of=app.interpret.areaRetry closed=true
@interpret.areaRetry.reason core.slot of=app.interpret.areaRetry key=reason kind=atom many=true present=true
@interpret.areaRetry.label core.slot of=app.interpret.areaRetry key=label kind=string present=true

# Which readings are first tried as a coordination of noun phrases.
@interpret.coordination.type core.type of=app.interpret.coordination closed=true
@interpret.coordination.act core.slot of=app.interpret.coordination key=act kind=atom id=true present=true
@interpret.coordination.requests core.slot of=app.interpret.coordination key=requests kind=integer min=1 present=true

# When a detected input language replaces the selected interface language.
@interpret.language.type core.type of=app.interpret.language closed=true
@interpret.language.role core.slot of=app.interpret.language key=role kind=atom id=true enum=detect present=true
@interpret.language.min core.slot of=app.interpret.language key=min.confidence kind=number min=0 max=1 present=true

# The default of a request field the reader left out, optionally only under a condition on the request.
@interpret.default.type core.type of=app.interpret.default closed=true
@interpret.default.field core.slot of=app.interpret.default key=field kind=atom enum=act enum=mood enum=mode enum=phase enum=operator enum=character enum=polarity present=true
@interpret.default.when core.slot of=app.interpret.default key=when kind=atom
@interpret.default.value core.slot of=app.interpret.default key=value kind=atom present=true

# How the reply names a dropped role, per bridge reason (a reason with no row is named by the generic row).
@interpret.drop.type core.type of=app.interpret.drop closed=true
@interpret.drop.reason core.slot of=app.interpret.drop key=reason kind=atom id=true present=true
@interpret.drop.text core.slot of=app.interpret.drop key=text kind=string present=true

# The ordered run-time fallbacks when the host refuses an admitted partial reading; each names what it drops.
@interpret.fallback.type core.type of=app.interpret.fallback closed=true
@interpret.fallback.step core.slot of=app.interpret.fallback key=step kind=atom id=true enum=split enum=without-placement enum=theme-only present=true
@interpret.fallback.order core.slot of=app.interpret.fallback key=order kind=integer min=1 present=true
@interpret.fallback.text core.slot of=app.interpret.fallback key=text kind=string present=true

# A reader family whose targets the binding table leaves unbound when no kind word is read (the table keeps it
# unresolved because the family's raw meaning spans several declared classes), read in partial admission as its
# most common class: the canonical kind named here, with the provenance of that kind's own table row.
@interpret.family.type core.type of=app.interpret.family closed=true
@interpret.family.area core.slot of=app.interpret.family key=area kind=atom present=true
@interpret.family.family core.slot of=app.interpret.family key=family kind=atom present=true
@interpret.family.kind core.slot of=app.interpret.family key=kind kind=atom present=true

# A relative position of an area read as two mentions (a relation key and its anchor key, README of official-dataset)
# whose binding table has no relation projection: the keys' roles and the spatial relation each value names (the
# relation names of the placement method, app.project/spatial-placement.sop). A value with no row stays disclosed.
@interpret.relation.type core.type of=app.interpret.relation closed=true
@interpret.relation.area core.slot of=app.interpret.relation key=area kind=atom present=true
@interpret.relation.key core.slot of=app.interpret.relation key=key kind=string present=true
@interpret.relation.anchor core.slot of=app.interpret.relation key=anchor kind=string present=true
@interpret.relation.like core.slot of=app.interpret.relation key=like kind=string present=true
@interpret.relationValue.type core.type of=app.interpret.relationValue closed=true
@interpret.relationValue.relation core.slot of=app.interpret.relationValue key=of kind=ref to=app.interpret.relation present=true
@interpret.relationValue.value core.slot of=app.interpret.relationValue key=value kind=string present=true
@interpret.relationValue.name core.slot of=app.interpret.relationValue key=relation kind=atom present=true
# How a UI gesture is said back as a command (src/dialog/native-control-intent.mjs) when its operation declares no
# intent verb or parameter label: the verb of each act, the words before a parameter's value, and the verb of an
# act with no row.
@interpret.controlVerb.type core.type of=app.interpret.controlVerb closed=true
@interpret.controlVerb.act core.slot of=app.interpret.controlVerb key=act kind=atom id=true present=true
@interpret.controlVerb.text core.slot of=app.interpret.controlVerb key=text kind=string present=true
@interpret.controlModifier.type core.type of=app.interpret.controlModifier closed=true
@interpret.controlModifier.parameter core.slot of=app.interpret.controlModifier key=parameter kind=atom id=true present=true
@interpret.controlModifier.text core.slot of=app.interpret.controlModifier key=text kind=string present=true

# A reader family whose objects are one source type the binding table gives no operation (the drawing page): the
# operation that names that source type, so a reference to the family ("the canvas", "it" for the page) binds.
@interpret.familyOperation.type core.type of=app.interpret.familyOperation closed=true
@interpret.familyOperation.area core.slot of=app.interpret.familyOperation key=area kind=atom present=true
@interpret.familyOperation.family core.slot of=app.interpret.familyOperation key=family kind=atom present=true
@interpret.familyOperation.operation core.slot of=app.interpret.familyOperation key=operation kind=string present=true

# A key the deployed binding table predates binds to the parameter of its name on its family's source type
# (sopworld completeStructuralBindings): an operation of these acts first, in order, else the first declaring it.
@interpret.parameterAct.type core.type of=app.interpret.parameterAct closed=true
@interpret.parameterAct.act core.slot of=app.interpret.parameterAct key=act kind=atom many=true present=true

# How far a said kind word may be from a declared kind of its family and still name it (sopworld readLexicalPhrase):
# a word of at least minLength letters; a letter typed twice; two neighbouring letters swapped; else the entries
# within the edits of the longest step whose `above` the word's length exceeds, when they all name one kind.
@interpret.spelling.type core.type of=app.interpret.spelling closed=true
@interpret.spelling.minLength core.slot of=app.interpret.spelling key=minLength kind=integer present=true
@interpret.spelling.doubled core.slot of=app.interpret.spelling key=doubled kind=atom enum=true enum=false present=true
@interpret.spelling.swapped core.slot of=app.interpret.spelling key=swapped kind=atom enum=true enum=false present=true
@interpret.spellingStep.type core.type of=app.interpret.spellingStep closed=true
@interpret.spellingStep.above core.slot of=app.interpret.spellingStep key=above kind=integer present=true
@interpret.spellingStep.edits core.slot of=app.interpret.spellingStep key=edits kind=integer present=true
# A word allowed inside a run of number words after a hundred or a scale word ("two hundred and six").
@interpret.numberJoiner.type core.type of=app.interpret.numberJoiner closed=true
@interpret.numberJoiner.text core.slot of=app.interpret.numberJoiner key=text kind=string present=true
