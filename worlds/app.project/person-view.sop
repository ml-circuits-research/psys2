@person.schema core.use world=app.person prefix=false

# What the conversation knows about the person (spec 23 "The person of the session"): the told w.person facts of
# session.things, shown in Settings > Privacy. The host reads these rows (src/dialog/person-view.mjs); it names no
# type or slot of its own.
@person.name app.person.row label="Name" of=w.person.person key=name order=1
@person.age app.person.row label="Age" of=w.person.person key=age order=2
@person.job app.person.row label="Job" of=w.person.person key=occupation order=3
@person.languages app.person.row label="Languages" of=w.person.person key=language many=true order=4
@person.family app.person.row label="Family" of=w.person.relative key=relation with=count many=true order=5
@person.likes app.person.row label="Likes" of=w.person.taste key=thing where=stance is=likes many=true order=6
@person.dislikes app.person.row label="Does not like" of=w.person.taste key=thing where=stance is=dislikes many=true order=7
