@place.default.schema core.use world=app.placement prefix=false
@place.choice.schema core.use world=std.choice
@place.choice.criteria core.use world=std.decide

# Objective values for keys an area's app.place.objective leaves out (grid: the frame's shorter side divided by
# gridDivisions; fy: the vertical share of a region its centre pull aims at).
@place.default app.placement.default gap=0 peerWeight=100 centreWeight=1 stackWeight=50 avoidWeight=1000000 budget=2000 groupBudget=3000 gridDivisions=40 fy=50

# Which solved candidate region is used: the fewest overlaps with observed objects, then the earliest in the
# area's declared region order (for a group: the earliest level). The solver stops at the first candidate with no
# overlap, which these criteria already rank first.
@place.region.overlaps std.decide.criterion of=app.place.region n=1 name=overlaps measure=overlaps dir=min
@place.region.order std.decide.criterion of=app.place.region n=2 name=declared.order measure=order dir=min

# "put the sun above the house" with no sun on the page also reads as asking for one, placed as requested: an unnamed,
# unselected definite subject of the relation is made new (indefinite) and the place request becomes a make.
@place.hypothesis.create app.placement.hypothesis name=create-absent-target rank=1 when=unbound-target act=place act.to=make mode=existing mode.to=new determiner=definite determiner.to=indefinite

# "draw a house next to a tree" with no tree on the page also reads as asking for both: the tree is drawn first (a new
# one, placed by default) and the house next to it; disclosed, one undo. Moving an existing thing next to an absent one
# ("put the house next to a lake") is not declared: it stays refused and said.
@place.hypothesis.anchor app.placement.hypothesis name=create-absent-anchor rank=2 when=unbound-target act=make act.to=make mode=existing mode.to=new determiner=definite determiner.to=indefinite role=anchor

# Disclosure of a placement method fallback (spatial-placement.sop fallback=), in the reply after the effect.
@place.disclosure.shrink app.placement.disclosure stage=shrink text="There is no room {relation} {anchor} within the page at its full size, so I drew it smaller."
@place.disclosure.shift app.placement.disclosure stage=shift text="There is no room right {relation} {anchor} within the page, so I placed it as close to that side as the page allows."
@place.disclosure.side app.placement.disclosure stage=side text="There is no room {relation} {anchor} within the page, so I placed it on its {direction} side instead."
@place.word.left app.placement.relationWord relation=left text="left of"
@place.word.right app.placement.relationWord relation=right text="right of"
@place.word.above app.placement.relationWord relation=above text="above"
@place.word.below app.placement.relationWord relation=below text="below"
@place.word.near app.placement.relationWord relation=near text="near"
