@place.default.module core.module name=app.placement version=1 exports=app.placement.default exports=app.placement.verification exports=app.placement.hypothesis exports=app.placement.disclosure exports=app.placement.relationWord

# Application defaults for the default-placement problem: used only for an objective key the area's own
# app.place.objective does not declare; every key taken from here is reported with the solution (trace: defaulted).
@place.default.type core.type of=app.placement.default closed=true
@place.default.gap core.slot of=app.placement.default key=gap kind=number min=0 present=true
@place.default.peer core.slot of=app.placement.default key=peerWeight kind=number min=0 present=true
@place.default.centre core.slot of=app.placement.default key=centreWeight kind=number min=0 present=true
@place.default.stack core.slot of=app.placement.default key=stackWeight kind=number min=0 present=true
@place.default.avoid core.slot of=app.placement.default key=avoidWeight kind=number min=0 present=true
@place.default.budget core.slot of=app.placement.default key=budget kind=integer min=1 present=true
@place.default.group core.slot of=app.placement.default key=groupBudget kind=integer min=1 present=true
@place.default.grid core.slot of=app.placement.default key=gridDivisions kind=integer min=1 present=true
@place.default.fy core.slot of=app.placement.default key=fy kind=number min=0 max=100 present=true

# A ranked alternative reading of a relation placement whose compiled problem fails for `when` (the compiler's
# reason): the request's act and its relation subjects' target mode and determiner are rewritten as declared. The
# reading as given always ranks first (rank 0); a hypothesis is tried only after it fails, and its use is disclosed.
@place.hypothesis.type core.type of=app.placement.hypothesis closed=true
@place.hypothesis.name core.slot of=app.placement.hypothesis key=name kind=atom id=true present=true
@place.hypothesis.rank core.slot of=app.placement.hypothesis key=rank kind=integer min=1 present=true
@place.hypothesis.when core.slot of=app.placement.hypothesis key=when kind=atom present=true
@place.hypothesis.act core.slot of=app.placement.hypothesis key=act kind=atom present=true
@place.hypothesis.act.to core.slot of=app.placement.hypothesis key=act.to kind=atom present=true
@place.hypothesis.mode core.slot of=app.placement.hypothesis key=mode kind=atom present=true
@place.hypothesis.mode.to core.slot of=app.placement.hypothesis key=mode.to kind=atom present=true
@place.hypothesis.determiner core.slot of=app.placement.hypothesis key=determiner kind=atom present=true
@place.hypothesis.determiner.to core.slot of=app.placement.hypothesis key=determiner.to kind=atom present=true
# role: whose reading is rewritten, the relation's subject (default) or its anchor. An anchor hypothesis makes the
# anchor first (a new one of its kind, placed by default), then places the subject as asked; it applies only to an
# anchor named by its kind alone, and the made anchor is undone with the rest when the placement still fails.
@place.hypothesis.role core.slot of=app.placement.hypothesis key=role kind=atom enum=subject enum=anchor

# How a placement that used one of the placement method's fallbacks (std.placement.result fallback=: no room on the
# stated side within the page) is said in the reply: the declared text, with {relation} (the relation's words, below),
# {anchor} (the anchor's id) and {direction} (the side the chosen place is on) filled in.
@place.disclosure.type core.type of=app.placement.disclosure closed=true
@place.disclosure.stage core.slot of=app.placement.disclosure key=stage kind=atom id=true present=true
@place.disclosure.text core.slot of=app.placement.disclosure key=text kind=string present=true
@place.relation.word.type core.type of=app.placement.relationWord closed=true
@place.relation.word.relation core.slot of=app.placement.relationWord key=relation kind=atom id=true present=true
@place.relation.word.text core.slot of=app.placement.relationWord key=text kind=string present=true
# How exactly an executed placement must reach its planned geometry to count as verified: the relative tolerance
# (|wanted - observed| <= tolerance * max(1, |wanted|)).
@place.verification.type core.type of=app.placement.verification closed=true
@place.verification.tolerance core.slot of=app.placement.verification key=tolerance kind=number present=true

