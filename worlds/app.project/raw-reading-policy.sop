@reading.types core.use world=app.reading prefix=false

# Declared re-readings of a raw reader proposal before it is bridged (specs/semantic-frame.md §5). The feeder
# (src/dialog/raw-reading-policy.mjs) tells the reading's facts and applies what these rules conclude; it decides nothing.

# A request whose target is neither bound nor named.
@el.target app.reading.target request=?r
@el.bound app.reading.target request=?r mode="bound"
@el.named app.reading.target request=?r nameSpan=?n
@el.out app.reading.eligible request=?r
@rule.eligible core.rule when=$el.target not=$el.bound not=$el.named then=$el.out

# ---- Number agreement (2026-11-21) ---------------------------------------------------------------------------------
# The indefinite (singular) article counts one: a plural kind phrase under it ("draw a women") names the kind of its
# singular, so the request binds what its singular binds (quantity-projection.mjs applies it, as for a counted kind).
@sg.t app.reading.target request=?r determiner="indefinite" kindSpan=?s
@sg.f app.reading.form text=?s singular=?g
@sg.d core.check fn=neq args=?s args=?g
@sg.out app.reading.bySingular request=?r
@rule.singular.indefinite core.rule when=$sg.t when=$sg.f if=$sg.d then=$sg.out

# ---- One value, one role (2026-11-21) -------------------------------------------------------------------------------
# A said value fills one key. When the reader gives the same value span to two keys ("that moon skewed 20 degrees":
# rotation and skew) and the request says the concept word of one of them only, the other reading of the span is dropped.
# The words that say a key's concept besides its own name: the width of a drawn outline (a "4px outline" is its stroke
# width), the font style of a node's text.
@word.stroke.outline app.reading.word key="drawn.stroke" text="outline"
@word.stroke.border app.reading.word key="drawn.stroke" text="border"
@word.stroke.stroke app.reading.word key="drawn.stroke" text="stroke"
@word.stroke.line app.reading.word key="drawn.stroke" text="line"
@sr.a app.reading.span request=?r index=?i key=?k start=?s end=?e
@sr.b app.reading.span request=?r index=?j key=?k2 start=?s end=?e
@sr.diff core.check fn=neq args=?k args=?k2
@sr.ev app.reading.evidence request=?r key=?k
@sr.ev2 app.reading.evidence request=?r key=?k2
@sr.out app.reading.drop request=?r index=?j
@rule.span.one.role core.rule when=$sr.a when=$sr.b if=$sr.diff when=$sr.ev not=$sr.ev2 then=$sr.out

# ---- A value word of another key (2026-11-21) ------------------------------------------------------------------------
# A constraint whose value span says a declared value word of another key of the same family ("in italics": the font
# style italic) and neither its own value nor a word of its own key is that key and value: the reader had no head for
# the key and gave the nearest one it knew ("italic" read as the font weight bold). A constraint that only repeats a
# re-keyed one (same key and value) and says nothing of its own is dropped; one that says its own value stays, so
# "bold and italic" sets both.
@vw.style.italic app.reading.valueWord key="node.fontStyle" keyType="node" value="italic" text="italic"
@vw.style.slant app.reading.valueWord key="node.fontStyle" keyType="node" value="italic" text="slant"
@vw.style.oblique app.reading.valueWord key="node.fontStyle" keyType="node" value="italic" text="oblique"
@oe.s app.reading.span request=?r index=?i key=?k value=?v
@oe.says app.reading.spanSays request=?r index=?i text=?v
@oe.out app.reading.spanEvidence request=?r index=?i
@rule.span.evidence.value core.rule when=$oe.s when=$oe.says then=$oe.out
@oe.w app.reading.word key=?k text=?t
@oe.wsays app.reading.spanSays request=?r index=?i text=?t
@rule.span.evidence.word core.rule when=$oe.s when=$oe.w when=$oe.wsays then=$oe.out
@rk.s app.reading.span request=?r index=?i key=?k keyType=?kt
@rk.w app.reading.valueWord key=?k2 keyType=?kt value=?v2 text=?t
@rk.says app.reading.spanSays request=?r index=?i text=?t
@rk.diff core.check fn=neq args=?k args=?k2
@rk.out app.reading.rekey request=?r index=?i key=?k2 value=?v2
@rule.span.rekey core.rule when=$rk.s when=$rk.w when=$rk.says if=$rk.diff not=$oe.out then=$rk.out
@dd.a app.reading.span request=?r index=?i key=?k value=?v
@dd.b app.reading.span request=?r index=?j key=?k value=?v
@dd.ne core.check fn=neq args=?i args=?j
@dd.rk app.reading.rekey request=?r index=?i
@dd.rkj app.reading.rekey request=?r index=?j
@dd.evj app.reading.spanEvidence request=?r index=?j
@dd.out app.reading.drop request=?r index=?j
@rule.span.repeat core.rule when=$dd.a when=$dd.b if=$dd.ne when=$dd.rk not=$dd.rkj not=$dd.evj then=$dd.out

# ---- A family named by a kindless make (2026-11-21) -----------------------------------------------------------------
# A make whose target has no kind ("a new page": the reader gave a node and no kind word) and whose request says the
# word of another family of the area, not after a definite determiner ("on this page" names the page there), makes
# that family: "start a new page" is the page's make (diagram.page.new), not a box.
@fm.req app.reading.request request=?r act="make"
@fm.t app.reading.target request=?r mode="new" type=?tt
@fm.kind app.reading.target request=?r kind=?k
@fm.ks app.reading.target request=?r kindSpan=?s
@fm.m app.reading.mention request=?r type=?ft definite="no"
@fm.f app.reading.family type=?ft canonical=?c
@fm.diff core.check fn=neq args=?ft args=?tt
@fm.out app.reading.retarget request=?r rule=family type=?ft mode="new" determiner="indefinite"
@rule.family.named core.rule when=$fm.req when=$fm.t not=$fm.kind not=$fm.ks when=$fm.m when=$fm.f if=$fm.diff then=$fm.out
# The name said for the object the reader took ("the title Ward Census" read as a node's label) names the family made:
# a page's name is its title.
@name.node app.reading.nameKey type="node" key="node.label"
@name.chart app.reading.nameKey type="chart" key="chart.title"
@name.page app.reading.nameKey type="page" key="page.title"
@fn.c app.reading.constraint request=?r index=?i key=?k
@fn.from app.reading.nameKey type=?other key=?k
@fn.to app.reading.nameKey type=?ft key=?k2
@fn.diff core.check fn=neq args=?k args=?k2
@fn.out app.reading.renamed request=?r index=?i key=?k2
@rule.family.name core.rule when=$fm.out when=$fn.c when=$fn.from when=$fn.to if=$fn.diff then=$fn.out

# ---- A name restated by another family's key (2026-11-21) -----------------------------------------------------------
# A selector whose value is the target's own name, by a key whose objects are of another source type than the target's
# family ("what values does Mailer show?": the chart Mailer, with node.ids Mailer beside it), says the name again and
# is dropped; the target's name picks the object.
@rs.c app.reading.constraint request=?r index=?i key=?k phase="selector" valueSpan=?n
@rs.t app.reading.target request=?r type=?tt nameSpan=?n
@rs.p app.reading.property key=?k host=?h
@rs.f app.reading.family type=?tt sourceType=?ts
@rs.diff core.check fn=neq args=?h args=?ts
@rs.out app.reading.restated request=?r index=?i
@rule.name.restated core.rule when=$rs.c when=$rs.t when=$rs.p when=$rs.f if=$rs.diff then=$rs.out

# ---- A joined population (cdf4aed4d, 954017902) ----------------------------------------------------------------------
# A joining act read with the joined population as its theme ("connect all the circles", "connect C to all circles")
# is the joining line made between them: the act's declared form (actForm as=make of=<line kind>) names the line's
# family; the line pattern (linkPattern) its two ends, by the keys of their concepts.
@j.req app.reading.request request=?r act=?act
@j.target app.reading.target request=?r type=?tt
@j.form app.reading.actForm act=?act as="make" of=?line
@j.line app.reading.family canonical=?line type=?lt
@j.pat app.reading.linkPattern pattern=?pid from=?fc to=?tc
@j.fk app.reading.property canonical=?fc key=?fk
@j.tk app.reading.property canonical=?tc key=?tk
@j.other core.check fn=neq args=?lt args=?tt
@j.out app.reading.joining request=?r line=?lt pattern=?pid from=?fk to=?tk
@rule.joining core.rule when=$j.req when=$j.target when=$j.form when=$j.line when=$j.pat when=$j.fk when=$j.tk if=$j.other then=$j.out
# (a target without a family: the line is another family as well)
@j.untyped app.reading.target request=?r
@j.typed app.reading.target request=?r type=?any
@rule.joining.untyped core.rule when=$j.req when=$j.untyped not=$j.typed when=$j.form when=$j.line when=$j.pat when=$j.fk when=$j.tk then=$j.out

# The keys a joining request may say: the two ends and the pattern's own concept.
@a.j app.reading.joining request=?r pattern=?pid from=?fk to=?tk
@a.from app.reading.allowed request=?r pattern=?pid key=?fk
@a.to app.reading.allowed request=?r pattern=?pid key=?tk
@rule.allowed.ends core.rule when=$a.j then=$a.from then=$a.to
@a.pc app.reading.linkPattern pattern=?pid patternConcept=?pc
@a.pk app.reading.property canonical=?pc key=?pk
@a.pkey app.reading.allowed request=?r pattern=?pid key=?pk
@rule.allowed.pattern core.rule when=$a.j when=$a.pc when=$a.pk then=$a.pkey
@f.c app.reading.constraint request=?r key=?k
@f.allowed app.reading.allowed request=?r pattern=?pid key=?k
@f.out app.reading.foreign request=?r pattern=?pid
@rule.foreign core.rule when=$a.j when=$f.c not=$f.allowed then=$f.out

# The first end the request leaves unsaid, and whether it says an end.
@fe.saidFrom app.reading.constraint request=?r key=?fk
@fe.saidTo app.reading.constraint request=?r key=?tk
@fe.outFrom app.reading.freeEnd request=?r pattern=?pid key=?fk
@fe.outTo app.reading.freeEnd request=?r pattern=?pid key=?tk
@rule.free.from core.rule when=$a.j not=$fe.saidFrom then=$fe.outFrom
@rule.free.to core.rule when=$a.j when=$fe.saidFrom not=$fe.saidTo then=$fe.outTo
@se.out app.reading.saidEnd request=?r pattern=?pid
@rule.said.from core.rule when=$a.j when=$fe.saidFrom then=$se.out
@rule.said.to core.rule when=$a.j when=$fe.saidTo then=$se.out

# A population said: every member ("all", a quantifier over all), or a kind said in another form than its kind
# (the plural "circles" read as the kind circle).
@po.fill app.reading.target request=?r fill="all"
@po.quant app.reading.target request=?r quantifier="all"
@po.all app.reading.populous request=?r how=all
@rule.populous.fill core.rule when=$po.fill then=$po.all
@rule.populous.quant core.rule when=$po.quant then=$po.all
@po.spanKind app.reading.target request=?r kind=?k kindSpan=?s
@po.differs core.check fn=neq args=?k args=?s
@po.plural app.reading.populous request=?r how=plural
@rule.populous.plural core.rule when=$po.spanKind if=$po.differs then=$po.plural
@po.span app.reading.target request=?r kindSpan=?s
@po.kind app.reading.target request=?r kind=?k
@rule.populous.unkinded core.rule when=$po.span not=$po.kind then=$po.plural

# The population phrase: the kind said, or (no kind said) the description of every member ("all elements").
@ph.populous app.reading.populous request=?r
@ph.kind app.reading.phrase request=?r field="kind_span"
@rule.phrase.kind core.rule when=$po.span when=$ph.populous then=$ph.kind
@ph.desc app.reading.target request=?r descriptionSpan=?d
@ph.description app.reading.phrase request=?r field="description_span"
@rule.phrase.description core.rule when=$ph.desc not=$po.span when=$po.all then=$ph.description

# The phrase becomes the first unsaid end and the target the line made; with no phrase, a said end is enough
# ("connect the circles" read with the circles as the line's end). A kind said without a population keeps its reading.
@pt.j app.reading.joining request=?r line=?lt pattern=?pid
@pt.phrase app.reading.phrase request=?r field=?field
@pt.free app.reading.freeEnd request=?r pattern=?pid key=?free
@pt.foreign app.reading.foreign request=?r pattern=?pid
@pt.retarget app.reading.retarget request=?r rule=population type=?lt mode="new" determiner="indefinite"
@pt.addEnd app.reading.addEnd request=?r key=?free from=?field operator="eq" phase="result" polarity="positive" character="requirement"
@pt.joined app.reading.joined request=?r
@rule.population.phrase core.rule when=$el.out when=$pt.j when=$pt.phrase when=$pt.free not=$pt.foreign then=$pt.retarget then=$pt.addEnd then=$pt.joined
@pt.said app.reading.saidEnd request=?r pattern=?pid
@pt.anyPhrase app.reading.phrase request=?r
@rule.population.ends core.rule when=$el.out when=$pt.j when=$pt.said not=$po.span not=$pt.anyPhrase not=$pt.foreign then=$pt.retarget then=$pt.joined

# ---- A container's property (cdf4aed4d, 9fdd8a858) -------------------------------------------------------------------
# A property of a container ("make it pastel": diagram.theme) that its binding applies through an operation on the
# container's members (the property's native source type is the member family's) is said of every member, whatever
# reference the reader gave ("it", "the diagram", a node). The containment is the binding table's declared slot.
@ck.c app.reading.constraint request=?r key=?k keyType=?ct
@ck.p app.reading.property key=?k host=?s
@ck.out app.reading.containerKey request=?r container=?ct host=?s
@rule.container.key core.rule when=$ck.c when=$ck.p then=$ck.out
# All keys of one container type and one host, every key bound to a host.
@mx.a app.reading.containerKey request=?r container=?c1 host=?s1
@mx.b app.reading.containerKey request=?r container=?c2 host=?s2
@mx.c core.check fn=neq args=?c1 args=?c2
@mx.s core.check fn=neq args=?s1 args=?s2
@mx.out app.reading.mixed request=?r
@rule.mixed.container core.rule when=$mx.a when=$mx.b if=$mx.c then=$mx.out
@rule.mixed.host core.rule when=$mx.a when=$mx.b if=$mx.s then=$mx.out
@mx.key app.reading.constraint request=?r key=?k
@mx.hosted app.reading.property key=?k host=?any
@rule.mixed.unhosted core.rule when=$mx.key not=$mx.hosted then=$mx.out
@mx.keyless app.reading.constraint request=?r
@mx.keyed app.reading.constraint request=?r key=?k
@rule.mixed.keyless core.rule when=$mx.keyless not=$mx.keyed then=$mx.out
# The member family: of the host's source type, contained in the container, not the container itself nor its own
# representative (the diagram page is the same class as the diagram).
@mb.f app.reading.family type=?mt canonical=?mc sourceType=?s
@mb.in app.reading.containment type=?mt container=?ct
@mb.notSelf core.check fn=neq args=?mt args=?ct
@mb.own app.reading.family type=?ct canonical=?mc
@mb.out app.reading.member request=?r type=?mt
@rule.member core.rule when=$ck.out when=$mb.f when=$mb.in if=$mb.notSelf not=$mb.own then=$mb.out
# A member kind said keeps its reading.
@km.m app.reading.member request=?r type=?mt
@km.t app.reading.target request=?r type=?mt kindSpan=?s
@km.ctx app.reading.target request=?r fill="context"
@km.out app.reading.keepsMember request=?r
@rule.keeps core.rule when=$km.m when=$km.t not=$km.ctx then=$km.out
@cp.new app.reading.target request=?r mode="new"
@cp.pop app.reading.joined request=?r
@cp.out app.reading.retarget request=?r rule=container type=?mt mode="existing" determiner="definite" fill="all"
@rule.container core.rule when=$el.out when=$km.m not=$cp.new not=$mx.out not=$km.out not=$cp.pop then=$cp.out

# ---- A population reference (cdf4aed4d, 6037d01cc) -------------------------------------------------------------------
# "all the boxes", "every node": every matching member of an existing target (std.request reference=population); a
# make names what it makes, so an existing population is not its theme.
@pr.existing app.reading.target request=?r mode="existing"
@pr.make app.reading.request request=?r act="make"
@pr.out app.reading.population request=?r
@rule.population.reference core.rule when=$pr.existing when=$po.all not=$pr.make then=$pr.out

# ---- A plural reference and a distributed list (2026-11-21) -------------------------------------------------------
# A request that says a plural pronoun of w.lang.en referring to things ("call them Tom and Jerry", "paint them red and
# blue") refers to several things. A naming key (and a colour) said as a coordinated list of as many values as the
# things referred to gives each thing its value in order (project-context-action.mjs reads app.reading.distributes;
# the list is cut at the w.lang.en coordinators).
@pl.p app.reading.pronoun request=?r number="pl" refers="thing"
@pl.out app.reading.plural request=?r
@rule.plural.pronoun core.rule when=$pl.p then=$pl.out
@pl.pa app.reading.pronoun request=?r number="pl" refers="any"
@rule.plural.pronoun.any core.rule when=$pl.pa then=$pl.out
@distributes.drawn.name app.reading.distributes key="drawn.name"
@distributes.node.label app.reading.distributes key="node.label"
@distributes.drawn.colour app.reading.distributes key="drawn.colour"
@distributes.node.colour app.reading.distributes key="node.colour"

# ---- A code names its object (2026-11-21) ----------------------------------------------------------------------------
# "make e1 dashed", "delete n2": a code names an observed object whatever family the reader gave it. Its identity
# restatements (a selector by an identity key whose value starts the code) are the same reference and are dropped, and
# the reader's kind head is replaced by the object's observed kind (src/dialog/project-code-reference.mjs reads these).
@identity.id app.reading.identityConcept concept="id"
@identity.ids app.reading.identityConcept concept="ids"
@codeHead.kind app.reading.codeHead key="request.target.kind"

# ---- Implicit counts of a make request (quantity-projection.mjs applies these) --------------------------------------
# A vague amount ("some clouds", "a few birds", "a couple of trees") is a k.expect.amount of the execution knowledge,
# said before the kind's plural noun or given by the reader as the count's value: the request makes its typical number
# and the reply says how it read it. A counted kind ("three houses"), a vague amount, or a kind the number-agreement
# rules read by its singular ("draw a women") binds what its singular binds, not a thing whose own name is the plural.
@q.req app.reading.request request=?r act="make"
@q.t app.reading.target request=?r mode="new" kindSpan=?s
@q.f app.reading.form text=?s singular=?g
@q.pl core.check fn=neq args=?s args=?g
@q.plural app.reading.pluralKind request=?r singular=?g
@rule.quantity.plural core.rule when=$q.req when=$q.t when=$q.f if=$q.pl then=$q.plural
@q.cs app.reading.countSaid request=?r
@q.counted app.reading.counted request=?r
@rule.quantity.counted core.rule when=$q.cs then=$q.counted
@q.csw app.reading.countSaid request=?r word=?w
@q.am app.reading.amount name=?w typical=?n amount=?id
@q.said app.reading.amountCount request=?r name=?w count=?n amount=?id how=said
@rule.quantity.amount.said core.rule when=$q.req when=$q.t when=$q.csw when=$q.am then=$q.said
@q.pk app.reading.pluralKind request=?r
@q.qw app.reading.quantityWord request=?r word=?w
@q.implicit app.reading.amountCount request=?r name=?w count=?n amount=?id how=implicit
@rule.quantity.amount.implicit core.rule when=$q.pk when=$q.qw when=$q.am not=$q.counted then=$q.implicit
@q.pks app.reading.pluralKind request=?r singular=?g
@q.kl app.reading.kindLemma lemma=?g canonical=?c
@q.as app.reading.kindAs request=?r canonical=?c
@rule.quantity.kind core.rule when=$q.pks when=$q.kl then=$q.as
@q.kas app.reading.kindAs request=?r canonical=?c
@q.rt app.reading.retargetKind request=?r canonical=?c
@q.ac app.reading.amountCount request=?r
@q.bs app.reading.bySingular request=?r
@rule.quantity.kind.counted core.rule when=$q.kas when=$q.counted then=$q.rt
@rule.quantity.kind.amount core.rule when=$q.kas when=$q.ac then=$q.rt
@rule.quantity.kind.singular core.rule when=$q.kas when=$q.bs then=$q.rt

