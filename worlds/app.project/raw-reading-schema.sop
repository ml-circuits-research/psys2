@reading.target.fill core.slot of=app.reading.target key=fill kind=string
@reading.target.quantifier core.slot of=app.reading.target key=quantifier kind=string
@reading.target.kind core.slot of=app.reading.target key=kind kind=string
@reading.target.kindSpan core.slot of=app.reading.target key=kindSpan kind=string
@reading.target.descriptionSpan core.slot of=app.reading.target key=descriptionSpan kind=string
@reading.target.nameSpan core.slot of=app.reading.target key=nameSpan kind=string
@reading.target.determiner core.slot of=app.reading.target key=determiner kind=string
# A said kind phrase and its singular (w.lang.en morphology of its head word), told by the feeder for the kind span.
@reading.form.type core.type of=app.reading.form closed=true
@reading.form.text core.slot of=app.reading.form key=text kind=string id=true present=true
@reading.form.singular core.slot of=app.reading.form key=singular kind=string present=true
