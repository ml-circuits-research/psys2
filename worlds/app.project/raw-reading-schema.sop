# The facts a raw reading gives (src/dialog/raw-reading-policy.mjs feeds them; nothing is decided there): one request
# of the reading, its target's fields as the reader wrote them, each constraint's key and the type its key belongs to.
@reading.request.type core.type of=app.reading.request closed=true
@reading.request.request core.slot of=app.reading.request key=request kind=integer id=true present=true
@reading.request.act core.slot of=app.reading.request key=act kind=string
@reading.target.type core.type of=app.reading.target closed=true
@reading.target.request core.slot of=app.reading.target key=request kind=integer id=true present=true
@reading.target.family core.slot of=app.reading.target key=type kind=string
