@reading.bySingular.type core.type of=app.reading.bySingular closed=true
@reading.bySingular.request core.slot of=app.reading.bySingular key=request kind=integer id=true present=true
@reading.constraint.type core.type of=app.reading.constraint closed=true
@reading.constraint.request core.slot of=app.reading.constraint key=request kind=integer present=true
@reading.constraint.index core.slot of=app.reading.constraint key=index kind=integer present=true
@reading.constraint.key core.slot of=app.reading.constraint key=key kind=string
@reading.constraint.keyType core.slot of=app.reading.constraint key=keyType kind=string
@reading.constraint.phase core.slot of=app.reading.constraint key=phase kind=string
@reading.constraint.valueSpan core.slot of=app.reading.constraint key=valueSpan kind=string
# Conclusion: a selector constraint restates the target's name by another family's key and is dropped.
@reading.restated.type core.type of=app.reading.restated closed=true
@reading.restated.request core.slot of=app.reading.restated key=request kind=integer present=true
@reading.restated.index core.slot of=app.reading.restated key=index kind=integer present=true

# The deployed binding table's rows the rules read (area-scoped by the feeder): a property key, its canonical concept
# and the native source type its host binding operates on; a family's type, canonical class and native source type;
# a declared containment slot. And the execution policy's act forms and line patterns (execution-policy.sop).
@reading.property.type core.type of=app.reading.property closed=true
@reading.property.key core.slot of=app.reading.property key=key kind=string present=true
@reading.property.canonical core.slot of=app.reading.property key=canonical kind=string
@reading.property.host core.slot of=app.reading.property key=host kind=string
@reading.family.type core.type of=app.reading.family closed=true
@reading.family.family core.slot of=app.reading.family key=type kind=string present=true
@reading.family.canonical core.slot of=app.reading.family key=canonical kind=string present=true
@reading.family.source core.slot of=app.reading.family key=sourceType kind=string
# A family's own word (its type, by its forms) said in a request, and whether a definite determiner (w.lang.en det
# definite=yes: "the", "this") says it just before ("on this page" names the page already there).
@reading.mention.type core.type of=app.reading.mention closed=true
