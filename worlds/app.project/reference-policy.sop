@ref.types core.use world=app.reference prefix=false
@ref.choices core.use world=std.choice
@ref.criteria core.use world=std.decide

# Resolve a contextual target from the current turn (a change, or an arrangement: "improve the layout" of the page
# in view), or retarget the previous change.
@read.focus app.reference.reading turn=?turn act="change" mood="do" fill="context" mode="existing"
@read.arrange app.reference.reading turn=?turn act="arrange" mood="do" fill="context" mode="existing"
@read.other app.reference.reading turn=?turn act="change" mood="do" quantifier="other" fragment="replaces"
@result.focus app.reference.resolution turn=?turn policy=app.focus values=stated
@result.other app.reference.resolution turn=?turn policy=app.other values=previous
@route.focus core.rule when=$read.focus not=$read.other then=$result.focus
@route.arrange core.rule when=$read.arrange then=$result.focus
# The other acts on an existing referent ("trash it", "copy this one", "move it next to Orange", "pick that one"): the
# same salience (the focus: the object last made, selected or acted on, else the most recent).
@read.acts app.reference.reading turn=?turn act=?refact mood="do" fill="context" mode="existing"
@read.acts.which app.reference.act act=?refact
@route.acts core.rule when=$read.acts when=$read.acts.which then=$result.focus
@ref.act.remove app.reference.act act="remove"
@ref.act.copy app.reference.act act="copy"
@ref.act.place app.reference.act act="place"
@ref.act.pick app.reference.act act="pick"
@ref.act.select app.reference.act act="select"
@route.other core.rule when=$read.other then=$result.other

# An exact kind or a matching family binds a live object to a reader meaning.
@object.exact app.reference.object id=?id kind=?kind sourceType=?type
@mapping.exact app.reference.mapping sourceType=?type lemma=?kind canonical=?meaning family=false
@object.family app.reference.object id=?id sourceType=?type
@mapping.family app.reference.mapping sourceType=?type canonical=?meaning family=true
@matched.kind app.reference.match id=?id canonical=?meaning exact=true
@matched.family app.reference.match id=?id canonical=?meaning exact=false
@match.exact core.rule when=$object.exact when=$mapping.exact then=$matched.kind
@match.family core.rule when=$object.family when=$mapping.family then=$matched.family

@focus.first std.decide.criterion of=app.focus n=1 name=focus measure=focused dir=max
@focus.recent std.decide.criterion of=app.focus n=2 name=recent measure=order dir=max
@other.exclude std.decide.criterion of=app.other n=1 name=other measure=focused dir=hard
@other.recent std.decide.criterion of=app.other n=2 name=recent measure=order dir=max
@focus.specific std.decide.criterion of=app.focus n=3 name=specific measure=exact dir=max
@other.specific std.decide.criterion of=app.other n=3 name=specific measure=exact dir=max

# An act on the referent that says nothing more: a make says nothing to make; an arrangement is the page's declared
# improvement of the resolved target ("improve the layout"); other acts ("trash it", "copy this one") are bridged.
@ref.bare.make app.reference.bare act="make" use=none
@ref.bare.arrange app.reference.bare act="arrange" use=grounded
