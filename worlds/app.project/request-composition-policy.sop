@policy.schema core.use world=app.request.composition prefix=false
@composition.default app.request.composition.policy independent.order=source explicit.dependencies=preserve undo=turn after.unresolved=advance

@following.complete app.request.composition.progress previous=complete remaining=?remaining
@following.unresolved app.request.composition.progress previous=unresolved remaining=?remaining
@flow.policy app.request.composition.policy after.unresolved=?next
@flow.advance app.request.composition.decision progress=$following.complete action=advance
@flow.afterUnresolved app.request.composition.decision progress=$following.unresolved action=?next
@flow.completed core.rule when=$following.complete then=$flow.advance
@flow.unresolved core.rule when=$following.unresolved when=$flow.policy then=$flow.afterUnresolved
