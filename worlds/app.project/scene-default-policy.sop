@scene.schema core.use world=app.sceneDefault prefix=false
@scene.water.support app.sceneDefault.requiresSupport place=water

# Explicit coordinate constraints bind through the same renderer ports.
@scene.position.port app.sceneDefault.port scope=?scope operation=?operation xKey=?xKey yKey=?yKey
@scene.position.tool std.capability.operation scope=?scope on=?on
@scene.position.identity core.check fn=eq args=?operation args=$scene.position.tool
@scene.position.x std.capability.property scope=?scope concept=x on=?on parameter=?xKey order=500
@scene.position.y std.capability.property scope=?scope concept=y on=?on parameter=?yKey order=501
@scene.position.bind core.rule when=$scene.position.port when=$scene.position.tool if=$scene.position.identity then=$scene.position.x then=$scene.position.y
@scene.multiplicity.port app.sceneDefault.port scope=?scope operation=?operation countKey=?countKey
@scene.multiplicity.tool std.capability.operation scope=?scope on=?on act=make
@scene.multiplicity.identity core.check fn=eq args=?operation args=$scene.multiplicity.tool
@scene.multiplicity.property std.capability.property scope=?scope concept=count on=?on parameter=?countKey order=502
@scene.multiplicity.bind core.rule when=$scene.multiplicity.port when=$scene.multiplicity.tool if=$scene.multiplicity.identity then=$scene.multiplicity.property

# A normalized slot is framed by the actual editor bounds. A support region is
# framed by an actual visible object with a relevant catalog anchor.
@scene.subject app.sceneDefault.subject scope=?scope canonical=?kind name=?native operation=?operation xKey=?xKey yKey=?yKey minX=?extentLeft minY=?extentTop maxX=?extentRight maxY=?extentBottom
@scene.frame app.sceneDefault.frame scope=?scope min_x=?left min_y=?top max_x=?right max_y=?bottom
@scene.catalog.slot k.composition2d.slot subject=?label layout=?layout place=?place x=?u y=?v w=?w h=?h
@scene.live.support app.sceneDefault.requiresSupport place=?place
@scene.allowed.slot app.sceneDefault.region operation=?operation value=$scene.catalog.slot
@scene.catalog.anchor k.composition2d.anchor subject=?label of=?owner x=?u y=?v w=?w h=?h
@scene.allowed.anchor app.sceneDefault.region operation=?operation value=$scene.catalog.anchor
@scene.label core.calc fn=matches args=?label args="^[\\s\\S]*$" out=?nativeLabel
@scene.owner core.calc fn=matches args=?owner args="^[\\s\\S]*$" out=?nativeOwner
@scene.matches core.check fn=eq args=?native args=?nativeLabel
@scene.owner.matches core.check fn=eq args=?ownerName args=?nativeOwner
@scene.owner.observed app.sceneDefault.peer scope=?scope entity=?anchor name=?ownerName order=?order min_x=?left min_y=?top max_x=?right max_y=?bottom
@scene.frame.site app.sceneDefault.site scope=?scope kind=?kind operation=?operation anchor="" rank=1 order=0 x=?u y=?v w=?w h=?h min_x=?left min_y=?top max_x=?right max_y=?bottom
@scene.anchor.site app.sceneDefault.site scope=?scope kind=?kind operation=?operation anchor=?anchor rank=0 order=?order x=?u y=?v w=?w h=?h min_x=?left min_y=?top max_x=?right max_y=?bottom
@scene.frame.preference core.rule when=$scene.subject when=$scene.frame when=$scene.catalog.slot when=$scene.allowed.slot not=$scene.live.support with=$scene.label if=$scene.matches then=$scene.frame.site
@scene.anchor.preference core.rule when=$scene.subject when=$scene.owner.observed when=$scene.catalog.anchor when=$scene.allowed.anchor with=$scene.label with=$scene.owner if=$scene.matches if=$scene.owner.matches then=$scene.anchor.site

# Sample the admitted catalog box using the same fractions in every scene.
@scene.point.center app.sceneDefault.sample u=0.5 v=0.5 rank=0
@scene.point.left app.sceneDefault.sample u=0.25 v=0.5 rank=1
@scene.point.right app.sceneDefault.sample u=0.75 v=0.5 rank=2
@scene.point.upper app.sceneDefault.sample u=0.5 v=0.25 rank=3
@scene.point.lower app.sceneDefault.sample u=0.5 v=0.75 rank=4
@scene.fraction app.sceneDefault.sample u=?uFraction v=?vFraction rank=?sample
@scene.site app.sceneDefault.site scope=?scope kind=?kind operation=?operation anchor=?anchor rank=?rank order=?order x=?u y=?v w=?w h=?h min_x=?left min_y=?top max_x=?right max_y=?bottom
@scene.viewport app.sceneDefault.frame scope=?scope min_x=?frameLeft min_y=?frameTop max_x=?frameRight max_y=?frameBottom
@scene.w core.calc fn=sub args=?right args=?left out=?physicalW
@scene.h core.calc fn=sub args=?bottom args=?top out=?physicalH
@scene.u.half core.calc fn=mul args=?w args=?uFraction out=?halfU
@scene.v.half core.calc fn=mul args=?h args=?vFraction out=?halfV
@scene.u.core core.calc fn=add args=?u args=?halfU out=?centerU
@scene.v.core core.calc fn=add args=?v args=?halfV out=?centerV
@scene.u.frac core.calc fn=div args=?centerU args=100 out=?fractionU
@scene.v.frac core.calc fn=div args=?centerV args=100 out=?fractionV
@scene.x.offset core.calc fn=mul args=?physicalW args=?fractionU out=?offsetX
@scene.y.offset core.calc fn=mul args=?physicalH args=?fractionV out=?offsetY
@scene.x core.calc fn=add args=?left args=?offsetX out=?x
@scene.y core.calc fn=add args=?top args=?offsetY out=?y
@scene.left core.calc fn=add args=?x args=?extentLeft out=?minX
@scene.top core.calc fn=add args=?y args=?extentTop out=?minY
@scene.right core.calc fn=add args=?x args=?extentRight out=?maxX
@scene.bottom core.calc fn=add args=?y args=?extentBottom out=?maxY
@scene.inside.left core.check fn=gte args=?minX args=?frameLeft
@scene.inside.top core.check fn=gte args=?minY args=?frameTop
@scene.inside.right core.check fn=lte args=?maxX args=?frameRight
@scene.inside.bottom core.check fn=lte args=?maxY args=?frameBottom
@scene.option app.sceneDefault.option subject=$scene.subject scope=?scope kind=?kind operation=?operation anchor=?anchor rank=?rank order=?order sample=?sample x=?x y=?y xKey=?xKey yKey=?yKey min_x=?minX min_y=?minY max_x=?maxX max_y=?maxY
@scene.project core.rule when=$scene.subject when=$scene.site when=$scene.viewport when=$scene.fraction with=$scene.w with=$scene.h with=$scene.u.half with=$scene.v.half with=$scene.u.core with=$scene.v.core with=$scene.u.frac with=$scene.v.frac with=$scene.x.offset with=$scene.y.offset with=$scene.x with=$scene.y with=$scene.left with=$scene.top with=$scene.right with=$scene.bottom if=$scene.inside.left if=$scene.inside.top if=$scene.inside.right if=$scene.inside.bottom then=$scene.option

# Weight crowding by the actual overlapping area. An observed support is expected to overlap.
@scene.trial app.sceneDefault.option scope=?scope anchor=?anchor min_x=?a0 min_y=?b0 max_x=?a1 max_y=?b1
@scene.peer app.sceneDefault.peer scope=?scope entity=?peer min_x=?c0 min_y=?d0 max_x=?c1 max_y=?d1
@scene.other core.check fn=neq args=?anchor args=?peer
@scene.cross.left core.check fn=lt args=?a0 args=?c1
@scene.cross.right core.check fn=gt args=?a1 args=?c0
@scene.cross.top core.check fn=lt args=?b0 args=?d1
@scene.cross.bottom core.check fn=gt args=?b1 args=?d0
@scene.overlap.min_x core.calc fn=max args=?a0 args=?c0 out=?ix0
@scene.overlap.min_y core.calc fn=max args=?b0 args=?d0 out=?iy0
@scene.overlap.max_x core.calc fn=min args=?a1 args=?c1 out=?ix1
@scene.overlap.max_y core.calc fn=min args=?b1 args=?d1 out=?iy1
@scene.overlap.width core.calc fn=sub args=?ix1 args=?ix0 out=?overlapWidth
@scene.overlap.height core.calc fn=sub args=?iy1 args=?iy0 out=?overlapHeight
@scene.overlap.area core.calc fn=mul args=?overlapWidth args=?overlapHeight out=?area
@scene.overlapping app.sceneDefault.overlap option=$scene.trial peer=?peer area=?area
@scene.collision core.rule when=$scene.trial when=$scene.peer if=$scene.other if=$scene.cross.left if=$scene.cross.right if=$scene.cross.top if=$scene.cross.bottom with=$scene.overlap.min_x with=$scene.overlap.min_y with=$scene.overlap.max_x with=$scene.overlap.max_y with=$scene.overlap.width with=$scene.overlap.height with=$scene.overlap.area then=$scene.overlapping
@scene.area app.sceneDefault.overlap option=$scene.trial area=?area
@scene.sum core.calc fn=sum over=$scene.area args=?area out=?crowding
@scene.feasible app.sceneDefault.candidate option=$scene.trial crowding=?crowding
@scene.feasible.rule core.rule when=$scene.trial with=$scene.sum then=$scene.feasible

# Minimize observed crowding first, then prefer a supported site, central
# sample and the latest comparable observation.
@scene.choice app.sceneDefault.option subject=?subject scope=?scope kind=?kind operation=?operation rank=?rank order=?order sample=?sample
@scene.alternative app.sceneDefault.option subject=?subject scope=?scope kind=?kind operation=?operation rank=?nextRank order=?nextOrder sample=?nextSample
@scene.candidate app.sceneDefault.candidate option=$scene.choice crowding=?crowding
@scene.known.alternative app.sceneDefault.candidate option=$scene.alternative crowding=?nextCrowding
@scene.less.crowding core.check fn=lt args=?nextCrowding args=?crowding
@scene.same.crowding core.check fn=eq args=?nextCrowding args=?crowding
@scene.lower.rank core.check fn=lt args=?nextRank args=?rank
@scene.equal.rank core.check fn=eq args=?nextRank args=?rank
@scene.lower.sample core.check fn=lt args=?nextSample args=?sample
@scene.equal.sample core.check fn=eq args=?nextSample args=?sample
@scene.more.recent core.check fn=gt args=?nextOrder args=?order
@scene.equal.order core.check fn=eq args=?nextOrder args=?order
@scene.earlier.record core.check fn=before args=$scene.alternative args=$scene.choice
@scene.displaced app.sceneDefault.displaced option=$scene.choice
@scene.prefer.space core.rule when=$scene.choice when=$scene.candidate when=$scene.alternative when=$scene.known.alternative if=$scene.less.crowding then=$scene.displaced
@scene.prefer.anchor core.rule when=$scene.choice when=$scene.candidate when=$scene.alternative when=$scene.known.alternative if=$scene.same.crowding if=$scene.lower.rank then=$scene.displaced
@scene.prefer.central core.rule when=$scene.choice when=$scene.candidate when=$scene.alternative when=$scene.known.alternative if=$scene.same.crowding if=$scene.equal.rank if=$scene.lower.sample then=$scene.displaced
@scene.prefer.recent core.rule when=$scene.choice when=$scene.candidate when=$scene.alternative when=$scene.known.alternative if=$scene.same.crowding if=$scene.equal.rank if=$scene.equal.sample if=$scene.more.recent then=$scene.displaced
@scene.stable.tie core.rule when=$scene.choice when=$scene.candidate when=$scene.alternative when=$scene.known.alternative if=$scene.same.crowding if=$scene.equal.rank if=$scene.equal.sample if=$scene.equal.order if=$scene.earlier.record then=$scene.displaced

@scene.winner app.sceneDefault.option subject=?subject scope=?scope kind=?kind operation=?operation xKey=?xKey yKey=?yKey x=?x y=?y
@scene.winner.feasible app.sceneDefault.candidate option=$scene.winner
@scene.winner.displaced app.sceneDefault.displaced option=$scene.winner
@scene.tool std.capability.operation scope=?scope name=?operationName act=make eligible=true
@scene.tool.identity core.check fn=eq args=?operation args=$scene.tool
@scene.seed.x std.capability.seed scope=?scope kind=?kind operation=?operationName parameter=?xKey source=value value=?x phase=missing order=250
@scene.seed.y std.capability.seed scope=?scope kind=?kind operation=?operationName parameter=?yKey source=value value=?y phase=missing order=251 notice="I used the scene layout for the placement."
@scene.guardless.subject app.sceneDefault.subject guarded=false
@scene.guardless.identity core.check fn=eq args=?subject args=$scene.guardless.subject
@scene.guarded.subject app.sceneDefault.subject guarded=true guard=?guard
@scene.guarded.identity core.check fn=eq args=?subject args=$scene.guarded.subject
@scene.seed.guarded.x std.capability.seed scope=?scope kind=?kind operation=?operationName parameter=?xKey source=value value=?x whenArgument=?guard phase=missing order=250
@scene.seed.guarded.y std.capability.seed scope=?scope kind=?kind operation=?operationName parameter=?yKey source=value value=?y whenArgument=?guard phase=missing order=251 notice="I used the scene layout for the placement."
@scene.seed core.rule when=$scene.winner when=$scene.winner.feasible when=$scene.tool when=$scene.guardless.subject not=$scene.winner.displaced if=$scene.tool.identity if=$scene.guardless.identity then=$scene.seed.x then=$scene.seed.y
@scene.seed.guarded core.rule when=$scene.winner when=$scene.winner.feasible when=$scene.tool when=$scene.guarded.subject not=$scene.winner.displaced if=$scene.tool.identity if=$scene.guarded.identity then=$scene.seed.guarded.x then=$scene.seed.guarded.y
