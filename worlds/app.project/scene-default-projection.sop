@scene.projection.import core.use world=std.knowledge prefix=false

# Bind renderer observations to indexed catalog reads and selected composition outputs.
@scene.projection.subject std.knowledge.input param=subjects type=k.composition2d.subject key=name
@scene.projection.things std.knowledge.read param=subjects type=k.scenes.thing key=name
@scene.projection.layouts std.knowledge.read param=layout type=k.layouts.slot key=layout
@scene.projection.anchors std.knowledge.read param=anchors type=k.layouts.anchor key=of
@scene.projection.slots std.knowledge.select param=layout type=k.composition2d.slot key=layout
@scene.projection.support std.knowledge.select param=anchors type=k.composition2d.anchor key=of
@scene.projection std.knowledge.profile module=k.composition2d input=$scene.projection.subject read=$scene.projection.things read=$scene.projection.layouts read=$scene.projection.anchors select=$scene.projection.slots select=$scene.projection.support


# Structural placement uses the operation's declared role and layout without a shape-to-role lookup.
@scene.projection.role std.knowledge.input param=role type=k.composition2d.role key=name
@scene.projection.roles std.knowledge.profile module=k.composition2d input=$scene.projection.subject input=$scene.projection.role read=$scene.projection.layouts select=$scene.projection.slots
