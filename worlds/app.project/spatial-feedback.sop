@feedback.schema core.use world=app.spatialFeedback prefix=false
@feedback.threshold app.spatialFeedback.threshold minimum=0

# A correction compares the same anchored placement at different observed revisions.
@feedback.change app.spatialFeedback.change subject=?subject anchor=?anchor relation=?relation before=?before frame=?frame instance=?instance scope=?scope prior=?prior current=?current
@feedback.new.revision core.check fn=neq args=?prior args=?current

@feedback.subject.remembered app.spatialFeedback.geometry stage=remembered role=subject source=?subjectSource min_x=?sx0 min_y=?sy0 max_x=?sx1 max_y=?sy1
@feedback.subject.prior app.spatialFeedback.geometry stage=prior role=subject source=?subjectSource min_x=?sx0 min_y=?sy0 max_x=?sx1 max_y=?sy1
@feedback.subject.current app.spatialFeedback.geometry stage=current role=subject source=?subjectSource min_x=?tx0 min_y=?ty0 max_x=?tx1 max_y=?ty1
@feedback.anchor.remembered app.spatialFeedback.geometry stage=remembered role=anchor source=?anchorSource min_x=?ax0 min_y=?ay0 max_x=?ax1 max_y=?ay1
@feedback.anchor.prior app.spatialFeedback.geometry stage=prior role=anchor source=?anchorSource min_x=?ax0 min_y=?ay0 max_x=?ax1 max_y=?ay1
@feedback.anchor.current app.spatialFeedback.geometry stage=current role=anchor source=?anchorSource min_x=?ax0 min_y=?ay0 max_x=?ax1 max_y=?ay1

@feedback.before.width core.calc fn=sub args=?sx1 args=?sx0 out=?width
@feedback.before.height core.calc fn=sub args=?sy1 args=?sy0 out=?height
@feedback.current.width core.calc fn=sub args=?tx1 args=?tx0 out=?nextWidth
@feedback.current.height core.calc fn=sub args=?ty1 args=?ty0 out=?nextHeight
@feedback.same.width core.check fn=eq args=?width args=?nextWidth
@feedback.same.height core.check fn=eq args=?height args=?nextHeight

@feedback.separation k.spatial2d.pair_geometry subject=?subject object=?anchor kind=?relation frame=?frame instance=?instance scope=?scope revision=?current separation=?after
@feedback.tolerance app.spatialFeedback.threshold minimum=?minimum
@feedback.grow core.calc fn=sub args=?after args=?before out=?increase
@feedback.shrink core.calc fn=sub args=?before args=?after out=?decrease
@feedback.difference core.calc fn=max args=?increase args=?decrease out=?difference
@feedback.changed core.check fn=gt args=?difference args=?minimum
@feedback.accepted app.spatialFeedback.accepted clearance=?after
@feedback.compare core.rule when=$feedback.change when=$feedback.subject.remembered when=$feedback.subject.prior when=$feedback.subject.current when=$feedback.anchor.remembered when=$feedback.anchor.prior when=$feedback.anchor.current when=$feedback.separation when=$feedback.tolerance with=$feedback.before.width with=$feedback.before.height with=$feedback.current.width with=$feedback.current.height with=$feedback.grow with=$feedback.shrink with=$feedback.difference if=$feedback.new.revision if=$feedback.same.width if=$feedback.same.height if=$feedback.changed then=$feedback.accepted
