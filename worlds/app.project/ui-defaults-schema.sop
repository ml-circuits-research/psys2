@ui.module core.module name=app.ui version=1 exports=app.ui.value

# A value an editor tab's own controls use when the person has not said one: a new item's starting value, a
# keyboard step, a minimum size, the page frame before the area reports one. The tab reads these through the host
# (host.ui(view)); each is a number or a text.
@ui.value.type core.type of=app.ui.value closed=true
@ui.value.view core.slot of=app.ui.value key=view kind=atom present=true
@ui.value.name core.slot of=app.ui.value key=name kind=atom present=true
@ui.value.number core.slot of=app.ui.value key=number kind=number
@ui.value.text core.slot of=app.ui.value key=text kind=string
