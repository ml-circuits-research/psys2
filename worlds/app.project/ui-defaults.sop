@ui.schema core.use world=app.ui prefix=false

# Calendar: a new event starts at 09:00 of the selected day and lasts an hour; the arrow keys move the focused
# event by 30 minutes (15 with Shift), left and right by a day.
@ui.calendar.newEventHour app.ui.value view=calendar name=newEventHour number=9
@ui.calendar.newEventDuration app.ui.value view=calendar name=newEventDurationMs number=3600000
@ui.calendar.keyStep app.ui.value view=calendar name=keyStepMinutes number=30
@ui.calendar.keyFineStep app.ui.value view=calendar name=keyFineStepMinutes number=15

# Documents: the title a new document is written with.
@ui.editor.newTitle app.ui.value view=editor name=newDocumentTitle text="Untitled document"

# Drawing: the arrow keys move a selection by 2 (20 with Shift); an object with no box is scaled as 120 wide.
@ui.draw.keyStep app.ui.value view=draw name=keyStep number=2
@ui.draw.keyLargeStep app.ui.value view=draw name=keyLargeStep number=20
@ui.draw.defaultScale app.ui.value view=draw name=defaultScale number=120

# Diagram: the arrow keys move a selection by 10 (1 with Shift); a node is resized to no less than 8 by 8; the page
# frame is 1000 by 700 until the area reports its own.
@ui.diagram.keyStep app.ui.value view=diagram name=keyStep number=10
@ui.diagram.keyFineStep app.ui.value view=diagram name=keyFineStep number=1
@ui.diagram.minNodeSize app.ui.value view=diagram name=minNodeSize number=8
@ui.diagram.frameWidth app.ui.value view=diagram name=frameWidth number=1000
@ui.diagram.frameHeight app.ui.value view=diagram name=frameHeight number=700
