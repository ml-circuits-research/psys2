# The English voice words of the page (docs/webchat/ui/voice-words.mjs): the end-of-turn and microphone-command lists. One app.voice.word per entry,
# in list order; for another language each entry is translated once by the translation layer. Hand-written for this application.
@voice.schema core.use world=app.voice prefix=false

@voice.address.0 app.voice.word list=address text="robot"
@voice.address.1 app.voice.word list=address text="assistant"
@voice.address.2 app.voice.word list=address text="computer"

@voice.stopPhrases.0 app.voice.word list=stopPhrases text="stop microphone"
