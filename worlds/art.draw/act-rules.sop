# art.draw act rules (authored). Each native Drawing command compiles to std.acts calls on the w.drawing
# instance; worlds/sop-world-host.mjs only runs them. Objects are addressed by their code.
@draw.default.type core.type of=ui.draw.default
@draw.next.type core.type of=ui.draw.next
@draw.default ui.draw.default x=500 y=350 size=120


# Where a new object goes, and how big it is, when the command names no place (worlds/art.draw/coverage.md):
#  1. Its size: the size the command asks for; else, for a thing others float in (a k.layouts anchor of a declared
#     kind: the water of a lake), the holder size; else the drawn size of its k.scenes size class; else the default.
#     A kind with no facts of its own is sized and placed as the kind it is a kind of (k.people kind_of).
#  2. The regions it may go to, in order: (1) the inside of an object on the page whose k.layouts anchor of a declared
#     kind holds the kind (a boat on the lake's water, a bird in the crown of a tree), when the kind fits there at
#     no less than the declared share of its size; (2) the region of the page layout (k.layouts landscape: sky, far,
#     ground, water, foreground) whose slot holds the kind; (3) the region named by the kind's k.scenes place (the
#     sun in the sky, a fish in the water); (4) the regions of (2) and (3) widened to the page's width (the same
#     band); (5) the regions of (1) to (4) for the object made smaller, in their upper part (farther away), in the
#     declared steps (smaller and higher at each step); (6) the whole page, only for a kind with no region of (2)
#     or (3).
#  3. In each region the declared grid of spots (centre first, then the edges, then between; the middle row, then
#     the lower and the higher one), each
#     keeping the object inside its region when it fits there and always on the page; then the spots that touch an
#     object on the page from its right or its left, in each row.
#  4. The first spot (by region, then order) whose box keeps the declared gap from every object except its
#     container and whose centre is not on an object's centre; when none is free, the spot that overlaps the
#     fewest objects and is not centred on one.
# A command that gives x or y keeps the default place for what it does not give and the size of step 1.
@draw.subject.type core.type of=ui.draw.subject
@draw.as.type core.type of=ui.draw.as
@draw.auto.type core.type of=ui.draw.auto
@draw.page.type core.type of=ui.draw.page
@draw.scale.type core.type of=ui.draw.scale
@draw.into.type core.type of=ui.draw.into
@draw.sizing.type core.type of=ui.draw.sizing
@draw.sizerank.type core.type of=ui.draw.sizerank
@draw.size.type core.type of=ui.draw.size
@draw.area.type core.type of=ui.draw.area
@draw.region.type core.type of=ui.draw.region
@draw.grid.type core.type of=ui.draw.grid
@draw.candidate.type core.type of=ui.draw.candidate
@draw.blocker.type core.type of=ui.draw.blocker
@draw.free.type core.type of=ui.draw.free
@draw.crowd.type core.type of=ui.draw.crowd
@draw.stacked.type core.type of=ui.draw.stacked
@draw.spare.type core.type of=ui.draw.spare
@draw.best.type core.type of=ui.draw.best
@draw.target.type core.type of=ui.draw.target
@draw.beside.type core.type of=ui.draw.beside
@draw.homed.type core.type of=ui.draw.homed
@draw.far.type core.type of=ui.draw.far
@draw.partedit.type core.type of=ui.draw.partedit
@draw.partdx.type core.type of=ui.draw.partdx
@draw.partdy.type core.type of=ui.draw.partdy
@draw.partfw.type core.type of=ui.draw.partfw
@draw.partfh.type core.type of=ui.draw.partfh
@draw.fitpick.type core.type of=ui.draw.fitpick
@draw.fitbox.type core.type of=ui.draw.fitbox
@draw.fitscaled.type core.type of=ui.draw.fitscaled

# The page is laid out as a k.layouts landscape of its own size; objects keep a gap of 10; a contained object takes
# at most 0.6 of its container's place and goes there only at no less than half its own size; when its own regions
# and their bands are full it is tried there again at 0.7 of its size in their upper 0.6, then at 0.5 of its size
# in their upper 0.35 (smaller is farther away, higher on the page).
@draw.page ui.draw.page layout=landscape w=1000 h=700 gap=10 room=0.6 fit=0.5
@draw.far.1 ui.draw.far step=1 scale=0.7 part=0.6
@draw.far.2 ui.draw.far step=2 scale=0.5 part=0.35
# Drawn sizes of the k.scenes size classes (a picture scale, not the real one), and of things others float in.
@draw.scale.tiny ui.draw.scale class=tiny size=45
@draw.scale.small ui.draw.scale class=small size=70
@draw.scale.medium ui.draw.scale class=medium size=100
@draw.scale.large ui.draw.scale class=large size=130
@draw.scale.huge ui.draw.scale class=huge size=160
@draw.scale.water ui.draw.scale anchor=water size=320
# The two sides of an object a new one may touch (right first).
@draw.beside.right ui.draw.beside side=1 n=1
@draw.beside.left ui.draw.beside side=-1 n=2
# The anchor kinds a new object is put into by default (on, at the top of or on the roof of are asked for).
@draw.into.water ui.draw.into anchor=water
@draw.into.inside ui.draw.into anchor=inside
# The spots of a region: x and y as shares (0 to 100) of the room the object has there, in order.
@grid.1 ui.draw.grid n=1 fx=50 fy=50
@grid.2 ui.draw.grid n=2 fx=0 fy=50
@grid.3 ui.draw.grid n=3 fx=100 fy=50
@grid.4 ui.draw.grid n=4 fx=15 fy=50
@grid.5 ui.draw.grid n=5 fx=85 fy=50
@grid.6 ui.draw.grid n=6 fx=32 fy=50
@grid.7 ui.draw.grid n=7 fx=68 fy=50
@grid.8 ui.draw.grid n=8 fx=50 fy=100
@grid.9 ui.draw.grid n=9 fx=0 fy=100
@grid.10 ui.draw.grid n=10 fx=100 fy=100
@grid.11 ui.draw.grid n=11 fx=15 fy=100
@grid.12 ui.draw.grid n=12 fx=85 fy=100
@grid.13 ui.draw.grid n=13 fx=32 fy=100
@grid.14 ui.draw.grid n=14 fx=68 fy=100
@grid.15 ui.draw.grid n=15 fx=50 fy=0
@grid.16 ui.draw.grid n=16 fx=0 fy=0
@grid.17 ui.draw.grid n=17 fx=100 fy=0
@grid.18 ui.draw.grid n=18 fx=15 fy=0
@grid.19 ui.draw.grid n=19 fx=85 fy=0
@grid.20 ui.draw.grid n=20 fx=32 fy=0
@grid.21 ui.draw.grid n=21 fx=68 fy=0

# The kind a command makes, and the kinds whose facts stand for it: its own, and the one it is a kind of.
@sb.make app.act.request operation="drawing.object.make" kind=?k
@sb.cat app.act.request operation="drawing.catalog.make" name=?k
@sb.out ui.draw.subject kind=?k
@subject.make core.rule when=$sb.make then=$sb.out
@subject.catalog core.rule when=$sb.cat then=$sb.out
@as.sub ui.draw.subject kind=?k
@as.self ui.draw.as kind=?k as=?k
@as.own core.rule when=$as.sub then=$as.self
@as.parent k.people.kind name=?k kind_of=?p
@as.parent.o ui.draw.as kind=?k as=?p
@as.inherited core.rule when=$as.sub when=$as.parent then=$as.parent.o
@ex.x app.act.request x=?ax
@ex.y app.act.request y=?ay
@au.out ui.draw.auto kind=?k
@auto core.rule when=$as.sub not=$ex.x not=$ex.y then=$au.out

# 1. The size.
@sz.sub ui.draw.subject kind=?k
@sz.as ui.draw.as kind=?k as=?a
@sz.req app.act.request size=?s
@sz.req.o ui.draw.sizing rank=0 size=?s
@size.asked core.rule when=$sz.sub when=$sz.req then=$sz.req.o
@sz.anchor k.layouts.anchor of=?a kind=?ak
@sz.scale.a ui.draw.scale anchor=?ak size=?s
@sz.anchor.o ui.draw.sizing rank=1 size=?s
@size.holder core.rule when=$sz.sub when=$sz.as when=$sz.anchor when=$sz.scale.a then=$sz.anchor.o
@sz.scene k.scenes.thing name=?a size=?c
@sz.scale.c ui.draw.scale class=?c size=?s
@sz.scene.o ui.draw.sizing rank=2 size=?s
@size.class core.rule when=$sz.sub when=$sz.as when=$sz.scene when=$sz.scale.c then=$sz.scene.o
@sz.def ui.draw.default size=?s
@sz.def.o ui.draw.sizing rank=3 size=?s
@size.default core.rule when=$sz.sub when=$sz.def then=$sz.def.o
@sz.all ui.draw.sizing rank=?r size=?s
@sz.min core.aggregate over=$sz.all min=?best args=?r then=$sz.best
@sz.best ui.draw.sizerank rank=?best
@sz.top ui.draw.sizerank rank=?r
@sz.chosen ui.draw.sizing rank=?r size=?s
@sz.max core.aggregate over=$sz.top over=$sz.chosen max=?best args=?s then=$sz.out
@sz.out ui.draw.size size=?best

# 2. The regions. The areas of the page: each slot of its layout, in page units.
@pa.page ui.draw.page layout=?l w=?pw h=?ph
@pa.slot k.layouts.slot layout=?l name=?r x=?x y=?y w=?w h=?h
@pa.kx core.calc out=?kx fn=div args=?pw args=100
@pa.ky core.calc out=?ky fn=div args=?ph args=100
@pa.x0 core.calc out=?x0 fn=mul args=?x args=?kx
@pa.y0 core.calc out=?y0 fn=mul args=?y args=?ky
@pa.xw core.calc out=?xw fn=add args=?x args=?w
@pa.yh core.calc out=?yh fn=add args=?y args=?h
@pa.x1 core.calc out=?x1 fn=mul args=?xw args=?kx
@pa.y1 core.calc out=?y1 fn=mul args=?yh args=?ky
@pa.out ui.draw.area name=?r x0=?x0 y0=?y0 x1=?x1 y1=?y1
@page.area core.rule when=$pa.page when=$pa.slot with=$pa.kx with=$pa.ky with=$pa.x0 with=$pa.y0 with=$pa.xw with=$pa.yh with=$pa.x1 with=$pa.y1 then=$pa.out
# (0) The region the command names (at=, before every other region): a box of the page in hundredths of its size (a
# side, a corner, the middle; "corner" is each of the four), or a band of the ground between the horizon and the foot
# of the page in hundredths of that room (the background: the far band, where a thing is drawn smaller and pulled up;
# the foreground: the near band). The horizon is the view's or the layout's (landscape-rules.sop ui.draw.horizon).
@draw.pagebox.type core.type of=ui.draw.pagebox
@draw.band.type core.type of=ui.draw.band
@pb.top ui.draw.pagebox name=top order=0 x=0 y=0 w=100 h=33
@pb.bottom ui.draw.pagebox name=bottom order=0 x=0 y=67 w=100 h=33
@pb.left ui.draw.pagebox name=left order=0 x=0 y=0 w=33 h=100
@pb.right ui.draw.pagebox name=right order=0 x=67 y=0 w=33 h=100
@pb.center ui.draw.pagebox name=center order=0 x=30 y=30 w=40 h=40
@pb.middle ui.draw.pagebox name=middle order=0 x=30 y=30 w=40 h=40
@pb.top_left ui.draw.pagebox name=top_left order=0 x=0 y=0 w=33 h=33
@pb.top_right ui.draw.pagebox name=top_right order=0 x=67 y=0 w=33 h=33
@pb.bottom_left ui.draw.pagebox name=bottom_left order=0 x=0 y=67 w=33 h=33
@pb.bottom_right ui.draw.pagebox name=bottom_right order=0 x=67 y=67 w=33 h=33
@pb.corner.1 ui.draw.pagebox name=corner order=1 x=0 y=0 w=25 h=25
@pb.corner.2 ui.draw.pagebox name=corner order=2 x=75 y=0 w=25 h=25
@pb.corner.3 ui.draw.pagebox name=corner order=3 x=0 y=75 w=25 h=25
@pb.corner.4 ui.draw.pagebox name=corner order=4 x=75 y=75 w=25 h=25
@bd.background ui.draw.band name=background from=0 to=30 scale=0.6 far=1
@bd.foreground ui.draw.band name=foreground from=60 to=100 scale=1 far=0
@ra.auto ui.draw.auto kind=?k
@ra.req app.act.request operation="drawing.object.make" at=?r
@ra.box ui.draw.pagebox name=?r order=?o x=?x y=?y w=?w h=?h
@ra.page ui.draw.page w=?pw h=?ph
@ra.s ui.draw.size size=?s
@ra.kx core.calc out=?kx fn=div args=?pw args=100
@ra.ky core.calc out=?ky fn=div args=?ph args=100
@ra.x0 core.calc out=?x0 fn=mul args=?x args=?kx
@ra.y0 core.calc out=?y0 fn=mul args=?y args=?ky
@ra.xw core.calc out=?xw fn=add args=?x args=?w
@ra.yh core.calc out=?yh fn=add args=?y args=?h
@ra.x1 core.calc out=?x1 fn=mul args=?xw args=?kx
@ra.y1 core.calc out=?y1 fn=mul args=?yh args=?ky
@ra.key core.calc out=?key fn=concat args=at- args=?r args=- args=?o
@ra.out ui.draw.region key=?key tier=0 order=?o host=none x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s
@region.asked core.rule when=$ra.auto when=$ra.req when=$ra.box when=$ra.page when=$ra.s with=$ra.kx with=$ra.ky with=$ra.x0 with=$ra.y0 with=$ra.xw with=$ra.yh with=$ra.x1 with=$ra.y1 with=$ra.key then=$ra.out
@rbd.band ui.draw.band name=?r from=?fr to=?to scale=?sc far=?far
@rbd.hz ui.draw.horizon y=?hy
@rbd.room core.calc out=?room fn=sub args=?ph args=?hy
@rbd.a core.calc out=?a fn=mul args=?room args=?fr args=0.01
@rbd.b core.calc out=?b fn=mul args=?room args=?to args=0.01
@rbd.y0 core.calc out=?y0 fn=add args=?hy args=?a
@rbd.y1 core.calc out=?y1 fn=add args=?hy args=?b
@rbd.s0 core.calc out=?s0 fn=mul args=?s args=?sc
@rbd.s1 core.calc out=?s1 fn=div args=?s0 args=2
@rbd.s2 core.calc out=?s2 fn=round args=?s1
@rbd.s3 core.calc out=?s3 fn=mul args=?s2 args=2
@rbd.key core.calc out=?key fn=concat args=at- args=?r
@rbd.out ui.draw.region key=?key tier=0 order=0 host=none x0=0 y0=?y0 x1=?pw y1=?y1 size=?s3 far=?far
@region.asked.band core.rule when=$ra.auto when=$ra.req when=$rbd.band when=$rbd.hz when=$ra.page when=$ra.s with=$rbd.room with=$rbd.a with=$rbd.b with=$rbd.y0 with=$rbd.y1 with=$rbd.s0 with=$rbd.s1 with=$rbd.s2 with=$rbd.s3 with=$rbd.key then=$rbd.out
# (1) Into an object on the page whose anchor holds the kind.
@ct.auto ui.draw.auto kind=?k
@ct.into ui.draw.into anchor=?ak
@ct.anchor k.layouts.anchor of=?c name=?an kind=?ak holds=?k x=?ax y=?ay w=?aw h=?ah
@ct.o w.drawing.object code=?host drawing=?c x=?ox y=?oy size=?os z=?oz
@ct.s ui.draw.size size=?s
@ct.page ui.draw.page room=?room fit=?fit
@ct.sc core.calc out=?sc fn=div args=?os args=100
@ct.half core.calc out=?oh fn=div args=?os args=2
@ct.ox0 core.calc out=?ox0 fn=sub args=?ox args=?oh
@ct.oy0 core.calc out=?oy0 fn=sub args=?oy args=?oh
@ct.dx core.calc out=?dx fn=mul args=?ax args=?sc
@ct.dy core.calc out=?dy fn=mul args=?ay args=?sc
@ct.bw core.calc out=?bw fn=mul args=?aw args=?sc
@ct.bh core.calc out=?bh fn=mul args=?ah args=?sc
@ct.bx0 core.calc out=?bx0 fn=add args=?ox0 args=?dx
@ct.by0 core.calc out=?by0 fn=add args=?oy0 args=?dy
@ct.bx1 core.calc out=?bx1 fn=add args=?bx0 args=?bw
@ct.by1 core.calc out=?by1 fn=add args=?by0 args=?bh
@ct.rw core.calc out=?rw fn=mul args=?bw args=?room
@ct.rh core.calc out=?rh fn=mul args=?bh args=?room
@ct.s0 core.calc out=?s0 fn=min args=?s args=?rw args=?rh
@ct.s0h core.calc out=?s0h fn=div args=?s0 args=2
@ct.s0r core.calc out=?s0r fn=round args=?s0h
@ct.s1 core.calc out=?s1 fn=mul args=?s0r args=2
@ct.need core.calc out=?need fn=mul args=?s args=?fit
@ct.fits core.check fn=gte args=?s1 args=?need
@ct.key core.calc out=?key fn=concat args=?host args=- args=?an
@ct.out ui.draw.region key=?key tier=1 order=?oz host=?host x0=?bx0 y0=?by0 x1=?bx1 y1=?by1 size=?s1
@ct.terrain ui.draw.backdrop object=?host
@region.container core.rule when=$ct.auto when=$ct.into when=$ct.anchor when=$ct.o not=$ct.terrain when=$ct.s when=$ct.page with=$ct.sc with=$ct.half with=$ct.ox0 with=$ct.oy0 with=$ct.dx with=$ct.dy with=$ct.bw with=$ct.bh with=$ct.bx0 with=$ct.by0 with=$ct.bx1 with=$ct.by1 with=$ct.rw with=$ct.rh with=$ct.s0 with=$ct.s0h with=$ct.s0r with=$ct.s1 with=$ct.need if=$ct.fits with=$ct.key then=$ct.out
# (2) The area whose layout slot holds the kind; (3) the area of its k.scenes place; (5) the page.
@rh.auto ui.draw.auto kind=?k
@rh.as ui.draw.as kind=?k as=?a
@rh.page ui.draw.page layout=?l
@rh.slot k.layouts.slot layout=?l name=?r holds=?a
@rh.area ui.draw.area name=?r x0=?x0 y0=?y0 x1=?x1 y1=?y1
@rh.s ui.draw.size size=?s
@rh.key core.calc out=?key fn=concat args=holds- args=?r
@rh.out ui.draw.region key=?key tier=2 order=0 host=none x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s
@region.holds core.rule when=$rh.auto when=$rh.as when=$rh.page when=$rh.slot when=$rh.area when=$rh.s with=$rh.key then=$rh.out
@rp.scene k.scenes.thing name=?a place=?r
@rp.key core.calc out=?key fn=concat args=place- args=?r
@rp.out ui.draw.region key=?key tier=3 order=0 host=none x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s
@region.place core.rule when=$rh.auto when=$rh.as when=$rp.scene when=$rh.area when=$rh.s with=$rp.key then=$rp.out
# (4) The regions of (2) and (3) widened to the whole width of the page (the same band: still in the sky, still on
# the ground).
@rb.r ui.draw.region key=?rk tier=?t host=none y0=?y0 y1=?y1 size=?s
@rb.page ui.draw.page w=?pw
@rb.low core.check fn=lt args=?t args=4
@rb.key core.calc out=?key fn=concat args=wide- args=?rk
@rb.out ui.draw.region key=?key tier=4 order=?t host=none x0=0 y0=?y0 x1=?pw y1=?y1 size=?s
@region.wide core.rule when=$rb.r when=$rb.page if=$rb.low with=$rb.key then=$rb.out
# (5) The regions of (1) to (4) again, their upper part, for the object made smaller (farther away), one tier per step.
@rs.r ui.draw.region key=?rk tier=?t host=?host x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s
@rs.page ui.draw.far step=?st scale=?f part=?far
@rs.tier core.calc out=?nt fn=add args=4 args=?st
@rs.dh core.calc out=?dh fn=sub args=?y1 args=?y0
@rs.fh core.calc out=?fh fn=mul args=?dh args=?far
@rs.y1 core.calc out=?fy1 fn=add args=?y0 args=?fh
@rs.low core.check fn=lt args=?t args=5
@rs.s core.calc out=?s1 fn=mul args=?s args=?f
@rs.s2 core.calc out=?s3 fn=div args=?s1 args=2
@rs.s3 core.calc out=?s4 fn=round args=?s3
@rs.s4 core.calc out=?s2 fn=mul args=?s4 args=2
@rs.key core.calc out=?key fn=concat args=smaller- args=?st args=- args=?rk
@rs.out ui.draw.region key=?key tier=?nt order=?t host=?host x0=?x0 y0=?y0 x1=?x1 y1=?fy1 size=?s2 far=1
@region.smaller core.rule when=$rs.r when=$rs.page if=$rs.low if=$rs.free with=$rs.tier with=$rs.s with=$rs.s2 with=$rs.s3 with=$rs.s4 with=$rs.dh with=$rs.fh with=$rs.y1 with=$rs.key then=$rs.out
# A thing a container holds stays in it, drawn smaller (farther away), before it goes to a band of the page: the
# smaller variants of a container's region come right after that region.
@rs.free core.check fn=gt args=?t args=1
@rs.held core.check fn=eq args=?t args=1
@rs.tenth core.calc out=?tn fn=div args=?st args=10
@rs.tier.held core.calc out=?ht fn=add args=1 args=?tn
@rs.out.held ui.draw.region key=?key tier=?ht order=?t host=?host x0=?x0 y0=?y0 x1=?x1 y1=?fy1 size=?s2 far=1
@region.smaller.held core.rule when=$rs.r when=$rs.page if=$rs.held with=$rs.tenth with=$rs.tier.held with=$rs.s with=$rs.s2 with=$rs.s3 with=$rs.s4 with=$rs.dh with=$rs.fh with=$rs.y1 with=$rs.key then=$rs.out.held
# A kind with a region of its own stays there (overlapping the fewest objects when it is full); the page is for the
# kinds with none.
@hm.out ui.draw.homed kind=?k
@homed.holds core.rule when=$rh.auto when=$rh.as when=$rh.page when=$rh.slot then=$hm.out
@homed.place core.rule when=$rh.auto when=$rh.as when=$rp.scene when=$rh.area then=$hm.out
@rw.homed ui.draw.homed kind=?k
@rw.page ui.draw.page w=?pw h=?ph
@rw.out ui.draw.region key=page tier=7 order=0 host=none x0=0 y0=0 x1=?pw y1=?ph size=?s
@region.page core.rule when=$rh.auto not=$rw.homed when=$rw.page when=$rh.s then=$rw.out

# The placement problem (std.problem) the application solves, with Z3 where the page can run it and the library's
# internal search otherwise: the regions of step 2 are its candidates, in their order (tier, then order), each with
# the size the object has there. In a region the object's centre stays inside it when the object fits there (else at
# its middle) and the object stays on the page; it keeps the gap from every object except its container (soft, at
# peerWeight each, more than any distance to the centre costs: an overlap only when no region has room) and is as near the centre of the region as it can be
# (soft, centreWeight per unit of distance on each axis; vertically at fy, 0 the top and 100 the bottom) with its centre not within stackDistance of an object's centre
# (soft, stackWeight); the first region with no overlap wins, else the one with
# the fewest. Steps 3 and 4 below are the same choice by a grid of spots, for a command run without the application.
@draw.place.region.type core.type of=app.place.region
@draw.place.objective.type core.type of=app.place.objective
@draw.place.objective app.place.objective gap=10 peerWeight=10000 centreWeight=1 stackDistance=20 stackWeight=2000 grid=10
@plr.r ui.draw.region key=?rk tier=?t order=?o host=?host x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s
@plr.far ui.draw.region key=?rk far=1
@plr.out app.place.region key=?rk tier=?t order=?o host=?host x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s fy=50
@place.region core.rule when=$plr.r not=$plr.far then=$plr.out
# A smaller (farther) object is pulled to the top of its region rather than its middle: farther is higher.
@plr.out.far app.place.region key=?rk tier=?t order=?o host=?host x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s fy=0
@place.region.far core.rule when=$plr.r when=$plr.far then=$plr.out.far

# 3. The spots of each region: inside it when the object fits there, on the page always.
@cd.r ui.draw.region key=?rk tier=?t order=?o host=?host x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s
@cd.g ui.draw.grid n=?n fx=?fx fy=?fy
@cd.page ui.draw.page w=?pw h=?ph
@cd.hs core.calc out=?hs fn=div args=?s args=2
@cd.lx core.calc out=?lx fn=add args=?x0 args=?hs
@cd.ly core.calc out=?ly fn=add args=?y0 args=?hs
@cd.ux core.calc out=?ux fn=sub args=?x1 args=?hs
@cd.uy core.calc out=?uy fn=sub args=?y1 args=?hs
@cd.sx core.calc out=?sx fn=add args=?x0 args=?x1
@cd.sy core.calc out=?sy fn=add args=?y0 args=?y1
@cd.mx core.calc out=?mx fn=div args=?sx args=2
@cd.my core.calc out=?my fn=div args=?sy args=2
@cd.lx2 core.calc out=?lx2 fn=min args=?lx args=?mx
@cd.ly2 core.calc out=?ly2 fn=min args=?ly args=?my
@cd.wx core.calc out=?wx fn=sub args=?ux args=?lx2
@cd.wy core.calc out=?wy fn=sub args=?uy args=?ly2
@cd.wx2 core.calc out=?wx2 fn=max args=?wx args=0
@cd.wy2 core.calc out=?wy2 fn=max args=?wy args=0
@cd.px core.calc out=?px fn=mul args=?wx2 args=?fx
@cd.py core.calc out=?py fn=mul args=?wy2 args=?fy
@cd.qx core.calc out=?qx fn=div args=?px args=100
@cd.qy core.calc out=?qy fn=div args=?py args=100
@cd.cx core.calc out=?cx fn=add args=?lx2 args=?qx
@cd.cy core.calc out=?cy fn=add args=?ly2 args=?qy
@cd.hx core.calc out=?hx fn=sub args=?pw args=?hs
@cd.hy core.calc out=?hy fn=sub args=?ph args=?hs
@cd.kx core.calc out=?kx fn=clamp args=?cx args=?hs args=?hx
@cd.ky core.calc out=?ky fn=clamp args=?cy args=?hs args=?hy
@cd.rx core.calc out=?rx fn=round args=?kx
@cd.ry core.calc out=?ry fn=round args=?ky
@cd.rs core.calc out=?rs fn=round args=?s
@cd.t5 core.calc out=?t5 fn=mul args=?t args=10000000
@cd.o2 core.calc out=?o2 fn=mul args=?o args=10000
@cd.score core.calc out=?score fn=add args=?t5 args=?o2 args=?n
@cd.id core.calc out=?cid fn=concat args=?rk args=. args=?n
@cd.out ui.draw.candidate id=?cid x=?rx y=?ry size=?rs host=?host score=?score
@spot core.rule when=$cd.r when=$cd.g when=$cd.page with=$cd.hs with=$cd.lx with=$cd.ly with=$cd.ux with=$cd.uy with=$cd.sx with=$cd.sy with=$cd.mx with=$cd.my with=$cd.lx2 with=$cd.ly2 with=$cd.wx with=$cd.wy with=$cd.wx2 with=$cd.wy2 with=$cd.px with=$cd.py with=$cd.qx with=$cd.qy with=$cd.cx with=$cd.cy with=$cd.hx with=$cd.hy with=$cd.kx with=$cd.ky with=$cd.rx with=$cd.ry with=$cd.rs with=$cd.t5 with=$cd.o2 with=$cd.score with=$cd.id then=$cd.out

# Beside each object on the page, in each row of the grid: the spots that touch it from the left and the right
# with the gap between (after the grid spots of the same region).
@bs.r ui.draw.region key=?rk tier=?t order=?o host=?host x0=?x0 y0=?y0 x1=?x1 y1=?y1 size=?s
@bs.o w.drawing.object code=?oid x=?ox size=?os z=?oz
@bs.side ui.draw.beside side=?side n=?j
@bs.g ui.draw.grid n=?gn fx=50 fy=?fy
@bs.page ui.draw.page w=?pw h=?ph gap=?g
@bs.other core.check fn=neq args=?oid args=?host
@bs.hs core.calc out=?hs fn=div args=?s args=2
@bs.oh core.calc out=?oh fn=div args=?os args=2
@bs.d1 core.calc out=?d1 fn=add args=?hs args=?oh args=?g
@bs.d core.calc out=?d fn=mul args=?d1 args=?side
@bs.bx core.calc out=?bx fn=add args=?ox args=?d
@bs.ly core.calc out=?ly fn=add args=?y0 args=?hs
@bs.uy core.calc out=?uy fn=sub args=?y1 args=?hs
@bs.sy core.calc out=?sy fn=add args=?y0 args=?y1
@bs.my core.calc out=?my fn=div args=?sy args=2
@bs.ly2 core.calc out=?ly2 fn=min args=?ly args=?my
@bs.wy core.calc out=?wy fn=sub args=?uy args=?ly2
@bs.wy2 core.calc out=?wy2 fn=max args=?wy args=0
@bs.py core.calc out=?py fn=mul args=?wy2 args=?fy
@bs.qy core.calc out=?qy fn=div args=?py args=100
@bs.cy core.calc out=?cy fn=add args=?ly2 args=?qy
@bs.lx core.calc out=?lx fn=add args=?x0 args=?hs
@bs.ux core.calc out=?ux fn=sub args=?x1 args=?hs
@bs.inx core.check fn=lte args=?lx args=?bx
@bs.inx2 core.check fn=lte args=?bx args=?ux
@bs.hx core.calc out=?hx fn=sub args=?pw args=?hs
@bs.hy core.calc out=?hy fn=sub args=?ph args=?hs
@bs.ky core.calc out=?ky fn=clamp args=?cy args=?hs args=?hy
@bs.rx core.calc out=?rx fn=round args=?bx
@bs.ry core.calc out=?ry fn=round args=?ky
@bs.rs core.calc out=?rs fn=round args=?s
@bs.t5 core.calc out=?t5 fn=mul args=?t args=10000000
@bs.o2 core.calc out=?o2 fn=mul args=?o args=10000
@bs.n1 core.calc out=?n1 fn=mul args=?oz args=100
@bs.n2 core.calc out=?n2 fn=mul args=?gn args=2
@bs.score core.calc out=?score fn=add args=?t5 args=?o2 args=1000 args=?n1 args=?n2 args=?j
@bs.id core.calc out=?cid fn=concat args=?rk args=.beside. args=?oid args=. args=?gn args=. args=?j
@bs.out ui.draw.candidate id=?cid x=?rx y=?ry size=?rs host=?host score=?score
@spot.beside core.rule when=$bs.r when=$bs.o when=$bs.side when=$bs.g when=$bs.page if=$bs.other with=$bs.hs with=$bs.oh with=$bs.d1 with=$bs.d with=$bs.bx with=$bs.ly with=$bs.uy with=$bs.sy with=$bs.my with=$bs.ly2 with=$bs.wy with=$bs.wy2 with=$bs.py with=$bs.qy with=$bs.cy with=$bs.lx with=$bs.ux if=$bs.inx if=$bs.inx2 with=$bs.hx with=$bs.hy with=$bs.ky with=$bs.rx with=$bs.ry with=$bs.rs with=$bs.t5 with=$bs.o2 with=$bs.n1 with=$bs.n2 with=$bs.score with=$bs.id then=$bs.out

# 4. The first free spot; else the least crowded one that is not centred on an object.
@bk.c ui.draw.candidate id=?cid x=?cx y=?cy size=?s host=?host
@bk.o w.drawing.object code=?oid x=?ox y=?oy size=?os
@bk.page ui.draw.page gap=?g
@bk.other core.check fn=neq args=?oid args=?host
@bk.dx core.calc out=?dx fn=sub args=?cx args=?ox
@bk.dy core.calc out=?dy fn=sub args=?cy args=?oy
@bk.ax core.calc out=?ax fn=abs args=?dx
@bk.ay core.calc out=?ay fn=abs args=?dy
@bk.ss core.calc out=?ss fn=add args=?s args=?os
@bk.sh core.calc out=?sh fn=div args=?ss args=2
@bk.reach core.calc out=?reach fn=add args=?sh args=?g
@bk.nx core.check fn=lt args=?ax args=?reach
@bk.ny core.check fn=lt args=?ay args=?reach
@bk.out ui.draw.blocker candidate=?cid object=?oid
@blocked core.rule when=$bk.c when=$bk.o when=$bk.page if=$bk.other with=$bk.dx with=$bk.dy with=$bk.ax with=$bk.ay with=$bk.ss with=$bk.sh with=$bk.reach if=$bk.nx if=$bk.ny then=$bk.out
@st.near core.check fn=lt args=?ax args=20
@st.neary core.check fn=lt args=?ay args=20
@st.out ui.draw.stacked candidate=?cid
@stacked core.rule when=$bk.c when=$bk.o with=$bk.dx with=$bk.dy with=$bk.ax with=$bk.ay if=$st.near if=$st.neary then=$st.out
@fr.c ui.draw.candidate id=?cid score=?score
@fr.b ui.draw.blocker candidate=?cid
@fr.out ui.draw.free candidate=?cid score=?score
@fr.st ui.draw.stacked candidate=?cid
@free core.rule when=$fr.c not=$fr.b not=$fr.st then=$fr.out
@fr.all ui.draw.free candidate=?cid score=?score
@fr.best core.aggregate over=$fr.all argmin=?best args=?score pick=?cid ties=first then=$fr.best.o
@fr.best.o ui.draw.best candidate=?best from=free
@cw.b ui.draw.blocker candidate=?cid object=?oid
@cw.count core.aggregate over=$cw.b by=?cid count=?n then=$cw.out
@cw.out ui.draw.crowd candidate=?cid count=?n
@sp.crowd ui.draw.crowd candidate=?cid count=?n
@sp.c ui.draw.candidate id=?cid score=?score
@sp.st ui.draw.stacked candidate=?cid
@sp.any ui.draw.free candidate=?other
@sp.m core.calc out=?m fn=mul args=?n args=10000000
@sp.score core.calc out=?s2 fn=add args=?m args=?score
@sp.out ui.draw.spare candidate=?cid score=?s2
@spare core.rule when=$sp.crowd when=$sp.c not=$sp.st not=$sp.any with=$sp.m with=$sp.score then=$sp.out
@sp.all ui.draw.spare candidate=?cid score=?score
@sp.best core.aggregate over=$sp.all argmin=?best args=?score pick=?cid ties=first then=$sp.best.o
@sp.best.o ui.draw.best candidate=?best from=spare
@tg.best ui.draw.best candidate=?cid
@tg.c ui.draw.candidate id=?cid x=?x y=?y size=?s
@tg.out ui.draw.target x=?x y=?y size=?s
@target.chosen core.rule when=$tg.best when=$tg.c then=$tg.out
# A command that names x or y: the default place for the rest, the size of step 1.
@te.sub ui.draw.subject kind=?k
@te.d ui.draw.default x=?x y=?y
@te.s ui.draw.size size=?s
@te.out ui.draw.target x=?x y=?y size=?s
@target.given.x core.rule when=$te.sub when=$ex.x when=$te.d when=$te.s then=$te.out
@target.given.y core.rule when=$te.sub when=$ex.y when=$te.d when=$te.s then=$te.out

# The next object takes the layer after the highest one and the code "o" + that layer.
@next.o w.drawing.object z=?z
@next.max core.aggregate over=$next.o max=?top args=?z default=0 then=$next.fact
@next.fact ui.draw.next top=?top
@next.n ui.draw.next top=?top
@next.z core.calc out=?nz fn=add args=?top args=1
@next.code core.calc out=?code fn=concat args=o args=?nz

# Make an object of a kind (or of a catalog drawing), at the place and size chosen above unless the command says.
@make.req app.act.request operation="drawing.object.make" kind=?kind
@cat.req app.act.request operation="drawing.catalog.make" name=?kind
@make.t ui.draw.target x=?x y=?y size=?s
@make.call app.act.call act=make kind=w.drawing.object code=?code drawing=?kind x=?x y=?y size=?s z=?nz order=1 ref=new.object
@make core.rule when=$make.req when=$make.t when=$next.n with=$next.z with=$next.code then=$make.call
@cat.known k.objects.object name=?kind
@make.catalog core.rule when=$cat.req when=$cat.known when=$make.t when=$next.n with=$next.z with=$next.code then=$make.call
# The object just made is the selected one (an editor shows it; "it" can name it).
@made.select.view app.act.view key=selected value=?code
@made.unpart.view app.act.view key=part
@make.select core.rule when=$make.req when=$make.t when=$next.n with=$next.z with=$next.code then=$made.select.view
@make.catalog.select core.rule when=$cat.req when=$cat.known when=$make.t when=$next.n with=$next.z with=$next.code then=$made.select.view
@make.unpart core.rule when=$make.req then=$made.unpart.view
@make.catalog.unpart core.rule when=$cat.req when=$cat.known then=$made.unpart.view
# A drawing made from the catalog is named after it, the name the command asked for.
@cat.name.arg app.act.arg call=new.object attr=name value=?kind
@make.catalog.name core.rule when=$cat.req when=$cat.known then=$cat.name.arg
@cat.unknown app.act.refuse reason=drawing-not-in-catalog
@cat.unknown.people k.people.kind name=?kind
@make.catalog.unknown core.rule when=$cat.req not=$cat.known not=$cat.unknown.people then=$cat.unknown
@make.x.req app.act.request x=?v
@make.x.arg app.act.arg call=new.object attr=x value=?v
@make.x core.rule when=$make.x.req then=$make.x.arg
@make.y.req app.act.request y=?v
@make.y.arg app.act.arg call=new.object attr=y value=?v
@make.y core.rule when=$make.y.req then=$make.y.arg
@make.size.req app.act.request size=?v
@make.size.arg app.act.arg call=new.object attr=size value=?v
@make.size core.rule when=$make.size.req then=$make.size.arg
@make.label.req app.act.request operation="drawing.object.make" label=?v
@make.label.arg app.act.arg call=new.object attr=label value=?v
@make.label core.rule when=$make.label.req then=$make.label.arg
@make.name.req app.act.request operation="drawing.object.make" name=?v
@make.name.arg app.act.arg call=new.object attr=name value=?v
@make.name core.rule when=$make.name.req then=$make.name.arg
@make.width.req app.act.request operation="drawing.object.make" width=?v
@make.width.arg app.act.arg call=new.object attr=width value=?v
@make.width core.rule when=$make.width.req then=$make.width.arg
@make.height.req app.act.request operation="drawing.object.make" height=?v
@make.height.arg app.act.arg call=new.object attr=height value=?v
@make.height core.rule when=$make.height.req then=$make.height.arg
@make.colour.req app.act.request operation="drawing.object.make" color=?v
@make.colour.arg app.act.arg call=new.object attr=colour value=?v
@make.colour core.rule when=$make.colour.req then=$make.colour.arg
# Facing (render-projection.sop): a made object (a drawn kind or a catalog drawing) faces the side the command gives
# (facing: left or right), or the side an object on the page is on (toward: its code), from where the new object goes.
@make.facing.req app.act.request operation="drawing.object.make" facing=?v
@make.facing.cat app.act.request operation="drawing.catalog.make" facing=?v
@make.facing.arg app.act.arg call=new.object attr=art.draw.facing value=?v
@make.facing core.rule when=$make.facing.req then=$make.facing.arg
@make.facing.catalog core.rule when=$make.facing.cat then=$make.facing.arg
@draw.newx.type core.type of=ui.draw.newx
@draw.towardnew.type core.type of=ui.draw.towardnew
@fnx.req app.act.request x=?x
@fnx.any app.act.request x=?anyx
@fnx.t ui.draw.target x=?x
@fnx.out ui.draw.newx x=?x
@facing.newx.given core.rule when=$fnx.req then=$fnx.out
@facing.newx.placed core.rule when=$fnx.t not=$fnx.any then=$fnx.out
@fmt.make app.act.request operation="drawing.object.make" toward=?tid
@fmt.cat app.act.request operation="drawing.catalog.make" toward=?tid
@fmt.out ui.draw.towardnew object=?tid
@facing.toward.make core.rule when=$fmt.make then=$fmt.out
@facing.toward.catalog core.rule when=$fmt.cat then=$fmt.out
@fmn.t ui.draw.towardnew object=?tid
@fmn.given app.act.request facing=?anyf
@fmn.x ui.draw.newx x=?x
@fmn.o w.drawing.object code=?tid x=?ox
@fmn.right core.check fn=gt args=?ox args=?x
@fmn.left core.check fn=lt args=?ox args=?x
@fmn.r.arg app.act.arg call=new.object attr=art.draw.facing value=right
@fmn.l.arg app.act.arg call=new.object attr=art.draw.facing value=left
@make.toward.right core.rule when=$fmn.t not=$fmn.given when=$fmn.x when=$fmn.o if=$fmn.right then=$fmn.r.arg
@make.toward.left core.rule when=$fmn.t not=$fmn.given when=$fmn.x when=$fmn.o if=$fmn.left then=$fmn.l.arg
@fmn.none app.act.refuse reason=facing-target-not-on-page
@fmn.code w.drawing.object code=?tid
@make.toward.unknown core.rule when=$fmn.t not=$fmn.code then=$fmn.none

# Change, place or remove listed objects.
@obj.item app.act.item param="ids" value=?id
@obj.thing w.drawing.object code=?id
@chg.label.req app.act.request operation="drawing.object.change" label=?v
@chg.label.call app.act.call act=change thing=$obj.thing attr=label value=?v order=1
@change.label core.rule when=$chg.label.req when=$obj.item when=$obj.thing then=$chg.label.call
@chg.name.req app.act.request operation="drawing.object.change" name=?v
@chg.name.call app.act.call act=change thing=$obj.thing attr=name value=?v order=1
@change.name core.rule when=$chg.name.req when=$obj.item when=$obj.thing then=$chg.name.call
@chg.width.req app.act.request operation="drawing.object.change" width=?v
@chg.width.call app.act.call act=change thing=$obj.thing attr=width value=?v order=1
@change.width core.rule when=$chg.width.req when=$obj.item when=$obj.thing then=$chg.width.call
@chg.height.req app.act.request operation="drawing.object.change" height=?v
@chg.height.call app.act.call act=change thing=$obj.thing attr=height value=?v order=1
@change.height core.rule when=$chg.height.req when=$obj.item when=$obj.thing then=$chg.height.call
@chg.x.req app.act.request operation="drawing.object.change" x=?v
@chg.x.call app.act.call act=change thing=$obj.thing attr=x value=?v order=1
@change.x core.rule when=$chg.x.req when=$obj.item when=$obj.thing then=$chg.x.call
@chg.y.req app.act.request operation="drawing.object.change" y=?v
@chg.y.call app.act.call act=change thing=$obj.thing attr=y value=?v order=1
@change.y core.rule when=$chg.y.req when=$obj.item when=$obj.thing then=$chg.y.call
@chg.size.req app.act.request operation="drawing.object.change" size=?v
@chg.size.call app.act.call act=change thing=$obj.thing attr=size value=?v order=1
@change.size core.rule when=$chg.size.req when=$obj.item when=$obj.thing then=$chg.size.call
@chg.colour.req app.act.request operation="drawing.object.change" color=?v
@chg.colour.call app.act.call act=change thing=$obj.thing attr=colour value=?v order=1
@change.colour core.rule when=$chg.colour.req when=$obj.item when=$obj.thing then=$chg.colour.call
# Facing: a change turns the listed objects to the side it gives, or to the side an object on the page is on (toward:
# its code; an object right above or below it keeps its facing); flipping one turns it to the other side.
@chg.facing.req app.act.request operation="drawing.object.change" facing=?v
@chg.facing.call app.act.call act=change thing=$obj.thing attr=art.draw.facing value=?v order=1
@change.facing core.rule when=$chg.facing.req when=$obj.item when=$obj.thing then=$chg.facing.call
@fct.req app.act.request operation="drawing.object.change" toward=?tid
@fct.given app.act.request operation="drawing.object.change" facing=?anyf
@fct.self w.drawing.object code=?id x=?x
@fct.o w.drawing.object code=?tid x=?ox
@fct.right core.check fn=gt args=?ox args=?x
@fct.left core.check fn=lt args=?ox args=?x
@fct.r.call app.act.call act=change thing=$obj.thing attr=art.draw.facing value=right order=1
@fct.l.call app.act.call act=change thing=$obj.thing attr=art.draw.facing value=left order=1
@change.toward.right core.rule when=$fct.req not=$fct.given when=$obj.item when=$obj.thing when=$fct.self when=$fct.o if=$fct.right then=$fct.r.call
@change.toward.left core.rule when=$fct.req not=$fct.given when=$obj.item when=$obj.thing when=$fct.self when=$fct.o if=$fct.left then=$fct.l.call
@fct.code w.drawing.object code=?tid
@fct.none app.act.refuse reason=facing-target-not-on-page
@change.toward.unknown core.rule when=$fct.req not=$fct.code then=$fct.none
@flp.req app.act.request operation="drawing.object.flip"
@flp.f ui.draw.facing object=?id facing=?f
@flp.other ui.draw.opposite side=?f other=?g
@flp.call app.act.call act=change thing=$obj.thing attr=art.draw.facing value=?g order=1
@flip core.rule when=$flp.req when=$obj.item when=$obj.thing when=$flp.f when=$flp.other then=$flp.call
@flp.opposite.type core.type of=ui.draw.opposite
@flp.opposite.left ui.draw.opposite side=left other=right
@flp.opposite.right ui.draw.opposite side=right other=left
@place.req app.act.request operation="drawing.object.place" x=?x y=?y
@place.x app.act.call act=change thing=$obj.thing attr=x value=?x order=1
@place.y app.act.call act=change thing=$obj.thing attr=y value=?y order=2
@place.cx core.rule when=$place.req when=$obj.item when=$obj.thing then=$place.x
@place.cy core.rule when=$place.req when=$obj.item when=$obj.thing then=$place.y
@remove.req app.act.request operation="drawing.object.remove"
@remove.call app.act.call act=remove thing=$obj.thing order=1
@remove core.rule when=$remove.req when=$obj.item when=$obj.thing then=$remove.call
@clear.req app.act.request operation="drawing.page.clear"
@clear.thing w.drawing.object code=?any
@clear.call app.act.call act=remove thing=$clear.thing order=1
@clear core.rule when=$clear.req when=$clear.thing then=$clear.call

# Groups.
@group.req app.act.request operation="drawing.object.group"
@group.call app.act.call act=make kind=w.drawing.group code=?code order=1 ref=new.group
@group core.rule when=$group.req when=$next.n with=$next.z with=$group.code then=$group.call
@group.sel app.act.view key=selected value=?code
@group.select core.rule when=$group.req when=$next.n with=$next.z with=$group.code then=$group.sel
@group.code core.calc out=?code fn=concat args=g args=?nz
@group.member app.act.arg call=new.group attr=member value=$obj.thing
@group.members core.rule when=$group.req when=$obj.item when=$obj.thing then=$group.member
@group.label.req app.act.request operation="drawing.object.group" label=?v
@group.label.arg app.act.arg call=new.group attr=label value=?v
@group.label core.rule when=$group.label.req then=$group.label.arg
@ungroup.req app.act.request operation="drawing.object.ungroup" id=?id
@ungroup.thing w.drawing.group code=?id
@ungroup.call app.act.call act=remove thing=$ungroup.thing order=1
@ungroup core.rule when=$ungroup.req when=$ungroup.thing then=$ungroup.call
@ungroup.unselect.view app.act.view key=selected
@ungroup.unselect core.rule when=$ungroup.req when=$ungroup.thing then=$ungroup.unselect.view

# Edits of one part: recolour or resize (a new edit, or a change of the existing one), remove.
@part.obj w.drawing.object code=?id
@part.edit w.drawing.part object=$part.obj index=?i
@part.any w.drawing.part object=$part.obj index=?i
# A look part's index (a part of a person's face or clothes) is edited through its face (look edits, below).
@part.lk ui.draw.lookpart object=?id index=?i
@part.colour.req app.act.request operation="drawing.part.change" id=?id index=?i color=?v
@part.colour.new app.act.call act=make kind=w.drawing.part object=$part.obj index=?i colour=?v order=1
@part.colour.chg app.act.call act=change thing=$part.edit attr=colour value=?v order=1
@part.colour.geo ui.draw.partedit object=?id index=?i
@part.colour.make core.rule when=$part.colour.req when=$part.obj not=$part.lk not=$part.any not=$part.colour.geo then=$part.colour.new
@part.colour.arg app.act.arg call=new.part attr=colour value=?v
@part.colour.with.geometry core.rule when=$part.colour.req when=$part.obj not=$part.lk not=$part.any when=$part.colour.geo then=$part.colour.arg
@part.colour.change core.rule when=$part.colour.req when=$part.obj not=$part.lk when=$part.edit then=$part.colour.chg
@part.rm.req app.act.request operation="drawing.part.remove" id=?id index=?i
@part.rm.new app.act.call act=make kind=w.drawing.part object=$part.obj index=?i removed=true order=1
@part.rm.chg app.act.call act=change thing=$part.edit attr=removed value=true order=1
@part.remove.make core.rule when=$part.rm.req when=$part.obj not=$part.lk not=$part.any then=$part.rm.new
@part.remove.change core.rule when=$part.rm.req when=$part.obj not=$part.lk when=$part.edit then=$part.rm.chg

# Geometry edits of one part (render-projection.sop, ui.draw.partgeo): drawing.part.place moves its centre to x, y and
# drawing.part.change resizes it to width, height, both in page units, about its centre. The edit keeps the move (dx,
# dy) and the size (width, height) in the drawing's 0..100 frame; what the command does not give stays as it is.
@pgr.place app.act.request operation="drawing.part.place" id=?id index=?i
@pgr.width app.act.request operation="drawing.part.change" id=?id index=?i width=?w
@pgr.height app.act.request operation="drawing.part.change" id=?id index=?i height=?h
@pgr.edit.o ui.draw.partedit object=?id index=?i
@part.geometry.place core.rule when=$pgr.place then=$pgr.edit.o
@part.geometry.width core.rule when=$pgr.width then=$pgr.edit.o
@part.geometry.height core.rule when=$pgr.height then=$pgr.edit.o
@pgt.e ui.draw.partedit object=?id index=?i
@pgt.g ui.draw.partgeo object=?id index=?i cx=?cx cy=?cy ex=?ex ey=?ey fw=?fw fh=?fh
@pgt.o w.drawing.object code=?id x=?ox y=?oy
@pgt.ext ui.draw.extent object=?id w=?ow h=?oh
@pgt.sx core.calc out=?sx fn=div args=?ow args=100
@pgt.sy core.calc out=?sy fn=div args=?oh args=100
@pgt.x app.act.request operation="drawing.part.place" x=?nx
@pgt.ux core.calc out=?ux fn=sub args=?nx args=?ox
@pgt.sc ui.draw.boxscale object=?id sx=?ssx
@pgt.fx core.calc out=?fx fn=div args=?ux args=?ssx
@pgt.gx core.calc out=?gx fn=add args=?fx args=50
@pgt.dx core.calc out=?dx fn=sub args=?gx args=?cx
@pgt.kdx core.calc out=?dx fn=sub args=?ex args=?cx
@pgt.dx.o ui.draw.partdx object=?id index=?i dx=?dx
@part.dx.given core.rule when=$pgt.e when=$pgt.g when=$pgt.o when=$pgt.ext when=$pgt.sc when=$pgt.x with=$pgt.sx with=$pgt.ux with=$pgt.fx with=$pgt.gx with=$pgt.dx then=$pgt.dx.o
@part.dx.kept core.rule when=$pgt.e when=$pgt.g not=$pgt.x with=$pgt.kdx then=$pgt.dx.o
@pgt.y app.act.request operation="drawing.part.place" y=?ny
@pgt.uy core.calc out=?uy fn=sub args=?ny args=?oy
@pgt.fy core.calc out=?fy fn=div args=?uy args=?sy
@pgt.gy core.calc out=?gy fn=add args=?fy args=50
@pgt.dy core.calc out=?dy fn=sub args=?gy args=?cy
@pgt.kdy core.calc out=?dy fn=sub args=?ey args=?cy
@pgt.dy.o ui.draw.partdy object=?id index=?i dy=?dy
@part.dy.given core.rule when=$pgt.e when=$pgt.g when=$pgt.o when=$pgt.ext when=$pgt.y with=$pgt.sy with=$pgt.uy with=$pgt.fy with=$pgt.gy with=$pgt.dy then=$pgt.dy.o
@part.dy.kept core.rule when=$pgt.e when=$pgt.g not=$pgt.y with=$pgt.kdy then=$pgt.dy.o
@pgt.w app.act.request operation="drawing.part.change" width=?nw
@pgt.fw core.calc out=?tw fn=div args=?nw args=?sx
@pgt.fw.o ui.draw.partfw object=?id index=?i fw=?tw
@pgt.kfw.o ui.draw.partfw object=?id index=?i fw=?fw
@part.width.given core.rule when=$pgt.e when=$pgt.g when=$pgt.o when=$pgt.ext when=$pgt.w with=$pgt.sx with=$pgt.fw then=$pgt.fw.o
@part.width.kept core.rule when=$pgt.e when=$pgt.g not=$pgt.w then=$pgt.kfw.o
@pgt.h app.act.request operation="drawing.part.change" height=?nh
@pgt.fh core.calc out=?th fn=div args=?nh args=?sy
@pgt.fh.o ui.draw.partfh object=?id index=?i fh=?th
@pgt.kfh.o ui.draw.partfh object=?id index=?i fh=?fh
@part.height.given core.rule when=$pgt.e when=$pgt.g when=$pgt.o when=$pgt.ext when=$pgt.h with=$pgt.sy with=$pgt.fh then=$pgt.fh.o
@part.height.kept core.rule when=$pgt.e when=$pgt.g not=$pgt.h then=$pgt.kfh.o
@pgs.dx ui.draw.partdx object=?id index=?i dx=?dx
@pgs.dy ui.draw.partdy object=?id index=?i dy=?dy
@pgs.fw ui.draw.partfw object=?id index=?i fw=?fw
@pgs.fh ui.draw.partfh object=?id index=?i fh=?fh
@pgs.obj w.drawing.object code=?id
@pgs.edit w.drawing.part object=$pgs.obj index=?i
@pgs.make app.act.call act=make kind=w.drawing.part object=$pgs.obj index=?i dx=?dx dy=?dy width=?fw height=?fh order=1 ref=new.part
@part.geometry.make core.rule when=$pgs.dx when=$pgs.dy when=$pgs.fw when=$pgs.fh when=$pgs.obj not=$pgs.edit then=$pgs.make
@pgs.cdx app.act.call act=change thing=$pgs.edit attr=dx value=?dx order=1
@pgs.cdy app.act.call act=change thing=$pgs.edit attr=dy value=?dy order=2
@pgs.cfw app.act.call act=change thing=$pgs.edit attr=width value=?fw order=3
@pgs.cfh app.act.call act=change thing=$pgs.edit attr=height value=?fh order=4
@part.geometry.dx core.rule when=$pgs.dx when=$pgs.obj when=$pgs.edit then=$pgs.cdx
@part.geometry.dy core.rule when=$pgs.dy when=$pgs.obj when=$pgs.edit then=$pgs.cdy
@part.geometry.fw core.rule when=$pgs.fw when=$pgs.obj when=$pgs.edit then=$pgs.cfw
@part.geometry.fh core.rule when=$pgs.fh when=$pgs.obj when=$pgs.edit then=$pgs.cfh

# Extract a part: a new object of the basic shape the part is drawn as (a box shape: rectangle, square, circle, oval,
# triangle), where the part is drawn, as big and in the colour it is drawn; the part leaves its object. A part drawn
# through points (a polygon, a line) has no basic shape to become and is refused.
@px.req app.act.request operation="drawing.part.extract" id=?id index=?i
@px.o w.drawing.object code=?id x=?ox y=?oy
@px.kp k.objects.part shape=?shape
@px.g ui.draw.partgeo object=?id source=$px.kp index=?i ex=?ex ey=?ey fw=?fw fh=?fh
@px.basic ui.draw.shape drawing=?shape shape=?shape
@px.pt k.objects.point part=$px.kp
@px.ext ui.draw.extent object=?id w=?ow h=?oh
@px.fill ui.draw.fill source=$px.kp part=?id fill=?rgb
@px.sx core.calc out=?sx fn=div args=?ow args=100
@px.sy core.calc out=?sy fn=div args=?oh args=100
@px.ux core.calc out=?ux fn=sub args=?ex args=50
@px.uy core.calc out=?uy fn=sub args=?ey args=50
@px.sc ui.draw.boxscale object=?id sx=?ssx
@px.vx core.calc out=?vx fn=mul args=?ux args=?ssx
@px.vy core.calc out=?vy fn=mul args=?uy args=?sy
@px.nx core.calc out=?nx fn=add args=?ox args=?vx
@px.ny core.calc out=?ny fn=add args=?oy args=?vy
@px.nw core.calc out=?nw fn=mul args=?fw args=?sx
@px.nh core.calc out=?nh fn=mul args=?fh args=?sy
@px.ns core.calc out=?ns fn=max args=?nw args=?nh
@px.make app.act.call act=make kind=w.drawing.object code=?code drawing=?shape x=?nx y=?ny size=?ns width=?nw height=?nh colour=?rgb z=?nz order=1 ref=new.object
@part.extract core.rule when=$px.req when=$px.o when=$px.kp when=$px.g when=$px.basic not=$px.pt when=$px.ext when=$px.sc when=$px.fill when=$next.n with=$px.sx with=$px.sy with=$px.ux with=$px.uy with=$px.vx with=$px.vy with=$px.nx with=$px.ny with=$px.nw with=$px.nh with=$px.ns with=$next.z with=$next.code then=$px.make
@px.edit w.drawing.part object=$px.o index=?i
@px.rm.new app.act.call act=make kind=w.drawing.part object=$px.o index=?i removed=true order=2
@px.rm.chg app.act.call act=change thing=$px.edit attr=removed value=true order=2
@part.extract.leave.make core.rule when=$px.req when=$px.o when=$px.kp when=$px.g when=$px.basic not=$px.pt not=$px.edit then=$px.rm.new
@part.extract.leave.change core.rule when=$px.req when=$px.o when=$px.kp when=$px.g when=$px.basic not=$px.pt when=$px.edit then=$px.rm.chg
@px.sel app.act.view key=selected value=?code
@px.unpart app.act.view key=part
@part.extract.select core.rule when=$px.req when=$px.o when=$px.kp when=$px.g when=$px.basic not=$px.pt when=$next.n with=$next.z with=$next.code then=$px.sel
@part.extract.unselect.part core.rule when=$px.req when=$px.o when=$px.kp when=$px.g when=$px.basic not=$px.pt then=$px.unpart
@px.points.no app.act.refuse reason=part-extract-shape-not-declared
@part.extract.points core.rule when=$px.req when=$px.o when=$px.kp when=$px.g when=$px.pt then=$px.points.no
@px.shape.no app.act.refuse reason=part-extract-shape-not-declared
@part.extract.shape core.rule when=$px.req when=$px.o when=$px.kp when=$px.g not=$px.basic then=$px.shape.no

# Fit the listed objects into a box (x, y: its top left corner; width, height): their joint box (app.observe.box)
# maps onto it, each object's centre and sides scale with it. A move (the same width and height) changes only x and y.
@tf.req app.act.request operation="drawing.objects.transform" x=?tx y=?ty width=?tw height=?th
@tf.item app.act.item param="ids" value=?id
@tf.box app.observe.box id=?id x0=?x0 y0=?y0 x1=?x1 y1=?y1
@tf.pick.o ui.draw.fitpick id=?id x0=?x0 y0=?y0 x1=?x1 y1=?y1
@fit.pick core.rule when=$tf.req when=$tf.item when=$tf.box then=$tf.pick.o
@tf.p.x0 ui.draw.fitpick x0=?a
@tf.p.y0 ui.draw.fitpick y0=?a
@tf.p.x1 ui.draw.fitpick x1=?a
@tf.p.y1 ui.draw.fitpick y1=?a
@tf.ux0.o ui.draw.fitbox side=x0 v=?v
@tf.uy0.o ui.draw.fitbox side=y0 v=?v
@tf.ux1.o ui.draw.fitbox side=x1 v=?v
@tf.uy1.o ui.draw.fitbox side=y1 v=?v
@fit.x0 core.aggregate over=$tf.p.x0 min=?v args=?a then=$tf.ux0.o
@fit.y0 core.aggregate over=$tf.p.y0 min=?v args=?a then=$tf.uy0.o
@fit.x1 core.aggregate over=$tf.p.x1 max=?v args=?a then=$tf.ux1.o
@fit.y1 core.aggregate over=$tf.p.y1 max=?v args=?a then=$tf.uy1.o
@tf.bx0 ui.draw.fitbox side=x0 v=?ux0
@tf.by0 ui.draw.fitbox side=y0 v=?uy0
@tf.bx1 ui.draw.fitbox side=x1 v=?ux1
@tf.by1 ui.draw.fitbox side=y1 v=?uy1
@tf.pk ui.draw.fitpick id=?id
@tf.o w.drawing.object code=?id x=?ox y=?oy
@tf.ext ui.draw.extent object=?id w=?ow h=?oh
@tf.uw core.calc out=?uw fn=sub args=?ux1 args=?ux0
@tf.uh core.calc out=?uh fn=sub args=?uy1 args=?uy0
@tf.kx core.calc out=?kx fn=div args=?tw args=?uw
@tf.ky core.calc out=?ky fn=div args=?th args=?uh
@tf.rx core.calc out=?rx fn=sub args=?ox args=?ux0
@tf.ry core.calc out=?ry fn=sub args=?oy args=?uy0
@tf.sx core.calc out=?sx fn=mul args=?rx args=?kx
@tf.sy core.calc out=?sy fn=mul args=?ry args=?ky
@tf.nx core.calc out=?nx fn=add args=?tx args=?sx
@tf.ny core.calc out=?ny fn=add args=?ty args=?sy
@tf.nw core.calc out=?nw fn=mul args=?ow args=?kx
@tf.nh core.calc out=?nh fn=mul args=?oh args=?ky
@tf.ns core.calc out=?ns fn=max args=?nw args=?nh
@tf.thing w.drawing.object code=?id
@tf.cx app.act.call act=change thing=$tf.thing attr=x value=?nx order=1
@tf.cy app.act.call act=change thing=$tf.thing attr=y value=?ny order=2
@fit.move.x core.rule when=$tf.req when=$tf.bx0 when=$tf.by0 when=$tf.bx1 when=$tf.by1 when=$tf.pk when=$tf.o when=$tf.thing with=$tf.uw with=$tf.kx with=$tf.rx with=$tf.sx with=$tf.nx then=$tf.cx
@fit.move.y core.rule when=$tf.req when=$tf.bx0 when=$tf.by0 when=$tf.bx1 when=$tf.by1 when=$tf.pk when=$tf.o when=$tf.thing with=$tf.uh with=$tf.ky with=$tf.ry with=$tf.sy with=$tf.ny then=$tf.cy
@tf.wide core.check fn=neq args=?tw args=?uw
@tf.tall core.check fn=neq args=?th args=?uh
@tf.scaled.o ui.draw.fitscaled request=yes
@fit.scaled.w core.rule when=$tf.req when=$tf.bx0 when=$tf.bx1 with=$tf.uw if=$tf.wide then=$tf.scaled.o
@fit.scaled.h core.rule when=$tf.req when=$tf.by0 when=$tf.by1 with=$tf.uh if=$tf.tall then=$tf.scaled.o
@tf.scaled ui.draw.fitscaled request=yes
@tf.cw app.act.call act=change thing=$tf.thing attr=width value=?nw order=3
@tf.ch app.act.call act=change thing=$tf.thing attr=height value=?nh order=4
@tf.cs app.act.call act=change thing=$tf.thing attr=size value=?ns order=5
@fit.width core.rule when=$tf.req when=$tf.scaled when=$tf.bx0 when=$tf.by0 when=$tf.bx1 when=$tf.by1 when=$tf.pk when=$tf.o when=$tf.ext when=$tf.thing with=$tf.uw with=$tf.kx with=$tf.nw then=$tf.cw
@fit.height core.rule when=$tf.req when=$tf.scaled when=$tf.bx0 when=$tf.by0 when=$tf.bx1 when=$tf.by1 when=$tf.pk when=$tf.o when=$tf.ext when=$tf.thing with=$tf.uh with=$tf.ky with=$tf.nh then=$tf.ch
@fit.size core.rule when=$tf.req when=$tf.scaled when=$tf.bx0 when=$tf.by0 when=$tf.bx1 when=$tf.by1 when=$tf.pk when=$tf.o when=$tf.ext when=$tf.thing with=$tf.uw with=$tf.uh with=$tf.kx with=$tf.ky with=$tf.nw with=$tf.nh with=$tf.ns then=$tf.cs

# View keys.
@sel.req app.act.request operation="drawing.object.select" id=?id
@sel.view app.act.view key=selected value=?id
@select core.rule when=$sel.req then=$sel.view
@sels.req app.act.request operation="drawing.objects.select"
@sels.view app.act.view key=selected value=?id
@select.many core.rule when=$sels.req when=$obj.item then=$sels.view
@ids.req app.act.request operation="drawing.ids.show" mode=?m
@ids.view app.act.view key=ids value=?m
@ids core.rule when=$ids.req then=$ids.view
@psel.req app.act.request operation="drawing.part.select" id=?id index=?i
@psel.view app.act.view key=part value=?i
@part.select core.rule when=$psel.req then=$psel.view
@psel.object app.act.view key=selected value=?id
@part.select.object core.rule when=$psel.req then=$psel.object
@unpart.view app.act.view key=part
@sel.unpart core.rule when=$sel.none.req then=$unpart.view
@sels.unpart core.rule when=$sels.req then=$unpart.view

# What a reader observes, and the geometry placement needs.
@ob.o w.drawing.object code=?id drawing=?k x=?x y=?y size=?s
@ob.sel app.area.view key=selected value=?id
@ob.o.o app.observe.object id=?id kind=?k sourceType=art.draw.object binding=drawing.object x=?x y=?y size=?s selected=false
@ob.o.sel app.observe.object id=?id kind=?k sourceType=art.draw.object binding=drawing.object x=?x y=?y size=?s selected=true
@ob.grouped.o w.drawing.object code=?id
@ob.grouped w.drawing.group code=?g member=$ob.grouped.o
@ob.member app.observe.object id=?id kind=?k sourceType=art.draw.object binding=drawing.object x=?x y=?y size=?s selected=false in=?g role=member
@ob.member.sel app.observe.object id=?id kind=?k sourceType=art.draw.object binding=drawing.object x=?x y=?y size=?s selected=true in=?g role=member
@ob.member.tag app.observe.member id=?id
@ob.member.mark core.rule when=$ob.grouped.o when=$ob.grouped then=$ob.member.tag
@ob.is.member app.observe.member id=?id
@draw.observe.object core.rule when=$ob.o not=$ob.sel not=$ob.is.member then=$ob.o.o
@draw.observe.object.selected core.rule when=$ob.o when=$ob.sel not=$ob.is.member then=$ob.o.sel
@draw.observe.object.member core.rule when=$ob.o when=$ob.grouped.o when=$ob.grouped not=$ob.sel then=$ob.member
@draw.observe.object.member.selected core.rule when=$ob.o when=$ob.grouped.o when=$ob.grouped when=$ob.sel then=$ob.member.sel
@ob.in.label w.drawing.object code=?id label=?v
@ob.in.label.o app.observe.input id=?id key=label value=?v
@draw.observe.label core.rule when=$ob.in.label then=$ob.in.label.o
@ob.in.name w.drawing.object code=?id name=?v
@ob.in.name.o app.observe.input id=?id key=name value=?v
@draw.observe.name core.rule when=$ob.in.name then=$ob.in.name.o
@ob.in.colour w.drawing.object code=?id colour=?v
@ob.in.colour.o app.observe.input id=?id key=color value=?v
@draw.observe.colour core.rule when=$ob.in.colour then=$ob.in.colour.o
# Width and height are observed for every object: the sides of the box it is drawn in (its own width or height,
# else its size), so a comparative of either side ("wider") has the value the object has now.
@ob.in.extent ui.draw.extent object=?id w=?w h=?h
@ob.in.width.o app.observe.input id=?id key=width value=?w
@ob.in.height.o app.observe.input id=?id key=height value=?h
@draw.observe.width core.rule when=$ob.in.extent then=$ob.in.width.o
@draw.observe.height core.rule when=$ob.in.extent then=$ob.in.height.o
# Facing is observed for every object: the side it faces now (its own facing, else its drawing's; render-projection.sop).
@ob.in.facing ui.draw.facing object=?id facing=?f
@ob.in.facing.o app.observe.input id=?id key=facing value=?f
@draw.observe.facing core.rule when=$ob.in.facing then=$ob.in.facing.o
# Each drawn part of an object is observed under it (id <code>.<index>, its k.objects name as kind), so a reader can
# name "the roof" of the house; a removed part is not observed.
@obp.o w.drawing.object code=?id
@obp.kp k.objects.part name=?name
@obp.ix ui.draw.index object=?id source=$obp.kp index=?i
@obp.removed w.drawing.part object=$obp.o index=?i removed=true
@obp.pid core.calc out=?pid fn=concat args=?id args="." args=?i
@obp.out app.observe.object id=?pid kind=?name sourceType=art.draw.part binding=drawing.part in=?id role=?name name=?name index=?i
@obp.hidden ui.draw.hidden object=?id source=$obp.kp
@draw.observe.part core.rule when=$obp.o when=$obp.kp when=$obp.ix not=$obp.removed not=$obp.hidden with=$obp.pid then=$obp.out
@ob.member.type core.type of=app.observe.member
@sp.frame app.observe.frame id=drawing.canvas x0=0 y0=0 x1=1000 y1=700 evidence=rectangle
@sp.o w.drawing.object code=?id x=?x y=?y
@sp.ext ui.draw.extent object=?id w=?w h=?h
@sp.hw core.calc out=?hw fn=div args=?w args=2
@sp.hh core.calc out=?hh fn=div args=?h args=2
@sp.x0 core.calc out=?x0 fn=sub args=?x args=?hw
@sp.y0 core.calc out=?y0 fn=sub args=?y args=?hh
@sp.x1 core.calc out=?x1 fn=add args=?x args=?hw
@sp.y1 core.calc out=?y1 fn=add args=?y args=?hh
@sp.box app.observe.box id=?id x0=?x0 y0=?y0 x1=?x1 y1=?y1 occupant=true
@sp.backdrop ui.draw.backdrop object=?id
@spatial.box core.rule when=$sp.o not=$sp.backdrop when=$sp.ext with=$sp.hw with=$sp.hh with=$sp.x0 with=$sp.y0 with=$sp.x1 with=$sp.y1 then=$sp.box
# Where other things go on each object (its k.layouts anchors: the water of a lake, the surface of a table), in page
# units, with the kinds each holds: placement puts "a boat in the lake" into the water, "a cup on the table" on it.
@rg.o w.drawing.object code=?id drawing=?k x=?x y=?y size=?s
@rg.a k.layouts.anchor of=?k kind=?ak holds=?h x=?ax y=?ay w=?aw h=?ah
@rg.sc core.calc out=?sc fn=div args=?s args=100
@rg.half core.calc out=?hs fn=div args=?s args=2
@rg.ox core.calc out=?ox fn=sub args=?x args=?hs
@rg.oy core.calc out=?oy fn=sub args=?y args=?hs
@rg.dx core.calc out=?dx fn=mul args=?ax args=?sc
@rg.dy core.calc out=?dy fn=mul args=?ay args=?sc
@rg.bw core.calc out=?bw fn=mul args=?aw args=?sc
@rg.bh core.calc out=?bh fn=mul args=?ah args=?sc
@rg.x0 core.calc out=?x0 fn=add args=?ox args=?dx
@rg.y0 core.calc out=?y0 fn=add args=?oy args=?dy
@rg.x1 core.calc out=?x1 fn=add args=?x0 args=?bw
@rg.y1 core.calc out=?y1 fn=add args=?y0 args=?bh
@rg.out app.observe.region of=?id kind=?ak holds=?h x0=?x0 y0=?y0 x1=?x1 y1=?y1
@rg.terrain ui.draw.backdrop object=?id
@spatial.region core.rule when=$rg.o not=$rg.terrain when=$rg.a with=$rg.sc with=$rg.half with=$rg.ox with=$rg.oy with=$rg.dx with=$rg.dy with=$rg.bw with=$rg.bh with=$rg.x0 with=$rg.y0 with=$rg.x1 with=$rg.y1 then=$rg.out
@op.object w.drawing.object code=?id
@op.object.o app.observe.option id=object value=?id
@draw.option.object core.rule when=$op.object then=$op.object.o
@op.kind ui.draw.kind drawing=?k
@op.kind.o app.observe.option id=kind value=?k
@draw.option.kind core.rule when=$op.kind then=$op.kind.o

# Selecting nothing (id=null) clears the selection.
@sel.none.req app.act.request operation="drawing.object.select"
@sel.none.any app.act.request operation="drawing.object.select" id=?any
@sel.none.view app.act.view key=selected
@select.none core.rule when=$sel.none.req not=$sel.none.any then=$sel.none.view

# Groups are observed as objects of their own; a part's drawn colour is an observed input of the part.
@obg.g w.drawing.group code=?id
@obg.out app.observe.object id=?id kind=group sourceType=art.draw.group binding=drawing.group
@draw.observe.group core.rule when=$obg.g then=$obg.out
@obg.mo w.drawing.object code=?mc
@obg.m w.drawing.group code=?id member=$obg.mo
@obg.min app.observe.input id=?id key=member value=?mc
@draw.observe.member core.rule when=$obg.mo when=$obg.m then=$obg.min
@obc.kp k.objects.part name=?name
@obc.ix ui.draw.index object=?id source=$obc.kp index=?i
@obc.fill ui.draw.fill source=$obc.kp part=?id fill=?f
@obc.pid core.calc out=?pid fn=concat args=?id args="." args=?i
@obc.out app.observe.input id=?pid key=color value=?f
@draw.observe.part.colour core.rule when=$obc.kp when=$obc.ix when=$obc.fill with=$obc.pid then=$obc.out

# Where each drawn part is on the page (its centre, width and height in page units), and the colour an object's
# colour value paints (its RGB), for an editor; the colour names k.colours knows are the colour options.
@opg.o w.drawing.object code=?id x=?x y=?y
@opg.g ui.draw.partgeo object=?id index=?i ex=?ex ey=?ey fw=?fw fh=?fh
@opg.removed w.drawing.part object=$opg.o index=?i removed=true
@opg.ext ui.draw.extent object=?id w=?ow h=?oh
@opg.sx core.calc out=?sx fn=div args=?ow args=100
@opg.sy core.calc out=?sy fn=div args=?oh args=100
@opg.ux core.calc out=?ux fn=sub args=?ex args=50
@opg.uy core.calc out=?uy fn=sub args=?ey args=50
@opg.sc ui.draw.boxscale object=?id sx=?ssx
@opg.vx core.calc out=?vx fn=mul args=?ux args=?ssx
@opg.vy core.calc out=?vy fn=mul args=?uy args=?sy
@opg.px core.calc out=?px fn=add args=?x args=?vx
@opg.py core.calc out=?py fn=add args=?y args=?vy
@opg.pw core.calc out=?pw fn=mul args=?fw args=?sx
@opg.ph core.calc out=?ph fn=mul args=?fh args=?sy
@opg.pid core.calc out=?pid fn=concat args=?id args="." args=?i
@opg.x.o app.observe.input id=?pid key=x value=?px
@opg.y.o app.observe.input id=?pid key=y value=?py
@opg.w.o app.observe.input id=?pid key=width value=?pw
@opg.h.o app.observe.input id=?pid key=height value=?ph
@draw.observe.part.x core.rule when=$opg.o when=$opg.g not=$opg.removed when=$opg.ext when=$opg.sc with=$opg.sx with=$opg.ux with=$opg.vx with=$opg.px with=$opg.pid then=$opg.x.o
@draw.observe.part.y core.rule when=$opg.o when=$opg.g not=$opg.removed when=$opg.ext with=$opg.sy with=$opg.uy with=$opg.vy with=$opg.py with=$opg.pid then=$opg.y.o
@draw.observe.part.width core.rule when=$opg.o when=$opg.g not=$opg.removed when=$opg.ext with=$opg.sx with=$opg.pw with=$opg.pid then=$opg.w.o
@draw.observe.part.height core.rule when=$opg.o when=$opg.g not=$opg.removed when=$opg.ext with=$opg.sy with=$opg.ph with=$opg.pid then=$opg.h.o
@obf.o w.drawing.object code=?id colour=?c
@obf.rgb ui.draw.rgb colour=?c rgb=?rgb
@obf.out app.observe.input id=?id key=fill value=?rgb
@draw.observe.fill core.rule when=$obf.o when=$obf.rgb then=$obf.out
@op.colour k.colours.colour name=?c rgb=?rgb
@op.colour.o app.observe.option id=colour value=?c
@draw.option.colour core.rule when=$op.colour then=$op.colour.o

# People (authored; art.draw/person-rules.sop composes them): a kind drawn as a drawing that a body style is drawn on
# (k.faces.frame: the drawing person) is made with a look: a face (style plain, on the part that bears a face) and a
# body with clothes (style figure). Its age and sex are the kind's (k.people.kind: a boy is a male child) or the
# command's (age=, sex=: "an old person"); which face and which outfit of that age and sex is chosen by the object's
# seed (its layer when it has none), so two people of one kind look different and the same page draws the same.
@person.drawnas.type core.type of=ui.draw.drawnas
@person.figured.type core.type of=ui.draw.figured
@dn.sub ui.draw.subject kind=?k
@dn.own k.objects.object name=?k
@dn.own.o ui.draw.drawnas kind=?k drawing=?k
@drawn.as.own core.rule when=$dn.sub when=$dn.own then=$dn.own.o
@dn.people k.people.kind name=?k drawing=?d
@dn.people.o ui.draw.drawnas kind=?k drawing=?d
@drawn.as.people core.rule when=$dn.sub not=$dn.own when=$dn.people then=$dn.people.o
@fg.as ui.draw.drawnas kind=?k drawing=?d
@fg.frame k.faces.frame style=?bs drawing=?d
@fg.o ui.draw.figured kind=?k body=?bs
@figured core.rule when=$fg.as when=$fg.frame then=$fg.o
# A people kind is made by its catalog name: known through k.people.kind, drawn as its declared drawing.
@cat.people k.people.kind name=?kind drawing=?pd
@cat.people.drawing k.objects.object name=?pd
@make.catalog.people core.rule when=$cat.req not=$cat.known when=$cat.people when=$cat.people.drawing when=$make.t when=$next.n with=$next.z with=$next.code then=$make.call
@make.catalog.people.select core.rule when=$cat.req not=$cat.known when=$cat.people when=$cat.people.drawing when=$make.t when=$next.n with=$next.z with=$next.code then=$made.select.view
@make.catalog.people.name core.rule when=$cat.req not=$cat.known when=$cat.people when=$cat.people.drawing then=$cat.name.arg

# The person to compose: its key is the new object's code; the traits are the command's, else the kind's.
@pw.fg ui.draw.figured kind=?k body=?bs
@pw.seed core.calc out=?seed fn=add args=?top args=1
@pw.face.o ui.person.want key=?code style=plain seed=?seed
@person.want.face core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.seed then=$pw.face.o
@pw.req.age app.act.request age=?a
@pw.req.sex app.act.request sex=?x
@pw.kind.age k.people.kind name=?k age=?a
@pw.kind.sex k.people.kind name=?k sex=?x
@pw.age.o ui.person.want key=?code age=?a
@pw.sex.o ui.person.want key=?code sex=?x
@person.want.age.asked core.rule when=$pw.fg when=$pw.req.age when=$next.n with=$next.z with=$next.code then=$pw.age.o
@person.want.age.kind core.rule when=$pw.fg not=$pw.req.age when=$pw.kind.age when=$next.n with=$next.z with=$next.code then=$pw.age.o
@person.want.sex.asked core.rule when=$pw.fg when=$pw.req.sex when=$next.n with=$next.z with=$next.code then=$pw.sex.o
@person.want.sex.kind core.rule when=$pw.fg not=$pw.req.sex when=$pw.kind.sex when=$next.n with=$next.z with=$next.code then=$pw.sex.o
@pw.anyage.o ui.person.want key=?code age=any
@pw.anysex.o ui.person.want key=?code sex=any
@person.want.age.any core.rule when=$pw.fg not=$pw.req.age not=$pw.kind.age when=$next.n with=$next.z with=$next.code then=$pw.anyage.o
@person.want.sex.any core.rule when=$pw.fg not=$pw.req.sex not=$pw.kind.sex when=$next.n with=$next.z with=$next.code then=$pw.anysex.o
# The outfit: of the age and sex of the face chosen (a face for both sexes leaves the outfit's sex free).
@pw.pick ui.person.pick key=?code preset=?p
@pw.body.key core.calc out=?bkey fn=concat args=?code args=".body"
@pw.seed3 core.calc out=?bseed fn=add args=?seed args=?top
@pw.body.o ui.person.bodywant key=?bkey style=?bs seed=?bseed
@person.want.body core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.seed when=$pw.pick with=$pw.body.key with=$pw.seed3 then=$pw.body.o
@pw.pa k.faces.preset name=?p style=plain age=?a
@pw.px k.faces.preset name=?p style=plain sex=?x
@pw.body.age ui.person.bodywant key=?bkey age=?a
@pw.body.sex ui.person.bodywant key=?bkey sex=?x
@person.want.body.age core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code when=$pw.pick when=$pw.pa with=$pw.body.key then=$pw.body.age
@person.want.body.sex core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code when=$pw.pick when=$pw.px with=$pw.body.key then=$pw.body.sex
@pw.pxany k.faces.preset name=?p style=plain sex=?anySex
@pw.body.anysex ui.person.bodywant key=?bkey sex=any
@person.want.body.anysex core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code when=$pw.pick not=$pw.pxany with=$pw.body.key then=$pw.body.anysex

# The calls: the face and the body are made before the object, their parts after them; the object takes both as its look.
@pm.face.call app.act.call act=make kind=w.face.face style=plain order=0.1 ref=new.face
@pm.face.parts ui.person.parts face=new.face preset=?p order=0.3 part=0.2 withBody=true
@person.make.face core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code when=$pw.pick then=$pm.face.call
@person.make.face.parts core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code when=$pw.pick then=$pm.face.parts
@pm.bpick ui.person.bodypick key=?bkey preset=?o
@pm.body.call app.act.call act=make kind=w.face.face style=?bs order=0.1 ref=new.body
@pm.body.parts ui.person.parts face=new.body preset=?o order=0.3 part=0.2
@person.make.body core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.body.key when=$pm.bpick then=$pm.body.call
@person.make.body.parts core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.body.key when=$pm.bpick then=$pm.body.parts
@pm.look.face app.act.arg call=new.object attr=look value=new.face
@pm.look.body app.act.arg call=new.object attr=look value=new.body
@person.look.face core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code when=$pw.pick then=$pm.look.face
@person.look.body core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.body.key when=$pm.bpick then=$pm.look.body

# The person's skin (on its face and its body), its hair (unless the face is an old person's, whose hair is grey or
# white) and its clothes, chosen by its seed among the catalog's colours; set after the presets' own colours.
@pc2.skin.w ui.person.colourwant key=?code of=skin seed=?seed natural=true
@pc2.hair.w ui.person.colourwant key=?code of=hair seed=?hseed natural=true
@pc2.clothes.w ui.person.colourwant key=?code of=clothes seed=?cseed
@pc2.hseed core.calc out=?hseed fn=mul args=?seed args=3
@pc2.cseed core.calc out=?cseed fn=mul args=?seed args=7
@person.tone.skin core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.seed then=$pc2.skin.w
@pc2.old k.faces.preset name=?p style=plain age=old
@person.tone.hair core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.seed with=$pc2.hseed when=$pw.pick not=$pc2.old then=$pc2.hair.w
@person.tone.clothes core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.seed with=$pc2.cseed then=$pc2.clothes.w
@pc2.skin ui.person.colourpick key=?code of=skin colour=?c
@pc2.hair ui.person.colourpick key=?code of=hair colour=?c
@pc2.clothes ui.person.colourpick key=?code of=clothes colour=?c
@pc2.face.skin app.act.call act=change thing=new.face attr=skin value=?c order=0.4
@pc2.body.skin app.act.call act=change thing=new.body attr=skin value=?c order=0.4
@pc2.face.hair app.act.call act=change thing=new.face attr=hair_colour value=?c order=0.4
@pc2.body.clothes app.act.call act=change thing=new.body attr=clothes value=?c order=0.4
@person.set.face.skin core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code when=$pw.pick when=$pc2.skin then=$pc2.face.skin
@person.set.body.skin core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.body.key when=$pm.bpick when=$pc2.skin then=$pc2.body.skin
@person.set.face.hair core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code when=$pw.pick when=$pc2.hair then=$pc2.face.hair
@person.set.body.clothes core.rule when=$pw.fg when=$next.n with=$next.z with=$next.code with=$pw.body.key when=$pm.bpick when=$pc2.clothes then=$pc2.body.clothes

# Removing an object removes its looks (their parts, then the faces); clearing the page removes every look.
@rl.face w.face.face
@rl.o w.drawing.object code=?id look=$rl.face
@rl.part w.face.part face=$rl.face
@rl.part.call app.act.call act=remove thing=$rl.part order=2
@rl.face.call app.act.call act=remove thing=$rl.face order=3
@remove.look.parts core.rule when=$remove.req when=$obj.item when=$rl.face when=$rl.o when=$rl.part then=$rl.part.call
@remove.look.faces core.rule when=$remove.req when=$obj.item when=$rl.face when=$rl.o then=$rl.face.call
@cl.part w.face.part
@cl.face w.face.face
@cl.part.call app.act.call act=remove thing=$cl.part order=2
@cl.face.call app.act.call act=remove thing=$cl.face order=3
@clear.look.parts core.rule when=$clear.req when=$cl.part then=$cl.part.call
@clear.look.faces core.rule when=$clear.req when=$cl.face then=$cl.face.call

# Edits of a look part by its index (drawing.part.change, .place, .remove: the editor and the reader address every part
# of an object alike): the look rules (look-rules.sop) compile them on that part of its face. A width or a height scales
# the part (within the face's size range), a place moves it in its face's frame.
@lp.face w.face.face
@lp.lp ui.draw.lookpart object=?id index=?i face=$lp.face slot=?slot
@lp.c.req app.act.request operation="drawing.part.change" id=?id index=?i color=?c
@lp.c.o ui.face.edit face=$lp.face slot=?slot colour=?c
@look.edit.colour core.rule when=$lp.c.req when=$lp.face when=$lp.lp then=$lp.c.o
@lp.v.req app.act.request operation="drawing.part.change" id=?id index=?i variant=?v
@lp.v.o ui.face.edit face=$lp.face slot=?slot variant=?v
@look.edit.variant core.rule when=$lp.v.req when=$lp.face when=$lp.lp then=$lp.v.o
@lp.l.req app.act.request operation="drawing.part.change" id=?id index=?i length=?l
@lp.l.o ui.face.edit face=$lp.face slot=?slot property=length value=?l
@look.edit.length core.rule when=$lp.l.req when=$lp.face when=$lp.lp then=$lp.l.o
@lp.rm.req app.act.request operation="drawing.part.remove" id=?id index=?i
@lp.rm.o ui.face.edit face=$lp.face slot=?slot remove=true
@look.edit.remove core.rule when=$lp.rm.req when=$lp.face when=$lp.lp then=$lp.rm.o
@lp.w.req app.act.request operation="drawing.part.change" id=?id index=?i width=?nw
@lp.h.req app.act.request operation="drawing.part.change" id=?id index=?i height=?nh
@lp.geo.w app.observe.input id=?pid key=width value=?pw
@lp.geo.h app.observe.input id=?pid key=height value=?ph
@lp.pid core.calc out=?pid fn=concat args=?id args="." args=?i
@lp.size w.face.part face=$lp.face kind=?kind size=?sz
@lp.kind w.face.slot slot=?slot part=?kind
@lp.kw core.calc out=?kw fn=div args=?nw args=?pw
@lp.kh core.calc out=?kh fn=div args=?nh args=?ph
@lp.k1w core.calc out=?k1 fn=mul args=?kw args=?sz
@lp.k1h core.calc out=?k1 fn=mul args=?kh args=?sz
@lp.k2 core.calc out=?k2 fn=clamp args=?k1 args=0.6 args=1.5
@lp.k3 core.calc out=?k3 fn=round args=?k2 args=1
@lp.s.o ui.face.edit face=$lp.face slot=?slot scale=?k3
@look.edit.width core.rule when=$lp.w.req when=$lp.face when=$lp.lp with=$lp.pid when=$lp.geo.w when=$lp.kind when=$lp.size with=$lp.kw with=$lp.k1w with=$lp.k2 with=$lp.k3 then=$lp.s.o
@look.edit.height core.rule when=$lp.h.req not=$lp.w.req when=$lp.face when=$lp.lp with=$lp.pid when=$lp.geo.h when=$lp.kind when=$lp.size with=$lp.kh with=$lp.k1h with=$lp.k2 with=$lp.k3 then=$lp.s.o
@lp.pl.req app.act.request operation="drawing.part.place" id=?id index=?i x=?nx y=?ny
@lp.m ui.draw.mount object=?id face=$lp.face size=?ms
@lp.ext ui.draw.extent object=?id w=?ow h=?oh
@lp.geo.x app.observe.input id=?pid key=x value=?px
@lp.geo.y app.observe.input id=?pid key=y value=?py
@lp.xy w.face.part face=$lp.face kind=?kind x=?fx y=?fy
@lp.f core.calc out=?f fn=div args=?ms args=100
@lp.sc ui.draw.xsign object=?id k=?lk
@lp.fx core.calc out=?fxs fn=mul args=?ow args=?f args=?lk
@lp.fy core.calc out=?fys fn=mul args=?oh args=?f
@lp.ddx core.calc out=?ddx fn=sub args=?nx args=?px
@lp.ddy core.calc out=?ddy fn=sub args=?ny args=?py
@lp.qx core.calc out=?qx fn=div args=?ddx args=?fxs
@lp.qy core.calc out=?qy fn=div args=?ddy args=?fys
@lp.qx100 core.calc out=?qx1 fn=mul args=?qx args=100
@lp.qy100 core.calc out=?qy1 fn=mul args=?qy args=100
@lp.nfx core.calc out=?nfx0 fn=add args=?fx args=?qx1
@lp.nfy core.calc out=?nfy0 fn=add args=?fy args=?qy1
@lp.cfx core.calc out=?nfx1 fn=clamp args=?nfx0 args=-50 args=50
@lp.cfy core.calc out=?nfy1 fn=clamp args=?nfy0 args=-50 args=50
@lp.rfx core.calc out=?nfx fn=round args=?nfx1
@lp.rfy core.calc out=?nfy fn=round args=?nfy1
@lp.x.o ui.face.edit face=$lp.face slot=?slot x=?nfx
@lp.y.o ui.face.edit face=$lp.face slot=?slot y=?nfy
@look.edit.place.x core.rule when=$lp.pl.req when=$lp.face when=$lp.lp when=$lp.m when=$lp.ext with=$lp.pid when=$lp.geo.x when=$lp.kind when=$lp.xy when=$lp.sc with=$lp.f with=$lp.fx with=$lp.ddx with=$lp.qx with=$lp.qx100 with=$lp.nfx with=$lp.cfx with=$lp.rfx then=$lp.x.o
@look.edit.place.y core.rule when=$lp.pl.req when=$lp.face when=$lp.lp when=$lp.m when=$lp.ext with=$lp.pid when=$lp.geo.y when=$lp.kind when=$lp.xy with=$lp.f with=$lp.fy with=$lp.ddy with=$lp.qy with=$lp.qy100 with=$lp.nfy with=$lp.cfy with=$lp.rfy then=$lp.y.o

# Add a part to an object by the word for it (drawing.part.add kind=: "a hat", "eyes", "a red t-shirt", "the chimney"):
# the slot a part name draws (k.parts.name slot), the slot and variant a wearable is shown with (k.wearables face or
# figure), a variant named by its kind (k.faces.variant kind: a cap) or a slot by its own name. It is added to the
# object's look of the style that has the slot (a part of that kind already there takes the new variant); a thing with
# no face yet that has a part bearing one (the sun's disc) is given a face for it. Without a variant: the variant the
# word names, else the first of the slot. A part of the drawing itself that was removed is put back.
@part.add.slot.type core.type of=ui.draw.addslot
@pd.req app.act.request operation="drawing.part.add" id=?id kind=?w
@pd.skip ui.draw.skipslot object=?id slot=?slot
@pd.name k.parts.name name=?w slot=?slot
@pd.slot.o ui.draw.addslot slot=?slot
@add.slot.name core.rule when=$pd.req when=$pd.name then=$pd.slot.o
@pd.alias core.word text=?w means=?n of=k.parts.name.name
@pd.alias.name k.parts.name name=?n slot=?slot
@add.slot.alias core.rule when=$pd.req when=$pd.alias when=$pd.alias.name then=$pd.slot.o
@pd.own w.face.slot slot=?w
@pd.own.o ui.draw.addslot slot=?w
@add.slot.own core.rule when=$pd.req when=$pd.own then=$pd.own.o
@pd.wf k.wearables.wearable name=?w face_slot=?slot face=?v
@pd.slotv.o ui.draw.addslot slot=?slot variant=?v
@add.slot.wear.face core.rule when=$pd.req when=$pd.wf then=$pd.slotv.o
