# The Drawing tab as a SOP area (read by worlds/sop-area.mjs). The instance is a w.drawing world with the w.face faces
# of what is drawn with a look (a person's face and figure, eyes put on the sun: k.faces styles plain and figure, drawn
# by the look projection and edited by the look rules, look-projection.sop and look-rules.sop; composed by
# person-rules.sop; the Avatar tab is a view of one such person); k.parts
# names the parts people name (k.parts.name) and which part bears a face; k.wearables what is worn where. How each kind
# is drawn is looked up in k.objects (and k.people for kinds drawn as their parent kind) when the instance or a
# command names it; k.scenes says where a kind usually is (new objects prefer a free slot there); k.colours turns
# colour names into RGB. Where a new object goes reads k.layouts too: the page is laid out as its landscape (looked
# up by that fixed value), and the anchors of the objects on the page say what they hold (the water of a lake).
@area.types core.type of=app.area
@area.rules.type core.type of=app.area.rules
@area.make.type core.type of=app.area.make
@area.command.type core.type of=app.area.command
@area.choice.type core.type of=app.area.choice
@area.constant.type core.type of=app.area.constant
@area.draw.type core.type of=app.area.draw
@area.offline.type core.type of=app.area.offline
@area.control.type core.type of=app.area.control
@area.field.type core.type of=app.area.field
@area.lookup.type core.type of=app.area.lookup

@drawing.area app.area world=art.draw instance=w.drawing instance=w.face knowledge=k.colours knowledge=k.faces knowledge=k.wearables knowledge=k.parts knowledge=k.styles knowledge=k.feelings scope="drawing.object-lifecycle" frame.w=1000 frame.h=700 spatial=true calls=instance
@area.subset.type core.type of=app.area.subset
@drawing.subset.faces app.area.subset area=$drawing.area world=k.faces prefix="plain-" prefix="figure-"
@drawing.subset.parts app.area.subset area=$drawing.area world=k.parts prefix="names" prefix="psys2" strict=true
@drawing.rules.looks app.area.rules area=$drawing.area file="look-projection.sop" n=0
@drawing.rules.1 app.area.rules area=$drawing.area file="render-projection.sop" n=1
@drawing.rules.2 app.area.rules area=$drawing.area file="act-rules.sop" n=2
@drawing.rules.lookedits app.area.rules area=$drawing.area file="look-rules.sop" n=7
@drawing.rules.people app.area.rules area=$drawing.area file="person-rules.sop" n=8
# The person as a controllable model: poses on the page, and the commands that pose, dress, give traits and expressions
# and put things in a hand (figure-rules.sop; knowledge in k.faces, k.feelings and k.wearables).
@drawing.rules.figure app.area.rules area=$drawing.area file="figure-rules.sop" n=11
# A thing touching an edge of the page or partly cut off by it (occlusion-rules.sop).
@drawing.rules.occlusion app.area.rules area=$drawing.area file="occlusion-rules.sop" n=12
# Poses, styles, writing and the filter of the whole picture (k.styles: effects, fills, typefaces, frames, filters, turns).
@drawing.rules.styles app.area.rules area=$drawing.area file="style-projection.sop" n=9
@drawing.rules.styleacts app.area.rules area=$drawing.area file="style-rules.sop" n=10
# Terrain features drawn from their handles, what holds things up (worlds/art.draw/landscape-rules.sop), and the depth
# of the page: occlusion by depth, ground shadows, side faces and perspective (perspective-rules.sop).
@drawing.rules.5 app.area.rules area=$drawing.area file="landscape-rules.sop" n=5
@drawing.rules.6 app.area.rules area=$drawing.area file="perspective-rules.sop" n=6
@drawing.lookup.objects app.area.lookup area=$drawing.area world=k.objects from=w.drawing.object key=drawing arg=kind arg=name
@drawing.lookup.scenes app.area.lookup area=$drawing.area world=k.scenes from=w.drawing.object key=drawing arg=kind arg=name
@drawing.lookup.layouts app.area.lookup area=$drawing.area world=k.layouts from=w.drawing.object key=drawing arg=kind arg=name value=landscape
@drawing.lookup.people app.area.lookup area=$drawing.area world=k.people from=w.drawing.object key=drawing arg=kind arg=name
# What every thing of a place stands on and keeps out of (k.scenes.support of the places ground, water and sky).
@drawing.lookup.support app.area.lookup area=$drawing.area world=k.scenes value=ground value=water value=sky
# The outline a part is drawn with (w.drawing.part shape: irregular, star) is looked up in k.layouts by its name.
@drawing.lookup.outlines app.area.lookup area=$drawing.area world=k.layouts from=w.drawing.part key=shape arg=shape value=irregular
@drawing.choice.kinds app.area.choice area=$drawing.area input="drawing.kinds" type=ui.draw.kind key=drawing
@drawing.draw app.area.draw area=$drawing.area draw=ui.draw.draw fill=ui.draw.fill point=ui.draw.point orient=ui.draw.orient select=slot layer=ui.draw.layer pose=ui.draw.pose style=ui.draw.style filter=ui.draw.filter

@drawing.control.select app.area.control area=$drawing.area n=1 label="Selection" operation="drawing.object.select" param=id options=object
@drawing.control.move app.area.control area=$drawing.area n=2 label="Move" operation="drawing.object.place" target=selected list=ids when=present options=none
@drawing.field.move.x app.area.field control=$drawing.control.move n=1 param=x label="x" input=number
@drawing.field.move.y app.area.field control=$drawing.control.move n=2 param=y label="y" input=number
@drawing.control.remove app.area.control area=$drawing.area n=3 label="Delete" operation="drawing.object.remove" target=selected list=ids when=present
@drawing.control.clear app.area.control area=$drawing.area n=4 label="Clear drawing" operation="drawing.page.clear"
# A selected person: its pose, expression, a trait, a thing to wear (figure-rules.sop; the options are the knowledge's).
@drawing.control.pose app.area.control area=$drawing.area n=5 label="Pose" operation="drawing.person.pose" param=pose options=pose target=selected list=id when=present
@drawing.control.expression app.area.control area=$drawing.area n=6 label="Expression" operation="drawing.object.change" param=expression options=expression target=selected list=ids when=present
@drawing.control.trait app.area.control area=$drawing.area n=7 label="Trait" operation="drawing.object.change" param=trait options=trait target=selected list=ids when=present
@drawing.control.garment app.area.control area=$drawing.area n=8 label="Wear" operation="drawing.part.add" param=kind options=garment target=selected list=id when=present
