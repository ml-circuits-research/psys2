@fgh.new.o ui.draw.holdpose object=?id pose=?hp
@fgh.anykept ui.draw.holdkept object=?id
@hold.pose.default core.rule when=$fgh.req when=$fgh.face when=$fgh.frame when=$fgh.o when=$fgh.dk not=$fgh.anykept then=$fgh.new.o
@fgh.hp ui.draw.holdpose object=?id pose=?hp
@fgh.hpcall app.act.call act=change thing=$fgh.face attr=pose value=?hp order=1
@hold.pose.set core.rule when=$fgh.req when=$fgh.face when=$fgh.frame when=$fgh.o when=$fgh.hp then=$fgh.hpcall
@fgh.hk k.faces.pose name=?hp style=?bs hold_x=?hx hold_y=?hy
@fgh.m ui.draw.mount object=?id face=$fgh.face x=?mx y=?my size=?ms
@fgh.ext ui.draw.boxscale object=?id sx=?osx sy=?osy
@fgh.f core.calc out=?f fn=div args=?ms args=100
@fgh.hxf core.calc out=?hxf fn=mul args=?hx args=?f
@fgh.hyf core.calc out=?hyf fn=mul args=?hy args=?f
@fgh.dx core.calc out=?dx fn=add args=?mx args=?hxf
@fgh.dy core.calc out=?dy fn=add args=?my args=?hyf
@fgh.ux core.calc out=?ux fn=sub args=?dx args=50
@fgh.uy core.calc out=?uy fn=sub args=?dy args=50
@fgh.vx core.calc out=?vx fn=mul args=?ux args=?osx
@fgh.vy core.calc out=?vy fn=mul args=?uy args=?osy
@fgh.px core.calc out=?px fn=add args=?vx args=?X
@fgh.py core.calc out=?py fn=add args=?vy args=?Y
@fgh.s core.calc out=?hs fn=mul args=?S args=0.34
@fgh.at.type core.type of=ui.draw.holdat
@fgh.at.o ui.draw.holdat object=?id x=?px y=?py size=?hs
@hold.at core.rule when=$fgh.req when=$fgh.face when=$fgh.frame when=$fgh.o when=$fgh.hp when=$fgh.hk when=$fgh.m when=$fgh.ext with=$fgh.f with=$fgh.hxf with=$fgh.hyf with=$fgh.dx with=$fgh.dy with=$fgh.ux with=$fgh.uy with=$fgh.vx with=$fgh.vy with=$fgh.px with=$fgh.py with=$fgh.s then=$fgh.at.o
