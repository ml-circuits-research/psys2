# art.draw as a matrix: the scene is wires, what is in the picture is derived by rules and aggregates, and what cannot be is refused with the reason.
#
# The drawing engine (ops.mjs and scene.mjs: the vocabulary, noun phrases, placement, geometry, the shapes and their parts, the pictures) is unchanged and keeps
# working on the session state; the library takes the state over after every operation (fns.mjs, `adopt`; `toState` is the way back): one art.draw.object per thing
# on the canvas (kind, effective colour, place, size, and `obj`, the exact object with its parts, so the state is derived without loss), art.draw.sel (the selected
# thing), art.draw.last (what the last command made or changed: "it", "them") and art.draw.scene (paper, sky, ground, mood, the counter of ids, the words of the
# last step for "undo", and the bookkeeping of the operations). Undo and redo are the session timeline's. Nothing here is a list of points: the shapes' geometry is
# computed from `size` and `kind` by scene.mjs each time the tab draws.

@ad.seq core.sequence key=core.seq

# ---- the state as wires
@ad.k.o.oid core.slot of=art.draw.object key=oid kind=string required=true
@ad.k.o.ord core.slot of=art.draw.object key=ord kind=integer required=true
@ad.k.o.kind core.slot of=art.draw.object key=kind kind=atom enum=circle enum=oval enum=square enum=rectangle enum=triangle enum=star enum=heart enum=line enum=arrow enum=house enum=tree enum=sun enum=cloud enum=car enum=flower enum=cat enum=dog enum=fish enum=bird enum=boat enum=mountain enum=rainbow enum=person enum=balloon enum=rocket enum=moon required=true
@ad.k.o.color core.slot of=art.draw.object key=color kind=string required=true
@ad.k.o.x core.slot of=art.draw.object key=x kind=number
@ad.k.o.y core.slot of=art.draw.object key=y kind=number
@ad.k.o.size core.slot of=art.draw.object key=size kind=number
@ad.k.o.rot core.slot of=art.draw.object key=rotation kind=number
@ad.k.o.z core.slot of=art.draw.object key=z kind=number
@ad.k.o.fill core.slot of=art.draw.object key=fill kind=atom enum=crayon enum=solid enum=outline
@ad.k.o.tag core.slot of=art.draw.object key=tag kind=atom
@ad.k.o.flip core.slot of=art.draw.object key=flip kind=boolean
@ad.k.o.obj core.slot of=art.draw.object key=obj kind=string required=true
@ad.k.s.oid core.slot of=art.draw.sel key=oid kind=string required=true
@ad.k.l.oid core.slot of=art.draw.last key=oid kind=string required=true
@ad.k.l.i core.slot of=art.draw.last key=i kind=integer required=true
@ad.k.sc.bg core.slot of=art.draw.scene key=background kind=string required=true
@ad.k.sc.sky core.slot of=art.draw.scene key=sky kind=string
@ad.k.sc.ground core.slot of=art.draw.scene key=ground kind=atom enum=grass enum=sand enum=snow enum=sea
@ad.k.sc.gc core.slot of=art.draw.scene key=gcolor kind=string
@ad.k.sc.mood core.slot of=art.draw.scene key=mood kind=atom enum=night enum=day enum=sunset
@ad.k.sc.next core.slot of=art.draw.scene key=nextid kind=integer required=true
@ad.k.sc.label core.slot of=art.draw.scene key=label kind=string
@ad.k.sc.rest core.slot of=art.draw.scene key=rest kind=string required=true

# ---- what cannot be: two things with one id, a thing of no size, a selection or a "it" that is not on the canvas, a counter that would give an id twice
@ad.o1 art.draw.object oid=?i
@ad.o2 art.draw.object oid=?i
@ad.t.diff core.check fn=neq args=$ad.o1 args=$ad.o2
@ad.d.twice core.deny when=$ad.o1 when=$ad.o2 if=$ad.t.diff why="Two things in the picture have the same name, ?i."
@ad.o3 art.draw.object size=?sz kind=?k
@ad.t.size core.check fn=lt args=?sz args=1
@ad.d.size core.deny when=$ad.o3 if=$ad.t.size why="A ?k cannot have a size of ?sz."
@ad.sl art.draw.sel oid=?i
@ad.on art.draw.object oid=?i
@ad.d.sel core.deny when=$ad.sl not=$ad.on why="The selected thing ?i is not in the picture."
@ad.ls art.draw.last oid=?i
@ad.d.last core.deny when=$ad.ls not=$ad.on why="?i, the thing the last command touched, is not in the picture."

# ---- what is in the picture: the number of things and of a kind (the count of a colour is a filter over the object wires: see fns.mjs) (the kinds as static facts, so that an empty kind still has its 0)
@ad.k.tt.n core.slot of=art.draw.total key=n kind=integer
@ad.k.t.kind core.slot of=art.draw.tally key=kind kind=atom
@ad.k.t.n core.slot of=art.draw.tally key=n kind=integer
@ad.k.kf.kind core.slot of=art.draw.kindfact key=kind kind=atom
@ad.sc art.draw.scene
@ad.oo art.draw.object
@ad.c.all core.calc out=?na fn=count over=$ad.oo
@ad.tt art.draw.total n=?na
@ad.r.tt core.rule when=$ad.sc with=$ad.c.all then=$ad.tt
# one count per kind, anchored on the kind (a static fact below), not on a thing of the kind: an anchor per thing would count the whole group once for each of its members
@ad.kf art.draw.kindfact kind=?k
@ad.ok art.draw.object kind=?k
@ad.c.k core.calc out=?nk fn=count over=$ad.ok
@ad.tk art.draw.tally kind=?k n=?nk
@ad.r.tk core.rule when=$ad.kf with=$ad.c.k then=$ad.tk
@ad.kind.circle art.draw.kindfact kind=circle
@ad.kind.oval art.draw.kindfact kind=oval
@ad.kind.square art.draw.kindfact kind=square
@ad.kind.rectangle art.draw.kindfact kind=rectangle
@ad.kind.triangle art.draw.kindfact kind=triangle
@ad.kind.star art.draw.kindfact kind=star
@ad.kind.heart art.draw.kindfact kind=heart
@ad.kind.line art.draw.kindfact kind=line
@ad.kind.arrow art.draw.kindfact kind=arrow
@ad.kind.house art.draw.kindfact kind=house
@ad.kind.tree art.draw.kindfact kind=tree
@ad.kind.sun art.draw.kindfact kind=sun
@ad.kind.cloud art.draw.kindfact kind=cloud
@ad.kind.car art.draw.kindfact kind=car
@ad.kind.flower art.draw.kindfact kind=flower
@ad.kind.cat art.draw.kindfact kind=cat
@ad.kind.dog art.draw.kindfact kind=dog
@ad.kind.fish art.draw.kindfact kind=fish
@ad.kind.bird art.draw.kindfact kind=bird
@ad.kind.boat art.draw.kindfact kind=boat
@ad.kind.mountain art.draw.kindfact kind=mountain
@ad.kind.rainbow art.draw.kindfact kind=rainbow
@ad.kind.person art.draw.kindfact kind=person
@ad.kind.balloon art.draw.kindfact kind=balloon
@ad.kind.rocket art.draw.kindfact kind=rocket
@ad.kind.moon art.draw.kindfact kind=moon

# ---- a request about a thing that is not there (asked by `guard` in fns.mjs, a dry run: the wire is never kept)
@ad.k.w.kind core.slot of=art.draw.want key=kind kind=atom required=true
@ad.k.w.label core.slot of=art.draw.want key=label kind=string required=true
@ad.w art.draw.want kind=?k label=?l
@ad.wk art.draw.object kind=?k
@ad.d.nokind core.deny when=$ad.w not=$ad.wk why="I can not find ?l in your picture."
@ad.d.empty core.deny when=$ad.w not=$ad.oo why="I can not find ?l in your picture. Your picture is empty. Try \"draw a red house\"."

# ---- the questions about the picture the library answers (fns.mjs says them in the words of ops.mjs)
@ad.a.count core.action name=draw.count fn=drCount
@ad.a.exists core.action name=draw.exists fn=drExists
