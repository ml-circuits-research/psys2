# Occlusion by the page's edge (authored): a thing drawn touching an edge of the page or partly off it ("touching the
# right edge", "half cut off by the edge", "two paws off the left edge"). edge= names the side (left, right, top,
# bottom); cut= the share of the thing beyond it (0: it touches the edge; 0.5: half of it is cut off), 0 when not
# given. The thing keeps its size; its centre is put that far from the edge (its size times one half less the cut), on
# make (overriding the place chosen) and on change. The page clips what lies beyond it.
@ocx.req.type core.type of=ui.draw.edgecut
@ocx.cut.given app.act.request cut=?c
@ocx.cut.any app.act.request cut=?anyc
@ocx.edge app.act.request edge=?e
@ocx.cut.o ui.draw.edgecut edge=?e cut=?c
@ocx.off app.act.request offset=?anyoff
@ocx.grade app.act.request grade=?anygr
@edge.cut.given core.rule when=$ocx.edge when=$ocx.cut.given not=$ocx.off not=$ocx.grade then=$ocx.cut.o
@ocx.cut.zero ui.draw.edgecut edge=?e cut=0
@edge.cut.none core.rule when=$ocx.edge not=$ocx.cut.any not=$ocx.off not=$ocx.grade then=$ocx.cut.zero
@ocx.page ui.draw.page w=?pw h=?ph
@ocx.half core.calc out=?k fn=sub args=0.5 args=?c
@ocx.make app.act.request operation="drawing.object.make"
@ocx.cat app.act.request operation="drawing.catalog.make"
@ocx.t ui.draw.target size=?s
@ocx.d core.calc out=?d fn=mul args=?s args=?k
@ocx.far.x core.calc out=?fx fn=sub args=?pw args=?d
@ocx.far.y core.calc out=?fy fn=sub args=?ph args=?d
@ocx.left ui.draw.edgecut edge=left cut=?c
@ocx.right ui.draw.edgecut edge=right cut=?c
@ocx.top ui.draw.edgecut edge=top cut=?c
@ocx.bottom ui.draw.edgecut edge=bottom cut=?c
@ocx.ax.near app.act.arg call=new.object attr=x value=?d
@ocx.ax.far app.act.arg call=new.object attr=x value=?fx
@ocx.ay.near app.act.arg call=new.object attr=y value=?d
@ocx.ay.far app.act.arg call=new.object attr=y value=?fy
@make.edge.left core.rule when=$ocx.make when=$ocx.left when=$ocx.t with=$ocx.half with=$ocx.d then=$ocx.ax.near
@make.edge.right core.rule when=$ocx.make when=$ocx.right when=$ocx.t when=$ocx.page with=$ocx.half with=$ocx.d with=$ocx.far.x then=$ocx.ax.far
@make.edge.top core.rule when=$ocx.make when=$ocx.top when=$ocx.t with=$ocx.half with=$ocx.d then=$ocx.ay.near
@make.edge.bottom core.rule when=$ocx.make when=$ocx.bottom when=$ocx.t when=$ocx.page with=$ocx.half with=$ocx.d with=$ocx.far.y then=$ocx.ay.far
@make.catalog.edge.left core.rule when=$ocx.cat when=$ocx.left when=$ocx.t with=$ocx.half with=$ocx.d then=$ocx.ax.near
@make.catalog.edge.right core.rule when=$ocx.cat when=$ocx.right when=$ocx.t when=$ocx.page with=$ocx.half with=$ocx.d with=$ocx.far.x then=$ocx.ax.far
@make.catalog.edge.top core.rule when=$ocx.cat when=$ocx.top when=$ocx.t with=$ocx.half with=$ocx.d then=$ocx.ay.near
@make.catalog.edge.bottom core.rule when=$ocx.cat when=$ocx.bottom when=$ocx.t when=$ocx.page with=$ocx.half with=$ocx.d with=$ocx.far.y then=$ocx.ay.far
# A change moves each listed thing to the edge, keeping its size.
@ocx.chg app.act.request operation="drawing.object.change"
@ocx.item app.act.item param="ids" value=?id
@ocx.o w.drawing.object code=?id size=?s
@ocx.cx.near app.act.call act=change thing=$ocx.o attr=x value=?d order=1
@ocx.cx.far app.act.call act=change thing=$ocx.o attr=x value=?fx order=1
@ocx.cy.near app.act.call act=change thing=$ocx.o attr=y value=?d order=2
@ocx.cy.far app.act.call act=change thing=$ocx.o attr=y value=?fy order=2
@change.edge.left core.rule when=$ocx.chg when=$ocx.item when=$ocx.o when=$ocx.left with=$ocx.half with=$ocx.d then=$ocx.cx.near
@change.edge.right core.rule when=$ocx.chg when=$ocx.item when=$ocx.o when=$ocx.right when=$ocx.page with=$ocx.half with=$ocx.d with=$ocx.far.x then=$ocx.cx.far
@change.edge.top core.rule when=$ocx.chg when=$ocx.item when=$ocx.o when=$ocx.top with=$ocx.half with=$ocx.d then=$ocx.cy.near
@change.edge.bottom core.rule when=$ocx.chg when=$ocx.item when=$ocx.o when=$ocx.bottom when=$ocx.page with=$ocx.half with=$ocx.d with=$ocx.far.y then=$ocx.cy.far

# --- Behind another thing -------------------------------------------------------------------------------------------
# A thing partly hidden behind another (behind=: the code of the one in front; "half hidden behind the tree", "peeking
# out from behind the house"): hidden= the share of it covered (0.5 when not given), side= where it peeks out (right,
# left or top; right when not given). What covers it is a drawn part of the one in front, not its box: at a side, the
# widest of its parts that reach its foot (a tree's trunk, a house's walls), the thing standing on the same ground; at
# the top, its topmost part (a tree's crown), the thing rising above it. The thing overlaps that part by the hidden
# share of its size and is drawn under the one in front (it takes that one's layer and the one in front goes to the top
# layer; on change their layers swap): the part covers what overlaps. No other object changes.
@ocb.type core.type of=ui.draw.behindcut
@ocb.cand.type core.type of=ui.draw.coverpart
@ocb.cover.type core.type of=ui.draw.cover
@ocb.req app.act.request behind=?oc
@ocb.h.req app.act.request hidden=?h
@ocb.h.any app.act.request hidden=?anyh
@ocb.s.req app.act.request side=?sd
@ocb.s.any app.act.request side=?anysd
@ocb.o1 ui.draw.behindcut front=?oc hidden=?h side=?sd
@behind.given core.rule when=$ocb.req when=$ocb.h.req when=$ocb.s.req then=$ocb.o1
@ocb.o2 ui.draw.behindcut front=?oc hidden=0.5 side=?sd
@behind.side core.rule when=$ocb.req not=$ocb.h.any when=$ocb.s.req then=$ocb.o2
@ocb.o3 ui.draw.behindcut front=?oc hidden=?h side=right
@behind.hidden core.rule when=$ocb.req when=$ocb.h.req not=$ocb.s.any then=$ocb.o3
@ocb.o4 ui.draw.behindcut front=?oc hidden=0.5 side=right
@behind.default core.rule when=$ocb.req not=$ocb.h.any not=$ocb.s.any then=$ocb.o4
# The parts that may cover: those reaching the foot of the drawing (their bottom in its lowest quarter), and the widest
# of them; the topmost part.
@ocb.fd w.drawing.object code=?oc drawing=?od
@ocb.kp k.objects.part of=?od y=?py h=?ph w=?pw
@ocb.bot core.calc out=?pb fn=add args=?py args=?ph
@ocb.low core.check fn=gt args=?pb args=75
@ocb.cand.o ui.draw.coverpart object=?oc side=ground source=$ocb.kp w=?pw
@cover.ground.candidate core.rule when=$ocb.req when=$ocb.fd when=$ocb.kp with=$ocb.bot if=$ocb.low then=$ocb.cand.o
@ocb.cand ui.draw.coverpart object=?oc side=ground source=?src w=?pw
@ocb.widest core.aggregate over=$ocb.cand by=?oc argmax=?best args=?pw pick=?src ties=first then=$ocb.wide.o
@ocb.wide.o ui.draw.cover object=?oc side=ground source=?best
@ocb.tkp k.objects.part of=?od y=?ty0
@ocb.tcand.o ui.draw.coverpart object=?oc side=top source=$ocb.tkp y=?ty0
@cover.top.candidate core.rule when=$ocb.req when=$ocb.fd when=$ocb.tkp then=$ocb.tcand.o
@ocb.tcand ui.draw.coverpart object=?oc side=top source=?src y=?ty0
@ocb.topmost core.aggregate over=$ocb.tcand by=?oc argmin=?best args=?ty0 pick=?src ties=first then=$ocb.top.o
@ocb.top.o ui.draw.cover object=?oc side=top source=?best
# The covering part on the page: its left, right, top and bottom.
@ocb.f w.drawing.object code=?oc x=?fx y=?fy z=?fz
@ocb.fe ui.draw.boxscale object=?oc sx=?fsx sy=?fsy
@ocb.cp k.objects.part x=?cx y=?cy w=?cw h=?ch
@ocb.cg ui.draw.cover object=?oc side=ground source=$ocb.cp
@ocb.ct ui.draw.cover object=?oc side=top source=$ocb.cp
@ocb.l0 core.calc out=?l0 fn=sub args=?cx args=50
@ocb.l1 core.calc out=?l1 fn=mul args=?l0 args=?fsx
@ocb.pl core.calc out=?pl fn=add args=?fx args=?l1
@ocb.r0 core.calc out=?r0 fn=add args=?cx args=?cw
@ocb.r1 core.calc out=?r1 fn=sub args=?r0 args=50
@ocb.r2 core.calc out=?r2 fn=mul args=?r1 args=?fsx
@ocb.pr core.calc out=?pr fn=add args=?fx args=?r2
@ocb.t0 core.calc out=?t0 fn=sub args=?cy args=50
@ocb.t1 core.calc out=?t1 fn=mul args=?t0 args=?fsy
@ocb.pt core.calc out=?pt fn=add args=?fy args=?t1
@ocb.b0 core.calc out=?b0 fn=add args=?cy args=?ch
@ocb.b1 core.calc out=?b1 fn=sub args=?b0 args=50
@ocb.b2 core.calc out=?b2 fn=mul args=?b1 args=?fsy
@ocb.pbt core.calc out=?pbt fn=add args=?fy args=?b2
@ocb.pm0 core.calc out=?pm0 fn=add args=?pl args=?pr
@ocb.pm core.calc out=?pm fn=div args=?pm0 args=2
@ocb.area.type core.type of=ui.draw.coverbox
@ocb.area.o ui.draw.coverbox object=?oc side=ground left=?pl right=?pr top=?pt bottom=?pbt middle=?pm
@cover.ground.box core.rule when=$ocb.f when=$ocb.fe when=$ocb.cp when=$ocb.cg with=$ocb.l0 with=$ocb.l1 with=$ocb.pl with=$ocb.r0 with=$ocb.r1 with=$ocb.r2 with=$ocb.pr with=$ocb.t0 with=$ocb.t1 with=$ocb.pt with=$ocb.b0 with=$ocb.b1 with=$ocb.b2 with=$ocb.pbt with=$ocb.pm0 with=$ocb.pm then=$ocb.area.o
@ocb.tarea.o ui.draw.coverbox object=?oc side=top left=?pl right=?pr top=?pt bottom=?pbt middle=?pm
@cover.top.box core.rule when=$ocb.f when=$ocb.fe when=$ocb.cp when=$ocb.ct with=$ocb.l0 with=$ocb.l1 with=$ocb.pl with=$ocb.r0 with=$ocb.r1 with=$ocb.r2 with=$ocb.pr with=$ocb.t0 with=$ocb.t1 with=$ocb.pt with=$ocb.b0 with=$ocb.b1 with=$ocb.b2 with=$ocb.pbt with=$ocb.pm0 with=$ocb.pm then=$ocb.tarea.o
# Where the thing goes (size s): at a side, overlapping the covering part by the hidden share and standing on its foot;
# at the top, centred over it and overlapping its top by the hidden share.
@ocb.gb ui.draw.coverbox object=?oc side=ground left=?pl right=?pr bottom=?pbt
@ocb.tb ui.draw.coverbox object=?oc side=top top=?pt middle=?pm
@ocb.right ui.draw.behindcut front=?oc hidden=?h side=right
@ocb.left ui.draw.behindcut front=?oc hidden=?h side=left
@ocb.top ui.draw.behindcut front=?oc hidden=?h side=top
@ocb.bc ui.draw.behindcut front=?oc hidden=?h side=?sd
@ocb.s2 core.calc out=?s2 fn=div args=?s args=2
@ocb.hs core.calc out=?hs fn=mul args=?h args=?s
@ocb.rx0 core.calc out=?rx0 fn=add args=?pr args=?s2
@ocb.rx core.calc out=?rx fn=sub args=?rx0 args=?hs
@ocb.lx0 core.calc out=?lx0 fn=sub args=?pl args=?s2
@ocb.lx core.calc out=?lx fn=add args=?lx0 args=?hs
@ocb.by core.calc out=?by fn=sub args=?pbt args=?s2
@ocb.ty0 core.calc out=?ty0 fn=sub args=?pt args=?s2
@ocb.ty core.calc out=?ty fn=add args=?ty0 args=?hs
@ocb.next ui.draw.next top=?top
@ocb.nz core.calc out=?nz fn=add args=?top args=1
@ocb.mk.x.r app.act.arg call=new.object attr=x value=?rx
@ocb.mk.x.l app.act.arg call=new.object attr=x value=?lx
@ocb.mk.x.t app.act.arg call=new.object attr=x value=?pm
@ocb.mk.y.g app.act.arg call=new.object attr=y value=?by
@ocb.mk.y.t app.act.arg call=new.object attr=y value=?ty
@ocb.mk.z app.act.arg call=new.object attr=z value=?fz
@ocb.mk.front app.act.call act=change thing=$ocb.f attr=z value=?nz order=3
@ocb.mk ui.draw.target size=?s
@ocb.anymake app.act.request operation="drawing.object.make"
@ocb.anycat app.act.request operation="drawing.catalog.make"
@ocb.making.type core.type of=ui.draw.makingbehind
@ocb.making ui.draw.makingbehind
@make.behind.flag core.rule when=$ocb.anymake when=$ocb.req then=$ocb.making
@make.behind.flag.catalog core.rule when=$ocb.anycat when=$ocb.req then=$ocb.making
@make.behind.right.x core.rule when=$ocb.making when=$ocb.right when=$ocb.gb when=$ocb.mk with=$ocb.s2 with=$ocb.hs with=$ocb.rx0 with=$ocb.rx then=$ocb.mk.x.r
@make.behind.left.x core.rule when=$ocb.making when=$ocb.left when=$ocb.gb when=$ocb.mk with=$ocb.s2 with=$ocb.hs with=$ocb.lx0 with=$ocb.lx then=$ocb.mk.x.l
@make.behind.right.y core.rule when=$ocb.making when=$ocb.right when=$ocb.gb when=$ocb.mk with=$ocb.s2 with=$ocb.by then=$ocb.mk.y.g
@make.behind.left.y core.rule when=$ocb.making when=$ocb.left when=$ocb.gb when=$ocb.mk with=$ocb.s2 with=$ocb.by then=$ocb.mk.y.g
@make.behind.top.x core.rule when=$ocb.making when=$ocb.top when=$ocb.tb then=$ocb.mk.x.t
@make.behind.top.y core.rule when=$ocb.making when=$ocb.top when=$ocb.tb when=$ocb.mk with=$ocb.s2 with=$ocb.hs with=$ocb.ty0 with=$ocb.ty then=$ocb.mk.y.t
@make.behind.layer core.rule when=$ocb.making when=$ocb.bc when=$ocb.f then=$ocb.mk.z
@make.behind.front core.rule when=$ocb.making when=$ocb.bc when=$ocb.f when=$ocb.next with=$ocb.nz then=$ocb.mk.front
@ocb.chg app.act.request operation="drawing.object.change"
@ocb.item app.act.item param="ids" value=?id
@ocb.t w.drawing.object code=?id size=?s z=?tz
@ocb.c.x.r app.act.call act=change thing=$ocb.t attr=x value=?rx order=1
@ocb.c.x.l app.act.call act=change thing=$ocb.t attr=x value=?lx order=1
@ocb.c.x.t app.act.call act=change thing=$ocb.t attr=x value=?pm order=1
@ocb.c.y.g app.act.call act=change thing=$ocb.t attr=y value=?by order=2
@ocb.c.y.t app.act.call act=change thing=$ocb.t attr=y value=?ty order=2
@change.behind.right.x core.rule when=$ocb.chg when=$ocb.item when=$ocb.t when=$ocb.right when=$ocb.gb with=$ocb.s2 with=$ocb.hs with=$ocb.rx0 with=$ocb.rx then=$ocb.c.x.r
@change.behind.left.x core.rule when=$ocb.chg when=$ocb.item when=$ocb.t when=$ocb.left when=$ocb.gb with=$ocb.s2 with=$ocb.hs with=$ocb.lx0 with=$ocb.lx then=$ocb.c.x.l
@change.behind.right.y core.rule when=$ocb.chg when=$ocb.item when=$ocb.t when=$ocb.right when=$ocb.gb with=$ocb.s2 with=$ocb.by then=$ocb.c.y.g
@change.behind.left.y core.rule when=$ocb.chg when=$ocb.item when=$ocb.t when=$ocb.left when=$ocb.gb with=$ocb.s2 with=$ocb.by then=$ocb.c.y.g
@change.behind.top.x core.rule when=$ocb.chg when=$ocb.item when=$ocb.t when=$ocb.top when=$ocb.tb then=$ocb.c.x.t
@change.behind.top.y core.rule when=$ocb.chg when=$ocb.item when=$ocb.t when=$ocb.top when=$ocb.tb with=$ocb.s2 with=$ocb.hs with=$ocb.ty0 with=$ocb.ty then=$ocb.c.y.t
@ocb.above core.check fn=gt args=?tz args=?fz
@ocb.c.z.t app.act.call act=change thing=$ocb.t attr=z value=?fz order=3
@ocb.c.z.f app.act.call act=change thing=$ocb.f attr=z value=?tz order=4
@change.behind.layer core.rule when=$ocb.chg when=$ocb.item when=$ocb.t when=$ocb.bc when=$ocb.f if=$ocb.above then=$ocb.c.z.t
@change.behind.layer.front core.rule when=$ocb.chg when=$ocb.item when=$ocb.t when=$ocb.bc when=$ocb.f if=$ocb.above then=$ocb.c.z.f
@ocb.none app.act.refuse reason=occluder-not-on-page
@ocb.anyf w.drawing.object code=?oc
@behind.unknown core.rule when=$ocb.req not=$ocb.anyf then=$ocb.none
@ocb.noparts app.act.refuse reason=occluder-has-no-covering-part
@ocb.anycover ui.draw.coverbox object=?oc
@behind.nocover core.rule when=$ocb.req when=$ocb.anyf not=$ocb.anycover then=$ocb.noparts

# --- Measured offsets -----------------------------------------------------------------------------------------------
# A distance a command measures (offset= a number, unit= a k.units length or one of its words: "two hand-widths",
# "an inch", "a finger-width"; a grade word with no number: "a bit", "a little", "far") in page units: the picture
# scale below (the page is about 25 inches wide, as a picture on a screen) times the unit's length in metres; a grade is
# a declared share of the page width. With edge= it is the gap between the thing and that edge of the page ("two
# hand-widths from the left edge"); with near= (the code of a thing on the page) and side= (left, right, above, below)
# the gap between the two ("2 inches above the house", "a bit to the left of the tree").
@ocm.scale.type core.type of=ui.draw.scale
@ocm.grade.type core.type of=ui.draw.distancegrade
@ocm.gap.type core.type of=ui.draw.measuredgap
@ocm.scale ui.draw.scale metre=1575
@ocm.g.bit ui.draw.distancegrade grade="a bit" share=0.03
@ocm.g.little ui.draw.distancegrade grade="a little" share=0.03
@ocm.g.slightly ui.draw.distancegrade grade=slightly share=0.03
@ocm.g.close ui.draw.distancegrade grade=close share=0.01
@ocm.g.some ui.draw.distancegrade grade="some way" share=0.1
@ocm.g.far ui.draw.distancegrade grade=far share=0.25
@ocm.g.veryfar ui.draw.distancegrade grade="far away" share=0.35
@ocm.n.req app.act.request offset=?n
@ocm.u.req app.act.request unit=?u
@ocm.u.any app.act.request unit=?anyu
@ocm.sc ui.draw.scale metre=?pm
@ocm.u.own k.units.unit name=?u quantity=length factor=?f
@ocm.u.word core.word text=?u means=?un of=k.units.unit.name
@ocm.u.wk k.units.unit name=?un quantity=length factor=?f
@ocm.d1 core.calc out=?d1 fn=mul args=?n args=?f
@ocm.d core.calc out=?d fn=mul args=?d1 args=?pm
@ocm.gap.o ui.draw.measuredgap d=?d
@offset.unit.own core.rule when=$ocm.n.req when=$ocm.u.req when=$ocm.u.own when=$ocm.sc with=$ocm.d1 with=$ocm.d then=$ocm.gap.o
@offset.unit.word core.rule when=$ocm.n.req when=$ocm.u.req not=$ocm.u.own when=$ocm.u.word when=$ocm.u.wk when=$ocm.sc with=$ocm.d1 with=$ocm.d then=$ocm.gap.o
@ocm.pg.o ui.draw.measuredgap d=?n
@offset.page.units core.rule when=$ocm.n.req not=$ocm.u.any then=$ocm.pg.o
@ocm.gr.req app.act.request grade=?g
@ocm.gr.k ui.draw.distancegrade grade=?g share=?sh
@ocm.page ui.draw.page w=?pw
@ocm.gd core.calc out=?gd fn=mul args=?pw args=?sh
@ocm.gr.o ui.draw.measuredgap d=?gd
@offset.grade core.rule when=$ocm.gr.req when=$ocm.gr.k when=$ocm.page with=$ocm.gd then=$ocm.gr.o
@ocm.u.none app.act.refuse reason=unit-not-known
@ocm.u.anyown k.units.unit name=?u quantity=length
@ocm.u.anyword core.word text=?u of=k.units.unit.name
@offset.unit.unknown core.rule when=$ocm.u.req not=$ocm.u.anyown not=$ocm.u.anyword then=$ocm.u.none
@ocm.gr.none app.act.refuse reason=distance-grade-not-known
@ocm.gr.anyk ui.draw.distancegrade grade=?g
@offset.grade.unknown core.rule when=$ocm.gr.req not=$ocm.gr.anyk then=$ocm.gr.none
# From an edge of the page: the thing's centre is half its size more than the gap from that edge (inside the page).
@ocm.gap ui.draw.measuredgap d=?d
@ocm.s2 core.calc out=?s2 fn=div args=?s args=2
@ocm.near.e core.calc out=?ne fn=add args=?d args=?s2
@ocm.pgh ui.draw.page w=?pw h=?ph
@ocm.fx core.calc out=?fe fn=sub args=?pw args=?ne
@ocm.fy core.calc out=?fe2 fn=sub args=?ph args=?ne
@ocm.el app.act.request edge=left
@ocm.er app.act.request edge=right
@ocm.et app.act.request edge=top
@ocm.eb app.act.request edge=bottom
@ocm.mk.xn app.act.arg call=new.object attr=x value=?ne
@ocm.mk.xf app.act.arg call=new.object attr=x value=?fe
@ocm.mk.yn app.act.arg call=new.object attr=y value=?ne
@ocm.mk.yf app.act.arg call=new.object attr=y value=?fe2
@ocm.t ui.draw.target size=?s
@ocm.making.type core.type of=ui.draw.makingmeasured
@ocm.making ui.draw.makingmeasured
@ocm.anymake app.act.request operation="drawing.object.make"
@ocm.anycat app.act.request operation="drawing.catalog.make"
@make.measured.flag core.rule when=$ocm.anymake when=$ocm.gap then=$ocm.making
@make.measured.flag.catalog core.rule when=$ocm.anycat when=$ocm.gap then=$ocm.making
@make.offset.edge.left core.rule when=$ocm.making when=$ocm.gap when=$ocm.el when=$ocm.t with=$ocm.s2 with=$ocm.near.e then=$ocm.mk.xn
@make.offset.edge.right core.rule when=$ocm.making when=$ocm.gap when=$ocm.er when=$ocm.t when=$ocm.pgh with=$ocm.s2 with=$ocm.near.e with=$ocm.fx then=$ocm.mk.xf
@make.offset.edge.top core.rule when=$ocm.making when=$ocm.gap when=$ocm.et when=$ocm.t with=$ocm.s2 with=$ocm.near.e then=$ocm.mk.yn
@make.offset.edge.bottom core.rule when=$ocm.making when=$ocm.gap when=$ocm.eb when=$ocm.t when=$ocm.pgh with=$ocm.s2 with=$ocm.near.e with=$ocm.fy then=$ocm.mk.yf
# From a thing on the page: beside it on the side asked, the gap between their boxes.
@ocm.near app.act.request near=?nc
@ocm.nf w.drawing.object code=?nc x=?nx y=?ny
@ocm.ne ui.draw.extent object=?nc w=?nw h=?nh
@ocm.nw2 core.calc out=?nw2 fn=div args=?nw args=2
@ocm.nh2 core.calc out=?nh2 fn=div args=?nh args=2
@ocm.dl0 core.calc out=?dl0 fn=add args=?nw2 args=?d
@ocm.dl core.calc out=?dl fn=add args=?dl0 args=?s2
@ocm.dv0 core.calc out=?dv0 fn=add args=?nh2 args=?d
@ocm.dv core.calc out=?dv fn=add args=?dv0 args=?s2
@ocm.xl core.calc out=?xl fn=sub args=?nx args=?dl
@ocm.xr core.calc out=?xr fn=add args=?nx args=?dl
@ocm.ya core.calc out=?ya fn=sub args=?ny args=?dv
@ocm.yb core.calc out=?yb fn=add args=?ny args=?dv
@ocm.sl app.act.request side=left
@ocm.sr app.act.request side=right
@ocm.sa app.act.request side=above
@ocm.sb app.act.request side=below
@ocm.a.xl app.act.arg call=new.object attr=x value=?xl
@ocm.a.xr app.act.arg call=new.object attr=x value=?xr
@ocm.a.xn app.act.arg call=new.object attr=x value=?nx
@ocm.a.ya app.act.arg call=new.object attr=y value=?ya
@ocm.a.yb app.act.arg call=new.object attr=y value=?yb
@ocm.a.yn app.act.arg call=new.object attr=y value=?ny
@make.offset.left.x core.rule when=$ocm.making when=$ocm.gap when=$ocm.near when=$ocm.sl when=$ocm.nf when=$ocm.ne when=$ocm.t with=$ocm.nw2 with=$ocm.s2 with=$ocm.dl0 with=$ocm.dl with=$ocm.xl then=$ocm.a.xl
@make.offset.left.y core.rule when=$ocm.making when=$ocm.gap when=$ocm.near when=$ocm.sl when=$ocm.nf then=$ocm.a.yn
@make.offset.right.x core.rule when=$ocm.making when=$ocm.gap when=$ocm.near when=$ocm.sr when=$ocm.nf when=$ocm.ne when=$ocm.t with=$ocm.nw2 with=$ocm.s2 with=$ocm.dl0 with=$ocm.dl with=$ocm.xr then=$ocm.a.xr
@make.offset.right.y core.rule when=$ocm.making when=$ocm.gap when=$ocm.near when=$ocm.sr when=$ocm.nf then=$ocm.a.yn
@make.offset.above.y core.rule when=$ocm.making when=$ocm.gap when=$ocm.near when=$ocm.sa when=$ocm.nf when=$ocm.ne when=$ocm.t with=$ocm.nh2 with=$ocm.s2 with=$ocm.dv0 with=$ocm.dv with=$ocm.ya then=$ocm.a.ya
@make.offset.above.x core.rule when=$ocm.making when=$ocm.gap when=$ocm.near when=$ocm.sa when=$ocm.nf then=$ocm.a.xn
@make.offset.below.y core.rule when=$ocm.making when=$ocm.gap when=$ocm.near when=$ocm.sb when=$ocm.nf when=$ocm.ne when=$ocm.t with=$ocm.nh2 with=$ocm.s2 with=$ocm.dv0 with=$ocm.dv with=$ocm.yb then=$ocm.a.yb
@make.offset.below.x core.rule when=$ocm.making when=$ocm.gap when=$ocm.near when=$ocm.sb when=$ocm.nf then=$ocm.a.xn
@ocm.chg app.act.request operation="drawing.object.change"
@ocm.item app.act.item param="ids" value=?id
@ocm.o w.drawing.object code=?id size=?s
@ocm.c.xn app.act.call act=change thing=$ocm.o attr=x value=?ne order=1
@ocm.c.xf app.act.call act=change thing=$ocm.o attr=x value=?fe order=1
@ocm.c.yn app.act.call act=change thing=$ocm.o attr=y value=?ne order=2
@ocm.c.yf app.act.call act=change thing=$ocm.o attr=y value=?fe2 order=2
@change.offset.edge.left core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.el with=$ocm.s2 with=$ocm.near.e then=$ocm.c.xn
@change.offset.edge.right core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.er when=$ocm.pgh with=$ocm.s2 with=$ocm.near.e with=$ocm.fx then=$ocm.c.xf
@change.offset.edge.top core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.et with=$ocm.s2 with=$ocm.near.e then=$ocm.c.yn
@change.offset.edge.bottom core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.eb when=$ocm.pgh with=$ocm.s2 with=$ocm.near.e with=$ocm.fy then=$ocm.c.yf
@ocm.c.xl app.act.call act=change thing=$ocm.o attr=x value=?xl order=1
@ocm.c.xr app.act.call act=change thing=$ocm.o attr=x value=?xr order=1
@ocm.c.xnn app.act.call act=change thing=$ocm.o attr=x value=?nx order=1
@ocm.c.ya app.act.call act=change thing=$ocm.o attr=y value=?ya order=2
@ocm.c.yb app.act.call act=change thing=$ocm.o attr=y value=?yb order=2
@ocm.c.ynn app.act.call act=change thing=$ocm.o attr=y value=?ny order=2
@change.offset.left.x core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.near when=$ocm.sl when=$ocm.nf when=$ocm.ne with=$ocm.nw2 with=$ocm.s2 with=$ocm.dl0 with=$ocm.dl with=$ocm.xl then=$ocm.c.xl
@change.offset.left.y core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.near when=$ocm.sl when=$ocm.nf then=$ocm.c.ynn
@change.offset.right.x core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.near when=$ocm.sr when=$ocm.nf when=$ocm.ne with=$ocm.nw2 with=$ocm.s2 with=$ocm.dl0 with=$ocm.dl with=$ocm.xr then=$ocm.c.xr
@change.offset.right.y core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.near when=$ocm.sr when=$ocm.nf then=$ocm.c.ynn
@change.offset.above.y core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.near when=$ocm.sa when=$ocm.nf when=$ocm.ne with=$ocm.nh2 with=$ocm.s2 with=$ocm.dv0 with=$ocm.dv with=$ocm.ya then=$ocm.c.ya
@change.offset.above.x core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.near when=$ocm.sa when=$ocm.nf then=$ocm.c.xnn
@change.offset.below.y core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.near when=$ocm.sb when=$ocm.nf when=$ocm.ne with=$ocm.nh2 with=$ocm.s2 with=$ocm.dv0 with=$ocm.dv with=$ocm.yb then=$ocm.c.yb
@change.offset.below.x core.rule when=$ocm.chg when=$ocm.item when=$ocm.o when=$ocm.gap when=$ocm.near when=$ocm.sb when=$ocm.nf then=$ocm.c.xnn
@ocm.nn app.act.refuse reason=offset-target-not-on-page
@ocm.anyn w.drawing.object code=?nc
@offset.near.unknown core.rule when=$ocm.near not=$ocm.anyn then=$ocm.nn
