    emit="@{_} core.request action=draw.save arg.f={f}"
    kind=request
    priority=14
    example="I want to save it as a png file."

@pat.art.draw.x.save.fmtfirst core.pattern
    match="[can_i_get|can_i_have|give_me|get_me|i_want|i_need|make|make_me]? [a|the]? {f:lex.art.draw.formats} [of|from|for|version_of|copy_of|file_of] [my|the|this|that]? [$art.draw.g8_art] [save|download|export|keep|get|grab]? [$lang.tail.filler|i_guess|ish|yes|ya|k]? [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.save arg.f={f}"
    kind=request
    priority=13
    example="PNG of my picture, save pls."

@pat.art.draw.x.remove.takeout core.pattern
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [$lang.lead.filler|right|also|hi|pls|plz]? [$art.draw.g1_can_you]? [take_out|clear_out|get_out] [the|my|that|this|those|these|all_the]? {t:lex.art.draw.targets} [$lang.tail.filler|i_guess|ish|yes|ya|k]? [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.remove arg.phrase=\"the {t}\""
    kind=request
    priority=12
    example="Take out the grass."

@pat.art.draw.x.add.gerund core.pattern
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [would_you_mind|do_you_mind|would_you_be_able_to|are_you_able_to|how_about|what_about|im_thinking_of|i_am_thinking_of|i_was_thinking_of|i_am_in_the_mood_for|time_for|lets_try|let_us_try|thinking_of|keep|try] [drawing|sketching|painting|adding|making|putting|creating|doodling|drawing_me|sketching_me|giving_me|getting_me|showing_me] [a|an|another|some|a_few|more|1_more|one|the]? {n:number?} {q:lex.art.draw.quantity?} [of]? {m1:lex.art.draw.mods?} {m2:lex.art.draw.mods?} {m3:lex.art.draw.mods?} {k:lex.art.draw.things} [$lang.tail.filler|i_guess|ish|yes|ya|k]? [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.add arg.n={n} arg.q={q} arg.m1={m1} arg.m2={m2} arg.m3={m3} arg.kind={k} arg.kt=\"{k}\""
    kind=request
    priority=12
    example="Would you mind drawing a heart?"

@pat.art.draw.x.add.verbs.clean core.pattern
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [$lang.lead.filler|right|also|hi|pls|plz]? [$art.draw.g1_can_you]? [$art.draw.g3_gimme] [$art.draw.g13_a_picture_of]? {n:number?} {q:lex.art.draw.quantity?} [of]? {m1:lex.art.draw.mods?} {m2:lex.art.draw.mods?} {m3:lex.art.draw.mods?} {k:lex.art.draw.things} [$lang.tail.filler|i_guess|ish|yes|ya|k]? [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.add arg.n={n} arg.q={q} arg.m1={m1} arg.m2={m2} arg.m3={m3} arg.kind={k} arg.kt=\"{k}\" "
    kind=request
    priority=12
    example="Gimme a blue cat."
    example="It needs a sun."

@pat.art.draw.bare core.pattern
    match="[pls|can_you|could_you|let_us]? [draw|sketch|paint] [pls]?"
    emit="@{_} core.request action=draw.askKind"
    kind=request
    priority=11
    example="Draw."
    doc="A drawing command without the thing to draw: asks what to draw and expects the answer as the next utterance (discourse pending, spec 11). Priority 11 keeps the chess draw offer on other tabs; on the drawing tab the tab bias selects this pattern."

@pat.art.draw.x2.bare.colored core.pattern
    match="[$lang.lead.filler|pls|plz]? [a|an|one|some|another]? {n:number?} {m1:lex.art.draw.mods} {m2:lex.art.draw.mods?} {k:lex.art.draw.things} [$lang.tail.filler|pls|plz|thanks]?"
    emit="@{_} core.request action=draw.add arg.n={n} arg.m1={m1} arg.m2={m2} arg.kind={k} arg.kt=\"{k}\""
    kind=request
    priority=9
    tabOnly=true
    example="A purple tree please."
    example="A big red house."

@pat.art.draw.x2.mood.look core.pattern
    match="[$lang.lead.filler|pls|plz]? [make|turn|let|have|set|change] [it|the_picture|the_scene|the_sky|everything|the_drawing|this] [to]? [look|seem|feel|be|become|turn|go|appear|get] [like|as|into]? {w:lex.art.draw.times} [time|now|outside|pls]?"
    emit="@{_} core.request action=draw.mood arg.w={w}"
    kind=request
    priority=12
    example="Make it look like night time."
    example="Turn it into evening."

@pat.art.draw.x2.clean.page core.pattern
    canonical="Give me a blank canvas."
    canonical="I want a clean page."
    match="[$lang.lead.filler|pls|plz]? [i_want|i_would_like|i_d_like|id_like|i_need|give_me|can_i_have|could_i_have|may_i_have|let_me_have|start_with|let_us_start_with|how_about] [a|an|the|my]? [clean|blank|empty|fresh|new|white|clear|clean_white|plain] [page|canvas|paper|sheet|picture|drawing|slate|board|screen]"
    emit="@{_} core.request action=draw.clearAll"
    kind=request
    priority=12
    example="I want a clean page."
    example="Give me a blank canvas."

@pat.art.draw.x2.bare.plain core.pattern
    match="[$lang.lead.filler|pls|plz]? [a|an|one|some|another] {n:number?} {m1:lex.art.draw.mods?} {k:lex.art.draw.things} [$lang.tail.filler|please|pls|plz|thanks]"
    emit="@{_} core.request action=draw.add arg.n={n} arg.m1={m1} arg.kind={k} arg.kt=\"{k}\""
    kind=request
    priority=9
    tabOnly=true
    example="A boat please."

@pat.art.draw.add.again core.pattern
    match="[$lang.lead.filler|pls|plz]? [a|an|another|one_more] {m1:lex.art.draw.relmods} {m2:lex.art.draw.mods?} {m3:lex.art.draw.mods?} {k:lex.art.draw.things} [pls|plz|thanks|thx]?"
    emit="@{_} core.request action=draw.add arg.m1={m1} arg.m2={m2} arg.m3={m3} arg.kind={k} arg.kt=\"{k}\" arg.where=\"\""
    kind=request
    priority=12
    tabOnly=true
    example="A bigger house."
    example="A smaller tree."
    doc="Ellipsis after a draw on the Drawing tab: a comparative or a mood before the thing repeats the draw (a bigger house, a happy girl). A bare noun alone is not read: a comma list (a sun, a cloud and a bird) must stay one command."

@pat.art.draw.add.person core.pattern
    match="[$lang.lead.filler|pls|plz]? [a|an|another|one_more] {m1:lex.art.draw.mods?} {m2:lex.art.draw.mods?} {k:lex.art.draw.people} [pls|plz|thanks|thx]?"
    emit="@{_} core.request action=draw.add arg.m1={m1} arg.m2={m2} arg.kind={k} arg.kt=\"{k}\" arg.where=\"\""
    kind=request
    priority=12
    tabOnly=true
    example="A man."
    example="Another happy girl."
    doc="Ellipsis after a draw on the Drawing tab for people (a man, a girl): repeats the draw with the person presets."

@pat.art.draw.color.my core.pattern
    canonical="What color is my house?"
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [$lang.lead.filler|right|also|hi|pls|plz]? [$art.draw.g1_can_you]? [what|whats|which] [color|colour] [is|are]? [my] {t:words(5)} [$art.draw.g17_painted]? [$lang.tail.filler|i_guess|ish|yes|ya|k]? [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.colorOf arg.t=\"{t}\""
    kind=request
    priority=13
    example="What color is my house?"

@pat.art.draw.color.in core.pattern
    match="what [color|colour] [is|are] [the]? {t:words(5)} [in|of|on] [my|the] [$art.draw.g15_picture] [$lang.tail.filler|i_guess|ish|yes|ya|k]? [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.colorOf arg.t=\"{t}\""
    kind=request
    priority=13
    example="What color is the sky in my picture?"

@pat.art.draw.color.of core.pattern
    canonical="What is the color of my car?"
    match="what is the [color|colour] of my {t:words(5)}"
    emit="@{_} core.request action=draw.colorOf arg.t=\"{t}\""
    kind=request
    priority=13
    example="What is the color of my car?"

@pat.art.draw.x.colorof.the core.pattern
    match="[what|whats|which] [color|colour] [is|are]? [the|that|this] {t:lex.art.draw.things} [$art.draw.g17_painted]? [$lang.tail.filler|i_guess|ish|yes|ya|k]? [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.colorOf arg.t=\"{t}\""
    kind=request
    priority=14
    example="What colour is the house?"

@shape.art.draw.ground core.shape
    family=do
    verb="draw|add|put|make|paint|create|give_me|show_me|add_some|draw_some"
    obj="g:lex.art.draw.ground"
    det="some|the|a_bit_of|more|a|a_lot_of"
    extra="[on_the_ground|to_the_ground|to_the_picture|to_my_picture|to_my_drawing]?"
    forms=imp,wish,ind,q
    sample="g=grass"
    emit="@{_} core.request action=draw.ground arg.g={g}"
    priority=13
    example="Add grass."

@shape.art.draw.mood core.shape
    family=set
    verb="make|turn|let|set|change|switch|go"
    noun="it|the_picture|the_drawing|the_sky|the_scene|the_day|everything"
    val="w:lex.art.draw.times"
    link="into|to|be|become"
    det="a"
    sample="w=night"
    emit="@{_} core.request action=draw.mood arg.w={w}"
    priority=13
    skip=state,q
    example="Make it night."

@pat.art.draw.x.move.state core.pattern
    canonical="The sun is above the clouds."
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [the|my]? {m1:lex.art.draw.mods?} {k:lex.art.draw.things} [is|are|should_be|must_be|needs_to_be|has_to_be|goes|go|sits|stands|belongs|stays] [to_be|to_go|to_sit]? {pp:lex.art.draw.preps} {d:words(8)} [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.move arg.phrase=\"the {k} {pp} {d}\" arg.m1={m1}"
    kind=request
    priority=12
    example="The sun is above the clouds."
    example="The cat should be under the tree."
    doc="RP3: a position stated as a fact is a request to put the thing there."

@pat.art.draw.x.move.notunder core.pattern
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [the|my]? {k:lex.art.draw.things} [is|are|should_be|must_be|goes|go|stays|stay]? [up|above|over|higher|on_top|on_top_of] [not|and_not|instead_of|rather_than|but_not] [under|below|beneath|underneath|behind|in_front_of] {d:words(8)} [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.move arg.phrase=\"the {k} above {d}\""
    kind=request
    priority=13
    example="The sun up, not under the clouds."
    doc="RP3: 'up, not under X' is above X."

@pat.art.draw.x.move.notabove core.pattern
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [the|my]? {k:lex.art.draw.things} [is|are|should_be|must_be|goes|go|stays|stay]? [down|below|under|beneath|underneath|lower] [not|and_not|instead_of|rather_than|but_not] [above|over|on_top_of|on_top] {d:words(8)} [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.move arg.phrase=\"the {k} under {d}\""
    kind=request
    priority=13
    example="The sun down, not above the clouds."

@pat.art.draw.x.add.open core.pattern
    canonical="Draw a lighthouse."
    canonical="Add a third window."
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [$art.draw.g1_can_you]? [draw|sketch|paint|add|create|draw_me|paint_me|sketch_me] [a|an|another] {o:words(3,noun)} [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.add arg.open=\"{o}\" arg.kt=\"{o}\""
    kind=request
    priority=4
    example="Draw a red lighthouse."
    example="Sketch a castle."
    example="Add a third window."
    doc="DRAW-FROM-FACTS: the thing to draw is an open slot. After the reading the operation looks the noun up in the catalog of drawable things (knowledge/k.objects, as things.catalog.mjs): a hit draws the thing from its parts; a part word of a thing in the picture adds one more of that part; nothing else is answered plainly (I don't know how to draw a blorp yet), never with a random shape."

@pat.art.draw.x.count.open core.pattern
    canonical="How many lighthouses are there?"
    match="how_many {k:words(2,noun)} [are_there|are_in_my_picture|are_in_my_drawing|are_in_the_picture|are_in_the_drawing|do_i_have|have_i_drawn|did_i_draw]"
    emit="@{_} core.request action=draw.count arg.kind=\"{k}\" arg.kt=\"{k}\""
    kind=request
    priority=4
    example="How many lighthouses are there?"
    doc="DRAW-FROM-FACTS: counts a thing of the catalog (a composite) as one object each; the noun is looked up after the reading, a word that is no thing is answered plainly."

@pat.art.draw.x.add.open.n core.pattern
    canonical="Draw two blue castles."
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [$art.draw.g1_can_you]? [draw|sketch|paint|add|create|draw_me|paint_me|sketch_me] {n:number} {o:words(3,noun)} [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
    emit="@{_} core.request action=draw.add arg.n={n} arg.open=\"{o}\" arg.kt=\"{o}\""
    kind=request
    priority=4
    example="Draw two blue castles."
    doc="DRAW-FROM-FACTS: the same open slot with a number (draw two blue castles)."

@pat.art.draw.takeApart core.pattern
    canonical="Take the house apart."
    match="[$lang.lead.polite|$art.draw.g2_hey]? [$lang.apart.verb] {t:words(5)} [$lang.apart] [$lang.tail.filler]?"
    emit="@{_} core.request action=draw.takeApart arg.t=\"{t}\""
    kind=request
    priority=15
    example="Take the house apart."
    example="Break the car into pieces."
    example="Pull it apart."
    doc="Takes a thing apart: its parts become things of their own."

@pat.art.draw.takeApart.first core.pattern
    canonical="Take apart the house."
    match="[$lang.lead.polite|$art.draw.g2_hey]? [$lang.apart.verb] apart {t:words(5)} [$lang.tail.filler]?"
    emit="@{_} core.request action=draw.takeApart arg.t=\"{t}\""
    kind=request
    priority=15
    example="Take apart the house."
    example="Pull apart the car."

@pat.art.draw.separate core.pattern
    canonical="Separate the roof."
    match="[$lang.lead.polite|$art.draw.g2_hey]? [$lang.dismantle] {t:words(5)} [$lang.apart]? [$lang.tail.filler]?"
    emit="@{_} core.request action=draw.takeApart arg.t=\"{t}\""
    kind=request
    priority=14
    example="Separate the roof."
    example="Dismantle the car."
    example="Detach the door from the house."

@pat.art.draw.group core.pattern
    canonical="Put these together."
    match="[$lang.lead.polite|$art.draw.g2_hey]? [$lang.group.verb] {t:words(5)} [$lang.together] [as|into|to_make|to_form]? [a|an|one|my]? {name:words(2)?}"
    emit="@{_} core.request action=draw.group arg.t=\"{t}\" arg.name=\"{name}\""
    kind=request
    priority=15
    example="Put these together."
    example="Glue the house and the tree together."
    example="Put them together as a boat."

@pat.art.draw.group.it core.pattern
    canonical="Group them."
    match="[$lang.lead.polite|$art.draw.g2_hey]? [group|combine|merge|bundle|unite] {t:words(5)}"
    emit="@{_} core.request action=draw.group arg.t=\"{t}\""
    kind=request
    priority=13
    example="Group them."
    example="Combine the house and the tree."

@pat.art.draw.group.named core.pattern
    canonical="This is a boat."
    match="[this|these|those|they] [$lang.group.is] [a|an|my|the|one] {name:words(2)}"
    emit="@{_} core.request action=draw.group arg.name=\"{name}\""
    kind=request
    priority=11
    example="This is a boat."
    example="These are a train."

@pat.art.draw.group.into core.pattern
    canonical="Make them into a boat."
    match="[$lang.lead.polite|$art.draw.g2_hey]? [$lang.group.make] [them|these|those|all_of_them|all_of_these] into [a|an|one|my] {name:words(2)}"
    emit="@{_} core.request action=draw.group arg.name=\"{name}\""
    kind=request
    priority=14
    example="Make them into a boat."
    example="Turn these into a train."

@pat.art.draw.group.into.things core.pattern
    canonical="Make the house and the tree into a village."
    match="[$lang.lead.polite|$art.draw.g2_hey]? [$lang.group.make] [the|my] {t:words(5)} into [a|an|one|my] {name:words(2)}"
    emit="@{_} core.request action=draw.group arg.t=\"the {t}\" arg.name=\"{name}\""
    kind=request
    priority=14
    example="Make the house and the tree into a village."
