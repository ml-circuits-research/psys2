@pat.art.draw.add core.pattern
    match="[can_you|could_you|will_you|would_you|please_can_you|i_want_you_to|i_would_like_you_to|let_us|can_u|could_u|would_u|will_u|hey|hey_can_you|hey_can_u|hey_could_you|ok_can_you|yo|i_d_like_to|id_like_to|i_d_like_you_to|im_gonna|we_want_to|we_would_like_to|i_need_you_to|could_you_please|would_you_please|can_you_just]? [draw|sketch|paint|add|make|put|create|give_me|show_me|i_want|i_would_like|i_need|draw_me|paint_me|make_me|sketch_me|let_us_draw|i_want_to_draw|i_would_like_to_draw|how_about|can_i_have|i_will_have|i_want_to_add|i_would_like_to_add|throw_in] [a_picture_of|a_drawing_of|a_painting_of|a_sketch_of|a_picture_with]? [a|an|another|1_more|more|some|a_few]? {n:number?} {q:lex.art.draw.quantity?} [of]? {m1:lex.art.draw.mods?} {m2:lex.art.draw.mods?} {m3:lex.art.draw.mods?} {k:lex.art.draw.things} {w:rest?}"
    emit="@{_} core.request action=draw.add arg.n={n} arg.q={q} arg.m1={m1} arg.m2={m2} arg.m3={m3} arg.kind={k} arg.kt=\"{k}\" arg.where=\"{w}\""
    kind=request
    priority=12
    example="Draw a red house."
    example="Draw three trees."
    example="Put a big yellow sun in the top right corner."
    example="Add a cloud next to the sun."
    example="Draw a cat under the tree."
    example="Draw a house with a red roof and a blue door."
    example="Add 5 stars."
    example="Draw a small blue fish."
    doc="Draws one or more things: count, size, color, kind, and an optional place or parts (\"in the top right corner\", \"next to the sun\", \"with a red roof\")."

@pat.art.draw.add.the core.pattern
    match="[can_you|could_you|will_you|would_you|please_can_you|i_want_you_to|i_would_like_you_to|let_us|can_u|could_u|would_u|will_u|hey|hey_can_you|hey_can_u|hey_could_you|ok_can_you|yo|i_d_like_to|id_like_to|i_d_like_you_to|im_gonna|we_want_to|we_would_like_to|i_need_you_to|could_you_please|would_you_please|can_you_just]? [draw|sketch|draw_me|sketch_me] the {n:number?} {q:lex.art.draw.quantity?} {m1:lex.art.draw.mods?} {m2:lex.art.draw.mods?} {m3:lex.art.draw.mods?} {k:lex.art.draw.things} {w:rest?}"
    emit="@{_} core.request action=draw.add arg.n={n} arg.q={q} arg.m1={m1} arg.m2={m2} arg.m3={m3} arg.kind={k} arg.kt=\"{k}\" arg.where=\"{w}\""
    kind=request
    priority=12
    example="Draw the sun."
    example="Sketch the moon in the sky."

