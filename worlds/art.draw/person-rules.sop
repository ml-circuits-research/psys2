# Person composition (authored), the one model of a drawn person shared by the Drawing tab and the Avatar tab (the
# Avatar is a view of the same person: one large person framed on the face). A person is a face (a k.faces style with
# a head: plain) and a body with clothes (a style drawn in the frame of a drawing: figure, k.faces.frame). A tab says
# which preset fills which face (ui.person.parts: an existing face, or a face the same command makes, by its call ref)
# and whether the person has a body (withBody=true); these rules make the parts of that preset on that face, the
# preset's colours, and, for a person with a body, leave out the face slots the body draws itself (ui.person.replaced:
# the neck and the shoulders). Which preset and which outfit: those of the person's age and sex (k.people.kind age,
# sex; k.faces.preset age, sex), the n-th of them for the person's seed (ui.person.pick), so two people of one kind need
# not look alike and the same seed gives the same look. Every garment, face part or trait added to the knowledge reaches
# both tabs through these rules.
@pz.person.parts.type core.type of=ui.person.parts
@pz.person.replaced.type core.type of=ui.person.replaced
@pz.person.cand.type core.type of=ui.person.candidate
@pz.person.count.type core.type of=ui.person.count
@pz.person.pick.type core.type of=ui.person.pick
@pz.person.head.type core.type of=ui.look.head
@pz.person.body.type core.type of=ui.look.body
@pz.person.replaced.neck ui.person.replaced slot=neck
@pz.person.replaced.shoulders ui.person.replaced slot=shoulders

# A face of a style drawn in the frame of a drawing is a body (the figure); another face is a head.
@pz.pl.face w.face.face style=?st
@pz.pl.frame k.faces.frame style=?st
@pz.pl.head.o ui.look.head face=$pz.pl.face style=?st
@pz.pl.body.o ui.look.body face=$pz.pl.face style=?st
@pz.look.head core.rule when=$pz.pl.face not=$pz.pl.frame then=$pz.pl.head.o
@pz.look.body core.rule when=$pz.pl.face when=$pz.pl.frame then=$pz.pl.body.o

# The colours of the preset, on the face (a call ref of a face made in the same command, or an existing face).
@pz.pp.req ui.person.parts face=?fr preset=?p order=?o
@pz.pp.c.skin k.faces.preset name=?p skin=?c
@pz.pp.c.skin.call app.act.call act=change thing=?fr attr=skin value=?c order=?o
@pz.person.colour.skin core.rule when=$pz.pp.req when=$pz.pp.c.skin then=$pz.pp.c.skin.call
@pz.pp.c.hair k.faces.preset name=?p hair_colour=?c
@pz.pp.c.hair.call app.act.call act=change thing=?fr attr=hair_colour value=?c order=?o
@pz.person.colour.hair core.rule when=$pz.pp.req when=$pz.pp.c.hair then=$pz.pp.c.hair.call
@pz.pp.c.eyes k.faces.preset name=?p eye_colour=?c
@pz.pp.c.eyes.call app.act.call act=change thing=?fr attr=eye_colour value=?c order=?o
@pz.person.colour.eyes core.rule when=$pz.pp.req when=$pz.pp.c.eyes then=$pz.pp.c.eyes.call
@pz.pp.c.clothes k.faces.preset name=?p clothes=?c
@pz.pp.c.clothes.call app.act.call act=change thing=?fr attr=clothes value=?c order=?o
@pz.person.colour.clothes core.rule when=$pz.pp.req when=$pz.pp.c.clothes then=$pz.pp.c.clothes.call
@pz.pp.c.name.call app.act.call act=change thing=?fr attr=preset value=?p order=?o
@pz.person.preset.name core.rule when=$pz.pp.req then=$pz.pp.c.name.call

# The parts of the preset, one rule per slot of the styles (a preset names its variant under the slot's own key).
@pz.pp.part.req ui.person.parts face=?fr preset=?p part=?po
@pz.pp.body ui.person.parts face=?fr preset=?p withBody=true
@pz.pp.rep ui.person.replaced slot=?slot
@pz.pp.hair_back.k k.faces.preset name=?p hair_back=?v
@pz.pp.hair_back.slot w.face.slot part=w.face.hair_back slot=?slot
@pz.pp.hair_back.call app.act.call act=make kind=w.face.hair_back variant=?v face=?fr order=?po
@pz.person.part.hair_back core.rule when=$pz.pp.part.req when=$pz.pp.hair_back.k when=$pz.pp.hair_back.slot not=$pz.pp.body then=$pz.pp.hair_back.call
@pz.person.part.hair_back.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.hair_back.k when=$pz.pp.hair_back.slot not=$pz.pp.rep then=$pz.pp.hair_back.call
@pz.pp.shoulders.k k.faces.preset name=?p shoulders=?v
@pz.pp.shoulders.slot w.face.slot part=w.face.shoulders slot=?slot
@pz.pp.shoulders.call app.act.call act=make kind=w.face.shoulders variant=?v face=?fr order=?po
@pz.person.part.shoulders core.rule when=$pz.pp.part.req when=$pz.pp.shoulders.k when=$pz.pp.shoulders.slot not=$pz.pp.body then=$pz.pp.shoulders.call
@pz.person.part.shoulders.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.shoulders.k when=$pz.pp.shoulders.slot not=$pz.pp.rep then=$pz.pp.shoulders.call
@pz.pp.neck.k k.faces.preset name=?p neck=?v
@pz.pp.neck.slot w.face.slot part=w.face.neck slot=?slot
@pz.pp.neck.call app.act.call act=make kind=w.face.neck variant=?v face=?fr order=?po
@pz.person.part.neck core.rule when=$pz.pp.part.req when=$pz.pp.neck.k when=$pz.pp.neck.slot not=$pz.pp.body then=$pz.pp.neck.call
@pz.person.part.neck.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.neck.k when=$pz.pp.neck.slot not=$pz.pp.rep then=$pz.pp.neck.call
@pz.pp.ears.k k.faces.preset name=?p ears=?v
@pz.pp.ears.slot w.face.slot part=w.face.ears slot=?slot
@pz.pp.ears.call app.act.call act=make kind=w.face.ears variant=?v face=?fr order=?po
@pz.person.part.ears core.rule when=$pz.pp.part.req when=$pz.pp.ears.k when=$pz.pp.ears.slot not=$pz.pp.body then=$pz.pp.ears.call
@pz.person.part.ears.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.ears.k when=$pz.pp.ears.slot not=$pz.pp.rep then=$pz.pp.ears.call
@pz.pp.head.k k.faces.preset name=?p head=?v
@pz.pp.head.slot w.face.slot part=w.face.head slot=?slot
@pz.pp.head.call app.act.call act=make kind=w.face.head variant=?v face=?fr order=?po
@pz.person.part.head core.rule when=$pz.pp.part.req when=$pz.pp.head.k when=$pz.pp.head.slot not=$pz.pp.body then=$pz.pp.head.call
@pz.person.part.head.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.head.k when=$pz.pp.head.slot not=$pz.pp.rep then=$pz.pp.head.call
@pz.pp.cheeks.k k.faces.preset name=?p cheeks=?v
@pz.pp.cheeks.slot w.face.slot part=w.face.cheeks slot=?slot
@pz.pp.cheeks.call app.act.call act=make kind=w.face.cheeks variant=?v face=?fr order=?po
@pz.person.part.cheeks core.rule when=$pz.pp.part.req when=$pz.pp.cheeks.k when=$pz.pp.cheeks.slot not=$pz.pp.body then=$pz.pp.cheeks.call
@pz.person.part.cheeks.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.cheeks.k when=$pz.pp.cheeks.slot not=$pz.pp.rep then=$pz.pp.cheeks.call
@pz.pp.beard.k k.faces.preset name=?p beard=?v
@pz.pp.beard.slot w.face.slot part=w.face.beard slot=?slot
@pz.pp.beard.call app.act.call act=make kind=w.face.beard variant=?v face=?fr order=?po
@pz.person.part.beard core.rule when=$pz.pp.part.req when=$pz.pp.beard.k when=$pz.pp.beard.slot not=$pz.pp.body then=$pz.pp.beard.call
@pz.person.part.beard.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.beard.k when=$pz.pp.beard.slot not=$pz.pp.rep then=$pz.pp.beard.call
@pz.pp.mouth.k k.faces.preset name=?p mouth=?v
@pz.pp.mouth.slot w.face.slot part=w.face.mouth slot=?slot
@pz.pp.mouth.call app.act.call act=make kind=w.face.mouth variant=?v face=?fr order=?po
@pz.person.part.mouth core.rule when=$pz.pp.part.req when=$pz.pp.mouth.k when=$pz.pp.mouth.slot not=$pz.pp.body then=$pz.pp.mouth.call
@pz.person.part.mouth.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.mouth.k when=$pz.pp.mouth.slot not=$pz.pp.rep then=$pz.pp.mouth.call
@pz.pp.moustache.k k.faces.preset name=?p moustache=?v
@pz.pp.moustache.slot w.face.slot part=w.face.moustache slot=?slot
@pz.pp.moustache.call app.act.call act=make kind=w.face.moustache variant=?v face=?fr order=?po
@pz.person.part.moustache core.rule when=$pz.pp.part.req when=$pz.pp.moustache.k when=$pz.pp.moustache.slot not=$pz.pp.body then=$pz.pp.moustache.call
@pz.person.part.moustache.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.moustache.k when=$pz.pp.moustache.slot not=$pz.pp.rep then=$pz.pp.moustache.call
@pz.pp.nose.k k.faces.preset name=?p nose=?v
@pz.pp.nose.slot w.face.slot part=w.face.nose slot=?slot
@pz.pp.nose.call app.act.call act=make kind=w.face.nose variant=?v face=?fr order=?po
@pz.person.part.nose core.rule when=$pz.pp.part.req when=$pz.pp.nose.k when=$pz.pp.nose.slot not=$pz.pp.body then=$pz.pp.nose.call
@pz.person.part.nose.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.nose.k when=$pz.pp.nose.slot not=$pz.pp.rep then=$pz.pp.nose.call
@pz.pp.eyes.k k.faces.preset name=?p eyes=?v
@pz.pp.eyes.slot w.face.slot part=w.face.eyes slot=?slot
@pz.pp.eyes.call app.act.call act=make kind=w.face.eyes variant=?v face=?fr order=?po
@pz.person.part.eyes core.rule when=$pz.pp.part.req when=$pz.pp.eyes.k when=$pz.pp.eyes.slot not=$pz.pp.body then=$pz.pp.eyes.call
@pz.person.part.eyes.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.eyes.k when=$pz.pp.eyes.slot not=$pz.pp.rep then=$pz.pp.eyes.call
@pz.pp.eyebrows.k k.faces.preset name=?p eyebrows=?v
@pz.pp.eyebrows.slot w.face.slot part=w.face.eyebrows slot=?slot
@pz.pp.eyebrows.call app.act.call act=make kind=w.face.eyebrows variant=?v face=?fr order=?po
@pz.person.part.eyebrows core.rule when=$pz.pp.part.req when=$pz.pp.eyebrows.k when=$pz.pp.eyebrows.slot not=$pz.pp.body then=$pz.pp.eyebrows.call
@pz.person.part.eyebrows.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.eyebrows.k when=$pz.pp.eyebrows.slot not=$pz.pp.rep then=$pz.pp.eyebrows.call
@pz.pp.glasses.k k.faces.preset name=?p glasses=?v
@pz.pp.glasses.slot w.face.slot part=w.face.glasses slot=?slot
@pz.pp.glasses.call app.act.call act=make kind=w.face.glasses variant=?v face=?fr order=?po
@pz.person.part.glasses core.rule when=$pz.pp.part.req when=$pz.pp.glasses.k when=$pz.pp.glasses.slot not=$pz.pp.body then=$pz.pp.glasses.call
@pz.person.part.glasses.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.glasses.k when=$pz.pp.glasses.slot not=$pz.pp.rep then=$pz.pp.glasses.call
@pz.pp.hair_front.k k.faces.preset name=?p hair_front=?v
@pz.pp.hair_front.slot w.face.slot part=w.face.hair_front slot=?slot
@pz.pp.hair_front.call app.act.call act=make kind=w.face.hair_front variant=?v face=?fr order=?po
@pz.person.part.hair_front core.rule when=$pz.pp.part.req when=$pz.pp.hair_front.k when=$pz.pp.hair_front.slot not=$pz.pp.body then=$pz.pp.hair_front.call
@pz.person.part.hair_front.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.hair_front.k when=$pz.pp.hair_front.slot not=$pz.pp.rep then=$pz.pp.hair_front.call
@pz.pp.earrings.k k.faces.preset name=?p earrings=?v
@pz.pp.earrings.slot w.face.slot part=w.face.earrings slot=?slot
@pz.pp.earrings.call app.act.call act=make kind=w.face.earrings variant=?v face=?fr order=?po
@pz.person.part.earrings core.rule when=$pz.pp.part.req when=$pz.pp.earrings.k when=$pz.pp.earrings.slot not=$pz.pp.body then=$pz.pp.earrings.call
@pz.person.part.earrings.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.earrings.k when=$pz.pp.earrings.slot not=$pz.pp.rep then=$pz.pp.earrings.call
@pz.pp.hat.k k.faces.preset name=?p hat=?v
@pz.pp.hat.slot w.face.slot part=w.face.hat slot=?slot
@pz.pp.hat.call app.act.call act=make kind=w.face.hat variant=?v face=?fr order=?po
@pz.person.part.hat core.rule when=$pz.pp.part.req when=$pz.pp.hat.k when=$pz.pp.hat.slot not=$pz.pp.body then=$pz.pp.hat.call
@pz.person.part.hat.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.hat.k when=$pz.pp.hat.slot not=$pz.pp.rep then=$pz.pp.hat.call
@pz.pp.body.k k.faces.preset name=?p body=?v
@pz.pp.body.slot w.face.slot part=w.face.body slot=?slot
@pz.pp.body.call app.act.call act=make kind=w.face.body variant=?v face=?fr order=?po
@pz.person.part.body core.rule when=$pz.pp.part.req when=$pz.pp.body.k when=$pz.pp.body.slot not=$pz.pp.body then=$pz.pp.body.call
@pz.person.part.body.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.body.k when=$pz.pp.body.slot not=$pz.pp.rep then=$pz.pp.body.call
@pz.pp.bottom.k k.faces.preset name=?p bottom=?v
@pz.pp.bottom.slot w.face.slot part=w.face.bottom slot=?slot
@pz.pp.bottom.call app.act.call act=make kind=w.face.bottom variant=?v face=?fr order=?po
@pz.person.part.bottom core.rule when=$pz.pp.part.req when=$pz.pp.bottom.k when=$pz.pp.bottom.slot not=$pz.pp.body then=$pz.pp.bottom.call
@pz.person.part.bottom.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.bottom.k when=$pz.pp.bottom.slot not=$pz.pp.rep then=$pz.pp.bottom.call
@pz.pp.shoes.k k.faces.preset name=?p shoes=?v
@pz.pp.shoes.slot w.face.slot part=w.face.shoes slot=?slot
@pz.pp.shoes.call app.act.call act=make kind=w.face.shoes variant=?v face=?fr order=?po
@pz.person.part.shoes core.rule when=$pz.pp.part.req when=$pz.pp.shoes.k when=$pz.pp.shoes.slot not=$pz.pp.body then=$pz.pp.shoes.call
@pz.person.part.shoes.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.shoes.k when=$pz.pp.shoes.slot not=$pz.pp.rep then=$pz.pp.shoes.call
@pz.pp.top.k k.faces.preset name=?p top=?v
@pz.pp.top.slot w.face.slot part=w.face.top slot=?slot
@pz.pp.top.call app.act.call act=make kind=w.face.top variant=?v face=?fr order=?po
@pz.person.part.top core.rule when=$pz.pp.part.req when=$pz.pp.top.k when=$pz.pp.top.slot not=$pz.pp.body then=$pz.pp.top.call
@pz.person.part.top.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.top.k when=$pz.pp.top.slot not=$pz.pp.rep then=$pz.pp.top.call
@pz.pp.coat.k k.faces.preset name=?p coat=?v
@pz.pp.coat.slot w.face.slot part=w.face.coat slot=?slot
@pz.pp.coat.call app.act.call act=make kind=w.face.coat variant=?v face=?fr order=?po
@pz.person.part.coat core.rule when=$pz.pp.part.req when=$pz.pp.coat.k when=$pz.pp.coat.slot not=$pz.pp.body then=$pz.pp.coat.call
@pz.person.part.coat.body core.rule when=$pz.pp.part.req when=$pz.pp.body when=$pz.pp.coat.k when=$pz.pp.coat.slot not=$pz.pp.rep then=$pz.pp.coat.call

# Which preset: those of the style that suit the person's age and sex (a tab states each trait, or `any` when the
# person has none: a person of no stated age takes a preset of any age), counted, and the one at the person's seed
# modulo their number, in the order of their names. A tab states the person to compose (ui.person.want: the key it names
# the choice by, the style, the seed; and its age and its sex, each a value or any).
@pz.person.want.type core.type of=ui.person.want
@pz.pw.w ui.person.want key=?key style=?st seed=?seed
@pz.pw.age ui.person.want key=?key age=?a
@pz.pw.sex ui.person.want key=?key sex=?s
@pz.pw.anyage ui.person.want key=?key age=any
@pz.pw.anysex ui.person.want key=?key sex=any
@pz.pw.p.as k.faces.preset style=?st name=?p kind=human age=?a sex=?s
@pz.pw.p.a k.faces.preset style=?st name=?p kind=human age=?a
@pz.pw.p.s k.faces.preset style=?st name=?p kind=human sex=?s
@pz.pw.p.any k.faces.preset style=?st name=?p kind=human age=?anyAge
@pz.pw.c ui.person.candidate key=?key preset=?p
@pz.person.candidate.both core.rule when=$pz.pw.w when=$pz.pw.age when=$pz.pw.sex when=$pz.pw.p.as then=$pz.pw.c
@pz.person.candidate.age core.rule when=$pz.pw.w when=$pz.pw.age when=$pz.pw.anysex when=$pz.pw.p.a then=$pz.pw.c
@pz.person.candidate.sex core.rule when=$pz.pw.w when=$pz.pw.anyage when=$pz.pw.sex when=$pz.pw.p.s then=$pz.pw.c
@pz.person.candidate.any core.rule when=$pz.pw.w when=$pz.pw.anyage when=$pz.pw.anysex when=$pz.pw.p.any then=$pz.pw.c
@pz.pk.c ui.person.candidate key=?key preset=?p
@pz.pk.count core.aggregate over=$pz.pk.c by=?key count=?n then=$pz.pk.n.o
@pz.pk.n.o ui.person.count key=?key n=?n
@pz.pk.n ui.person.count key=?key n=?n
@pz.pk.w ui.person.want key=?key seed=?seed
@pz.pk.rank core.rank of=$pz.pk.c by=preset out=?r within=?key
@pz.pk.mod core.calc out=?m fn=mod args=?seed args=?n
@pz.pk.at core.calc out=?at fn=sub args=?r args=1
@pz.pk.is core.check fn=eq args=?at args=?m
@pz.pk.out ui.person.pick key=?key preset=?p
@pz.person.pick core.rule when=$pz.pk.c when=$pz.pk.n when=$pz.pk.w with=$pz.pk.rank with=$pz.pk.mod with=$pz.pk.at if=$pz.pk.is then=$pz.pk.out


# The outfit, chosen the same way after the face (its age and sex are those of the face chosen): the same rules over
# the types of the body, so the choice of the face is made first. Which preset: those of the style that suit the person's age and sex (a tab states each trait, or `any` when the
# person has none: a person of no stated age takes a preset of any age), counted, and the one at the person's seed
# modulo their number, in the order of their names. A tab states the person to compose (ui.person.bodywant: the key it names
# the choice by, the style, the seed; and its age and its sex, each a value or any).
@pb.person.want.type core.type of=ui.person.bodywant
@pb.person.cand.type core.type of=ui.person.bodycandidate
@pb.person.count.type core.type of=ui.person.bodycount
@pb.person.pick.type core.type of=ui.person.bodypick
@pb.pw.w ui.person.bodywant key=?key style=?st seed=?seed
@pb.pw.age ui.person.bodywant key=?key age=?a
@pb.pw.sex ui.person.bodywant key=?key sex=?s
@pb.pw.anyage ui.person.bodywant key=?key age=any
@pb.pw.anysex ui.person.bodywant key=?key sex=any
@pb.pw.p.as k.faces.preset style=?st name=?p kind=human age=?a sex=?s
@pb.pw.p.a k.faces.preset style=?st name=?p kind=human age=?a
@pb.pw.p.s k.faces.preset style=?st name=?p kind=human sex=?s
@pb.pw.p.any k.faces.preset style=?st name=?p kind=human age=?anyAge
@pb.pw.c ui.person.bodycandidate key=?key preset=?p
@pb.person.candidate.both core.rule when=$pb.pw.w when=$pb.pw.age when=$pb.pw.sex when=$pb.pw.p.as then=$pb.pw.c
@pb.person.candidate.age core.rule when=$pb.pw.w when=$pb.pw.age when=$pb.pw.anysex when=$pb.pw.p.a then=$pb.pw.c
@pb.person.candidate.sex core.rule when=$pb.pw.w when=$pb.pw.anyage when=$pb.pw.sex when=$pb.pw.p.s then=$pb.pw.c
@pb.person.candidate.any core.rule when=$pb.pw.w when=$pb.pw.anyage when=$pb.pw.anysex when=$pb.pw.p.any then=$pb.pw.c
@pb.pk.c ui.person.bodycandidate key=?key preset=?p
@pb.pk.count core.aggregate over=$pb.pk.c by=?key count=?n then=$pb.pk.n.o
@pb.pk.n.o ui.person.bodycount key=?key n=?n
@pb.pk.n ui.person.bodycount key=?key n=?n
@pb.pk.w ui.person.bodywant key=?key seed=?seed
@pb.pk.rank core.rank of=$pb.pk.c by=preset out=?r within=?key
@pb.pk.mod core.calc out=?m fn=mod args=?seed args=?n
@pb.pk.at core.calc out=?at fn=sub args=?r args=1
@pb.pk.is core.check fn=eq args=?at args=?m
@pb.pk.out ui.person.bodypick key=?key preset=?p
@pb.person.pick core.rule when=$pb.pk.c when=$pb.pk.n when=$pb.pk.w with=$pb.pk.rank with=$pb.pk.mod with=$pb.pk.at if=$pb.pk.is then=$pb.pk.out


# The colours of a person chosen by its seed the same way (ui.person.colourwant: the key, what the colour is of, the
# seed; natural=true for the colours people have): the n-th colour of the catalog's list of that use.
@pt.type.want core.type of=ui.person.colourwant
@pt.type.cand core.type of=ui.person.colourcandidate
@pt.type.count core.type of=ui.person.colourcount
@pt.type.pick core.type of=ui.person.colourpick
@pt.w ui.person.colourwant key=?key of=?of seed=?seed
@pt.wn ui.person.colourwant key=?key of=?of natural=true
@pt.cn k.faces.colour of=?of name=?c natural=true
@pt.ca k.faces.colour of=?of name=?c
@pt.c ui.person.colourcandidate key=?key of=?of colour=?c
@person.colour.natural core.rule when=$pt.w when=$pt.wn when=$pt.cn then=$pt.c
@person.colour.any core.rule when=$pt.w not=$pt.wn when=$pt.ca then=$pt.c
@pt.k ui.person.colourcandidate key=?key of=?of colour=?c
@pt.count core.aggregate over=$pt.k by=?key by=?of count=?n then=$pt.n.o
@pt.n.o ui.person.colourcount key=?key of=?of n=?n
@pt.n ui.person.colourcount key=?key of=?of n=?n
@pt.rank core.rank of=$pt.k by=colour out=?r within=?key within=?of
@pt.mod core.calc out=?m fn=mod args=?seed args=?n
@pt.at core.calc out=?at fn=sub args=?r args=1
@pt.is core.check fn=eq args=?at args=?m
@pt.out ui.person.colourpick key=?key of=?of colour=?c
@person.colour.pick core.rule when=$pt.k when=$pt.n when=$pt.w with=$pt.rank with=$pt.mod with=$pt.at if=$pt.is then=$pt.out
