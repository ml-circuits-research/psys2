# art.draw render projection (authored): what is drawn for each w.drawing object, derived with k.objects.
# A kind with its own drawing in k.objects draws its parts in the 0..100 frame, scaled to the object's size
# about its centre; a basic shape is one declared primitive; a kind with no drawing of its own draws the one of
# the kind it is a kind of (k.people kind_of). The object's colour paints the drawing's largest part.
@d.draw.type core.type of=ui.draw.draw
@d.fill.type core.type of=ui.draw.fill
@d.colour.type core.type of=ui.draw.colour
@d.chosen.type core.type of=ui.draw.chosen
@d.area.type core.type of=ui.draw.area
@d.main.type core.type of=ui.draw.main
@d.rgb.type core.type of=ui.draw.rgb
@d.edited.type core.type of=ui.draw.edited
@d.index.type core.type of=ui.draw.index
@d.point.type core.type of=ui.draw.point
@d.orient.type core.type of=ui.draw.orient
@d.form.type core.type of=ui.draw.form
@d.shape.type core.type of=ui.draw.shape
@d.kind.type core.type of=ui.draw.kind
@d.extent.type core.type of=ui.draw.extent
@d.partgeo.type core.type of=ui.draw.partgeo

# The box an object fills: its width and height where it has them, else its size on that side (a square box).
@ext.o w.drawing.object code=?id size=?s
@ext.w w.drawing.object code=?id width=?w
@ext.h w.drawing.object code=?id height=?h
@ext.wh.o ui.draw.extent object=?id w=?w h=?h
@ext.ws.o ui.draw.extent object=?id w=?w h=?s
@ext.sh.o ui.draw.extent object=?id w=?s h=?h
@ext.ss.o ui.draw.extent object=?id w=?s h=?s
@extent.both core.rule when=$ext.o when=$ext.w when=$ext.h then=$ext.wh.o
@extent.width core.rule when=$ext.o when=$ext.w not=$ext.h then=$ext.ws.o
@extent.height core.rule when=$ext.o not=$ext.w when=$ext.h then=$ext.sh.o
@extent.size core.rule when=$ext.o not=$ext.w not=$ext.h then=$ext.ss.o

# Basic shapes: one primitive filling the object's box.
@shape.circle ui.draw.shape drawing=circle shape=circle
@shape.oval ui.draw.shape drawing=oval shape=oval
@shape.square ui.draw.shape drawing=square shape=square
@shape.rectangle ui.draw.shape drawing=rectangle shape=rectangle
@shape.triangle ui.draw.shape drawing=triangle shape=triangle
@shape.patch ui.draw.shape drawing=patch shape=oval
@shape.line ui.draw.shape drawing=line shape=line
@line.o w.drawing.object code=?id drawing=line
@line.p1 ui.draw.point source=?id n=1 x=0 y=50
@line.p2 ui.draw.point source=?id n=2 x=100 y=50
@line.start core.rule when=$line.o then=$line.p1
@line.end core.rule when=$line.o then=$line.p2

# The drawing an object uses: its own, else the one of the kind it is a kind of.
@form.o w.drawing.object code=?id drawing=?k
@form.own k.objects.object name=?k
@form.own.o ui.draw.form object=?id form=?k
@form.direct core.rule when=$form.o when=$form.own then=$form.own.o
@form.parent k.people.kind name=?k kind_of=?p
@form.parent.obj k.objects.object name=?p
@form.parent.o ui.draw.form object=?id form=?p
@form.inherited core.rule when=$form.o when=$form.parent when=$form.parent.obj not=$form.own then=$form.parent.o

# Parts of the form, scaled about the object's centre: the 0..100 frame maps onto the object's box (its extent). A part's
# index is its place in the drawing's layer order (from 0), the index part edits name; a removed part is not drawn.
@ix.o w.drawing.object code=?id
@ix.f ui.draw.form object=?id form=?k
@ix.kp k.objects.part of=?k z=?pz
@ix.rank core.rank of=$ix.kp by=z out=?r within=?k
@ix.i core.calc out=?i fn=sub args=?r args=1
@ix.out ui.draw.index object=?id source=$ix.kp index=?i
@project.index core.rule when=$ix.o when=$ix.f when=$ix.kp with=$ix.rank with=$ix.i then=$ix.out
@pr.o w.drawing.object code=?id x=?x y=?y size=?s z=?layer
@pr.f ui.draw.form object=?id form=?k
@pr.kp k.objects.part of=?k shape=?shape x=?px y=?py w=?pw h=?ph z=?pz
@pr.ix ui.draw.index object=?id source=$pr.kp index=?i
@pr.removed w.drawing.part object=$pr.o index=?i removed=true
@pr.moved w.drawing.part object=$pr.o index=?i dx=?mdx
@pr.k core.calc out=?scale fn=div args=?s args=100
@pr.ext ui.draw.extent object=?id w=?ow h=?oh
@pr.sx core.calc out=?sx fn=div args=?ow args=100
@pr.sy core.calc out=?sy fn=div args=?oh args=100
@pr.out ui.draw.draw part=?id source=$pr.kp slot=?id order=?layer z=?pz shape=?shape x=?px y=?py w=?pw h=?ph cx=50 cy=50 tx=?x ty=?y scale=?scale sx=?sx sy=?sy side=left
@project.parts core.rule when=$pr.o when=$pr.f when=$pr.kp when=$pr.ix not=$pr.removed not=$pr.moved when=$pr.ext with=$pr.k with=$pr.sx with=$pr.sy then=$pr.out

# The geometry of each part in the drawing's 0..100 frame: its own centre (cx, cy) and size (pw, ph), and where it is
# drawn: its centre moved by its edit (ex, ey) and its size as edited (fw, fh). A geometry edit stores dx, dy, width
# and height together (drawing.part.place, drawing.part.change width/height), so the part keeps its place on the
# object when the object moves or is resized.
@pg.o w.drawing.object code=?id
@pg.f ui.draw.form object=?id form=?k
@pg.kp k.objects.part of=?k x=?px y=?py w=?pw h=?ph
@pg.ix ui.draw.index object=?id source=$pg.kp index=?i
@pg.hw core.calc out=?hw fn=div args=?pw args=2
@pg.hh core.calc out=?hh fn=div args=?ph args=2
@pg.cx core.calc out=?cx fn=add args=?px args=?hw
@pg.cy core.calc out=?cy fn=add args=?py args=?hh
@pg.edit w.drawing.part object=$pg.o index=?i dx=?dx dy=?dy width=?fw height=?fh
@pg.ex core.calc out=?ex fn=add args=?cx args=?dx
@pg.ey core.calc out=?ey fn=add args=?cy args=?dy
@pg.plain.o ui.draw.partgeo object=?id source=$pg.kp index=?i cx=?cx cy=?cy pw=?pw ph=?ph ex=?cx ey=?cy fw=?pw fh=?ph
@pg.edit.o ui.draw.partgeo object=?id source=$pg.kp index=?i cx=?cx cy=?cy pw=?pw ph=?ph ex=?ex ey=?ey fw=?fw fh=?fh
@partgeo.plain core.rule when=$pg.o when=$pg.f when=$pg.kp when=$pg.ix not=$pg.edit with=$pg.hw with=$pg.hh with=$pg.cx with=$pg.cy then=$pg.plain.o
@partgeo.edited core.rule when=$pg.o when=$pg.f when=$pg.kp when=$pg.ix when=$pg.edit with=$pg.hw with=$pg.hh with=$pg.cx with=$pg.cy with=$pg.ex with=$pg.ey then=$pg.edit.o

# A part with a geometry edit: a shape drawn in its box takes the edited box; a shape drawn through its points (a
# polygon, a line) is moved and scaled about its own centre.
@pe.o w.drawing.object code=?id x=?x y=?y size=?s z=?layer
@pe.kp k.objects.part shape=?shape x=?px y=?py w=?pw h=?ph z=?pz
@pe.g ui.draw.partgeo object=?id source=$pe.kp index=?i cx=?cx cy=?cy ex=?ex ey=?ey fw=?fw fh=?fh
@pe.edit w.drawing.part object=$pe.o index=?i dx=?dx
@pe.removed w.drawing.part object=$pe.o index=?i removed=true
@pe.pt k.objects.point part=$pe.kp
@pe.ext ui.draw.extent object=?id w=?ow h=?oh
@pe.k core.calc out=?scale fn=div args=?s args=100
@pe.sx core.calc out=?sx fn=div args=?ow args=100
@pe.sy core.calc out=?sy fn=div args=?oh args=100
@pe.hw core.calc out=?hw fn=div args=?fw args=2
@pe.hh core.calc out=?hh fn=div args=?fh args=2
@pe.bx core.calc out=?bx fn=sub args=?ex args=?hw
@pe.by core.calc out=?by fn=sub args=?ey args=?hh
@pe.box.out ui.draw.draw part=?id source=$pe.kp slot=?id order=?layer z=?pz shape=?shape x=?bx y=?by w=?fw h=?fh cx=50 cy=50 tx=?x ty=?y scale=?scale sx=?sx sy=?sy side=left
@project.parts.edited.box core.rule when=$pe.o when=$pe.kp when=$pe.g when=$pe.edit not=$pe.removed not=$pe.pt when=$pe.ext with=$pe.k with=$pe.sx with=$pe.sy with=$pe.hw with=$pe.hh with=$pe.bx with=$pe.by then=$pe.box.out
@pe.fwm core.calc out=?fwm fn=max args=?fw args=0.01
@pe.fhm core.calc out=?fhm fn=max args=?fh args=0.01
@pe.pwm core.calc out=?pwm fn=max args=?pw args=0.01
@pe.phm core.calc out=?phm fn=max args=?ph args=0.01
@pe.kx core.calc out=?kx fn=div args=?fwm args=?pwm
@pe.ky core.calc out=?ky fn=div args=?fhm args=?phm
@pe.sx2 core.calc out=?sx2 fn=mul args=?sx args=?kx
@pe.sy2 core.calc out=?sy2 fn=mul args=?sy args=?ky
@pe.ux core.calc out=?ux fn=sub args=?ex args=50
@pe.uy core.calc out=?uy fn=sub args=?ey args=50
@pe.vx core.calc out=?vx fn=mul args=?ux args=?sx
@pe.vy core.calc out=?vy fn=mul args=?uy args=?sy
@pe.tx core.calc out=?tx fn=add args=?x args=?vx
@pe.ty core.calc out=?ty fn=add args=?y args=?vy
@pe.pts.out ui.draw.draw part=?id source=$pe.kp slot=?id order=?layer z=?pz shape=?shape x=?px y=?py w=?pw h=?ph cx=?cx cy=?cy tx=?tx ty=?ty scale=?scale sx=?sx2 sy=?sy2 side=left
@project.parts.edited.points core.rule when=$pe.o when=$pe.kp when=$pe.g when=$pe.edit not=$pe.removed when=$pe.pt when=$pe.ext with=$pe.k with=$pe.sx with=$pe.sy with=$pe.fwm with=$pe.fhm with=$pe.pwm with=$pe.phm with=$pe.kx with=$pe.ky with=$pe.sx2 with=$pe.sy2 with=$pe.ux with=$pe.uy with=$pe.vx with=$pe.vy with=$pe.tx with=$pe.ty then=$pe.pts.out

@pp.draw ui.draw.draw source=?src
@pp.k k.objects.point part=?src n=?n x=?x y=?y
@pp.o ui.draw.point source=?src n=?n x=?x y=?y
@project.points core.rule when=$pp.draw when=$pp.k then=$pp.o
@po.kp k.objects.part opens=?open
@po.draw ui.draw.draw source=$po.kp
@po.o ui.draw.orient source=$po.kp opens=?open
@project.orient core.rule when=$po.kp when=$po.draw then=$po.o

# Basic shapes.
@ps.o w.drawing.object code=?id drawing=?k x=?x y=?y size=?s z=?layer
@ps.shape ui.draw.shape drawing=?k shape=?shape
@ps.k core.calc out=?scale fn=div args=?s args=100
@ps.ext ui.draw.extent object=?id w=?ow h=?oh
@ps.sx core.calc out=?sx fn=div args=?ow args=100
@ps.sy core.calc out=?sy fn=div args=?oh args=100
@ps.out ui.draw.draw part=?id source=?id slot=?id order=?layer z=0 shape=?shape x=0 y=0 w=100 h=100 cx=50 cy=50 tx=?x ty=?y scale=?scale sx=?sx sy=?sy side=left
@project.shape core.rule when=$ps.o when=$ps.shape when=$ps.ext with=$ps.k with=$ps.sx with=$ps.sy then=$ps.out

# A colour value is a k.colours name or an #rrggbb value, which is its own RGB.
@rgb.name k.colours.colour name=?c rgb=?rgb
@rgb.name.o ui.draw.rgb colour=?c rgb=?rgb
@colour.named core.rule when=$rgb.name then=$rgb.name.o
@rgb.obj w.drawing.object colour=?c
@rgb.part w.drawing.part colour=?c
@rgb.hex core.check fn=matches args=?c args="^#[0-9a-fA-F]{6}$"
@rgb.hex.o ui.draw.rgb colour=?c rgb=?c
@colour.hex.object core.rule when=$rgb.obj if=$rgb.hex then=$rgb.hex.o
@colour.hex.part core.rule when=$rgb.part if=$rgb.hex then=$rgb.hex.o

# Colours: the object's colour paints the largest part of its drawing (and a basic shape), the other parts keep
# their own first colour; an edited part takes its edit.
@c.o w.drawing.object code=?id colour=?c
@c.rgb ui.draw.rgb colour=?c rgb=?rgb
@e.o w.drawing.object code=?id
@e.part w.drawing.part object=$e.o index=?i colour=?c
@e.ix ui.draw.index object=?id source=?src index=?i
@e.rgb ui.draw.rgb colour=?c rgb=?rgb
@e.out ui.draw.edited source=?src part=?id fill=?rgb
@colour.edited core.rule when=$e.o when=$e.part when=$e.ix when=$e.rgb then=$e.out
@ar.f ui.draw.form form=?k
@ar.kp k.objects.part of=?k w=?w h=?h
@ar.a core.calc out=?area fn=mul args=?w args=?h
@ar.out ui.draw.area form=?k source=$ar.kp area=?area
@project.area core.rule when=$ar.f when=$ar.kp with=$ar.a then=$ar.out
@main.a ui.draw.area form=?k source=?src area=?area
@main.out ui.draw.main form=?k source=?best
@main core.aggregate over=$main.a by=?k argmax=?best args=?area pick=?src ties=first then=$main.out
@c.main.f ui.draw.form object=?id form=?k
@c.main ui.draw.main form=?k source=?src
@c.main.draw ui.draw.draw part=?id source=?src
@c.main.edited ui.draw.edited source=?src part=?id
@c.main.out ui.draw.chosen source=?src part=?id fill=?rgb
@colour.main core.rule when=$c.o when=$c.rgb when=$c.main.f when=$c.main when=$c.main.draw not=$c.main.edited then=$c.main.out
@c.shape.draw ui.draw.draw part=?id source=?id
@c.shape.out ui.draw.chosen source=?id part=?id fill=?rgb
@colour.shape core.rule when=$c.o when=$c.rgb when=$c.shape.draw then=$c.shape.out
@c.own.kp k.objects.part colour=?pc
@c.own.draw ui.draw.draw part=?id source=$c.own.kp
@c.own.rgb k.colours.colour name=?pc rgb=?rgb
@c.chosen ui.draw.chosen source=$c.own.kp part=?id
@c.edited ui.draw.edited source=$c.own.kp part=?id
@c.own.out ui.draw.colour source=$c.own.kp part=?id fill=?rgb
@colour.own core.rule when=$c.own.kp when=$c.own.draw when=$c.own.rgb not=$c.chosen not=$c.edited then=$c.own.out
@f.edited ui.draw.edited source=?src part=?id fill=?f
@f.edited.o ui.draw.fill source=?src part=?id fill=?f
@fill.edited core.rule when=$f.edited then=$f.edited.o
@f.chosen ui.draw.chosen source=?src part=?id fill=?f
@f.chosen.o ui.draw.fill source=?src part=?id fill=?f
@fill.chosen core.rule when=$f.chosen then=$f.chosen.o
@f.c ui.draw.colour source=?src part=?id fill=?f
@f.o ui.draw.fill source=?src part=?id fill=?f
@fill.own core.rule when=$f.c then=$f.o
@f.default.draw ui.draw.draw source=?src part=?id
@f.default.has ui.draw.colour source=?src part=?id
@f.default.chosen ui.draw.chosen source=?src part=?id
@f.default.edited ui.draw.edited source=?src part=?id
@f.default.o ui.draw.fill source=?src part=?id fill="#9aa5b1"
@fill.default core.rule when=$f.default.draw not=$f.default.has not=$f.default.chosen not=$f.default.edited then=$f.default.o

# Labels under the object, centred on it.
@l.o w.drawing.object code=?id label=?text x=?x y=?y size=?s z=?layer
@l.h core.calc out=?h fn=div args=?s args=2
@l.y core.calc out=?ly fn=add args=?y args=?h
@l.y2 core.calc out=?ty fn=add args=?ly args=18
@l.out ui.draw.draw part=?id source=?text slot=?id order=?layer z=99 shape=text text=?text x=?x y=?ty w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left anchor=middle
@label core.rule when=$l.o with=$l.h with=$l.y with=$l.y2 then=$l.out
@l.ink ui.draw.chosen source=?text part=?id fill="#1f2933"
@label.ink core.rule when=$l.o then=$l.ink

# The kinds the Drawing tab offers by name (drawing.object.make); any k.objects drawing is reachable through drawing.catalog.make.
@kind.circle ui.draw.kind drawing=circle
@kind.oval ui.draw.kind drawing=oval
@kind.square ui.draw.kind drawing=square
@kind.rectangle ui.draw.kind drawing=rectangle
@kind.triangle ui.draw.kind drawing=triangle
@kind.star ui.draw.kind drawing=star
@kind.heart ui.draw.kind drawing=heart
@kind.line ui.draw.kind drawing=line
@kind.arrow ui.draw.kind drawing=arrow
@kind.lake ui.draw.kind drawing=lake
@kind.river ui.draw.kind drawing=river
@kind.road ui.draw.kind drawing=road
@kind.field ui.draw.kind drawing=field
@kind.patch ui.draw.kind drawing=patch
@kind.hill ui.draw.kind drawing=hill
@kind.house ui.draw.kind drawing=house
@kind.tree ui.draw.kind drawing=tree
@kind.sun ui.draw.kind drawing=sun
@kind.cloud ui.draw.kind drawing=cloud
@kind.car ui.draw.kind drawing=car
@kind.flower ui.draw.kind drawing=flower
@kind.cat ui.draw.kind drawing=cat
@kind.dog ui.draw.kind drawing=dog
@kind.fish ui.draw.kind drawing=fish
@kind.bird ui.draw.kind drawing=bird
@kind.boat ui.draw.kind drawing=boat
@kind.mountain ui.draw.kind drawing=mountain
@kind.rainbow ui.draw.kind drawing=rainbow
@kind.person ui.draw.kind drawing=person
@kind.balloon ui.draw.kind drawing=balloon
@kind.rocket ui.draw.kind drawing=rocket
@kind.moon ui.draw.kind drawing=moon
