@layer.water std.schema.region world=drawing name=water kind=water kind=lake kind=river kind=fish kind=goldfish kind=duck kind=boat kind=frog kind="water lily" kind=reed
@layer.land std.schema.region world=drawing name=land kind=house kind=tree kind=flower kind=bush kind=grass kind=fence kind=bench kind=stone kind=cat kind=dog kind=mountain kind=hill kind=person kind=car
@layer.sky std.schema.region world=drawing name=sky kind=sun kind=cloud kind=bird kind=butterfly kind=moon kind=rainbow kind=balloon kind=rocket
@wd.woods core.word text=woods means=forest
@wd.things core.word text=thing text=things text=items means=part
# The door (reviewer 2026-11-15 16:40): the wholes whose requests this world plans through the library. Read by src/dialog/request.mjs doorWholes.
@door psys2.door world=drawing whole=pond whole=forest whole=garden
