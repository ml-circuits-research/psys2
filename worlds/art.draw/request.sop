# Spec 28 (sopworld 0.149): what this world can do, as data the library reads (capabilitiesOf, readRequest, planRequest): its kinds and slots (std.schema),
# the constraints each act honours (std.schema.honours) and its own expectations (k.expect.make / k.expect.part) where the catalog's k.expect has none.
# No code reads this file per world: src/dialog/request.mjs loads it as the world's live request World.
@acts core.use world=std.acts
@w std.schema.world name=drawing doc="the drawing board: scenes of the board's own things, sized and placed"
@t.picture core.type of=picture extends=std.schema.thing closed=true
@s.extent core.slot of=picture key=extent enum=tiny enum=small enum=default enum=big enum=huge
@s.place core.slot of=picture key=place enum=corner enum=top enum=bottom enum=left enum=right enum=center
@s.layout core.slot of=picture key=layout enum=layers enum=free
@t.pond core.type of=pond extends=picture closed=true
@t.forest core.type of=forest extends=picture closed=true
@t.garden core.type of=garden extends=picture closed=true
@k.pond std.schema.kind of=pond world=drawing acts=make acts=remove
@k.forest std.schema.kind of=forest world=drawing acts=make acts=remove
@k.garden std.schema.kind of=garden world=drawing acts=make acts=remove
@t.thing core.type of=thing extends=std.schema.thing closed=true
@s.size core.slot of=thing key=size enum=tiny enum=small enum=default enum=big enum=huge
@s.in core.slot of=thing key=in
@s.thing_place core.slot of=thing key=place enum=corner enum=top enum=bottom enum=left enum=right enum=center
@s.thing_colour core.slot of=thing key=colour kind=string
@t.water core.type of=water extends=thing closed=true
@k.water std.schema.kind of=water world=drawing acts=make acts=remove
@t.flower core.type of=flower extends=thing closed=true
@k.flower std.schema.kind of=flower world=drawing acts=make acts=remove
@t.tree core.type of=tree extends=thing closed=true
@k.tree std.schema.kind of=tree world=drawing acts=make acts=remove
@t.bush core.type of=bush extends=thing closed=true
@k.bush std.schema.kind of=bush world=drawing acts=make acts=remove
@t.butterfly core.type of=butterfly extends=thing closed=true
@k.butterfly std.schema.kind of=butterfly world=drawing acts=make acts=remove
@t.bird core.type of=bird extends=thing closed=true
@k.bird std.schema.kind of=bird world=drawing acts=make acts=remove
@t.cloud core.type of=cloud extends=thing closed=true
@k.cloud std.schema.kind of=cloud world=drawing acts=make acts=remove
@t.sun core.type of=sun extends=thing closed=true
@k.sun std.schema.kind of=sun world=drawing acts=make acts=remove
@t.sky core.type of=sky extends=thing closed=true
@k.sky std.schema.kind of=sky world=drawing acts=make acts=remove
@t.house core.type of=house extends=thing closed=true
@k.house std.schema.kind of=house world=drawing acts=make acts=remove
@t.fish core.type of=fish extends=thing closed=true
@k.fish std.schema.kind of=fish world=drawing acts=make acts=remove
@t.boat core.type of=boat extends=thing closed=true
@k.boat std.schema.kind of=boat world=drawing acts=make acts=remove
@t.cat core.type of=cat extends=thing closed=true
@k.cat std.schema.kind of=cat world=drawing acts=make acts=remove
@t.dog core.type of=dog extends=thing closed=true
@k.dog std.schema.kind of=dog world=drawing acts=make acts=remove
@t.mountain core.type of=mountain extends=thing closed=true
@k.mountain std.schema.kind of=mountain world=drawing acts=make acts=remove
@t.lake core.type of=lake extends=thing closed=true
@k.lake std.schema.kind of=lake world=drawing acts=make acts=remove
@t.river core.type of=river extends=thing closed=true
@k.river std.schema.kind of=river world=drawing acts=make acts=remove
@t.hill core.type of=hill extends=thing closed=true
@k.hill std.schema.kind of=hill world=drawing acts=make acts=remove
@t.water_lily core.type of=water_lily extends=flower closed=true
@k.water_lily std.schema.kind of=water_lily world=drawing acts=make acts=remove
@t.reed core.type of=reed extends=flower closed=true
@k.reed std.schema.kind of=reed world=drawing acts=make acts=remove
@t.goldfish core.type of=goldfish extends=fish closed=true
@k.goldfish std.schema.kind of=goldfish world=drawing acts=make acts=remove
@t.duck core.type of=duck extends=bird closed=true
@k.duck std.schema.kind of=duck world=drawing acts=make acts=remove
@h.make std.schema.honours world=drawing act=make on=kind on=count on=size on=extent on=place on=with on=manner on=layout on=attribute of=picture of=pond of=forest of=garden of="water" of=water_lily of=reed of="duck" of="goldfish" of="flower" of="tree" of="bush" of="butterfly" of="bird" of="cloud" of="sky" of="sun" of="house" of="fish" of="boat" of="cat" of="dog" of="mountain" of="lake" of="river" of="hill"
@h.arrange std.schema.honours world=drawing act=arrange on=layout of=picture of=pond of=forest of=garden
@e.forest k.expect.make thing=forest made_in=drawing unit=part min=5 max=7 typical=6 kinds_min=1 kinds_max=2 layout=free
@e.forest.tree k.expect.part of=forest part=tree group=plant min=5 max=7 typical=6 needed=yes
@as.water std.schema.drawn world=drawing kind=water as=lake
@as.water_lily std.schema.drawn world=drawing kind="water lily" as=flower
@as.reed std.schema.drawn world=drawing kind=reed as=flower
@as.goldfish std.schema.drawn world=drawing kind=goldfish as=fish
@as.duck std.schema.drawn world=drawing kind=duck as=bird
@as.bush std.schema.drawn world=drawing kind=bush as=tree
@layer.water std.schema.region world=drawing name=water holds=water holds=lake holds=river holds=fish holds=goldfish holds=duck holds=boat holds=frog holds="water lily" holds=reed
@layer.land std.schema.region world=drawing name=land holds=house holds=tree holds=flower holds=bush holds=grass holds=fence holds=bench holds=stone holds=cat holds=dog holds=mountain holds=hill holds=person holds=car
@layer.sky std.schema.region world=drawing name=sky holds=sun holds=cloud holds=bird holds=butterfly holds=moon holds=rainbow holds=balloon holds=rocket
@wd.woods core.word text=woods means=forest
@wd.picture core.word text=picture text=drawing text=canvas means=picture
@t.page core.type of=page extends=std.schema.thing closed=true
@k.page std.schema.kind of=page world=drawing acts=make
@wd.page core.word text=page text=sheet text=paper means=page
@h.page std.schema.honours world=drawing act=make of=page
@wd.things core.word text=thing text=things text=items means=part
# The door (reviewer 2026-11-15 16:40): the wholes whose requests this world plans through the library. Read by src/dialog/request.mjs doorWholes.
@door psys2.door world=drawing whole=pond whole=forest whole=garden
# The session timeline (reviewer 2026-11-15 19:05): the world's own undo and redo, the operations the door calls for the acts undo / redo of k.actions (src/dialog/request.mjs actOperation).
@op.undo psys2.op world=drawing act=undo op=drawUndo
@op.redo psys2.op world=drawing act=redo op=drawRedo
# A whole the world makes with an operation of its own, not by a plan of parts: a new page is the board's fresh sheet (the old one stays for undo).
@op.page psys2.op world=drawing act=make of=page op=newDrawing
# Acts on the things that are there (spec 28 section 12): what each honours, and the one operation of the world that carries them out (the door resolves the things and the roles).
@k.picture std.schema.kind of=picture world=drawing acts=make acts=remove
@h.place std.schema.honours world=drawing act=place on=place of=thing of=picture
@h.change std.schema.honours world=drawing act=change on=attribute on=size of=thing of=picture
@h.remove std.schema.honours world=drawing act=remove of=thing of=picture
@wd.colour core.word text=color text=colour means=colour
# TOOL BINDING (spec 28 section 12; reviewer 2026-11-15 20:45; sopworld 0.152.1 std.tool): the board's primitives with their typed parameters (std.tool.op / std.tool.param), the act of a
# plan step bound to one primitive with its arguments' sources (std.tool.bind / std.tool.arg), the preconditions (needs=) and the effect on the view (makes / removes / changes).
# The library's runPlan fills the arguments (said, revised, the plan's values, the expectations below), translates a value the parameter does not take by knowledge (tiny -> small by
# k.expect.scale; a water lily -> a flower by std.schema.drawn), checks, calls the primitive (worlds/art.draw/engine.mjs: no words, no defaults) and reads the view before and after.
@tool core.use world=std.tool
# A scene (a pond, a forest, a garden: a picture) is a whole the library plans with its parts (k.expect.make / k.expect.part of the catalog, by join; the structure operators
# keep it when a count is revised): the whole is a scene of the board (startScene), each part is drawn in it (addThings whole<-step.in), and an act on the scene is an act on its things.
@op.scene std.tool.op name=startScene world=drawing param=kind param=place effect=makes doc="a scene: the whole its things are drawn in (they stand together)"
@b.scene std.tool.bind world=drawing act=make of=pond of=forest of=garden op=startScene arg=kind<-step.kind arg=place<-step.place makes=thing
@op.add std.tool.op name=addThings world=drawing param=kind param=n param=size param=colour param=place param=anchor param=whole effect=makes doc="draw n things of a kind of the board"
@pa.add.kind std.tool.param op=addThings name=kind type=thing required=true accepts=house accepts=tree accepts=sun accepts=cloud accepts=flower accepts=cat accepts=dog accepts=fish accepts=bird accepts=boat accepts=mountain accepts=hill accepts=lake accepts=river accepts=butterfly
@pa.add.n std.tool.param op=addThings name=n kind=integer min=1 max=12 default=1
@pa.add.size std.tool.param op=addThings name=size type=k.expect.scale by=step accepts=small accepts=default accepts=big
@b.add std.tool.bind world=drawing act=make of=thing op=addThings makes=thing
@a.add.kind std.tool.arg bind=$b.add param=kind from=step.kind
@a.add.n std.tool.arg bind=$b.add param=n from=step.count
@a.add.size std.tool.arg bind=$b.add param=size from=step.size
@a.add.colour std.tool.arg bind=$b.add param=colour from=step.colour
@a.add.place std.tool.arg bind=$b.add param=place from=step.place
@a.add.anchor std.tool.arg bind=$b.add param=anchor from=custom.thingAt
@a.add.whole std.tool.arg bind=$b.add param=whole from=step.in
@op.sky std.tool.op name=paintSky world=drawing param=colour effect=makes doc="the sky band behind everything, in a colour"
@b.sky std.tool.bind world=drawing act=make of=sky op=paintSky arg=colour<-step.colour makes=thing
@op.remove std.tool.op name=removeThings world=drawing param=ids effect=removes
@b.remove std.tool.bind world=drawing act=remove of=thing op=removeThings arg=ids<-step.things needs=exists(ids) removes=ids
@b.remove.scene std.tool.bind world=drawing act=remove of=picture op=removeThings arg=ids<-step.things
@op.move std.tool.op name=moveThings world=drawing param=ids param=place param=anchor effect=changes
@c.thingAt std.tool.custom name=thingAt world=drawing kind=search in=place out=anchor doc="the newest thing of the kind a place names (next to it)"
@b.move std.tool.bind world=drawing act=place of=thing op=moveThings arg=ids<-step.things arg=place<-step.place arg=anchor<-custom.thingAt needs=exists(ids)
@b.move.scene std.tool.bind world=drawing act=place of=picture op=moveThings arg=ids<-step.things arg=place<-step.place arg=anchor<-custom.thingAt needs=exists(ids)
@op.set std.tool.op name=setThings world=drawing param=ids param=colour param=size effect=changes
@pa.set.size std.tool.param op=setThings name=size type=k.expect.scale by=step accepts=small accepts=default accepts=big
@b.set std.tool.bind world=drawing act=change of=thing op=setThings arg=ids<-step.things arg=colour<-step.colour arg=size<-step.size needs=exists(ids)
@b.set.scene std.tool.bind world=drawing act=change of=picture op=setThings arg=ids<-step.things arg=colour<-step.colour arg=size<-step.size needs=exists(ids)
# What the acts on the things that are there honour (the library's reference step resolves the things by kind, the values said before the kind, "it" / "them")
@h.remove.kind std.schema.honours world=drawing act=remove on=kind on=count on=attribute of=thing
@h.change.kind std.schema.honours world=drawing act=change on=kind on=attribute on=size of=thing
@h.place.kind std.schema.honours world=drawing act=place on=kind on=place of=thing
# Defaults are expectations (k.expect.value ... when.), chosen by the library and said in `assumed`
@x.small.place k.expect.value of=thing on=place value=corner when.size=small about="a small thing goes in a corner"
@x.sky.colour k.expect.value of=sky on=colour value=blue about="the sky is blue unless said"
