@t.art.draw.a01 core.test
    input="Draw a red house."
    expect="a red house"
    expectState="objects.length=1"
    expectState="objects.0.kind=house"
    expectState="objects.0.color=red"
    expectState="objects.0.x=500"
    expectState="objects.0.size=240"
    expectState="canvas.w=1000"
    expectState="canvas.h=700"
    session=a

