# Variants of kinds and materials (authored). A variant (k.objects.stand_in: "a storm cloud", "a sports car", "an oak
# tree", "a brick house") is drawn by the object of its kind, named after itself, in the variant's colour, at its scale
# of the size the kind gets, and of its material. A material (k.styles.material: wooden, glass, metal, brick, stone,
# thatch, tiles, water) is shown by the colour, fill, opacity and gradient the knowledge gives it, on a whole thing or
# on one part. No variant or material is named here.

# --- Variants -------------------------------------------------------------------------------------------------------
# A catalog make by a variant's name: the kind it is drawn as stands for it in placement and size (ui.draw.as), and the
# make draws that kind.
@vr.req app.act.request operation="drawing.catalog.make" name=?v
@vr.si k.objects.stand_in name=?v drawing=?d
@vr.known k.objects.object name=?d
@vr.own k.objects.object name=?v
@vr.as.o ui.draw.as kind=?v as=?d
@variant.as core.rule when=$vr.req when=$vr.si not=$vr.own then=$vr.as.o
@vr.t ui.draw.target x=?x y=?y size=?s
@vr.next ui.draw.next top=?top
@vr.nz core.calc out=?nz fn=add args=?top args=1
@vr.code core.calc out=?code fn=concat args=o args=?nz
@vr.scaled k.objects.stand_in name=?v scale=?k
@vr.anyscale k.objects.stand_in name=?v scale=?anyk
@vr.ss core.calc out=?ss fn=mul args=?s args=?k
@vr.make app.act.call act=make kind=w.drawing.object code=?code drawing=?d x=?x y=?y size=?s z=?nz name=?v order=1 ref=new.object
@vr.make.s app.act.call act=make kind=w.drawing.object code=?code drawing=?d x=?x y=?y size=?ss z=?nz name=?v order=1 ref=new.object
@variant.make core.rule when=$vr.req when=$vr.si not=$vr.own when=$vr.known not=$vr.anyscale when=$vr.t when=$vr.next with=$vr.nz with=$vr.code then=$vr.make
@variant.make.scaled core.rule when=$vr.req when=$vr.si not=$vr.own when=$vr.known when=$vr.scaled when=$vr.t when=$vr.next with=$vr.nz with=$vr.code with=$vr.ss then=$vr.make.s
@vr.sel app.act.view key=selected value=?code
@variant.select core.rule when=$vr.req when=$vr.si not=$vr.own when=$vr.known when=$vr.t when=$vr.next with=$vr.nz with=$vr.code then=$vr.sel
@vr.c k.objects.stand_in name=?v colour=?c
@vr.asked.c app.act.request color=?anyc
@vr.c.arg app.act.arg call=new.object attr=colour value=?c
@variant.colour core.rule when=$vr.req when=$vr.si not=$vr.own when=$vr.c not=$vr.asked.c then=$vr.c.arg
@vr.mat k.objects.stand_in name=?v material=?m
@vr.mat.o ui.draw.materialof target=new.object material=?m
@variant.material core.rule when=$vr.req when=$vr.si not=$vr.own when=$vr.mat then=$vr.mat.o
# A thing on the page becomes another variant of its kind, or another kind (drawing.object.change variant=: "let the
# car be a sports car"): it is drawn as the variant's kind, named after it, in its colour, at its scale.
@vc.req app.act.request operation="drawing.object.change" variant=?v
@vc.item app.act.item param="ids" value=?id
@vc.o w.drawing.object code=?id size=?s
@vc.si k.objects.stand_in name=?v drawing=?d
@vc.dr app.act.call act=change thing=$vc.o attr=drawing value=?d order=1
@vc.nm app.act.call act=change thing=$vc.o attr=name value=?v order=2
@change.variant.drawing core.rule when=$vc.req when=$vc.item when=$vc.o when=$vc.si then=$vc.dr
@change.variant.name core.rule when=$vc.req when=$vc.item when=$vc.o when=$vc.si then=$vc.nm
@vc.c k.objects.stand_in name=?v colour=?c
@vc.cc app.act.call act=change thing=$vc.o attr=colour value=?c order=3
@change.variant.colour core.rule when=$vc.req when=$vc.item when=$vc.o when=$vc.si when=$vc.c then=$vc.cc
@vc.k k.objects.stand_in name=?v scale=?k
@vc.ks core.calc out=?ns fn=mul args=?s args=?k
@vc.kc app.act.call act=change thing=$vc.o attr=size value=?ns order=4
@change.variant.scale core.rule when=$vc.req when=$vc.item when=$vc.o when=$vc.si when=$vc.k with=$vc.ks then=$vc.kc
@vc.mat k.objects.stand_in name=?v material=?m
@vc.mat.o ui.draw.materialof target=$vc.o material=?m
@change.variant.material core.rule when=$vc.req when=$vc.item when=$vc.o when=$vc.si when=$vc.mat then=$vc.mat.o
@vc.obj k.objects.object name=?v
@vc.obj.dr app.act.call act=change thing=$vc.o attr=drawing value=?v order=1
@change.variant.kind core.rule when=$vc.req when=$vc.item when=$vc.o not=$vc.si when=$vc.obj then=$vc.obj.dr
@vc.none app.act.refuse reason=variant-not-known
@vc.anysi k.objects.stand_in name=?v
@change.variant.unknown core.rule when=$vc.req not=$vc.anysi not=$vc.obj then=$vc.none

# --- Materials ------------------------------------------------------------------------------------------------------
# A material named by its name or one of its words (core.word ... of=k.styles.material.name), on a thing made, a thing
# changed (material=) or one part (drawing.part.change material=).
@vm.mat.type core.type of=ui.draw.materialof
@vm.name.type core.type of=ui.draw.materialname
@vm.req app.act.request material=?w
@vm.own k.styles.material name=?w
@vm.own.o ui.draw.materialname word=?w material=?w
@material.name.own core.rule when=$vm.req when=$vm.own then=$vm.own.o
@vm.word core.word text=?w means=?m of=k.styles.material.name
@vm.word.o ui.draw.materialname word=?w material=?m
@material.name.word core.rule when=$vm.req not=$vm.own when=$vm.word then=$vm.word.o
@vm.none.n ui.draw.materialname word=?w
@vm.refuse app.act.refuse reason=material-not-known
@material.unknown core.rule when=$vm.req not=$vm.none.n then=$vm.refuse
@vm.named ui.draw.materialname material=?m
@vm.make app.act.request operation="drawing.object.make"
@vm.cat app.act.request operation="drawing.catalog.make"
@vm.mk.o ui.draw.materialof target=new.object material=?m
@material.make core.rule when=$vm.make when=$vm.named then=$vm.mk.o
@material.make.catalog core.rule when=$vm.cat when=$vm.named then=$vm.mk.o
@vm.chg app.act.request operation="drawing.object.change"
@vm.item app.act.item param="ids" value=?id
@vm.o w.drawing.object code=?id
@vm.chg.o ui.draw.materialof target=$vm.o material=?m
@material.change core.rule when=$vm.chg when=$vm.item when=$vm.o when=$vm.named then=$vm.chg.o
# A material on a thing: its colour, its fill, its opacity and the colour its gradient ends in.
@vm.of ui.draw.materialof target=?t material=?m
@vm.k.c k.styles.material name=?m colour=?c
@vm.k.f k.styles.material name=?m fill=?f
@vm.k.o k.styles.material name=?m opacity=?op
@vm.k.g k.styles.material name=?m gradient=?g
@vm.c.call app.act.call act=change thing=?t attr=colour value=?c order=5
@vm.f.call app.act.call act=change thing=?t attr=fill value=?f order=6
@vm.o.call app.act.call act=change thing=?t attr=opacity value=?op order=7
@vm.g.call app.act.call act=change thing=?t attr=gradient value=?g order=8
@material.colour core.rule when=$vm.of when=$vm.k.c then=$vm.c.call
@material.fill core.rule when=$vm.of when=$vm.k.f then=$vm.f.call
@material.opacity core.rule when=$vm.of when=$vm.k.o then=$vm.o.call
@material.gradient core.rule when=$vm.of when=$vm.k.g then=$vm.g.call
# A material on one part of a thing (the roof thatched, the walls brick): the part's colour and opacity (a part takes no
# fill of its own: its colour is the material's).
@vp.req app.act.request operation="drawing.part.change" id=?id index=?i
@vp.o w.drawing.object code=?id
@vp.edit w.drawing.part object=$vp.o index=?i
@vp.c.call app.act.call act=change thing=$vp.edit attr=colour value=?c order=5
@vp.o.call app.act.call act=change thing=$vp.edit attr=opacity value=?op order=6
@material.part.colour core.rule when=$vp.req when=$vp.o when=$vp.edit when=$vm.named when=$vm.k.c then=$vp.c.call
@material.part.opacity core.rule when=$vp.req when=$vp.o when=$vp.edit when=$vm.named when=$vm.k.o then=$vp.o.call
@vm.opt.k k.styles.material name=?m
@vm.opt.o app.observe.option id=material value=?m
@draw.option.material core.rule when=$vm.opt.k then=$vm.opt.o
