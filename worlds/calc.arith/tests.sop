# calc.arith (kids plan, ADR-011, K4): sums with the catalog's words of arithmetic and the library's core.calc builtins. The k. rows are the sum rows of kids.arith
# that the general world answers (kids.arith keeps its own rows while it is on).

@t.calc.arith.n1 core.test
    input="What is 7 plus 5?"
    expect="7 plus 5 is 12."

@t.calc.arith.n2 core.test
    input="Share 12 between 3."
    expect="12 divided by 3 is 4."

@t.calc.arith.n3 core.test
    doc="A split verb with the marker from names the second number first."
    input="Subtract 4 from 10."
    expect="10 minus 4 is 6."

@t.calc.arith.n4 core.test
    input="What is a quarter of 12?"
    expect="A quarter of 12 is 3."

@t.calc.arith.n5 core.test
    doc="Refused (kids.arith answers it while it is on, calc.arith when it is off: both say so)."
    input="What is 5 divided by 0?"
    expect="Dividing by zero has no answer"

@t.calc.arith.k.n25 core.test
    input="What is 7 plus 5?"
    expect="7 plus 5 is 12."

@t.calc.arith.k.n26 core.test
    input="How much is 3 times 4?"
    expect="3 times 4 is 12."

