@legend.core core.legend
    namespace=core
    version=0.1.0
    doc="Bootstrap legend: the types and keys every other legend builds on. Dynamic keys: a core.key with dynamic=true declares a key prefix; a wire may use any key of the form <prefix>.<anything> (for example where.owner or arg.count on core.question and core.request). The part after the prefix is resolved against the wire type named by the question, and the value kind is any."

@core.thing core.type
    doc="Root of the type hierarchy; any wire without an explicit parent extends it."

@core.state core.type
    extends=core.thing
    doc="A fact that holds at some time: something has a property or relation."

@core.event core.type
    extends=core.thing
    doc="Something that happens; events are ordered by core.seq in dialog order."

@core.agent core.type
    extends=core.thing
    doc="A person or participant that can be mentioned in dialog."
    example="Tom"

@core.question core.type
    extends=core.thing
    doc="A question about a wire type: type, seek, optional where.<key> constraints (see the legend doc), mode."

@core.answer core.type
    extends=core.thing
    doc="The result of resolving a question or request, written by the interpreter."

@core.request core.type
    extends=core.thing
    doc="A request to run an action operation: action and optional arg.<name> arguments (see the legend doc)."

@core.legend core.type
    extends=core.thing
    doc="A legend: namespace, version, imports."

@core.type core.type
    extends=core.thing
    doc="A type declaration."

@core.key core.type
    extends=core.thing
    doc="A key declaration."

@core.world core.type
    extends=core.thing
    doc="A world manifest."

@core.pattern core.type
    extends=core.thing
    doc="A rule-formalizer pattern."

@core.operation core.type
    extends=core.thing
    doc="An operation declaration."

@core.template core.type
    extends=core.thing
    doc="An answer rendering template."

@core.test core.type
    extends=core.thing
    doc="A competency test."

@core.lexicon core.type
    extends=core.thing
    doc="A word list."

@core.note core.type
    extends=core.thing
    doc="A free-text note (SOP Lang v1 has no comments)."

@core.source core.key
    value=string
    card=one
    ask="Where does this come from?"
    scope=global

@core.in core.key
    value=any
    card=one
    ask="In which context?"
    scope=global

@core.from core.key
    value=any
    card=many
    ask="Which wires support this?"
    scope=global

@core.via core.key
    value=any
    card=one
    ask="Which operation or pattern produced this?"
    scope=global

@core.seq core.key
    value=integer
    card=one
    ask="In which order did this happen?"
    scope=global

@core.status core.key
    value=atom
    card=one
    ask="What is the status?"
    scope=global

@core.agent.name core.key
    value=string
    card=one
    ask="What is the name?"
    required=true

@core.agent.gender core.key
    value=atom
    card=one
    ask="Is the agent male (m) or female (f)?"

@core.question.type core.key
    value=atom
    card=one
    ask="Which wire type is asked about?"
    required=true

@core.question.seek core.key
    value=atom
    card=one
    ask="Which key is sought?"

@core.question.where core.key
    value=any
    card=many
    ask="Which constraints apply?"
    dynamic=true

@core.question.about core.key
    value=any
    card=one
    ask="Which wire is asked about?"

@core.question.mode core.key
    value=atom
    card=one
    ask="value, exists, list or count?"

@core.answer.to core.key
    value=any
    card=one
    ask="Which question or request is answered?"
    required=true

@core.answer.value core.key
    value=any
    card=many
    ask="What is the value?"

@core.answer.unit core.key
    value=atom
    card=one
    ask="What is the unit?"

@core.answer.alternative core.key
    value=any
    card=many
    ask="Which alternative values exist?"

@core.answer.missing core.key
    value=atom
    card=many
    ask="Which keys are missing?"

@core.answer.note core.key
    value=string
    card=one
    ask="Is there a note?"

@core.request.action core.key
    value=atom
    card=one
    ask="Which action is requested?"
    required=true

@core.request.arg core.key
    value=any
    card=many
    ask="Which arguments are given?"
    dynamic=true

@core.legend.namespace core.key
    value=atom
    card=one
    ask="Which namespace does the legend define?"
    required=true

@core.legend.version core.key
    value=atom
    card=one
    ask="Which version?"

@core.legend.imports core.key
    value=atom
    card=many
    ask="Which namespaces are imported?"

@core.legend.doc core.key
    value=string
    card=one
    ask="What is it about?"

@core.type.extends core.key
