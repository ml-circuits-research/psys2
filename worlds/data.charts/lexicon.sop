@lex.data.charts.types core.lexicon
    class=noun
    doc="Chart types as people say them (Chart.js: bar, line, pie, doughnut, radar, polarArea, scatter)"
    word=bar
    word=line
    word=pie
    word=doughnut
    word=donut
    word=radar
    word=polar_area
    word=polar
    word=scatter
    plural=pie:pies

