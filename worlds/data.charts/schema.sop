@chart acts.schema
    noun="chart"
    doc="Charts as a schema (spec 21): a chart holds bars (points, slices) with a label and a value; a chart has a type, a title, an axis, colours, a legend, an order. Chart.js draws the state (chart.mjs: the renderer, the data readers of what people have, prices, lists and legs, the statistics); the schema only says what is said."
    hooks=hooks.mjs
    own=fromHoldings:chart.fromHoldings
    own=fromPrices:chart.fromPrices
    own=fromLegs:chart.fromLegs
    own=fromList:chart.fromList
    own=refresh:chart.refresh
    own=extreme:chart.extreme
    own=total:chart.total
    own=average:chart.average
    own=difference:chart.difference
    own=compare:chart.compare
    own=percent:chart.percent
    own=read:chart.read
    own=download:chart.download
    own=downloadData:chart.downloadData
    own=copyData:chart.copyData
    own=describe:chart.describe
    own=options:chart.options
    own=listCharts:chart.listCharts
    own=valueOf:chart.valueOf
    own=countItems:chart.countItems
    own=toDocument:chart.toDocument
    own=toDocumentData:chart.toDocumentData
    own=setValues:chart.setValues
    own=view:data.charts.view
    own=adopt:data.charts.adopt
    own=chartUndo:chart.undo
    own=chartRedo:chart.redo
    sample=chart
    thing=charts:chart:::active=active
    list=yes
    say=yes
    scale=yes
    clear=yes
    opencolour=yes
    valued=yes
    ordered=yes
    acts=make
    acts=remove
    acts=change
    acts=pick
    acts=ask
    acts=copy
    acts=send
    acts=undo
    acts=redo
    limit.items=200
    limit.history=30

@chart.chart acts.kind
    dice.not=make
    know=charts:*
    plural=charts
    numbered=yes
    word=graph
    word=graphs
    word=plot
    word=plots
    word=diagram

@chart.point acts.kind
    know=bars:*
    dice.not=make
    plural=points
    named=yes
    in=chart
    word=bar
    word=bars
    word=slice
    word=slices
    word=column
    word=columns
    word=segment
    word=dot
    word=item
    word=items

@chart.type acts.attr
    of=chart
    type=enum
    values=bar
    values=line
    values=pie
    values=doughnut
    values=donut
    values=radar
    values=polar_area
    values=polar
    values=scatter

@chart.title acts.attr
    of=chart
    type=text
    word=heading

@chart.axis acts.attr
    of=chart
    type=enum
    values=horizontal
    values=vertical
    values=sideways
    values=sideway
    values=upright
    values=lie_down
    word=orientation

@chart.value acts.attr
    of=point
    type=number
    min=0
    default=0
    more=bigger
    less=smaller
    word=number
    word=size
    word=count
    word=amount

@chart.label acts.attr
    of=point
    type=text
    word=name

@chart.colour acts.attr
    of=chart
    of=point
    type=colour
    word=color
    word=colors
    word=colours

@chart.legend acts.attr
    of=chart
    type=bool

@chart.stacked acts.attr
    of=chart
    type=bool
    word=stacking
    word=stacked

@chart.sort acts.attr
    of=chart
    type=enum
    values=desc
    values=asc
    values=alpha
    values=none
    word=order

@chart.palette acts.attr
    of=chart
    type=enum
    values=rainbow
    values=pastel
    values=ocean
    values=forest
    values=sunset
    values=warm
    values=cool
    values=neon
    values=earth
    values=different
    values=differently
    values=default
