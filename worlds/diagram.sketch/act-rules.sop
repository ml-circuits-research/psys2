@a.sr.miss app.act.refuse reason=missing-target
@remove.selection.nodes.missing core.rule when=$a.sr.r when=$a.sr.ni not=$a.sr.nn then=$a.sr.miss
@remove.selection.links.missing core.rule when=$a.sr.r when=$a.sr.li not=$a.sr.le then=$a.sr.miss
