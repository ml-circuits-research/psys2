@a.cg.gtv core.calc out=?gt fn=concat args=?d args=" " args=?suf
@a.cg.it.gv ui.diagram.citem n=?i1 label=?gt value=?v
@chart.item.dimension.values core.rule when=$a.cg.r when=$a.cg.dim when=$a.cg.li when=$a.cg.vi not=$a.cg.isnamed if=$a.cg.ok with=$a.cg.i1 when=$a.cg.kcv then=$a.cg.it.kv
@chart.item.dimension.values.beyond core.rule when=$a.cg.r when=$a.cg.dim when=$a.cg.li when=$a.cg.vi not=$a.cg.isnamed if=$a.cg.ok with=$a.cg.i1 when=$a.cg.anykc not=$a.cg.kcno then=$a.cg.it
@chart.item.dimension.values.named core.rule when=$a.cg.r when=$a.cg.dim when=$a.cg.li when=$a.cg.vi not=$a.cg.isnamed if=$a.cg.ok with=$a.cg.i1 not=$a.cg.anykc when=$a.cg.gnv with=$a.cg.gtv then=$a.cg.it.gv
@chart.item.dimension.values.named.beyond core.rule when=$a.cg.r when=$a.cg.dim when=$a.cg.li when=$a.cg.vi not=$a.cg.isnamed if=$a.cg.ok with=$a.cg.i1 not=$a.cg.anykc not=$a.cg.gno then=$a.cg.it
@a.cg.anyv app.act.item param="values" n=?anyvn
@a.cg.anyl app.act.item param="labels" n=?anyln
@a.cg.sm ui.diagram.csample n=?sn value=?sv
