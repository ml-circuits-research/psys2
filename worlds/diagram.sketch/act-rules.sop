# diagram.sketch act rules (authored). Each native Diagram command compiles to std.acts calls on the w.diagram
# instance (worlds/sop-world-host.mjs only runs them) or to an explicit refusal. Nodes, edges and groups are
# addressed by their code. Removing a node removes its edges and memberships (std.acts removes what refers to a thing).
# Where a node goes is not stored: render-projection.sop lays the instance out, unless a node or group was pinned.
@dga.next.type core.type of=ui.diagram.next
@dga.count.type core.type of=ui.diagram.count
@dga.many.type core.type of=ui.diagram.many
@dga.nodeop.type core.type of=ui.diagram.nodeop
@dga.edgeop.type core.type of=ui.diagram.edgeop
@dga.groupop.type core.type of=ui.diagram.groupop
@dga.refusal.type core.type of=ui.diagram.refusal
@dga.closed.type core.type of=ui.diagram.closed
@dga.arranged.type core.type of=ui.diagram.arranged
@dga.centre.type core.type of=ui.diagram.centre
@dga.made.type core.type of=ui.diagram.made

# How many things one command may make, one per number.
@count.1 ui.diagram.count i=1
@count.2 ui.diagram.count i=2
@count.3 ui.diagram.count i=3
@count.4 ui.diagram.count i=4
@count.5 ui.diagram.count i=5
@count.6 ui.diagram.count i=6
@count.7 ui.diagram.count i=7
@count.8 ui.diagram.count i=8
@count.9 ui.diagram.count i=9
@count.10 ui.diagram.count i=10
@count.11 ui.diagram.count i=11
@count.12 ui.diagram.count i=12

# The next numbers: after the highest node, edge and group so far (codes n<k>, e<k>, g<k>).
@a.nx.n w.diagram.node n=?z
@a.nx.n.out ui.diagram.next of=node top=?top
@next.node core.aggregate over=$a.nx.n max=?top args=?z default=0 then=$a.nx.n.out
@a.nx.e w.diagram.edge n=?z
@a.nx.e.out ui.diagram.next of=edge top=?top
@next.edge core.aggregate over=$a.nx.e max=?top args=?z default=0 then=$a.nx.e.out
@a.nx.g w.diagram.group n=?z
@a.nx.g.out ui.diagram.next of=group top=?top
@next.group core.aggregate over=$a.nx.g max=?top args=?z default=0 then=$a.nx.g.out

# ---- Nodes ----
# Make n nodes of a shape (1 when n is not given), each with the label, colour and size the command gives; at x, y
# (pinned, the next ones 140 to the right) when it gives a place; in a row, column or grid when it gives that layout
# (an arrangement: a group drawn without its frame), or a circle (radial: the same ring). A tree or layers is the
# diagram's own layout.
@a.mn.r app.act.request operation="diagram.node.make" n=?k
@a.mn.o ui.diagram.many k=?k
@many.given core.rule when=$a.mn.r then=$a.mn.o
@a.m1.r app.act.request operation="diagram.node.make"
@a.m1.has app.act.request n=?anyn
@a.m1.o ui.diagram.many k=1
@many.one core.rule when=$a.m1.r not=$a.m1.has then=$a.m1.o
@dga.mkshape.type core.type of=ui.diagram.mkshape
@a.ms.k app.act.request operation="diagram.node.make" kind=?kind
@a.ms.o ui.diagram.mkshape shape=?kind
@make.shape.kind core.rule when=$a.ms.k then=$a.ms.o
@a.ms.r app.act.request operation="diagram.node.make" role=?role
@a.ms.anyk app.act.request operation="diagram.node.make" kind=?anyk
@a.ms.ks k.diagrams.shape kind=flowchart role=?role shape=?rs
@a.ms.ro ui.diagram.mkshape shape=?rs
@make.shape.role core.rule when=$a.ms.r when=$a.ms.ks not=$a.ms.anyk then=$a.ms.ro
@a.ms.any app.act.request operation="diagram.node.make"
@a.ms.anyrole app.act.request operation="diagram.node.make" role=?anyrole
@a.ms.rect ui.diagram.mkshape shape=rectangle
@make.shape.default core.rule when=$a.ms.any not=$a.ms.anyk not=$a.ms.anyrole then=$a.ms.rect
@make.shape.role.unknown core.rule when=$a.ms.r not=$a.ms.anyk not=$a.ms.ks then=$a.ms.rect
@a.mk.req app.act.request operation="diagram.node.make"
@a.mk.shape ui.diagram.mkshape shape=?kind
@a.mk.k ui.diagram.many k=?k
@a.mk.i ui.diagram.count i=?i
@a.mk.le core.check fn=lte args=?i args=?k
@a.mk.nx ui.diagram.next of=node top=?top
@a.mk.z core.calc out=?z fn=add args=?top args=?i
@a.mk.code core.calc out=?code fn=concat args=n args=?z
@a.mk.ref core.calc out=?ref fn=concat args="new.node." args=?i
@a.mk.call app.act.call act=make kind=w.diagram.node code=?code shape=?kind n=?z order=1 ref=?ref
@make.node core.rule when=$a.mk.req when=$a.mk.shape when=$a.mk.k when=$a.mk.i when=$a.mk.nx if=$a.mk.le with=$a.mk.z with=$a.mk.code with=$a.mk.ref then=$a.mk.call
@a.mk.made ui.diagram.made ref=?ref i=?i
@made.node core.rule when=$a.mk.req when=$a.mk.shape when=$a.mk.k when=$a.mk.i when=$a.mk.nx if=$a.mk.le with=$a.mk.z with=$a.mk.code with=$a.mk.ref then=$a.mk.made
@a.ma.m ui.diagram.made ref=?ref i=?i
@a.ma.label.r app.act.request operation="diagram.node.make" label=?v
@a.ma.label.a app.act.arg call=?ref attr=label value=?v
@make.node.label core.rule when=$a.ma.m when=$a.ma.label.r then=$a.ma.label.a
@a.ma.colour.r app.act.request operation="diagram.node.make" colour=?v
@a.ma.colour.a app.act.arg call=?ref attr=colour value=?v
@make.node.colour core.rule when=$a.ma.m when=$a.ma.colour.r then=$a.ma.colour.a
@a.ma.size.r app.act.request operation="diagram.node.make" size=?v
@a.ma.size.a app.act.arg call=?ref attr=size value=?v
@make.node.size core.rule when=$a.ma.m when=$a.ma.size.r then=$a.ma.size.a
@a.ma.outline.r app.act.request operation="diagram.node.make" outline=?v
@a.ma.outline.a app.act.arg call=?ref attr=outline value=?v
@make.node.outline core.rule when=$a.ma.m when=$a.ma.outline.r then=$a.ma.outline.a
@a.ma.text.r app.act.request operation="diagram.node.make" textColour=?v
@a.ma.text.a app.act.arg call=?ref attr=text_colour value=?v
@make.node.text core.rule when=$a.ma.m when=$a.ma.text.r then=$a.ma.text.a
@a.ma.role.r app.act.request operation="diagram.node.make" role=?v
@a.ma.role.a app.act.arg call=?ref attr=role value=?v
@make.node.role core.rule when=$a.ma.m when=$a.ma.role.r then=$a.ma.role.a
# The label's weight and style (catalog w.diagram.node font_weight, font_style): bold, italic, or both.
@a.ma.fweight.r app.act.request operation="diagram.node.make" fontWeight=?v
@a.ma.fweight.a app.act.arg call=?ref attr=font_weight value=?v
@make.node.fontweight core.rule when=$a.ma.m when=$a.ma.fweight.r then=$a.ma.fweight.a
@a.ma.fstyle.r app.act.request operation="diagram.node.make" fontStyle=?v
@a.ma.fstyle.a app.act.arg call=?ref attr=font_style value=?v
@make.node.fontstyle core.rule when=$a.ma.m when=$a.ma.fstyle.r then=$a.ma.fstyle.a
# A picture's image and caption, a table's rows and columns (catalog w.diagram.node source, caption, rows, columns).
@a.ma.source.r app.act.request operation="diagram.node.make" source=?v
@a.ma.source.a app.act.arg call=?ref attr=source value=?v
@make.node.source core.rule when=$a.ma.m when=$a.ma.source.r then=$a.ma.source.a
@a.ma.caption.r app.act.request operation="diagram.node.make" caption=?v
@a.ma.caption.a app.act.arg call=?ref attr=caption value=?v
@make.node.caption core.rule when=$a.ma.m when=$a.ma.caption.r then=$a.ma.caption.a
@a.ma.rows.r app.act.request operation="diagram.node.make" rows=?v
@a.ma.rows.a app.act.arg call=?ref attr=rows value=?v
@make.node.rows core.rule when=$a.ma.m when=$a.ma.rows.r then=$a.ma.rows.a
@a.ma.columns.r app.act.request operation="diagram.node.make" columns=?v
@a.ma.columns.a app.act.arg call=?ref attr=columns value=?v
@make.node.columns core.rule when=$a.ma.m when=$a.ma.columns.r then=$a.ma.columns.a
# A table's cell texts (`cells`, in reading order: along the first row, then the next), each a w.diagram.cell of the
# table made; the columns are the said ones, else 3. More texts than cells is refused.
@dga.tcols.type core.type of=ui.diagram.tcols
@a.tc.r app.act.request operation="diagram.node.make" columns=?k
@a.tc.o ui.diagram.tcols request=make cols=?k
@table.make.cols core.rule when=$a.tc.r then=$a.tc.o
@a.tc.r0 app.act.request operation="diagram.node.make"
@a.tc.any app.act.request columns=?anyk
@a.tc.o3 ui.diagram.tcols request=make cols=3
@table.make.cols.default core.rule when=$a.tc.r0 not=$a.tc.any then=$a.tc.o3
@a.mc.m ui.diagram.made ref=?ref
@a.mc.r app.act.request operation="diagram.node.make"
@a.mc.k ui.diagram.tcols request=make cols=?k
@a.mc.i app.act.item param="cells" n=?i value=?t
@a.mc.row1 core.calc out=?r0 fn=idiv args=?i args=?k
@a.mc.row core.calc out=?row fn=add args=?r0 args=1
@a.mc.col1 core.calc out=?c0 fn=mod args=?i args=?k
@a.mc.col core.calc out=?col fn=add args=?c0 args=1
@a.mc.call app.act.call act=make kind=w.diagram.cell node=?ref row=?row column=?col text=?t order=2
@make.table.cell core.rule when=$a.mc.m when=$a.mc.r when=$a.mc.k when=$a.mc.i with=$a.mc.row1 with=$a.mc.row with=$a.mc.col1 with=$a.mc.col then=$a.mc.call
@a.mc.rows app.act.request operation="diagram.node.make" rows=?rs
@a.mc.over core.check fn=gt args=?row args=?rs
@a.mc.refuse app.act.refuse reason=table-cells-beyond-rows
@make.table.cells.over core.rule when=$a.mc.r when=$a.mc.rows when=$a.mc.k when=$a.mc.i with=$a.mc.row1 with=$a.mc.row if=$a.mc.over then=$a.mc.refuse
@a.mc.norows app.act.request rows=?anyrs
@a.mc.over3 core.check fn=gt args=?row args=3
@make.table.cells.over.default core.rule when=$a.mc.r not=$a.mc.norows when=$a.mc.k when=$a.mc.i with=$a.mc.row1 with=$a.mc.row if=$a.mc.over3 then=$a.mc.refuse
@a.ma.xy.r app.act.request operation="diagram.node.make" x=?x y=?y
@a.ma.xy.i0 core.calc out=?i0 fn=sub args=?i args=1
@a.ma.xy.dx core.calc out=?dx fn=mul args=?i0 args=140
@a.ma.xy.x core.calc out=?px fn=add args=?x args=?dx
@a.ma.xy.ax app.act.arg call=?ref attr=x value=?px
@a.ma.xy.ay app.act.arg call=?ref attr=y value=?y
@a.ma.xy.ap app.act.arg call=?ref attr=pinned value=true
@make.node.x core.rule when=$a.ma.m when=$a.ma.xy.r with=$a.ma.xy.i0 with=$a.ma.xy.dx with=$a.ma.xy.x then=$a.ma.xy.ax
@make.node.y core.rule when=$a.ma.m when=$a.ma.xy.r then=$a.ma.xy.ay
@make.node.pinned core.rule when=$a.ma.m when=$a.ma.xy.r then=$a.ma.xy.ap
@a.ma.lay.r app.act.request operation="diagram.node.make" layout=?l
@a.ma.lay.a ui.diagram.arranged layout=?l
@a.ma.g.nx ui.diagram.next of=group top=?top
@a.ma.g.z core.calc out=?z fn=add args=?top args=1
@a.ma.g.code core.calc out=?code fn=concat args=g args=?z
@a.ma.g.call app.act.call act=make kind=w.diagram.group code=?code n=?z layout=?l framed=false order=2 ref=new.group
@a.ma.mem.call app.act.call act=make kind=w.diagram.member group=new.group node=?ref order=3
@arranged core.rule when=$a.ma.lay.r then=$a.ma.lay.a
@a.ma.lay.ok ui.diagram.arranged layout=?l
@a.ma.lay.set core.check fn=matches args=?l args="^(row|column|grid)$"
@make.arrangement core.rule when=$a.mk.req when=$a.ma.lay.ok when=$a.ma.g.nx if=$a.ma.lay.set with=$a.ma.g.z with=$a.ma.g.code then=$a.ma.g.call
@a.ma.g.ring app.act.call act=make kind=w.diagram.group code=?code n=?z layout=circle framed=false order=2 ref=new.group
@make.arrangement.member core.rule when=$a.ma.m when=$a.ma.lay.ok if=$a.ma.lay.set then=$a.ma.mem.call
@a.ma.lay.ring core.check fn=matches args=?l args="^(circle|radial)$"
@make.arrangement.ring core.rule when=$a.mk.req when=$a.ma.lay.ok when=$a.ma.g.nx if=$a.ma.lay.ring with=$a.ma.g.z with=$a.ma.g.code then=$a.ma.g.ring
@make.arrangement.ring.member core.rule when=$a.ma.m when=$a.ma.lay.ok if=$a.ma.lay.ring then=$a.ma.mem.call

# The commands that name nodes by `ids`, and a refusal when one of them is not a node of the diagram.
@nodeop.change ui.diagram.nodeop operation="diagram.node.change"
@nodeop.select ui.diagram.nodeop operation="diagram.node.select"
@nodeop.remove ui.diagram.nodeop operation="diagram.node.remove"
@nodeop.place ui.diagram.nodeop operation="diagram.node.place"
@nodeop.resize ui.diagram.nodeop operation="diagram.node.resize"
@nodeop.layout ui.diagram.nodeop operation="diagram.node.layout"
@nodeop.group ui.diagram.nodeop operation="diagram.group.make"
@a.mt.r app.act.request operation=?op
@a.mt.op ui.diagram.nodeop operation=?op
@a.mt.i app.act.item param="ids" value=?id
@a.mt.n w.diagram.node code=?id
@a.mt.out app.act.refuse reason=missing-target
@missing.node core.rule when=$a.mt.r when=$a.mt.op when=$a.mt.i not=$a.mt.n then=$a.mt.out
@a.it.i app.act.item param="ids" value=?id
@a.it.n w.diagram.node code=?id

# Change colour, size, label, value, shape (the command's `kind`, as the node was made), outline, text colour, font
# size and weight or role; a change that names none of them is refused.
@a.cn.colour.r app.act.request operation="diagram.node.change" colour=?v
@a.cn.colour.c app.act.call act=change thing=$a.it.n attr=colour value=?v order=1
@change.node.colour core.rule when=$a.cn.colour.r when=$a.it.i when=$a.it.n then=$a.cn.colour.c
@a.cn.size.r app.act.request operation="diagram.node.change" size=?v
@a.cn.size.c app.act.call act=change thing=$a.it.n attr=size value=?v order=1
@change.node.size core.rule when=$a.cn.size.r when=$a.it.i when=$a.it.n then=$a.cn.size.c
@a.cn.label.r app.act.request operation="diagram.node.change" label=?v
@a.cn.label.c app.act.call act=change thing=$a.it.n attr=label value=?v order=1
@change.node.label core.rule when=$a.cn.label.r when=$a.it.i when=$a.it.n then=$a.cn.label.c
@a.cn.value.r app.act.request operation="diagram.node.change" value=?v
@a.cn.value.c app.act.call act=change thing=$a.it.n attr=value value=?v order=1
@change.node.value core.rule when=$a.cn.value.r when=$a.it.i when=$a.it.n then=$a.cn.value.c
@a.cn.kind.r app.act.request operation="diagram.node.change" kind=?v
@a.cn.kind.c app.act.call act=change thing=$a.it.n attr=shape value=?v order=1
@change.node.kind core.rule when=$a.cn.kind.r when=$a.it.i when=$a.it.n then=$a.cn.kind.c
@a.cn.outline.r app.act.request operation="diagram.node.change" outline=?v
@a.cn.outline.c app.act.call act=change thing=$a.it.n attr=outline value=?v order=1
@change.node.outline core.rule when=$a.cn.outline.r when=$a.it.i when=$a.it.n then=$a.cn.outline.c
@a.cn.text.r app.act.request operation="diagram.node.change" textColour=?v
@a.cn.text.c app.act.call act=change thing=$a.it.n attr=text_colour value=?v order=1
@change.node.text core.rule when=$a.cn.text.r when=$a.it.i when=$a.it.n then=$a.cn.text.c
@a.cn.fsize.r app.act.request operation="diagram.node.change" fontSize=?v
@a.cn.fsize.c app.act.call act=change thing=$a.it.n attr=font_size value=?v order=1
@change.node.fontsize core.rule when=$a.cn.fsize.r when=$a.it.i when=$a.it.n then=$a.cn.fsize.c
@a.cn.fweight.r app.act.request operation="diagram.node.change" fontWeight=?v
@a.cn.fweight.c app.act.call act=change thing=$a.it.n attr=font_weight value=?v order=1
@change.node.fontweight core.rule when=$a.cn.fweight.r when=$a.it.i when=$a.it.n then=$a.cn.fweight.c
@a.cn.fstyle.r app.act.request operation="diagram.node.change" fontStyle=?v
@a.cn.fstyle.c app.act.call act=change thing=$a.it.n attr=font_style value=?v order=1
@change.node.fontstyle core.rule when=$a.cn.fstyle.r when=$a.it.i when=$a.it.n then=$a.cn.fstyle.c
@a.cn.role.r app.act.request operation="diagram.node.change" role=?v
@a.cn.role.c app.act.call act=change thing=$a.it.n attr=role value=?v order=1
@change.node.role core.rule when=$a.cn.role.r when=$a.it.i when=$a.it.n then=$a.cn.role.c
@a.cn.effect.r app.act.request operation="diagram.node.change" effect=?v
@a.cn.effect.c app.act.call act=change thing=$a.it.n attr=effect value=?v order=1
@change.node.effect core.rule when=$a.cn.effect.r when=$a.it.i when=$a.it.n then=$a.cn.effect.c
@a.cn.opacity.r app.act.request operation="diagram.node.change" opacity=?v
@a.cn.opacity.c app.act.call act=change thing=$a.it.n attr=opacity value=?v order=1
@change.node.opacity core.rule when=$a.cn.opacity.r when=$a.it.i when=$a.it.n then=$a.cn.opacity.c
@a.cn.corner.r app.act.request operation="diagram.node.change" corner=?v
@a.cn.corner.c app.act.call act=change thing=$a.it.n attr=corner value=?v order=1
@change.node.corner core.rule when=$a.cn.corner.r when=$a.it.i when=$a.it.n then=$a.cn.corner.c
@a.cn.rotation.r app.act.request operation="diagram.node.change" rotation=?v
@a.cn.rotation.c app.act.call act=change thing=$a.it.n attr=rotation value=?v order=1
@change.node.rotation core.rule when=$a.cn.rotation.r when=$a.it.i when=$a.it.n then=$a.cn.rotation.c
@a.cn.source.r app.act.request operation="diagram.node.change" source=?v
@a.cn.source.c app.act.call act=change thing=$a.it.n attr=source value=?v order=1
@change.node.source core.rule when=$a.cn.source.r when=$a.it.i when=$a.it.n then=$a.cn.source.c
@a.cn.caption.r app.act.request operation="diagram.node.change" caption=?v
@a.cn.caption.c app.act.call act=change thing=$a.it.n attr=caption value=?v order=1
@change.node.caption core.rule when=$a.cn.caption.r when=$a.it.i when=$a.it.n then=$a.cn.caption.c
@a.cn.rows.r app.act.request operation="diagram.node.change" rows=?v
@a.cn.rows.c app.act.call act=change thing=$a.it.n attr=rows value=?v order=1
@change.node.rows core.rule when=$a.cn.rows.r when=$a.it.i when=$a.it.n then=$a.cn.rows.c
@a.cn.columns.r app.act.request operation="diagram.node.change" columns=?v
@a.cn.columns.c app.act.call act=change thing=$a.it.n attr=columns value=?v order=1
@change.node.columns core.rule when=$a.cn.columns.r when=$a.it.i when=$a.it.n then=$a.cn.columns.c
# A table's cell texts changed (`cells` in reading order, over the table's columns: its own, else 3): a cell with a
# text takes the new one, one without gets one.
@a.tcc.r app.act.request operation="diagram.node.change"
@a.tcc.i app.act.item param="cells" n=?i value=?t
@a.tcc.id app.act.item param="ids" value=?id
@a.tcc.n w.diagram.node code=?id
@a.tcc.own w.diagram.node code=?id columns=?k
@a.tcc.anyk w.diagram.node code=?id columns=?anyk
@a.tcc.req app.act.request operation="diagram.node.change" columns=?k
@a.tcc.anyreq app.act.request columns=?anyrk
@a.tcc.ko ui.diagram.tcols request=?id cols=?k
@a.tcc.k3 ui.diagram.tcols request=?id cols=3
@table.change.cols.said core.rule when=$a.tcc.r when=$a.tcc.id when=$a.tcc.n when=$a.tcc.req then=$a.tcc.ko
@table.change.cols.own core.rule when=$a.tcc.r when=$a.tcc.id when=$a.tcc.own not=$a.tcc.anyreq then=$a.tcc.ko
@table.change.cols.default core.rule when=$a.tcc.r when=$a.tcc.id when=$a.tcc.n not=$a.tcc.anyk not=$a.tcc.anyreq then=$a.tcc.k3
@a.tcc.k ui.diagram.tcols request=?id cols=?k
@a.tcc.row1 core.calc out=?r0 fn=idiv args=?i args=?k
@a.tcc.row core.calc out=?row fn=add args=?r0 args=1
@a.tcc.col1 core.calc out=?c0 fn=mod args=?i args=?k
@a.tcc.col core.calc out=?col fn=add args=?c0 args=1
@a.tcc.cell w.diagram.cell node=$a.tcc.n row=?row column=?col
@a.tcc.set app.act.call act=change thing=$a.tcc.cell attr=text value=?t order=2
@change.table.cell core.rule when=$a.tcc.r when=$a.tcc.i when=$a.tcc.id when=$a.tcc.n when=$a.tcc.k with=$a.tcc.row1 with=$a.tcc.row with=$a.tcc.col1 with=$a.tcc.col when=$a.tcc.cell then=$a.tcc.set
@a.tcc.mk app.act.call act=make kind=w.diagram.cell node=$a.tcc.n row=?row column=?col text=?t order=2
@change.table.cell.new core.rule when=$a.tcc.r when=$a.tcc.i when=$a.tcc.id when=$a.tcc.n when=$a.tcc.k with=$a.tcc.row1 with=$a.tcc.row with=$a.tcc.col1 with=$a.tcc.col not=$a.tcc.cell then=$a.tcc.mk
