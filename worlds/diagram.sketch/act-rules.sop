@link.make core.rule when=$a.lk.r when=$a.lk.a when=$a.lk.b when=$a.lk.nx not=$a.lk.same with=$a.lk.z with=$a.lk.code then=$a.lk.c
@a.lk.made app.act.call act=make kind=w.diagram.edge
@a.lk.lab app.act.request operation="diagram.link.make" label=?v
@a.lk.lab.a app.act.arg call=new.edge attr=label value=?v
@link.make.label core.rule when=$a.lk.lab when=$a.lk.made then=$a.lk.lab.a
@a.lk.col app.act.request operation="diagram.link.make" colour=?v
@a.lk.col.a app.act.arg call=new.edge attr=colour value=?v
@link.make.colour core.rule when=$a.lk.col when=$a.lk.made then=$a.lk.col.a
@a.lk.sty app.act.request operation="diagram.link.make" style=?v
@a.lk.sty.a app.act.arg call=new.edge attr=style value=?v
@link.make.style core.rule when=$a.lk.sty when=$a.lk.made then=$a.lk.sty.a
@a.lk.arr app.act.request operation="diagram.link.make" arrow=?v
@a.lk.arr.a app.act.arg call=new.edge attr=direction value=?v
@link.make.arrow core.rule when=$a.lk.arr when=$a.lk.made then=$a.lk.arr.a
@a.lk.dup app.act.refuse reason=link-exists
@link.make.twice core.rule when=$a.lk.r when=$a.lk.a when=$a.lk.b when=$a.lk.same then=$a.lk.dup
@a.lk.miss app.act.refuse reason=missing-endpoint
@a.lk.ra app.act.request operation="diagram.link.make" from=?a
@a.lk.ma w.diagram.node code=?a
@link.make.no.from core.rule when=$a.lk.ra not=$a.lk.ma then=$a.lk.miss
@a.lk.rb app.act.request operation="diagram.link.make" to=?b
@a.lk.mb w.diagram.node code=?b
@link.make.no.to core.rule when=$a.lk.rb not=$a.lk.mb then=$a.lk.miss

