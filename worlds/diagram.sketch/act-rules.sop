@chart.item.said.label core.rule when=$a.cg.r when=$a.cg.li not=$a.cg.anyv not=$a.cg.iscount if=$a.cg.ok with=$a.cg.i1 with=$a.cg.sm.n with=$a.cg.sm.n1 when=$a.cg.sm then=$a.cg.it.s
@a.cg.dim app.act.request operation="diagram.group.chart.make" dimension=?d
@a.cg.kc k.charts.category dimension=?d n=?n label=?kt
@a.cg.anykc k.charts.category dimension=?d n=?anykn
@a.cg.ks ui.diagram.csample n=?n value=?kv
