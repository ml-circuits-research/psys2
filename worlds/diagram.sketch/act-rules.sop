@chart.sample.2 ui.diagram.csample n=2 value=35
@chart.sample.3 ui.diagram.csample n=3 value=28
@chart.sample.4 ui.diagram.csample n=4 value=51
@chart.sample.5 ui.diagram.csample n=5 value=19
@chart.sample.6 ui.diagram.csample n=6 value=33
@chart.sample.7 ui.diagram.csample n=7 value=47
@chart.sample.8 ui.diagram.csample n=8 value=24
