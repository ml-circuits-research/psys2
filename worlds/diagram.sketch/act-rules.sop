@observe.group.values core.rule when=$a.og.vm when=$a.og.vn not=$a.og.vnn then=$a.og.vo
@observe.group.values.ordered core.rule when=$a.og.vm when=$a.og.vnn then=$a.og.vno

@a.sp.n ui.diagram.nbox node=?id x0=?x0 y0=?y0 x1=?x1 y1=?y1
