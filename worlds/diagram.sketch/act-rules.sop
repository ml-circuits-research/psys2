@chart.binx.17 ui.diagram.cbinx k=17
@chart.binx.18 ui.diagram.cbinx k=18
@chart.binx.19 ui.diagram.cbinx k=19
@a.bn.r app.act.request operation="diagram.group.chart.make" bins=?nb
@a.bn.ci ui.diagram.citem n=?n value=?v
@a.bn.lo ui.diagram.cstat key=lo value=?m
@chart.bins.low core.aggregate over=$a.bn.r over=$a.bn.ci by=?nb min=?m args=?v then=$a.bn.lo
@a.bn.hi ui.diagram.cstat key=hi value=?m
@chart.bins.high core.aggregate over=$a.bn.r over=$a.bn.ci by=?nb max=?m args=?v then=$a.bn.hi
@a.bn.l ui.diagram.cstat key=lo value=?lo
@a.bn.h ui.diagram.cstat key=hi value=?hi
@a.bn.span core.calc out=?sp fn=sub args=?hi args=?lo
@a.bn.sp1 core.calc out=?sp1 fn=max args=?sp args=1
@a.bn.w core.calc out=?w fn=div args=?sp1 args=?nb
@a.bn.d core.calc out=?d fn=sub args=?v args=?lo
@a.bn.b0 core.calc out=?b0 fn=idiv args=?d args=?w
@a.bn.nb1 core.calc out=?nb1 fn=sub args=?nb args=1
@a.bn.b core.calc out=?b fn=min args=?b0 args=?nb1
@a.bn.out ui.diagram.cbin n=?n k=?b
@chart.bins.record core.rule when=$a.cg.r when=$a.bn.r when=$a.bn.ci when=$a.bn.l when=$a.bn.h with=$a.bn.span with=$a.bn.sp1 with=$a.bn.w with=$a.bn.d with=$a.bn.b0 with=$a.bn.nb1 with=$a.bn.b then=$a.bn.out
@a.bn.rec ui.diagram.cbin n=?n k=?k
@a.bn.cnt ui.diagram.cagg label=?k key=bin value=?c
@chart.bins.count core.aggregate over=$a.bn.rec by=?k count=?c then=$a.bn.cnt
@a.bn.x ui.diagram.cbinx k=?k
@a.bn.inr core.check fn=lt args=?k args=?nb
@a.bn.k1 core.calc out=?k1 fn=add args=?k args=1
@a.bn.blo1 core.calc out=?blo1 fn=mul args=?k args=?w
@a.bn.blo2 core.calc out=?blo2 fn=add args=?lo args=?blo1
@a.bn.blo core.calc out=?blo fn=round args=?blo2 args=2
@a.bn.bhi1 core.calc out=?bhi1 fn=mul args=?k1 args=?w
@a.bn.bhi2 core.calc out=?bhi2 fn=add args=?lo args=?bhi1
@a.bn.bhi core.calc out=?bhi fn=round args=?bhi2 args=2
@a.bn.lab core.calc out=?blab fn=concat args=?blo args="–" args=?bhi
@a.bn.c ui.diagram.cagg label=?k key=bin value=?bc
@a.bn.anyc ui.diagram.cagg label=?k key=bin value=?anybc
@a.bn.cat ui.diagram.ccat n=?k1 label=?blab value=?bc
@a.bn.cat0 ui.diagram.ccat n=?k1 label=?blab value=0
@chart.bins.category core.rule when=$a.cg.r when=$a.bn.r when=$a.bn.x if=$a.bn.inr when=$a.bn.l when=$a.bn.h with=$a.bn.span with=$a.bn.sp1 with=$a.bn.w with=$a.bn.k1 with=$a.bn.blo1 with=$a.bn.blo2 with=$a.bn.blo with=$a.bn.bhi1 with=$a.bn.bhi2 with=$a.bn.bhi with=$a.bn.lab when=$a.bn.c then=$a.bn.cat
@chart.bins.category.empty core.rule when=$a.cg.r when=$a.bn.r when=$a.bn.x if=$a.bn.inr when=$a.bn.l when=$a.bn.h with=$a.bn.span with=$a.bn.sp1 with=$a.bn.w with=$a.bn.k1 with=$a.bn.blo1 with=$a.bn.blo2 with=$a.bn.blo with=$a.bn.bhi1 with=$a.bn.bhi2 with=$a.bn.bhi with=$a.bn.lab not=$a.bn.anyc then=$a.bn.cat0
# Only the categories `only` names; only the largest `top`, those above `above`, those below `below`.
@a.cg.ci ui.diagram.ccat n=?n label=?t value=?v
@a.cg.drop ui.diagram.cdrop n=?n
@a.cg.onlyany app.act.item param="only" n=?anyon
@a.cg.onlyt app.act.item param="only" value=?t
@chart.item.only core.rule when=$a.cg.r when=$a.cg.onlyany when=$a.cg.ci not=$a.cg.onlyt then=$a.cg.drop
@a.cg.top app.act.request operation="diagram.group.chart.make" top=?k
@a.cg.rk core.rank of=$a.cg.ci by=value order=desc out=?r
@a.cg.over core.check fn=gt args=?r args=?k
@chart.item.top core.rule when=$a.cg.r when=$a.cg.top when=$a.cg.ci with=$a.cg.rk if=$a.cg.over then=$a.cg.drop
@a.cg.ab app.act.request operation="diagram.group.chart.make" above=?lim
@a.cg.notab core.check fn=lte args=?v args=?lim
@chart.item.above core.rule when=$a.cg.r when=$a.cg.ab when=$a.cg.ci if=$a.cg.notab then=$a.cg.drop
@a.cg.be app.act.request operation="diagram.group.chart.make" below=?blim
@a.cg.notbe core.check fn=gte args=?v args=?blim
@chart.item.below core.rule when=$a.cg.r when=$a.cg.be when=$a.cg.ci if=$a.cg.notbe then=$a.cg.drop
# The order of the categories kept: where they were said, or sorted (`sort`: ascending, descending, label).
@a.cg.kept ui.diagram.ccat n=?n label=?t value=?v
@a.cg.dropped ui.diagram.cdrop n=?n
@a.cg.anysort app.act.request sort=?anysort
@a.cg.ord ui.diagram.corder n=?n pos=?n
@chart.order.said core.rule when=$a.cg.r when=$a.cg.kept not=$a.cg.dropped not=$a.cg.anysort then=$a.cg.ord
@a.cg.so.asc app.act.request operation="diagram.group.chart.make" sort=ascending
@a.cg.so.desc app.act.request operation="diagram.group.chart.make" sort=descending
@a.cg.so.lab app.act.request operation="diagram.group.chart.make" sort=label
@dga.ckept.type core.type of=ui.diagram.ckept
@a.cg.kf ui.diagram.ckept n=?n label=?t value=?v
@chart.kept core.rule when=$a.cg.r when=$a.cg.kept not=$a.cg.dropped then=$a.cg.kf
@a.cg.kk ui.diagram.ckept n=?n label=?t value=?v
@a.cg.rka core.rank of=$a.cg.kk by=value out=?p
@a.cg.rkd core.rank of=$a.cg.kk by=value order=desc out=?p
@a.cg.rkl core.rank of=$a.cg.kk by=label out=?p
@a.cg.ordp ui.diagram.corder n=?n pos=?p
@chart.order.ascending core.rule when=$a.cg.r when=$a.cg.so.asc when=$a.cg.kk with=$a.cg.rka then=$a.cg.ordp
@chart.order.descending core.rule when=$a.cg.r when=$a.cg.so.desc when=$a.cg.kk with=$a.cg.rkd then=$a.cg.ordp
@chart.order.label core.rule when=$a.cg.r when=$a.cg.so.lab when=$a.cg.kk with=$a.cg.rkl then=$a.cg.ordp
# One rectangle node per category kept, a member of the new group, in that order.
@a.cg.keep ui.diagram.ckept n=?n label=?t value=?v
@a.cg.kpos ui.diagram.corder n=?n pos=?pos
@a.cg.nnx ui.diagram.next of=node top=?ntop
@a.cg.nz core.calc out=?nz fn=add args=?ntop args=?pos
@a.cg.ncode core.calc out=?ncode fn=concat args=n args=?nz
@a.cg.ref core.calc out=?ref fn=concat args="new.node." args=?n
@a.cg.n app.act.call act=make kind=w.diagram.node code=?ncode shape=rectangle label=?t value=?v n=?nz order=1 ref=?ref
@chart.make.node core.rule when=$a.cg.r when=$a.cg.keep when=$a.cg.kpos when=$a.cg.nnx with=$a.cg.nz with=$a.cg.ncode with=$a.cg.ref then=$a.cg.n
@a.cg.mem app.act.call act=make kind=w.diagram.member group=new.group node=?ref order=3
@chart.make.member core.rule when=$a.cg.r when=$a.cg.keep when=$a.cg.kpos when=$a.cg.nnx with=$a.cg.nz with=$a.cg.ncode with=$a.cg.ref then=$a.cg.mem
# Errors said with the values (`errors`, in the order of the values): the error of the category made from that record.
@a.cg.er app.act.item param="errors" n=?ei value=?e
@a.cg.ei1 core.calc out=?n fn=add args=?ei args=1
@a.cg.eref core.calc out=?eref fn=concat args="new.node." args=?n
@a.cg.ekept ui.diagram.ckept n=?n
@a.cg.earg app.act.arg call=?eref attr=error value=?e
@chart.make.error core.rule when=$a.cg.r when=$a.cg.er with=$a.cg.ei1 when=$a.cg.ekept with=$a.cg.eref then=$a.cg.earg
@a.cg.lab.v app.act.item param="labels" n=?i
@a.cg.val.v app.act.item param="values" n=?i
@a.cg.unpaired app.act.refuse reason=invalid-chart-data
@chart.make.unpaired.label core.rule when=$a.cg.r when=$a.cg.lab.v when=$a.cg.anyv not=$a.cg.val.v not=$a.cg.iscount then=$a.cg.unpaired
@a.cg.lab.w app.act.item param="labels" n=?j
@a.cg.val.w app.act.item param="values" n=?j
@a.cg.binsd app.act.request operation="diagram.group.chart.make" bins=?binsd
@chart.make.unpaired.value core.rule when=$a.cg.r when=$a.cg.val.w not=$a.cg.lab.w not=$a.cg.binsd then=$a.cg.unpaired
# Values said alone for a histogram are its records.
@a.cg.bv app.act.item param="values" n=?i value=?v
@a.cg.bvi core.calc out=?i1 fn=add args=?i args=1
@a.cg.bvo ui.diagram.citem n=?i1 label=?i1 value=?v
@chart.item.bins.values core.rule when=$a.cg.r when=$a.cg.binsd when=$a.cg.bv not=$a.cg.anyl with=$a.cg.bvi then=$a.cg.bvo
# What the chart shows: its dimension (the x axis title), its measure and aggregate (the y axis title: "average sales",
# "number of stadiums"), and that its values are a sample when none were said.
@chart.agg.count ui.diagram.aggword aggregate=count prefix="number of " alone="count"
@chart.agg.sum ui.diagram.aggword aggregate=sum prefix="total " alone="total"
@chart.agg.avg ui.diagram.aggword aggregate=avg prefix="average " alone="average"
@chart.agg.min ui.diagram.aggword aggregate=min prefix="minimum " alone="minimum"
@chart.agg.max ui.diagram.aggword aggregate=max prefix="maximum " alone="maximum"
@a.cg.dx app.act.arg call=new.group attr=x_label value=?d
@a.cg.dd app.act.arg call=new.group attr=dimension value=?d
@chart.make.dimension.title core.rule when=$a.cg.r when=$a.cg.dim if=$a.cg.ok then=$a.cg.dx
@chart.make.dimension core.rule when=$a.cg.r when=$a.cg.dim if=$a.cg.ok then=$a.cg.dd
@a.cg.ms app.act.request operation="diagram.group.chart.make" measure=?m
@a.cg.ag app.act.request operation="diagram.group.chart.make" aggregate=?ag
@a.cg.anyag app.act.request aggregate=?anyag
@a.cg.anyms app.act.request measure=?anyms
@a.cg.aw ui.diagram.aggword aggregate=?ag prefix=?pre alone=?alone
@a.cg.my app.act.arg call=new.group attr=y_label value=?m
@a.cg.mm app.act.arg call=new.group attr=measure value=?m
@a.cg.am app.act.arg call=new.group attr=aggregate value=?ag
@a.cg.amt core.calc out=?amt fn=concat args=?pre args=?m
@a.cg.amy app.act.arg call=new.group attr=y_label value=?amt
@a.cg.aay app.act.arg call=new.group attr=y_label value=?alone
@chart.make.measure core.rule when=$a.cg.r when=$a.cg.ms if=$a.cg.ok then=$a.cg.mm
@chart.make.measure.title core.rule when=$a.cg.r when=$a.cg.ms not=$a.cg.anyag if=$a.cg.ok then=$a.cg.my
@chart.make.aggregate core.rule when=$a.cg.r when=$a.cg.ag if=$a.cg.ok then=$a.cg.am
@chart.make.aggregate.title core.rule when=$a.cg.r when=$a.cg.ag when=$a.cg.ms when=$a.cg.aw if=$a.cg.ok with=$a.cg.amt then=$a.cg.amy
@chart.make.aggregate.alone core.rule when=$a.cg.r when=$a.cg.ag when=$a.cg.aw not=$a.cg.anyms if=$a.cg.ok then=$a.cg.aay
@a.cg.smp app.act.arg call=new.group attr=sample value=true
@chart.make.sample.labels core.rule when=$a.cg.r not=$a.cg.anyl if=$a.cg.ok then=$a.cg.smp
@chart.make.sample.values core.rule when=$a.cg.r not=$a.cg.anyv if=$a.cg.ok then=$a.cg.smp

# Charts of the data.charts composition (diagram.group.chart, diagram.group.chart.adopt and the composed chart.*
# commands) are not part of this area's instance: refused, never simulated.
@a.cc.r app.act.request operation=?op
@a.cc.chart core.check fn=matches args=?op args="^(chart[.]|diagram[.]group[.]chart$|diagram[.]group[.]chart[.]adopt$)"
@a.cc.out app.act.refuse reason=chart-composition-not-in-area
@chart.composition core.rule when=$a.cc.r if=$a.cc.chart then=$a.cc.out

# ---- What a reader observes, and the geometry placement reads ----
@a.ob.n w.diagram.node code=?id shape=?k
@a.ob.b ui.diagram.nbox node=?id cx=?x cy=?y w=?w h=?h
@a.ob.sel ui.diagram.picked id=?id
@a.ob.out app.observe.object id=?id kind=?k sourceType=diagram.sketch.node binding=diagram.node x=?x y=?y width=?w height=?h selected=false
@a.ob.out.sel app.observe.object id=?id kind=?k sourceType=diagram.sketch.node binding=diagram.node x=?x y=?y width=?w height=?h selected=true
# A category of a chart is observed as a chart point (chart-shape.sop), not as a free node.
@a.ob.cp ui.diagram.cpoint node=?id
@observe.node core.rule when=$a.ob.n when=$a.ob.b not=$a.ob.sel not=$a.ob.cp then=$a.ob.out
@observe.node.selected core.rule when=$a.ob.n when=$a.ob.b when=$a.ob.sel not=$a.ob.cp then=$a.ob.out.sel
@a.oi.label w.diagram.node code=?id label=?v
@a.oi.label.o app.observe.input id=?id key=label value=?v
@observe.node.label core.rule when=$a.oi.label then=$a.oi.label.o
@a.oi.colour w.diagram.node code=?id colour=?v
@a.oi.colour.o app.observe.input id=?id key=colour value=?v
@observe.node.colour core.rule when=$a.oi.colour then=$a.oi.colour.o
@a.oi.size w.diagram.node code=?id size=?v
@a.oi.size.o app.observe.input id=?id key=size value=?v
@observe.node.size core.rule when=$a.oi.size then=$a.oi.size.o
@a.oi.value w.diagram.node code=?id value=?v
@a.oi.value.o app.observe.input id=?id key=value value=?v
@observe.node.value core.rule when=$a.oi.value then=$a.oi.value.o
@a.oi.group ui.diagram.inside node=?id group=?g
@a.oi.group.o app.observe.input id=?id key=group value=?g
@observe.node.group core.rule when=$a.oi.group then=$a.oi.group.o
# A picture's image and caption, a table's rows and columns.
@a.oi.source w.diagram.node code=?id source=?v
@a.oi.source.o app.observe.input id=?id key=source value=?v
@observe.node.source core.rule when=$a.oi.source then=$a.oi.source.o
@a.oi.caption w.diagram.node code=?id caption=?v
@a.oi.caption.o app.observe.input id=?id key=caption value=?v
@observe.node.caption core.rule when=$a.oi.caption then=$a.oi.caption.o
@a.oi.rows w.diagram.node code=?id rows=?v
@a.oi.rows.o app.observe.input id=?id key=rows value=?v
@observe.node.rows core.rule when=$a.oi.rows then=$a.oi.rows.o
@a.oi.columns w.diagram.node code=?id columns=?v
@a.oi.columns.o app.observe.input id=?id key=columns value=?v
@observe.node.columns core.rule when=$a.oi.columns then=$a.oi.columns.o
@a.oe.e w.diagram.edge code=?id from=$a.oe.a to=$a.oe.b
@a.oe.a w.diagram.node code=?a
@a.oe.b w.diagram.node code=?b
@a.oe.sel ui.diagram.picked id=?id
@a.oe.out app.observe.object id=?id kind=link sourceType=diagram.sketch.link binding=diagram.link from=?a to=?b selected=false
@a.oe.out.sel app.observe.object id=?id kind=link sourceType=diagram.sketch.link binding=diagram.link from=?a to=?b selected=true
@observe.link core.rule when=$a.oe.e when=$a.oe.a when=$a.oe.b not=$a.oe.sel then=$a.oe.out
@observe.link.selected core.rule when=$a.oe.e when=$a.oe.a when=$a.oe.b when=$a.oe.sel then=$a.oe.out.sel
@a.oe.label w.diagram.edge code=?id label=?v
@a.oe.label.o app.observe.input id=?id key=label value=?v
@observe.link.label core.rule when=$a.oe.label then=$a.oe.label.o
@a.oe.colour w.diagram.edge code=?id colour=?v
@a.oe.colour.o app.observe.input id=?id key=colour value=?v
@observe.link.colour core.rule when=$a.oe.colour then=$a.oe.colour.o
@a.oe.style w.diagram.edge code=?id style=?v
@a.oe.style.o app.observe.input id=?id key=style value=?v
@observe.link.style core.rule when=$a.oe.style then=$a.oe.style.o
@a.oe.arrow w.diagram.edge code=?id direction=?v
@a.oe.arrow.o app.observe.input id=?id key=arrow value=?v
@observe.link.arrow core.rule when=$a.oe.arrow then=$a.oe.arrow.o
@a.oe.width w.diagram.edge code=?id width=?v
@a.oe.width.o app.observe.input id=?id key=width value=?v
@observe.link.width core.rule when=$a.oe.width then=$a.oe.width.o
@a.og.g w.diagram.group code=?id label=?label
@a.og.u ui.diagram.unit unit=?id kind=group
@a.og.sel app.area.view key=selected value=?id
@a.og.out app.observe.object id=?id kind=group sourceType=diagram.sketch.group binding=diagram.group label=?label selected=false
@a.og.out.sel app.observe.object id=?id kind=group sourceType=diagram.sketch.group binding=diagram.group label=?label selected=true
@observe.group core.rule when=$a.og.g when=$a.og.u not=$a.og.sel then=$a.og.out
@observe.group.selected core.rule when=$a.og.g when=$a.og.u when=$a.og.sel then=$a.og.out.sel
@a.og.layout w.diagram.group code=?id layout=?v
@a.og.layout.o app.observe.input id=?id key=layout value=?v
@observe.group.layout core.rule when=$a.og.layout then=$a.og.layout.o
@a.og.scale w.diagram.group code=?id scale=?v
@a.og.scale.o app.observe.input id=?id key=scale value=?v
@observe.group.scale core.rule when=$a.og.scale then=$a.og.scale.o
@a.og.member ui.diagram.inside group=?id node=?v
@a.og.member.o app.observe.input id=?id key=members value=?v
@observe.group.members core.rule when=$a.og.member then=$a.og.member.o
# A chart group is observed with the values of its members ("what values does Revenue show?"), in the members' order.
@a.og.vn w.diagram.node code=?mv value=?vv
@a.og.vm ui.diagram.inside group=?id node=?mv
