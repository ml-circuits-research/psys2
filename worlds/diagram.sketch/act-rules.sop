# diagram.sketch act rules (authored). Each native Diagram command compiles to std.acts calls on the w.diagram
# instance (worlds/sop-world-host.mjs only runs them) or to an explicit refusal. Nodes, edges and groups are
# addressed by their code. Removing a node removes its edges and memberships (std.acts removes what refers to a thing).
# Where a node goes is not stored: render-projection.sop lays the instance out, unless a node or group was pinned.
@dga.next.type core.type of=ui.diagram.next
@dga.count.type core.type of=ui.diagram.count
@dga.many.type core.type of=ui.diagram.many
@dga.nodeop.type core.type of=ui.diagram.nodeop
@dga.edgeop.type core.type of=ui.diagram.edgeop
@dga.groupop.type core.type of=ui.diagram.groupop
@dga.refusal.type core.type of=ui.diagram.refusal
@dga.closed.type core.type of=ui.diagram.closed
@dga.arranged.type core.type of=ui.diagram.arranged
@dga.centre.type core.type of=ui.diagram.centre
@dga.made.type core.type of=ui.diagram.made

# How many things one command may make, one per number.
@count.1 ui.diagram.count i=1
@count.2 ui.diagram.count i=2
@count.3 ui.diagram.count i=3
@count.4 ui.diagram.count i=4
@count.5 ui.diagram.count i=5
@count.6 ui.diagram.count i=6
@count.7 ui.diagram.count i=7
@count.8 ui.diagram.count i=8
@count.9 ui.diagram.count i=9
@count.10 ui.diagram.count i=10
@count.11 ui.diagram.count i=11
@count.12 ui.diagram.count i=12

# The next numbers: after the highest node, edge and group so far (codes n<k>, e<k>, g<k>).
@a.nx.n w.diagram.node n=?z
@a.nx.n.out ui.diagram.next of=node top=?top
@next.node core.aggregate over=$a.nx.n max=?top args=?z default=0 then=$a.nx.n.out
@a.nx.e w.diagram.edge n=?z
@a.nx.e.out ui.diagram.next of=edge top=?top
@next.edge core.aggregate over=$a.nx.e max=?top args=?z default=0 then=$a.nx.e.out
@a.nx.g w.diagram.group n=?z
@a.nx.g.out ui.diagram.next of=group top=?top
@next.group core.aggregate over=$a.nx.g max=?top args=?z default=0 then=$a.nx.g.out

# ---- Nodes ----
# Make n nodes of a shape (1 when n is not given), each with the label, colour and size the command gives; at x, y
# (pinned, the next ones 140 to the right) when it gives a place; in a row, column or grid when it gives that layout
# (an arrangement: a group drawn without its frame). A tree or layers is the diagram's own layout; a circle or radial
# layout is not declared here.
@a.mn.r app.act.request operation="diagram.node.make" n=?k
@a.mn.o ui.diagram.many k=?k
@many.given core.rule when=$a.mn.r then=$a.mn.o
@a.m1.r app.act.request operation="diagram.node.make"
@a.m1.has app.act.request n=?anyn
@a.m1.o ui.diagram.many k=1
@many.one core.rule when=$a.m1.r not=$a.m1.has then=$a.m1.o
@a.mk.req app.act.request operation="diagram.node.make" kind=?kind
@a.mk.k ui.diagram.many k=?k
@a.mk.i ui.diagram.count i=?i
@a.mk.le core.check fn=lte args=?i args=?k
@a.mk.nx ui.diagram.next of=node top=?top
@a.mk.z core.calc out=?z fn=add args=?top args=?i
@a.mk.code core.calc out=?code fn=concat args=n args=?z
@a.mk.ref core.calc out=?ref fn=concat args="new.node." args=?i
@a.mk.call app.act.call act=make kind=w.diagram.node code=?code shape=?kind n=?z order=1 ref=?ref
@make.node core.rule when=$a.mk.req when=$a.mk.k when=$a.mk.i when=$a.mk.nx if=$a.mk.le with=$a.mk.z with=$a.mk.code with=$a.mk.ref then=$a.mk.call
@a.mk.made ui.diagram.made ref=?ref i=?i
@made.node core.rule when=$a.mk.req when=$a.mk.k when=$a.mk.i when=$a.mk.nx if=$a.mk.le with=$a.mk.z with=$a.mk.code with=$a.mk.ref then=$a.mk.made
@a.ma.m ui.diagram.made ref=?ref i=?i
@a.ma.label.r app.act.request operation="diagram.node.make" label=?v
@a.ma.label.a app.act.arg call=?ref attr=label value=?v
@make.node.label core.rule when=$a.ma.m when=$a.ma.label.r then=$a.ma.label.a
@a.ma.colour.r app.act.request operation="diagram.node.make" colour=?v
@a.ma.colour.a app.act.arg call=?ref attr=colour value=?v
@make.node.colour core.rule when=$a.ma.m when=$a.ma.colour.r then=$a.ma.colour.a
@a.ma.size.r app.act.request operation="diagram.node.make" size=?v
@a.ma.size.a app.act.arg call=?ref attr=size value=?v
@make.node.size core.rule when=$a.ma.m when=$a.ma.size.r then=$a.ma.size.a
@a.ma.xy.r app.act.request operation="diagram.node.make" x=?x y=?y
@a.ma.xy.i0 core.calc out=?i0 fn=sub args=?i args=1
@a.ma.xy.dx core.calc out=?dx fn=mul args=?i0 args=140
@a.ma.xy.x core.calc out=?px fn=add args=?x args=?dx
@a.ma.xy.ax app.act.arg call=?ref attr=x value=?px
@a.ma.xy.ay app.act.arg call=?ref attr=y value=?y
@a.ma.xy.ap app.act.arg call=?ref attr=pinned value=true
@make.node.x core.rule when=$a.ma.m when=$a.ma.xy.r with=$a.ma.xy.i0 with=$a.ma.xy.dx with=$a.ma.xy.x then=$a.ma.xy.ax
@make.node.y core.rule when=$a.ma.m when=$a.ma.xy.r then=$a.ma.xy.ay
@make.node.pinned core.rule when=$a.ma.m when=$a.ma.xy.r then=$a.ma.xy.ap
@a.ma.lay.r app.act.request operation="diagram.node.make" layout=?l
@a.ma.lay.a ui.diagram.arranged layout=?l
@a.ma.g.nx ui.diagram.next of=group top=?top
@a.ma.g.z core.calc out=?z fn=add args=?top args=1
@a.ma.g.code core.calc out=?code fn=concat args=g args=?z
@a.ma.g.call app.act.call act=make kind=w.diagram.group code=?code n=?z layout=?l framed=false order=2 ref=new.group
@a.ma.mem.call app.act.call act=make kind=w.diagram.member group=new.group node=?ref order=3
@arranged core.rule when=$a.ma.lay.r then=$a.ma.lay.a
@a.ma.lay.ok ui.diagram.arranged layout=?l
@a.ma.lay.set core.check fn=matches args=?l args="^(row|column|grid)$"
@make.arrangement core.rule when=$a.mk.req when=$a.ma.lay.ok when=$a.ma.g.nx if=$a.ma.lay.set with=$a.ma.g.z with=$a.ma.g.code then=$a.ma.g.call
@make.arrangement.member core.rule when=$a.ma.m when=$a.ma.lay.ok if=$a.ma.lay.set then=$a.ma.mem.call
@a.ma.lay.no core.check fn=matches args=?l args="^(circle|radial)$"
@a.ma.lay.refuse app.act.refuse reason=layout-not-declared
@make.layout.refused core.rule when=$a.ma.lay.ok if=$a.ma.lay.no then=$a.ma.lay.refuse

# The commands that name nodes by `ids`, and a refusal when one of them is not a node of the diagram.
@nodeop.change ui.diagram.nodeop operation="diagram.node.change"
@nodeop.select ui.diagram.nodeop operation="diagram.node.select"
@nodeop.remove ui.diagram.nodeop operation="diagram.node.remove"
@nodeop.place ui.diagram.nodeop operation="diagram.node.place"
@nodeop.resize ui.diagram.nodeop operation="diagram.node.resize"
@nodeop.layout ui.diagram.nodeop operation="diagram.node.layout"
@nodeop.group ui.diagram.nodeop operation="diagram.group.make"
@a.mt.r app.act.request operation=?op
@a.mt.op ui.diagram.nodeop operation=?op
@a.mt.i app.act.item param="ids" value=?id
@a.mt.n w.diagram.node code=?id
@a.mt.out app.act.refuse reason=missing-target
@missing.node core.rule when=$a.mt.r when=$a.mt.op when=$a.mt.i not=$a.mt.n then=$a.mt.out
@a.it.i app.act.item param="ids" value=?id
@a.it.n w.diagram.node code=?id

# Change colour, size, label, value or shape (the command's `kind`, as the node was made); a change that names none of
# them is refused.
@a.cn.colour.r app.act.request operation="diagram.node.change" colour=?v
@a.cn.colour.c app.act.call act=change thing=$a.it.n attr=colour value=?v order=1
@change.node.colour core.rule when=$a.cn.colour.r when=$a.it.i when=$a.it.n then=$a.cn.colour.c
@a.cn.size.r app.act.request operation="diagram.node.change" size=?v
@a.cn.size.c app.act.call act=change thing=$a.it.n attr=size value=?v order=1
@change.node.size core.rule when=$a.cn.size.r when=$a.it.i when=$a.it.n then=$a.cn.size.c
@a.cn.label.r app.act.request operation="diagram.node.change" label=?v
@a.cn.label.c app.act.call act=change thing=$a.it.n attr=label value=?v order=1
@change.node.label core.rule when=$a.cn.label.r when=$a.it.i when=$a.it.n then=$a.cn.label.c
@a.cn.value.r app.act.request operation="diagram.node.change" value=?v
@a.cn.value.c app.act.call act=change thing=$a.it.n attr=value value=?v order=1
@change.node.value core.rule when=$a.cn.value.r when=$a.it.i when=$a.it.n then=$a.cn.value.c
@a.cn.kind.r app.act.request operation="diagram.node.change" kind=?v
@a.cn.kind.c app.act.call act=change thing=$a.it.n attr=shape value=?v order=1
@change.node.kind core.rule when=$a.cn.kind.r when=$a.it.i when=$a.it.n then=$a.cn.kind.c
@a.cn.none.r app.act.request operation="diagram.node.change"
@a.cn.none.c app.act.request colour=?a1
@a.cn.none.s app.act.request size=?a2
@a.cn.none.l app.act.request label=?a3
@a.cn.none.v app.act.request value=?a4
@a.cn.none.k app.act.request kind=?a5
@a.cn.none.out app.act.refuse reason=missing-property
@change.node.none core.rule when=$a.cn.none.r not=$a.cn.none.c not=$a.cn.none.s not=$a.cn.none.l not=$a.cn.none.v not=$a.cn.none.k then=$a.cn.none.out

# Select nodes (and edges): the view's selection.
@a.sel.n.r app.act.request operation="diagram.node.select"
@a.sel.n.v app.act.view key=selected value=?id
@select.nodes core.rule when=$a.sel.n.r when=$a.it.i when=$a.it.n then=$a.sel.n.v
@a.sel.e.i app.act.item param="edges" value=?id
@a.sel.e.e w.diagram.edge code=?id
@select.nodes.edges core.rule when=$a.sel.n.r when=$a.sel.e.i when=$a.sel.e.e then=$a.sel.n.v
@a.sel.e.miss app.act.refuse reason=missing-target
@select.nodes.edges.missing core.rule when=$a.sel.n.r when=$a.sel.e.i not=$a.sel.e.e then=$a.sel.e.miss
# Selecting no node and no edge clears the selection.
@a.sel.none.i app.act.item param="ids" value=?anyid
@a.sel.none.e app.act.item param="edges" value=?anye
@a.sel.none.v app.act.view key=selected
@select.none core.rule when=$a.sel.n.r not=$a.sel.none.i not=$a.sel.none.e then=$a.sel.none.v

# Several things selected at once: the view's `selected` key holds one of them, and each selected node or edge also
# has its own view key selected.<code>=true. A select command sets the keys of what it names and clears the others
# (a group selection or an empty selection clears them all); removing a node or an edge clears its key.
@dga.pickop.type core.type of=ui.diagram.pickop
@dga.picked.type core.type of=ui.diagram.picked
@dga.thing.type core.type of=ui.diagram.thing
@pickop.nodes ui.diagram.pickop operation="diagram.node.select"
@pickop.links ui.diagram.pickop operation="diagram.link.select"
@pickop.group ui.diagram.pickop operation="diagram.group.select"
@a.th.n w.diagram.node code=?c
@a.th.o ui.diagram.thing code=?c
@thing.node core.rule when=$a.th.n then=$a.th.o
@a.th.e w.diagram.edge code=?c
@thing.edge core.rule when=$a.th.e then=$a.th.o
@a.pk.item app.act.item value=?c
@a.pk.th ui.diagram.thing code=?c
@a.pk.k core.calc out=?k fn=concat args="selected." args=?c
@a.pk.set app.act.view key=?k value=true
@select.many.set core.rule when=$a.unp.r when=$a.unp.op when=$a.pk.item when=$a.pk.th with=$a.pk.k then=$a.pk.set
@a.unp.r app.act.request operation=?op
@a.unp.op ui.diagram.pickop operation=?op
@a.unp.v app.area.view key=?k value=true
@a.unp.th ui.diagram.thing code=?c
@a.unp.k core.calc out=?k2 fn=concat args="selected." args=?c
@a.unp.eq core.check fn=eq args=?k args=?k2
@a.unp.item app.act.item value=?c
@a.unp.out app.act.view key=?k
@select.many.clear core.rule when=$a.unp.r when=$a.unp.op when=$a.unp.v when=$a.unp.th not=$a.unp.item with=$a.unp.k if=$a.unp.eq then=$a.unp.out
@a.rmk.n w.diagram.node code=?c
@a.rmk.e w.diagram.edge code=?c
@a.rmk.cn app.act.call act=remove thing=$a.rmk.n
@a.rmk.ce app.act.call act=remove thing=$a.rmk.e
@select.many.removed.node core.rule when=$a.rmk.n when=$a.rmk.cn when=$a.unp.v with=$a.unp.k if=$a.unp.eq then=$a.unp.out
@select.many.removed.edge core.rule when=$a.rmk.e when=$a.rmk.ce when=$a.unp.v with=$a.unp.k if=$a.unp.eq then=$a.unp.out
@a.rmk.one app.area.view key=selected value=?c
@a.rmk.clear app.act.view key=selected
@select.removed.node core.rule when=$a.rmk.n when=$a.rmk.cn when=$a.rmk.one then=$a.rmk.clear
@select.removed.edge core.rule when=$a.rmk.e when=$a.rmk.ce when=$a.rmk.one then=$a.rmk.clear
# A thing is picked when the view's selected key names it or its own key is set.
@a.pk.one app.area.view key=selected value=?id
@a.pk.o ui.diagram.picked id=?id
@picked.one core.rule when=$a.pk.one then=$a.pk.o
@a.pk.mv app.area.view key=?k value=true
@a.pk.mt ui.diagram.thing code=?id
@a.pk.mk core.calc out=?k2 fn=concat args="selected." args=?id
@a.pk.meq core.check fn=eq args=?k args=?k2
@picked.many core.rule when=$a.pk.mv when=$a.pk.mt with=$a.pk.mk if=$a.pk.meq then=$a.pk.o

# Remove nodes.
@a.rm.n.r app.act.request operation="diagram.node.remove"
@a.rm.n.c app.act.call act=remove thing=$a.it.n order=1
@remove.nodes core.rule when=$a.rm.n.r when=$a.it.i when=$a.it.n then=$a.rm.n.c

# Place nodes: one node's centre at x, y; several keep where they are from each other, their middle at x, y. A
# placed node is pinned. A member of a group is placed with its group.
@a.pl.r app.act.request operation="diagram.node.place" x=?x y=?y
@a.pl.b ui.diagram.nbox node=?id cx=?cx cy=?cy
@a.pl.sx core.aggregate over=$a.it.i over=$a.pl.b sum=?sx args=?cx then=$a.pl.sxo
@a.pl.sxo ui.diagram.centre key=x sum=?sx
@a.pl.sy core.aggregate over=$a.it.i over=$a.pl.b sum=?sy args=?cy then=$a.pl.syo
@a.pl.syo ui.diagram.centre key=y sum=?sy
@a.pl.nc core.aggregate over=$a.it.i over=$a.pl.b count=?k then=$a.pl.nco
@a.pl.nco ui.diagram.centre key=count sum=?k
@a.pl.cx ui.diagram.centre key=x sum=?sx
@a.pl.cy ui.diagram.centre key=y sum=?sy
@a.pl.ck ui.diagram.centre key=count sum=?k
@a.pl.ax core.calc out=?ax fn=div args=?sx args=?k
@a.pl.ay core.calc out=?ay fn=div args=?sy args=?k
@a.pl.dx core.calc out=?dx fn=sub args=?cx args=?ax
@a.pl.dy core.calc out=?dy fn=sub args=?cy args=?ay
@a.pl.nx core.calc out=?nx fn=add args=?x args=?dx
@a.pl.ny core.calc out=?ny fn=add args=?y args=?dy
@a.pl.in ui.diagram.mpos node=?id
@a.pl.c.x app.act.call act=change thing=$a.it.n attr=x value=?nx order=1
@a.pl.c.y app.act.call act=change thing=$a.it.n attr=y value=?ny order=2
@a.pl.c.p app.act.call act=change thing=$a.it.n attr=pinned value=true order=3
@place.node.x core.rule when=$a.pl.r when=$a.it.i when=$a.it.n when=$a.pl.b when=$a.pl.cx when=$a.pl.cy when=$a.pl.ck not=$a.pl.in with=$a.pl.ax with=$a.pl.ay with=$a.pl.dx with=$a.pl.dy with=$a.pl.nx with=$a.pl.ny then=$a.pl.c.x
@place.node.y core.rule when=$a.pl.r when=$a.it.i when=$a.it.n when=$a.pl.b when=$a.pl.cx when=$a.pl.cy when=$a.pl.ck not=$a.pl.in with=$a.pl.ax with=$a.pl.ay with=$a.pl.dx with=$a.pl.dy with=$a.pl.nx with=$a.pl.ny then=$a.pl.c.y
@place.node.pin core.rule when=$a.pl.r when=$a.it.i when=$a.it.n when=$a.pl.b when=$a.pl.cx when=$a.pl.cy when=$a.pl.ck not=$a.pl.in with=$a.pl.ax with=$a.pl.ay with=$a.pl.dx with=$a.pl.dy with=$a.pl.nx with=$a.pl.ny then=$a.pl.c.p
@a.pl.grp.out app.act.refuse reason=node-in-group-place-the-group
@place.node.member core.rule when=$a.pl.r when=$a.it.i when=$a.it.n when=$a.pl.in then=$a.pl.grp.out

# Resize nodes to an exact width and height.
@a.rs.r app.act.request operation="diagram.node.resize" width=?w height=?h
@a.rs.w app.act.call act=change thing=$a.it.n attr=width value=?w order=1
@a.rs.h app.act.call act=change thing=$a.it.n attr=height value=?h order=2
@resize.node.w core.rule when=$a.rs.r when=$a.it.i when=$a.it.n then=$a.rs.w
@resize.node.h core.rule when=$a.rs.r when=$a.it.i when=$a.it.n then=$a.rs.h

# Lay nodes out: a tree or layers hands them back to the diagram's layout (unpinned, out of arrangements); a row,
# column or grid makes them an arrangement (a node already in a framed group is refused); circle and radial are
# not declared here.
@a.ly.r app.act.request operation="diagram.node.layout" layout=?l
@a.ly.flow core.check fn=matches args=?l args="^(tree|layers)$"
@a.ly.unpin app.act.call act=change thing=$a.it.n attr=pinned value=false order=1
@layout.nodes.flow core.rule when=$a.ly.r when=$a.it.i when=$a.it.n if=$a.ly.flow then=$a.ly.unpin
@a.ly.m w.diagram.member node=$a.it.n group=$a.ly.g
@a.ly.g w.diagram.group code=?lyg framed=false
@a.ly.leave app.act.call act=remove thing=$a.ly.m order=2
@layout.nodes.leave core.rule when=$a.ly.r when=$a.it.i when=$a.it.n when=$a.ly.m when=$a.ly.g if=$a.ly.flow then=$a.ly.leave
@a.ly.set core.check fn=matches args=?l args="^(row|column|grid)$"
@a.ly.nx ui.diagram.next of=group top=?top
@a.ly.z core.calc out=?z fn=add args=?top args=1
@a.ly.code core.calc out=?code fn=concat args=g args=?z
@a.ly.g.call app.act.call act=make kind=w.diagram.group code=?code n=?z layout=?l framed=false order=2 ref=new.group
@layout.nodes.arrange core.rule when=$a.ly.r when=$a.ly.nx if=$a.ly.set with=$a.ly.z with=$a.ly.code then=$a.ly.g.call
@a.ly.mem app.act.call act=make kind=w.diagram.member group=new.group node=$a.it.n order=3
@layout.nodes.member core.rule when=$a.ly.r when=$a.it.i when=$a.it.n if=$a.ly.set then=$a.ly.mem
@layout.nodes.leave.old core.rule when=$a.ly.r when=$a.it.i when=$a.it.n when=$a.ly.m when=$a.ly.g if=$a.ly.set then=$a.ly.leave
@dga.framedin.type core.type of=ui.diagram.framedin
@a.fi.m w.diagram.member node=$a.fi.n group=$a.fi.g
@a.fi.n w.diagram.node code=?id
@a.fi.g w.diagram.group code=?g
@a.fi.nf w.diagram.group code=?g framed=false
@a.fi.out ui.diagram.framedin node=?id group=?g
@framed.in core.rule when=$a.fi.m when=$a.fi.n when=$a.fi.g not=$a.fi.nf then=$a.fi.out
@a.ly.fin ui.diagram.framedin node=?id
@a.ly.fin.out app.act.refuse reason=node-already-in-group
@layout.nodes.framed core.rule when=$a.ly.r when=$a.it.i when=$a.ly.fin if=$a.ly.set then=$a.ly.fin.out
@a.ly.no core.check fn=matches args=?l args="^(circle|radial)$"
@a.ly.no.out app.act.refuse reason=layout-not-declared
@layout.nodes.refused core.rule when=$a.ly.r if=$a.ly.no then=$a.ly.no.out

# ---- Edges ----
# Connect two nodes with an arrow; both must be nodes of the diagram, and the same arrow is not made twice.
@a.lk.r app.act.request operation="diagram.link.make" from=?a to=?b
@a.lk.a w.diagram.node code=?a
@a.lk.b w.diagram.node code=?b
@a.lk.nx ui.diagram.next of=edge top=?top
@a.lk.z core.calc out=?z fn=add args=?top args=1
@a.lk.code core.calc out=?code fn=concat args=e args=?z
@a.lk.same w.diagram.edge from=$a.lk.a to=$a.lk.b
@a.lk.c app.act.call act=make kind=w.diagram.edge code=?code from=$a.lk.a to=$a.lk.b n=?z direction=forward order=1
@link.make core.rule when=$a.lk.r when=$a.lk.a when=$a.lk.b when=$a.lk.nx not=$a.lk.same with=$a.lk.z with=$a.lk.code then=$a.lk.c
@a.lk.dup app.act.refuse reason=link-exists
@link.make.twice core.rule when=$a.lk.r when=$a.lk.a when=$a.lk.b when=$a.lk.same then=$a.lk.dup
