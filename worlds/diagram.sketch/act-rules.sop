@observe.link.width core.rule when=$a.oe.width then=$a.oe.width.o
@a.og.g w.diagram.group code=?id label=?label
@a.og.u ui.diagram.unit unit=?id kind=group
@a.og.sel app.area.view key=selected value=?id
@a.og.out app.observe.object id=?id kind=group sourceType=diagram.sketch.group binding=diagram.group label=?label selected=false
@a.og.out.sel app.observe.object id=?id kind=group sourceType=diagram.sketch.group binding=diagram.group label=?label selected=true
@observe.group core.rule when=$a.og.g when=$a.og.u not=$a.og.sel then=$a.og.out
@observe.group.selected core.rule when=$a.og.g when=$a.og.u when=$a.og.sel then=$a.og.out.sel
@a.og.layout w.diagram.group code=?id layout=?v
@a.og.layout.o app.observe.input id=?id key=layout value=?v
@observe.group.layout core.rule when=$a.og.layout then=$a.og.layout.o
@a.og.scale w.diagram.group code=?id scale=?v
@a.og.scale.o app.observe.input id=?id key=scale value=?v
@observe.group.scale core.rule when=$a.og.scale then=$a.og.scale.o
@a.og.member ui.diagram.inside group=?id node=?v
@a.og.member.o app.observe.input id=?id key=members value=?v
@observe.group.members core.rule when=$a.og.member then=$a.og.member.o

@a.sp.n ui.diagram.nbox node=?id x0=?x0 y0=?y0 x1=?x1 y1=?y1
@a.sp.free ui.diagram.unitof node=?id unit=?id
@a.sp.box app.observe.box id=?id x0=?x0 y0=?y0 x1=?x1 y1=?y1 occupant=true
@spatial.node core.rule when=$a.sp.n when=$a.sp.free then=$a.sp.box
@a.sp.m ui.diagram.inside node=?id group=?g
@a.sp.box.m app.observe.box id=?id x0=?x0 y0=?y0 x1=?x1 y1=?y1 occupant=false
@spatial.member core.rule when=$a.sp.n when=$a.sp.m then=$a.sp.box.m
@a.sp.rel app.observe.relation subject=?id object=?g kind=member_of
@spatial.member.of core.rule when=$a.sp.m then=$a.sp.rel
@a.sp.g ui.diagram.unit unit=?g kind=group
@a.sp.gb ui.diagram.ubox unit=?g x0=?gx y0=?gy w=?gw h=?gh
@a.sp.gx1 core.calc out=?gx1 fn=add args=?gx args=?gw
@a.sp.gy1 core.calc out=?gy1 fn=add args=?gy args=?gh
@a.sp.box.g app.observe.box id=?g x0=?gx y0=?gy x1=?gx1 y1=?gy1 occupant=true
@spatial.group core.rule when=$a.sp.g when=$a.sp.gb with=$a.sp.gx1 with=$a.sp.gy1 then=$a.sp.box.g

# The ends of each edge where it is drawn: a point per end (named by the edge and its role, as placement reads them)
# and the edge's endpoint relation to each node.
@a.ep.e w.diagram.edge code=?e from=$a.ep.a to=$a.ep.b
@a.ep.a w.diagram.node code=?a
@a.ep.b w.diagram.node code=?b
@a.ep.h ui.diagram.tip edge=?e at=head x=?hx y=?hy
@a.ep.t ui.diagram.tip edge=?e at=tail x=?tx y=?ty
@a.ep.sf core.calc out=?sf fn=concat args="[\"" args=?e args="\",\"from\"]"
@a.ep.st core.calc out=?st fn=concat args="[\"" args=?e args="\",\"to\"]"
@a.ep.pf app.observe.point id=?sf x=?tx y=?ty
@a.ep.pt app.observe.point id=?st x=?hx y=?hy
@spatial.endpoint.from core.rule when=$a.ep.e when=$a.ep.a when=$a.ep.b when=$a.ep.t with=$a.ep.sf then=$a.ep.pf
@spatial.endpoint.to core.rule when=$a.ep.e when=$a.ep.a when=$a.ep.b when=$a.ep.h with=$a.ep.st then=$a.ep.pt
@a.ep.rf app.observe.relation subject=?e object=?a kind=endpoint_of
@a.ep.rt app.observe.relation subject=?e object=?b kind=endpoint_of
@spatial.endpoint.of.from core.rule when=$a.ep.e when=$a.ep.a when=$a.ep.b then=$a.ep.rf
@spatial.endpoint.of.to core.rule when=$a.ep.e when=$a.ep.a when=$a.ep.b then=$a.ep.rt

@a.op.n w.diagram.node code=?id
@a.op.n.o app.observe.option id=node value=?id
@option.node core.rule when=$a.op.n then=$a.op.n.o
@a.op.e w.diagram.edge code=?id
@a.op.e.o app.observe.option id=link value=?id
@option.link core.rule when=$a.op.e then=$a.op.e.o
@a.op.g w.diagram.group code=?id
@a.op.g.o app.observe.option id=group value=?id
@option.group core.rule when=$a.op.g then=$a.op.g.o
@a.op.c ui.diagram.colour name=?c
@a.op.c.o app.observe.option id=colour value=?c
@option.colour core.rule when=$a.op.c then=$a.op.c.o
@a.op.s ui.diagram.size name=?s
@a.op.s.o app.observe.option id=size value=?s
@option.size core.rule when=$a.op.s then=$a.op.s.o
