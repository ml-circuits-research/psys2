@a.mg.op ui.diagram.groupop operation=?op
@a.mg.g w.diagram.group code=?id
@a.mg.out app.act.refuse reason=missing-group
@missing.group core.rule when=$a.mg.r when=$a.mg.op not=$a.mg.g then=$a.mg.out
@a.ig.r app.act.request id=?id
@a.ig.g w.diagram.group code=?id
@a.ig.m w.diagram.member group=$a.ig.g node=$a.ig.n
@a.ig.n w.diagram.node code=?mid

@a.gsel.r app.act.request operation="diagram.group.select" id=?id
@a.gsel.v app.act.view key=selected value=?id
@group.select core.rule when=$a.gsel.r when=$a.ig.g then=$a.gsel.v

# Change a group: its label; the colour and size of its members.
@a.gc.label.r app.act.request operation="diagram.group.change" label=?v
@a.gc.label.c app.act.call act=change thing=$a.ig.g attr=label value=?v order=1
@group.change.label core.rule when=$a.gc.label.r when=$a.ig.r when=$a.ig.g then=$a.gc.label.c
@a.gc.colour.r app.act.request operation="diagram.group.change" colour=?v
@a.gc.colour.c app.act.call act=change thing=$a.ig.n attr=colour value=?v order=1
@group.change.colour core.rule when=$a.gc.colour.r when=$a.ig.r when=$a.ig.g when=$a.ig.m when=$a.ig.n then=$a.gc.colour.c
@a.gc.size.r app.act.request operation="diagram.group.change" size=?v
@a.gc.size.c app.act.call act=change thing=$a.ig.n attr=size value=?v order=1
@group.change.size core.rule when=$a.gc.size.r when=$a.ig.r when=$a.ig.g when=$a.ig.m when=$a.ig.n then=$a.gc.size.c
@a.gc.none.r app.act.request operation="diagram.group.change"
@a.gc.none.1 app.act.request label=?c1
@a.gc.none.2 app.act.request colour=?c2
@a.gc.none.3 app.act.request size=?c3
@a.gc.none.out app.act.refuse reason=missing-property
@group.change.none core.rule when=$a.gc.none.r not=$a.gc.none.1 not=$a.gc.none.2 not=$a.gc.none.3 then=$a.gc.none.out

# Lay a group out: row, column, grid, or its members' values as a bar or line chart (every member needs a value).
# Free, tree, layers, circle, radial, pie and doughnut layouts of a group are not declared here.
@a.gl.r app.act.request operation="diagram.group.layout" layout=?l
@a.gl.ok core.check fn=matches args=?l args="^(row|column|grid|bar|line)$"
@a.gl.c app.act.call act=change thing=$a.ig.g attr=layout value=?l order=1
@group.layout core.rule when=$a.gl.r when=$a.ig.r when=$a.ig.g if=$a.gl.ok then=$a.gl.c
@a.gl.no core.check fn=matches args=?l args="^(free|tree|layers|circle|radial|pie|doughnut)$"
@a.gl.no.out app.act.refuse reason=group-layout-not-declared
@group.layout.refused core.rule when=$a.gl.r if=$a.gl.no then=$a.gl.no.out
@a.gl.chart core.check fn=matches args=?l args="^(bar|line)$"
@a.gl.nv w.diagram.node code=?mid value=?anyv
@a.gl.nv.out app.act.refuse reason=explicit-numeric-values-required
@group.layout.values core.rule when=$a.gl.r when=$a.ig.r when=$a.ig.g when=$a.ig.m when=$a.ig.n not=$a.gl.nv if=$a.gl.chart then=$a.gl.nv.out

# Resize a group (its members' size, 1 as made) and place it (its centre at x, y; pinned).
@a.gr.r app.act.request operation="diagram.group.resize" scale=?k
@a.gr.c app.act.call act=change thing=$a.ig.g attr=scale value=?k order=1
@group.resize core.rule when=$a.gr.r when=$a.ig.r when=$a.ig.g then=$a.gr.c
@a.gp.r app.act.request operation="diagram.group.place" x=?x y=?y
@a.gp.x app.act.call act=change thing=$a.ig.g attr=x value=?x order=1
@a.gp.y app.act.call act=change thing=$a.ig.g attr=y value=?y order=2
@a.gp.p app.act.call act=change thing=$a.ig.g attr=pinned value=true order=3
@group.place.x core.rule when=$a.gp.r when=$a.ig.r when=$a.ig.g then=$a.gp.x
@group.place.y core.rule when=$a.gp.r when=$a.ig.r when=$a.ig.g then=$a.gp.y
@group.place.pin core.rule when=$a.gp.r when=$a.ig.r when=$a.ig.g then=$a.gp.p

# Remove a group with its members; ungroup (the members stay).
@a.grm.r app.act.request operation="diagram.group.remove"
@a.grm.n app.act.call act=remove thing=$a.ig.n order=1
@a.grm.g app.act.call act=remove thing=$a.ig.g order=2
@group.remove.members core.rule when=$a.grm.r when=$a.ig.r when=$a.ig.g when=$a.ig.m when=$a.ig.n then=$a.grm.n
@group.remove core.rule when=$a.grm.r when=$a.ig.r when=$a.ig.g then=$a.grm.g
@a.gu.r app.act.request operation="diagram.group.ungroup"
@group.ungroup core.rule when=$a.gu.r when=$a.ig.r when=$a.ig.g then=$a.grm.g

# A chart group: one rectangle node per label with its value, in a framed group laid out as bars or a line. The
# labels and values must pair up; a pie or doughnut chart is not declared here.
@a.cg.r app.act.request operation="diagram.group.chart.make" label=?label layout=?l
@a.cg.ok core.check fn=matches args=?l args="^(bar|line)$"
@a.cg.gnx ui.diagram.next of=group top=?gtop
@a.cg.gz core.calc out=?gz fn=add args=?gtop args=1
@a.cg.gcode core.calc out=?gcode fn=concat args=g args=?gz
@a.cg.g app.act.call act=make kind=w.diagram.group code=?gcode label=?label n=?gz layout=?l order=2 ref=new.group
@chart.make.group core.rule when=$a.cg.r when=$a.cg.gnx if=$a.cg.ok with=$a.cg.gz with=$a.cg.gcode then=$a.cg.g
@a.cg.li app.act.item param="labels" n=?i value=?t
@a.cg.vi app.act.item param="values" n=?i value=?v
@a.cg.nnx ui.diagram.next of=node top=?ntop
@a.cg.i1 core.calc out=?i1 fn=add args=?i args=1
@a.cg.nz core.calc out=?nz fn=add args=?ntop args=?i1
@a.cg.ncode core.calc out=?ncode fn=concat args=n args=?nz
@a.cg.ref core.calc out=?ref fn=concat args="new.node." args=?i1
@a.cg.n app.act.call act=make kind=w.diagram.node code=?ncode shape=rectangle label=?t value=?v n=?nz order=1 ref=?ref
@chart.make.node core.rule when=$a.cg.r when=$a.cg.li when=$a.cg.vi when=$a.cg.nnx if=$a.cg.ok with=$a.cg.i1 with=$a.cg.nz with=$a.cg.ncode with=$a.cg.ref then=$a.cg.n
@a.cg.mem app.act.call act=make kind=w.diagram.member group=new.group node=?ref order=3
@chart.make.member core.rule when=$a.cg.r when=$a.cg.li when=$a.cg.vi when=$a.cg.nnx if=$a.cg.ok with=$a.cg.i1 with=$a.cg.nz with=$a.cg.ncode with=$a.cg.ref then=$a.cg.mem
@a.cg.lab.v app.act.item param="labels" n=?i
@a.cg.val.v app.act.item param="values" n=?i
@a.cg.unpaired app.act.refuse reason=invalid-chart-data
@chart.make.unpaired.label core.rule when=$a.cg.r when=$a.cg.lab.v not=$a.cg.val.v then=$a.cg.unpaired
@a.cg.lab.w app.act.item param="labels" n=?j
@a.cg.val.w app.act.item param="values" n=?j
@chart.make.unpaired.value core.rule when=$a.cg.r when=$a.cg.val.w not=$a.cg.lab.w then=$a.cg.unpaired
@a.cg.no core.check fn=matches args=?l args="^(pie|doughnut)$"
@a.cg.no.out app.act.refuse reason=chart-layout-not-declared
@chart.make.refused core.rule when=$a.cg.r if=$a.cg.no then=$a.cg.no.out

# Charts of the data.charts composition (diagram.group.chart, diagram.group.chart.adopt and the composed chart.*
# commands) are not part of this area's instance: refused, never simulated.
@a.cc.r app.act.request operation=?op
@a.cc.chart core.check fn=matches args=?op args="^(chart[.]|diagram[.]group[.]chart$|diagram[.]group[.]chart[.]adopt$)"
@a.cc.out app.act.refuse reason=chart-composition-not-in-area
@chart.composition core.rule when=$a.cc.r if=$a.cc.chart then=$a.cc.out

