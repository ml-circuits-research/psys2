# ---- Groups ----
# Make a group of nodes named `name` (its code; it must not be a node's or another group's), labelled with its label
# or its name, its members in a row. A member of an arrangement leaves it; a member of a framed group is refused.
@a.gm.r app.act.request operation="diagram.group.make" name=?name
@a.gm.nx ui.diagram.next of=group top=?top
@a.gm.z core.calc out=?z fn=add args=?top args=1
@a.gm.taken.n w.diagram.node code=?name
@a.gm.taken.g w.diagram.group code=?name
@a.gm.lab app.act.request operation="diagram.group.make" label=?anyl
@a.gm.c app.act.call act=make kind=w.diagram.group code=?name label=?name n=?z layout=row order=2 ref=new.group
@group.make core.rule when=$a.gm.r when=$a.gm.nx not=$a.gm.taken.n not=$a.gm.taken.g not=$a.gm.lab with=$a.gm.z then=$a.gm.c
@a.gm.rl app.act.request operation="diagram.group.make" name=?name label=?label
@a.gm.cl app.act.call act=make kind=w.diagram.group code=?name label=?label n=?z layout=row order=2 ref=new.group
@group.make.labelled core.rule when=$a.gm.rl when=$a.gm.nx not=$a.gm.taken.n not=$a.gm.taken.g with=$a.gm.z then=$a.gm.cl
@a.gm.dup app.act.refuse reason=invalid-or-duplicate-group-name
@group.make.taken.node core.rule when=$a.gm.r when=$a.gm.taken.n then=$a.gm.dup
@group.make.taken.group core.rule when=$a.gm.r when=$a.gm.taken.g then=$a.gm.dup
@a.gm.mem app.act.call act=make kind=w.diagram.member group=new.group node=$a.it.n order=3
@group.make.member core.rule when=$a.gm.r when=$a.it.i when=$a.it.n then=$a.gm.mem
@a.gm.lm w.diagram.member node=$a.it.n group=$a.gm.lg
@a.gm.lg w.diagram.group code=?gmg framed=false
@a.gm.leave app.act.call act=remove thing=$a.gm.lm order=1
@group.make.leave core.rule when=$a.gm.r when=$a.it.i when=$a.it.n when=$a.gm.lm when=$a.gm.lg then=$a.gm.leave
@a.gm.fin ui.diagram.framedin node=?id
@a.gm.fin.out app.act.refuse reason=node-already-in-group
@group.make.framed core.rule when=$a.gm.r when=$a.it.i when=$a.gm.fin then=$a.gm.fin.out

# The commands that name a group by `id`, and a refusal when it is not a group of the diagram.
@groupop.select ui.diagram.groupop operation="diagram.group.select"
@groupop.change ui.diagram.groupop operation="diagram.group.change"
@groupop.layout ui.diagram.groupop operation="diagram.group.layout"
@groupop.resize ui.diagram.groupop operation="diagram.group.resize"
@groupop.place ui.diagram.groupop operation="diagram.group.place"
@groupop.remove ui.diagram.groupop operation="diagram.group.remove"
@groupop.ungroup ui.diagram.groupop operation="diagram.group.ungroup"
