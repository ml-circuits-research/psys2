@a.lc.none.out app.act.refuse reason=missing-property
@a.lc.none.9 ui.diagram.lcgiven value=yes
@change.link.none core.rule when=$a.lc.none.r not=$a.lc.none.9 not=$a.lc.none.1 not=$a.lc.none.2 not=$a.lc.none.3 not=$a.lc.none.4 not=$a.lc.none.5 not=$a.lc.none.6 not=$a.lc.none.7 not=$a.lc.none.8 then=$a.lc.none.out

