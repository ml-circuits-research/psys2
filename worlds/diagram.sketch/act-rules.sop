@a.cl.n w.diagram.node code=?any
@a.cl.nc app.act.call act=remove thing=$a.cl.n order=3
@clear.nodes core.rule when=$a.cl.r when=$a.cl.n then=$a.cl.nc

# A new page: every link, group and node of the page goes and the page takes the title said, or none. The history
