# The said records are aggregated by category (ui.diagram.ccat): a label said several times ("Ana 3, Bob 5, Ana 2") is
# one category whose value is the sum of its records, or their count, average, minimum or maximum (`aggregate`); the
# category stands where its label was first said. With `bins`, the values are a distribution instead: the range from
# the smallest to the largest value is cut into `bins` equal ranges, each a category counting its records (a histogram).
@dga.ccat.type core.type of=ui.diagram.ccat
@dga.cagg.type core.type of=ui.diagram.cagg
@dga.cbin.type core.type of=ui.diagram.cbin
@dga.cbinx.type core.type of=ui.diagram.cbinx
@dga.cstat.type core.type of=ui.diagram.cstat
@dga.corder.type core.type of=ui.diagram.corder
@a.ag.ci ui.diagram.citem n=?n label=?t value=?v
@a.ag.nobins app.act.request bins=?nobins
@a.ag.first ui.diagram.cagg label=?t key=first value=?m
@chart.records.first core.aggregate over=$a.ag.ci by=?t min=?m args=?n then=$a.ag.first
@a.ag.sum ui.diagram.cagg label=?t key=sum value=?m
@chart.records.sum core.aggregate over=$a.ag.ci by=?t sum=?m args=?v then=$a.ag.sum
@a.ag.cnt ui.diagram.cagg label=?t key=count value=?m
@chart.records.count core.aggregate over=$a.ag.ci by=?t count=?m then=$a.ag.cnt
@a.ag.max ui.diagram.cagg label=?t key=max value=?m
@chart.records.max core.aggregate over=$a.ag.ci by=?t max=?m args=?v then=$a.ag.max
@a.ag.min ui.diagram.cagg label=?t key=min value=?m
@chart.records.min core.aggregate over=$a.ag.ci by=?t min=?m args=?v then=$a.ag.min
@a.ag.f ui.diagram.cagg label=?t key=first value=?n
@a.ag.k ui.diagram.cagg label=?t key=?ak value=?av
@a.ag.req app.act.request operation="diagram.group.chart.make" aggregate=?ak
@a.ag.any app.act.request aggregate=?anyak
@a.ag.out ui.diagram.ccat n=?n label=?t value=?av
@chart.category.aggregate core.rule when=$a.cg.r when=$a.ag.req when=$a.ag.f when=$a.ag.k not=$a.ag.nobins then=$a.ag.out
@a.ag.s ui.diagram.cagg label=?t key=sum value=?av
@chart.category.sum core.rule when=$a.cg.r not=$a.ag.any when=$a.ag.f when=$a.ag.s not=$a.ag.nobins then=$a.ag.out
@a.ag.avs ui.diagram.cagg label=?t key=sum value=?sv
@a.ag.avc ui.diagram.cagg label=?t key=count value=?cv
@a.ag.avg app.act.request operation="diagram.group.chart.make" aggregate=avg
@a.ag.av core.calc out=?a1 fn=div args=?sv args=?cv
@a.ag.avr core.calc out=?a2 fn=round args=?a1 args=2
@a.ag.aout ui.diagram.ccat n=?n label=?t value=?a2
@chart.category.average core.rule when=$a.cg.r when=$a.ag.avg when=$a.ag.f when=$a.ag.avs when=$a.ag.avc not=$a.ag.nobins with=$a.ag.av with=$a.ag.avr then=$a.ag.aout
# Bins: the range of the values, each record's bin, the count of each bin (an empty bin counts 0).
@chart.binx.0 ui.diagram.cbinx k=0
@chart.binx.1 ui.diagram.cbinx k=1
@chart.binx.2 ui.diagram.cbinx k=2
@chart.binx.3 ui.diagram.cbinx k=3
@chart.binx.4 ui.diagram.cbinx k=4
@chart.binx.5 ui.diagram.cbinx k=5
@chart.binx.6 ui.diagram.cbinx k=6
@chart.binx.7 ui.diagram.cbinx k=7
@chart.binx.8 ui.diagram.cbinx k=8
