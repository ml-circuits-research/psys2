@chart.item.said core.rule when=$a.cg.r when=$a.cg.li when=$a.cg.vi not=$a.cg.nodim not=$a.cg.iscount if=$a.cg.ok with=$a.cg.i1 then=$a.cg.it
@chart.item.said.named core.rule when=$a.cg.r when=$a.cg.li when=$a.cg.vi when=$a.cg.isnamed not=$a.cg.iscount if=$a.cg.ok with=$a.cg.i1 then=$a.cg.it
@a.cg.kcv k.charts.category dimension=?d n=?i1 label=?kt
@a.cg.kcno k.charts.category dimension=?d n=?i1
@a.cg.it.kv ui.diagram.citem n=?i1 label=?kt value=?v
@a.cg.gnv ui.diagram.cgeneric n=?i1 suffix=?suf
