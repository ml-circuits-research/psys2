@a.np.g w.diagram.group code=?any
@a.np.gc app.act.call act=remove thing=$a.np.g order=2
@page.new.groups core.rule when=$a.np.r when=$a.np.g then=$a.np.gc
@a.np.n w.diagram.node code=?any
@a.np.nc app.act.call act=remove thing=$a.np.n order=3
@page.new.nodes core.rule when=$a.np.r when=$a.np.n then=$a.np.nc
@a.np.t app.act.request operation="diagram.page.new" title=?t
