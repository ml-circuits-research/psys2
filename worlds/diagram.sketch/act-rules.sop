@group.ungroup core.rule when=$a.gu.r when=$a.ig.r when=$a.ig.g then=$a.grm.g

# A chart group: one rectangle node per label with its value, in a framed group laid out as a chart. The
# labels and values must pair up; pie and doughnut charts draw the values as slices.
@a.cg.r app.act.request operation="diagram.group.chart.make" label=?label layout=?l
@a.cg.ok core.check fn=matches args=?l args="^(bar|line|area|pie|doughnut|scatter|radar|treemap)$"
@a.cg.gnx ui.diagram.next of=group top=?gtop
@a.cg.gz core.calc out=?gz fn=add args=?gtop args=1
@a.cg.gcode core.calc out=?gcode fn=concat args=g args=?gz
@a.cg.g app.act.call act=make kind=w.diagram.group code=?gcode label=?label n=?gz layout=?l order=2 ref=new.group
@chart.make.group core.rule when=$a.cg.r when=$a.cg.gnx if=$a.cg.ok with=$a.cg.gz with=$a.cg.gcode then=$a.cg.g
# The categories it draws (ui.diagram.citem): the said labels with their values; said labels without values, with sample
# values; no labels: the typical categories of the said dimension (k.charts.category), else that dimension's name with
# A, B, C, D, else A, B and C, all with sample values (the chart is then marked as a sample). Labels and values said
# both must pair up.
@dga.citem.type core.type of=ui.diagram.citem
@dga.cdrop.type core.type of=ui.diagram.cdrop
@dga.csample.type core.type of=ui.diagram.csample
