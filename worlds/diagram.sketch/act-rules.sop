@chart.sample.10 ui.diagram.csample n=10 value=30
@chart.sample.11 ui.diagram.csample n=11 value=45
@chart.sample.12 ui.diagram.csample n=12 value=26
@chart.generic.1 ui.diagram.cgeneric n=1 suffix=A
@chart.generic.2 ui.diagram.cgeneric n=2 suffix=B
@chart.generic.3 ui.diagram.cgeneric n=3 suffix=C
@chart.generic.4 ui.diagram.cgeneric n=4 suffix=D
@chart.default.1 ui.diagram.cdefault n=1 label="A" value=3
@chart.default.2 ui.diagram.cdefault n=2 label="B" value=5
@chart.default.3 ui.diagram.cdefault n=3 label="C" value=2
@a.cg.li app.act.item param="labels" n=?i value=?t
@a.cg.vi app.act.item param="values" n=?i value=?v
@a.cg.i1 core.calc out=?i1 fn=add args=?i args=1
@a.cg.it ui.diagram.citem n=?i1 label=?t value=?v
# Labels the policy numbered after the values ("1", "2", ...: execution-policy.sop, no labels said) are not names: with
# a dimension said, its typical categories name the values in order (beyond them the numbers stay).
@dga.cnamed.type core.type of=ui.diagram.cnamed
@a.cg.lx app.act.item param="labels" n=?i value=?t
@a.cg.lxv core.calc out=?tv fn=lower args=?t
@a.cg.lxn core.check fn=neq args=?tv args=?i1
@a.cg.named ui.diagram.cnamed request=yes
