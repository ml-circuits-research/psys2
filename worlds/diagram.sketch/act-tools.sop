@t.sc.h core.calc out=?nh fn=mul args=?h args=?f
@t.sc.cw app.act.call act=change thing=$t.sc.n attr=width value=?nw order=1
@t.sc.ch app.act.call act=change thing=$t.sc.n attr=height value=?nh order=1
@tool.scale.w core.rule when=$t.sc.r when=$t.sc.i when=$t.sc.n when=$t.sc.d with=$t.sc.w then=$t.sc.cw
@tool.scale.h core.rule when=$t.sc.r when=$t.sc.i when=$t.sc.n when=$t.sc.d with=$t.sc.h then=$t.sc.ch

# ---- Charts: colour the categories by a condition on their value; sort them; the top of the value axis ----
@groupop.chart.highlight ui.diagram.groupop operation="diagram.chart.highlight"
@groupop.chart.sort ui.diagram.groupop operation="diagram.chart.sort"
@t.ch.r app.act.request operation="diagram.chart.highlight" id=?g test=?test value=?lim colour=?col
@t.ch.g w.diagram.group code=?g
@t.ch.m ui.diagram.inside group=?g node=?c
@t.ch.n w.diagram.node code=?c value=?v
@t.ch.below core.check fn=lt args=?v args=?lim
@t.ch.above core.check fn=gt args=?v args=?lim
@t.ch.istb core.check fn=eq args=?test args=below
@t.ch.ista core.check fn=eq args=?test args=above
@t.ch.c app.act.call act=change thing=$t.ch.n attr=colour value=?col order=1
@tool.chart.highlight.below core.rule when=$t.ch.r when=$t.ch.g when=$t.ch.m when=$t.ch.n if=$t.ch.istb if=$t.ch.below then=$t.ch.c
@tool.chart.highlight.above core.rule when=$t.ch.r when=$t.ch.g when=$t.ch.m when=$t.ch.n if=$t.ch.ista if=$t.ch.above then=$t.ch.c
@t.so.r app.act.request operation="diagram.chart.sort" id=?g order=?ord
@t.so.g w.diagram.group code=?g
@dgt.csort.type core.type of=ui.diagram.csort
@t.so.m ui.diagram.inside group=?g node=?c order=?o
@t.so.n w.diagram.node code=?c value=?v label=?l
@t.so.out ui.diagram.csort group=?g node=?c value=?v label=?l
@tool.chart.sort.members core.rule when=$t.so.r when=$t.so.g when=$t.so.m when=$t.so.n then=$t.so.out
@t.so.s ui.diagram.csort group=?g node=?c value=?v label=?l
@t.so.min ui.diagram.gorder group=?g order=?first
@t.so.asc core.check fn=eq args=?ord args=ascending
@t.so.desc core.check fn=eq args=?ord args=descending
@t.so.lab core.check fn=eq args=?ord args=label
@t.so.ra core.rank of=$t.so.s by=value within=?g out=?k
@t.so.rd core.rank of=$t.so.s by=value order=desc within=?g out=?k
@t.so.rl core.rank of=$t.so.s by=label within=?g out=?k
@t.so.k0 core.calc out=?k0 fn=sub args=?k args=1
@t.so.nn core.calc out=?nn fn=add args=?first args=?k0
@t.so.cn w.diagram.node code=?c
@t.so.c app.act.call act=change thing=$t.so.cn attr=n value=?nn order=1
@tool.chart.sort.ascending core.rule when=$t.so.r when=$t.so.s when=$t.so.min when=$t.so.cn if=$t.so.asc with=$t.so.ra with=$t.so.k0 with=$t.so.nn then=$t.so.c
@tool.chart.sort.descending core.rule when=$t.so.r when=$t.so.s when=$t.so.min when=$t.so.cn if=$t.so.desc with=$t.so.rd with=$t.so.k0 with=$t.so.nn then=$t.so.c
@tool.chart.sort.label core.rule when=$t.so.r when=$t.so.s when=$t.so.min when=$t.so.cn if=$t.so.lab with=$t.so.rl with=$t.so.k0 with=$t.so.nn then=$t.so.c
@t.cf.ym app.act.request operation="diagram.chart.format" yMax=?v
@t.cf.ymc app.act.call act=change thing=$t.cf.g attr=y_max value=?v order=1
@tool.chart.format.ymax core.rule when=$t.cf.r when=$t.cf.g when=$t.cf.ym then=$t.cf.ymc
# The chart's type changed in place: its group's layout (bar, line, area, pie, doughnut).
@t.cf.ly app.act.request operation="diagram.chart.format" layout=?v
@t.cf.lyc app.act.call act=change thing=$t.cf.g attr=layout value=?v order=1
@tool.chart.format.layout core.rule when=$t.cf.r when=$t.cf.g when=$t.cf.ly then=$t.cf.lyc
# A palette: each category takes the next swatch of the named theme, in the order of the categories.
@t.cf.pl app.act.request operation="diagram.chart.format" palette=?p
@t.cf.plp ui.diagram.palette name=?p
@tool.chart.format.palette.name core.rule when=$t.cf.pl then=$t.cf.plp
@dgt.cpal.type core.type of=ui.diagram.cpal
@t.cf.pm ui.diagram.inside group=?g node=?c order=?o
@t.cf.pmo ui.diagram.cpal group=?g node=?c order=?o
@tool.chart.format.palette.members core.rule when=$t.cf.r when=$t.cf.pl when=$t.cf.pm then=$t.cf.pmo
@t.cf.ps ui.diagram.cpal group=?g node=?c order=?o
@t.cf.prk core.rank of=$t.cf.ps by=order within=?g out=?i
@t.cf.pn ui.diagram.pcount name=?p n=?k
@t.cf.pi0 core.calc out=?i0 fn=sub args=?i args=1
@t.cf.pim core.calc out=?im fn=mod args=?i0 args=?k
@t.cf.pj core.calc out=?j fn=add args=?im args=1
@t.cf.psw k.styles.swatch theme=?p n=?j colour=?col
@t.cf.pnode w.diagram.node code=?c
@t.cf.pc app.act.call act=change thing=$t.cf.pnode attr=colour value=?col order=1
@tool.chart.format.palette core.rule when=$t.cf.pl when=$t.cf.ps when=$t.cf.pn when=$t.cf.pnode with=$t.cf.prk with=$t.cf.pi0 with=$t.cf.pim with=$t.cf.pj when=$t.cf.psw then=$t.cf.pc
