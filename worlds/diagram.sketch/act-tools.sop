@tool.link.improve.style core.rule when=$t.li.r when=$t.li.i when=$t.li.e then=$t.li.c2
@tool.link.improve.width core.rule when=$t.li.r when=$t.li.i when=$t.li.e then=$t.li.c3

# ---- Swap two nodes: their places (pinned: their positions; in the layout: their order) ----
@nodeop.swap ui.diagram.nodeop operation="diagram.nodes.swap"
