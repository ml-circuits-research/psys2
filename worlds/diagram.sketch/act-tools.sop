# ---- Charts: a chart is a framed group whose members are its categories (their labels) with their values; its
# title is the group's label and its type the group's layout (bar, line, area, pie, doughnut). ----
@groupop.chart.value ui.diagram.groupop operation="diagram.chart.value"
@groupop.chart.add ui.diagram.groupop operation="diagram.chart.category.add"
@groupop.chart.remove ui.diagram.groupop operation="diagram.chart.category.remove"
@groupop.chart.rename ui.diagram.groupop operation="diagram.chart.category.rename"
@groupop.chart.format ui.diagram.groupop operation="diagram.chart.format"
@dgt.cat.type core.type of=ui.diagram.cat
# The category a command names: a member of the chart whose label (or code) it is; none is refused.
@t.ct.r app.act.request id=?g category=?cat
@t.ct.g w.diagram.group code=?g
@t.ct.m ui.diagram.inside group=?g node=?c
@t.ct.l w.diagram.node code=?c label=?cat
@t.ct.out ui.diagram.cat node=?c
@tool.chart.category.label core.rule when=$t.ct.r when=$t.ct.g when=$t.ct.m when=$t.ct.l then=$t.ct.out
@t.ct.code core.check fn=eq args=?c args=?cat
@tool.chart.category.code core.rule when=$t.ct.r when=$t.ct.g when=$t.ct.m if=$t.ct.code then=$t.ct.out
@t.ct.any ui.diagram.cat node=?anyc
@t.ct.miss app.act.refuse reason=missing-category
@tool.chart.category.missing core.rule when=$t.ct.r when=$t.ct.g not=$t.ct.any then=$t.ct.miss
@t.ct.c ui.diagram.cat node=?c
@t.ct.n w.diagram.node code=?c
# A category's value ("make March 40"), name, and removal.
@t.cv.r app.act.request operation="diagram.chart.value" value=?v
@t.cv.c app.act.call act=change thing=$t.ct.n attr=value value=?v order=1
@tool.chart.value core.rule when=$t.cv.r when=$t.ct.c when=$t.ct.n then=$t.cv.c
@t.cn.r app.act.request operation="diagram.chart.category.rename" label=?l
@t.cn.c app.act.call act=change thing=$t.ct.n attr=label value=?l order=1
@tool.chart.rename core.rule when=$t.cn.r when=$t.ct.c when=$t.ct.n then=$t.cn.c
@t.cr.r app.act.request operation="diagram.chart.category.remove"
@t.cr.c app.act.call act=remove thing=$t.ct.n order=1
@tool.chart.remove core.rule when=$t.cr.r when=$t.ct.c when=$t.ct.n then=$t.cr.c
# A new category at the end, with its value ("add a column for April").
@t.ca.r app.act.request operation="diagram.chart.category.add" id=?g label=?l value=?v
@t.ca.g w.diagram.group code=?g
@t.ca.nx ui.diagram.next of=node top=?top
@t.ca.z core.calc out=?z fn=add args=?top args=1
@t.ca.code core.calc out=?code fn=concat args=n args=?z
@t.ca.mk app.act.call act=make kind=w.diagram.node code=?code shape=rectangle label=?l value=?v n=?z order=1 ref=chart.node
@t.ca.mem app.act.call act=make kind=w.diagram.member group=$t.ca.g node=chart.node order=2
@tool.chart.add core.rule when=$t.ca.r when=$t.ca.g when=$t.ca.nx with=$t.ca.z with=$t.ca.code then=$t.ca.mk
@tool.chart.add.member core.rule when=$t.ca.r when=$t.ca.g then=$t.ca.mem
