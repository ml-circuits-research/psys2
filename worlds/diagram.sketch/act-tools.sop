@t.sw.a app.act.item param="ids" n=0 value=?a
@t.sw.b app.act.item param="ids" n=1 value=?b
@t.sw.na w.diagram.node code=?a n=?oa
@t.sw.nb w.diagram.node code=?b n=?ob
@t.sw.ca app.act.call act=change thing=$t.sw.na attr=n value=?ob order=1
@t.sw.cb app.act.call act=change thing=$t.sw.nb attr=n value=?oa order=1
@tool.swap.order.a core.rule when=$t.sw.r when=$t.sw.a when=$t.sw.b when=$t.sw.na when=$t.sw.nb then=$t.sw.ca
@tool.swap.order.b core.rule when=$t.sw.r when=$t.sw.a when=$t.sw.b when=$t.sw.na when=$t.sw.nb then=$t.sw.cb
@t.sw.ba ui.diagram.nbox node=?a cx=?ax cy=?ay
@t.sw.bb ui.diagram.nbox node=?b cx=?bx cy=?by
@t.sw.pa w.diagram.node code=?a pinned=true
@t.sw.pb w.diagram.node code=?b pinned=true
@t.sw.xa app.act.call act=change thing=$t.sw.na attr=x value=?bx order=2
@t.sw.ya app.act.call act=change thing=$t.sw.na attr=y value=?by order=2
@t.sw.xb app.act.call act=change thing=$t.sw.nb attr=x value=?ax order=2
@t.sw.yb app.act.call act=change thing=$t.sw.nb attr=y value=?ay order=2
@t.sw.pina app.act.call act=change thing=$t.sw.na attr=pinned value=true order=3
@t.sw.pinb app.act.call act=change thing=$t.sw.nb attr=pinned value=true order=3
@tool.swap.xa core.rule when=$t.sw.r when=$t.sw.a when=$t.sw.b when=$t.sw.na when=$t.sw.nb when=$t.sw.ba when=$t.sw.bb when=$t.sw.pb then=$t.sw.xa
@tool.swap.ya core.rule when=$t.sw.r when=$t.sw.a when=$t.sw.b when=$t.sw.na when=$t.sw.nb when=$t.sw.ba when=$t.sw.bb when=$t.sw.pb then=$t.sw.ya
@tool.swap.pina core.rule when=$t.sw.r when=$t.sw.a when=$t.sw.b when=$t.sw.na when=$t.sw.nb when=$t.sw.pb then=$t.sw.pina
@tool.swap.xb core.rule when=$t.sw.r when=$t.sw.a when=$t.sw.b when=$t.sw.na when=$t.sw.nb when=$t.sw.ba when=$t.sw.bb when=$t.sw.pa then=$t.sw.xb
@tool.swap.yb core.rule when=$t.sw.r when=$t.sw.a when=$t.sw.b when=$t.sw.na when=$t.sw.nb when=$t.sw.ba when=$t.sw.bb when=$t.sw.pa then=$t.sw.yb
