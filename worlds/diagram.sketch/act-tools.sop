@observe.page.object core.rule when=$t.pg.k when=$t.pg.l when=$t.pg.d then=$t.pg.o

# ---- Tidy links: the declared look of a link (orthogonal route, solid, 2 wide); disclosed as such ----
@edgeop.improve ui.diagram.edgeop operation="diagram.link.improve"
@t.li.r app.act.request operation="diagram.link.improve"
@t.li.i app.act.item param="ids" value=?id
@t.li.e w.diagram.edge code=?id
