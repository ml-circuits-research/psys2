@tool.chart.format.none core.rule when=$t.cf.r not=$t.cf.n12 not=$t.cf.n1 not=$t.cf.n2 not=$t.cf.n3 not=$t.cf.n4 not=$t.cf.n5 not=$t.cf.n6 not=$t.cf.n7 not=$t.cf.n8 not=$t.cf.n9 not=$t.cf.n10 not=$t.cf.n11 then=$t.cf.none
@t.cg.f w.diagram.group code=?id x_label=?v
@t.cg.fo app.observe.input id=?id key=xLabel value=?v
@observe.chart.x core.rule when=$t.cg.f then=$t.cg.fo
@t.cg.y w.diagram.group code=?id y_label=?v
@t.cg.yo app.observe.input id=?id key=yLabel value=?v
@observe.chart.y core.rule when=$t.cg.y then=$t.cg.yo
@t.cg.v w.diagram.group code=?id value_labels=?v
@t.cg.vo app.observe.input id=?id key=valueLabels value=?v
@observe.chart.values core.rule when=$t.cg.v then=$t.cg.vo
@t.cg.g w.diagram.group code=?id gridlines=?v
@t.cg.go app.observe.input id=?id key=gridlines value=?v
@observe.chart.grid core.rule when=$t.cg.g then=$t.cg.go
@t.cg.l w.diagram.group code=?id legend=?v
@t.cg.lo app.observe.input id=?id key=legend value=?v
@observe.chart.legend core.rule when=$t.cg.l then=$t.cg.lo
@t.ob.rot w.diagram.node code=?id rotation=?v
@t.ob.rotc app.observe.input id=?id key=rotation value=?v
@observe.node.rotation core.rule when=$t.ob.rot then=$t.ob.rotc
@t.cg.ym w.diagram.group code=?id y_max=?v
@t.cg.ymo app.observe.input id=?id key=yMax value=?v
@observe.chart.ymax core.rule when=$t.cg.ym then=$t.cg.ymo

# ---- The page as an observed object: the target of the page-wide commands (layout, theme, improve, numbers) ----
@t.pg.k ui.diagram.const0 w=?anyw
@t.pg.l ui.diagram.lay value=?lay
@t.pg.d ui.diagram.dmode value=?dir
