# The Diagram tab as a SOP area (read by worlds/sop-area.mjs). The instance is a w.diagram world (nodes, edges,
# groups and memberships); render-projection.sop lays it out and draws it, act-rules.sop compiles every native
# Diagram command into std.acts calls (or an explicit refusal) and derives what a reader observes; layout-modes.sop
# and style-projection.sop add the page's layouts, routes, themes and shapes, act-tools.sop the editing tools (styles,
# alignment, many links at once, insert, merge, split), link-schema.sop and link-geometry.sop where each end of a link
# is attached, its bends, end marks and label place (and the commands that change them). k.colours turns colour names into RGB and says which colours
# are dark; k.styles holds the themes and palettes; k.charts the typical categories of a chart's dimension; k.values the comparatives; k.diagrams (looked up for flowcharts) the usual shape of a role. The layout derives deeply (levels by graph depth, then
# rows, then routes), so the area asks for a derivation depth of 64.
@area.types core.type of=app.area
@area.rules.type core.type of=app.area.rules
@area.make.type core.type of=app.area.make
@area.command.type core.type of=app.area.command
@area.choice.type core.type of=app.area.choice
@area.constant.type core.type of=app.area.constant
@area.draw.type core.type of=app.area.draw
@area.offline.type core.type of=app.area.offline
@area.control.type core.type of=app.area.control
@area.field.type core.type of=app.area.field
@area.lookup.type core.type of=app.area.lookup
@area.subset.type core.type of=app.area.subset

@diagram.area app.area world=diagram.sketch instance=w.diagram instance=w.preferences knowledge=k.colours knowledge=k.styles knowledge=k.charts knowledge=k.values scope="diagram.nodes-links-and-charts" frame.w=1000 frame.h=700 spatial=true depth=64 calls=instance
@diagram.rules.0 app.area.rules area=$diagram.area file="link-schema.sop" n=0
@diagram.rules.1 app.area.rules area=$diagram.area file="render-projection.sop" n=1
@diagram.rules.2 app.area.rules area=$diagram.area file="layout-modes.sop" n=2
@diagram.rules.3 app.area.rules area=$diagram.area file="style-projection.sop" n=3
@diagram.rules.4 app.area.rules area=$diagram.area file="ring-projection.sop" n=4
@diagram.rules.5 app.area.rules area=$diagram.area file="act-rules.sop" n=5
@diagram.rules.6 app.area.rules area=$diagram.area file="act-tools.sop" n=6
@diagram.rules.7 app.area.rules area=$diagram.area file="chart-format.sop" n=7
@diagram.rules.10 app.area.rules area=$diagram.area file="link-geometry.sop" n=10
@diagram.rules.11 app.area.rules area=$diagram.area file="chart-shape.sop" n=11
# k.charts: the typical categories of a dimension (a chart asked for by its dimension alone); k.values: the comparatives
# ("bigger", "thinner") a chart's numeric formatting moves along.
@diagram.subset.charts app.area.subset area=$diagram.area world=k.charts prefix="categories" strict=true
@diagram.subset.values app.area.subset area=$diagram.area world=k.values prefix="scales" strict=true
# Standing preferences (a w.preferences instance beside the diagram): the shared merge rules and this tab's declared keys
# and their effect (preferences.sop: the line style of links, the palette of the page, object IDs).
@diagram.rules.8 app.area.rules area=$diagram.area world=app.project file="preference-rules.sop" n=8
@diagram.rules.9 app.area.rules area=$diagram.area file="preferences.sop" n=9
@diagram.lookup.shapes app.area.lookup area=$diagram.area world=k.diagrams value=flowchart
@diagram.choice.themes app.area.choice area=$diagram.area input="diagram.themes" type=k.styles.theme key=name
@diagram.choice.colours app.area.choice area=$diagram.area input="diagram.colours" type=ui.diagram.colour key=name
@diagram.draw app.area.draw area=$diagram.area draw=ui.diagram.draw fill=ui.diagram.fill point=ui.diagram.point orient=ui.diagram.orient select=slot

@diagram.control.select app.area.control area=$diagram.area n=1 label="Selection" operation="diagram.node.select" param=ids many=true options=node
@diagram.control.label app.area.control area=$diagram.area n=2 label="Label" operation="diagram.node.change" target=selected list=ids when=present options=none
@diagram.field.label app.area.field control=$diagram.control.label n=1 param=label label="Label" input=text
@diagram.control.colour app.area.control area=$diagram.area n=3 label="Colour" operation="diagram.node.change" param=colour target=selected list=ids when=present options=colour
@diagram.control.size app.area.control area=$diagram.area n=4 label="Size" operation="diagram.node.change" param=size target=selected list=ids when=present options=size
@diagram.control.link app.area.control area=$diagram.area n=5 label="Connect to" operation="diagram.link.make" param=to target=selected list=from when=present options=node
@diagram.control.remove app.area.control area=$diagram.area n=6 label="Delete" operation="diagram.node.remove" target=selected list=ids when=present
@diagram.control.clear app.area.control area=$diagram.area n=7 label="Clear diagram" operation="diagram.page.clear"
