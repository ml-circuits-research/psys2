@chart.bar.half.default core.rule when=$cfx.bh.ch not=$cfx.bh.any then=$cfx.bh.d
# A gridline's dashes: fine dashes when the chart names no style.
@cfx.gd.type core.type of=ui.diagram.gdash
@cfx.gd.fine ui.diagram.gdash style=fine dash="3 3"
@cfx.gd.dashed ui.diagram.gdash style=dashed dash="6 4"
