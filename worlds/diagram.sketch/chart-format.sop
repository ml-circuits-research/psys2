@chart.value.text core.rule when=$cfx.vt.i when=$cfx.vt.v not=$cfx.vt.anyp then=$cfx.vt.o2
# A bar's half width: its share of the category's room (56 wide), else 18.
@cfx.bh.type core.type of=ui.diagram.bhalf
@cfx.bh.ch ui.diagram.chart group=?g
@cfx.bh.o ui.diagram.cown group=?g slot=bar_width v=?bw
@cfx.bh.any ui.diagram.cown group=?g slot=bar_width v=?anybw
@cfx.bh.h core.calc out=?h fn=mul args=?bw args=28
