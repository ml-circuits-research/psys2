# ---- The page's background and title (diagram.page.change) ----
@cfx.pc.b app.act.request operation="diagram.page.change" background=?c
@cfx.pc.bo ui.diagram.pageset key=background value=?c
@page.change.background core.rule when=$cfx.pc.b then=$cfx.pc.bo
@cfx.pc.t app.act.request operation="diagram.page.change" title=?t
@cfx.pc.to ui.diagram.pageset key=title value=?t
@page.change.title core.rule when=$cfx.pc.t then=$cfx.pc.to
@cfx.pc.r app.act.request operation="diagram.page.change"
@cfx.pc.n1 app.act.request background=?anyb
@cfx.pc.n2 app.act.request title=?anyt
@cfx.pc.none app.act.refuse reason=missing-property
@page.change.none core.rule when=$cfx.pc.r not=$cfx.pc.n1 not=$cfx.pc.n2 then=$cfx.pc.none
