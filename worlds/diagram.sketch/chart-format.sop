@chart.axis.line.fill core.rule when=$cfx.al.a with=$cfx.al.s then=$cfx.al.f
# The numbers of a linear axis: at its foot and at each quarter of its top.
@cfx.tl.a ui.diagram.axpos group=?g base=?base iy=?iy
@cfx.tl.lin w.diagram.group code=?g axis_scale=log
