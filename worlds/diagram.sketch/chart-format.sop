@chart.axis.left core.rule when=$cfx.ap.a when=$cfx.ap.b when=$cfx.ap.p when=$cfx.ap.d if=$cfx.ap.l with=$cfx.ap.xl1 with=$cfx.ap.xl with=$cfx.ap.b1 with=$cfx.ap.base then=$cfx.ap.out.l
@chart.axis.right core.rule when=$cfx.ap.a when=$cfx.ap.b when=$cfx.ap.p when=$cfx.ap.d if=$cfx.ap.r with=$cfx.ap.xr1 with=$cfx.ap.xr2 with=$cfx.ap.xr with=$cfx.ap.b1 with=$cfx.ap.base then=$cfx.ap.out.r
@cfx.al.a ui.diagram.axpos group=?g x=?x base=?base
