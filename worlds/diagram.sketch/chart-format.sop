@cfx.td.fl ui.diagram.fill source=?src part=?g fill="#52606d"
@chart.tick.draw core.rule when=$cfx.td.t when=$cfx.td.a when=$cfx.td.n when=$cfx.td.fs with=$cfx.td.f with=$cfx.td.x with=$cfx.td.y with=$cfx.td.s then=$cfx.td.d
@chart.tick.fill core.rule when=$cfx.td.t when=$cfx.td.a when=$cfx.td.n with=$cfx.td.s then=$cfx.td.fl

# ---- A value as written on the chart: rounded to its precision when it has one ----
@cfx.vtext.type core.type of=ui.diagram.vtext
@cfx.vt.i ui.diagram.inside group=?g node=?c
@cfx.vt.v w.diagram.node code=?c value=?v
