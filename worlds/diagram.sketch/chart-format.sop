@chart.number.power.top core.aggregate over=$cfx.pe.c by=?v max=?m args=?e then=$cfx.pe.out
@cfx.pw.t ui.diagram.tickv group=?g v=?v
@cfx.pw.f ui.diagram.cfmt group=?g slot=tick_format v=power
