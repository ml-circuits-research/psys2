# diagram.sketch chart formatting (authored): how a chart group is drawn beyond its data, each property a slot of
# w.diagram.group (the catalog's chart formatting slots). One table says, per property, the parameter of
# diagram.chart.format that sets it, its kind (a number or one of named values), its value when the chart has none of
# its own and its limits. The rules are generic over that table: a said number is set within the limits; a comparative
# of k.values ("bigger", "thinner", "wider") moves the chart's current value one step up or down (an inverse property,
# the gap between bars, moves the other way); a word for the usual value ("medium", "normal") sets the table's value;
# a word for none ("off", "none") sets the lower limit (the upper one of an inverse property); a named value is set as
# said. (The declared parameters take numbers for the number properties: a reader's comparative reaches them as the
# execution policy's step from the observed value; the words here serve the gap between bars, a word-valued parameter.) What the chart has is observed as an input of the group (the parameter's name). The value axis (its side, its
# scale, its numbers) and the page's title are drawn here; render-projection.sop, ring-projection.sop and
# style-projection.sop read the resolved values (ui.diagram.cfmt) for fonts, bars, lines, markers, pies and gridlines.
@cfx.cprop.type core.type of=ui.diagram.cprop
@cfx.cown.type core.type of=ui.diagram.cown
@cfx.cfmt.type core.type of=ui.diagram.cfmt
@cfx.cset.type core.type of=ui.diagram.cset
@cfx.cstep.type core.type of=ui.diagram.cstep
@cfx.creset.type core.type of=ui.diagram.creset
@cfx.czero.type core.type of=ui.diagram.czero
@cfx.cmore.type core.type of=ui.diagram.cmore

# ---- The properties: slot, parameter, kind, the usual value, limits; primary=false: another parameter of the slot ----
@cfx.p.font ui.diagram.cprop slot=font_size param=fontSize kind=number base=12 min=6 max=40 inverse=false primary=true
@cfx.p.lw ui.diagram.cprop slot=line_width param=lineWidth kind=number base=2 min=0.5 max=12 inverse=false primary=true
@cfx.p.ms ui.diagram.cprop slot=marker_size param=markerSize kind=number base=12 min=2 max=40 inverse=false primary=true
@cfx.p.me ui.diagram.cprop slot=marker_edge param=markerEdge kind=number base=1.5 min=0 max=8 inverse=false primary=true
@cfx.p.bw ui.diagram.cprop slot=bar_width param=barWidth kind=number base=0.64 min=0.1 max=1 inverse=false primary=true
@cfx.p.bg ui.diagram.cprop slot=bar_width param=barGap kind=number base=0.64 min=0.1 max=1 inverse=true primary=false
@cfx.p.pr ui.diagram.cprop slot=pie_radius param=pieRadius kind=number base=90 min=30 max=300 inverse=false primary=true
@cfx.p.prec ui.diagram.cprop slot=precision param=precision kind=number base=0 min=0 max=4 inverse=false primary=true
@cfx.p.tw ui.diagram.cprop slot=title_weight param=titleWeight kind=enum base=bold primary=true
@cfx.p.tc ui.diagram.cprop slot=title_colour param=titleColour kind=enum base=none primary=true
@cfx.p.tp ui.diagram.cprop slot=title_position param=titlePosition kind=enum base=top_left primary=true
@cfx.p.ya ui.diagram.cprop slot=y_axis param=axisSide kind=enum base=none primary=true
@cfx.p.inv ui.diagram.cprop slot=invert param=invert kind=enum base=none primary=true
@cfx.p.as ui.diagram.cprop slot=axis_scale param=axisScale kind=enum base=linear primary=true
@cfx.p.tf ui.diagram.cprop slot=tick_format param=tickFormat kind=enum base=plain primary=true
@cfx.p.ls ui.diagram.cprop slot=line_style param=lineStyle kind=enum base=solid primary=true
@cfx.p.gs ui.diagram.cprop slot=grid_style param=gridStyle kind=enum base=fine primary=true
# One step up or down: a quarter more, a fifth less (an inverse property the other way round).
@cfx.step.up ui.diagram.cstep way=up inverse=false factor=1.25
@cfx.step.down ui.diagram.cstep way=down inverse=false factor=0.8
@cfx.step.up.inv ui.diagram.cstep way=up inverse=true factor=0.8
@cfx.step.down.inv ui.diagram.cstep way=down inverse=true factor=1.25
# The scales of k.values whose comparatives say more or less of a chart's size, width or thickness.
@cfx.scale.size ui.diagram.cmore name=size
@cfx.scale.width ui.diagram.cmore name=width
@cfx.scale.thickness ui.diagram.cmore name=thickness
@cfx.scale.length ui.diagram.cmore name=length
@cfx.scale.height ui.diagram.cmore name=height
@cfx.scale.distance ui.diagram.cmore name=distance
# Words for the usual value, and for none.
@cfx.reset.medium ui.diagram.creset word=medium
@cfx.reset.normal ui.diagram.creset word=normal
@cfx.reset.default ui.diagram.creset word=default
@cfx.reset.regular ui.diagram.creset word=regular
@cfx.reset.standard ui.diagram.creset word=standard
@cfx.reset.usual ui.diagram.creset word=usual
@cfx.reset.original ui.diagram.creset word=original
@cfx.zero.off ui.diagram.czero word=off
@cfx.zero.none ui.diagram.czero word=none
@cfx.zero.no ui.diagram.czero word=no
@cfx.zero.remove ui.diagram.czero word=remove
@cfx.zero.hide ui.diagram.czero word=hide

# ---- What the chart has of its own, and the value each property resolves to ----
@cfx.o1 w.diagram.group code=?g font_size=?v
@cfx.o1.o ui.diagram.cown group=?g slot=font_size v=?v
@chart.own.font_size core.rule when=$cfx.o1 then=$cfx.o1.o
@cfx.o2 w.diagram.group code=?g line_width=?v
@cfx.o2.o ui.diagram.cown group=?g slot=line_width v=?v
@chart.own.line_width core.rule when=$cfx.o2 then=$cfx.o2.o
@cfx.o3 w.diagram.group code=?g marker_size=?v
@cfx.o3.o ui.diagram.cown group=?g slot=marker_size v=?v
@chart.own.marker_size core.rule when=$cfx.o3 then=$cfx.o3.o
@cfx.o4 w.diagram.group code=?g marker_edge=?v
@cfx.o4.o ui.diagram.cown group=?g slot=marker_edge v=?v
@chart.own.marker_edge core.rule when=$cfx.o4 then=$cfx.o4.o
@cfx.o5 w.diagram.group code=?g bar_width=?v
@cfx.o5.o ui.diagram.cown group=?g slot=bar_width v=?v
@chart.own.bar_width core.rule when=$cfx.o5 then=$cfx.o5.o
@cfx.o6 w.diagram.group code=?g pie_radius=?v
@cfx.o6.o ui.diagram.cown group=?g slot=pie_radius v=?v
@chart.own.pie_radius core.rule when=$cfx.o6 then=$cfx.o6.o
@cfx.o7 w.diagram.group code=?g precision=?v
@cfx.o7.o ui.diagram.cown group=?g slot=precision v=?v
@chart.own.precision core.rule when=$cfx.o7 then=$cfx.o7.o
@cfx.o8 w.diagram.group code=?g title_weight=?v
@cfx.o8.o ui.diagram.cown group=?g slot=title_weight v=?v
@chart.own.title_weight core.rule when=$cfx.o8 then=$cfx.o8.o
@cfx.o9 w.diagram.group code=?g title_colour=?v
@cfx.o9.o ui.diagram.cown group=?g slot=title_colour v=?v
@chart.own.title_colour core.rule when=$cfx.o9 then=$cfx.o9.o
@cfx.o10 w.diagram.group code=?g title_position=?v
@cfx.o10.o ui.diagram.cown group=?g slot=title_position v=?v
@chart.own.title_position core.rule when=$cfx.o10 then=$cfx.o10.o
@cfx.o11 w.diagram.group code=?g y_axis=?v
@cfx.o11.o ui.diagram.cown group=?g slot=y_axis v=?v
@chart.own.y_axis core.rule when=$cfx.o11 then=$cfx.o11.o
@cfx.o12 w.diagram.group code=?g invert=?v
@cfx.o12.o ui.diagram.cown group=?g slot=invert v=?v
@chart.own.invert core.rule when=$cfx.o12 then=$cfx.o12.o
@cfx.o13 w.diagram.group code=?g axis_scale=?v
@cfx.o13.o ui.diagram.cown group=?g slot=axis_scale v=?v
@chart.own.axis_scale core.rule when=$cfx.o13 then=$cfx.o13.o
@cfx.o14 w.diagram.group code=?g tick_format=?v
@cfx.o14.o ui.diagram.cown group=?g slot=tick_format v=?v
@chart.own.tick_format core.rule when=$cfx.o14 then=$cfx.o14.o
@cfx.o15 w.diagram.group code=?g line_style=?v
@cfx.o15.o ui.diagram.cown group=?g slot=line_style v=?v
@chart.own.line_style core.rule when=$cfx.o15 then=$cfx.o15.o
@cfx.o16 w.diagram.group code=?g grid_style=?v
@cfx.o16.o ui.diagram.cown group=?g slot=grid_style v=?v
@chart.own.grid_style core.rule when=$cfx.o16 then=$cfx.o16.o

@cfx.f.o ui.diagram.cown group=?g slot=?s v=?v
@cfx.f.oo ui.diagram.cfmt group=?g slot=?s v=?v
@chart.cfmt.own core.rule when=$cfx.f.o then=$cfx.f.oo
@cfx.f.g w.diagram.group code=?g
@cfx.f.p ui.diagram.cprop slot=?s base=?b primary=true
@cfx.f.any ui.diagram.cown group=?g slot=?s v=?anyv
@cfx.f.bo ui.diagram.cfmt group=?g slot=?s v=?b
@chart.cfmt.base core.rule when=$cfx.f.g when=$cfx.f.p not=$cfx.f.any then=$cfx.f.bo
# Observed under its parameter's name: a number property as it is drawn (its own value or the usual one: the measure a
# comparative steps from), a named property when the chart has one.
@cfx.ob.o ui.diagram.cown group=?g slot=?s v=?v
@cfx.ob.p ui.diagram.cprop slot=?s param=?p kind=enum primary=true
@cfx.ob.out app.observe.input id=?g key=?p value=?v
@observe.chart.format core.rule when=$cfx.ob.o when=$cfx.ob.p then=$cfx.ob.out
@cfx.ob.f ui.diagram.cfmt group=?g slot=?s v=?v
@cfx.ob.n ui.diagram.cprop slot=?s param=?p kind=number primary=true
@cfx.ob.u ui.diagram.unit unit=?g kind=group
@observe.chart.format.number core.rule when=$cfx.ob.f when=$cfx.ob.n when=$cfx.ob.u then=$cfx.ob.out
# The title colour is looked up (render-projection.sop: ui.diagram.rgb).
@cfx.tc.u w.diagram.group title_colour=?c
@cfx.tc.out ui.diagram.usecol c=?c
@chart.use.title_colour core.rule when=$cfx.tc.u then=$cfx.tc.out

# ---- Setting a property (diagram.chart.format) ----
@cfx.q1 app.act.request operation="diagram.chart.format" fontSize=?v
@cfx.q1.o ui.diagram.cset param=fontSize said=?v
@chart.say.fontSize core.rule when=$cfx.q1 then=$cfx.q1.o
@cfx.q2 app.act.request operation="diagram.chart.format" lineWidth=?v
@cfx.q2.o ui.diagram.cset param=lineWidth said=?v
@chart.say.lineWidth core.rule when=$cfx.q2 then=$cfx.q2.o
@cfx.q3 app.act.request operation="diagram.chart.format" markerSize=?v
@cfx.q3.o ui.diagram.cset param=markerSize said=?v
@chart.say.markerSize core.rule when=$cfx.q3 then=$cfx.q3.o
@cfx.q4 app.act.request operation="diagram.chart.format" markerEdge=?v
@cfx.q4.o ui.diagram.cset param=markerEdge said=?v
@chart.say.markerEdge core.rule when=$cfx.q4 then=$cfx.q4.o
@cfx.q5 app.act.request operation="diagram.chart.format" barWidth=?v
@cfx.q5.o ui.diagram.cset param=barWidth said=?v
@chart.say.barWidth core.rule when=$cfx.q5 then=$cfx.q5.o
@cfx.q6 app.act.request operation="diagram.chart.format" barGap=?v
@cfx.q6.o ui.diagram.cset param=barGap said=?v
@chart.say.barGap core.rule when=$cfx.q6 then=$cfx.q6.o
@cfx.q7 app.act.request operation="diagram.chart.format" pieRadius=?v
@cfx.q7.o ui.diagram.cset param=pieRadius said=?v
@chart.say.pieRadius core.rule when=$cfx.q7 then=$cfx.q7.o
@cfx.q8 app.act.request operation="diagram.chart.format" precision=?v
@cfx.q8.o ui.diagram.cset param=precision said=?v
@chart.say.precision core.rule when=$cfx.q8 then=$cfx.q8.o
@cfx.q9 app.act.request operation="diagram.chart.format" titleWeight=?v
@cfx.q9.o ui.diagram.cset param=titleWeight said=?v
@chart.say.titleWeight core.rule when=$cfx.q9 then=$cfx.q9.o
@cfx.q10 app.act.request operation="diagram.chart.format" titleColour=?v
@cfx.q10.o ui.diagram.cset param=titleColour said=?v
@chart.say.titleColour core.rule when=$cfx.q10 then=$cfx.q10.o
@cfx.q11 app.act.request operation="diagram.chart.format" titlePosition=?v
@cfx.q11.o ui.diagram.cset param=titlePosition said=?v
@chart.say.titlePosition core.rule when=$cfx.q11 then=$cfx.q11.o
@cfx.q12 app.act.request operation="diagram.chart.format" axisSide=?v
@cfx.q12.o ui.diagram.cset param=axisSide said=?v
@chart.say.axisSide core.rule when=$cfx.q12 then=$cfx.q12.o
@cfx.q13 app.act.request operation="diagram.chart.format" invert=?v
@cfx.q13.o ui.diagram.cset param=invert said=?v
@chart.say.invert core.rule when=$cfx.q13 then=$cfx.q13.o
@cfx.q14 app.act.request operation="diagram.chart.format" axisScale=?v
@cfx.q14.o ui.diagram.cset param=axisScale said=?v
@chart.say.axisScale core.rule when=$cfx.q14 then=$cfx.q14.o
@cfx.q15 app.act.request operation="diagram.chart.format" tickFormat=?v
@cfx.q15.o ui.diagram.cset param=tickFormat said=?v
@chart.say.tickFormat core.rule when=$cfx.q15 then=$cfx.q15.o
@cfx.q16 app.act.request operation="diagram.chart.format" lineStyle=?v
@cfx.q16.o ui.diagram.cset param=lineStyle said=?v
@chart.say.lineStyle core.rule when=$cfx.q16 then=$cfx.q16.o
@cfx.q17 app.act.request operation="diagram.chart.format" gridStyle=?v
@cfx.q17.o ui.diagram.cset param=gridStyle said=?v
@chart.say.gridStyle core.rule when=$cfx.q17 then=$cfx.q17.o

@cfx.s.r app.act.request operation="diagram.chart.format" id=?g
@cfx.s.g w.diagram.group code=?g
@cfx.s.s ui.diagram.cset param=?p said=?v
# A named value is set as said (the declared parameter's closed list has admitted it).
@cfx.s.pe ui.diagram.cprop param=?p slot=?s kind=enum
@cfx.s.ce app.act.call act=change thing=$cfx.s.g attr=?s value=?v order=1
@chart.set.named core.rule when=$cfx.s.r when=$cfx.s.g when=$cfx.s.s when=$cfx.s.pe then=$cfx.s.ce
# A number, within the limits (a said number may come as text: lower() gives it back as a number).
@cfx.s.pn ui.diagram.cprop param=?p slot=?s kind=number base=?b min=?lo max=?hi inverse=?inv
@cfx.s.isn core.check fn=matches args=?v args="^[0-9.]+$"
@cfx.s.n core.calc out=?n fn=lower args=?v
@cfx.s.k core.calc out=?k fn=clamp args=?n args=?lo args=?hi
@cfx.s.cn app.act.call act=change thing=$cfx.s.g attr=?s value=?k order=1
@chart.set.number core.rule when=$cfx.s.r when=$cfx.s.g when=$cfx.s.s when=$cfx.s.pn if=$cfx.s.isn with=$cfx.s.n with=$cfx.s.k then=$cfx.s.cn
# A comparative: one step from what the chart has now.
@cfx.s.cmp k.values.comparative text=?v scale=?sc way=?w degree=comparative
@cfx.s.sc ui.diagram.cmore name=?sc
@cfx.s.st ui.diagram.cstep way=?w inverse=?inv factor=?f
@cfx.s.cur ui.diagram.cfmt group=?g slot=?s v=?cur
@cfx.s.m core.calc out=?m fn=mul args=?cur args=?f
@cfx.s.mk core.calc out=?mk fn=clamp args=?m args=?lo args=?hi
@cfx.s.mr core.calc out=?mr fn=round args=?mk args=3
@cfx.s.cd app.act.call act=change thing=$cfx.s.g attr=?s value=?mr order=1
@chart.set.step core.rule when=$cfx.s.r when=$cfx.s.g when=$cfx.s.s when=$cfx.s.pn when=$cfx.s.cmp when=$cfx.s.sc when=$cfx.s.st when=$cfx.s.cur with=$cfx.s.m with=$cfx.s.mk with=$cfx.s.mr then=$cfx.s.cd
# The usual value; none.
@cfx.s.rs ui.diagram.creset word=?v
@cfx.s.cb app.act.call act=change thing=$cfx.s.g attr=?s value=?b order=1
@chart.set.usual core.rule when=$cfx.s.r when=$cfx.s.g when=$cfx.s.s when=$cfx.s.pn when=$cfx.s.rs then=$cfx.s.cb
@cfx.s.zr ui.diagram.czero word=?v
@cfx.s.pz ui.diagram.cprop param=?p slot=?s kind=number min=?lo max=?hi inverse=false
@cfx.s.pzi ui.diagram.cprop param=?p slot=?s kind=number min=?lo max=?hi inverse=true
@cfx.s.cz app.act.call act=change thing=$cfx.s.g attr=?s value=?lo order=1
@cfx.s.czi app.act.call act=change thing=$cfx.s.g attr=?s value=?hi order=1
@chart.set.none core.rule when=$cfx.s.r when=$cfx.s.g when=$cfx.s.s when=$cfx.s.pz when=$cfx.s.zr then=$cfx.s.cz
@chart.set.none.inverse core.rule when=$cfx.s.r when=$cfx.s.g when=$cfx.s.s when=$cfx.s.pzi when=$cfx.s.zr then=$cfx.s.czi
# A word for a number property that is none of these is refused, never guessed.
@cfx.s.anycmp k.values.comparative text=?v scale=?anysc degree=comparative
@cfx.s.out app.act.refuse reason=unknown-degree
@cfx.s.word core.check fn=matches args=?v args="[^0-9.]"
@chart.set.unknown core.rule when=$cfx.s.r when=$cfx.s.s when=$cfx.s.pn if=$cfx.s.word not=$cfx.s.anycmp not=$cfx.s.rs not=$cfx.s.zr then=$cfx.s.out

# ---- The value axis: drawn when the chart has a side for it, a scale or a number format ----
@cfx.yax.type core.type of=ui.diagram.yaxis
@cfx.ya.c ui.diagram.chart group=?g
@cfx.ya.own w.diagram.group code=?g y_axis=?side
@cfx.ya.out ui.diagram.yaxis group=?g side=?side
@chart.axis.side core.rule when=$cfx.ya.c when=$cfx.ya.own then=$cfx.ya.out
@cfx.ya.any w.diagram.group code=?g y_axis=?anyside
@cfx.ya.sc w.diagram.group code=?g axis_scale=?anysc
@cfx.ya.tf w.diagram.group code=?g tick_format=?anytf
@cfx.ya.left ui.diagram.yaxis group=?g side=left
@chart.axis.scale core.rule when=$cfx.ya.c when=$cfx.ya.sc not=$cfx.ya.any then=$cfx.ya.left
@chart.axis.format core.rule when=$cfx.ya.c when=$cfx.ya.tf not=$cfx.ya.any then=$cfx.ya.left
# An axis drawn the other way: x the categories from the right (ix=1), y the values from the top (iy=1).
@cfx.cinv.type core.type of=ui.diagram.cinv
@cfx.inv.none ui.diagram.cinv value=none ix=0 iy=0
@cfx.inv.x ui.diagram.cinv value=x ix=1 iy=0
@cfx.inv.y ui.diagram.cinv value=y iy=1 ix=0
@cfx.cdir.type core.type of=ui.diagram.cdir
@cfx.cd.f ui.diagram.cfmt group=?g slot=invert v=?iv
@cfx.cd.t ui.diagram.cinv value=?iv ix=?ix iy=?iy
@cfx.cd.out ui.diagram.cdir group=?g ix=?ix iy=?iy
@chart.direction core.rule when=$cfx.cd.f when=$cfx.cd.t then=$cfx.cd.out
# A member's column as drawn: its own, or counted from the right.
@cfx.ccol.type core.type of=ui.diagram.ccol
@cfx.cc.p ui.diagram.mpos node=?c group=?g col=?col
@cfx.cc.ch ui.diagram.chart group=?g
@cfx.cc.d ui.diagram.cdir group=?g ix=?ix
@cfx.cc.n ui.diagram.gstat group=?g key=count value=?n
@cfx.cc.a core.calc out=?a fn=sub args=?n args=1
@cfx.cc.b core.calc out=?b fn=mul args=?col args=2
@cfx.cc.e core.calc out=?e fn=sub args=?a args=?b
@cfx.cc.f core.calc out=?f fn=mul args=?ix args=?e
@cfx.cc.dc core.calc out=?dc fn=add args=?col args=?f
@cfx.cc.out ui.diagram.ccol node=?c col=?dc
@chart.column core.rule when=$cfx.cc.p when=$cfx.cc.ch when=$cfx.cc.d when=$cfx.cc.n with=$cfx.cc.a with=$cfx.cc.b with=$cfx.cc.e with=$cfx.cc.f with=$cfx.cc.dc then=$cfx.cc.out

# ---- Logarithms for a log scale (log10 from powers of ten and a table of mantissas, interpolated) ----
@cfx.pow.type core.type of=ui.diagram.pow10
@cfx.pow.0 ui.diagram.pow10 e=0 p=1 sup="⁰"
@cfx.pow.1 ui.diagram.pow10 e=1 p=10 sup="¹"
@cfx.pow.2 ui.diagram.pow10 e=2 p=100 sup="²"
@cfx.pow.3 ui.diagram.pow10 e=3 p=1000 sup="³"
@cfx.pow.4 ui.diagram.pow10 e=4 p=10000 sup="⁴"
@cfx.pow.5 ui.diagram.pow10 e=5 p=100000 sup="⁵"
@cfx.pow.6 ui.diagram.pow10 e=6 p=1000000 sup="⁶"
@cfx.pow.7 ui.diagram.pow10 e=7 p=10000000 sup="⁷"
@cfx.pow.8 ui.diagram.pow10 e=8 p=100000000 sup="⁸"
@cfx.pow.9 ui.diagram.pow10 e=9 p=1000000000 sup="⁹"
@cfx.lm.type core.type of=ui.diagram.lmant
@cfx.lm.1 ui.diagram.lmant m=1 l=0 next=0.30103
@cfx.lm.2 ui.diagram.lmant m=2 l=0.30103 next=0.47712
@cfx.lm.3 ui.diagram.lmant m=3 l=0.47712 next=0.60206
@cfx.lm.4 ui.diagram.lmant m=4 l=0.60206 next=0.69897
@cfx.lm.5 ui.diagram.lmant m=5 l=0.69897 next=0.77815
@cfx.lm.6 ui.diagram.lmant m=6 l=0.77815 next=0.84510
@cfx.lm.7 ui.diagram.lmant m=7 l=0.84510 next=0.90309
@cfx.lm.8 ui.diagram.lmant m=8 l=0.90309 next=0.95424
@cfx.lm.9 ui.diagram.lmant m=9 l=0.95424 next=1
@cfx.lgneed.type core.type of=ui.diagram.lgneed
@cfx.lgc.type core.type of=ui.diagram.lgc
@cfx.lge.type core.type of=ui.diagram.lge
