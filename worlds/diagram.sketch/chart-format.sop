@cfx.pw.o2 ui.diagram.ntext group=?g v=?v text=?t2
@chart.number.power.ten core.rule when=$cfx.pw.t when=$cfx.pw.f when=$cfx.pw.e when=$cfx.pw.p with=$cfx.pw.m with=$cfx.pw.mr if=$cfx.pw.one with=$cfx.pw.t1 then=$cfx.pw.o1
@chart.number.power core.rule when=$cfx.pw.t when=$cfx.pw.f when=$cfx.pw.e when=$cfx.pw.p with=$cfx.pw.m with=$cfx.pw.mr if=$cfx.pw.notone with=$cfx.pw.t2 then=$cfx.pw.o2
@cfx.td.t ui.diagram.tickv group=?g k=?k v=?v y=?ty
