@chart.number.thousands core.rule when=$cfx.nt.t when=$cfx.nt.f if=$cfx.nt.ismag if=$cfx.nt.m3 if=$cfx.nt.lt6 with=$cfx.nt.d3 with=$cfx.nt.d3r with=$cfx.nt.t3 then=$cfx.nt.om3
@chart.number.units core.rule when=$cfx.nt.t when=$cfx.nt.f if=$cfx.nt.ismag if=$cfx.nt.lt3 with=$cfx.nt.r2 then=$cfx.nt.o2
@cfx.nt.ispow core.check fn=eq args=?tf args=power
