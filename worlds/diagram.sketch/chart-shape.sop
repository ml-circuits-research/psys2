# ---- Scatter: each member a point at its x_value (its place among the categories when it has none) and its value ----
# A scatter chart is a chart (ui.diagram.chart form=scatter): it shares the value axis, the floor, the gridlines, the
# baseline and the labels of bar and line charts; its x positions are its members' x values spread over the plot's
# width (from the smallest to the largest), its points as large as the chart's marker size, no line between them.
@shp.sx.g w.diagram.group code=?g layout=scatter
@shp.sx.out ui.diagram.chart group=?g form=scatter
@chart.scatter core.rule when=$shp.sx.g then=$shp.sx.out
@shp.xv.type core.type of=ui.diagram.xv
@shp.xr.type core.type of=ui.diagram.xr
@shp.xv.p ui.diagram.mpos node=?c group=?g pos=?p
@shp.xv.c ui.diagram.chart group=?g form=scatter
@shp.xv.own w.diagram.node code=?c x_value=?x
@shp.xv.any w.diagram.node code=?c x_value=?anyx
@shp.xv.o ui.diagram.xv node=?c group=?g x=?x
@shp.xv.op ui.diagram.xv node=?c group=?g x=?p
@chart.scatter.x core.rule when=$shp.xv.p when=$shp.xv.c when=$shp.xv.own then=$shp.xv.o
