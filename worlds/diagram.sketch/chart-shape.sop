@chart.share.percent core.rule when=$shp.pc.c when=$shp.pc.i when=$shp.pc.v when=$shp.pc.t if=$shp.pc.pos with=$shp.pc.f then=$shp.pc.out
# A category's centre on a standing chart.
@shp.cx.p ui.diagram.mpos node=?c group=?g
@shp.cx.cc ui.diagram.ccol node=?c col=?col
