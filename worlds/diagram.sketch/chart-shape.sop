@chart.top core.aggregate over=$shp.tp.c by=?g max=?m args=?v then=$shp.tp.out
# Shares: a member's bar is its share of its category's total.
@shp.pc.c ui.diagram.cstack group=?g mode=percent
@shp.pc.i ui.diagram.inside group=?g node=?c
@shp.pc.v w.diagram.node code=?c value=?v
@shp.pc.t ui.diagram.ctotal node=?c v=?t
