@shp.bs.notnone core.check fn=neq args=?sm args=none
@chart.slots.stacked core.rule when=$shp.bs.cc when=$shp.bs.h when=$shp.bs.anyser when=$shp.bs.stk if=$shp.bs.notnone then=$shp.bs.one
@shp.bs.notbar ui.diagram.chart group=?g form=line
@chart.slots.line core.rule when=$shp.bs.notbar when=$shp.bs.h when=$shp.bs.anyser then=$shp.bs.one
