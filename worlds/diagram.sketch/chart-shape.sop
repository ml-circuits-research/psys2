@chart.radar.anchor.right core.rule when=$shp.rl.ak.s when=$shp.rl.ak.t if=$shp.rl.ak.r then=$shp.rl.ak.or
@chart.radar.anchor.left core.rule when=$shp.rl.ak.s when=$shp.rl.ak.t if=$shp.rl.ak.l then=$shp.rl.ak.ol
