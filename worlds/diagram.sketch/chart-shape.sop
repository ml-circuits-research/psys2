@chart.treemap.size core.rule when=$shp.tu.u when=$shp.tu.t when=$shp.tu.p with=$shp.tu.p2 with=$shp.tu.w with=$shp.tu.h1 with=$shp.tu.h2 with=$shp.tu.h then=$shp.tu.out
# Its members with a value, their total, and the values before each one in order.
@shp.tv.t ui.diagram.treemap group=?g
@shp.tv.i ui.diagram.inside group=?g node=?c
@shp.tv.v w.diagram.node code=?c value=?v
@shp.tv.pos core.check fn=gt args=?v args=0
@shp.tv.out ui.diagram.tmmember node=?c group=?g v=?v
@chart.treemap.member core.rule when=$shp.tv.t when=$shp.tv.i when=$shp.tv.v if=$shp.tv.pos then=$shp.tv.out
