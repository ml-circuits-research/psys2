@shp.rl.y1 core.calc out=?ly1 fn=add args=?cy args=?dy
@shp.rl.y core.calc out=?ly fn=add args=?ly1 args=4
@shp.rl.src core.calc out=?src fn=concat args=?c args=".label"
# A label right of the centre starts at its spoke's end, one left of it ends there, one above or below is centred.
@shp.rl.ranchor.type core.type of=ui.diagram.ranchor
@shp.rl.ak.t ui.diagram.trig deg=?deg c=?co
@shp.rl.ak.r core.check fn=gt args=?co args=0.3
