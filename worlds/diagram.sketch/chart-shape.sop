@shp.bs.out ui.diagram.bslot group=?g h=?hk off=?off
@chart.slots.side core.rule when=$shp.bs.c when=$shp.bs.n when=$shp.bs.m when=$shp.bs.h with=$shp.bs.k with=$shp.bs.hk with=$shp.bs.k1 with=$shp.bs.o1 with=$shp.bs.off then=$shp.bs.out
@shp.bs.cc ui.diagram.chart group=?g
