@shp.ac2.r ui.diagram.radar group=?g
@chart.any.radar core.rule when=$shp.ac2.r then=$shp.ac2.out
# ---- Treemap: each member a rectangle as large as its share of the whole (the sum of the members' values), the
# rectangles filling the plot from left to right in the order the members were made (a slice layout: one strip). The
# plot is the chart's width and height when set, else 360 by 220. Each member is coloured from the page's palette
# (its own colour first), labelled in its middle with its value under the label, and observed as a chart point. ----
@shp.tm.type core.type of=ui.diagram.treemap
@shp.tmm.type core.type of=ui.diagram.tmmember
@shp.tmt.type core.type of=ui.diagram.tmtotal
@shp.tmb.type core.type of=ui.diagram.tmbefore
@shp.tmc.type core.type of=ui.diagram.tmcum
@shp.tm.g w.diagram.group code=?g layout=treemap
@shp.tm.w w.diagram.group code=?g width=?w
@shp.tm.h w.diagram.group code=?g height=?h
@shp.tm.anyw w.diagram.group code=?g width=?anyw
@shp.tm.anyh w.diagram.group code=?g height=?anyh
@shp.tm.o1 ui.diagram.treemap group=?g w=?w h=?h
@shp.tm.o2 ui.diagram.treemap group=?g w=?w h=220
@shp.tm.o3 ui.diagram.treemap group=?g w=360 h=?h
@shp.tm.o4 ui.diagram.treemap group=?g w=360 h=220
@chart.treemap.sized core.rule when=$shp.tm.g when=$shp.tm.w when=$shp.tm.h then=$shp.tm.o1
@chart.treemap.wide core.rule when=$shp.tm.g when=$shp.tm.w not=$shp.tm.anyh then=$shp.tm.o2
@chart.treemap.tall core.rule when=$shp.tm.g when=$shp.tm.h not=$shp.tm.anyw then=$shp.tm.o3
@chart.treemap core.rule when=$shp.tm.g not=$shp.tm.anyw not=$shp.tm.anyh then=$shp.tm.o4
# Its size: the plot, the padding round it and the title band over it.
@shp.tu.u ui.diagram.unit unit=?g kind=group
@shp.tu.t ui.diagram.treemap group=?g w=?pw h=?ph
