@shp.cu.o2 ui.diagram.dcum node=?c r=?r v=?a
@chart.cumulative.next core.rule when=$shp.cu.mm when=$shp.cu.sr with=$shp.cu.r1 when=$shp.cu.prev if=$shp.cu.at when=$shp.cu.dv with=$shp.cu.sum then=$shp.cu.o1
@chart.cumulative.gap core.rule when=$shp.cu.mm when=$shp.cu.sr with=$shp.cu.r1 when=$shp.cu.prev if=$shp.cu.at not=$shp.cu.anyd then=$shp.cu.o2
