@shp.clast.type core.type of=ui.diagram.clast
@series.chart.newest core.aggregate over=$shp.sc.cg over=$shp.sc.gn max=?ln args=?gn then=$shp.sc.last
@shp.sc.is core.check fn=eq args=?gn args=?ln
@series.chart.last core.rule when=$shp.sc.op when=$shp.sc.r0 not=$shp.sc.anyc when=$shp.sc.cg when=$shp.sc.gn when=$shp.sc.last if=$shp.sc.is then=$shp.sc.outl
