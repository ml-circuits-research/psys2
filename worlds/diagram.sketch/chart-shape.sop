@shp.bslot.type core.type of=ui.diagram.bslot
@shp.dcum.type core.type of=ui.diagram.dcum
@shp.ctotal.type core.type of=ui.diagram.ctotal
@shp.ccand.type core.type of=ui.diagram.ccand
@shp.ctop.type core.type of=ui.diagram.ctop
@shp.catx.type core.type of=ui.diagram.catx
