@shp.tl.out ui.diagram.draw part=?c source=?src slot=?c order=4 z=0 shape=text text=?v x=?cx y=?ty w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left anchor=middle font=?f
@shp.tl.fill ui.diagram.fill source=?src part=?c fill=?ink
@chart.treemap.value core.rule when=$shp.tl.m when=$shp.tl.t when=$shp.tl.b when=$shp.tl.fs with=$shp.tl.d with=$shp.tl.y with=$shp.tl.f with=$shp.tl.src then=$shp.tl.out
@chart.treemap.value.fill core.rule when=$shp.tl.m when=$shp.tl.t when=$shp.tl.ink with=$shp.tl.src then=$shp.tl.fill
@shp.tmp.m ui.diagram.tmmember node=?c group=?g
@shp.tmp.out ui.diagram.cpoint node=?c group=?g
@chart.point.treemap core.rule when=$shp.tmp.m then=$shp.tmp.out
@shp.ac2.t ui.diagram.treemap group=?g
@chart.any.treemap core.rule when=$shp.ac2.t then=$shp.ac2.out
