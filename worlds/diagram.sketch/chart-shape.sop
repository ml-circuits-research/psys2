@chart.category.place core.rule when=$shp.cps.i when=$shp.cps.c with=$shp.cps.rk then=$shp.cps.out
# Every kind of chart (bars, lines, scatter, slices, radar) is a chart a series or a point command can name.
@shp.anychart.type core.type of=ui.diagram.anychart
