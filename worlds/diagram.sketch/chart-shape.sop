@shp.cp.s ui.diagram.slicemember node=?c group=?g
@chart.point.slice core.rule when=$shp.cp.s then=$shp.cp.out
@shp.op.p ui.diagram.cpoint node=?id group=?g
@shp.op.n w.diagram.node code=?id
@shp.op.b ui.diagram.nbox node=?id cx=?x cy=?y w=?w h=?h
@shp.op.gl w.diagram.group code=?g label=?gl
@shp.op.out app.observe.object id=?id kind=point sourceType=diagram.sketch.point binding=diagram.point x=?x y=?y width=?w height=?h selected=false
@observe.point core.rule when=$shp.op.p when=$shp.op.n when=$shp.op.b then=$shp.op.out
@shp.op.co app.observe.input id=?id key=chart value=?gl
@observe.point.chart core.rule when=$shp.op.p when=$shp.op.gl then=$shp.op.co
# Its place among its chart's categories, from 1 ("the third bar", "the first month").
@shp.op.ix ui.diagram.cpos node=?id group=?g pos=?p
@shp.op.ixo app.observe.input id=?id key=index value=?p
@observe.point.index core.rule when=$shp.op.p when=$shp.op.ix then=$shp.op.ixo
@shp.pa.r app.act.request operation="diagram.chart.point.add" label=?l value=?v
@shp.pa.c ui.diagram.schart group=?g
@shp.pa.g w.diagram.group code=?g
@shp.pa.nx ui.diagram.next of=node top=?top
@shp.pa.z core.calc out=?z fn=add args=?top args=1
@shp.pa.code core.calc out=?code fn=concat args=n args=?z
