@lk.lg.oface.left core.rule when=$lk.go.w when=$lk.go.au when=$lk.go.ai with=$lk.go.dx with=$lk.go.dy with=$lk.go.adx with=$lk.go.ady if=$lk.go.across if=$lk.go.nx then=$lk.go.fl
