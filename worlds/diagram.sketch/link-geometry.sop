@lk.go.n3 ui.diagram.snorm side=left nx=-1 ny=0 o=h
@lk.go.n4 ui.diagram.snorm side=right nx=1 ny=0 o=h
@lk.go.n5 ui.diagram.snorm side=free nx=0 ny=0 o=free
@lk.go.se ui.diagram.oend edge=?e at=?at side=?s x=?x y=?y
@lk.go.sn ui.diagram.snorm side=?s nx=?nx ny=?ny o=?o
@lk.go.sx1 core.calc out=?sx1 fn=mul args=?nx args=16
@lk.go.sy1 core.calc out=?sy1 fn=mul args=?ny args=16
@lk.go.sx core.calc out=?sx fn=add args=?x args=?sx1
@lk.go.sy core.calc out=?sy fn=add args=?y args=?sy1
@lk.go.so ui.diagram.stub edge=?e at=?at x=?sx y=?sy nx=?nx ny=?ny o=?o
@lk.lg.stub core.rule when=$lk.go.se when=$lk.go.sn with=$lk.go.sx1 with=$lk.go.sy1 with=$lk.go.sx with=$lk.go.sy then=$lk.go.so
@lk.go.sd ui.diagram.stub edge=?e at=?at o=?o
@lk.go.sided core.check fn=neq args=?o args=free
@lk.go.sdo ui.diagram.sided edge=?e at=?at
@lk.lg.sided core.rule when=$lk.go.sd if=$lk.go.sided then=$lk.go.sdo
# The pieces: the first starts at the source's stub, the last ends at the target's; between bends they are free.
@lk.gs2.v ui.diagram.mv edge=?e i=?i x=?ax y=?ay
@lk.gs2.vn ui.diagram.mvn edge=?e prev=?i x=?bx y=?by
@lk.gs2.last ui.diagram.mlast edge=?e i=?l
@lk.gs2.sa ui.diagram.stub edge=?e at=a x=?sax y=?say nx=?anx ny=?any o=?oa
@lk.gs2.sb ui.diagram.stub edge=?e at=b x=?sbx y=?sby nx=?bnx ny=?bny o=?ob
@lk.gs2.first core.check fn=eq args=?i args=0
@lk.gs2.notfirst core.check fn=neq args=?i args=0
@lk.gs2.i1 core.calc out=?i1 fn=add args=?i args=1
@lk.gs2.islast core.check fn=eq args=?i1 args=?l
@lk.gs2.notlast core.check fn=neq args=?i1 args=?l
@lk.gs2.o1 ui.diagram.opiece edge=?e i=?i ax=?sax ay=?say oa=?oa anx=?anx any=?any bx=?sbx by=?sby ob=?ob bnx=?bnx bny=?bny
@lk.gs2.o2 ui.diagram.opiece edge=?e i=?i ax=?sax ay=?say oa=?oa anx=?anx any=?any bx=?bx by=?by ob=free bnx=0 bny=0
@lk.gs2.o3 ui.diagram.opiece edge=?e i=?i ax=?ax ay=?ay oa=free anx=0 any=0 bx=?sbx by=?sby ob=?ob bnx=?bnx bny=?bny
@lk.gs2.o4 ui.diagram.opiece edge=?e i=?i ax=?ax ay=?ay oa=free anx=0 any=0 bx=?bx by=?by ob=free bnx=0 bny=0
@lk.lg.opiece.only core.rule when=$lk.go.w when=$lk.gs2.v when=$lk.gs2.vn when=$lk.gs2.last when=$lk.gs2.sa when=$lk.gs2.sb if=$lk.gs2.first with=$lk.gs2.i1 if=$lk.gs2.islast then=$lk.gs2.o1
@lk.lg.opiece.first core.rule when=$lk.go.w when=$lk.gs2.v when=$lk.gs2.vn when=$lk.gs2.last when=$lk.gs2.sa if=$lk.gs2.first with=$lk.gs2.i1 if=$lk.gs2.notlast then=$lk.gs2.o2
@lk.lg.opiece.last core.rule when=$lk.go.w when=$lk.gs2.v when=$lk.gs2.vn when=$lk.gs2.last when=$lk.gs2.sb if=$lk.gs2.notfirst with=$lk.gs2.i1 if=$lk.gs2.islast then=$lk.gs2.o3
@lk.lg.opiece.middle core.rule when=$lk.go.w when=$lk.gs2.v when=$lk.gs2.vn when=$lk.gs2.last if=$lk.gs2.notfirst with=$lk.gs2.i1 if=$lk.gs2.notlast then=$lk.gs2.o4
# A stub that faces away from where the piece goes turns: the piece leaves it (enters it) the other way.
@lk.ge2.p ui.diagram.opiece edge=?e i=?i ax=?ax ay=?ay oa=?oa anx=?anx any=?any bx=?bx by=?by ob=?ob bnx=?bnx bny=?bny
@lk.ge2.dx core.calc out=?dx fn=sub args=?bx args=?ax
@lk.ge2.dy core.calc out=?dy fn=sub args=?by args=?ay
