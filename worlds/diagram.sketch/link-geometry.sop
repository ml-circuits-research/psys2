@lk.gu.last core.check fn=eq args=?j args=?cn
@lk.gu.j1 core.calc out=?j1 fn=add args=?j args=1
@lk.gu.jq core.calc out=?jq fn=mul args=?j1 args=100
@lk.gu.pq ui.diagram.point source=?e n=?jq x=?bx y=?by
@lk.lg.curve.end core.rule when=$lk.gu.p when=$lk.gu.cn if=$lk.gu.last with=$lk.gu.j1 with=$lk.gu.jq then=$lk.gu.pq
