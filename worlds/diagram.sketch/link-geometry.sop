@lk.lg.ortho.leg.tail.sideways core.rule when=$lk.gy.f not=$lk.gy.sda if=$lk.gy.first with=$lk.gy.dx with=$lk.gy.dy with=$lk.gy.ex with=$lk.gy.ey if=$lk.gy.lside with=$lk.gy.ts1 with=$lk.gy.ts2 with=$lk.gy.ts3 then=$lk.gy.ts.o
