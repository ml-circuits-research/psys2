@lk.lg.bowc core.rule when=$lk.cb.m when=$lk.cb.a when=$lk.cb.b when=$lk.cb.po when=$lk.cb.f not=$lk.cb.any with=$lk.cb.fo with=$lk.cb.fe with=$lk.cb.dx with=$lk.cb.dy with=$lk.cb.mx1 with=$lk.cb.my1 with=$lk.cb.mx with=$lk.cb.my with=$lk.cb.ox with=$lk.cb.oy0 with=$lk.cb.oy with=$lk.cb.cx with=$lk.cb.cy then=$lk.cb.o
@lk.cs.c ui.diagram.bowc edge=?e f=?f cx=?cx cy=?cy px=?px py=?py qx=?qx qy=?qy
@lk.cs.z ui.diagram.bez k=?k a=?a b=?b c=?c
