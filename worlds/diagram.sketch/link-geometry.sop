@lk.ge2.fb2 core.calc out=?fb fn=mul args=?dy args=?bny
@lk.ge2.back core.check fn=lt args=?f args=0
@lk.ge2.ahead core.check fn=gte args=?f args=0
@lk.ge2.isah core.check fn=eq args=?oa args=h
@lk.ge2.isav core.check fn=eq args=?oa args=v
@lk.ge2.isaf core.check fn=eq args=?oa args=free
@lk.ge2.isbh core.check fn=eq args=?ob args=h
@lk.ge2.isbv core.check fn=eq args=?ob args=v
@lk.ge2.isbf core.check fn=eq args=?ob args=free
@lk.ge2.fab core.check fn=lt args=?fa args=0
@lk.ge2.faa core.check fn=gte args=?fa args=0
@lk.ge2.fbb core.check fn=gt args=?fb args=0
@lk.ge2.fba core.check fn=lte args=?fb args=0
@lk.ge2.ah ui.diagram.oeff edge=?e i=?i at=a o=h
@lk.ge2.av ui.diagram.oeff edge=?e i=?i at=a o=v
@lk.ge2.af ui.diagram.oeff edge=?e i=?i at=a o=free
@lk.ge2.bh ui.diagram.oeff edge=?e i=?i at=b o=h
@lk.ge2.bv ui.diagram.oeff edge=?e i=?i at=b o=v
@lk.ge2.bf ui.diagram.oeff edge=?e i=?i at=b o=free
@lk.lg.oeff.a.h core.rule when=$lk.ge2.p if=$lk.ge2.isah with=$lk.ge2.dx with=$lk.ge2.fa1 if=$lk.ge2.faa then=$lk.ge2.ah
@lk.lg.oeff.a.h.turn core.rule when=$lk.ge2.p if=$lk.ge2.isah with=$lk.ge2.dx with=$lk.ge2.fa1 if=$lk.ge2.fab then=$lk.ge2.av
@lk.lg.oeff.a.v core.rule when=$lk.ge2.p if=$lk.ge2.isav with=$lk.ge2.dy with=$lk.ge2.fa2 if=$lk.ge2.faa then=$lk.ge2.av
@lk.lg.oeff.a.v.turn core.rule when=$lk.ge2.p if=$lk.ge2.isav with=$lk.ge2.dy with=$lk.ge2.fa2 if=$lk.ge2.fab then=$lk.ge2.ah
@lk.lg.oeff.a.free core.rule when=$lk.ge2.p if=$lk.ge2.isaf then=$lk.ge2.af
@lk.lg.oeff.b.h core.rule when=$lk.ge2.p if=$lk.ge2.isbh with=$lk.ge2.dx with=$lk.ge2.fb1 if=$lk.ge2.fba then=$lk.ge2.bh
@lk.lg.oeff.b.h.turn core.rule when=$lk.ge2.p if=$lk.ge2.isbh with=$lk.ge2.dx with=$lk.ge2.fb1 if=$lk.ge2.fbb then=$lk.ge2.bv
@lk.lg.oeff.b.v core.rule when=$lk.ge2.p if=$lk.ge2.isbv with=$lk.ge2.dy with=$lk.ge2.fb2 if=$lk.ge2.fba then=$lk.ge2.bv
@lk.lg.oeff.b.v.turn core.rule when=$lk.ge2.p if=$lk.ge2.isbv with=$lk.ge2.dy with=$lk.ge2.fb2 if=$lk.ge2.fbb then=$lk.ge2.bh
@lk.lg.oeff.b.free core.rule when=$lk.ge2.p if=$lk.ge2.isbf then=$lk.ge2.bf
@lk.ge2.q ui.diagram.opiece edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by
@lk.ge2.ea ui.diagram.oeff edge=?e i=?i at=a o=?oa
@lk.ge2.eb ui.diagram.oeff edge=?e i=?i at=b o=?ob
@lk.ge2.out ui.diagram.oseg edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by a=?oa b=?ob
@lk.lg.oseg core.rule when=$lk.ge2.q when=$lk.ge2.ea when=$lk.ge2.eb then=$lk.ge2.out
# ---- The router: each piece takes the way of least cost among its candidates ----
# A candidate: one turn (hv: sideways then across; vh: across then sideways) or two turns at a corridor c (hvh: across
# at x = c; vhv: sideways at y = c). First the four plain ones (two turns halfway); then, for a piece whose plain ways
# cross a node, corridors 24 beyond each side of every node they cross. Its cost: 10000 per node one of its runs passes
# through or within 6 of, 400 per end left or entered against the way its stub faces, its length, 20 per turn.
@lk.ro.s ui.diagram.oseg edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by a=?oa b=?ob
@lk.ro.p ui.diagram.opiece edge=?e i=?i anx=?anx any=?any bnx=?bnx bny=?bny
@lk.ro.o ui.diagram.oq edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by oa=?oa ob=?ob anx=?anx any=?any bnx=?bnx bny=?bny
@lk.lg.oq core.rule when=$lk.ro.s when=$lk.ro.p then=$lk.ro.o
@lk.ro.pat.1 ui.diagram.patax pat=hv first=h last=v turns=1
@lk.ro.pat.2 ui.diagram.patax pat=vh first=v last=h turns=1
@lk.ro.pat.3 ui.diagram.patax pat=hvh first=h last=h turns=2
@lk.ro.pat.4 ui.diagram.patax pat=vhv first=v last=v turns=2
@lk.ro.q ui.diagram.oq edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by
@lk.ro.mx1 core.calc out=?mx1 fn=add args=?ax args=?bx
@lk.ro.mx core.calc out=?mx fn=div args=?mx1 args=2
@lk.ro.my1 core.calc out=?my1 fn=add args=?ay args=?by
@lk.ro.my core.calc out=?my fn=div args=?my1 args=2
@lk.ro.c1 ui.diagram.ocand edge=?e i=?i pat=hv c=0 stage=1
@lk.ro.c2 ui.diagram.ocand edge=?e i=?i pat=vh c=0 stage=1
@lk.ro.c3 ui.diagram.ocand edge=?e i=?i pat=hvh c=?mx stage=1
@lk.ro.c4 ui.diagram.ocand edge=?e i=?i pat=vhv c=?my stage=1
@lk.lg.ocand.hv core.rule when=$lk.ro.q then=$lk.ro.c1
@lk.lg.ocand.vh core.rule when=$lk.ro.q then=$lk.ro.c2
@lk.lg.ocand.hvh core.rule when=$lk.ro.q with=$lk.ro.mx1 with=$lk.ro.mx then=$lk.ro.c3
@lk.lg.ocand.vhv core.rule when=$lk.ro.q with=$lk.ro.my1 with=$lk.ro.my then=$lk.ro.c4
# Corridors round the nodes a plain way crosses.
@lk.ro.hit1 ui.diagram.ohit edge=?e i=?i stage=1 node=?n
@lk.ro.nb ui.diagram.nbox node=?n x0=?x0 y0=?y0 x1=?x1 y1=?y1
@lk.ro.l core.calc out=?cl fn=sub args=?x0 args=24
@lk.ro.r core.calc out=?cr fn=add args=?x1 args=24
@lk.ro.t core.calc out=?ct fn=sub args=?y0 args=24
@lk.ro.b core.calc out=?cb fn=add args=?y1 args=24
@lk.ro.cl ui.diagram.ocand edge=?e i=?i pat=hvh c=?cl stage=2
@lk.ro.cr ui.diagram.ocand edge=?e i=?i pat=hvh c=?cr stage=2
@lk.ro.ct ui.diagram.ocand edge=?e i=?i pat=vhv c=?ct stage=2
@lk.ro.cb ui.diagram.ocand edge=?e i=?i pat=vhv c=?cb stage=2
@lk.lg.ocand.left core.rule when=$lk.ro.hit1 when=$lk.ro.nb with=$lk.ro.l then=$lk.ro.cl
@lk.lg.ocand.right core.rule when=$lk.ro.hit1 when=$lk.ro.nb with=$lk.ro.r then=$lk.ro.cr
@lk.lg.ocand.top core.rule when=$lk.ro.hit1 when=$lk.ro.nb with=$lk.ro.t then=$lk.ro.ct
@lk.lg.ocand.bottom core.rule when=$lk.ro.hit1 when=$lk.ro.nb with=$lk.ro.b then=$lk.ro.cb
# The runs of each candidate: s, axis o (h: along y = at, x from p to q; v: along x = at, y from p to q).
@lk.ru.c ui.diagram.ocand edge=?e i=?i pat=?pat c=?c stage=?st
@lk.ru.q ui.diagram.oq edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by
@lk.ru.ishv core.check fn=eq args=?pat args=hv
@lk.ru.isvh core.check fn=eq args=?pat args=vh
@lk.ru.ishvh core.check fn=eq args=?pat args=hvh
@lk.ru.isvhv core.check fn=eq args=?pat args=vhv
@lk.ru.hv1 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=1 o=h at=?ay p=?ax q=?bx
@lk.ru.hv2 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=2 o=v at=?bx p=?ay q=?by
@lk.ru.vh1 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=1 o=v at=?ax p=?ay q=?by
@lk.ru.vh2 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=2 o=h at=?by p=?ax q=?bx
@lk.ru.hvh1 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=1 o=h at=?ay p=?ax q=?c
@lk.ru.hvh2 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=2 o=v at=?c p=?ay q=?by
@lk.ru.hvh3 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=3 o=h at=?by p=?c q=?bx
@lk.ru.vhv1 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=1 o=v at=?ax p=?ay q=?c
@lk.ru.vhv2 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=2 o=h at=?c p=?ax q=?bx
@lk.ru.vhv3 ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=3 o=v at=?bx p=?c q=?by
@lk.lg.orun.hv.1 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.ishv then=$lk.ru.hv1
@lk.lg.orun.hv.2 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.ishv then=$lk.ru.hv2
@lk.lg.orun.vh.1 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.isvh then=$lk.ru.vh1
@lk.lg.orun.vh.2 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.isvh then=$lk.ru.vh2
@lk.lg.orun.hvh.1 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.ishvh then=$lk.ru.hvh1
@lk.lg.orun.hvh.2 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.ishvh then=$lk.ru.hvh2
@lk.lg.orun.hvh.3 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.ishvh then=$lk.ru.hvh3
@lk.lg.orun.vhv.1 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.isvhv then=$lk.ru.vhv1
@lk.lg.orun.vhv.2 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.isvhv then=$lk.ru.vhv2
@lk.lg.orun.vhv.3 core.rule when=$lk.ru.c when=$lk.ru.q if=$lk.ru.isvhv then=$lk.ru.vhv3
# A run crosses a node when it passes through its box or within 6 of it.
@lk.rh.r ui.diagram.orun edge=?e i=?i pat=?pat c=?c stage=?st s=?s o=?o at=?at p=?p q=?q
@lk.rh.b ui.diagram.nbox node=?n x0=?x0 y0=?y0 x1=?x1 y1=?y1
@lk.rh.lo core.calc out=?lo fn=min args=?p args=?q
@lk.rh.hi core.calc out=?hi fn=max args=?p args=?q
@lk.rh.ish core.check fn=eq args=?o args=h
@lk.rh.isv core.check fn=eq args=?o args=v
@lk.rh.x0 core.calc out=?ix0 fn=sub args=?x0 args=6
@lk.rh.x1 core.calc out=?ix1 fn=add args=?x1 args=6
@lk.rh.y0 core.calc out=?iy0 fn=sub args=?y0 args=6
@lk.rh.y1 core.calc out=?iy1 fn=add args=?y1 args=6
@lk.rh.hy core.check fn=between args=?at args=?iy0 args=?iy1
@lk.rh.hx1 core.check fn=lt args=?lo args=?ix1
@lk.rh.hx2 core.check fn=gt args=?hi args=?ix0
@lk.rh.vx core.check fn=between args=?at args=?ix0 args=?ix1
@lk.rh.vy1 core.check fn=lt args=?lo args=?iy1
@lk.rh.vy2 core.check fn=gt args=?hi args=?iy0
@lk.rh.o ui.diagram.ocross edge=?e i=?i pat=?pat c=?c stage=?st s=?s node=?n
@lk.lg.ocross.h core.rule when=$lk.rh.r when=$lk.rh.b if=$lk.rh.ish with=$lk.rh.lo with=$lk.rh.hi with=$lk.rh.x0 with=$lk.rh.x1 with=$lk.rh.y0 with=$lk.rh.y1 if=$lk.rh.hy if=$lk.rh.hx1 if=$lk.rh.hx2 then=$lk.rh.o
@lk.lg.ocross.v core.rule when=$lk.rh.r when=$lk.rh.b if=$lk.rh.isv with=$lk.rh.lo with=$lk.rh.hi with=$lk.rh.x0 with=$lk.rh.x1 with=$lk.rh.y0 with=$lk.rh.y1 if=$lk.rh.vx if=$lk.rh.vy1 if=$lk.rh.vy2 then=$lk.rh.o
@lk.rh.x ui.diagram.ocross edge=?e i=?i stage=1 node=?n
@lk.rh.xo ui.diagram.ohit edge=?e i=?i stage=1 node=?n
@lk.lg.ohit core.rule when=$lk.rh.x then=$lk.rh.xo
# The count of nodes crossed and of ends taken against their stubs (none: 0).
@lk.rk.x ui.diagram.ocross edge=?e i=?i pat=?pat c=?c node=?n
@lk.rk.xo ui.diagram.ocrossn edge=?e i=?i pat=?pat c=?c n=?k
