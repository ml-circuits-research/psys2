@lk.lg.mend.auto core.rule when=$lk.gp.c not=$lk.gp.ortho with=$lk.gp.t with=$lk.gp.ox with=$lk.gp.oy with=$lk.gp.x with=$lk.gp.y then=$lk.gp.o

# ---- The vertices: the source end (i = 0), the bends (1..m) and the target end (m + 1) ----
@lk.gv.a ui.diagram.mend edge=?e at=a x=?x y=?y
@lk.gv.ao ui.diagram.mv edge=?e i=0 x=?x y=?y
