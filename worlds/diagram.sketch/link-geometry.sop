# The points of the line in order (k from 1), each also under the number of the one before it.
@lk.gl.lt ui.diagram.lt edge=?e
@lk.gl.p ui.diagram.point source=?e n=?n x=?x y=?y
@lk.gl.k core.rank of=$lk.gl.p by=n within=?e out=?k
@lk.gl.po ui.diagram.lp edge=?e k=?k x=?x y=?y
@lk.lg.lp core.rule when=$lk.gl.lt when=$lk.gl.p with=$lk.gl.k then=$lk.gl.po
@lk.gl.v ui.diagram.lp edge=?e k=?k x=?x y=?y
@lk.gl.vp core.calc out=?p fn=sub args=?k args=1
@lk.gl.vno ui.diagram.lpn edge=?e prev=?p x=?x y=?y
@lk.lg.lpn core.rule when=$lk.gl.v with=$lk.gl.vp then=$lk.gl.vno
# Each segment (from point k to k + 1) and its length (the "alpha max plus beta min" estimate).
@lk.gl.s0 ui.diagram.lp edge=?e k=?k x=?x0 y=?y0
@lk.gl.s1 ui.diagram.lpn edge=?e prev=?k x=?x1 y=?y1
@lk.gl.dx core.calc out=?dx fn=sub args=?x1 args=?x0
@lk.gl.dy core.calc out=?dy fn=sub args=?y1 args=?y0
@lk.gl.ax core.calc out=?ax fn=abs args=?dx
@lk.gl.ay core.calc out=?ay fn=abs args=?dy
@lk.gl.bg core.calc out=?bg fn=max args=?ax args=?ay
@lk.gl.sm core.calc out=?sm fn=min args=?ax args=?ay
@lk.gl.l1 core.calc out=?l1 fn=mul args=?bg args=0.96043
@lk.gl.l2 core.calc out=?l2 fn=mul args=?sm args=0.39782
@lk.gl.len core.calc out=?len fn=add args=?l1 args=?l2
@lk.gl.so ui.diagram.ls edge=?e k=?k len=?len x0=?x0 y0=?y0 dx=?dx dy=?dy
@lk.lg.ls core.rule when=$lk.gl.s0 when=$lk.gl.s1 with=$lk.gl.dx with=$lk.gl.dy with=$lk.gl.ax with=$lk.gl.ay with=$lk.gl.bg with=$lk.gl.sm with=$lk.gl.l1 with=$lk.gl.l2 with=$lk.gl.len then=$lk.gl.so
# The length before each segment and the whole length.
@lk.gl.pa ui.diagram.ls edge=?e k=?k
@lk.gl.pb ui.diagram.ls edge=?e k=?j len=?len
@lk.gl.before core.check fn=lt args=?j args=?k
@lk.gl.pair ui.diagram.lspair edge=?e k=?k j=?j len=?len
@lk.lg.lspair core.rule when=$lk.gl.pa when=$lk.gl.pb if=$lk.gl.before then=$lk.gl.pair
@lk.gl.pr ui.diagram.lspair edge=?e k=?k len=?len
@lk.gl.cum ui.diagram.lcum edge=?e k=?k before=?c
@lk.lg.lcum core.aggregate over=$lk.gl.pr by=?e by=?k sum=?c args=?len then=$lk.gl.cum
@lk.gl.first ui.diagram.ls edge=?e k=1
@lk.gl.cum0 ui.diagram.lcum edge=?e k=1 before=0
@lk.lg.lcum.first core.rule when=$lk.gl.first then=$lk.gl.cum0
@lk.gl.all ui.diagram.ls edge=?e len=?len
@lk.gl.tot ui.diagram.ltotal edge=?e len=?l
@lk.lg.ltotal core.aggregate over=$lk.gl.all by=?e sum=?l args=?len then=$lk.gl.tot
# The point at the fraction: inside the segment that holds that length.
@lk.gl.f ui.diagram.lt edge=?e t=?t0
@lk.gl.tl ui.diagram.ltotal edge=?e len=?tot
@lk.gl.sg ui.diagram.ls edge=?e k=?k len=?len x0=?x0 y0=?y0 dx=?dx dy=?dy
@lk.gl.c ui.diagram.lcum edge=?e k=?k before=?c
@lk.gl.t1 core.calc out=?t1 fn=max args=?t0 args=0.001
@lk.gl.t core.calc out=?t fn=min args=?t1 args=0.999
@lk.gl.d core.calc out=?d fn=mul args=?t args=?tot
@lk.gl.ce core.calc out=?ce fn=add args=?c args=?len
@lk.gl.in1 core.check fn=lte args=?c args=?d
@lk.gl.in2 core.check fn=lt args=?d args=?ce
@lk.gl.r1 core.calc out=?r1 fn=sub args=?d args=?c
@lk.gl.r core.calc out=?r fn=div args=?r1 args=?len
@lk.gl.ox core.calc out=?ox fn=mul args=?dx args=?r
@lk.gl.oy core.calc out=?oy fn=mul args=?dy args=?r
@lk.gl.x core.calc out=?x fn=add args=?x0 args=?ox
@lk.gl.y core.calc out=?y fn=add args=?y0 args=?oy
@lk.gl.out ui.diagram.lpos edge=?e x=?x y=?y
@lk.lg.lpos core.rule when=$lk.gl.f when=$lk.gl.tl when=$lk.gl.sg when=$lk.gl.c with=$lk.gl.t1 with=$lk.gl.t with=$lk.gl.d with=$lk.gl.ce if=$lk.gl.in1 if=$lk.gl.in2 with=$lk.gl.r1 with=$lk.gl.r with=$lk.gl.ox with=$lk.gl.oy with=$lk.gl.x with=$lk.gl.y then=$lk.gl.out
# A hand-drawn link's middle (its code and, without a fraction of its own, its label) is that point.
@lk.gl.mm ui.diagram.manual edge=?e
@lk.gl.mp ui.diagram.lpos edge=?e x=?x y=?y
@lk.gl.mo ui.diagram.mid edge=?e x=?x y=?y
@lk.lg.mid.manual core.rule when=$lk.gl.mm when=$lk.gl.mp then=$lk.gl.mo
# A label placed by its fraction (render-projection.sop draws the others at the middle).
@lk.gd.e w.diagram.edge code=?e label=?text diagram.sketch.label_at=?t
@lk.gd.p ui.diagram.lpos edge=?e x=?x y=?y
@lk.gd.s core.calc out=?src fn=concat args=?e args=".label"
@lk.gd.x core.calc out=?lx fn=add args=?x args=6
@lk.gd.y core.calc out=?ly fn=add args=?y args=14
@lk.gd.out ui.diagram.draw part=?e source=?src slot=?e order=4 z=1 shape=text text=?text x=?lx y=?ly w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left font=12
@lk.gd.ink ui.diagram.pagecol key=label rgb=?lc
@lk.gd.fill ui.diagram.fill source=?src part=?e fill=?lc
@lk.lg.draw.label.at core.rule when=$lk.gd.e when=$lk.gd.p with=$lk.gd.s with=$lk.gd.x with=$lk.gd.y then=$lk.gd.out
@lk.lg.fill.label.at core.rule when=$lk.gd.e when=$lk.gd.p when=$lk.gd.ink with=$lk.gd.s with=$lk.gd.x with=$lk.gd.y then=$lk.gd.fill

# ---- Marks: an open arrow, a diamond or a circle instead of an arrow ----
# An end whose kind is not an arrow is not drawn as one (render-projection.sop and layout-modes.sop leave it out).
@lk.gn.h w.diagram.edge code=?e diagram.sketch.head=?k
@lk.gn.t w.diagram.edge code=?e diagram.sketch.tail=?k
@lk.gn.notarrow core.check fn=neq args=?k args=arrow
@lk.gn.ho ui.diagram.altmark edge=?e at=head
@lk.gn.to ui.diagram.altmark edge=?e at=tail
@lk.lg.altmark.head core.rule when=$lk.gn.h if=$lk.gn.notarrow then=$lk.gn.ho
@lk.lg.altmark.tail core.rule when=$lk.gn.t if=$lk.gn.notarrow then=$lk.gn.to
# Which ends show their mark: the head unless the direction is none or back; the tail when it is both or back.
@lk.gn.none w.diagram.edge code=?e direction=none
@lk.gn.back w.diagram.edge code=?e direction=back
@lk.gn.both w.diagram.edge code=?e direction=both
@lk.gn.hs ui.diagram.markshow edge=?e at=head kind=?k
@lk.gn.ts ui.diagram.markshow edge=?e at=tail kind=?k
@lk.lg.markshow.head core.rule when=$lk.gn.h not=$lk.gn.none not=$lk.gn.back then=$lk.gn.hs
@lk.lg.markshow.tail.both core.rule when=$lk.gn.t when=$lk.gn.both then=$lk.gn.ts
@lk.lg.markshow.tail.back core.rule when=$lk.gn.t when=$lk.gn.back then=$lk.gn.ts
# The direction at each end: an arrow's own, or a gap route's tip turned to a unit vector.
@lk.gn.pd ui.diagram.pvec pointing=down ux=0 uy=1
@lk.gn.pu ui.diagram.pvec pointing=up ux=0 uy=-1
@lk.gn.pl ui.diagram.pvec pointing=left ux=-1 uy=0
@lk.gn.pr ui.diagram.pvec pointing=right ux=1 uy=0
@lk.gn.ar ui.diagram.arrow edge=?e at=?at x=?x y=?y ux=?ux uy=?uy
@lk.gn.ud ui.diagram.udir edge=?e at=?at x=?x y=?y ux=?ux uy=?uy
@lk.lg.udir.arrow core.rule when=$lk.gn.ar then=$lk.gn.ud
@lk.gn.tp ui.diagram.tip edge=?e at=?at x=?x y=?y pointing=?pt
@lk.gn.pv ui.diagram.pvec pointing=?pt ux=?ux uy=?uy
@lk.lg.udir.tip core.rule when=$lk.gn.tp when=$lk.gn.pv then=$lk.gn.ud
# The shapes, tip on the end and turned along the line: an open arrow (two strokes), a diamond 16 long and 10 wide,
# a circle 10 across.
@lk.gj.s ui.diagram.markshow edge=?e at=?at kind=?k
@lk.gj.u ui.diagram.udir edge=?e at=?at x=?x y=?y ux=?ux uy=?uy
@lk.gj.c ui.diagram.ecolour edge=?e fill=?f
@lk.gj.w ui.diagram.ewidth edge=?e w=?sw
@lk.gj.src core.calc out=?src fn=concat args=?e args="." args=?at
@lk.gj.isopen core.check fn=eq args=?k args=open
@lk.gj.isdia core.check fn=eq args=?k args=diamond
@lk.gj.iscirc core.check fn=eq args=?k args=circle
@lk.gj.bx1 core.calc out=?bx1 fn=mul args=?ux args=11
@lk.gj.by1 core.calc out=?by1 fn=mul args=?uy args=11
@lk.gj.bx core.calc out=?bx fn=sub args=?x args=?bx1
@lk.gj.by core.calc out=?by fn=sub args=?y args=?by1
@lk.gj.nx core.calc out=?nx fn=mul args=?uy args=-6
@lk.gj.ny core.calc out=?ny fn=mul args=?ux args=6
@lk.gj.lx core.calc out=?lx fn=add args=?bx args=?nx
@lk.gj.ly core.calc out=?ly fn=add args=?by args=?ny
@lk.gj.rx core.calc out=?rx fn=sub args=?bx args=?nx
@lk.gj.ry core.calc out=?ry fn=sub args=?by args=?ny
@lk.gj.o1 ui.diagram.point source=?src n=1 x=?lx y=?ly
@lk.gj.o2 ui.diagram.point source=?src n=2 x=?x y=?y
@lk.gj.o3 ui.diagram.point source=?src n=3 x=?rx y=?ry
@lk.gj.odraw ui.diagram.draw part=?e source=?src slot=?e order=2 z=1 shape=line x=0 y=0 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left stroke=?sw
@lk.gj.ofill ui.diagram.fill source=?src part=?e fill=?f
@lk.lg.mark.open.1 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isopen with=$lk.gj.src with=$lk.gj.bx1 with=$lk.gj.by1 with=$lk.gj.bx with=$lk.gj.by with=$lk.gj.nx with=$lk.gj.ny with=$lk.gj.lx with=$lk.gj.ly then=$lk.gj.o1
@lk.lg.mark.open.2 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isopen with=$lk.gj.src then=$lk.gj.o2
@lk.lg.mark.open.3 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isopen with=$lk.gj.src with=$lk.gj.bx1 with=$lk.gj.by1 with=$lk.gj.bx with=$lk.gj.by with=$lk.gj.nx with=$lk.gj.ny with=$lk.gj.rx with=$lk.gj.ry then=$lk.gj.o3
@lk.lg.mark.open.draw core.rule when=$lk.gj.s when=$lk.gj.u when=$lk.gj.w if=$lk.gj.isopen with=$lk.gj.src then=$lk.gj.odraw
@lk.lg.mark.open.fill core.rule when=$lk.gj.s when=$lk.gj.u when=$lk.gj.c if=$lk.gj.isopen with=$lk.gj.src then=$lk.gj.ofill
@lk.gj.mx1 core.calc out=?mx1 fn=mul args=?ux args=8
@lk.gj.my1 core.calc out=?my1 fn=mul args=?uy args=8
@lk.gj.mx core.calc out=?mx fn=sub args=?x args=?mx1
@lk.gj.my core.calc out=?my fn=sub args=?y args=?my1
@lk.gj.fx1 core.calc out=?fx1 fn=mul args=?ux args=16
@lk.gj.fy1 core.calc out=?fy1 fn=mul args=?uy args=16
@lk.gj.fx core.calc out=?fx fn=sub args=?x args=?fx1
@lk.gj.fy core.calc out=?fy fn=sub args=?y args=?fy1
@lk.gj.wx core.calc out=?wx fn=mul args=?uy args=-5
@lk.gj.wy core.calc out=?wy fn=mul args=?ux args=5
@lk.gj.dlx core.calc out=?dlx fn=add args=?mx args=?wx
@lk.gj.dly core.calc out=?dly fn=add args=?my args=?wy
@lk.gj.drx core.calc out=?drx fn=sub args=?mx args=?wx
@lk.gj.dry core.calc out=?dry fn=sub args=?my args=?wy
@lk.gj.d1 ui.diagram.point source=?src n=1 x=?x y=?y
@lk.gj.d2 ui.diagram.point source=?src n=2 x=?dlx y=?dly
@lk.gj.d3 ui.diagram.point source=?src n=3 x=?fx y=?fy
@lk.gj.d4 ui.diagram.point source=?src n=4 x=?drx y=?dry
@lk.gj.ddraw ui.diagram.draw part=?e source=?src slot=?e order=2 z=1 shape=polygon x=0 y=0 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left
@lk.lg.mark.diamond.1 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src then=$lk.gj.d1
@lk.lg.mark.diamond.2 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src with=$lk.gj.mx1 with=$lk.gj.my1 with=$lk.gj.mx with=$lk.gj.my with=$lk.gj.wx with=$lk.gj.wy with=$lk.gj.dlx with=$lk.gj.dly then=$lk.gj.d2
@lk.lg.mark.diamond.3 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src with=$lk.gj.fx1 with=$lk.gj.fy1 with=$lk.gj.fx with=$lk.gj.fy then=$lk.gj.d3
@lk.lg.mark.diamond.4 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src with=$lk.gj.mx1 with=$lk.gj.my1 with=$lk.gj.mx with=$lk.gj.my with=$lk.gj.wx with=$lk.gj.wy with=$lk.gj.drx with=$lk.gj.dry then=$lk.gj.d4
@lk.lg.mark.diamond.draw core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src then=$lk.gj.ddraw
@lk.lg.mark.diamond.fill core.rule when=$lk.gj.s when=$lk.gj.u when=$lk.gj.c if=$lk.gj.isdia with=$lk.gj.src then=$lk.gj.ofill
@lk.gj.ccx1 core.calc out=?ccx1 fn=mul args=?ux args=5
@lk.gj.ccy1 core.calc out=?ccy1 fn=mul args=?uy args=5
@lk.gj.ccx core.calc out=?ccx fn=sub args=?x args=?ccx1
@lk.gj.ccy core.calc out=?ccy fn=sub args=?y args=?ccy1
@lk.gj.cbx core.calc out=?cbx fn=sub args=?ccx args=5
@lk.gj.cby core.calc out=?cby fn=sub args=?ccy args=5
@lk.gj.cdraw ui.diagram.draw part=?e source=?src slot=?e order=2 z=1 shape=circle x=?cbx y=?cby w=10 h=10 cx=0 cy=0 tx=0 ty=0 scale=1 side=left
@lk.lg.mark.circle.draw core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.iscirc with=$lk.gj.src with=$lk.gj.ccx1 with=$lk.gj.ccy1 with=$lk.gj.ccx with=$lk.gj.ccy with=$lk.gj.cbx with=$lk.gj.cby then=$lk.gj.cdraw
@lk.lg.mark.circle.fill core.rule when=$lk.gj.s when=$lk.gj.u when=$lk.gj.c if=$lk.gj.iscirc with=$lk.gj.src then=$lk.gj.ofill

# ---- Commands ----
# The link commands that name links by `ids` (a missing one is refused, act-rules.sop).
@lk.edgeop.attach ui.diagram.edgeop operation="diagram.link.attach"
@lk.edgeop.detach ui.diagram.edgeop operation="diagram.link.detach"
@lk.edgeop.bend.add ui.diagram.edgeop operation="diagram.link.bend.add"
@lk.edgeop.bend.move ui.diagram.edgeop operation="diagram.link.bend.move"
@lk.edgeop.bend.remove ui.diagram.edgeop operation="diagram.link.bend.remove"
@lk.c.it app.act.item param="ids" value=?id
@lk.c.ed w.diagram.edge code=?id

# A change names one of the link's properties (act-rules.sop refuses one that names none).
@lk.c.g1 app.act.request operation="diagram.link.change" fromSide=?v
@lk.c.g2 app.act.request operation="diagram.link.change" toSide=?v
@lk.c.g3 app.act.request operation="diagram.link.change" head=?v
@lk.c.g4 app.act.request operation="diagram.link.change" tail=?v
@lk.c.g5 app.act.request operation="diagram.link.change" labelAt=?v
@lk.c.g6 app.act.request operation="diagram.link.change" labelPosition=?v
@lk.c.g7 app.act.request operation="diagram.link.change" fromX=?v
@lk.c.g8 app.act.request operation="diagram.link.change" fromY=?v
@lk.c.g9 app.act.request operation="diagram.link.change" toX=?v
@lk.c.g10 app.act.request operation="diagram.link.change" toY=?v
@lk.c.go ui.diagram.lcgiven value=yes
@lk.lg.given.1 core.rule when=$lk.c.g1 then=$lk.c.go
@lk.lg.given.2 core.rule when=$lk.c.g2 then=$lk.c.go
@lk.lg.given.3 core.rule when=$lk.c.g3 then=$lk.c.go
@lk.lg.given.4 core.rule when=$lk.c.g4 then=$lk.c.go
@lk.lg.given.5 core.rule when=$lk.c.g5 then=$lk.c.go
@lk.lg.given.6 core.rule when=$lk.c.g6 then=$lk.c.go
@lk.lg.given.7 core.rule when=$lk.c.g7 then=$lk.c.go
@lk.lg.given.8 core.rule when=$lk.c.g8 then=$lk.c.go
@lk.lg.given.9 core.rule when=$lk.c.g9 then=$lk.c.go
@lk.lg.given.10 core.rule when=$lk.c.g10 then=$lk.c.go

# The sides an end is attached at.
@lk.c.fs.r app.act.request operation="diagram.link.change" fromSide=?v
@lk.c.fs.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=?v order=4
@lk.lg.change.from.side core.rule when=$lk.c.fs.r when=$lk.c.it when=$lk.c.ed then=$lk.c.fs.c
@lk.c.ts.r app.act.request operation="diagram.link.change" toSide=?v
@lk.c.ts.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=?v order=4
@lk.lg.change.to.side core.rule when=$lk.c.ts.r when=$lk.c.it when=$lk.c.ed then=$lk.c.ts.c
# A free end's point.
@lk.c.fx.r app.act.request operation="diagram.link.change" fromX=?v
@lk.c.fx.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_x value=?v order=4
@lk.lg.change.from.x core.rule when=$lk.c.fx.r when=$lk.c.it when=$lk.c.ed then=$lk.c.fx.c
@lk.c.fy.r app.act.request operation="diagram.link.change" fromY=?v
@lk.c.fy.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_y value=?v order=4
@lk.lg.change.from.y core.rule when=$lk.c.fy.r when=$lk.c.it when=$lk.c.ed then=$lk.c.fy.c
@lk.c.tx.r app.act.request operation="diagram.link.change" toX=?v
@lk.c.tx.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_x value=?v order=4
@lk.lg.change.to.x core.rule when=$lk.c.tx.r when=$lk.c.it when=$lk.c.ed then=$lk.c.tx.c
@lk.c.ty.r app.act.request operation="diagram.link.change" toY=?v
@lk.c.ty.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_y value=?v order=4
@lk.lg.change.to.y core.rule when=$lk.c.ty.r when=$lk.c.it when=$lk.c.ed then=$lk.c.ty.c
# Where the label sits: start, middle or end, or a fraction of the length.
@lk.c.la.r app.act.request operation="diagram.link.change" labelAt=?w
@lk.c.la.t ui.diagram.ldir name=?w t=?t
@lk.c.la.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.label_at value=?t order=4
@lk.lg.change.label.at core.rule when=$lk.c.la.r when=$lk.c.la.t when=$lk.c.it when=$lk.c.ed then=$lk.c.la.c
@lk.c.ld.start ui.diagram.ldir name=start t=0.2
@lk.c.ld.middle ui.diagram.ldir name=middle t=0.5
@lk.c.ld.end ui.diagram.ldir name=end t=0.8
@lk.c.lp.r app.act.request operation="diagram.link.change" labelPosition=?t
@lk.c.lp.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.label_at value=?t order=4
@lk.lg.change.label.position core.rule when=$lk.c.lp.r when=$lk.c.it when=$lk.c.ed then=$lk.c.lp.c

# The mark at each end. A kind shows that end's mark (the direction gains the end); none takes the mark away (the
# direction loses it); the kind of a shown end is kept.
@lk.c.hd.r app.act.request operation="diagram.link.change" head=?k
@lk.c.hd.kind core.check fn=neq args=?k args=none
@lk.c.hd.nokind core.check fn=eq args=?k args=none
@lk.c.hd.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.head value=?k order=4
@lk.lg.change.head core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.ed if=$lk.c.hd.kind then=$lk.c.hd.c
@lk.c.dir.none w.diagram.edge code=?id direction=none
@lk.c.dir.back w.diagram.edge code=?id direction=back
@lk.c.dir.fwd w.diagram.edge code=?id direction=forward
@lk.c.dir.both w.diagram.edge code=?id direction=both
@lk.c.to.fwd.n app.act.call act=change thing=$lk.c.dir.none attr=direction value=forward order=5
@lk.c.to.both.b app.act.call act=change thing=$lk.c.dir.back attr=direction value=both order=5
@lk.lg.change.head.shows.none core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.dir.none if=$lk.c.hd.kind then=$lk.c.to.fwd.n
@lk.lg.change.head.shows.back core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.dir.back if=$lk.c.hd.kind then=$lk.c.to.both.b
@lk.c.to.none.f app.act.call act=change thing=$lk.c.dir.fwd attr=direction value=none order=5
@lk.c.to.back.b app.act.call act=change thing=$lk.c.dir.both attr=direction value=back order=5
@lk.lg.change.head.off.forward core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.dir.fwd if=$lk.c.hd.nokind then=$lk.c.to.none.f
@lk.lg.change.head.off.both core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.dir.both if=$lk.c.hd.nokind then=$lk.c.to.back.b
@lk.c.tl.r app.act.request operation="diagram.link.change" tail=?k
@lk.c.tl.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.tail value=?k order=4
@lk.lg.change.tail core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.ed if=$lk.c.hd.kind then=$lk.c.tl.c
@lk.c.to.both.f app.act.call act=change thing=$lk.c.dir.fwd attr=direction value=both order=5
@lk.c.to.back.n app.act.call act=change thing=$lk.c.dir.none attr=direction value=back order=5
@lk.lg.change.tail.shows.forward core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.dir.fwd if=$lk.c.hd.kind then=$lk.c.to.both.f
@lk.lg.change.tail.shows.none core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.dir.none if=$lk.c.hd.kind then=$lk.c.to.back.n
@lk.c.to.fwd.b app.act.call act=change thing=$lk.c.dir.both attr=direction value=forward order=5
@lk.c.to.none.b app.act.call act=change thing=$lk.c.dir.back attr=direction value=none order=5
@lk.lg.change.tail.off.both core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.dir.both if=$lk.c.hd.nokind then=$lk.c.to.fwd.b
@lk.lg.change.tail.off.back core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.dir.back if=$lk.c.hd.nokind then=$lk.c.to.none.b
# An arrow direction that shows an end whose kind was none shows it as an arrow again.
@lk.c.ar.r app.act.request operation="diagram.link.change" arrow=?a
@lk.c.ar.head core.check fn=matches args=?a args="^(forward|both)$"
@lk.c.ar.tail core.check fn=matches args=?a args="^(back|both)$"
@lk.c.hn.e w.diagram.edge code=?id diagram.sketch.head=none
@lk.c.tn.e w.diagram.edge code=?id diagram.sketch.tail=none
@lk.c.hn.c app.act.call act=change thing=$lk.c.hn.e attr=diagram.sketch.head value=arrow order=5
@lk.c.tn.c app.act.call act=change thing=$lk.c.tn.e attr=diagram.sketch.tail value=arrow order=5
@lk.lg.arrow.head.back core.rule when=$lk.c.ar.r when=$lk.c.it when=$lk.c.hn.e if=$lk.c.ar.head then=$lk.c.hn.c
@lk.lg.arrow.tail.back core.rule when=$lk.c.ar.r when=$lk.c.it when=$lk.c.tn.e if=$lk.c.ar.tail then=$lk.c.tn.c

# A new link with its sides, marks and route.
@lk.c.mk.made app.act.call act=make kind=w.diagram.edge
@lk.c.mk.fs app.act.request operation="diagram.link.make" fromSide=?v
@lk.c.mk.fs.a app.act.arg call=new.edge attr=diagram.sketch.from_side value=?v
@lk.lg.make.from.side core.rule when=$lk.c.mk.fs when=$lk.c.mk.made then=$lk.c.mk.fs.a
@lk.c.mk.ts app.act.request operation="diagram.link.make" toSide=?v
@lk.c.mk.ts.a app.act.arg call=new.edge attr=diagram.sketch.to_side value=?v
@lk.lg.make.to.side core.rule when=$lk.c.mk.ts when=$lk.c.mk.made then=$lk.c.mk.ts.a
@lk.c.mk.rt app.act.request operation="diagram.link.make" route=?v
@lk.c.mk.rt.a app.act.arg call=new.edge attr=route value=?v
@lk.lg.make.route core.rule when=$lk.c.mk.rt when=$lk.c.mk.made then=$lk.c.mk.rt.a
@lk.c.mk.hd app.act.request operation="diagram.link.make" head=?k
@lk.c.mk.hd.a app.act.arg call=new.edge attr=diagram.sketch.head value=?k
@lk.lg.make.head core.rule when=$lk.c.mk.hd when=$lk.c.mk.made if=$lk.c.hd.kind then=$lk.c.mk.hd.a
@lk.c.mk.tl app.act.request operation="diagram.link.make" tail=?k
@lk.c.mk.tl.a app.act.arg call=new.edge attr=diagram.sketch.tail value=?k
@lk.lg.make.tail core.rule when=$lk.c.mk.tl when=$lk.c.mk.made if=$lk.c.hd.kind then=$lk.c.mk.tl.a
# Without an arrow said: a tail kind shows the tail too (both; back when the head is none); a head of none alone, no mark.
@lk.c.mk.anyarrow app.act.request operation="diagram.link.make" arrow=?anya
@lk.c.mk.hnone app.act.request operation="diagram.link.make" head=none
@lk.c.mk.both app.act.arg call=new.edge attr=direction value=both
@lk.c.mk.back app.act.arg call=new.edge attr=direction value=back
@lk.c.mk.none app.act.arg call=new.edge attr=direction value=none
@lk.lg.make.tail.both core.rule when=$lk.c.mk.tl when=$lk.c.mk.made if=$lk.c.hd.kind not=$lk.c.mk.anyarrow not=$lk.c.mk.hnone then=$lk.c.mk.both
@lk.lg.make.tail.back core.rule when=$lk.c.mk.tl when=$lk.c.mk.made when=$lk.c.mk.hnone if=$lk.c.hd.kind not=$lk.c.mk.anyarrow then=$lk.c.mk.back
@lk.c.mk.anytail app.act.request operation="diagram.link.make" tail=?anyt
@lk.lg.make.head.none core.rule when=$lk.c.mk.hnone when=$lk.c.mk.made not=$lk.c.mk.anyarrow not=$lk.c.mk.anytail then=$lk.c.mk.none

# ---- Which end of each named link a command means ----
@lk.endop.attach ui.diagram.endop operation="diagram.link.attach"
@lk.endop.detach ui.diagram.endop operation="diagram.link.detach"
@lk.p.r app.act.request operation=?op
@lk.p.op ui.diagram.endop operation=?op
@lk.p.fe w.diagram.edge code=?id from=$lk.p.na
@lk.p.te w.diagram.edge code=?id to=$lk.p.nb
@lk.p.na w.diagram.node code=?a
@lk.p.nb w.diagram.node code=?b
@lk.p.from ui.diagram.pick edge=?id end=from
@lk.p.to ui.diagram.pick edge=?id end=to
# The end said by its role: from, start, source or tail; to, end, target or head.
@lk.p.re app.act.request end=?end
@lk.p.isfrom core.check fn=matches args=?end args="^(from|start|source|tail)$"
@lk.p.isto core.check fn=matches args=?end args="^(to|end|target|head)$"
@lk.lg.pick.role.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re if=$lk.p.isfrom then=$lk.p.from
@lk.lg.pick.role.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re if=$lk.p.isto then=$lk.p.to
# The end said by the node it is at now (both ends of a link from a node to itself).
@lk.p.ra app.act.request at=?n
@lk.p.atfrom core.check fn=eq args=?n args=?a
@lk.p.atto core.check fn=eq args=?n args=?b
@lk.lg.pick.at.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.fe when=$lk.p.na when=$lk.p.ra if=$lk.p.atfrom then=$lk.p.from
@lk.lg.pick.at.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.te when=$lk.p.nb when=$lk.p.ra if=$lk.p.atto then=$lk.p.to
# The end said by where it is drawn: the left, right, upper or lower one (the target on a tie).
@lk.p.th ui.diagram.tip edge=?id at=head x=?hx y=?hy
@lk.p.tt ui.diagram.tip edge=?id at=tail x=?tx y=?ty
@lk.p.isright core.check fn=eq args=?end args=right
@lk.p.isleft core.check fn=eq args=?end args=left
@lk.p.isup core.check fn=matches args=?end args="^(top|upper)$"
@lk.p.isdown core.check fn=matches args=?end args="^(bottom|lower)$"
@lk.p.tgt core.check fn=gt args=?tx args=?hx
@lk.p.tle core.check fn=lte args=?tx args=?hx
@lk.p.tlt core.check fn=lt args=?tx args=?hx
@lk.p.tge core.check fn=gte args=?tx args=?hx
@lk.p.ylt core.check fn=lt args=?ty args=?hy
@lk.p.yge core.check fn=gte args=?ty args=?hy
@lk.p.ygt core.check fn=gt args=?ty args=?hy
@lk.p.yle core.check fn=lte args=?ty args=?hy
@lk.lg.pick.right.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isright if=$lk.p.tgt then=$lk.p.from
@lk.lg.pick.right.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isright if=$lk.p.tle then=$lk.p.to
@lk.lg.pick.left.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isleft if=$lk.p.tlt then=$lk.p.from
@lk.lg.pick.left.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isleft if=$lk.p.tge then=$lk.p.to
@lk.lg.pick.up.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isup if=$lk.p.ylt then=$lk.p.from
@lk.lg.pick.up.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isup if=$lk.p.yge then=$lk.p.to
@lk.lg.pick.down.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isdown if=$lk.p.ygt then=$lk.p.from
@lk.lg.pick.down.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isdown if=$lk.p.yle then=$lk.p.to
# Neither said: the target end.
@lk.p.anyend app.act.request end=?anyend
@lk.p.anyat app.act.request at=?anyat
@lk.lg.pick.default core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed not=$lk.p.anyend not=$lk.p.anyat then=$lk.p.to
# An end that is not one of these, or a node that is at neither end: refused.
@lk.p.picked ui.diagram.pick edge=?id
@lk.p.miss app.act.refuse reason=missing-endpoint
@lk.lg.pick.none core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed not=$lk.p.picked then=$lk.p.miss

# ---- Attach an end of each named link to a node, at a side (auto when none is said) ----
@lk.at.r app.act.request operation="diagram.link.attach" node=?n
@lk.at.n w.diagram.node code=?n
@lk.at.from ui.diagram.pick edge=?id end=from
@lk.at.to ui.diagram.pick edge=?id end=to
@lk.at.cf app.act.call act=change thing=$lk.c.ed attr=from value=$lk.at.n order=1
@lk.at.ct app.act.call act=change thing=$lk.c.ed attr=to value=$lk.at.n order=1
@lk.lg.attach.from core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.c.ed when=$lk.at.from then=$lk.at.cf
@lk.lg.attach.to core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.c.ed when=$lk.at.to then=$lk.at.ct
@lk.at.rs app.act.request operation="diagram.link.attach" side=?s
@lk.at.sf app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=?s order=3
@lk.at.st app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=?s order=3
@lk.lg.attach.from.side core.rule when=$lk.at.r when=$lk.at.n when=$lk.at.rs when=$lk.c.it when=$lk.c.ed when=$lk.at.from then=$lk.at.sf
@lk.lg.attach.to.side core.rule when=$lk.at.r when=$lk.at.n when=$lk.at.rs when=$lk.c.it when=$lk.c.ed when=$lk.at.to then=$lk.at.st
@lk.at.anys app.act.request side=?anys
@lk.at.anyp app.act.request port=?anyp
@lk.at.ofs w.diagram.edge code=?id diagram.sketch.from_side=?old
@lk.at.ots w.diagram.edge code=?id diagram.sketch.to_side=?old
@lk.at.af app.act.call act=change thing=$lk.at.ofs attr=diagram.sketch.from_side value=auto order=3
@lk.at.att app.act.call act=change thing=$lk.at.ots attr=diagram.sketch.to_side value=auto order=3
@lk.lg.attach.from.auto core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.at.ofs when=$lk.at.from not=$lk.at.anys not=$lk.at.anyp then=$lk.at.af
@lk.lg.attach.to.auto core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.at.ots when=$lk.at.to not=$lk.at.anys not=$lk.at.anyp then=$lk.at.att
@lk.at.rn app.act.request operation="diagram.link.attach" node=?n
@lk.at.nn w.diagram.node code=?n
@lk.lg.attach.no.node core.rule when=$lk.at.rn not=$lk.at.nn then=$lk.p.miss

# ---- Detach an end of each named link: the end has no node any more; it stays where it was drawn (40 beyond its tip,
# away from its node's centre) or goes to the point said ----
# std.acts cannot take a reference away, so the link is made again under its code, without that end, carrying its
# other keys and its bends; reversing a link with a free end is made again the same way, its ends swapped.
@lk.dr.r app.act.request operation="diagram.link.detach"
@lk.dr.pf ui.diagram.pick edge=?id end=from
@lk.dr.pt ui.diagram.pick edge=?id end=to
@lk.dr.mf ui.diagram.remake edge=?id mode=detach-from
@lk.dr.mt ui.diagram.remake edge=?id mode=detach-to
@lk.dr.hf w.diagram.edge code=?id from=?anyf
@lk.dr.ht w.diagram.edge code=?id to=?anyt
@lk.dr.anyx app.act.request operation="diagram.link.detach" x=?anyx
@lk.lg.remake.detach.from core.rule when=$lk.dr.r when=$lk.c.it when=$lk.c.ed when=$lk.dr.pf when=$lk.dr.hf then=$lk.dr.mf
@lk.lg.remake.detach.to core.rule when=$lk.dr.r when=$lk.c.it when=$lk.c.ed when=$lk.dr.pt when=$lk.dr.ht then=$lk.dr.mt
# A free end moved to the point said: only its point changes.
@lk.dr.xy app.act.request operation="diagram.link.detach" x=?x y=?y
@lk.dr.fx app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_x value=?x order=1
@lk.dr.fy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_y value=?y order=2
@lk.dr.tx app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_x value=?x order=1
@lk.dr.ty app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_y value=?y order=2
@lk.lg.free.from.x core.rule when=$lk.dr.xy when=$lk.c.it when=$lk.c.ed when=$lk.dr.pf not=$lk.dr.hf then=$lk.dr.fx
@lk.lg.free.from.y core.rule when=$lk.dr.xy when=$lk.c.it when=$lk.c.ed when=$lk.dr.pf not=$lk.dr.hf then=$lk.dr.fy
@lk.lg.free.to.x core.rule when=$lk.dr.xy when=$lk.c.it when=$lk.c.ed when=$lk.dr.pt not=$lk.dr.ht then=$lk.dr.tx
@lk.lg.free.to.y core.rule when=$lk.dr.xy when=$lk.c.it when=$lk.c.ed when=$lk.dr.pt not=$lk.dr.ht then=$lk.dr.ty
@lk.dr.already app.act.refuse reason=already-free
@lk.lg.free.from.already core.rule when=$lk.dr.r when=$lk.c.it when=$lk.c.ed when=$lk.dr.pf not=$lk.dr.hf not=$lk.dr.anyx then=$lk.dr.already
@lk.lg.free.to.already core.rule when=$lk.dr.r when=$lk.c.it when=$lk.c.ed when=$lk.dr.pt not=$lk.dr.ht not=$lk.dr.anyx then=$lk.dr.already
@lk.dr.rv app.act.request operation="diagram.link.reverse"
@lk.dr.mr ui.diagram.remake edge=?id mode=reverse
@lk.lg.remake.reverse.from core.rule when=$lk.dr.rv when=$lk.c.it when=$lk.c.ed not=$lk.dr.hf then=$lk.dr.mr
@lk.lg.remake.reverse.to core.rule when=$lk.dr.rv when=$lk.c.it when=$lk.c.ed not=$lk.dr.ht then=$lk.dr.mr
# The ends of the new link.
@lk.dn.f w.diagram.edge code=?id from=$lk.dn.na
@lk.dn.t w.diagram.edge code=?id to=$lk.dn.nb
@lk.dn.na w.diagram.node code=?a
@lk.dn.nb w.diagram.node code=?b
@lk.dn.mf ui.diagram.remake edge=?id mode=detach-from
@lk.dn.mt ui.diagram.remake edge=?id mode=detach-to
@lk.dn.mr ui.diagram.remake edge=?id mode=reverse
@lk.dn.keepto ui.diagram.newend edge=?id at=to node=?b
@lk.dn.keepfrom ui.diagram.newend edge=?id at=from node=?a
@lk.dn.swapto ui.diagram.newend edge=?id at=from node=?b
@lk.dn.swapfrom ui.diagram.newend edge=?id at=to node=?a
@lk.lg.newend.detach.from core.rule when=$lk.dn.mf when=$lk.dn.t when=$lk.dn.nb then=$lk.dn.keepto
@lk.lg.newend.detach.to core.rule when=$lk.dn.mt when=$lk.dn.f when=$lk.dn.na then=$lk.dn.keepfrom
@lk.lg.newend.reverse.to core.rule when=$lk.dn.mr when=$lk.dn.t when=$lk.dn.nb then=$lk.dn.swapto
@lk.lg.newend.reverse.from core.rule when=$lk.dn.mr when=$lk.dn.f when=$lk.dn.na then=$lk.dn.swapfrom
@lk.dm.m ui.diagram.remake edge=?id
@lk.dm.e w.diagram.edge code=?id n=?n
@lk.dm.rm app.act.call act=remove thing=$lk.dm.e order=1
@lk.lg.remake.remove core.rule when=$lk.dm.m when=$lk.dm.e then=$lk.dm.rm
@lk.dm.nf ui.diagram.newend edge=?id at=from node=?f
@lk.dm.nt ui.diagram.newend edge=?id at=to node=?t
@lk.dm.anf ui.diagram.newend edge=?id at=from
@lk.dm.ant ui.diagram.newend edge=?id at=to
@lk.dm.fn w.diagram.node code=?f
@lk.dm.tn w.diagram.node code=?t
@lk.dm.both app.act.call act=make kind=w.diagram.edge code=?id n=?n from=$lk.dm.fn to=$lk.dm.tn order=2 ref=remade.edge
@lk.dm.from app.act.call act=make kind=w.diagram.edge code=?id n=?n from=$lk.dm.fn order=2 ref=remade.edge
@lk.dm.to app.act.call act=make kind=w.diagram.edge code=?id n=?n to=$lk.dm.tn order=2 ref=remade.edge
@lk.dm.none app.act.call act=make kind=w.diagram.edge code=?id n=?n order=2 ref=remade.edge
@lk.lg.remake.both core.rule when=$lk.dm.m when=$lk.dm.e when=$lk.dm.nf when=$lk.dm.nt when=$lk.dm.fn when=$lk.dm.tn then=$lk.dm.both
@lk.lg.remake.from core.rule when=$lk.dm.m when=$lk.dm.e when=$lk.dm.nf when=$lk.dm.fn not=$lk.dm.ant then=$lk.dm.from
@lk.lg.remake.to core.rule when=$lk.dm.m when=$lk.dm.e when=$lk.dm.nt when=$lk.dm.tn not=$lk.dm.anf then=$lk.dm.to
@lk.lg.remake.none core.rule when=$lk.dm.m when=$lk.dm.e not=$lk.dm.anf not=$lk.dm.ant then=$lk.dm.none
# The keys it carries: the same key, or (reversed) the other end's.
@lk.dk.d1 ui.diagram.carry key=label mode=any to=label
@lk.dk.d2 ui.diagram.carry key=colour mode=any to=colour
@lk.dk.d3 ui.diagram.carry key=style mode=any to=style
@lk.dk.d4 ui.diagram.carry key=width mode=any to=width
@lk.dk.d5 ui.diagram.carry key=route mode=any to=route
@lk.dk.d6 ui.diagram.carry key=direction mode=any to=direction
@lk.dk.d7 ui.diagram.carry key=diagram.sketch.label_at mode=any to=diagram.sketch.label_at
@lk.dk.f1 ui.diagram.carry key=diagram.sketch.head mode=detach-from to=diagram.sketch.head
@lk.dk.f2 ui.diagram.carry key=diagram.sketch.tail mode=detach-from to=diagram.sketch.tail
@lk.dk.f3 ui.diagram.carry key=diagram.sketch.to_side mode=detach-from to=diagram.sketch.to_side
@lk.dk.f4 ui.diagram.carry key=diagram.sketch.to_port mode=detach-from to=diagram.sketch.to_port
@lk.dk.f5 ui.diagram.carry key=diagram.sketch.to_x mode=detach-from to=diagram.sketch.to_x
@lk.dk.f6 ui.diagram.carry key=diagram.sketch.to_y mode=detach-from to=diagram.sketch.to_y
@lk.dk.t1 ui.diagram.carry key=diagram.sketch.head mode=detach-to to=diagram.sketch.head
@lk.dk.t2 ui.diagram.carry key=diagram.sketch.tail mode=detach-to to=diagram.sketch.tail
@lk.dk.t3 ui.diagram.carry key=diagram.sketch.from_side mode=detach-to to=diagram.sketch.from_side
@lk.dk.t4 ui.diagram.carry key=diagram.sketch.from_port mode=detach-to to=diagram.sketch.from_port
@lk.dk.t5 ui.diagram.carry key=diagram.sketch.from_x mode=detach-to to=diagram.sketch.from_x
@lk.dk.t6 ui.diagram.carry key=diagram.sketch.from_y mode=detach-to to=diagram.sketch.from_y
