@lk.lg.ls core.rule when=$lk.gl.s0 when=$lk.gl.s1 with=$lk.gl.dx with=$lk.gl.dy with=$lk.gl.ax with=$lk.gl.ay with=$lk.gl.bg with=$lk.gl.sm with=$lk.gl.l1 with=$lk.gl.l2 with=$lk.gl.len then=$lk.gl.so
# The length before each segment and the whole length.
