# diagram.sketch link geometry (authored): where each end of a link is attached, the bends it passes through, the mark
# at each end and where its label sits; the commands that change them and how such a link is drawn.
#
# The link model. Each end of a link is attached to its node (w.diagram.edge from / to) at a side (top, right, bottom,
# left; auto and centre: where the line from the node's centre leaves its outline), or is free: it ends at a point of
# the page (x, y) and keeps the node it was attached to as the node it was last attached to (std.acts cannot take a
# reference away, and w.diagram.edge requires both ends). A link may pass through bends (diagram.sketch.bend, ordered
# along it). The mark at the target (head) and at the source (tail) is an arrow, an open arrow, a diamond or a circle;
# which ends have a mark stays the link's direction (forward: the head; back: the tail; both; none). The label sits at a
# fraction of the line's length (0 the source, 1 the target; the middle when not said).
#
# The keys are this area's (namespace diagram.sketch.): w.diagram owns the edge and the area adds to it, as art.draw
# adds facing to w.drawing objects. A bend is a kind of this area's own (an area may keep kinds of its own namespace in
# its state, worlds/sop-area.mjs).
#
# Drawing. A link with a side, a free end or a bend is drawn by hand (ui.diagram.manual), not by the page's routing:
# its ends are the attached sides, the free points or, for an auto end, where the line towards the next point leaves
# the node's outline; between them the bends in order. Straight: the points joined. Orthogonal: each piece turns at
# right angles, leaving and entering a side across it (top and bottom vertically, left and right sideways); one turn,
# or two halfway when both ends of a piece face the same way. Curved: quadratic pieces whose control points are the
# bends (a single curve bowed to the left when there is no bend). Marks point along the last piece.
# The keys and the bend kind are declared in link-schema.sop (read before the other rule files, which name them).

@lk.dgl.t.port core.type of=ui.diagram.port
@lk.dgl.t.bowbest core.type of=ui.diagram.bowbest
@lk.dgl.t.bowc core.type of=ui.diagram.bowc
@lk.dgl.t.bowcost core.type of=ui.diagram.bowcost
@lk.dgl.t.bowf core.type of=ui.diagram.bowf
@lk.dgl.t.bowhit core.type of=ui.diagram.bowhit
@lk.dgl.t.bown core.type of=ui.diagram.bown
@lk.dgl.t.carry core.type of=ui.diagram.carry
@lk.dgl.t.newend core.type of=ui.diagram.newend
@lk.dgl.t.nport core.type of=ui.diagram.nport
@lk.dgl.t.obest core.type of=ui.diagram.obest
@lk.dgl.t.ocand core.type of=ui.diagram.ocand
@lk.dgl.t.ocost core.type of=ui.diagram.ocost
@lk.dgl.t.ocross core.type of=ui.diagram.ocross
@lk.dgl.t.ocrossn core.type of=ui.diagram.ocrossn
@lk.dgl.t.ohit core.type of=ui.diagram.ohit
@lk.dgl.t.olen core.type of=ui.diagram.olen
@lk.dgl.t.openal core.type of=ui.diagram.openal
@lk.dgl.t.openaln core.type of=ui.diagram.openaln
@lk.dgl.t.oq core.type of=ui.diagram.oq
@lk.dgl.t.orun core.type of=ui.diagram.orun
@lk.dgl.t.orunlen core.type of=ui.diagram.orunlen
@lk.dgl.t.paircount core.type of=ui.diagram.paircount
@lk.dgl.t.pairkey core.type of=ui.diagram.pairkey
@lk.dgl.t.par core.type of=ui.diagram.par
@lk.dgl.t.patax core.type of=ui.diagram.patax
@lk.dgl.t.poff core.type of=ui.diagram.poff
@lk.dgl.t.portname core.type of=ui.diagram.portname
@lk.dgl.t.remake core.type of=ui.diagram.remake
@lk.dgl.t.rend core.type of=ui.diagram.rend
@lk.dgl.t.sshift core.type of=ui.diagram.sshift
@lk.dgl.t.endside core.type of=ui.diagram.endside
@lk.dgl.t.mnode core.type of=ui.diagram.mnode
@lk.dgl.t.anchor core.type of=ui.diagram.anchor
@lk.dgl.t.bendat core.type of=ui.diagram.bendat
@lk.dgl.t.bend core.type of=ui.diagram.bend
@lk.dgl.t.bends core.type of=ui.diagram.bends
@lk.dgl.t.bendlo core.type of=ui.diagram.bendlo
@lk.dgl.t.bendhi core.type of=ui.diagram.bendhi
@lk.dgl.t.aim core.type of=ui.diagram.aim
@lk.dgl.t.mcut core.type of=ui.diagram.mcut
@lk.dgl.t.mend core.type of=ui.diagram.mend
@lk.dgl.t.mway core.type of=ui.diagram.mway
@lk.dgl.t.mv core.type of=ui.diagram.mv
@lk.dgl.t.mvn core.type of=ui.diagram.mvn
@lk.dgl.t.mlast core.type of=ui.diagram.mlast
@lk.dgl.t.sideo core.type of=ui.diagram.sideo
@lk.dgl.t.oseg core.type of=ui.diagram.oseg
@lk.dgl.t.oeff core.type of=ui.diagram.oeff
@lk.dgl.t.opiece core.type of=ui.diagram.opiece
@lk.dgl.t.sided core.type of=ui.diagram.sided
@lk.dgl.t.stub core.type of=ui.diagram.stub
@lk.dgl.t.snorm core.type of=ui.diagram.snorm
@lk.dgl.t.oface core.type of=ui.diagram.oface
@lk.dgl.t.oend core.type of=ui.diagram.oend
@lk.dgl.t.oend0 core.type of=ui.diagram.oend0
@lk.dgl.t.stan core.type of=ui.diagram.stan
@lk.dgl.t.opat core.type of=ui.diagram.opat
@lk.dgl.t.ofit core.type of=ui.diagram.ofit
@lk.dgl.t.ctl core.type of=ui.diagram.ctl
@lk.dgl.t.ctln core.type of=ui.diagram.ctln
@lk.dgl.t.ctlp core.type of=ui.diagram.ctlp
@lk.dgl.t.ctlcount core.type of=ui.diagram.ctlcount
@lk.dgl.t.piece core.type of=ui.diagram.piece
@lk.dgl.t.leg core.type of=ui.diagram.leg
@lk.dgl.t.lt core.type of=ui.diagram.lt
@lk.dgl.t.lp core.type of=ui.diagram.lp
@lk.dgl.t.lpn core.type of=ui.diagram.lpn
@lk.dgl.t.ls core.type of=ui.diagram.ls
@lk.dgl.t.lspair core.type of=ui.diagram.lspair
@lk.dgl.t.lcum core.type of=ui.diagram.lcum
@lk.dgl.t.ltotal core.type of=ui.diagram.ltotal
@lk.dgl.t.lpos core.type of=ui.diagram.lpos
@lk.dgl.t.altmark core.type of=ui.diagram.altmark
@lk.dgl.t.markshow core.type of=ui.diagram.markshow
@lk.dgl.t.udir core.type of=ui.diagram.udir
@lk.dgl.t.pvec core.type of=ui.diagram.pvec
@lk.dgl.t.pick core.type of=ui.diagram.pick
@lk.dgl.t.endop core.type of=ui.diagram.endop
@lk.dgl.t.lcgiven core.type of=ui.diagram.lcgiven
@lk.dgl.t.ldir core.type of=ui.diagram.ldir

# Named ports of a node's shape, as flowcharts name them: every shape's in (top) and out (bottom); a decision's yes
# (bottom), no (right) and else (left); a database's lid (top) and base (bottom). A shape's own name wins over every
# shape's. (Declared here until k.diagrams carries ports at a later knowledge pin.)
@lk.ports.any.in ui.diagram.portname shape=any name=in side=top
@lk.ports.any.out ui.diagram.portname shape=any name=out side=bottom
@lk.ports.diamond.yes ui.diagram.portname shape=diamond name=yes side=bottom
@lk.ports.diamond.no ui.diagram.portname shape=diamond name=no side=right
@lk.ports.diamond.else ui.diagram.portname shape=diamond name=else side=left
@lk.ports.cylinder.lid ui.diagram.portname shape=cylinder name=lid side=top
@lk.ports.cylinder.base ui.diagram.portname shape=cylinder name=base side=bottom

# ---- Ports: the middle of each side of a node's box ----
@lk.gs.b ui.diagram.nbox node=?a x0=?x0 y0=?y0 x1=?x1 y1=?y1 cx=?cx cy=?cy
@lk.gs.t ui.diagram.port node=?a side=top x=?cx y=?y0
@lk.gs.r ui.diagram.port node=?a side=right x=?x1 y=?cy
@lk.gs.bo ui.diagram.port node=?a side=bottom x=?cx y=?y1
@lk.gs.l ui.diagram.port node=?a side=left x=?x0 y=?cy
@lk.lg.port.top core.rule when=$lk.gs.b then=$lk.gs.t
@lk.lg.port.right core.rule when=$lk.gs.b then=$lk.gs.r
@lk.lg.port.bottom core.rule when=$lk.gs.b then=$lk.gs.bo
@lk.lg.port.left core.rule when=$lk.gs.b then=$lk.gs.l

# ---- Which links are drawn by hand ----
# A link with a side, a free end (no node at that end) or a bend; a curved or elbow-routed link between two units (the
# router below keeps it off other nodes); and every link that shares its two nodes with another (they fan out). Links
# routed through the gaps of a top-down flow, inside one group or to themselves keep the page's routing.
@lk.gm.sides core.check fn=matches args=?s args="^(top|right|bottom|left)$"
@lk.gm.fs w.diagram.edge code=?e diagram.sketch.from_side=?s
@lk.gm.fs.o ui.diagram.endside edge=?e at=a side=?s
@lk.lg.endside.from core.rule when=$lk.gm.fs if=$lk.gm.sides then=$lk.gm.fs.o
@lk.gm.ts w.diagram.edge code=?e diagram.sketch.to_side=?s
@lk.gm.ts.o ui.diagram.endside edge=?e at=b side=?s
@lk.lg.endside.to core.rule when=$lk.gm.ts if=$lk.gm.sides then=$lk.gm.ts.o
@lk.gm.es ui.diagram.endside edge=?e
@lk.gm.out ui.diagram.manual edge=?e
@lk.lg.manual.side core.rule when=$lk.gm.es then=$lk.gm.out
@lk.gm.e w.diagram.edge code=?e
@lk.gm.hasf w.diagram.edge code=?e from=?anyf
@lk.gm.hast w.diagram.edge code=?e to=?anyt
@lk.lg.manual.from.open core.rule when=$lk.gm.e not=$lk.gm.hasf then=$lk.gm.out
@lk.lg.manual.to.open core.rule when=$lk.gm.e not=$lk.gm.hast then=$lk.gm.out
@lk.gm.b diagram.sketch.bend edge=$lk.gm.be
@lk.gm.be w.diagram.edge code=?e
@lk.lg.manual.bend core.rule when=$lk.gm.b when=$lk.gm.be then=$lk.gm.out
@lk.gm.two w.diagram.edge code=?e from=$lk.gm.na to=$lk.gm.nb
@lk.gm.na w.diagram.node code=?a
@lk.gm.nb w.diagram.node code=?b
@lk.gm.ua ui.diagram.unitof node=?a unit=?ua
@lk.gm.ub ui.diagram.unitof node=?b unit=?ub
@lk.gm.apart core.check fn=neq args=?ua args=?ub
@lk.gm.curved w.diagram.edge code=?e route=curved
@lk.lg.manual.curved core.rule when=$lk.gm.two when=$lk.gm.na when=$lk.gm.nb when=$lk.gm.ua when=$lk.gm.ub when=$lk.gm.curved if=$lk.gm.apart then=$lk.gm.out
@lk.gm.ortho w.diagram.edge code=?e route=orthogonal
@lk.gm.elbow ui.diagram.ortho value=elbow
@lk.lg.manual.elbow core.rule when=$lk.gm.two when=$lk.gm.na when=$lk.gm.nb when=$lk.gm.ua when=$lk.gm.ub when=$lk.gm.ortho when=$lk.gm.elbow if=$lk.gm.apart then=$lk.gm.out
@lk.gm.anyr w.diagram.edge code=?e route=?anyr
@lk.gm.pw ui.diagram.pway value=?pw
@lk.gm.pwr core.check fn=matches args=?pw args="^(elbow|curved)$"
@lk.lg.manual.page core.rule when=$lk.gm.two when=$lk.gm.na when=$lk.gm.nb when=$lk.gm.ua when=$lk.gm.ub when=$lk.gm.pw not=$lk.gm.anyr if=$lk.gm.apart if=$lk.gm.pwr then=$lk.gm.out
# Links between the same two nodes (either way): each its place k among them (in the order made) and its offset from
# the middle, as it is (rawoff, for shifts on the page) and turned with the link's own direction (off, for shifts to
# its left).
@lk.pp.e w.diagram.edge code=?e n=?n from=$lk.pp.na to=$lk.pp.nb
@lk.pp.na w.diagram.node code=?a
@lk.pp.nb w.diagram.node code=?b
@lk.pp.lt core.check fn=lt args=?a args=?b
@lk.pp.gt core.check fn=gt args=?a args=?b
@lk.pp.k1 core.calc out=?key fn=concat args=?a args="~" args=?b
@lk.pp.k2 core.calc out=?key fn=concat args=?b args="~" args=?a
@lk.pp.o1 ui.diagram.pairkey edge=?e key=?key n=?n sgn=1
@lk.pp.o2 ui.diagram.pairkey edge=?e key=?key n=?n sgn=-1
@lk.lg.pairkey.up core.rule when=$lk.pp.e when=$lk.pp.na when=$lk.pp.nb if=$lk.pp.lt with=$lk.pp.k1 then=$lk.pp.o1
@lk.lg.pairkey.down core.rule when=$lk.pp.e when=$lk.pp.na when=$lk.pp.nb if=$lk.pp.gt with=$lk.pp.k2 then=$lk.pp.o2
@lk.pp.c ui.diagram.pairkey edge=?e key=?key
@lk.pp.co ui.diagram.paircount key=?key count=?c
@lk.lg.paircount core.aggregate over=$lk.pp.c by=?key count=?c then=$lk.pp.co
@lk.pp.f ui.diagram.pairkey edge=?e key=?key n=?n sgn=?sgn
@lk.pp.n ui.diagram.paircount key=?key count=?c
@lk.pp.many core.check fn=gt args=?c args=1
@lk.pp.k core.rank of=$lk.pp.f by=n within=?key out=?k
@lk.pp.h1 core.calc out=?h1 fn=add args=?c args=1
@lk.pp.h core.calc out=?h fn=div args=?h1 args=2
@lk.pp.raw core.calc out=?raw fn=sub args=?k args=?h
@lk.pp.off core.calc out=?off fn=mul args=?raw args=?sgn
@lk.pp.out ui.diagram.par edge=?e off=?off rawoff=?raw
@lk.lg.par core.rule when=$lk.pp.f when=$lk.pp.n if=$lk.pp.many with=$lk.pp.k with=$lk.pp.h1 with=$lk.pp.h with=$lk.pp.raw with=$lk.pp.off then=$lk.pp.out
@lk.pp.p ui.diagram.par edge=?e
@lk.lg.manual.parallel core.rule when=$lk.pp.p then=$lk.gm.out
@lk.pp.m ui.diagram.manual edge=?e
@lk.pp.poff.o ui.diagram.poff edge=?e off=?off rawoff=?raw
@lk.pp.pf ui.diagram.par edge=?e off=?off rawoff=?raw
@lk.lg.poff core.rule when=$lk.pp.pf then=$lk.pp.poff.o
@lk.pp.pz ui.diagram.poff edge=?e off=0 rawoff=0
@lk.lg.poff.zero core.rule when=$lk.pp.m not=$lk.pp.p then=$lk.pp.pz

# The way a hand-drawn link goes: its own route, else the page's (gap routing and elbows are orthogonal).
@lk.gw.m ui.diagram.manual edge=?e
@lk.gw.r w.diagram.edge code=?e route=?r
@lk.gw.out ui.diagram.mway edge=?e way=?r
@lk.lg.mway.own core.rule when=$lk.gw.m when=$lk.gw.r then=$lk.gw.out
@lk.gw.any w.diagram.edge code=?e route=?anyr
@lk.gw.p ui.diagram.pway value=?pw
@lk.gw.ortho core.check fn=matches args=?pw args="^(gap|elbow)$"
@lk.gw.o ui.diagram.mway edge=?e way=orthogonal
@lk.lg.mway.page.ortho core.rule when=$lk.gw.m when=$lk.gw.p not=$lk.gw.any if=$lk.gw.ortho then=$lk.gw.o
@lk.gw.drawn core.check fn=matches args=?pw args="^(straight|curved)$"
@lk.gw.d ui.diagram.mway edge=?e way=?pw
@lk.lg.mway.page.drawn core.rule when=$lk.gw.m when=$lk.gw.p not=$lk.gw.any if=$lk.gw.drawn then=$lk.gw.d
# A hand-drawn link is a route of its own way (so its line, colour and dash are drawn as any other's); a free end's
# node is "free". The node at each attached end (mnode).
@lk.gw.e w.diagram.edge code=?e
@lk.gw.f w.diagram.edge code=?e from=$lk.gw.na
@lk.gw.t w.diagram.edge code=?e to=$lk.gw.nb
@lk.gw.na w.diagram.node code=?a
@lk.gw.nb w.diagram.node code=?b
@lk.gw.ra ui.diagram.rend edge=?e at=a node=?a
@lk.gw.rb ui.diagram.rend edge=?e at=b node=?b
@lk.gw.rfa ui.diagram.rend edge=?e at=a node=free
@lk.gw.rfb ui.diagram.rend edge=?e at=b node=free
@lk.lg.rend.a core.rule when=$lk.gw.m when=$lk.gw.f when=$lk.gw.na then=$lk.gw.ra
@lk.lg.rend.b core.rule when=$lk.gw.m when=$lk.gw.t when=$lk.gw.nb then=$lk.gw.rb
@lk.gw.hf w.diagram.edge code=?e from=?anyf
@lk.gw.ht w.diagram.edge code=?e to=?anyt
@lk.lg.rend.a.free core.rule when=$lk.gw.m when=$lk.gw.e not=$lk.gw.hf then=$lk.gw.rfa
@lk.lg.rend.b.free core.rule when=$lk.gw.m when=$lk.gw.e not=$lk.gw.ht then=$lk.gw.rfb
@lk.gw.xa ui.diagram.rend edge=?e at=a node=?a
@lk.gw.xb ui.diagram.rend edge=?e at=b node=?b
@lk.gw.route ui.diagram.route edge=?e way=manual a=?a b=?b la=0 lb=0
@lk.lg.route.manual core.rule when=$lk.gw.xa when=$lk.gw.xb then=$lk.gw.route
@lk.gw.mn.a ui.diagram.mnode edge=?e at=a node=?a
@lk.gw.mn.b ui.diagram.mnode edge=?e at=b node=?b
@lk.lg.mnode.a core.rule when=$lk.gw.m when=$lk.gw.f when=$lk.gw.na then=$lk.gw.mn.a
@lk.lg.mnode.b core.rule when=$lk.gw.m when=$lk.gw.t when=$lk.gw.nb then=$lk.gw.mn.b

# ---- The anchor of each end: its free point, its side's port, or (auto) its node's centre ----
# A straight link that shares its nodes with others is moved to the side by 12 per place (its centres shifted).
@lk.ga.m ui.diagram.manual edge=?e
@lk.ga.hf w.diagram.edge code=?e from=?anyf
@lk.ga.ht w.diagram.edge code=?e to=?anyt
@lk.ga.free.a w.diagram.edge code=?e diagram.sketch.from_x=?x diagram.sketch.from_y=?y
@lk.ga.free.ao ui.diagram.anchor edge=?e at=a x=?x y=?y side=free
@lk.lg.anchor.a.free core.rule when=$lk.ga.m when=$lk.ga.free.a not=$lk.ga.hf then=$lk.ga.free.ao
@lk.ga.free.b w.diagram.edge code=?e diagram.sketch.to_x=?x diagram.sketch.to_y=?y
@lk.ga.free.bo ui.diagram.anchor edge=?e at=b x=?x y=?y side=free
@lk.lg.anchor.b.free core.rule when=$lk.ga.m when=$lk.ga.free.b not=$lk.ga.ht then=$lk.ga.free.bo
@lk.ga.mn ui.diagram.mnode edge=?e at=?at node=?n
@lk.ga.side ui.diagram.endside edge=?e at=?at side=?s
@lk.ga.port ui.diagram.port node=?n side=?s x=?x y=?y
@lk.ga.side.o ui.diagram.anchor edge=?e at=?at x=?x y=?y side=?s
@lk.lg.anchor.side core.rule when=$lk.ga.mn when=$lk.ga.side when=$lk.ga.port then=$lk.ga.side.o
@lk.ga.noside ui.diagram.endside edge=?e at=?at
@lk.ga.box ui.diagram.nbox node=?n cx=?x cy=?y
@lk.ga.auto.o ui.diagram.anchor edge=?e at=?at x=?x y=?y side=auto
@lk.ga.ss ui.diagram.sshift edge=?e
@lk.lg.anchor.auto core.rule when=$lk.ga.mn when=$lk.ga.box not=$lk.ga.noside not=$lk.ga.ss then=$lk.ga.auto.o
@lk.ga.sw ui.diagram.mway edge=?e way=straight
@lk.ga.sp ui.diagram.par edge=?e off=?off
@lk.ga.sso ui.diagram.sshift edge=?e
@lk.lg.sshift core.rule when=$lk.ga.sw when=$lk.ga.sp then=$lk.ga.sso
@lk.ga.s.mn ui.diagram.mnode edge=?e at=?at node=?n
@lk.ga.s.ma ui.diagram.mnode edge=?e at=a node=?na
@lk.ga.s.mb ui.diagram.mnode edge=?e at=b node=?nb
@lk.ga.s.ba ui.diagram.nbox node=?na cx=?ax cy=?ay
@lk.ga.s.bb ui.diagram.nbox node=?nb cx=?bx cy=?by
@lk.ga.s.b ui.diagram.nbox node=?n cx=?cx cy=?cy
@lk.ga.s.p ui.diagram.par edge=?e off=?off
@lk.ga.s.dx core.calc out=?dx fn=sub args=?bx args=?ax
@lk.ga.s.dy core.calc out=?dy fn=sub args=?by args=?ay
@lk.ga.s.adx core.calc out=?adx fn=abs args=?dx
@lk.ga.s.ady core.calc out=?ady fn=abs args=?dy
@lk.ga.s.bg core.calc out=?bg fn=max args=?adx args=?ady
@lk.ga.s.sm core.calc out=?sm fn=min args=?adx args=?ady
@lk.ga.s.l1 core.calc out=?l1 fn=mul args=?bg args=0.96043
@lk.ga.s.l2 core.calc out=?l2 fn=mul args=?sm args=0.39782
@lk.ga.s.l3 core.calc out=?l3 fn=add args=?l1 args=?l2
@lk.ga.s.ln core.calc out=?ln fn=max args=?l3 args=0.001
@lk.ga.s.k core.calc out=?k fn=div args=?off args=?ln
@lk.ga.s.k12 core.calc out=?k12 fn=mul args=?k args=12
@lk.ga.s.ox core.calc out=?ox fn=mul args=?dy args=?k12
@lk.ga.s.oy0 core.calc out=?oy0 fn=mul args=?dx args=?k12
@lk.ga.s.oy core.calc out=?oy fn=mul args=?oy0 args=-1
@lk.ga.s.x core.calc out=?x fn=add args=?cx args=?ox
@lk.ga.s.y core.calc out=?y fn=add args=?cy args=?oy
@lk.lg.anchor.auto.shifted core.rule when=$lk.ga.ss when=$lk.ga.s.mn when=$lk.ga.s.ma when=$lk.ga.s.mb when=$lk.ga.s.ba when=$lk.ga.s.bb when=$lk.ga.s.b when=$lk.ga.s.p not=$lk.ga.noside with=$lk.ga.s.dx with=$lk.ga.s.dy with=$lk.ga.s.adx with=$lk.ga.s.ady with=$lk.ga.s.bg with=$lk.ga.s.sm with=$lk.ga.s.l1 with=$lk.ga.s.l2 with=$lk.ga.s.l3 with=$lk.ga.s.ln with=$lk.ga.s.k with=$lk.ga.s.k12 with=$lk.ga.s.ox with=$lk.ga.s.oy0 with=$lk.ga.s.oy with=$lk.ga.s.x with=$lk.ga.s.y then=$lk.ga.auto.o

# ---- Bends in order (k from 1), how many, the lowest and highest order ----
@lk.gb.b diagram.sketch.bend edge=$lk.gb.e seq=?o x=?x y=?y
@lk.gb.e w.diagram.edge code=?e
@lk.gb.flat ui.diagram.bendat edge=?e order=?o x=?x y=?y
@lk.lg.bendat core.rule when=$lk.gb.b when=$lk.gb.e then=$lk.gb.flat
@lk.gr.f ui.diagram.bendat edge=?e order=?o x=?x y=?y
@lk.gr.k core.rank of=$lk.gr.f by=order within=?e out=?k
@lk.gr.o ui.diagram.bend edge=?e k=?k order=?o x=?x y=?y
@lk.lg.bendrank core.rule when=$lk.gr.f with=$lk.gr.k then=$lk.gr.o
@lk.gc.f ui.diagram.bendat edge=?e order=?o
@lk.gc.o ui.diagram.bends edge=?e count=?n
@lk.lg.bendcount core.aggregate over=$lk.gc.f by=?e count=?n then=$lk.gc.o
@lk.gc.lo ui.diagram.bendlo edge=?e order=?m
@lk.lg.bendlo core.aggregate over=$lk.gc.f by=?e min=?m args=?o then=$lk.gc.lo
@lk.gc.hi ui.diagram.bendhi edge=?e order=?m
@lk.lg.bendhi core.aggregate over=$lk.gc.f by=?e max=?m args=?o then=$lk.gc.hi
@lk.gc.m ui.diagram.manual edge=?e
@lk.gc.any ui.diagram.bendat edge=?e
@lk.gc.zero ui.diagram.bends edge=?e count=0
@lk.lg.bendcount.zero core.rule when=$lk.gc.m not=$lk.gc.any then=$lk.gc.zero

# ---- Where an auto end leaves its node: towards the first (last) bend, else the other end's anchor ----
@lk.gi.b1 ui.diagram.bend edge=?e k=1 x=?x y=?y
@lk.gi.ao ui.diagram.aim edge=?e at=a x=?x y=?y
@lk.lg.aim.a.bend core.rule when=$lk.gi.b1 then=$lk.gi.ao
@lk.gi.any ui.diagram.bendat edge=?e
@lk.gi.anb ui.diagram.anchor edge=?e at=b x=?x y=?y
@lk.lg.aim.a.anchor core.rule when=$lk.gi.anb not=$lk.gi.any then=$lk.gi.ao
@lk.gi.cnt ui.diagram.bends edge=?e count=?n
@lk.gi.bl ui.diagram.bend edge=?e k=?k x=?x y=?y
@lk.gi.last core.check fn=eq args=?k args=?n
@lk.gi.bo ui.diagram.aim edge=?e at=b x=?x y=?y
@lk.lg.aim.b.bend core.rule when=$lk.gi.cnt when=$lk.gi.bl if=$lk.gi.last then=$lk.gi.bo
@lk.gi.ana ui.diagram.anchor edge=?e at=a x=?x y=?y
@lk.lg.aim.b.anchor core.rule when=$lk.gi.ana not=$lk.gi.any then=$lk.gi.bo
# The fraction t of the line from the centre to the aim inside the node's outline (as for straight links).
@lk.gq.an ui.diagram.anchor edge=?e at=?at side=auto
@lk.gq.ai ui.diagram.aim edge=?e at=?at x=?ax y=?ay
@lk.gq.mn ui.diagram.mnode edge=?e at=?at node=?n
@lk.gq.b ui.diagram.nbox node=?n cx=?cx cy=?cy w=?w h=?h
@lk.gq.k ui.diagram.nkind node=?n kind=?kind
@lk.gq.dx core.calc out=?dx fn=sub args=?ax args=?cx
@lk.gq.dy core.calc out=?dy fn=sub args=?ay args=?cy
@lk.gq.adx0 core.calc out=?adx0 fn=abs args=?dx
@lk.gq.ady0 core.calc out=?ady0 fn=abs args=?dy
@lk.gq.adx core.calc out=?adx fn=max args=?adx0 args=0.001
@lk.gq.ady core.calc out=?ady fn=max args=?ady0 args=0.001
