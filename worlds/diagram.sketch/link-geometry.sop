@lk.lg.curve.leg.tail core.rule when=$lk.gu.p if=$lk.gu.first with=$lk.gu.tl with=$lk.gu.tm then=$lk.gu.to

# ---- The legs as arrowheads (unit vectors; layout-modes.sop draws them and observes the tips) ----
@lk.gh.l ui.diagram.leg edge=?e at=?at x=?x y=?y dx=?dx dy=?dy
