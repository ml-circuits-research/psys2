@lk.lg.ortho.hv core.rule when=$lk.gx.f if=$lk.gx.ishv with=$lk.gx.n1 with=$lk.gx.n30 then=$lk.gx.hv
@lk.lg.ortho.vh core.rule when=$lk.gx.f if=$lk.gx.isvh with=$lk.gx.n1 with=$lk.gx.n30 then=$lk.gx.vh
