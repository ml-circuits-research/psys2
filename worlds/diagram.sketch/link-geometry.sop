# The legs at the ends: into an attached side straight out of its stub; at a free end along the piece's last (first)
# run: across for hv and vhv, sideways for vh and hvh (a tiny share of the piece is added, for a run of no length).
@lk.gy.sm ui.diagram.mend edge=?e at=?at x=?x y=?y
@lk.gy.st ui.diagram.stub edge=?e at=?at nx=?nx ny=?ny o=?o
@lk.gy.side core.check fn=neq args=?o args=free
@lk.gy.ux core.calc out=?ux fn=mul args=?nx args=-1
@lk.gy.uy core.calc out=?uy fn=mul args=?ny args=-1
@lk.gy.isb core.check fn=eq args=?at args=b
@lk.gy.isa core.check fn=eq args=?at args=a
@lk.gy.so ui.diagram.leg edge=?e at=head x=?x y=?y dx=?ux dy=?uy
@lk.gy.to ui.diagram.leg edge=?e at=tail x=?x y=?y dx=?ux dy=?uy
@lk.lg.ortho.leg.head.side core.rule when=$lk.go.w when=$lk.gy.sm when=$lk.gy.st if=$lk.gy.side if=$lk.gy.isb with=$lk.gy.ux with=$lk.gy.uy then=$lk.gy.so
@lk.lg.ortho.leg.tail.side core.rule when=$lk.go.w when=$lk.gy.sm when=$lk.gy.st if=$lk.gy.side if=$lk.gy.isa with=$lk.gy.ux with=$lk.gy.uy then=$lk.gy.to
@lk.gy.f ui.diagram.ofit edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by pat=?pat
@lk.gy.last ui.diagram.mlast edge=?e i=?l
@lk.gy.sdb ui.diagram.sided edge=?e at=b
@lk.gy.sda ui.diagram.sided edge=?e at=a
@lk.gy.i1 core.calc out=?i1 fn=add args=?i args=1
@lk.gy.islast core.check fn=eq args=?i1 args=?l
@lk.gy.first core.check fn=eq args=?i args=0
@lk.gy.dx core.calc out=?dx fn=sub args=?bx args=?ax
@lk.gy.dy core.calc out=?dy fn=sub args=?by args=?ay
@lk.gy.ex core.calc out=?ex fn=mul args=?dx args=0.001
@lk.gy.ey core.calc out=?ey fn=mul args=?dy args=0.001
@lk.gy.across core.check fn=matches args=?pat args="^(hv|vhv)$"
@lk.gy.sideways core.check fn=matches args=?pat args="^(vh|hvh)$"
@lk.gy.ha core.calc out=?hy fn=add args=?dy args=?ey
