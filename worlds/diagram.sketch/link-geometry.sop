@lk.gj.o1 ui.diagram.point source=?src n=1 x=?lx y=?ly
@lk.gj.o2 ui.diagram.point source=?src n=2 x=?x y=?y
@lk.gj.o3 ui.diagram.point source=?src n=3 x=?rx y=?ry
@lk.gj.odraw ui.diagram.draw part=?e source=?src slot=?e order=2 z=1 shape=line x=0 y=0 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left stroke=?sw
@lk.gj.ofill ui.diagram.fill source=?src part=?e fill=?f
@lk.lg.mark.open.1 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isopen with=$lk.gj.src with=$lk.gj.bx1 with=$lk.gj.by1 with=$lk.gj.bx with=$lk.gj.by with=$lk.gj.nx with=$lk.gj.ny with=$lk.gj.lx with=$lk.gj.ly then=$lk.gj.o1
@lk.lg.mark.open.2 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isopen with=$lk.gj.src then=$lk.gj.o2
@lk.lg.mark.open.3 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isopen with=$lk.gj.src with=$lk.gj.bx1 with=$lk.gj.by1 with=$lk.gj.bx with=$lk.gj.by with=$lk.gj.nx with=$lk.gj.ny with=$lk.gj.rx with=$lk.gj.ry then=$lk.gj.o3
@lk.lg.mark.open.draw core.rule when=$lk.gj.s when=$lk.gj.u when=$lk.gj.w if=$lk.gj.isopen with=$lk.gj.src then=$lk.gj.odraw
@lk.lg.mark.open.fill core.rule when=$lk.gj.s when=$lk.gj.u when=$lk.gj.c if=$lk.gj.isopen with=$lk.gj.src then=$lk.gj.ofill
@lk.gj.mx1 core.calc out=?mx1 fn=mul args=?ux args=8
@lk.gj.my1 core.calc out=?my1 fn=mul args=?uy args=8
@lk.gj.mx core.calc out=?mx fn=sub args=?x args=?mx1
@lk.gj.my core.calc out=?my fn=sub args=?y args=?my1
@lk.gj.fx1 core.calc out=?fx1 fn=mul args=?ux args=16
@lk.gj.fy1 core.calc out=?fy1 fn=mul args=?uy args=16
@lk.gj.fx core.calc out=?fx fn=sub args=?x args=?fx1
@lk.gj.fy core.calc out=?fy fn=sub args=?y args=?fy1
@lk.gj.wx core.calc out=?wx fn=mul args=?uy args=-5
@lk.gj.wy core.calc out=?wy fn=mul args=?ux args=5
@lk.gj.dlx core.calc out=?dlx fn=add args=?mx args=?wx
@lk.gj.dly core.calc out=?dly fn=add args=?my args=?wy
@lk.gj.drx core.calc out=?drx fn=sub args=?mx args=?wx
@lk.gj.dry core.calc out=?dry fn=sub args=?my args=?wy
@lk.gj.d1 ui.diagram.point source=?src n=1 x=?x y=?y
@lk.gj.d2 ui.diagram.point source=?src n=2 x=?dlx y=?dly
@lk.gj.d3 ui.diagram.point source=?src n=3 x=?fx y=?fy
@lk.gj.d4 ui.diagram.point source=?src n=4 x=?drx y=?dry
@lk.gj.ddraw ui.diagram.draw part=?e source=?src slot=?e order=2 z=1 shape=polygon x=0 y=0 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left
@lk.lg.mark.diamond.1 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src then=$lk.gj.d1
@lk.lg.mark.diamond.2 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src with=$lk.gj.mx1 with=$lk.gj.my1 with=$lk.gj.mx with=$lk.gj.my with=$lk.gj.wx with=$lk.gj.wy with=$lk.gj.dlx with=$lk.gj.dly then=$lk.gj.d2
@lk.lg.mark.diamond.3 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src with=$lk.gj.fx1 with=$lk.gj.fy1 with=$lk.gj.fx with=$lk.gj.fy then=$lk.gj.d3
@lk.lg.mark.diamond.4 core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src with=$lk.gj.mx1 with=$lk.gj.my1 with=$lk.gj.mx with=$lk.gj.my with=$lk.gj.wx with=$lk.gj.wy with=$lk.gj.drx with=$lk.gj.dry then=$lk.gj.d4
@lk.lg.mark.diamond.draw core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.isdia with=$lk.gj.src then=$lk.gj.ddraw
@lk.lg.mark.diamond.fill core.rule when=$lk.gj.s when=$lk.gj.u when=$lk.gj.c if=$lk.gj.isdia with=$lk.gj.src then=$lk.gj.ofill
@lk.gj.ccx1 core.calc out=?ccx1 fn=mul args=?ux args=5
@lk.gj.ccy1 core.calc out=?ccy1 fn=mul args=?uy args=5
@lk.gj.ccx core.calc out=?ccx fn=sub args=?x args=?ccx1
@lk.gj.ccy core.calc out=?ccy fn=sub args=?y args=?ccy1
@lk.gj.cbx core.calc out=?cbx fn=sub args=?ccx args=5
@lk.gj.cby core.calc out=?cby fn=sub args=?ccy args=5
@lk.gj.cdraw ui.diagram.draw part=?e source=?src slot=?e order=2 z=1 shape=circle x=?cbx y=?cby w=10 h=10 cx=0 cy=0 tx=0 ty=0 scale=1 side=left
@lk.lg.mark.circle.draw core.rule when=$lk.gj.s when=$lk.gj.u if=$lk.gj.iscirc with=$lk.gj.src with=$lk.gj.ccx1 with=$lk.gj.ccy1 with=$lk.gj.ccx with=$lk.gj.ccy with=$lk.gj.cbx with=$lk.gj.cby then=$lk.gj.cdraw
@lk.lg.mark.circle.fill core.rule when=$lk.gj.s when=$lk.gj.u when=$lk.gj.c if=$lk.gj.iscirc with=$lk.gj.src then=$lk.gj.ofill

# ---- Commands ----
# The link commands that name links by `ids` (a missing one is refused, act-rules.sop).
@lk.edgeop.attach ui.diagram.edgeop operation="diagram.link.attach"
@lk.edgeop.detach ui.diagram.edgeop operation="diagram.link.detach"
@lk.edgeop.bend.add ui.diagram.edgeop operation="diagram.link.bend.add"
@lk.edgeop.bend.move ui.diagram.edgeop operation="diagram.link.bend.move"
@lk.edgeop.bend.remove ui.diagram.edgeop operation="diagram.link.bend.remove"
@lk.c.it app.act.item param="ids" value=?id
@lk.c.ed w.diagram.edge code=?id

# A change names one of the link's properties (act-rules.sop refuses one that names none).
@lk.c.g1 app.act.request operation="diagram.link.change" fromSide=?v
@lk.c.g2 app.act.request operation="diagram.link.change" toSide=?v
@lk.c.g3 app.act.request operation="diagram.link.change" head=?v
@lk.c.g4 app.act.request operation="diagram.link.change" tail=?v
@lk.c.g5 app.act.request operation="diagram.link.change" labelAt=?v
@lk.c.g6 app.act.request operation="diagram.link.change" labelPosition=?v
@lk.c.g7 app.act.request operation="diagram.link.change" fromX=?v
@lk.c.g8 app.act.request operation="diagram.link.change" fromY=?v
@lk.c.g9 app.act.request operation="diagram.link.change" toX=?v
@lk.c.g10 app.act.request operation="diagram.link.change" toY=?v
@lk.c.go ui.diagram.lcgiven value=yes
@lk.lg.given.1 core.rule when=$lk.c.g1 then=$lk.c.go
@lk.lg.given.2 core.rule when=$lk.c.g2 then=$lk.c.go
@lk.lg.given.3 core.rule when=$lk.c.g3 then=$lk.c.go
@lk.lg.given.4 core.rule when=$lk.c.g4 then=$lk.c.go
@lk.lg.given.5 core.rule when=$lk.c.g5 then=$lk.c.go
@lk.lg.given.6 core.rule when=$lk.c.g6 then=$lk.c.go
@lk.lg.given.7 core.rule when=$lk.c.g7 then=$lk.c.go
@lk.lg.given.8 core.rule when=$lk.c.g8 then=$lk.c.go
@lk.lg.given.9 core.rule when=$lk.c.g9 then=$lk.c.go
@lk.lg.given.10 core.rule when=$lk.c.g10 then=$lk.c.go

# The sides an end is attached at.
@lk.c.fs.r app.act.request operation="diagram.link.change" fromSide=?v
@lk.c.fs.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=?v order=4
@lk.lg.change.from.side core.rule when=$lk.c.fs.r when=$lk.c.it when=$lk.c.ed then=$lk.c.fs.c
@lk.c.ts.r app.act.request operation="diagram.link.change" toSide=?v
@lk.c.ts.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=?v order=4
@lk.lg.change.to.side core.rule when=$lk.c.ts.r when=$lk.c.it when=$lk.c.ed then=$lk.c.ts.c
# Attaching an end to a node (from, to) makes it fixed again when it was free.
@lk.c.af.r app.act.request operation="diagram.link.change" from=?n
@lk.c.af.e w.diagram.edge code=?id diagram.sketch.from_free=true
@lk.c.af.n w.diagram.node code=?n
@lk.c.af.c app.act.call act=change thing=$lk.c.af.e attr=diagram.sketch.from_free value=false order=4
@lk.lg.change.from.fixed core.rule when=$lk.c.af.r when=$lk.c.it when=$lk.c.af.e when=$lk.c.af.n then=$lk.c.af.c
@lk.c.at.r app.act.request operation="diagram.link.change" to=?n
@lk.c.at.e w.diagram.edge code=?id diagram.sketch.to_free=true
@lk.c.at.c app.act.call act=change thing=$lk.c.at.e attr=diagram.sketch.to_free value=false order=4
@lk.lg.change.to.fixed core.rule when=$lk.c.at.r when=$lk.c.it when=$lk.c.at.e when=$lk.c.af.n then=$lk.c.at.c
# A free end at a point.
@lk.c.fx.r app.act.request operation="diagram.link.change" fromX=?v
@lk.c.fx.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_x value=?v order=4
@lk.c.free.f app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_free value=true order=5
@lk.lg.change.from.x core.rule when=$lk.c.fx.r when=$lk.c.it when=$lk.c.ed then=$lk.c.fx.c
@lk.lg.change.from.x.free core.rule when=$lk.c.fx.r when=$lk.c.it when=$lk.c.ed then=$lk.c.free.f
@lk.c.fy.r app.act.request operation="diagram.link.change" fromY=?v
@lk.c.fy.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_y value=?v order=4
@lk.lg.change.from.y core.rule when=$lk.c.fy.r when=$lk.c.it when=$lk.c.ed then=$lk.c.fy.c
@lk.lg.change.from.y.free core.rule when=$lk.c.fy.r when=$lk.c.it when=$lk.c.ed then=$lk.c.free.f
@lk.c.tx.r app.act.request operation="diagram.link.change" toX=?v
@lk.c.tx.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_x value=?v order=4
@lk.c.free.t app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_free value=true order=5
@lk.lg.change.to.x core.rule when=$lk.c.tx.r when=$lk.c.it when=$lk.c.ed then=$lk.c.tx.c
@lk.lg.change.to.x.free core.rule when=$lk.c.tx.r when=$lk.c.it when=$lk.c.ed then=$lk.c.free.t
@lk.c.ty.r app.act.request operation="diagram.link.change" toY=?v
@lk.c.ty.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_y value=?v order=4
@lk.lg.change.to.y core.rule when=$lk.c.ty.r when=$lk.c.it when=$lk.c.ed then=$lk.c.ty.c
@lk.lg.change.to.y.free core.rule when=$lk.c.ty.r when=$lk.c.it when=$lk.c.ed then=$lk.c.free.t
# Where the label sits: start, middle or end, or a fraction of the length.
@lk.c.la.r app.act.request operation="diagram.link.change" labelAt=?w
@lk.c.la.t ui.diagram.ldir name=?w t=?t
@lk.c.la.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.label_at value=?t order=4
@lk.lg.change.label.at core.rule when=$lk.c.la.r when=$lk.c.la.t when=$lk.c.it when=$lk.c.ed then=$lk.c.la.c
@lk.c.ld.start ui.diagram.ldir name=start t=0.2
@lk.c.ld.middle ui.diagram.ldir name=middle t=0.5
@lk.c.ld.end ui.diagram.ldir name=end t=0.8
@lk.c.lp.r app.act.request operation="diagram.link.change" labelPosition=?t
@lk.c.lp.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.label_at value=?t order=4
@lk.lg.change.label.position core.rule when=$lk.c.lp.r when=$lk.c.it when=$lk.c.ed then=$lk.c.lp.c

# The mark at each end. A kind shows that end's mark (the direction gains the end); none takes the mark away (the
# direction loses it); the kind of a shown end is kept.
@lk.c.hd.r app.act.request operation="diagram.link.change" head=?k
@lk.c.hd.kind core.check fn=neq args=?k args=none
@lk.c.hd.nokind core.check fn=eq args=?k args=none
@lk.c.hd.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.head value=?k order=4
@lk.lg.change.head core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.ed if=$lk.c.hd.kind then=$lk.c.hd.c
@lk.c.dir.none w.diagram.edge code=?id direction=none
@lk.c.dir.back w.diagram.edge code=?id direction=back
@lk.c.dir.fwd w.diagram.edge code=?id direction=forward
@lk.c.dir.both w.diagram.edge code=?id direction=both
@lk.c.to.fwd.n app.act.call act=change thing=$lk.c.dir.none attr=direction value=forward order=5
@lk.c.to.both.b app.act.call act=change thing=$lk.c.dir.back attr=direction value=both order=5
@lk.lg.change.head.shows.none core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.dir.none if=$lk.c.hd.kind then=$lk.c.to.fwd.n
@lk.lg.change.head.shows.back core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.dir.back if=$lk.c.hd.kind then=$lk.c.to.both.b
@lk.c.to.none.f app.act.call act=change thing=$lk.c.dir.fwd attr=direction value=none order=5
@lk.c.to.back.b app.act.call act=change thing=$lk.c.dir.both attr=direction value=back order=5
@lk.lg.change.head.off.forward core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.dir.fwd if=$lk.c.hd.nokind then=$lk.c.to.none.f
@lk.lg.change.head.off.both core.rule when=$lk.c.hd.r when=$lk.c.it when=$lk.c.dir.both if=$lk.c.hd.nokind then=$lk.c.to.back.b
@lk.c.tl.r app.act.request operation="diagram.link.change" tail=?k
@lk.c.tl.c app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.tail value=?k order=4
@lk.lg.change.tail core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.ed if=$lk.c.hd.kind then=$lk.c.tl.c
@lk.c.to.both.f app.act.call act=change thing=$lk.c.dir.fwd attr=direction value=both order=5
@lk.c.to.back.n app.act.call act=change thing=$lk.c.dir.none attr=direction value=back order=5
@lk.lg.change.tail.shows.forward core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.dir.fwd if=$lk.c.hd.kind then=$lk.c.to.both.f
@lk.lg.change.tail.shows.none core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.dir.none if=$lk.c.hd.kind then=$lk.c.to.back.n
@lk.c.to.fwd.b app.act.call act=change thing=$lk.c.dir.both attr=direction value=forward order=5
@lk.c.to.none.b app.act.call act=change thing=$lk.c.dir.back attr=direction value=none order=5
@lk.lg.change.tail.off.both core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.dir.both if=$lk.c.hd.nokind then=$lk.c.to.fwd.b
@lk.lg.change.tail.off.back core.rule when=$lk.c.tl.r when=$lk.c.it when=$lk.c.dir.back if=$lk.c.hd.nokind then=$lk.c.to.none.b
# An arrow direction that shows an end whose kind was none shows it as an arrow again.
@lk.c.ar.r app.act.request operation="diagram.link.change" arrow=?a
@lk.c.ar.head core.check fn=matches args=?a args="^(forward|both)$"
@lk.c.ar.tail core.check fn=matches args=?a args="^(back|both)$"
@lk.c.hn.e w.diagram.edge code=?id diagram.sketch.head=none
@lk.c.tn.e w.diagram.edge code=?id diagram.sketch.tail=none
@lk.c.hn.c app.act.call act=change thing=$lk.c.hn.e attr=diagram.sketch.head value=arrow order=5
@lk.c.tn.c app.act.call act=change thing=$lk.c.tn.e attr=diagram.sketch.tail value=arrow order=5
@lk.lg.arrow.head.back core.rule when=$lk.c.ar.r when=$lk.c.it when=$lk.c.hn.e if=$lk.c.ar.head then=$lk.c.hn.c
@lk.lg.arrow.tail.back core.rule when=$lk.c.ar.r when=$lk.c.it when=$lk.c.tn.e if=$lk.c.ar.tail then=$lk.c.tn.c

# A new link with its sides, marks and route.
@lk.c.mk.made app.act.call act=make kind=w.diagram.edge
@lk.c.mk.fs app.act.request operation="diagram.link.make" fromSide=?v
@lk.c.mk.fs.a app.act.arg call=new.edge attr=diagram.sketch.from_side value=?v
@lk.lg.make.from.side core.rule when=$lk.c.mk.fs when=$lk.c.mk.made then=$lk.c.mk.fs.a
@lk.c.mk.ts app.act.request operation="diagram.link.make" toSide=?v
@lk.c.mk.ts.a app.act.arg call=new.edge attr=diagram.sketch.to_side value=?v
@lk.lg.make.to.side core.rule when=$lk.c.mk.ts when=$lk.c.mk.made then=$lk.c.mk.ts.a
@lk.c.mk.rt app.act.request operation="diagram.link.make" route=?v
@lk.c.mk.rt.a app.act.arg call=new.edge attr=route value=?v
@lk.lg.make.route core.rule when=$lk.c.mk.rt when=$lk.c.mk.made then=$lk.c.mk.rt.a
@lk.c.mk.hd app.act.request operation="diagram.link.make" head=?k
@lk.c.mk.hd.a app.act.arg call=new.edge attr=diagram.sketch.head value=?k
@lk.lg.make.head core.rule when=$lk.c.mk.hd when=$lk.c.mk.made if=$lk.c.hd.kind then=$lk.c.mk.hd.a
@lk.c.mk.tl app.act.request operation="diagram.link.make" tail=?k
@lk.c.mk.tl.a app.act.arg call=new.edge attr=diagram.sketch.tail value=?k
@lk.lg.make.tail core.rule when=$lk.c.mk.tl when=$lk.c.mk.made if=$lk.c.hd.kind then=$lk.c.mk.tl.a
# Without an arrow said: a tail kind shows the tail too (both; back when the head is none); a head of none alone, no mark.
@lk.c.mk.anyarrow app.act.request operation="diagram.link.make" arrow=?anya
@lk.c.mk.hnone app.act.request operation="diagram.link.make" head=none
@lk.c.mk.both app.act.arg call=new.edge attr=direction value=both
@lk.c.mk.back app.act.arg call=new.edge attr=direction value=back
@lk.c.mk.none app.act.arg call=new.edge attr=direction value=none
@lk.lg.make.tail.both core.rule when=$lk.c.mk.tl when=$lk.c.mk.made if=$lk.c.hd.kind not=$lk.c.mk.anyarrow not=$lk.c.mk.hnone then=$lk.c.mk.both
@lk.lg.make.tail.back core.rule when=$lk.c.mk.tl when=$lk.c.mk.made when=$lk.c.mk.hnone if=$lk.c.hd.kind not=$lk.c.mk.anyarrow then=$lk.c.mk.back
@lk.c.mk.anytail app.act.request operation="diagram.link.make" tail=?anyt
@lk.lg.make.head.none core.rule when=$lk.c.mk.hnone when=$lk.c.mk.made not=$lk.c.mk.anyarrow not=$lk.c.mk.anytail then=$lk.c.mk.none

# ---- Which end of each named link a command means ----
@lk.endop.attach ui.diagram.endop operation="diagram.link.attach"
@lk.endop.detach ui.diagram.endop operation="diagram.link.detach"
@lk.p.r app.act.request operation=?op
@lk.p.op ui.diagram.endop operation=?op
@lk.p.e w.diagram.edge code=?id from=$lk.p.na to=$lk.p.nb
@lk.p.na w.diagram.node code=?a
@lk.p.nb w.diagram.node code=?b
@lk.p.from ui.diagram.pick edge=?id end=from
@lk.p.to ui.diagram.pick edge=?id end=to
# The end said by its role: from, start, source or tail; to, end, target or head.
@lk.p.re app.act.request end=?end
@lk.p.isfrom core.check fn=matches args=?end args="^(from|start|source|tail)$"
@lk.p.isto core.check fn=matches args=?end args="^(to|end|target|head)$"
@lk.lg.pick.role.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re if=$lk.p.isfrom then=$lk.p.from
@lk.lg.pick.role.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re if=$lk.p.isto then=$lk.p.to
# The end said by the node it is at now (the target when both ends are at that node).
@lk.p.ra app.act.request at=?n
@lk.p.atfrom core.check fn=eq args=?n args=?a
@lk.p.atto core.check fn=eq args=?n args=?b
@lk.p.notto core.check fn=neq args=?n args=?b
@lk.lg.pick.at.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.ra if=$lk.p.atfrom if=$lk.p.notto then=$lk.p.from
@lk.lg.pick.at.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.ra if=$lk.p.atto then=$lk.p.to
# The end said by where it is drawn: the left, right, upper or lower one (the target on a tie).
@lk.p.th ui.diagram.tip edge=?id at=head x=?hx y=?hy
@lk.p.tt ui.diagram.tip edge=?id at=tail x=?tx y=?ty
@lk.p.isright core.check fn=eq args=?end args=right
@lk.p.isleft core.check fn=eq args=?end args=left
@lk.p.isup core.check fn=matches args=?end args="^(top|upper)$"
@lk.p.isdown core.check fn=matches args=?end args="^(bottom|lower)$"
@lk.p.tgt core.check fn=gt args=?tx args=?hx
@lk.p.tle core.check fn=lte args=?tx args=?hx
@lk.p.tlt core.check fn=lt args=?tx args=?hx
@lk.p.tge core.check fn=gte args=?tx args=?hx
@lk.p.ylt core.check fn=lt args=?ty args=?hy
@lk.p.yge core.check fn=gte args=?ty args=?hy
@lk.p.ygt core.check fn=gt args=?ty args=?hy
@lk.p.yle core.check fn=lte args=?ty args=?hy
@lk.lg.pick.right.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isright if=$lk.p.tgt then=$lk.p.from
@lk.lg.pick.right.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isright if=$lk.p.tle then=$lk.p.to
@lk.lg.pick.left.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isleft if=$lk.p.tlt then=$lk.p.from
@lk.lg.pick.left.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isleft if=$lk.p.tge then=$lk.p.to
@lk.lg.pick.up.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isup if=$lk.p.ylt then=$lk.p.from
@lk.lg.pick.up.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isup if=$lk.p.yge then=$lk.p.to
@lk.lg.pick.down.from core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isdown if=$lk.p.ygt then=$lk.p.from
@lk.lg.pick.down.to core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb when=$lk.p.re when=$lk.p.th when=$lk.p.tt if=$lk.p.isdown if=$lk.p.yle then=$lk.p.to
# Neither said: the target end.
@lk.p.anyend app.act.request end=?anyend
@lk.p.anyat app.act.request at=?anyat
@lk.lg.pick.default core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.p.e when=$lk.p.na when=$lk.p.nb not=$lk.p.anyend not=$lk.p.anyat then=$lk.p.to
# An end that is not one of these, or a node that is at neither end: refused.
@lk.p.picked ui.diagram.pick edge=?id
@lk.p.miss app.act.refuse reason=missing-endpoint
@lk.lg.pick.none core.rule when=$lk.p.r when=$lk.p.op when=$lk.c.it when=$lk.c.ed not=$lk.p.picked then=$lk.p.miss

# ---- Attach an end of each named link to a node, at a side (auto when none is said) ----
@lk.at.r app.act.request operation="diagram.link.attach" node=?n
@lk.at.n w.diagram.node code=?n
@lk.at.from ui.diagram.pick edge=?id end=from
@lk.at.to ui.diagram.pick edge=?id end=to
@lk.at.cf app.act.call act=change thing=$lk.c.ed attr=from value=$lk.at.n order=1
@lk.at.ct app.act.call act=change thing=$lk.c.ed attr=to value=$lk.at.n order=1
@lk.lg.attach.from core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.c.ed when=$lk.at.from then=$lk.at.cf
@lk.lg.attach.to core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.c.ed when=$lk.at.to then=$lk.at.ct
@lk.at.ff w.diagram.edge code=?id diagram.sketch.from_free=true
@lk.at.tf w.diagram.edge code=?id diagram.sketch.to_free=true
@lk.at.cff app.act.call act=change thing=$lk.at.ff attr=diagram.sketch.from_free value=false order=2
@lk.at.ctf app.act.call act=change thing=$lk.at.tf attr=diagram.sketch.to_free value=false order=2
@lk.lg.attach.from.fixed core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.at.ff when=$lk.at.from then=$lk.at.cff
@lk.lg.attach.to.fixed core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.at.tf when=$lk.at.to then=$lk.at.ctf
@lk.at.rs app.act.request operation="diagram.link.attach" side=?s
@lk.at.sf app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=?s order=3
@lk.at.st app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=?s order=3
@lk.lg.attach.from.side core.rule when=$lk.at.r when=$lk.at.n when=$lk.at.rs when=$lk.c.it when=$lk.c.ed when=$lk.at.from then=$lk.at.sf
@lk.lg.attach.to.side core.rule when=$lk.at.r when=$lk.at.n when=$lk.at.rs when=$lk.c.it when=$lk.c.ed when=$lk.at.to then=$lk.at.st
@lk.at.anys app.act.request side=?anys
@lk.at.ofs w.diagram.edge code=?id diagram.sketch.from_side=?old
@lk.at.ots w.diagram.edge code=?id diagram.sketch.to_side=?old
@lk.at.af app.act.call act=change thing=$lk.at.ofs attr=diagram.sketch.from_side value=auto order=3
@lk.at.att app.act.call act=change thing=$lk.at.ots attr=diagram.sketch.to_side value=auto order=3
@lk.lg.attach.from.auto core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.at.ofs when=$lk.at.from not=$lk.at.anys then=$lk.at.af
@lk.lg.attach.to.auto core.rule when=$lk.at.r when=$lk.at.n when=$lk.c.it when=$lk.at.ots when=$lk.at.to not=$lk.at.anys then=$lk.at.att
@lk.at.rn app.act.request operation="diagram.link.attach" node=?n
@lk.at.nn w.diagram.node code=?n
@lk.lg.attach.no.node core.rule when=$lk.at.rn not=$lk.at.nn then=$lk.p.miss

# ---- Detach an end of each named link: it stays where it is drawn, 40 further out, or goes to the point said ----
@lk.dt.r app.act.request operation="diagram.link.detach"
@lk.dt.from ui.diagram.pick edge=?id end=from
@lk.dt.to ui.diagram.pick edge=?id end=to
@lk.dt.xy app.act.request operation="diagram.link.detach" x=?x y=?y
@lk.dt.ff app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_free value=true order=3
@lk.dt.fx app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_x value=?x order=1
@lk.dt.fy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_y value=?y order=2
@lk.dt.tf app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_free value=true order=3
@lk.dt.tx app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_x value=?x order=1
@lk.dt.ty app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_y value=?y order=2
@lk.lg.detach.from.free core.rule when=$lk.dt.r when=$lk.c.it when=$lk.c.ed when=$lk.dt.from then=$lk.dt.ff
@lk.lg.detach.to.free core.rule when=$lk.dt.r when=$lk.c.it when=$lk.c.ed when=$lk.dt.to then=$lk.dt.tf
@lk.lg.detach.from.x core.rule when=$lk.dt.xy when=$lk.c.it when=$lk.c.ed when=$lk.dt.from then=$lk.dt.fx
@lk.lg.detach.from.y core.rule when=$lk.dt.xy when=$lk.c.it when=$lk.c.ed when=$lk.dt.from then=$lk.dt.fy
@lk.lg.detach.to.x core.rule when=$lk.dt.xy when=$lk.c.it when=$lk.c.ed when=$lk.dt.to then=$lk.dt.tx
@lk.lg.detach.to.y core.rule when=$lk.dt.xy when=$lk.c.it when=$lk.c.ed when=$lk.dt.to then=$lk.dt.ty
# No point said: the end's tip moved 40 away from its node's centre (an end that is free already stays).
@lk.dt.anyx app.act.request operation="diagram.link.detach" x=?anyx
@lk.dt.e w.diagram.edge code=?id from=$lk.dt.na to=$lk.dt.nb
@lk.dt.na w.diagram.node code=?a
@lk.dt.nb w.diagram.node code=?b
@lk.dt.isfree.f w.diagram.edge code=?id diagram.sketch.from_free=true
@lk.dt.isfree.t w.diagram.edge code=?id diagram.sketch.to_free=true
@lk.dt.tipf ui.diagram.tip edge=?id at=tail x=?tx y=?ty
@lk.dt.tipt ui.diagram.tip edge=?id at=head x=?tx y=?ty
@lk.dt.bf ui.diagram.nbox node=?a cx=?cx cy=?cy
@lk.dt.bt ui.diagram.nbox node=?b cx=?cx cy=?cy
@lk.dt.dx core.calc out=?dx fn=sub args=?tx args=?cx
@lk.dt.dy core.calc out=?dy fn=sub args=?ty args=?cy
@lk.dt.ax core.calc out=?ax fn=abs args=?dx
@lk.dt.ay core.calc out=?ay fn=abs args=?dy
@lk.dt.bg core.calc out=?bg fn=max args=?ax args=?ay
@lk.dt.sm core.calc out=?sm fn=min args=?ax args=?ay
@lk.dt.l1 core.calc out=?l1 fn=mul args=?bg args=0.96043
@lk.dt.l2 core.calc out=?l2 fn=mul args=?sm args=0.39782
@lk.dt.l3 core.calc out=?l3 fn=add args=?l1 args=?l2
@lk.dt.ln core.calc out=?ln fn=max args=?l3 args=0.001
@lk.dt.k core.calc out=?k fn=div args=40 args=?ln
@lk.dt.ox core.calc out=?ox fn=mul args=?dx args=?k
@lk.dt.oy core.calc out=?oy fn=mul args=?dy args=?k
@lk.dt.x1 core.calc out=?x1 fn=add args=?tx args=?ox
@lk.dt.y1 core.calc out=?y1 fn=add args=?ty args=?oy
@lk.dt.x core.calc out=?x fn=round args=?x1
@lk.dt.y core.calc out=?y fn=round args=?y1
@lk.dt.ofx app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_x value=?x order=1
@lk.dt.ofy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_y value=?y order=2
@lk.dt.otx app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_x value=?x order=1
@lk.dt.oty app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_y value=?y order=2
@lk.lg.detach.from.out.x core.rule when=$lk.dt.r when=$lk.c.it when=$lk.c.ed when=$lk.dt.e when=$lk.dt.na when=$lk.dt.nb when=$lk.dt.from when=$lk.dt.tipf when=$lk.dt.bf not=$lk.dt.anyx not=$lk.dt.isfree.f with=$lk.dt.dx with=$lk.dt.dy with=$lk.dt.ax with=$lk.dt.ay with=$lk.dt.bg with=$lk.dt.sm with=$lk.dt.l1 with=$lk.dt.l2 with=$lk.dt.l3 with=$lk.dt.ln with=$lk.dt.k with=$lk.dt.ox with=$lk.dt.oy with=$lk.dt.x1 with=$lk.dt.y1 with=$lk.dt.x with=$lk.dt.y then=$lk.dt.ofx
@lk.lg.detach.from.out.y core.rule when=$lk.dt.r when=$lk.c.it when=$lk.c.ed when=$lk.dt.e when=$lk.dt.na when=$lk.dt.nb when=$lk.dt.from when=$lk.dt.tipf when=$lk.dt.bf not=$lk.dt.anyx not=$lk.dt.isfree.f with=$lk.dt.dx with=$lk.dt.dy with=$lk.dt.ax with=$lk.dt.ay with=$lk.dt.bg with=$lk.dt.sm with=$lk.dt.l1 with=$lk.dt.l2 with=$lk.dt.l3 with=$lk.dt.ln with=$lk.dt.k with=$lk.dt.ox with=$lk.dt.oy with=$lk.dt.x1 with=$lk.dt.y1 with=$lk.dt.x with=$lk.dt.y then=$lk.dt.ofy
@lk.lg.detach.to.out.x core.rule when=$lk.dt.r when=$lk.c.it when=$lk.c.ed when=$lk.dt.e when=$lk.dt.na when=$lk.dt.nb when=$lk.dt.to when=$lk.dt.tipt when=$lk.dt.bt not=$lk.dt.anyx not=$lk.dt.isfree.t with=$lk.dt.dx with=$lk.dt.dy with=$lk.dt.ax with=$lk.dt.ay with=$lk.dt.bg with=$lk.dt.sm with=$lk.dt.l1 with=$lk.dt.l2 with=$lk.dt.l3 with=$lk.dt.ln with=$lk.dt.k with=$lk.dt.ox with=$lk.dt.oy with=$lk.dt.x1 with=$lk.dt.y1 with=$lk.dt.x with=$lk.dt.y then=$lk.dt.otx
@lk.lg.detach.to.out.y core.rule when=$lk.dt.r when=$lk.c.it when=$lk.c.ed when=$lk.dt.e when=$lk.dt.na when=$lk.dt.nb when=$lk.dt.to when=$lk.dt.tipt when=$lk.dt.bt not=$lk.dt.anyx not=$lk.dt.isfree.t with=$lk.dt.dx with=$lk.dt.dy with=$lk.dt.ax with=$lk.dt.ay with=$lk.dt.bg with=$lk.dt.sm with=$lk.dt.l1 with=$lk.dt.l2 with=$lk.dt.l3 with=$lk.dt.ln with=$lk.dt.k with=$lk.dt.ox with=$lk.dt.oy with=$lk.dt.x1 with=$lk.dt.y1 with=$lk.dt.x with=$lk.dt.y then=$lk.dt.oty

# ---- Bends: add one (after the bend said, 0 = before the first; at the end otherwise), move one, remove one or all ----
@lk.b.r app.act.request operation="diagram.link.bend.add" x=?x y=?y
@lk.b.mk app.act.call act=make kind=diagram.sketch.bend edge=$lk.c.ed seq=?o x=?x y=?y order=1
@lk.b.any ui.diagram.bendat edge=?id
@lk.b.one core.calc out=?o fn=add args=0 args=1
@lk.lg.bend.add.first core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed not=$lk.b.any with=$lk.b.one then=$lk.b.mk
@lk.b.after app.act.request after=?af
@lk.b.cnt ui.diagram.bends edge=?id count=?n
@lk.b.hi ui.diagram.bendhi edge=?id order=?hi
@lk.b.appendable core.check fn=gte args=?af args=?n
@lk.b.next core.calc out=?o fn=add args=?hi args=1
@lk.lg.bend.add.end core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed when=$lk.b.hi not=$lk.b.after with=$lk.b.next then=$lk.b.mk
@lk.lg.bend.add.after.last core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed when=$lk.b.hi when=$lk.b.after when=$lk.b.cnt if=$lk.b.appendable with=$lk.b.next then=$lk.b.mk
@lk.b.lo ui.diagram.bendlo edge=?id order=?lo
@lk.b.isfront core.check fn=lte args=?af args=0
@lk.b.front core.calc out=?o fn=sub args=?lo args=1
@lk.lg.bend.add.front core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed when=$lk.b.lo when=$lk.b.after if=$lk.b.isfront with=$lk.b.front then=$lk.b.mk
@lk.b.ka ui.diagram.bend edge=?id k=?af order=?oa
@lk.b.kb ui.diagram.bend edge=?id k=?kb order=?ob
@lk.b.isnext core.calc out=?k1 fn=add args=?af args=1
@lk.b.nexteq core.check fn=eq args=?kb args=?k1
@lk.b.mid1 core.calc out=?o1 fn=add args=?oa args=?ob
@lk.b.mid core.calc out=?o fn=div args=?o1 args=2
@lk.lg.bend.add.between core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed when=$lk.b.after when=$lk.b.ka when=$lk.b.kb with=$lk.b.isnext if=$lk.b.nexteq with=$lk.b.mid1 with=$lk.b.mid then=$lk.b.mk
@lk.bm.r app.act.request operation="diagram.link.bend.move" bend=?k x=?x y=?y
@lk.bm.k ui.diagram.bend edge=?id k=?k order=?o
@lk.bm.b diagram.sketch.bend edge=$lk.c.ed seq=?o
@lk.bm.cx app.act.call act=change thing=$lk.bm.b attr=x value=?x order=1
@lk.bm.cy app.act.call act=change thing=$lk.bm.b attr=y value=?y order=2
@lk.lg.bend.move.x core.rule when=$lk.bm.r when=$lk.c.it when=$lk.c.ed when=$lk.bm.k when=$lk.bm.b then=$lk.bm.cx
@lk.lg.bend.move.y core.rule when=$lk.bm.r when=$lk.c.it when=$lk.c.ed when=$lk.bm.k when=$lk.bm.b then=$lk.bm.cy
@lk.bm.miss app.act.refuse reason=missing-target
@lk.bm.r2 app.act.request operation="diagram.link.bend.move" bend=?k
@lk.bm.k2 ui.diagram.bend edge=?id k=?k
@lk.lg.bend.move.missing core.rule when=$lk.bm.r2 when=$lk.c.it when=$lk.c.ed not=$lk.bm.k2 then=$lk.bm.miss
@lk.br.r app.act.request operation="diagram.link.bend.remove" bend=?k
@lk.br.rm app.act.call act=remove thing=$lk.bm.b order=1
@lk.lg.bend.remove.one core.rule when=$lk.br.r when=$lk.c.it when=$lk.c.ed when=$lk.bm.k when=$lk.bm.b then=$lk.br.rm
@lk.lg.bend.remove.missing core.rule when=$lk.br.r when=$lk.c.it when=$lk.c.ed not=$lk.bm.k2 then=$lk.bm.miss
@lk.br.all app.act.request operation="diagram.link.bend.remove"
@lk.br.anyk app.act.request bend=?anyk
@lk.br.each diagram.sketch.bend edge=$lk.c.ed
@lk.br.rme app.act.call act=remove thing=$lk.br.each order=1
@lk.lg.bend.remove.all core.rule when=$lk.br.all when=$lk.c.it when=$lk.c.ed when=$lk.br.each not=$lk.br.anyk then=$lk.br.rme

# ---- Reversing a link also swaps its sides, marks and free ends, and passes its bends the other way ----
@lk.rv.r app.act.request operation="diagram.link.reverse"
@lk.rv.side.a.has w.diagram.edge code=?id diagram.sketch.from_side=?v
@lk.rv.side.a.lack w.diagram.edge code=?id diagram.sketch.to_side=?anyv
@lk.rv.side.a.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=?v order=3
@lk.rv.side.a.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=auto order=3
@lk.lg.reverse.side.a core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.side.a.has then=$lk.rv.side.a.copy
@lk.lg.reverse.side.a.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.side.a.has not=$lk.rv.side.a.lack then=$lk.rv.side.a.reset
@lk.rv.side.b.has w.diagram.edge code=?id diagram.sketch.to_side=?v
@lk.rv.side.b.lack w.diagram.edge code=?id diagram.sketch.from_side=?anyv
@lk.rv.side.b.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=?v order=3
@lk.rv.side.b.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=auto order=3
@lk.lg.reverse.side.b core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.side.b.has then=$lk.rv.side.b.copy
@lk.lg.reverse.side.b.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.side.b.has not=$lk.rv.side.b.lack then=$lk.rv.side.b.reset
@lk.rv.mark.a.has w.diagram.edge code=?id diagram.sketch.head=?v
@lk.rv.mark.a.lack w.diagram.edge code=?id diagram.sketch.tail=?anyv
@lk.rv.mark.a.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.tail value=?v order=3
@lk.rv.mark.a.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.head value=arrow order=3
@lk.lg.reverse.mark.a core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.mark.a.has then=$lk.rv.mark.a.copy
@lk.lg.reverse.mark.a.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.mark.a.has not=$lk.rv.mark.a.lack then=$lk.rv.mark.a.reset
@lk.rv.mark.b.has w.diagram.edge code=?id diagram.sketch.tail=?v
@lk.rv.mark.b.lack w.diagram.edge code=?id diagram.sketch.head=?anyv
@lk.rv.mark.b.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.head value=?v order=3
@lk.rv.mark.b.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.tail value=arrow order=3
@lk.lg.reverse.mark.b core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.mark.b.has then=$lk.rv.mark.b.copy
@lk.lg.reverse.mark.b.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.mark.b.has not=$lk.rv.mark.b.lack then=$lk.rv.mark.b.reset
@lk.rv.free.a.has w.diagram.edge code=?id diagram.sketch.from_free=?v
@lk.rv.free.a.lack w.diagram.edge code=?id diagram.sketch.to_free=?anyv
@lk.rv.free.a.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_free value=?v order=3
@lk.rv.free.a.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_free value=false order=3
@lk.lg.reverse.free.a core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.free.a.has then=$lk.rv.free.a.copy
@lk.lg.reverse.free.a.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.free.a.has not=$lk.rv.free.a.lack then=$lk.rv.free.a.reset
@lk.rv.free.b.has w.diagram.edge code=?id diagram.sketch.to_free=?v
@lk.rv.free.b.lack w.diagram.edge code=?id diagram.sketch.from_free=?anyv
@lk.rv.free.b.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_free value=?v order=3
@lk.rv.free.b.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_free value=false order=3
@lk.lg.reverse.free.b core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.free.b.has then=$lk.rv.free.b.copy
@lk.lg.reverse.free.b.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.free.b.has not=$lk.rv.free.b.lack then=$lk.rv.free.b.reset
@lk.rv.from_x.has w.diagram.edge code=?id diagram.sketch.from_x=?v
@lk.rv.from_x.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_x value=?v order=3
@lk.lg.reverse.from_x core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.from_x.has then=$lk.rv.from_x.copy
@lk.rv.to_x.has w.diagram.edge code=?id diagram.sketch.to_x=?v
@lk.rv.to_x.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_x value=?v order=3
@lk.lg.reverse.to_x core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.to_x.has then=$lk.rv.to_x.copy
@lk.rv.from_y.has w.diagram.edge code=?id diagram.sketch.from_y=?v
@lk.rv.from_y.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_y value=?v order=3
@lk.lg.reverse.from_y core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.from_y.has then=$lk.rv.from_y.copy
@lk.rv.to_y.has w.diagram.edge code=?id diagram.sketch.to_y=?v
@lk.rv.to_y.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_y value=?v order=3
@lk.lg.reverse.to_y core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.to_y.has then=$lk.rv.to_y.copy
@lk.rv.bend diagram.sketch.bend edge=$lk.c.ed seq=?o
@lk.rv.neg core.calc out=?no fn=sub args=0 args=?o
@lk.rv.bc app.act.call act=change thing=$lk.rv.bend attr=seq value=?no order=3
@lk.lg.reverse.bends core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.bend with=$lk.rv.neg then=$lk.rv.bc

# ---- What a reader observes of a link's geometry ----
@lk.o.fs w.diagram.edge code=?id diagram.sketch.from_side=?v
@lk.o.fs.o app.observe.input id=?id key=fromSide value=?v
@lk.observe.link.from.side core.rule when=$lk.o.fs then=$lk.o.fs.o
@lk.o.ts w.diagram.edge code=?id diagram.sketch.to_side=?v
@lk.o.ts.o app.observe.input id=?id key=toSide value=?v
@lk.observe.link.to.side core.rule when=$lk.o.ts then=$lk.o.ts.o
@lk.o.hd w.diagram.edge code=?id diagram.sketch.head=?v
@lk.o.hd.o app.observe.input id=?id key=head value=?v
@lk.observe.link.head core.rule when=$lk.o.hd then=$lk.o.hd.o
@lk.o.tl w.diagram.edge code=?id diagram.sketch.tail=?v
@lk.o.tl.o app.observe.input id=?id key=tail value=?v
@lk.observe.link.tail core.rule when=$lk.o.tl then=$lk.o.tl.o
@lk.o.la w.diagram.edge code=?id diagram.sketch.label_at=?v
@lk.o.la.o app.observe.input id=?id key=labelPosition value=?v
@lk.observe.link.label.position core.rule when=$lk.o.la then=$lk.o.la.o
@lk.o.ff w.diagram.edge code=?id diagram.sketch.from_free=true diagram.sketch.from_x=?x diagram.sketch.from_y=?y
@lk.o.ff.o app.observe.input id=?id key=fromFree value=true
@lk.o.ffx app.observe.input id=?id key=fromX value=?x
@lk.o.ffy app.observe.input id=?id key=fromY value=?y
@lk.observe.link.from.free core.rule when=$lk.o.ff then=$lk.o.ff.o
@lk.observe.link.from.x core.rule when=$lk.o.ff then=$lk.o.ffx
@lk.observe.link.from.y core.rule when=$lk.o.ff then=$lk.o.ffy
@lk.o.tf w.diagram.edge code=?id diagram.sketch.to_free=true diagram.sketch.to_x=?x diagram.sketch.to_y=?y
@lk.o.tf.o app.observe.input id=?id key=toFree value=true
@lk.o.tfx app.observe.input id=?id key=toX value=?x
@lk.o.tfy app.observe.input id=?id key=toY value=?y
@lk.observe.link.to.free core.rule when=$lk.o.tf then=$lk.o.tf.o
@lk.observe.link.to.x core.rule when=$lk.o.tf then=$lk.o.tfx
@lk.observe.link.to.y core.rule when=$lk.o.tf then=$lk.o.tfy
# Each bend as "k x y" (k from 1, in order along the link).
@lk.o.bd ui.diagram.bend edge=?id k=?k x=?x y=?y
@lk.o.bd.v core.calc out=?v fn=concat args=?k args=" " args=?x args=" " args=?y
@lk.o.bd.o app.observe.input id=?id key=bends value=?v
@lk.observe.link.bends core.rule when=$lk.o.bd with=$lk.o.bd.v then=$lk.o.bd.o
@lk.o.mw ui.diagram.mway edge=?id way=?v
@lk.o.mw.o app.observe.input id=?id key=way value=?v
@lk.observe.link.manual.way core.rule when=$lk.o.mw then=$lk.o.mw.o
