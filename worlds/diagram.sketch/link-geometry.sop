@lk.go.ady core.calc out=?ady fn=abs args=?dy
@lk.go.across core.check fn=gte args=?adx args=?ady
@lk.go.down core.check fn=lt args=?adx args=?ady
@lk.go.px core.check fn=gte args=?dx args=0
@lk.go.nx core.check fn=lt args=?dx args=0
@lk.go.py core.check fn=gte args=?dy args=0
@lk.go.ny core.check fn=lt args=?dy args=0
@lk.go.fr ui.diagram.oface edge=?e at=?at side=right
@lk.go.fl ui.diagram.oface edge=?e at=?at side=left
@lk.go.fb ui.diagram.oface edge=?e at=?at side=bottom
@lk.go.ft ui.diagram.oface edge=?e at=?at side=top
@lk.lg.oface.right core.rule when=$lk.go.w when=$lk.go.au when=$lk.go.ai with=$lk.go.dx with=$lk.go.dy with=$lk.go.adx with=$lk.go.ady if=$lk.go.across if=$lk.go.px then=$lk.go.fr
@lk.lg.oface.left core.rule when=$lk.go.w when=$lk.go.au when=$lk.go.ai with=$lk.go.dx with=$lk.go.dy with=$lk.go.adx with=$lk.go.ady if=$lk.go.across if=$lk.go.nx then=$lk.go.fl
@lk.lg.oface.bottom core.rule when=$lk.go.w when=$lk.go.au when=$lk.go.ai with=$lk.go.dx with=$lk.go.dy with=$lk.go.adx with=$lk.go.ady if=$lk.go.down if=$lk.go.py then=$lk.go.fb
@lk.lg.oface.top core.rule when=$lk.go.w when=$lk.go.au when=$lk.go.ai with=$lk.go.dx with=$lk.go.dy with=$lk.go.adx with=$lk.go.ady if=$lk.go.down if=$lk.go.ny then=$lk.go.ft
@lk.go.f ui.diagram.oface edge=?e at=?at side=?s
@lk.go.mn ui.diagram.mnode edge=?e at=?at node=?n
@lk.go.p ui.diagram.port node=?n side=?s x=?x y=?y
@lk.lg.oend.auto core.rule when=$lk.go.f when=$lk.go.mn when=$lk.go.p then=$lk.go.oe
# Links between the same two nodes leave and enter their sides 14 apart per place (along the side).
@lk.go.t1 ui.diagram.stan side=top tx=1 ty=0
@lk.go.t2 ui.diagram.stan side=bottom tx=1 ty=0
@lk.go.t3 ui.diagram.stan side=left tx=0 ty=1
@lk.go.t4 ui.diagram.stan side=right tx=0 ty=1
