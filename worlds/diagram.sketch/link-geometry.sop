@lk.lg.ortho.leg.head.sideways core.rule when=$lk.gy.f when=$lk.gy.last not=$lk.gy.sdb with=$lk.gy.i1 if=$lk.gy.islast with=$lk.gy.dx with=$lk.gy.dy with=$lk.gy.ex with=$lk.gy.ey if=$lk.gy.sideways with=$lk.gy.hs then=$lk.gy.hs.o
@lk.gy.lside core.check fn=matches args=?pat args="^(hv|hvh)$"
