@lk.rk.c ui.diagram.ocand edge=?e i=?i pat=?pat c=?c
@lk.rk.any ui.diagram.ocross edge=?e i=?i pat=?pat c=?c
@lk.rk.zo ui.diagram.ocrossn edge=?e i=?i pat=?pat c=?c n=0
@lk.lg.ocrossn.zero core.rule when=$lk.rk.c not=$lk.rk.any then=$lk.rk.zo
@lk.rp.c ui.diagram.ocand edge=?e i=?i pat=?pat c=?c
@lk.rp.q ui.diagram.oq edge=?e i=?i oa=?oa ob=?ob anx=?anx any=?any bnx=?bnx bny=?bny
@lk.rp.ax ui.diagram.patax pat=?pat first=?f last=?l
@lk.rp.r1 ui.diagram.orun edge=?e i=?i pat=?pat c=?c s=1 p=?p1 q=?q1
@lk.rp.rl ui.diagram.orun edge=?e i=?i pat=?pat c=?c s=?sl p=?pl q=?ql
@lk.rp.tn ui.diagram.patax pat=?pat turns=?tn
@lk.rp.islast core.calc out=?sl1 fn=add args=?tn args=1
@lk.rp.lasts core.check fn=eq args=?sl args=?sl1
@lk.rp.afix core.check fn=neq args=?oa args=free
@lk.rp.bfix core.check fn=neq args=?ob args=free
@lk.rp.amis core.check fn=neq args=?oa args=?f
@lk.rp.bmis core.check fn=neq args=?ob args=?l
@lk.rp.pa ui.diagram.openal edge=?e i=?i pat=?pat c=?c why=start-axis
@lk.rp.pb ui.diagram.openal edge=?e i=?i pat=?pat c=?c why=end-axis
@lk.lg.openal.start.axis core.rule when=$lk.rp.c when=$lk.rp.q when=$lk.rp.ax if=$lk.rp.afix if=$lk.rp.amis then=$lk.rp.pa
@lk.lg.openal.end.axis core.rule when=$lk.rp.c when=$lk.rp.q when=$lk.rp.ax if=$lk.rp.bfix if=$lk.rp.bmis then=$lk.rp.pb
@lk.rp.d1 core.calc out=?d1 fn=sub args=?q1 args=?p1
@lk.rp.dl core.calc out=?dl fn=sub args=?ql args=?pl
@lk.rp.fh core.check fn=eq args=?f args=h
@lk.rp.fv core.check fn=eq args=?f args=v
@lk.rp.lh core.check fn=eq args=?l args=h
@lk.rp.lv core.check fn=eq args=?l args=v
@lk.rp.bah core.calc out=?ba fn=mul args=?d1 args=?anx
@lk.rp.bav core.calc out=?ba fn=mul args=?d1 args=?any
@lk.rp.bbh core.calc out=?bb fn=mul args=?dl args=?bnx
@lk.rp.bbv core.calc out=?bb fn=mul args=?dl args=?bny
@lk.rp.aback core.check fn=lt args=?ba args=0
@lk.rp.bback core.check fn=gt args=?bb args=0
@lk.rp.pab ui.diagram.openal edge=?e i=?i pat=?pat c=?c why=start-back
@lk.rp.pbb ui.diagram.openal edge=?e i=?i pat=?pat c=?c why=end-back
@lk.lg.openal.start.back.h core.rule when=$lk.rp.c when=$lk.rp.q when=$lk.rp.ax when=$lk.rp.r1 if=$lk.rp.fh with=$lk.rp.d1 with=$lk.rp.bah if=$lk.rp.aback then=$lk.rp.pab
@lk.lg.openal.start.back.v core.rule when=$lk.rp.c when=$lk.rp.q when=$lk.rp.ax when=$lk.rp.r1 if=$lk.rp.fv with=$lk.rp.d1 with=$lk.rp.bav if=$lk.rp.aback then=$lk.rp.pab
@lk.lg.openal.end.back.h core.rule when=$lk.rp.c when=$lk.rp.q when=$lk.rp.ax when=$lk.rp.tn when=$lk.rp.rl with=$lk.rp.islast if=$lk.rp.lasts if=$lk.rp.lh with=$lk.rp.dl with=$lk.rp.bbh if=$lk.rp.bback then=$lk.rp.pbb
@lk.lg.openal.end.back.v core.rule when=$lk.rp.c when=$lk.rp.q when=$lk.rp.ax when=$lk.rp.tn when=$lk.rp.rl with=$lk.rp.islast if=$lk.rp.lasts if=$lk.rp.lv with=$lk.rp.dl with=$lk.rp.bbv if=$lk.rp.bback then=$lk.rp.pbb
@lk.rp.x ui.diagram.openal edge=?e i=?i pat=?pat c=?c why=?w
@lk.rp.xo ui.diagram.openaln edge=?e i=?i pat=?pat c=?c n=?k
@lk.lg.openaln core.aggregate over=$lk.rp.x by=?e by=?i by=?pat by=?c count=?k then=$lk.rp.xo
@lk.rp.any ui.diagram.openal edge=?e i=?i pat=?pat c=?c
@lk.rp.zo ui.diagram.openaln edge=?e i=?i pat=?pat c=?c n=0
@lk.lg.openaln.zero core.rule when=$lk.rp.c not=$lk.rp.any then=$lk.rp.zo
# The length of each candidate and its cost; the least costly one (the first made on a tie) is the piece's way.
@lk.rl.d core.calc out=?d0 fn=sub args=?q args=?p
@lk.rl.a core.calc out=?d fn=abs args=?d0
@lk.rl.o ui.diagram.orunlen edge=?e i=?i pat=?pat c=?c s=?s len=?d
@lk.rl.rs ui.diagram.orun edge=?e i=?i pat=?pat c=?c s=?s p=?p q=?q
@lk.lg.orunlen core.rule when=$lk.rl.rs with=$lk.rl.d with=$lk.rl.a then=$lk.rl.o
@lk.rl.x ui.diagram.orunlen edge=?e i=?i pat=?pat c=?c len=?d
@lk.rl.xo ui.diagram.olen edge=?e i=?i pat=?pat c=?c len=?l
@lk.lg.olen core.aggregate over=$lk.rl.x by=?e by=?i by=?pat by=?c sum=?l args=?d then=$lk.rl.xo
@lk.rc.c ui.diagram.ocand edge=?e i=?i pat=?pat c=?c
@lk.rc.x ui.diagram.ocrossn edge=?e i=?i pat=?pat c=?c n=?nx
@lk.rc.p ui.diagram.openaln edge=?e i=?i pat=?pat c=?c n=?np
@lk.rc.l ui.diagram.olen edge=?e i=?i pat=?pat c=?c len=?l
@lk.rc.t ui.diagram.patax pat=?pat turns=?tn
@lk.rc.v1 core.calc out=?v1 fn=mul args=?nx args=10000
@lk.rc.v2 core.calc out=?v2 fn=mul args=?np args=400
@lk.rc.v3 core.calc out=?v3 fn=mul args=?tn args=20
@lk.rc.cost core.calc out=?cost fn=add args=?v1 args=?v2 args=?v3 args=?l
@lk.rc.key core.calc out=?key fn=concat args=?pat args="@" args=?c
@lk.rc.o ui.diagram.ocost edge=?e i=?i key=?key pat=?pat c=?c cost=?cost
@lk.lg.ocost core.rule when=$lk.rc.c when=$lk.rc.x when=$lk.rc.p when=$lk.rc.l when=$lk.rc.t with=$lk.rc.v1 with=$lk.rc.v2 with=$lk.rc.v3 with=$lk.rc.cost with=$lk.rc.key then=$lk.rc.o
@lk.rb.c ui.diagram.ocost edge=?e i=?i key=?key cost=?cost
@lk.rb.o ui.diagram.obest edge=?e i=?i key=?best
@lk.lg.obest core.aggregate over=$lk.rb.c by=?e by=?i argmin=?best args=?cost pick=?key ties=first then=$lk.rb.o
@lk.rb.b ui.diagram.obest edge=?e i=?i key=?key
@lk.rb.k ui.diagram.ocost edge=?e i=?i key=?key pat=?pat c=?c
@lk.rb.q ui.diagram.oq edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by
@lk.rb.fit ui.diagram.ofit edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by pat=?pat c=?c
@lk.lg.ofit core.rule when=$lk.rb.b when=$lk.rb.k when=$lk.rb.q then=$lk.rb.fit
# The points: each vertex (100 i), the stubs (100 i + 10, 100 i + 90) and the turns between (100 i + 30, + 60).
@lk.gx.v ui.diagram.mv edge=?e i=?i x=?x y=?y
@lk.gx.n core.calc out=?n fn=mul args=?i args=100
