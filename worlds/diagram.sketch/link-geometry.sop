@lk.lg.ortho.leg.head.across core.rule when=$lk.gy.f when=$lk.gy.last not=$lk.gy.sdb with=$lk.gy.i1 if=$lk.gy.islast with=$lk.gy.dx with=$lk.gy.dy with=$lk.gy.ex with=$lk.gy.ey if=$lk.gy.across with=$lk.gy.ha then=$lk.gy.ha.o
@lk.gy.hs core.calc out=?hx fn=add args=?dx args=?ex
