@lk.cn.v1 core.calc out=?v1 fn=mul args=?n args=1000
@lk.cn.cost core.calc out=?cost fn=add args=?v1 args=?w
@lk.cn.co ui.diagram.bowcost edge=?e f=?f cost=?cost
@lk.lg.bowcost core.rule when=$lk.cn.cc when=$lk.cn.nn with=$lk.cn.v1 with=$lk.cn.cost then=$lk.cn.co
