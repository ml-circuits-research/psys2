@lk.cb.fo core.calc out=?fo fn=mul args=?off args=0.35
@lk.cb.fe core.calc out=?fe fn=add args=?f args=?fo
@lk.cb.dx core.calc out=?dx fn=sub args=?qx args=?px
@lk.cb.dy core.calc out=?dy fn=sub args=?qy args=?py
@lk.cb.mx1 core.calc out=?mx1 fn=add args=?px args=?qx
@lk.cb.my1 core.calc out=?my1 fn=add args=?py args=?qy
@lk.cb.mx core.calc out=?mx fn=div args=?mx1 args=2
@lk.cb.my core.calc out=?my fn=div args=?my1 args=2
@lk.cb.ox core.calc out=?ox fn=mul args=?dy args=?fe
@lk.cb.oy0 core.calc out=?oy0 fn=mul args=?dx args=?fe
@lk.cb.oy core.calc out=?oy fn=mul args=?oy0 args=-1
@lk.cb.cx core.calc out=?cx fn=add args=?mx args=?ox
@lk.cb.cy core.calc out=?cy fn=add args=?my args=?oy
