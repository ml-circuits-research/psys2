@lk.gy.ta1 core.calc out=?tay0 fn=add args=?dy args=?ey
@lk.gy.ta2 core.calc out=?tay fn=mul args=?tay0 args=-1
@lk.gy.ta3 core.calc out=?tax fn=mul args=?ex args=-1
@lk.gy.ta.o ui.diagram.leg edge=?e at=tail x=?ax y=?ay dx=?tax dy=?tay
@lk.lg.ortho.leg.tail.across core.rule when=$lk.gy.f not=$lk.gy.sda if=$lk.gy.first with=$lk.gy.dx with=$lk.gy.dy with=$lk.gy.ex with=$lk.gy.ey if=$lk.gy.lacross with=$lk.gy.ta1 with=$lk.gy.ta2 with=$lk.gy.ta3 then=$lk.gy.ta.o

# ---- Curved: quadratic pieces, one per control point ----
# The control points: the bends; with none, one bowed to the side (below).
@lk.gk.m ui.diagram.mway edge=?e way=curved
@lk.gk.bd ui.diagram.bend edge=?e k=?k x=?x y=?y
@lk.gk.co ui.diagram.ctl edge=?e j=?k x=?x y=?y
@lk.lg.ctl.bend core.rule when=$lk.gk.m when=$lk.gk.bd then=$lk.gk.co
# Without a bend, a curve bows to one side by a share f of its length: the candidate whose eight points fall inside
# the fewest other nodes (1000 each), the smaller bow first (0.2 left, 0.2 right, 0.4, 0.65, 0.9; within 8 of a box counts as inside); links between the same
# two nodes bow 0.35 further apart per place.
@lk.cb.f1 ui.diagram.bowf f=0.2 w=0
@lk.cb.f2 ui.diagram.bowf f=-0.2 w=1
@lk.cb.f3 ui.diagram.bowf f=0.4 w=2
@lk.cb.f4 ui.diagram.bowf f=-0.4 w=3
@lk.cb.f5 ui.diagram.bowf f=0.65 w=4
@lk.cb.f6 ui.diagram.bowf f=-0.65 w=5
@lk.cb.f7 ui.diagram.bowf f=0.9 w=6
@lk.cb.f8 ui.diagram.bowf f=-0.9 w=7
@lk.cb.m ui.diagram.mway edge=?e way=curved
@lk.cb.any ui.diagram.bendat edge=?e
