@lk.gy.ts1 core.calc out=?tsx0 fn=add args=?dx args=?ex
@lk.gy.ts2 core.calc out=?tsx fn=mul args=?tsx0 args=-1
@lk.gy.ts3 core.calc out=?tsy fn=mul args=?ey args=-1
@lk.gy.ts.o ui.diagram.leg edge=?e at=tail x=?ax y=?ay dx=?tsx dy=?tsy
