@lk.gd.y core.calc out=?ly fn=add args=?y args=14
@lk.gd.out ui.diagram.draw part=?e source=?src slot=?e order=4 z=1 shape=text text=?text x=?lx y=?ly w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left font=12
@lk.gd.ink ui.diagram.pagecol key=label rgb=?lc
@lk.gd.fill ui.diagram.fill source=?src part=?e fill=?lc
@lk.lg.draw.label.at core.rule when=$lk.gd.e when=$lk.gd.p with=$lk.gd.s with=$lk.gd.x with=$lk.gd.y then=$lk.gd.out
