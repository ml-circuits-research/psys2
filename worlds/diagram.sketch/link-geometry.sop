@lk.lg.ctln core.rule when=$lk.gk.cv with=$lk.gk.cp then=$lk.gk.cvn
@lk.gk.cnx core.calc out=?nx fn=add args=?j args=1
@lk.gk.cvp ui.diagram.ctlp edge=?e next=?nx x=?x y=?y
@lk.lg.ctlp core.rule when=$lk.gk.cv with=$lk.gk.cnx then=$lk.gk.cvp
# Piece j runs from the source end (j = 1) or the middle between control j - 1 and j, to the target end (j = the last)
# or the middle between control j and j + 1, bowed by control j.
@lk.gz.c ui.diagram.ctl edge=?e j=?j x=?kx y=?ky
@lk.gz.n ui.diagram.ctlcount edge=?e count=?n
@lk.gz.a ui.diagram.mend edge=?e at=a x=?px y=?py
@lk.gz.b ui.diagram.mend edge=?e at=b x=?qx y=?qy
