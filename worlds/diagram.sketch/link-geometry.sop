@lk.gz.o3 ui.diagram.piece edge=?e j=?j ax=?sx ay=?sy kx=?kx ky=?ky bx=?qx by=?qy
@lk.lg.piece.last core.rule when=$lk.gz.c when=$lk.gz.n when=$lk.gz.b when=$lk.gz.before if=$lk.gz.notfirst if=$lk.gz.last with=$lk.gz.sx1 with=$lk.gz.sy1 with=$lk.gz.sx with=$lk.gz.sy then=$lk.gz.o3
