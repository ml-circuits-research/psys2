@lk.lg.bowhit core.rule when=$lk.cs.c when=$lk.cs.z when=$lk.cs.nb not=$lk.cs.own with=$lk.cs.x1 with=$lk.cs.x2 with=$lk.cs.x3 with=$lk.cs.x with=$lk.cs.y1 with=$lk.cs.y2 with=$lk.cs.y3 with=$lk.cs.y with=$lk.cs.ix0 with=$lk.cs.ix1 with=$lk.cs.iy0 with=$lk.cs.iy1 if=$lk.cs.inx if=$lk.cs.iny then=$lk.cs.o
@lk.cn.h ui.diagram.bowhit edge=?e f=?f k=?k
@lk.cn.ho ui.diagram.bown edge=?e f=?f n=?n
