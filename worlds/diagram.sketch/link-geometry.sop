@lk.lg.curve.samples core.rule when=$lk.gu.p when=$lk.gu.b with=$lk.gu.x1 with=$lk.gu.x2 with=$lk.gu.x3 with=$lk.gu.x with=$lk.gu.y1 with=$lk.gu.y2 with=$lk.gu.y3 with=$lk.gu.y with=$lk.gu.j with=$lk.gu.n then=$lk.gu.pt
