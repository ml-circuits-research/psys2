@lk.lg.point.from.y core.rule when=$lk.dp.mf when=$lk.dp.xy then=$lk.dp.fy
@lk.lg.point.to.x core.rule when=$lk.dp.mt when=$lk.dp.xy then=$lk.dp.tx
@lk.lg.point.to.y core.rule when=$lk.dp.mt when=$lk.dp.xy then=$lk.dp.ty
@lk.dp.anyx app.act.request operation="diagram.link.detach" x=?anyx
@lk.dp.fe w.diagram.edge code=?id from=$lk.dp.na
@lk.dp.te w.diagram.edge code=?id to=$lk.dp.na
@lk.dp.na w.diagram.node code=?a
@lk.dp.tipf ui.diagram.tip edge=?id at=tail x=?tx y=?ty
@lk.dp.tipt ui.diagram.tip edge=?id at=head x=?tx y=?ty
@lk.dp.bx ui.diagram.nbox node=?a cx=?cx cy=?cy
@lk.dp.dx core.calc out=?dx fn=sub args=?tx args=?cx
@lk.dp.dy core.calc out=?dy fn=sub args=?ty args=?cy
@lk.dp.ax core.calc out=?ax fn=abs args=?dx
@lk.dp.ay core.calc out=?ay fn=abs args=?dy
@lk.dp.bg core.calc out=?bg fn=max args=?ax args=?ay
@lk.dp.sm core.calc out=?sm fn=min args=?ax args=?ay
@lk.dp.l1 core.calc out=?l1 fn=mul args=?bg args=0.96043
@lk.dp.l2 core.calc out=?l2 fn=mul args=?sm args=0.39782
@lk.dp.l3 core.calc out=?l3 fn=add args=?l1 args=?l2
@lk.dp.ln core.calc out=?ln fn=max args=?l3 args=0.001
@lk.dp.k core.calc out=?k fn=div args=40 args=?ln
@lk.dp.ox core.calc out=?ox fn=mul args=?dx args=?k
@lk.dp.oy core.calc out=?oy fn=mul args=?dy args=?k
@lk.dp.x1 core.calc out=?x1 fn=add args=?tx args=?ox
@lk.dp.y1 core.calc out=?y1 fn=add args=?ty args=?oy
@lk.dp.x core.calc out=?x fn=round args=?x1
@lk.dp.y core.calc out=?y fn=round args=?y1
@lk.lg.point.from.out.x core.rule when=$lk.dp.mf when=$lk.dp.fe when=$lk.dp.na when=$lk.dp.tipf when=$lk.dp.bx not=$lk.dp.anyx with=$lk.dp.dx with=$lk.dp.dy with=$lk.dp.ax with=$lk.dp.ay with=$lk.dp.bg with=$lk.dp.sm with=$lk.dp.l1 with=$lk.dp.l2 with=$lk.dp.l3 with=$lk.dp.ln with=$lk.dp.k with=$lk.dp.ox with=$lk.dp.oy with=$lk.dp.x1 with=$lk.dp.y1 with=$lk.dp.x with=$lk.dp.y then=$lk.dp.fx
@lk.lg.point.from.out.y core.rule when=$lk.dp.mf when=$lk.dp.fe when=$lk.dp.na when=$lk.dp.tipf when=$lk.dp.bx not=$lk.dp.anyx with=$lk.dp.dx with=$lk.dp.dy with=$lk.dp.ax with=$lk.dp.ay with=$lk.dp.bg with=$lk.dp.sm with=$lk.dp.l1 with=$lk.dp.l2 with=$lk.dp.l3 with=$lk.dp.ln with=$lk.dp.k with=$lk.dp.ox with=$lk.dp.oy with=$lk.dp.x1 with=$lk.dp.y1 with=$lk.dp.x with=$lk.dp.y then=$lk.dp.fy
@lk.lg.point.to.out.x core.rule when=$lk.dp.mt when=$lk.dp.te when=$lk.dp.na when=$lk.dp.tipt when=$lk.dp.bx not=$lk.dp.anyx with=$lk.dp.dx with=$lk.dp.dy with=$lk.dp.ax with=$lk.dp.ay with=$lk.dp.bg with=$lk.dp.sm with=$lk.dp.l1 with=$lk.dp.l2 with=$lk.dp.l3 with=$lk.dp.ln with=$lk.dp.k with=$lk.dp.ox with=$lk.dp.oy with=$lk.dp.x1 with=$lk.dp.y1 with=$lk.dp.x with=$lk.dp.y then=$lk.dp.tx
@lk.lg.point.to.out.y core.rule when=$lk.dp.mt when=$lk.dp.te when=$lk.dp.na when=$lk.dp.tipt when=$lk.dp.bx not=$lk.dp.anyx with=$lk.dp.dx with=$lk.dp.dy with=$lk.dp.ax with=$lk.dp.ay with=$lk.dp.bg with=$lk.dp.sm with=$lk.dp.l1 with=$lk.dp.l2 with=$lk.dp.l3 with=$lk.dp.ln with=$lk.dp.k with=$lk.dp.ox with=$lk.dp.oy with=$lk.dp.x1 with=$lk.dp.y1 with=$lk.dp.x with=$lk.dp.y then=$lk.dp.ty

# ---- Named ports: the sides a node's shape names (link-ports.sop), as a link's end is attached by its port ----
@lk.np.n w.diagram.node code=?c shape=?s
@lk.np.t ui.diagram.portname shape=?s name=?nm side=?sd
@lk.np.ta ui.diagram.portname shape=any name=?nm side=?sd
@lk.np.o ui.diagram.nport node=?c name=?nm side=?sd
@lk.np.own ui.diagram.portname shape=?s name=?nm
@lk.lg.nport.shape core.rule when=$lk.np.n when=$lk.np.t then=$lk.np.o
@lk.lg.nport.any core.rule when=$lk.np.n when=$lk.np.ta not=$lk.np.own then=$lk.np.o
@lk.np.ob ui.diagram.nport node=?c name=?nm side=?sd
@lk.np.ov core.calc out=?v fn=concat args=?nm args=":" args=?sd
@lk.np.oo app.observe.input id=?c key=ports value=?v
@lk.observe.node.ports core.rule when=$lk.np.ob with=$lk.np.ov then=$lk.np.oo
# attach port=...: the side the end's new node names so (and the port's name); a name it does not have is refused.
@lk.pa.r app.act.request operation="diagram.link.attach" node=?n port=?nm
@lk.pa.p ui.diagram.nport node=?n name=?nm side=?sd
@lk.pa.from ui.diagram.pick edge=?id end=from
@lk.pa.to ui.diagram.pick edge=?id end=to
@lk.pa.sf app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=?sd order=3
@lk.pa.st app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=?sd order=3
@lk.pa.nf app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_port value=?nm order=4
@lk.pa.nt app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_port value=?nm order=4
@lk.lg.attach.port.from.side core.rule when=$lk.pa.r when=$lk.pa.p when=$lk.c.it when=$lk.c.ed when=$lk.pa.from then=$lk.pa.sf
@lk.lg.attach.port.to.side core.rule when=$lk.pa.r when=$lk.pa.p when=$lk.c.it when=$lk.c.ed when=$lk.pa.to then=$lk.pa.st
@lk.lg.attach.port.from.name core.rule when=$lk.pa.r when=$lk.pa.p when=$lk.c.it when=$lk.c.ed when=$lk.pa.from then=$lk.pa.nf
@lk.lg.attach.port.to.name core.rule when=$lk.pa.r when=$lk.pa.p when=$lk.c.it when=$lk.c.ed when=$lk.pa.to then=$lk.pa.nt
@lk.pa.np app.act.refuse reason=no-such-port
@lk.pa.pn ui.diagram.nport node=?n name=?nm
@lk.lg.attach.port.missing core.rule when=$lk.pa.r not=$lk.pa.pn then=$lk.pa.np
# change fromPort / toPort: by the name the node at that end gives its side.
@lk.pc.rf app.act.request operation="diagram.link.change" fromPort=?nm
@lk.pc.rt app.act.request operation="diagram.link.change" toPort=?nm
@lk.pc.ef w.diagram.edge code=?id from=$lk.pc.na
@lk.pc.et w.diagram.edge code=?id to=$lk.pc.na
@lk.pc.na w.diagram.node code=?a
@lk.pc.p ui.diagram.nport node=?a name=?nm side=?sd
@lk.lg.change.port.from.side core.rule when=$lk.pc.rf when=$lk.c.it when=$lk.c.ed when=$lk.pc.ef when=$lk.pc.na when=$lk.pc.p then=$lk.pa.sf
@lk.lg.change.port.from.name core.rule when=$lk.pc.rf when=$lk.c.it when=$lk.c.ed when=$lk.pc.ef when=$lk.pc.na when=$lk.pc.p then=$lk.pa.nf
@lk.lg.change.port.to.side core.rule when=$lk.pc.rt when=$lk.c.it when=$lk.c.ed when=$lk.pc.et when=$lk.pc.na when=$lk.pc.p then=$lk.pa.st
@lk.lg.change.port.to.name core.rule when=$lk.pc.rt when=$lk.c.it when=$lk.c.ed when=$lk.pc.et when=$lk.pc.na when=$lk.pc.p then=$lk.pa.nt
@lk.pc.pn ui.diagram.nport node=?a name=?nm
@lk.lg.change.port.from.missing core.rule when=$lk.pc.rf when=$lk.c.it when=$lk.pc.ef when=$lk.pc.na not=$lk.pc.pn then=$lk.pa.np
@lk.lg.change.port.to.missing core.rule when=$lk.pc.rt when=$lk.c.it when=$lk.pc.et when=$lk.pc.na not=$lk.pc.pn then=$lk.pa.np
@lk.pc.g1 ui.diagram.lcgiven value=yes
@lk.lg.given.port.from core.rule when=$lk.pc.rf then=$lk.pc.g1
@lk.lg.given.port.to core.rule when=$lk.pc.rt then=$lk.pc.g1
# make fromPort / toPort.
@lk.pm.made app.act.call act=make kind=w.diagram.edge
@lk.pm.rf app.act.request operation="diagram.link.make" from=?a fromPort=?nm
@lk.pm.rt app.act.request operation="diagram.link.make" to=?a toPort=?nm
@lk.pm.p ui.diagram.nport node=?a name=?nm side=?sd
@lk.pm.sf app.act.arg call=new.edge attr=diagram.sketch.from_side value=?sd
@lk.pm.nf app.act.arg call=new.edge attr=diagram.sketch.from_port value=?nm
@lk.pm.st app.act.arg call=new.edge attr=diagram.sketch.to_side value=?sd
@lk.pm.nt app.act.arg call=new.edge attr=diagram.sketch.to_port value=?nm
@lk.lg.make.port.from.side core.rule when=$lk.pm.rf when=$lk.pm.made when=$lk.pm.p then=$lk.pm.sf
@lk.lg.make.port.from.name core.rule when=$lk.pm.rf when=$lk.pm.made when=$lk.pm.p then=$lk.pm.nf
@lk.lg.make.port.to.side core.rule when=$lk.pm.rt when=$lk.pm.made when=$lk.pm.p then=$lk.pm.st
@lk.lg.make.port.to.name core.rule when=$lk.pm.rt when=$lk.pm.made when=$lk.pm.p then=$lk.pm.nt
@lk.pm.pn ui.diagram.nport node=?a name=?nm
@lk.lg.make.port.from.missing core.rule when=$lk.pm.rf not=$lk.pm.pn then=$lk.pa.np
@lk.lg.make.port.to.missing core.rule when=$lk.pm.rt not=$lk.pm.pn then=$lk.pa.np

# ---- Moving nodes moves the bends of the links between them by the same amount ----
@lk.mv.r app.act.request operation="diagram.node.place" x=?x y=?y
@lk.mv.cx ui.diagram.centre key=x sum=?sx
@lk.mv.cy ui.diagram.centre key=y sum=?sy
@lk.mv.ck ui.diagram.centre key=count sum=?k
@lk.mv.ia app.act.item param="ids" value=?a
@lk.mv.ib app.act.item param="ids" value=?b
@lk.mv.e w.diagram.edge code=?ec from=$lk.mv.na to=$lk.mv.nb
@lk.mv.na w.diagram.node code=?a
@lk.mv.nb w.diagram.node code=?b
@lk.mv.b diagram.sketch.bend edge=$lk.mv.e x=?bx y=?by
@lk.mv.ax core.calc out=?ax fn=div args=?sx args=?k
@lk.mv.ay core.calc out=?ay fn=div args=?sy args=?k
@lk.mv.dx core.calc out=?dx fn=sub args=?x args=?ax
@lk.mv.dy core.calc out=?dy fn=sub args=?y args=?ay
@lk.mv.nx core.calc out=?nx fn=add args=?bx args=?dx
@lk.mv.ny core.calc out=?ny fn=add args=?by args=?dy
@lk.mv.c.x app.act.call act=change thing=$lk.mv.b attr=x value=?nx order=4
@lk.mv.c.y app.act.call act=change thing=$lk.mv.b attr=y value=?ny order=5
@lk.lg.place.bend.x core.rule when=$lk.mv.r when=$lk.mv.cx when=$lk.mv.cy when=$lk.mv.ck when=$lk.mv.ia when=$lk.mv.ib when=$lk.mv.e when=$lk.mv.na when=$lk.mv.nb when=$lk.mv.b with=$lk.mv.ax with=$lk.mv.ay with=$lk.mv.dx with=$lk.mv.dy with=$lk.mv.nx with=$lk.mv.ny then=$lk.mv.c.x
@lk.lg.place.bend.y core.rule when=$lk.mv.r when=$lk.mv.cx when=$lk.mv.cy when=$lk.mv.ck when=$lk.mv.ia when=$lk.mv.ib when=$lk.mv.e when=$lk.mv.na when=$lk.mv.nb when=$lk.mv.b with=$lk.mv.ax with=$lk.mv.ay with=$lk.mv.dx with=$lk.mv.dy with=$lk.mv.nx with=$lk.mv.ny then=$lk.mv.c.y

# ---- A link with a free end, as a reader observes it: the node at its attached end only ----
@lk.oz.e w.diagram.edge code=?id
@lk.oz.f w.diagram.edge code=?id from=$lk.oz.na
@lk.oz.t w.diagram.edge code=?id to=$lk.oz.nb
@lk.oz.na w.diagram.node code=?a
@lk.oz.nb w.diagram.node code=?b
@lk.oz.hf w.diagram.edge code=?id from=?anyf
@lk.oz.ht w.diagram.edge code=?id to=?anyt
@lk.oz.sel ui.diagram.picked id=?id
@lk.oz.of app.observe.object id=?id kind=link sourceType=diagram.sketch.link binding=diagram.link from=?a selected=false
@lk.oz.ofs app.observe.object id=?id kind=link sourceType=diagram.sketch.link binding=diagram.link from=?a selected=true
@lk.oz.ot app.observe.object id=?id kind=link sourceType=diagram.sketch.link binding=diagram.link to=?b selected=false
@lk.oz.ots app.observe.object id=?id kind=link sourceType=diagram.sketch.link binding=diagram.link to=?b selected=true
@lk.oz.on app.observe.object id=?id kind=link sourceType=diagram.sketch.link binding=diagram.link selected=false
@lk.oz.ons app.observe.object id=?id kind=link sourceType=diagram.sketch.link binding=diagram.link selected=true
@lk.observe.link.object.to.free core.rule when=$lk.oz.f when=$lk.oz.na not=$lk.oz.ht not=$lk.oz.sel then=$lk.oz.of
@lk.observe.link.to.free.selected core.rule when=$lk.oz.f when=$lk.oz.na not=$lk.oz.ht when=$lk.oz.sel then=$lk.oz.ofs
@lk.observe.link.object.from.free core.rule when=$lk.oz.t when=$lk.oz.nb not=$lk.oz.hf not=$lk.oz.sel then=$lk.oz.ot
@lk.observe.link.from.free.selected core.rule when=$lk.oz.t when=$lk.oz.nb not=$lk.oz.hf when=$lk.oz.sel then=$lk.oz.ots
@lk.observe.link.both.free core.rule when=$lk.oz.e not=$lk.oz.hf not=$lk.oz.ht not=$lk.oz.sel then=$lk.oz.on
@lk.observe.link.both.free.selected core.rule when=$lk.oz.e not=$lk.oz.hf not=$lk.oz.ht when=$lk.oz.sel then=$lk.oz.ons
@lk.oz.rf app.observe.relation subject=?id object=?a kind=endpoint_of
@lk.oz.rt app.observe.relation subject=?id object=?b kind=endpoint_of
@lk.spatial.endpoint.of.half.from core.rule when=$lk.oz.f when=$lk.oz.na not=$lk.oz.ht then=$lk.oz.rf
@lk.spatial.endpoint.of.half.to core.rule when=$lk.oz.t when=$lk.oz.nb not=$lk.oz.hf then=$lk.oz.rt

# ---- Bends: add one (after the bend said, 0 = before the first; at the end otherwise), move one, remove one or all ----
@lk.b.r app.act.request operation="diagram.link.bend.add" x=?x y=?y
@lk.b.mk app.act.call act=make kind=diagram.sketch.bend edge=$lk.c.ed seq=?o x=?x y=?y order=1
@lk.b.any ui.diagram.bendat edge=?id
@lk.b.one core.calc out=?o fn=add args=0 args=1
@lk.lg.bend.add.first core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed not=$lk.b.any with=$lk.b.one then=$lk.b.mk
@lk.b.after app.act.request after=?af
@lk.b.cnt ui.diagram.bends edge=?id count=?n
@lk.b.hi ui.diagram.bendhi edge=?id order=?hi
@lk.b.appendable core.check fn=gte args=?af args=?n
@lk.b.next core.calc out=?o fn=add args=?hi args=1
@lk.lg.bend.add.end core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed when=$lk.b.hi not=$lk.b.after with=$lk.b.next then=$lk.b.mk
@lk.lg.bend.add.after.last core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed when=$lk.b.hi when=$lk.b.after when=$lk.b.cnt if=$lk.b.appendable with=$lk.b.next then=$lk.b.mk
@lk.b.lo ui.diagram.bendlo edge=?id order=?lo
@lk.b.isfront core.check fn=lte args=?af args=0
@lk.b.front core.calc out=?o fn=sub args=?lo args=1
@lk.lg.bend.add.front core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed when=$lk.b.lo when=$lk.b.after if=$lk.b.isfront with=$lk.b.front then=$lk.b.mk
@lk.b.ka ui.diagram.bend edge=?id k=?af order=?oa
@lk.b.kb ui.diagram.bend edge=?id k=?kb order=?ob
@lk.b.isnext core.calc out=?k1 fn=add args=?af args=1
@lk.b.nexteq core.check fn=eq args=?kb args=?k1
@lk.b.mid1 core.calc out=?o1 fn=add args=?oa args=?ob
@lk.b.mid core.calc out=?o fn=div args=?o1 args=2
@lk.lg.bend.add.between core.rule when=$lk.b.r when=$lk.c.it when=$lk.c.ed when=$lk.b.after when=$lk.b.ka when=$lk.b.kb with=$lk.b.isnext if=$lk.b.nexteq with=$lk.b.mid1 with=$lk.b.mid then=$lk.b.mk
@lk.bm.r app.act.request operation="diagram.link.bend.move" bend=?k x=?x y=?y
@lk.bm.k ui.diagram.bend edge=?id k=?k order=?o
@lk.bm.b diagram.sketch.bend edge=$lk.c.ed seq=?o
@lk.bm.cx app.act.call act=change thing=$lk.bm.b attr=x value=?x order=1
@lk.bm.cy app.act.call act=change thing=$lk.bm.b attr=y value=?y order=2
@lk.lg.bend.move.x core.rule when=$lk.bm.r when=$lk.c.it when=$lk.c.ed when=$lk.bm.k when=$lk.bm.b then=$lk.bm.cx
@lk.lg.bend.move.y core.rule when=$lk.bm.r when=$lk.c.it when=$lk.c.ed when=$lk.bm.k when=$lk.bm.b then=$lk.bm.cy
@lk.bm.miss app.act.refuse reason=missing-target
@lk.bm.r2 app.act.request operation="diagram.link.bend.move" bend=?k
@lk.bm.k2 ui.diagram.bend edge=?id k=?k
@lk.lg.bend.move.missing core.rule when=$lk.bm.r2 when=$lk.c.it when=$lk.c.ed not=$lk.bm.k2 then=$lk.bm.miss
@lk.br.r app.act.request operation="diagram.link.bend.remove" bend=?k
@lk.br.rm app.act.call act=remove thing=$lk.bm.b order=1
@lk.lg.bend.remove.one core.rule when=$lk.br.r when=$lk.c.it when=$lk.c.ed when=$lk.bm.k when=$lk.bm.b then=$lk.br.rm
@lk.lg.bend.remove.missing core.rule when=$lk.br.r when=$lk.c.it when=$lk.c.ed not=$lk.bm.k2 then=$lk.bm.miss
@lk.br.all app.act.request operation="diagram.link.bend.remove"
@lk.br.anyk app.act.request bend=?anyk
@lk.br.each diagram.sketch.bend edge=$lk.c.ed
@lk.br.rme app.act.call act=remove thing=$lk.br.each order=1
@lk.lg.bend.remove.all core.rule when=$lk.br.all when=$lk.c.it when=$lk.c.ed when=$lk.br.each not=$lk.br.anyk then=$lk.br.rme

# ---- Reversing a link also swaps its sides, marks and free ends, and passes its bends the other way ----
@lk.rv.r app.act.request operation="diagram.link.reverse"
@lk.rv.both w.diagram.edge code=?id from=?anyf to=?anyt
@lk.rv.side.a.has w.diagram.edge code=?id diagram.sketch.from_side=?v
@lk.rv.side.a.lack w.diagram.edge code=?id diagram.sketch.to_side=?anyv
@lk.rv.side.a.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=?v order=3
@lk.rv.side.a.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=auto order=3
@lk.lg.reverse.side.a core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.side.a.has then=$lk.rv.side.a.copy
@lk.lg.reverse.side.a.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.side.a.has not=$lk.rv.side.a.lack then=$lk.rv.side.a.reset
@lk.rv.side.b.has w.diagram.edge code=?id diagram.sketch.to_side=?v
@lk.rv.side.b.lack w.diagram.edge code=?id diagram.sketch.from_side=?anyv
@lk.rv.side.b.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_side value=?v order=3
@lk.rv.side.b.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_side value=auto order=3
@lk.lg.reverse.side.b core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.side.b.has then=$lk.rv.side.b.copy
@lk.lg.reverse.side.b.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.side.b.has not=$lk.rv.side.b.lack then=$lk.rv.side.b.reset
@lk.rv.port.a.has w.diagram.edge code=?id diagram.sketch.from_port=?v
@lk.rv.port.a.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_port value=?v order=3
@lk.lg.reverse.port.a core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.port.a.has then=$lk.rv.port.a.copy
@lk.rv.port.b.has w.diagram.edge code=?id diagram.sketch.to_port=?v
@lk.rv.port.b.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_port value=?v order=3
@lk.lg.reverse.port.b core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.port.b.has then=$lk.rv.port.b.copy
@lk.rv.mark.a.has w.diagram.edge code=?id diagram.sketch.head=?v
@lk.rv.mark.a.lack w.diagram.edge code=?id diagram.sketch.tail=?anyv
@lk.rv.mark.a.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.tail value=?v order=3
@lk.rv.mark.a.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.head value=arrow order=3
@lk.lg.reverse.mark.a core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.mark.a.has then=$lk.rv.mark.a.copy
@lk.lg.reverse.mark.a.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.mark.a.has not=$lk.rv.mark.a.lack then=$lk.rv.mark.a.reset
@lk.rv.mark.b.has w.diagram.edge code=?id diagram.sketch.tail=?v
@lk.rv.mark.b.lack w.diagram.edge code=?id diagram.sketch.head=?anyv
@lk.rv.mark.b.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.head value=?v order=3
@lk.rv.mark.b.reset app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.tail value=arrow order=3
@lk.lg.reverse.mark.b core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.mark.b.has then=$lk.rv.mark.b.copy
@lk.lg.reverse.mark.b.alone core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.mark.b.has not=$lk.rv.mark.b.lack then=$lk.rv.mark.b.reset
@lk.rv.from_x.has w.diagram.edge code=?id diagram.sketch.from_x=?v
@lk.rv.from_x.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_x value=?v order=3
@lk.lg.reverse.from_x core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.from_x.has then=$lk.rv.from_x.copy
@lk.rv.to_x.has w.diagram.edge code=?id diagram.sketch.to_x=?v
@lk.rv.to_x.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_x value=?v order=3
@lk.lg.reverse.to_x core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.to_x.has then=$lk.rv.to_x.copy
@lk.rv.from_y.has w.diagram.edge code=?id diagram.sketch.from_y=?v
@lk.rv.from_y.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.to_y value=?v order=3
@lk.lg.reverse.from_y core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.from_y.has then=$lk.rv.from_y.copy
@lk.rv.to_y.has w.diagram.edge code=?id diagram.sketch.to_y=?v
@lk.rv.to_y.copy app.act.call act=change thing=$lk.c.ed attr=diagram.sketch.from_y value=?v order=3
@lk.lg.reverse.to_y core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.to_y.has then=$lk.rv.to_y.copy
@lk.rv.bend diagram.sketch.bend edge=$lk.c.ed seq=?o
@lk.rv.neg core.calc out=?no fn=sub args=0 args=?o
@lk.rv.bc app.act.call act=change thing=$lk.rv.bend attr=seq value=?no order=3
@lk.lg.reverse.bends core.rule when=$lk.rv.r when=$lk.c.it when=$lk.c.ed when=$lk.rv.both when=$lk.rv.bend with=$lk.rv.neg then=$lk.rv.bc

# ---- What a reader observes of a link's geometry ----
@lk.o.fs w.diagram.edge code=?id diagram.sketch.from_side=?v
@lk.o.fs.o app.observe.input id=?id key=fromSide value=?v
@lk.observe.link.from.side core.rule when=$lk.o.fs then=$lk.o.fs.o
@lk.o.ts w.diagram.edge code=?id diagram.sketch.to_side=?v
@lk.o.ts.o app.observe.input id=?id key=toSide value=?v
@lk.observe.link.to.side core.rule when=$lk.o.ts then=$lk.o.ts.o
@lk.o.hd w.diagram.edge code=?id diagram.sketch.head=?v
@lk.o.hd.o app.observe.input id=?id key=head value=?v
@lk.observe.link.head core.rule when=$lk.o.hd then=$lk.o.hd.o
@lk.o.tl w.diagram.edge code=?id diagram.sketch.tail=?v
@lk.o.tl.o app.observe.input id=?id key=tail value=?v
@lk.observe.link.tail core.rule when=$lk.o.tl then=$lk.o.tl.o
@lk.o.la w.diagram.edge code=?id diagram.sketch.label_at=?v
@lk.o.la.o app.observe.input id=?id key=labelPosition value=?v
@lk.observe.link.label.position core.rule when=$lk.o.la then=$lk.o.la.o
@lk.o.ff w.diagram.edge code=?id diagram.sketch.from_x=?x diagram.sketch.from_y=?y
@lk.o.hf w.diagram.edge code=?id from=?anyf
@lk.o.ff.o app.observe.input id=?id key=fromFree value=true
@lk.o.ffx app.observe.input id=?id key=fromX value=?x
@lk.o.ffy app.observe.input id=?id key=fromY value=?y
@lk.observe.link.from.free core.rule when=$lk.o.ff not=$lk.o.hf then=$lk.o.ff.o
@lk.observe.link.from.x core.rule when=$lk.o.ff not=$lk.o.hf then=$lk.o.ffx
@lk.observe.link.from.y core.rule when=$lk.o.ff not=$lk.o.hf then=$lk.o.ffy
@lk.o.tf w.diagram.edge code=?id diagram.sketch.to_x=?x diagram.sketch.to_y=?y
@lk.o.ht w.diagram.edge code=?id to=?anyt
@lk.o.tf.o app.observe.input id=?id key=toFree value=true
@lk.o.tfx app.observe.input id=?id key=toX value=?x
@lk.o.tfy app.observe.input id=?id key=toY value=?y
@lk.observe.link.to.free core.rule when=$lk.o.tf not=$lk.o.ht then=$lk.o.tf.o
@lk.observe.link.to.x core.rule when=$lk.o.tf not=$lk.o.ht then=$lk.o.tfx
@lk.observe.link.to.y core.rule when=$lk.o.tf not=$lk.o.ht then=$lk.o.tfy
@lk.o.fp w.diagram.edge code=?id diagram.sketch.from_port=?v
@lk.o.fp.o app.observe.input id=?id key=fromPort value=?v
@lk.observe.link.from.port core.rule when=$lk.o.fp then=$lk.o.fp.o
@lk.o.tp w.diagram.edge code=?id diagram.sketch.to_port=?v
@lk.o.tp.o app.observe.input id=?id key=toPort value=?v
@lk.observe.link.to.port core.rule when=$lk.o.tp then=$lk.o.tp.o
# Each bend as "k x y" (k from 1, in order along the link).
@lk.o.bd ui.diagram.bend edge=?id k=?k x=?x y=?y
@lk.o.bd.v core.calc out=?v fn=concat args=?k args=" " args=?x args=" " args=?y
@lk.o.bd.o app.observe.input id=?id key=bends value=?v
@lk.observe.link.bends core.rule when=$lk.o.bd with=$lk.o.bd.v then=$lk.o.bd.o
@lk.o.mw ui.diagram.mway edge=?id way=?v
@lk.o.mw.o app.observe.input id=?id key=way value=?v
@lk.observe.link.manual.way core.rule when=$lk.o.mw then=$lk.o.mw.o
