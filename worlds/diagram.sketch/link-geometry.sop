@lk.lg.straight.leg.tail core.rule when=$lk.gt.w when=$lk.gt.s when=$lk.gt.s1 with=$lk.gt.tdx with=$lk.gt.tdy then=$lk.gt.to

# ---- Orthogonal: each piece from vertex i to i + 1 turns at right angles ----
# The ends: an attached side's port or a free point as they are; an auto end at the port of the side that faces where
# the line goes (sideways when that is further across than down).
@lk.go.w ui.diagram.mway edge=?e way=orthogonal
@lk.go.an ui.diagram.anchor edge=?e at=?at x=?x y=?y side=?s
@lk.go.fixed core.check fn=neq args=?s args=auto
