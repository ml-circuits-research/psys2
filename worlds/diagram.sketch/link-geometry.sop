@lk.cs.y1 core.calc out=?y1a fn=mul args=?py args=?a
@lk.cs.y2 core.calc out=?y2a fn=mul args=?cy args=?b
@lk.cs.y3 core.calc out=?y3a fn=mul args=?qy args=?c
@lk.cs.y core.calc out=?y fn=add args=?y1a args=?y2a args=?y3a
@lk.cs.ix0 core.calc out=?ix0 fn=sub args=?x0 args=8
