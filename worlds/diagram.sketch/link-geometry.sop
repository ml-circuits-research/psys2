@lk.go.shy core.calc out=?shy fn=mul args=?sh args=?ty
@lk.go.x core.calc out=?x fn=add args=?x0 args=?shx
@lk.go.y core.calc out=?y fn=add args=?y0 args=?shy
@lk.go.oo ui.diagram.oend edge=?e at=?at side=?s x=?x y=?y
@lk.lg.oend core.rule when=$lk.go.o0 when=$lk.go.po when=$lk.go.tn with=$lk.go.sh with=$lk.go.shx with=$lk.go.shy with=$lk.go.x with=$lk.go.y then=$lk.go.oo
@lk.go.ox ui.diagram.oend edge=?e at=?at x=?x y=?y
@lk.go.me ui.diagram.mend edge=?e at=?at x=?x y=?y
@lk.lg.mend.ortho core.rule when=$lk.go.w when=$lk.go.ox then=$lk.go.me
