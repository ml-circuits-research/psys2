@lk.lg.markshow.tail.both core.rule when=$lk.gn.t when=$lk.gn.both then=$lk.gn.ts
@lk.lg.markshow.tail.back core.rule when=$lk.gn.t when=$lk.gn.back then=$lk.gn.ts
# The direction at each end: an arrow's own, or a gap route's tip turned to a unit vector.
@lk.gn.pd ui.diagram.pvec pointing=down ux=0 uy=1
