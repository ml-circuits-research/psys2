# Its bends again (passed the other way when reversed).
@lk.db.b diagram.sketch.bend edge=$lk.c.ed seq=?s x=?x y=?y
@lk.db.m ui.diagram.remake edge=?id mode=?m
@lk.db.isrev core.check fn=eq args=?m args=reverse
@lk.db.notrev core.check fn=neq args=?m args=reverse
@lk.db.neg core.calc out=?ns fn=sub args=0 args=?s
@lk.db.keep app.act.call act=make kind=diagram.sketch.bend edge=remade.edge seq=?s x=?x y=?y order=3
@lk.db.flip app.act.call act=make kind=diagram.sketch.bend edge=remade.edge seq=?ns x=?x y=?y order=3
@lk.lg.remake.bend core.rule when=$lk.db.m when=$lk.c.ed when=$lk.db.b if=$lk.db.notrev then=$lk.db.keep
@lk.lg.remake.bend.reverse core.rule when=$lk.db.m when=$lk.c.ed when=$lk.db.b if=$lk.db.isrev with=$lk.db.neg then=$lk.db.flip
# The detached end's point: the one said, else 40 beyond its tip away from its node's centre.
@lk.dp.mf ui.diagram.remake edge=?id mode=detach-from
@lk.dp.mt ui.diagram.remake edge=?id mode=detach-to
@lk.dp.xy app.act.request operation="diagram.link.detach" x=?x y=?y
@lk.dp.fx app.act.arg call=remade.edge attr=diagram.sketch.from_x value=?x
@lk.dp.fy app.act.arg call=remade.edge attr=diagram.sketch.from_y value=?y
