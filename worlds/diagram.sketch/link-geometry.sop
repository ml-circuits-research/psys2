@lk.lg.ortho.vertex core.rule when=$lk.go.w when=$lk.gx.v with=$lk.gx.n then=$lk.gx.p
@lk.gx.sa ui.diagram.stub edge=?e at=a x=?x y=?y
@lk.gx.sap ui.diagram.point source=?e n=10 x=?x y=?y
@lk.gx.sda ui.diagram.sided edge=?e at=a
@lk.lg.ortho.stub.a core.rule when=$lk.go.w when=$lk.gx.sa when=$lk.gx.sda then=$lk.gx.sap
@lk.gx.sb ui.diagram.stub edge=?e at=b x=?x y=?y
@lk.gx.sdb ui.diagram.sided edge=?e at=b
@lk.gx.last ui.diagram.mlast edge=?e i=?l
@lk.gx.nl1 core.calc out=?nl1 fn=mul args=?l args=100
@lk.gx.nl core.calc out=?nl fn=sub args=?nl1 args=10
@lk.gx.sbp ui.diagram.point source=?e n=?nl x=?x y=?y
@lk.lg.ortho.stub.b core.rule when=$lk.go.w when=$lk.gx.sb when=$lk.gx.sdb when=$lk.gx.last with=$lk.gx.nl1 with=$lk.gx.nl then=$lk.gx.sbp
@lk.gx.f ui.diagram.ofit edge=?e i=?i ax=?ax ay=?ay bx=?bx by=?by pat=?pat c=?c
@lk.gx.n1 core.calc out=?n1 fn=mul args=?i args=100
@lk.gx.n30 core.calc out=?n30 fn=add args=?n1 args=30
@lk.gx.n60 core.calc out=?n60 fn=add args=?n1 args=60
@lk.gx.ishv core.check fn=eq args=?pat args=hv
@lk.gx.isvh core.check fn=eq args=?pat args=vh
@lk.gx.ishvh core.check fn=eq args=?pat args=hvh
@lk.gx.isvhv core.check fn=eq args=?pat args=vhv
@lk.gx.hv ui.diagram.point source=?e n=?n30 x=?bx y=?ay
@lk.gx.vh ui.diagram.point source=?e n=?n30 x=?ax y=?by
