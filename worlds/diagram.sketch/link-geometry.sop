@lk.lg.straight.leg.head core.rule when=$lk.gt.w when=$lk.gt.last when=$lk.gt.q when=$lk.gt.bf with=$lk.gt.pl if=$lk.gt.isl.b with=$lk.gt.hdx with=$lk.gt.hdy then=$lk.gt.ho
@lk.gt.isl.b core.check fn=eq args=?pp args=?pl
@lk.gt.s ui.diagram.mv edge=?e i=0 x=?sx y=?sy
