# diagram.sketch as a matrix: the diagram is wires, what follows from the arrows is derived by rules and aggregates, and what cannot be is refused with the reason.
#
# The editor engine (engine/ and ops.mjs: the reader of sentences, the commands, the Datalog questions, the layouts, the templates, the arrow routing) is unchanged and
# keeps working on the session state; the library takes the state over after every operation (fns.mjs, `adopt`; `toState` is the way back): one
# diagram.sketch.shape per shape (id, name, kind, place, size, colour, and `obj`, the exact shape, so the state is derived without loss), one diagram.sketch.edge per
# arrow (id, the two ends, style, arrowhead), diagram.sketch.group with diagram.sketch.member for the groups, diagram.sketch.sel and diagram.sketch.last (what is
# selected, what "it" is) and diagram.sketch.scene (the engine's bookkeeping: rules, facts, counters, frames). Undo and redo are the session timeline's. The geometry
# (positions, routes, layouts) is the engine's; the library never sees a point of a path.

@dk.seq core.sequence key=core.seq

# ---- the state as wires
@dk.k.s.sid core.slot of=diagram.sketch.shape key=sid kind=string required=true
@dk.k.s.name core.slot of=diagram.sketch.shape key=name kind=string required=true
@dk.k.s.ord core.slot of=diagram.sketch.shape key=ord kind=integer required=true
@dk.k.s.shape core.slot of=diagram.sketch.shape key=shape kind=atom enum=circle enum=square enum=rectangle enum=triangle enum=diamond enum=ellipse enum=hexagon enum=star enum=text required=true
@dk.k.s.x core.slot of=diagram.sketch.shape key=x kind=number
@dk.k.s.y core.slot of=diagram.sketch.shape key=y kind=number
@dk.k.s.size core.slot of=diagram.sketch.shape key=size kind=number
@dk.k.s.w core.slot of=diagram.sketch.shape key=w kind=number
@dk.k.s.h core.slot of=diagram.sketch.shape key=h kind=number
@dk.k.s.color core.slot of=diagram.sketch.shape key=color kind=string
@dk.k.s.layer core.slot of=diagram.sketch.shape key=layer kind=atom
@dk.k.s.label core.slot of=diagram.sketch.shape key=label kind=string
@dk.k.s.obj core.slot of=diagram.sketch.shape key=obj kind=blob required=true
@dk.k.e.eid core.slot of=diagram.sketch.edge key=eid kind=string required=true
@dk.k.e.ord core.slot of=diagram.sketch.edge key=ord kind=integer required=true
@dk.k.e.from core.slot of=diagram.sketch.edge key=from kind=string required=true
@dk.k.e.to core.slot of=diagram.sketch.edge key=to kind=string required=true
@dk.k.e.style core.slot of=diagram.sketch.edge key=style kind=atom enum=solid enum=dashed enum=dotted
@dk.k.e.arrow core.slot of=diagram.sketch.edge key=arrow kind=atom enum=forward enum=both enum=none
@dk.k.e.obj core.slot of=diagram.sketch.edge key=obj kind=blob required=true
@dk.k.g.gname core.slot of=diagram.sketch.group key=gname kind=string required=true
@dk.k.g.ord core.slot of=diagram.sketch.group key=ord kind=integer required=true
@dk.k.g.n core.slot of=diagram.sketch.group key=n kind=integer required=true
@dk.k.g.obj core.slot of=diagram.sketch.group key=obj kind=blob required=true
@dk.k.m.gname core.slot of=diagram.sketch.member key=gname kind=string required=true
@dk.k.m.member core.slot of=diagram.sketch.member key=member kind=string required=true
@dk.k.m.ord core.slot of=diagram.sketch.member key=ord kind=integer required=true
@dk.k.sel.what core.slot of=diagram.sketch.sel key=what kind=atom enum=shape enum=edge required=true
@dk.k.sel.ref core.slot of=diagram.sketch.sel key=ref kind=string required=true
@dk.k.sel.ord core.slot of=diagram.sketch.sel key=ord kind=integer required=true
@dk.k.l.name core.slot of=diagram.sketch.last key=name kind=string required=true
@dk.k.l.i core.slot of=diagram.sketch.last key=i kind=integer required=true
@dk.k.sc.ns core.slot of=diagram.sketch.scene key=nshapes kind=integer required=true
@dk.k.sc.ne core.slot of=diagram.sketch.scene key=nedges kind=integer required=true
@dk.k.sc.rest core.slot of=diagram.sketch.scene key=rest kind=blob required=true

# ---- what cannot be: two shapes with one name or one id, two arrows for one pair, an arrow to a shape that is not there, a group member that is not there, a selection
# or an "it" that is not in the diagram
@dk.s1 diagram.sketch.shape name=?n
@dk.s2 diagram.sketch.shape name=?n
@dk.t.diff core.check fn=neq args=$dk.s1 args=$dk.s2
@dk.d.name core.deny when=$dk.s1 when=$dk.s2 if=$dk.t.diff why="Two shapes are called ?n."
@dk.s3 diagram.sketch.shape sid=?i
@dk.s4 diagram.sketch.shape sid=?i
@dk.t.diff2 core.check fn=neq args=$dk.s3 args=$dk.s4
@dk.d.sid core.deny when=$dk.s3 when=$dk.s4 if=$dk.t.diff2 why="Two shapes have the id ?i."
@dk.e1 diagram.sketch.edge from=?f to=?t
@dk.e2 diagram.sketch.edge from=?f to=?t
@dk.t.diff3 core.check fn=neq args=$dk.e1 args=$dk.e2
@dk.d.twice core.deny when=$dk.e1 when=$dk.e2 if=$dk.t.diff3 why="That arrow already connects ?f and ?t."
@dk.ef diagram.sketch.edge eid=?e from=?f
@dk.sf diagram.sketch.shape name=?f
@dk.d.from core.deny when=$dk.ef not=$dk.sf why="The arrow ?e starts at ?f, which is not in the diagram."
@dk.et diagram.sketch.edge eid=?e to=?t
@dk.st diagram.sketch.shape name=?t
@dk.d.to core.deny when=$dk.et not=$dk.st why="The arrow ?e goes to ?t, which is not in the diagram."
@dk.gm diagram.sketch.member gname=?g member=?m
@dk.sm diagram.sketch.shape name=?m
@dk.d.member core.deny when=$dk.gm not=$dk.sm why="?m is in the group ?g but not in the diagram."
@dk.ss diagram.sketch.sel what=shape ref=?r
@dk.sr diagram.sketch.shape name=?r
@dk.d.selshape core.deny when=$dk.ss not=$dk.sr why="The selected shape ?r is not in the diagram."
@dk.se diagram.sketch.sel what=edge ref=?r
@dk.er diagram.sketch.edge eid=?r
@dk.d.seledge core.deny when=$dk.se not=$dk.er why="The selected arrow ?r is not in the diagram."
@dk.ls diagram.sketch.last name=?n
@dk.sn diagram.sketch.shape name=?n
@dk.d.last core.deny when=$dk.ls not=$dk.sn why="?n, the shape the last command named, is not in the diagram."

# ---- what follows from the arrows: how many arrows leave a shape and how many arrive at it (anchored on the shape, so a shape with no arrow has 0 and 0)
@dk.k.dg.name core.slot of=diagram.sketch.degree key=name kind=string
@dk.k.dg.out core.slot of=diagram.sketch.degree key=out kind=integer
@dk.k.dg.inn core.slot of=diagram.sketch.degree key=inn kind=integer
@dk.k.dg.total core.slot of=diagram.sketch.degree key=total kind=integer
@dk.dn diagram.sketch.shape name=?n
@dk.oe diagram.sketch.edge from=?n
@dk.ie diagram.sketch.edge to=?n
@dk.c.out core.calc out=?o fn=count over=$dk.oe
@dk.c.in core.calc out=?i fn=count over=$dk.ie
@dk.c.tot core.calc out=?tt fn=add args=?o args=?i
@dk.dg diagram.sketch.degree name=?n out=?o inn=?i total=?tt
@dk.r.dg core.rule when=$dk.dn with=$dk.c.out with=$dk.c.in with=$dk.c.tot then=$dk.dg

# ---- a request that would only repeat an arrow (asked by `guard` in fns.mjs, a dry run: the wire is never kept)
@dk.k.w.from core.slot of=diagram.sketch.want key=from kind=string required=true
@dk.k.w.to core.slot of=diagram.sketch.want key=to kind=string required=true
@dk.w diagram.sketch.want from=?f to=?t
@dk.we diagram.sketch.edge from=?f to=?t
@dk.d.want core.deny when=$dk.w when=$dk.we why="That arrow already connects ?f and ?t."
