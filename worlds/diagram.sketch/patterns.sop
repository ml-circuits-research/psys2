@pat.diagram.sketch.resize.thicker core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [make|turn|set|get|draw] {t:words(8)} [thicker|thinner|fatter|slimmer|heavier|lighter|thicker_please|thinner_please] {u:rest?}"
