@gen.diagram.sketch.note core.note
    text="Generated by scripts/build-diagram-patterns.mjs from the cue words of the source legend; edit the script, not this file. Each pattern reads the cue of one act and hands the whole sentence ({segment}) to its operation: the engine of diagram-vss-demo reads the arguments."

@pat.diagram.sketch.create core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [$diagram.sketch.v_create] [a|an|another|new|some|one_more|a_few] ... {s:lex.diagram.sketch.shapenoun} {t:rest?}"
    emit="@{_} core.request action=diagram.create arg.text=\"{segment}\""
    kind=request
    priority=10
    tabPriority=18
    canonical="Draw a red circle."
    canonical="Add a small blue square."
    example="Create a huge gold star in the center."
    example="A triangle."
    example="A hexagon."
    example="A star."
    example="An ellipse."
    example="A diamond."
    example="A rhombus."
    example="A square."
    example="An oval."
    example="A rectangle."
    example="A dot."
    example="A golden triangle."
    example="Draw a square."
    example="A navy hexagon."
    example="A circle."
    example="Place a rhombus."
    example="Insert an ellipse."
    example="A brown rhombus."
    example="A rect."
    example="A magenta triangle."
    example="Add an orange square."
    example="A ball."
    example="Build an indigo dot."
    example="Draw a rect."
    example="Slap a square."
    example="A yellow rhombus."
    example="Add a green ellipse."
    example="Place a diamond."
    example="Add a green triangle."
    example="Draw a triangle with no border."
    example="Sketch a block."
    doc="Draws a shape: its kind, colour, size, name, label and place (the engine reads them)."

@pat.diagram.sketch.create.named core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [$diagram.sketch.v_create] [a|an|another|new|the|one]? ... {s:lex.diagram.sketch.shapenoun} [$diagram.sketch.naming] {n:rest}"
    emit="@{_} core.request action=diagram.create arg.text=\"{segment}\""
    kind=request
    priority=13
    tabPriority=21
    signal=true
    canonical="Draw a rectangle called Api."
    example="Add a red circle named Start."
    example="Create a diamond labeled Check."
    doc="Draws a named shape (\"a rectangle called Api\"): a name makes it a diagram request on any tab."

@pat.diagram.sketch.create.in core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [$diagram.sketch.v_create] [a|an|another|new|some|one_more|a_few]? ... {s:lex.diagram.sketch.shapenoun} [in|inside|on|into|to] [the|a|my|this]? [diagram|diagrams|sketchpad|flowchart]"
    emit="@{_} core.request action=diagram.create arg.text=\"{segment}\""
    kind=request
    priority=13
    tabPriority=21
    signal=true
    canonical="Draw three circles in the diagram."
    example="Add a red square to the diagram."
    doc="Draws shapes and says where: \"in the diagram\" names the Diagram world, so it is a diagram request on any tab (RP5b: the drawing tab would read it as a place)."

@pat.diagram.sketch.template core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [$diagram.sketch.v_create|show|give_me|build|generate] ... {f:lex.diagram.sketch.diagramform} {t:rest?}"
    emit="@{_} core.request action=diagram.create arg.text=\"{segment}\""
    kind=request
    priority=13
    tabPriority=21
    signal=true
    canonical="Make an org chart with Ann, Bob and Cy."
    example="Draw a flowchart."
    example="Create a pyramid with three levels."
    example="Build a timeline of five steps."
    doc="Draws a whole diagram form (flowchart, org chart, pyramid, timeline ...) from a list of texts."

@pat.diagram.sketch.create.bare core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [a|an|one|another|the]? ... {s:lex.diagram.sketch.shapenoun} [$diagram.sketch.naming] {n:rest}"
    emit="@{_} core.request action=diagram.create arg.text=\"{segment}\""
    kind=request
    priority=10
    tabPriority=18
    tabOnly=true
    example="A blue rectangle called Dad."
    example="Under them I want a blue rectangle called Dad."
    example="A navy diamond named Fraud gets placed above Pay."
    doc="A named shape without a cue verb (\"a blue rectangle called Dad\"): the sentence names a new shape."

@pat.diagram.sketch.create.bare.count core.pattern
