@pat.diagram.sketch.new core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [$diagram.sketch.v_newdiagram|clear|reset] [a|an|the]? [new|fresh|clean|blank|empty]? [diagram|canvas|drawing|sketch] [please]?"
    emit="@{_} core.request action=diagram.new arg.text=\"{segment}\""
    kind=request
    priority=11
    tabPriority=19
