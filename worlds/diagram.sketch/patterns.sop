@pat.diagram.sketch.new.diagram core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [create|make|start|build|begin|give_me|i_want|i_need|let_s_make|let_s_start|let_s_create|i_would_like|i_d_like] [me|us]? [a|an|the|another|one|my]? [new|fresh|blank|empty|clean]? [diagram|sketch|diagrams] [please]? {t:rest?}"
    emit="@{_} core.request action=diagram.new arg.text=\"{segment}\""
    kind=request
