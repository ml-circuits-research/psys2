@pat.diagram.sketch.export core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [$diagram.sketch.v_save] [my|the|this|your]? [diagram|drawing|picture|chart|flowchart|canvas] [as|to|in|into|a]? {f:lex.diagram.sketch.fileformat?} [file]?"
