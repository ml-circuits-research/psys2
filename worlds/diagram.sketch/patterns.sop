@pat.diagram.sketch.new.bare core.pattern
    match="[$lang.connective]? [$lang.lead.filler]? [$lang.lead.polite]? [a|an|another]? [new|fresh|blank|empty|clean] [diagram|drawing|canvas|sketch] [please]?"
    emit="@{_} core.request action=diagram.new arg.text=\"{segment}\""
    kind=request
    priority=12
    tabPriority=20
