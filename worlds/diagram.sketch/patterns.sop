    emit="@{_} core.request action=diagram.sketch.own arg.pre=\"{pre}\" arg.post=\"{post}\" arg.text=\"{segment}\""
    kind=request
    priority=44
    tabPriority=52
    signal=true
    tabClaim=true
    example="Draw a shape in the form of a house."

