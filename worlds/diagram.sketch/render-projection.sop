@dg.route.type core.type of=ui.diagram.route
@dg.lane.type core.type of=ui.diagram.lane
@dg.right.type core.type of=ui.diagram.right
@dg.page.type core.type of=ui.diagram.page
@dg.rgb.type core.type of=ui.diagram.rgb
@dg.ink.type core.type of=ui.diagram.ink
@dg.draw.type core.type of=ui.diagram.draw
