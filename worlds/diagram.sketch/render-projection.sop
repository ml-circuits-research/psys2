@dg.t.extent.rows core.type of=ui.diagram.extent.rows
@dg.t.extent.widest core.type of=ui.diagram.extent.widest
@dg.t.lstat.above core.type of=ui.diagram.lstat.above
@dg.t.lstat.count core.type of=ui.diagram.lstat.count
@dg.t.lstat.height core.type of=ui.diagram.lstat.height
@dg.t.lstat.row core.type of=ui.diagram.lstat.row
@dg.t.lstat.width core.type of=ui.diagram.lstat.width
