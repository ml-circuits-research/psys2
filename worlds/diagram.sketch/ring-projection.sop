# diagram.sketch rings and slices (authored): a group laid out as a circle sets its members on a ring inside its frame;
# a group laid out as a pie or a doughnut draws its members' values as slices of one disc (a doughnut leaves the middle
# out), each slice in the member's colour or the next colour of the page theme's palette (vivid without a theme), its
# label outside the disc and its value inside the slice. Links between members of a ring are straight.
@rg.ring.type core.type of=ui.diagram.gring
@rg.rpos.type core.type of=ui.diagram.rpos
@rg.pie.type core.type of=ui.diagram.pie
@rg.ptotal.type core.type of=ui.diagram.ptotal
@rg.pbefore.type core.type of=ui.diagram.pbefore
@rg.pcum.type core.type of=ui.diagram.pcum
@rg.slice.type core.type of=ui.diagram.slice
@rg.sarc.type core.type of=ui.diagram.sarc
@rg.spal.type core.type of=ui.diagram.spal
@rg.scount.type core.type of=ui.diagram.scount
@rg.arcstep.type core.type of=ui.diagram.arcstep
@rg.arc.0 ui.diagram.arcstep k=0
@rg.arc.1 ui.diagram.arcstep k=1
@rg.arc.2 ui.diagram.arcstep k=2
@rg.arc.3 ui.diagram.arcstep k=3
@rg.arc.4 ui.diagram.arcstep k=4
@rg.arc.5 ui.diagram.arcstep k=5
@rg.arc.6 ui.diagram.arcstep k=6
@rg.arc.7 ui.diagram.arcstep k=7
@rg.arc.8 ui.diagram.arcstep k=8
@rg.arc.9 ui.diagram.arcstep k=9
@rg.arc.10 ui.diagram.arcstep k=10
@rg.arc.11 ui.diagram.arcstep k=11
@rg.arc.12 ui.diagram.arcstep k=12

# ---- A ring group: its radius from its members, its size, each member's place ----
@yr.g w.diagram.group code=?g layout=circle
@yr.n ui.diagram.gstat group=?g key=count value=?n
@yr.mw ui.diagram.gstat group=?g key=maxw value=?mw
@yr.mh ui.diagram.gstat group=?g key=maxh value=?mh
@yr.c ui.diagram.const cell=?cg
@yr.md core.calc out=?md fn=max args=?mw args=?mh
@yr.l1 core.calc out=?l1 fn=add args=?md args=?cg
@yr.l2 core.calc out=?l2 fn=mul args=?l1 args=?n
@yr.r1 core.calc out=?r1 fn=div args=?l2 args=6.2832
@yr.r core.calc out=?rr fn=max args=?r1 args=50
@yr.many core.check fn=gt args=?n args=1
@yr.out ui.diagram.gring group=?g r=?rr n=?n mw=?mw mh=?mh
@ring.group core.rule when=$yr.g when=$yr.n when=$yr.mw when=$yr.mh when=$yr.c if=$yr.many with=$yr.md with=$yr.l1 with=$yr.l2 with=$yr.r1 with=$yr.r then=$yr.out
@yr.one core.check fn=eq args=?n args=1
@yr.out1 ui.diagram.gring group=?g r=0 n=1 mw=?mw mh=?mh
@ring.group.one core.rule when=$yr.g when=$yr.n when=$yr.mw when=$yr.mh if=$yr.one then=$yr.out1
@yd.u ui.diagram.unit unit=?g kind=group
@yd.r ui.diagram.gring group=?g r=?rr mw=?mw mh=?mh
@yd.p ui.diagram.gpad group=?g pad=?pad top=?top
@yd.d2 core.calc out=?d2 fn=mul args=?rr args=2
@yd.p2 core.calc out=?p2 fn=mul args=?pad args=2
@yd.w1 core.calc out=?w1 fn=add args=?d2 args=?mw
@yd.w core.calc out=?w fn=add args=?w1 args=?p2
@yd.h1 core.calc out=?h1 fn=add args=?d2 args=?mh
@yd.h2 core.calc out=?h2 fn=add args=?h1 args=?top
@yd.h core.calc out=?h fn=add args=?h2 args=?pad
@yd.out ui.diagram.udim unit=?g w=?w h=?h
@ring.udim core.rule when=$yd.u when=$yd.r when=$yd.p with=$yd.d2 with=$yd.p2 with=$yd.w1 with=$yd.w with=$yd.h1 with=$yd.h2 with=$yd.h then=$yd.out
@yp.i ui.diagram.inside group=?g node=?c order=?o
@yp.r ui.diagram.gring group=?g n=?n
@yp.rk core.rank of=$yp.i by=order within=?g out=?k
@yp.k0 core.calc out=?k0 fn=sub args=?k args=1
@yp.a1 core.calc out=?a1 fn=mul args=?k0 args=360
@yp.a2 core.calc out=?a2 fn=div args=?a1 args=?n
@yp.a3 core.calc out=?a3 fn=add args=?a2 args=270
@yp.a core.calc out=?deg fn=mod args=?a3 args=360
@yp.out ui.diagram.rpos node=?c group=?g deg=?deg
@yp.ang ui.diagram.angle deg=?deg
@ring.pos core.rule when=$yp.i when=$yp.r with=$yp.rk with=$yp.k0 with=$yp.a1 with=$yp.a2 with=$yp.a3 with=$yp.a then=$yp.out
@ring.angle core.rule when=$yp.i when=$yp.r with=$yp.rk with=$yp.k0 with=$yp.a1 with=$yp.a2 with=$yp.a3 with=$yp.a then=$yp.ang
@yb.p ui.diagram.rpos node=?c group=?g deg=?deg
@yb.r ui.diagram.gring group=?g r=?rr mw=?mw mh=?mh
@yb.gb ui.diagram.ubox unit=?g x0=?gx y0=?gy
@yb.pd ui.diagram.gpad group=?g pad=?pad top=?top
@yb.t ui.diagram.trig deg=?deg s=?s c=?co
@yb.d ui.diagram.dim node=?c w=?w h=?h
@yb.hmw core.calc out=?hmw fn=div args=?mw args=2
@yb.hmh core.calc out=?hmh fn=div args=?mh args=2
@yb.cx1 core.calc out=?cx1 fn=add args=?gx args=?pad
@yb.cx2 core.calc out=?cx2 fn=add args=?cx1 args=?hmw
@yb.ccx core.calc out=?ccx fn=add args=?cx2 args=?rr
@yb.cy1 core.calc out=?cy1 fn=add args=?gy args=?top
@yb.cy2 core.calc out=?cy2 fn=add args=?cy1 args=?hmh
@yb.ccy core.calc out=?ccy fn=add args=?cy2 args=?rr
@yb.dx core.calc out=?dx fn=mul args=?rr args=?co
@yb.dy core.calc out=?dy fn=mul args=?rr args=?s
@yb.cx core.calc out=?cx fn=add args=?ccx args=?dx
@yb.cy core.calc out=?cy fn=add args=?ccy args=?dy
@yb.hw core.calc out=?hw fn=div args=?w args=2
@yb.hh core.calc out=?hh fn=div args=?h args=2
@yb.x0 core.calc out=?x0 fn=sub args=?cx args=?hw
@yb.x1 core.calc out=?x1 fn=add args=?cx args=?hw
@yb.y0 core.calc out=?y0 fn=sub args=?cy args=?hh
@yb.y1 core.calc out=?y1 fn=add args=?cy args=?hh
@yb.out ui.diagram.nbox node=?c x0=?x0 y0=?y0 x1=?x1 y1=?y1 cx=?cx cy=?cy w=?w h=?h
@ring.nbox core.rule when=$yb.p when=$yb.r when=$yb.gb when=$yb.pd when=$yb.t when=$yb.d with=$yb.hmw with=$yb.hmh with=$yb.cx1 with=$yb.cx2 with=$yb.ccx with=$yb.cy1 with=$yb.cy2 with=$yb.ccy with=$yb.dx with=$yb.dy with=$yb.cx with=$yb.cy with=$yb.hw with=$yb.hh with=$yb.x0 with=$yb.x1 with=$yb.y0 with=$yb.y1 then=$yb.out
# A link between two members of a ring is straight.
@ye.e w.diagram.edge code=?e from=$ye.a to=$ye.b
@ye.a w.diagram.node code=?a
@ye.b w.diagram.node code=?b
@ye.pa ui.diagram.rpos node=?a group=?g
@ye.pb ui.diagram.rpos node=?b group=?g
@ye.ne core.check fn=neq args=?a args=?b
@ye.out ui.diagram.route edge=?e way=straight a=?a b=?b la=0 lb=0
@ye.man ui.diagram.manual edge=?e
@ring.route core.rule when=$ye.e when=$ye.a when=$ye.b when=$ye.pa when=$ye.pb if=$ye.ne not=$ye.man then=$ye.out

# ---- Pie and doughnut groups ----
@yq.g w.diagram.group code=?g layout=?l
@yq.isp core.check fn=matches args=?l args="^(pie|doughnut)$"
@yq.r ui.diagram.cfmt group=?g slot=pie_radius v=?r
@yq.out ui.diagram.pie group=?g form=?l r=?r
@pie.group core.rule when=$yq.g when=$yq.r if=$yq.isp then=$yq.out
@yq.u ui.diagram.unit unit=?g kind=group
@yq.p ui.diagram.pie group=?g r=?r
@yq.gp ui.diagram.gpad group=?g pad=?pad top=?top
@yq.d2 core.calc out=?d2 fn=mul args=?r args=2
@yq.w0 core.calc out=?w0 fn=add args=?d2 args=140
@yq.h0 core.calc out=?h0 fn=add args=?d2 args=70
@yq.w core.calc out=?w fn=add args=?w0 args=?pad args=?pad
@yq.h core.calc out=?h fn=add args=?h0 args=?top args=?pad
@yq.dim ui.diagram.pdim group=?g w=?w h=?h
@pie.udim core.rule when=$yq.u when=$yq.p when=$yq.gp with=$yq.d2 with=$yq.w0 with=$yq.h0 with=$yq.w with=$yq.h then=$yq.dim
@rg.pdim.type core.type of=ui.diagram.pdim
@yq.pv ui.diagram.pdim group=?g w=?pw h=?ph
@yq.anyl w.diagram.group code=?g legend=?anyleg
@yq.ln w.diagram.group code=?g legend=none
@yq.lr w.diagram.group code=?g legend=right
@yq.lb w.diagram.group code=?g legend=bottom
@yq.out0 ui.diagram.udim unit=?g w=?pw h=?ph
@pie.udim.plain core.rule when=$yq.pv not=$yq.anyl then=$yq.out0
@pie.udim.none core.rule when=$yq.pv when=$yq.ln then=$yq.out0
@yq.wr core.calc out=?wr fn=add args=?pw args=130
@yq.outr ui.diagram.udim unit=?g w=?wr h=?ph
@pie.udim.right core.rule when=$yq.pv when=$yq.lr with=$yq.wr then=$yq.outr
@yq.cnt ui.diagram.gstat group=?g key=count value=?n
@yq.r1 core.calc out=?r1 fn=add args=?n args=2
@yq.rows core.calc out=?rows fn=idiv args=?r1 args=3
@yq.hb1 core.calc out=?hb1 fn=mul args=?rows args=18
@yq.hb core.calc out=?hb fn=add args=?ph args=?hb1
@yq.outb ui.diagram.udim unit=?g w=?pw h=?hb
@pie.udim.bottom core.rule when=$yq.pv when=$yq.lb when=$yq.cnt with=$yq.r1 with=$yq.rows with=$yq.hb1 with=$yq.hb then=$yq.outb
@yq.mi ui.diagram.inside group=?g node=?c
@yq.sm ui.diagram.slicemember node=?c group=?g
@pie.member core.rule when=$yq.p when=$yq.mi then=$yq.sm
@yt.m ui.diagram.slicemember node=?c group=?g
@yt.v w.diagram.node code=?c value=?v
@yt.tot ui.diagram.ptotal group=?g value=?s
@pie.total core.aggregate over=$yt.m over=$yt.v by=?g sum=?s args=?v then=$yt.tot
@yt.ma ui.diagram.inside group=?g node=?a order=?oa
@yt.mb ui.diagram.inside group=?g node=?b order=?ob
@yt.pa ui.diagram.slicemember node=?a group=?g
@yt.va w.diagram.node code=?a value=?va
@yt.lt core.check fn=lt args=?oa args=?ob
@yt.bf ui.diagram.pbefore node=?b before=?a v=?va
@pie.before core.rule when=$yt.ma when=$yt.mb when=$yt.pa when=$yt.va if=$yt.lt then=$yt.bf
@yt.b ui.diagram.pbefore node=?b v=?va
@yt.cum ui.diagram.pcum node=?b value=?cv
@pie.cum core.aggregate over=$yt.b by=?b sum=?cv args=?va then=$yt.cum
@yt.nb ui.diagram.pbefore node=?c
@yt.zero ui.diagram.pcum node=?c value=0
@pie.cum.first core.rule when=$yt.m not=$yt.nb then=$yt.zero
# Each slice: its start angle and sweep (degrees, clockwise from the top), its centre, radius and inner radius.
@ys.m ui.diagram.slicemember node=?c group=?g
@ys.v w.diagram.node code=?c value=?v
@ys.cum ui.diagram.pcum node=?c value=?cv
@ys.t ui.diagram.ptotal group=?g value=?s
@ys.p ui.diagram.pie group=?g form=?f r=?r
@ys.gb ui.diagram.ubox unit=?g x0=?gx y0=?gy
@ys.pd ui.diagram.pdim group=?g w=?gw
@ys.gp ui.diagram.gpad group=?g top=?top
@ys.a1 core.calc out=?a1 fn=mul args=?cv args=360
@ys.a2 core.calc out=?a2 fn=div args=?a1 args=?s
@ys.a0 core.calc out=?a0 fn=add args=?a2 args=270
@ys.w1 core.calc out=?w1 fn=mul args=?v args=360
@ys.sw core.calc out=?sw fn=div args=?w1 args=?s
@ys.hw core.calc out=?hgw fn=div args=?gw args=2
@ys.cx core.calc out=?cx fn=add args=?gx args=?hgw
@ys.cy1 core.calc out=?cy1 fn=add args=?gy args=?top
@ys.cy2 core.calc out=?cy2 fn=add args=?cy1 args=20
@ys.cy core.calc out=?cy fn=add args=?cy2 args=?r
@ys.isd core.check fn=eq args=?f args=doughnut
@ys.isp core.check fn=eq args=?f args=pie
@ys.ri core.calc out=?ri fn=mul args=?r args=0.55
@ys.outd ui.diagram.slice node=?c group=?g a0=?a0 sweep=?sw cx=?cx cy=?cy r=?r ri=?ri
@ys.outp ui.diagram.slice node=?c group=?g a0=?a0 sweep=?sw cx=?cx cy=?cy r=?r ri=0
@pie.slice.doughnut core.rule when=$ys.m when=$ys.v when=$ys.cum when=$ys.t when=$ys.p when=$ys.gb when=$ys.pd when=$ys.gp if=$ys.isd with=$ys.a1 with=$ys.a2 with=$ys.a0 with=$ys.w1 with=$ys.sw with=$ys.hw with=$ys.cx with=$ys.cy1 with=$ys.cy2 with=$ys.cy with=$ys.ri then=$ys.outd
@pie.slice.pie core.rule when=$ys.m when=$ys.v when=$ys.cum when=$ys.t when=$ys.p when=$ys.gb when=$ys.pd when=$ys.gp if=$ys.isp with=$ys.a1 with=$ys.a2 with=$ys.a0 with=$ys.w1 with=$ys.sw with=$ys.hw with=$ys.cx with=$ys.cy1 with=$ys.cy2 with=$ys.cy then=$ys.outp
# The arc: 13 points from the start to the end of the sweep (and back along the inner edge of a doughnut).
@yk.s ui.diagram.slice node=?c a0=?a0 sweep=?sw cx=?cx cy=?cy r=?r ri=?ri
@yk.k ui.diagram.arcstep k=?k
@yk.d1 core.calc out=?d1 fn=mul args=?sw args=?k
@yk.d2 core.calc out=?d2 fn=div args=?d1 args=12
@yk.d3 core.calc out=?d3 fn=add args=?a0 args=?d2
@yk.deg core.calc out=?deg fn=mod args=?d3 args=360
@yk.ang ui.diagram.angle deg=?deg
@yk.arc ui.diagram.sarc node=?c k=?k deg=?deg
@pie.arc.angle core.rule when=$yk.s when=$yk.k with=$yk.d1 with=$yk.d2 with=$yk.d3 with=$yk.deg then=$yk.ang
@pie.arc core.rule when=$yk.s when=$yk.k with=$yk.d1 with=$yk.d2 with=$yk.d3 with=$yk.deg then=$yk.arc
@yo.a ui.diagram.sarc node=?c k=?k deg=?deg
@yo.s ui.diagram.slice node=?c cx=?cx cy=?cy r=?r ri=?ri
@yo.t ui.diagram.trig deg=?deg s=?sn c=?co
@yo.ox1 core.calc out=?ox1 fn=mul args=?r args=?co
@yo.oy1 core.calc out=?oy1 fn=mul args=?r args=?sn
@yo.ox core.calc out=?ox fn=add args=?cx args=?ox1
@yo.oy core.calc out=?oy fn=add args=?cy args=?oy1
@yo.n core.calc out=?n fn=add args=?k args=2
@yo.op ui.diagram.point source=?c n=?n x=?ox y=?oy
@pie.point.outer core.rule when=$yo.a when=$yo.s when=$yo.t with=$yo.ox1 with=$yo.oy1 with=$yo.ox with=$yo.oy with=$yo.n then=$yo.op
@yo.inner core.check fn=gt args=?ri args=0
@yo.ix1 core.calc out=?ix1 fn=mul args=?ri args=?co
@yo.iy1 core.calc out=?iy1 fn=mul args=?ri args=?sn
@yo.ix core.calc out=?ix fn=add args=?cx args=?ix1
@yo.iy core.calc out=?iy fn=add args=?cy args=?iy1
@yo.in core.calc out=?in fn=sub args=40 args=?k
@yo.ip ui.diagram.point source=?c n=?in x=?ix y=?iy
@pie.point.inner core.rule when=$yo.a when=$yo.s when=$yo.t if=$yo.inner with=$yo.ix1 with=$yo.iy1 with=$yo.ix with=$yo.iy with=$yo.in then=$yo.ip
@yc.s ui.diagram.slice node=?c cx=?cx cy=?cy ri=0
@yc.p ui.diagram.point source=?c n=1 x=?cx y=?cy
@pie.point.centre core.rule when=$yc.s then=$yc.p
# The slice drawn, its colour, its box (round the middle of the slice), its label and value.
@yw.s ui.diagram.slice node=?c group=?g a0=?a0 sweep=?sw cx=?cx cy=?cy r=?r
@yw.d ui.diagram.draw part=?c source=?c slot=?c order=3 z=0 shape=polygon x=0 y=0 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left outline="#ffffff"
@pie.draw core.rule when=$yw.s then=$yw.d
@yw.own w.diagram.node code=?c colour=?col
@yw.rgb ui.diagram.rgb colour=?col rgb=?rgb
@yw.fo ui.diagram.fill source=?c part=?c fill=?rgb
@pie.fill.own core.rule when=$yw.s when=$yw.own when=$yw.rgb then=$yw.fo
@yw.th ui.diagram.ptheme name=?t
@yw.pal ui.diagram.spal name=?t
@pie.palette.theme core.rule when=$yw.th then=$yw.pal
@yw.k ui.diagram.const0 w=?anyw
@yw.anyt ui.diagram.ptheme name=?anyt
@yw.viv ui.diagram.spal name=vivid
@pie.palette.vivid core.rule when=$yw.k not=$yw.anyt then=$yw.viv
@yw.sp ui.diagram.spal name=?p
@yw.sw k.styles.swatch theme=?p n=?sn
@yw.cnt ui.diagram.scount name=?p n=?kc
@pie.palette.count core.aggregate over=$yw.sp over=$yw.sw by=?p count=?kc then=$yw.cnt
@rg.spos.type core.type of=ui.diagram.spos
@yw.i ui.diagram.inside group=?g node=?c order=?o
@yw.im ui.diagram.slicemember node=?c group=?g
@yw.rk core.rank of=$yw.i by=order within=?g out=?pos
@yw.so ui.diagram.spos node=?c pos=?pos
@pie.pos core.rule when=$yw.i when=$yw.im with=$yw.rk then=$yw.so
@yw.ps ui.diagram.spos node=?c pos=?pos
@yw.anyc w.diagram.node code=?c colour=?anyc
@yw.pc ui.diagram.scount name=?p n=?kc
@yw.p0 core.calc out=?p0 fn=sub args=?pos args=1
@yw.pm core.calc out=?pm fn=mod args=?p0 args=?kc
@yw.pj core.calc out=?pj fn=add args=?pm args=1
@yw.swc k.styles.swatch theme=?p n=?pj colour=?scol
@yw.fp ui.diagram.fill source=?c part=?c fill=?scol
@pie.fill.palette core.rule when=$yw.s when=$yw.ps when=$yw.sp when=$yw.pc not=$yw.anyc with=$yw.p0 with=$yw.pm with=$yw.pj when=$yw.swc then=$yw.fp
@yl.s ui.diagram.slice node=?c group=?g a0=?a0 sweep=?sw cx=?cx cy=?cy r=?r ri=?ri
@yl.h core.calc out=?h fn=div args=?sw args=2
@yl.m1 core.calc out=?m1 fn=add args=?a0 args=?h
@yl.m core.calc out=?mdeg fn=mod args=?m1 args=360
@yl.ang ui.diagram.angle deg=?mdeg
@pie.mid.angle core.rule when=$yl.s with=$yl.h with=$yl.m1 with=$yl.m then=$yl.ang
@yl.t ui.diagram.trig deg=?mdeg s=?sn c=?co
@yl.rv1 core.calc out=?rv1 fn=add args=?r args=?ri
@yl.rv core.calc out=?rv fn=div args=?rv1 args=2
@yl.vx1 core.calc out=?vx1 fn=mul args=?rv args=?co
@yl.vy1 core.calc out=?vy1 fn=mul args=?rv args=?sn
@yl.vx core.calc out=?vx fn=add args=?cx args=?vx1
@yl.vy core.calc out=?vy fn=add args=?cy args=?vy1
@yl.x0 core.calc out=?x0 fn=sub args=?vx args=12
@yl.x1 core.calc out=?x1 fn=add args=?vx args=12
@yl.y0 core.calc out=?y0 fn=sub args=?vy args=12
@yl.y1 core.calc out=?y1 fn=add args=?vy args=12
@yl.box ui.diagram.nbox node=?c x0=?x0 y0=?y0 x1=?x1 y1=?y1 cx=?vx cy=?vy w=24 h=24
@pie.nbox core.rule when=$yl.s with=$yl.h with=$yl.m1 with=$yl.m when=$yl.t with=$yl.rv1 with=$yl.rv with=$yl.vx1 with=$yl.vy1 with=$yl.vx with=$yl.vy with=$yl.x0 with=$yl.x1 with=$yl.y0 with=$yl.y1 then=$yl.box
@yl.v ui.diagram.vtext node=?c text=?v
@yl.fs ui.diagram.cfmt group=?g slot=font_size v=?fs
@yl.vy5 core.calc out=?vy5 fn=add args=?vy args=4
@yl.vsrc core.calc out=?vsrc fn=concat args=?c args=".value"
@yl.vd ui.diagram.draw part=?c source=?vsrc slot=?c order=4 z=0 shape=text text=?v x=?vx y=?vy5 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left anchor=middle font=?fs weight=bold
@yl.vf ui.diagram.fill source=?vsrc part=?c fill="#ffffff"
@yl.off w.diagram.group code=?g value_labels=false
@pie.value core.rule when=$yl.s when=$yl.fs not=$yl.off with=$yl.h with=$yl.m1 with=$yl.m when=$yl.t when=$yl.v with=$yl.rv1 with=$yl.rv with=$yl.vx1 with=$yl.vy1 with=$yl.vx with=$yl.vy with=$yl.vy5 with=$yl.vsrc then=$yl.vd
@pie.value.fill core.rule when=$yl.s not=$yl.off when=$yl.v with=$yl.vsrc then=$yl.vf
@yl.lb w.diagram.node code=?c label=?txt
@yl.rl core.calc out=?rl fn=add args=?r args=20
@yl.lx1 core.calc out=?lx1 fn=mul args=?rl args=?co
@yl.ly1 core.calc out=?ly1 fn=mul args=?rl args=?sn
@yl.lx core.calc out=?lx fn=add args=?cx args=?lx1
@yl.ly2 core.calc out=?ly2 fn=add args=?cy args=?ly1
@yl.ly core.calc out=?ly fn=add args=?ly2 args=4
@yl.lsrc core.calc out=?lsrc fn=concat args=?c args=".label"
@yl.ld ui.diagram.draw part=?c source=?lsrc slot=?c order=4 z=0 shape=text text=?txt x=?lx y=?ly w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left anchor=middle font=?fs
@yl.lc ui.diagram.pagecol key=label rgb=?lcol
@yl.lf ui.diagram.fill source=?lsrc part=?c fill=?lcol
@pie.label core.rule when=$yl.s when=$yl.fs with=$yl.h with=$yl.m1 with=$yl.m when=$yl.t when=$yl.lb with=$yl.rl with=$yl.lx1 with=$yl.ly1 with=$yl.lx with=$yl.ly2 with=$yl.ly with=$yl.lsrc then=$yl.ld
@pie.label.fill core.rule when=$yl.s when=$yl.lb when=$yl.lc with=$yl.lsrc then=$yl.lf

# ---- Chart formatting: gridlines, axis titles, an area under a line, a legend for slices ----
# Gridlines (gridlines=true): a light line across the plot at each quarter of its height.
@rg.quarter.type core.type of=ui.diagram.quarter
@rg.q.1 ui.diagram.quarter k=1
@rg.q.2 ui.diagram.quarter k=2
@rg.q.3 ui.diagram.quarter k=3
@rg.q.4 ui.diagram.quarter k=4
@yg.c ui.diagram.chart group=?g
@yg.on w.diagram.group code=?g gridlines=true
@yg.q ui.diagram.quarter k=?k
@yg.b ui.diagram.ubox unit=?g x0=?x y0=?y w=?w
@yg.p ui.diagram.gpad group=?g pad=?pad top=?top
@yg.x0 core.calc out=?x0 fn=add args=?x args=?pad
@yg.xr core.calc out=?xr fn=add args=?x args=?w
@yg.x1 core.calc out=?x1 fn=sub args=?xr args=?pad
@yg.b1 core.calc out=?b1 fn=add args=?y args=?top
@yg.geo ui.diagram.cgeo group=?g ph=?ph base=?bo
@yg.hz ui.diagram.chor group=?g
@yg.base core.calc out=?base fn=add args=?b1 args=?bo
@yg.dy1 core.calc out=?dy1 fn=mul args=?k args=?ph
@yg.dy core.calc out=?dy fn=div args=?dy1 args=4
@yg.dir ui.diagram.cdir group=?g iy=?iy
@yg.yy0 core.calc out=?yy0 fn=sub args=?base args=?dy
@yg.e1 core.calc out=?ge1 fn=mul args=?dy args=2
@yg.e2 core.calc out=?ge2 fn=sub args=?ge1 args=?ph
@yg.e3 core.calc out=?ge3 fn=mul args=?ge2 args=?iy
@yg.yy core.calc out=?yy fn=add args=?yy0 args=?ge3
@yg.src core.calc out=?src fn=concat args=?g args=".grid." args=?k
@yg.p1 ui.diagram.point source=?src n=1 x=?x0 y=?yy
@yg.p2 ui.diagram.point source=?src n=2 x=?x1 y=?yy
@yg.gs ui.diagram.cfmt group=?g slot=grid_style v=?gs
@yg.gd ui.diagram.gdash style=?gs dash=?gdash
@yg.solid core.check fn=eq args=?gs args=solid
@yg.d ui.diagram.draw part=?g source=?src slot=?g order=2 z=0 shape=line x=0 y=0 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left stroke=1 dash=?gdash
@yg.ds ui.diagram.draw part=?g source=?src slot=?g order=2 z=0 shape=line x=0 y=0 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left stroke=1
@yg.f ui.diagram.fill source=?src part=?g fill="#c3cbd5"
@chart.grid.p1 core.rule when=$yg.c when=$yg.on when=$yg.q when=$yg.b when=$yg.p when=$yg.geo not=$yg.hz with=$yg.x0 with=$yg.xr with=$yg.x1 with=$yg.b1 with=$yg.base when=$yg.dir with=$yg.dy1 with=$yg.dy with=$yg.yy0 with=$yg.e1 with=$yg.e2 with=$yg.e3 with=$yg.yy with=$yg.src then=$yg.p1
@chart.grid.p2 core.rule when=$yg.c when=$yg.on when=$yg.q when=$yg.b when=$yg.p when=$yg.geo not=$yg.hz with=$yg.x0 with=$yg.xr with=$yg.x1 with=$yg.b1 with=$yg.base when=$yg.dir with=$yg.dy1 with=$yg.dy with=$yg.yy0 with=$yg.e1 with=$yg.e2 with=$yg.e3 with=$yg.yy with=$yg.src then=$yg.p2
@chart.grid.draw core.rule when=$yg.c when=$yg.on when=$yg.q when=$yg.b when=$yg.p when=$yg.gs when=$yg.gd not=$yg.hz with=$yg.src then=$yg.d
@chart.grid.draw.solid core.rule when=$yg.c when=$yg.on when=$yg.q when=$yg.b when=$yg.p when=$yg.gs if=$yg.solid not=$yg.hz with=$yg.src then=$yg.ds
@chart.grid.fill core.rule when=$yg.c when=$yg.on when=$yg.q when=$yg.b when=$yg.p not=$yg.hz with=$yg.src then=$yg.f
# Axis titles: the y title at the right end of the title band, the x title under the category labels.
@ya.c ui.diagram.chart group=?g
@ya.b ui.diagram.ubox unit=?g x0=?x y0=?y w=?w
@ya.p ui.diagram.gpad group=?g pad=?pad top=?top
@ya.yl w.diagram.group code=?g y_label=?t
@ya.fs ui.diagram.cfmt group=?g slot=font_size v=?fs
@ya.fv core.calc out=?fv fn=sub args=?fs args=1
@ya.yx1 core.calc out=?yx1 fn=add args=?x args=?w
@ya.yx core.calc out=?yx fn=sub args=?yx1 args=?pad
@ya.yy core.calc out=?yy fn=add args=?y args=20
@ya.ys core.calc out=?ys fn=concat args=?g args=".ytitle"
@ya.yd ui.diagram.draw part=?g source=?ys slot=?g order=4 z=0 shape=text text=?t x=?yx y=?yy w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left font=?fv slant=italic anchor=end
@ya.yf ui.diagram.fill source=?ys part=?g fill="#52606d"
@chart.ytitle core.rule when=$ya.c when=$ya.b when=$ya.p when=$ya.yl when=$ya.fs with=$ya.fv with=$ya.yx1 with=$ya.yx with=$ya.yy with=$ya.ys then=$ya.yd
@chart.ytitle.fill core.rule when=$ya.c when=$ya.b when=$ya.p when=$ya.yl with=$ya.ys then=$ya.yf
@ya.xl w.diagram.group code=?g x_label=?t
@ya.hw core.calc out=?hw fn=div args=?w args=2
@ya.xx core.calc out=?xx fn=add args=?x args=?hw
@ya.xy1 core.calc out=?xy1 fn=add args=?y args=?top
@ya.ft ui.diagram.cfoot group=?g y=?fy
@ya.xy core.calc out=?xy fn=add args=?xy1 args=?fy
@ya.xs core.calc out=?xs fn=concat args=?g args=".xtitle"
@ya.xd ui.diagram.draw part=?g source=?xs slot=?g order=4 z=0 shape=text text=?t x=?xx y=?xy w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left font=?fv anchor=middle slant=italic
@ya.xf ui.diagram.fill source=?xs part=?g fill="#52606d"
@ya.xt ui.diagram.xtop group=?g
@ya.xyt core.calc out=?xy fn=sub args=?xy1 args=38
@chart.xtitle.top core.rule when=$ya.c when=$ya.b when=$ya.p when=$ya.xl when=$ya.fs when=$ya.xt with=$ya.fv with=$ya.hw with=$ya.xx with=$ya.xy1 with=$ya.xyt with=$ya.xs then=$ya.xd
@chart.xtitle.top.fill core.rule when=$ya.c when=$ya.b when=$ya.p when=$ya.xl when=$ya.xt with=$ya.xs then=$ya.xf
@chart.xtitle core.rule when=$ya.c when=$ya.b when=$ya.p when=$ya.xl when=$ya.fs when=$ya.ft not=$ya.xt with=$ya.fv with=$ya.hw with=$ya.xx with=$ya.xy1 with=$ya.xy with=$ya.xs then=$ya.xd
@chart.xtitle.fill core.rule when=$ya.c when=$ya.b when=$ya.p when=$ya.xl not=$ya.xt with=$ya.xs then=$ya.xf
# An area chart: the region between the line and the baseline, filled lightly.
@yz.g w.diagram.group code=?g layout=area
@yz.m ui.diagram.mpos node=?c group=?g pos=?p
@yz.b ui.diagram.nbox node=?c cx=?cx cy=?cy
@yz.gb ui.diagram.ubox unit=?g y0=?gy
@yz.gp ui.diagram.gpad group=?g top=?top
@yz.src core.calc out=?src fn=concat args=?g args=".area"
@yz.b1 core.calc out=?b1 fn=add args=?gy args=?top
@yz.dir ui.diagram.cdir group=?g iy=?iy
@yz.geo ui.diagram.cgeo group=?g ph=?ph base=?bo
@yz.b2 core.calc out=?b2 fn=add args=?b1 args=?bo
@yz.b3 core.calc out=?b3 fn=mul args=?iy args=?ph
@yz.base core.calc out=?base fn=sub args=?b2 args=?b3
@yz.nt core.calc out=?nt fn=add args=?p args=10
@yz.nb core.calc out=?nb fn=sub args=1000 args=?p
@yz.pt ui.diagram.point source=?src n=?nt x=?cx y=?cy
@yz.pb ui.diagram.point source=?src n=?nb x=?cx y=?base
@chart.area.top core.rule when=$yz.g when=$yz.m when=$yz.b with=$yz.src with=$yz.nt then=$yz.pt
@chart.area.bottom core.rule when=$yz.g when=$yz.m when=$yz.b when=$yz.gb when=$yz.gp when=$yz.dir when=$yz.geo with=$yz.src with=$yz.b1 with=$yz.b2 with=$yz.b3 with=$yz.base with=$yz.nb then=$yz.pb
@yz.d ui.diagram.draw part=?g source=?src slot=?g order=2 z=0 shape=polygon x=0 y=0 w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left opacity=0.3
@yz.f ui.diagram.fill source=?src part=?g fill="#1d6fe8"
@yz.gu ui.diagram.ubox unit=?g
@chart.area.draw core.rule when=$yz.g when=$yz.gu with=$yz.src then=$yz.d
@chart.area.fill core.rule when=$yz.g when=$yz.gu with=$yz.src then=$yz.f
# A legend of a pie or doughnut (legend=right or bottom): a swatch and the label of each slice, in order, under the
# disc (bottom) or in a column right of it (right); the group grows to hold it (the disc keeps its place).
@yy.p ui.diagram.pie group=?g r=?r
@yy.d2 core.calc out=?yd2 fn=mul args=?r args=2
@yy.rxo core.calc out=?rxo fn=add args=?yd2 args=152
@yy.byo core.calc out=?byo fn=add args=?yd2 args=82
@yy.lr w.diagram.group code=?g legend=right
@yy.lb w.diagram.group code=?g legend=bottom
@yy.s ui.diagram.slice node=?c group=?g
@yy.ps ui.diagram.spos node=?c pos=?pos
@yy.lab w.diagram.node code=?c label=?t
@yy.gb ui.diagram.ubox unit=?g x0=?gx y0=?gy
@yy.gp ui.diagram.gpad group=?g pad=?pad top=?top
@yy.f ui.diagram.fill source=?c part=?c fill=?col
@yy.p0 core.calc out=?p0 fn=sub args=?pos args=1
@yy.ry core.calc out=?ry1 fn=mul args=?p0 args=18
@yy.rx core.calc out=?rx fn=add args=?gx args=?rxo
@yy.ry2 core.calc out=?ry2 fn=add args=?gy args=?top
@yy.ry3 core.calc out=?ry3 fn=add args=?ry2 args=?ry1
@yy.ry4 core.calc out=?ry4 fn=add args=?ry3 args=12
@yy.bx1 core.calc out=?bx1 fn=mod args=?p0 args=3
@yy.bx2 core.calc out=?bx2 fn=mul args=?bx1 args=106
@yy.bx3 core.calc out=?bx3 fn=add args=?gx args=?pad
@yy.bx core.calc out=?bx fn=add args=?bx3 args=?bx2
@yy.by1 core.calc out=?by1 fn=idiv args=?p0 args=3
@yy.by2 core.calc out=?by2 fn=mul args=?by1 args=18
@yy.by3 core.calc out=?by3 fn=add args=?gy args=?top
@yy.by4 core.calc out=?by4 fn=add args=?by3 args=?byo
@yy.by core.calc out=?by fn=add args=?by4 args=?by2
@rg.legend.type core.type of=ui.diagram.legend
@yy.out.r ui.diagram.legend node=?c x=?rx y=?ry4 text=?t fill=?col
@yy.out.b ui.diagram.legend node=?c x=?bx y=?by text=?t fill=?col
@chart.legend.right core.rule when=$yy.p when=$yy.lr when=$yy.s when=$yy.ps when=$yy.lab when=$yy.gb when=$yy.gp when=$yy.f with=$yy.d2 with=$yy.rxo with=$yy.p0 with=$yy.ry with=$yy.rx with=$yy.ry2 with=$yy.ry3 with=$yy.ry4 then=$yy.out.r
@chart.legend.bottom core.rule when=$yy.p when=$yy.lb when=$yy.s when=$yy.ps when=$yy.lab when=$yy.gb when=$yy.gp when=$yy.f with=$yy.d2 with=$yy.byo with=$yy.p0 with=$yy.bx1 with=$yy.bx2 with=$yy.bx3 with=$yy.bx with=$yy.by1 with=$yy.by2 with=$yy.by3 with=$yy.by4 with=$yy.by then=$yy.out.b
@yv.l ui.diagram.legend node=?c x=?x y=?y text=?t fill=?col
@yv.sy core.calc out=?sy fn=sub args=?y args=10
@yv.tx core.calc out=?tx fn=add args=?x args=16
@yv.ss core.calc out=?ss fn=concat args=?c args=".key"
@yv.ts core.calc out=?ts fn=concat args=?c args=".keytext"
@yv.sd ui.diagram.draw part=?c source=?ss slot=?c order=4 z=0 shape=rectangle x=?x y=?sy w=11 h=11 cx=0 cy=0 tx=0 ty=0 scale=1 side=left round=2
@yv.sf ui.diagram.fill source=?ss part=?c fill=?col
@yv.td ui.diagram.draw part=?c source=?ts slot=?c order=4 z=0 shape=text text=?t x=?tx y=?y w=0 h=0 cx=0 cy=0 tx=0 ty=0 scale=1 side=left font=12
@yv.tc ui.diagram.pagecol key=label rgb=?lc
@yv.tf ui.diagram.fill source=?ts part=?c fill=?lc
@chart.legend.swatch core.rule when=$yv.l with=$yv.sy with=$yv.ss then=$yv.sd
@chart.legend.swatch.fill core.rule when=$yv.l with=$yv.ss then=$yv.sf
@chart.legend.text core.rule when=$yv.l with=$yv.tx with=$yv.ts then=$yv.td
@chart.legend.text.fill core.rule when=$yv.l when=$yv.tc with=$yv.ts then=$yv.tf
