@dg acts.schema
    noun="diagram"
    doc="The diagram editor as a schema (pilot P1 of spec 21): shapes, arrows and labels with colour, size and text. The engine of diagram-vss-demo (engine/, ops.mjs) stays as it is: it executes and lays out; the schema only says what is said."
    hooks=hooks.mjs
    own=create:diagram.create
    own=diagramUndo:diagram.undo
    own=diagramRedo:diagram.redo
    sample=circle
    dir=yes
    layout=yes
    rel=yes
    thingask=yes
    bare=yes
    reader=yes
    acts=make
    acts=remove
    acts=change
    acts=place
    acts=connect
    acts=group
    acts=pick
    acts=ask
    acts=copy
    acts=undo
    acts=redo
    acts=own
    limit.items=200
    limit.history=30

@dg.shape acts.kind
    plural=shapes
    named=yes
    word=circle
    word=circles
    word=square
    word=squares
    word=rectangle
    word=rectangles
    word=triangle
    word=triangles
    word=diamond
    word=diamonds
    word=ellipse
    word=ellipses
    word=oval
    word=hexagon
    word=hexagons
    word=star
    word=stars
    word=box
    word=boxes
    word=node
    word=nodes
    word=dot

@dg.arrow acts.kind
    plural=arrows
    word=line
    word=lines
    word=connection
    word=connections
    word=link
    word=links
    word=edge

@dg.text acts.kind
    plural=texts
    word=label
    word=labels
    word=caption
    word=note

@dg.colour acts.attr
    of=shape
    of=arrow
    of=text
    type=colour
    word=color
    word=fill

@dg.size acts.attr
    of=shape
    type=number
    min=1
    max=10
    default=3
    more=bigger
    more=larger
    less=smaller
    less=tinier
