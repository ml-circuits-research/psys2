@a.sm.i2 core.check fn=lte args=?mt args=?q
@act.splice.inside core.rule when=$a.sm.sp when=$a.sm.mk if=$a.sm.over if=$a.sm.before if=$a.sm.r1 if=$a.sm.i2 then=$a.sm.rm
@a.sm.e1 core.check fn=eq args=?mf args=?p
@act.splice.inside.start core.rule when=$a.sm.sp when=$a.sm.mk if=$a.sm.over if=$a.sm.before if=$a.sm.e1 if=$a.sm.l2 then=$a.sm.rm

# ---- Marks ----
# On: marks of the same form that touch the range and say the same (the same colour, the same link) join it into
# one; a highlight or link that says something else is cut back out of the range. Off: the range is cut out of the
# marks of that form; what lies outside it stays, with its colour or link.
@a.mr.r app.act.request operation=?op id=?id from=?f to=?t mark=?fm enabled=?en
@a.mr.op ui.doc.markop operation=?op
@a.mr.ok ui.doc.rangeok ok=true
@a.mr.bad app.act.refuse reason=invalid-text-range
@act.mark.range core.rule when=$a.mr.r when=$a.mr.op not=$a.mr.ok then=$a.mr.bad
@a.mr.ge core.check fn=gte args=?f args=?t
@act.mark.empty core.rule when=$a.mr.r when=$a.mr.op if=$a.mr.ge then=$a.mr.bad
@a.lk.h app.act.item param="attrs" key="href" value=?h
@a.lk.k core.check fn=matches args=?h args="^([hH][tT][tT][pP][sS]?:|[mM][aA][iI][lL][tT][oO]:|#)"
@a.lk.o ui.doc.linkok ok=true
@act.mark.link.ok core.rule when=$a.lk.h if=$a.lk.k then=$a.lk.o
@a.lk.r app.act.request mark=link enabled=true
@a.lk.out app.act.refuse reason=invalid-link
@act.mark.link.refused core.rule when=$a.mr.r when=$a.mr.op when=$a.lk.r not=$a.lk.o then=$a.lk.out
@a.hl.c app.act.item param="attrs" key="color" value=?c
@a.hl.k core.check fn=matches args=?c args="^#[0-9a-fA-F]{6}$"
@a.hl.o ui.doc.colourok ok=true
@act.mark.colour.ok core.rule when=$a.hl.c if=$a.hl.k then=$a.hl.o
@a.hl.r app.act.request mark=highlight enabled=true
@a.hl.out app.act.refuse reason=invalid-highlight
@act.mark.highlight.refused core.rule when=$a.mr.r when=$a.mr.op when=$a.hl.r not=$a.hl.o then=$a.hl.out
@a.ua.i app.act.item param="attrs" key=?k
@a.ua.n ui.doc.attrname name=?k
@a.ua.out app.act.refuse reason=unknown-mark-attribute
@act.mark.attribute.refused core.rule when=$a.mr.r when=$a.mr.op when=$a.ua.i not=$a.ua.n then=$a.ua.out

# What may join the new mark: same form, touching the range, saying the same.
@a.mj.r app.act.request operation=?op from=?f to=?t mark=?fm enabled=true
@a.mj.tg ui.doc.target box=?cid
@a.mj.mk ui.doc.mk mark=?m box=?cid from=?mf to=?mt form=?fm
@a.mj.t1 core.check fn=lte args=?mf args=?t
@a.mj.t2 core.check fn=gte args=?mt args=?f
@a.mj.o ui.doc.mergeable mark=?m from=?mf to=?mt
@a.mj.pl ui.doc.plainmark form=?fm
@act.mark.join.plain core.rule when=$a.mj.r when=$a.mr.op when=$a.mr.ok when=$a.mj.tg when=$a.mj.mk when=$a.mj.pl if=$a.mj.t1 if=$a.mj.t2 then=$a.mj.o
@a.mj.hm ui.doc.mk mark=$a.mj.hw box=?cid from=?mf to=?mt form=highlight
@a.mj.hw w.document.mark colour=?c
@a.mj.hr app.act.request mark=highlight
@a.mj.hc app.act.item param="attrs" key="color" value=?c
@a.mj.ho ui.doc.mergeable mark=$a.mj.hw from=?mf to=?mt
@act.mark.join.highlight core.rule when=$a.mj.r when=$a.mr.op when=$a.mr.ok when=$a.mj.tg when=$a.mj.hm when=$a.mj.hw when=$a.mj.hr when=$a.mj.hc if=$a.mj.t1 if=$a.mj.t2 then=$a.mj.ho
@a.mj.lm ui.doc.mk mark=$a.mj.lw box=?cid from=?mf to=?mt form=link
@a.mj.lw w.document.mark href=?h
@a.mj.lr app.act.request mark=link
@a.mj.lh app.act.item param="attrs" key="href" value=?h
@a.mj.lo ui.doc.mergeable mark=$a.mj.lw from=?mf to=?mt
@act.mark.join.link core.rule when=$a.mj.r when=$a.mr.op when=$a.mr.ok when=$a.mj.tg when=$a.mj.lm when=$a.mj.lw when=$a.mj.lr when=$a.mj.lh if=$a.mj.t1 if=$a.mj.t2 then=$a.mj.lo
# What is cut: marks of the form that overlap the range and do not join (off: all of them).
@a.mx.r app.act.request operation=?op from=?f to=?t mark=?fm
@a.mx.mk ui.doc.mk mark=?m box=?cid from=?mf to=?mt form=?fm
@a.mx.o1 core.check fn=lt args=?mf args=?t
@a.mx.o2 core.check fn=gt args=?mt args=?f
@a.mx.j ui.doc.mergeable mark=?m
@a.mx.on app.act.request enabled=true
@a.mx.off app.act.request enabled=false
@a.mx.o ui.doc.cutmark mark=?m from=?mf to=?mt
@act.mark.cut.on core.rule when=$a.mx.r when=$a.mr.op when=$a.mr.ok when=$a.mj.tg when=$a.mx.mk when=$a.mx.on not=$a.mx.j if=$a.mx.o1 if=$a.mx.o2 then=$a.mx.o
