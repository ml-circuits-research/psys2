@a.sm.over core.check fn=gt args=?mt args=?p
@a.sm.before core.check fn=lt args=?mf args=?q
@a.sm.f2 core.calc out=?nf fn=add args=?mf args=?dl
@a.sm.t2 core.calc out=?nt fn=add args=?mt args=?dl
@a.sm.after core.check fn=gte args=?mf args=?q
@a.sm.cf app.act.call act=change thing=?m attr=from value=?nf order=2
@a.sm.ct app.act.call act=change thing=?m attr=to value=?nt order=3
