@act.splice.cover core.rule when=$a.sm.sp when=$a.sm.mk if=$a.sm.over if=$a.sm.before if=$a.sm.c1 if=$a.sm.c2 with=$a.sm.t2 if=$a.sm.grow then=$a.sm.ct
@act.splice.cover.gone core.rule when=$a.sm.sp when=$a.sm.mk if=$a.sm.over if=$a.sm.before if=$a.sm.c1 if=$a.sm.c2 with=$a.sm.t2 if=$a.sm.gone then=$a.sm.rm
