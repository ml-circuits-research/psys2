@a.mv.off ui.doc.goffset head=?h n=?o
@a.mv.pc ui.doc.count of=prefix n=?p
@a.mv.a core.calc out=?a fn=add args=?p args=?o
@a.mv.n core.calc out=?nn fn=add args=?a args=?r
@a.mv.bw w.document.block code=?c
@a.mv.c app.act.call act=change thing=$a.mv.bw attr=n value=?nn order=1
@act.group.place core.rule when=$a.so.r when=$a.mv.i with=$a.mv.r when=$a.mv.off when=$a.mv.pc with=$a.mv.a with=$a.mv.n when=$a.mv.bw then=$a.mv.c

# ---- What a reader observes ----
# The document: its title, genre, topic and length in words.
@a.ob.d w.document.document code=?d title=?t
@a.ob.do app.observe.object id=?d kind=document sourceType=docs.editor.document binding=document title=?t
@act.observe.document core.rule when=$a.ob.d then=$a.ob.do
@a.ob.g w.document.document code=?d genre=?g
@a.ob.go app.observe.input id=?d key=genre value=?g
@act.observe.genre core.rule when=$a.ob.g then=$a.ob.go
@a.ob.p w.document.document code=?d topic=?g
@a.ob.po app.observe.input id=?d key=topic value=?g
@act.observe.topic core.rule when=$a.ob.p then=$a.ob.po
@a.ob.w ui.doc.words n=?n
@a.ob.wt ui.doc.total n=?s
@act.observe.words.sum core.aggregate over=$a.ob.w sum=?s args=?n then=$a.ob.wt
@a.ob.wd w.document.document code=?d
@a.ob.wi ui.doc.total n=?s
@a.ob.wo app.observe.input id=?d key=length value=?s
@act.observe.length core.rule when=$a.ob.wd when=$a.ob.wi then=$a.ob.wo
@a.ob.opt.d app.observe.option id=document value=?d
@act.observe.option.document core.rule when=$a.ob.wd then=$a.ob.opt.d

# Blocks: a section (a heading of level 1 or 2) or the block's form, where it lies (its section, the chapter of a
# section, or the document), its place, alignment and whether it is selected; its text, name, level, style, header.
@a.ob.b w.document.block code=?c form=?f align=?al
@a.ob.ix ui.doc.index code=?c index=?i
@a.ob.hd ui.doc.head code=?c
@a.ob.par ui.doc.parent block=?c parent=?p
@a.ob.dc w.document.document code=?d
@a.ob.sel app.area.view key=selected value=?c
@a.ob.bo.s.p app.observe.object id=?c kind=section sourceType=docs.editor.section binding=document.block in=?p role=member index=?i align=?al form=?f selected=true
@a.ob.bo.s.n app.observe.object id=?c kind=section sourceType=docs.editor.section binding=document.block in=?p role=member index=?i align=?al form=?f selected=false
@a.ob.bo.s.dp app.observe.object id=?c kind=section sourceType=docs.editor.section binding=document.block in=?d role=member index=?i align=?al form=?f selected=true
@a.ob.bo.s.dn app.observe.object id=?c kind=section sourceType=docs.editor.section binding=document.block in=?d role=member index=?i align=?al form=?f selected=false
@a.ob.bo.b.p app.observe.object id=?c kind=?f sourceType=docs.editor.block binding=document.block in=?p role=member index=?i align=?al form=?f selected=true
@a.ob.bo.b.n app.observe.object id=?c kind=?f sourceType=docs.editor.block binding=document.block in=?p role=member index=?i align=?al form=?f selected=false
@a.ob.bo.b.dp app.observe.object id=?c kind=?f sourceType=docs.editor.block binding=document.block in=?d role=member index=?i align=?al form=?f selected=true
@a.ob.bo.b.dn app.observe.object id=?c kind=?f sourceType=docs.editor.block binding=document.block in=?d role=member index=?i align=?al form=?f selected=false
@act.observe.section.in.sel core.rule when=$a.ob.b when=$a.ob.ix when=$a.ob.hd when=$a.ob.par when=$a.ob.sel then=$a.ob.bo.s.p
@act.observe.section.in core.rule when=$a.ob.b when=$a.ob.ix when=$a.ob.hd when=$a.ob.par not=$a.ob.sel then=$a.ob.bo.s.n
@act.observe.section.top.sel core.rule when=$a.ob.b when=$a.ob.ix when=$a.ob.hd when=$a.ob.dc not=$a.ob.par when=$a.ob.sel then=$a.ob.bo.s.dp
@act.observe.section.top core.rule when=$a.ob.b when=$a.ob.ix when=$a.ob.hd when=$a.ob.dc not=$a.ob.par not=$a.ob.sel then=$a.ob.bo.s.dn
@act.observe.block.in.sel core.rule when=$a.ob.b when=$a.ob.ix not=$a.ob.hd when=$a.ob.par when=$a.ob.sel then=$a.ob.bo.b.p
@act.observe.block.in core.rule when=$a.ob.b when=$a.ob.ix not=$a.ob.hd when=$a.ob.par not=$a.ob.sel then=$a.ob.bo.b.n
@act.observe.block.top.sel core.rule when=$a.ob.b when=$a.ob.ix not=$a.ob.hd when=$a.ob.dc not=$a.ob.par when=$a.ob.sel then=$a.ob.bo.b.dp
@act.observe.block.top core.rule when=$a.ob.b when=$a.ob.ix not=$a.ob.hd when=$a.ob.dc not=$a.ob.par not=$a.ob.sel then=$a.ob.bo.b.dn
@a.oi.text w.document.block code=?c text=?v
@a.oi.text.tx ui.doc.textual code=?c
@a.oi.text.o app.observe.input id=?c key=text value=?v
@act.observe.block.text core.rule when=$a.oi.text when=$a.oi.text.tx then=$a.oi.text.o
@a.oi.name w.document.block code=?c name=?v
@a.oi.name.o app.observe.input id=?c key=name value=?v
@act.observe.block.name core.rule when=$a.oi.name then=$a.oi.name.o
@a.oi.level ui.doc.level code=?c level=?v
@a.oi.level.o app.observe.input id=?c key=level value=?v
@act.observe.block.level core.rule when=$a.oi.level then=$a.oi.level.o
@a.oi.style w.document.block code=?c form=list style=?v
@a.oi.style.o app.observe.input id=?c key=style value=?v
@act.observe.block.style core.rule when=$a.oi.style then=$a.oi.style.o
@a.oi.header w.document.block code=?c form=table header=?v
@a.oi.header.o app.observe.input id=?c key=header value=?v
@act.observe.block.header core.rule when=$a.oi.header then=$a.oi.header.o
@a.oi.par.b w.document.block code=?c
@a.oi.par.d w.document.document code=?d
@a.oi.par.o app.observe.input id=?c key=parent value=?d
@act.observe.block.parent core.rule when=$a.oi.par.b when=$a.oi.par.d then=$a.oi.par.o
@a.oi.rs app.area.view key=selected value=?c
@a.oi.rf app.area.view key=from value=?f
@a.oi.rt app.area.view key=to value=?t
@a.oi.ra app.area.view key=at value=?a
@a.oi.rb w.document.block code=?c
@a.oi.rf.o app.observe.input id=?c key=selectionFrom value=?fn
@a.oi.rt.o app.observe.input id=?c key=selectionTo value=?tn
@a.oi.ra.o app.observe.input id=?c key=selectionAt value=?a
@a.oi.rf.n core.calc out=?fn fn=matches args=?f args="^\\d+$"
@a.oi.rt.n core.calc out=?tn fn=matches args=?t args="^\\d+$"
@act.observe.block.range core.rule when=$a.oi.rs when=$a.oi.rb when=$a.oi.rf when=$a.oi.rt when=$a.oi.ra with=$a.oi.rf.n with=$a.oi.rt.n then=$a.oi.rf.o then=$a.oi.rt.o then=$a.oi.ra.o
@a.ob.opt.b w.document.block code=?c
@a.ob.opt.bo app.observe.option id=block value=?c
@act.observe.option.block core.rule when=$a.ob.opt.b then=$a.ob.opt.bo

# Text containers: a block's own text, each list item and each table cell, under their block.
@a.oc.bx ui.doc.box id=?cid block=?c at=?at text=?t kind=?k
@a.oc.nt core.check fn=neq args=?k args=title
@a.oc.o app.observe.object id=?cid kind=?k sourceType=docs.editor.text binding=document.text in=?c role=?k text=?t at=?at parent=?c
@act.observe.container core.rule when=$a.oc.bx if=$a.oc.nt then=$a.oc.o
@a.oc.n.bx ui.doc.box id=?cid block=?c at=?at kind=?k
@a.oc.n.b w.document.block code=?c form=?f
@a.oc.n.nm core.calc out=?nm fn=concat args=?f args=" " args=?at
@a.oc.n.o app.observe.input id=?cid key=name value=?nm
@act.observe.container.name core.rule when=$a.oc.n.bx when=$a.oc.n.b if=$a.oc.nt with=$a.oc.n.nm then=$a.oc.n.o
@a.oc.ck.bx ui.doc.box id=?cid thing=$a.oc.ck.i kind=item
@a.oc.ck.i w.document.item checked=?v
@a.oc.ck.o app.observe.input id=?cid key=checked value=?v
@act.observe.item.checked core.rule when=$a.oc.ck.bx when=$a.oc.ck.i then=$a.oc.ck.o
@a.oc.rc.bx ui.doc.box id=?cid kind=cell row=?r col=?k
@a.oc.rc.r app.observe.input id=?cid key=row value=?r
@a.oc.rc.c app.observe.input id=?cid key=column value=?k
@act.observe.cell.place core.rule when=$a.oc.rc.bx then=$a.oc.rc.r then=$a.oc.rc.c

# Marks, under their block: form, the characters they cover, the text they are in (at), a link's href, a colour.
@a.om.mk ui.doc.mk mark=$a.om.w box=?cid from=?f to=?t form=?fm
@a.om.w w.document.mark
@a.om.bx ui.doc.box id=?cid block=?c at=?at
@a.om.id core.calc out=?id fn=concat args=?cid args="|" args=?fm args="|" args=?f
@a.om.o app.observe.object id=?id kind=mark sourceType=docs.editor.mark binding=document.mark in=?c role=mark form=?fm from=?f to=?t at=?at
@act.observe.mark core.rule when=$a.om.mk when=$a.om.w when=$a.om.bx with=$a.om.id then=$a.om.o
@a.om.h.mk ui.doc.mk mark=$a.om.h.w box=?cid from=?f form=?fm
@a.om.h.w w.document.mark href=?v
@a.om.h.o app.observe.input id=?id key=href value=?v
@act.observe.mark.href core.rule when=$a.om.h.mk when=$a.om.h.w with=$a.om.id then=$a.om.h.o
@a.om.c.mk ui.doc.mk mark=$a.om.c.w box=?cid from=?f form=?fm
@a.om.c.w w.document.mark colour=?v
@a.om.c.o app.observe.input id=?id key=colour value=?v
@act.observe.mark.colour core.rule when=$a.om.c.mk when=$a.om.c.w with=$a.om.id then=$a.om.c.o

# The choices the inspector offers.
@opt.align.left app.observe.option id=align value=left
@opt.align.center app.observe.option id=align value=center
@opt.align.right app.observe.option id=align value=right
@opt.align.justify app.observe.option id=align value=justify
@opt.kind.paragraph app.observe.option id=kind value=paragraph
@opt.kind.heading app.observe.option id=kind value=heading
@opt.kind.quote app.observe.option id=kind value=quote
@opt.mark.bold app.observe.option id=mark value=bold
@opt.mark.italic app.observe.option id=mark value=italic
@opt.mark.underline app.observe.option id=mark value=underline
@opt.mark.strike app.observe.option id=mark value=strike
@opt.mark.code app.observe.option id=mark value=code
@opt.mark.highlight app.observe.option id=mark value=highlight
