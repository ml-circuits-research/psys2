@a.sz.kb core.calc out=?kb fn=concat args=?cid args="|new"
@a.sz.la ui.doc.len key=?ka n=?la
@a.sz.lb ui.doc.len key=?kb n=?lb
@a.sz.q core.calc out=?q fn=sub args=?la args=?s
@a.sz.e core.calc out=?e fn=sub args=?lb args=?s
@a.sz.dl core.calc out=?dl fn=sub args=?lb args=?la
@a.sz.o ui.doc.splice box=?cid from=?p to=?q ins=?e delta=?dl
@act.splice core.rule when=$a.sz.p when=$a.sz.s with=$a.sz.ka with=$a.sz.kb when=$a.sz.la when=$a.sz.lb with=$a.sz.q with=$a.sz.e with=$a.sz.dl then=$a.sz.o
@a.sm.sp ui.doc.splice box=?cid from=?p to=?q ins=?e delta=?dl
