# docs.editor act rules (authored). Each native Documents command compiles to std.acts calls on the w.document
# instance (worlds/sop-world-host.mjs only runs them) or to an explicit refusal. Blocks are addressed by their code
# (b1, b2 ...), the document by its code (text1), a text container by its native id ["b1","0"]. Removing a block
# removes its items, cells and marks (std.acts removes what refers to a thing); removing the document removes all.
# Composing and rewriting free text are refused: this area has no composer and no rewriter (no language model runs
# here), and no declared deterministic transform does what they ask. Undo and redo belong to the application's
# journal; observing reads the derived objects; neither compiles to a call.
@act.t.bnum core.type of=ui.doc.bnum
@act.t.dnum core.type of=ui.doc.dnum
@act.t.next core.type of=ui.doc.next
@act.t.reqat core.type of=ui.doc.reqat
@act.t.target core.type of=ui.doc.target
@act.t.rangeok core.type of=ui.doc.rangeok
@act.t.selop core.type of=ui.doc.selop
@act.t.markop core.type of=ui.doc.markop
@act.t.alignop core.type of=ui.doc.alignop
@act.t.changeop core.type of=ui.doc.changeop
@act.t.plainmark core.type of=ui.doc.plainmark
@act.t.attrname core.type of=ui.doc.attrname
@act.t.blockkey core.type of=ui.doc.blockkey
@act.t.linkok core.type of=ui.doc.linkok
@act.t.colourok core.type of=ui.doc.colourok
@act.t.mergeable core.type of=ui.doc.mergeable
@act.t.span core.type of=ui.doc.span
@act.t.union core.type of=ui.doc.union
@act.t.cutmark core.type of=ui.doc.cutmark
@act.t.retext core.type of=ui.doc.retext
@act.t.prefix core.type of=ui.doc.prefix
@act.t.suffix core.type of=ui.doc.suffix
@act.t.splice core.type of=ui.doc.splice
@act.t.count core.type of=ui.doc.count
@act.t.cutblock core.type of=ui.doc.cutblock
@act.t.stopper core.type of=ui.doc.stopper
@act.t.stop core.type of=ui.doc.stop
@act.t.gmember core.type of=ui.doc.gmember
@act.t.gsize core.type of=ui.doc.gsize
@act.t.gpos core.type of=ui.doc.gpos
@act.t.gpair core.type of=ui.doc.gpair
@act.t.goffset core.type of=ui.doc.goffset
@act.t.known core.type of=ui.doc.known
@act.t.okkind core.type of=ui.doc.okkind
@act.t.oklevel core.type of=ui.doc.oklevel
@act.t.prefixblock core.type of=ui.doc.prefixblock
@act.t.newitem core.type of=ui.doc.newitem
@act.t.newcell core.type of=ui.doc.newcell
@act.t.rowlen core.type of=ui.doc.rowlen
@act.t.clamp core.type of=ui.doc.clamp
@act.t.total core.type of=ui.doc.total
@act.t.made core.type of=ui.doc.made
@act.t.bad core.type of=ui.doc.bad

# ---- Numbers ----
# The next block code (b<k>), the next document code (text<k>) and the last place in the document's order.
@a.nb.b w.document.block code=?c
@a.nb.z core.calc out=?z fn=matches args=?c args="^b(\\d+)$" args=1
@a.nb.o ui.doc.bnum z=?z
@act.block.number core.rule when=$a.nb.b with=$a.nb.z then=$a.nb.o
@a.nb.i ui.doc.bnum z=?z
@a.nb.out ui.doc.next of=block top=?top
@act.next.block core.aggregate over=$a.nb.i max=?top args=?z default=0 then=$a.nb.out
@a.nd.d w.document.document code=?c
@a.nd.z core.calc out=?z fn=matches args=?c args="^text(\\d+)$" args=1
@a.nd.o ui.doc.dnum z=?z
@act.document.number core.rule when=$a.nd.d with=$a.nd.z then=$a.nd.o
@a.nd.i ui.doc.dnum z=?z
@a.nd.out ui.doc.next of=document top=?top
@act.next.document core.aggregate over=$a.nd.i max=?top args=?z default=0 then=$a.nd.out
@a.nn.b w.document.block n=?n
@a.nn.out ui.doc.next of=place top=?top
@act.next.place core.aggregate over=$a.nn.b max=?top args=?n default=0 then=$a.nn.out

# Names of the commands that share rules.
@selop.block ui.doc.selop operation="document.block.select"
@selop.section ui.doc.selop operation="document.section.select"
@markop.block ui.doc.markop operation="document.block.mark"
@markop.section ui.doc.markop operation="document.section.mark"
@alignop.block ui.doc.alignop operation="document.block.align"
@alignop.section ui.doc.alignop operation="document.section.align"
@changeop.block ui.doc.changeop operation="document.block.change"
@changeop.section ui.doc.changeop operation="document.section.change"
@plain.bold ui.doc.plainmark form=bold
@plain.italic ui.doc.plainmark form=italic
@plain.underline ui.doc.plainmark form=underline
@plain.strike ui.doc.plainmark form=strike
@plain.code ui.doc.plainmark form=code
@attr.href ui.doc.attrname name="href"
@attr.color ui.doc.attrname name="color"
@bkey.kind ui.doc.blockkey name="kind"
@bkey.text ui.doc.blockkey name="text"
@bkey.level ui.doc.blockkey name="level"
@bkey.from ui.doc.blockkey name="from"

# ---- The text a command names: a block's code and `at` ("0", an item's index, "row:column") ----
# A request's text values are quoted, derived ones are bare: `at` is read through concat, which also makes "0" a number.
@a.ra.r app.act.request at=?at
@a.ra.n core.calc out=?an fn=concat args=?at
@a.ra.o ui.doc.reqat at=?an
@act.at core.rule when=$a.ra.r with=$a.ra.n then=$a.ra.o
@a.tg.r app.act.request id=?id
@a.tg.a ui.doc.reqat at=?at
@a.tg.bx ui.doc.box id=?cid block=?id at=?at text=?txt thing=?w kind=?k
@a.tg.o ui.doc.target box=?cid text=?txt thing=?w kind=?k
@act.target core.rule when=$a.tg.r when=$a.tg.a when=$a.tg.bx then=$a.tg.o
# A range is good when from <= to and the text has `to` characters.
@a.rk.r app.act.request from=?f to=?t
@a.rk.tg ui.doc.target text=?txt
@a.rk.le core.check fn=lte args=?f args=?t
@a.rk.pat core.calc out=?pat fn=concat args="^[\\s\\S]{" args=?t args="}"
@a.rk.fit core.check fn=matches args=?txt args=?pat
@a.rk.o ui.doc.rangeok ok=true
@act.range.ok core.rule when=$a.rk.r when=$a.rk.tg if=$a.rk.le with=$a.rk.pat if=$a.rk.fit then=$a.rk.o

# ---- Title ----
@a.tc.r app.act.request operation="document.title.change" id=?id title=?t
@a.tc.d w.document.document code=?id
@a.tc.c app.act.call act=change thing=$a.tc.d attr=title value=?t order=1
@act.title.change core.rule when=$a.tc.r when=$a.tc.d then=$a.tc.c
@a.tc.miss app.act.refuse reason=missing-document
@act.title.missing core.rule when=$a.tc.r not=$a.tc.d then=$a.tc.miss

# ---- Selection: the view's selected block, and a range of its text when to > from ----
# A block selection (from = to = 0) is taken for any block, also one without a text at `at` (a table).
@a.sl.r app.act.request operation=?op id=?id from=?f to=?t at=?at
@a.sl.op ui.doc.selop operation=?op
@a.sl.b w.document.block code=?id
@a.sl.ok ui.doc.rangeok ok=true
@a.sl.v app.act.view key=selected value=?id
@a.sl.gt core.check fn=gt args=?t args=?f
@a.sl.eq core.check fn=eq args=?t args=?f
@a.sl.vf app.act.view key=from value=?f
@a.sl.vt app.act.view key=to value=?t
@a.sl.va app.act.view key=at value=?at
@a.sl.cf app.act.view key=from
@a.sl.ct app.act.view key=to
@a.sl.ca app.act.view key=at
@act.select.range core.rule when=$a.sl.r when=$a.sl.op when=$a.sl.ok if=$a.sl.gt then=$a.sl.v then=$a.sl.vf then=$a.sl.vt then=$a.sl.va
@act.select.point core.rule when=$a.sl.r when=$a.sl.op when=$a.sl.ok if=$a.sl.eq then=$a.sl.v then=$a.sl.cf then=$a.sl.ct then=$a.sl.ca
@a.sl.z1 core.check fn=eq args=?f args=0
@a.sl.z2 core.check fn=eq args=?t args=0
@act.select.block core.rule when=$a.sl.r when=$a.sl.op when=$a.sl.b not=$a.sl.ok if=$a.sl.z1 if=$a.sl.z2 then=$a.sl.v then=$a.sl.cf then=$a.sl.ct then=$a.sl.ca
@a.sl.bad.r app.act.request operation=?op from=?f to=?t
@a.sl.bad app.act.refuse reason=invalid-text-range
@a.sl.nz core.check fn=gt args=?t args=0
@act.select.refused core.rule when=$a.sl.bad.r when=$a.sl.op not=$a.sl.ok if=$a.sl.nz then=$a.sl.bad
@a.sl.nb.r app.act.request operation=?op id=?id
@act.select.missing core.rule when=$a.sl.nb.r when=$a.sl.op not=$a.sl.b then=$a.sl.bad

# ---- Alignment ----
@a.al.r app.act.request operation=?op id=?id align=?al
@a.al.op ui.doc.alignop operation=?op
@a.al.b w.document.block code=?id
@a.al.c app.act.call act=change thing=$a.al.b attr=align value=?al order=1
@act.align core.rule when=$a.al.r when=$a.al.op when=$a.al.b then=$a.al.c
@a.al.miss app.act.refuse reason=missing-target
@act.align.missing core.rule when=$a.al.r when=$a.al.op not=$a.al.b then=$a.al.miss

# ---- Changing a block (or a section's heading): text, name, kind, level, alignment ----
@a.bc.r app.act.request operation=?op id=?id
@a.bc.op ui.doc.changeop operation=?op
@a.bc.b w.document.block code=?id form=?f
@a.bc.miss app.act.refuse reason=missing-target
@act.change.missing core.rule when=$a.bc.r when=$a.bc.op not=$a.bc.b then=$a.bc.miss
@a.bc.tx ui.doc.textual code=?id
@a.bc.np app.act.refuse reason=not-a-plain-text-block
@a.bc.rt app.act.request text=?anyt
@a.bc.rk app.act.request kind=?anyk
@a.bc.rl app.act.request level=?anyl
@act.change.text.not.plain core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.rt not=$a.bc.tx then=$a.bc.np
@act.change.kind.not.plain core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.rk not=$a.bc.tx then=$a.bc.np
@act.change.level.not.plain core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.rl not=$a.bc.tx then=$a.bc.np
@a.bc.lv.r app.act.request level=?l kind=?k
@a.bc.lv.k core.check fn=neq args=?k args=heading
@a.bc.lv.out app.act.refuse reason=unexpected-heading-level
@act.change.level.kind core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.lv.r if=$a.bc.lv.k then=$a.bc.lv.out
@a.bc.lf.r app.act.request level=?l
@a.bc.lf.k core.check fn=neq args=?f args=heading
@act.change.level.form core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.lf.r not=$a.bc.rk if=$a.bc.lf.k then=$a.bc.lv.out
@a.bc.name.r app.act.request name=?v
@a.bc.name.c app.act.call act=change thing=$a.bc.b attr=name value=?v order=1
@act.change.name core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.name.r then=$a.bc.name.c
@a.bc.align.r app.act.request align=?v
@a.bc.align.c app.act.call act=change thing=$a.bc.b attr=align value=?v order=1
@act.change.align core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.align.r then=$a.bc.align.c
@a.bc.kind.r app.act.request kind=?v
@a.bc.kind.c app.act.call act=change thing=$a.bc.b attr=form value=?v order=1
@act.change.kind core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.kind.r when=$a.bc.tx then=$a.bc.kind.c
@a.bc.level.r app.act.request level=?v
@a.bc.level.c app.act.call act=change thing=$a.bc.b attr=level value=?v order=1
@act.change.level core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.level.r when=$a.bc.tx then=$a.bc.level.c
# A block that becomes a heading with no level given is a section (level 2), as a new heading of the editor is.
@a.bc.h2.r app.act.request kind=heading
@a.bc.h2.k core.check fn=neq args=?f args=heading
@a.bc.h2.c app.act.call act=change thing=$a.bc.b attr=level value=2 order=1
@act.change.heading.level core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.h2.r when=$a.bc.tx not=$a.bc.rl if=$a.bc.h2.k then=$a.bc.h2.c
@a.bc.text.r app.act.request text=?v
@a.bc.text.bx ui.doc.box id=?cid block=?id text=?old thing=?w kind=text
@a.bc.text.ne core.check fn=neq args=?old args=?v
@a.bc.text.c app.act.call act=change thing=$a.bc.b attr=text value=?v order=1
@a.bc.text.rt ui.doc.retext box=?cid old=?old new=?v
@act.change.text core.rule when=$a.bc.r when=$a.bc.op when=$a.bc.b when=$a.bc.text.r when=$a.bc.text.bx if=$a.bc.text.ne then=$a.bc.text.c then=$a.bc.text.rt

# ---- Changing the text of one container (a block's text, an item, a cell) by its native id ----
@a.cc.r app.act.request operation="document.container.change" id=?rid text=?v
@a.cc.id core.calc out=?cid fn=concat args=?rid
@a.cc.bx ui.doc.box id=?cid text=?old thing=?w kind=?k
@a.cc.nt core.check fn=neq args=?k args=title
@a.cc.ne core.check fn=neq args=?old args=?v
@a.cc.c app.act.call act=change thing=?w attr=text value=?v order=1
@a.cc.rt ui.doc.retext box=?cid old=?old new=?v
@act.container.change core.rule when=$a.cc.r with=$a.cc.id when=$a.cc.bx if=$a.cc.nt if=$a.cc.ne then=$a.cc.c then=$a.cc.rt
@a.cc.ok.bx ui.doc.box id=?cid kind=?k
@a.cc.miss app.act.refuse reason=missing-text-container
@act.container.missing core.rule when=$a.cc.r with=$a.cc.id not=$a.cc.ok.bx then=$a.cc.miss
@a.cc.ti.bx ui.doc.box id=?cid kind=title
@act.container.title core.rule when=$a.cc.r with=$a.cc.id when=$a.cc.ti.bx then=$a.cc.miss

# ---- Marks move with a changed text ----
# The old and new texts share a prefix of p and a suffix of s characters: the part [p, La - s) of the old text was
# replaced by [p, Lb - s) of the new one. A mark before it stays; after it moves by Lb - La; one that covers it grows
# or shrinks; one that overlaps it is cut at its edge; one inside it goes. Only a container with marks is measured.
# Both are found digit by digit, one stage per place, as the lengths are.
@a.sp.i ui.doc.retext box=?cid old=?a new=?b
@a.sp.hm ui.doc.hasmarks box=?cid
@a.sp.ps ui.doc.ps10000 box=?cid a=?a b=?b base=0
@a.sp.ka core.calc out=?ka fn=concat args=?cid args="|old"
@a.sp.kb core.calc out=?kb fn=concat args=?cid args="|new"
@a.sp.la ui.doc.lenof key=?ka text=?a top=10000
@a.sp.lb ui.doc.lenof key=?kb text=?b top=10000
@act.splice.start core.rule when=$a.sp.i when=$a.sp.hm with=$a.sp.ka with=$a.sp.kb then=$a.sp.ps then=$a.sp.la then=$a.sp.lb
@act.t.ps10000 core.type of=ui.doc.ps10000
@act.t.pk10000 core.type of=ui.doc.pk10000
@act.t.pb10000 core.type of=ui.doc.pb10000
@a.pc10000.s ui.doc.ps10000 box=?cid a=?a b=?b base=?base
@a.pc10000.d ui.doc.digit d=?d
@a.pc10000.m core.calc out=?m fn=mul args=?d args=10000
@a.pc10000.c core.calc out=?c fn=add args=?base args=?m
@a.pc10000.pat core.calc out=?pat fn=concat args="^([\\s\\S]{" args=?c args="})"
@a.pc10000.pa core.calc out=?pa fn=matches args=?a args=?pat args=1
@a.pc10000.pb core.calc out=?pb fn=matches args=?b args=?pat args=1
@a.pc10000.eq core.check fn=eq args=?pa args=?pb
@a.pc10000.o ui.doc.pk10000 box=?cid d=?d
@act.prefix.candidate.10000 core.rule when=$a.pc10000.s when=$a.pc10000.d with=$a.pc10000.m with=$a.pc10000.c with=$a.pc10000.pat with=$a.pc10000.pa with=$a.pc10000.pb if=$a.pc10000.eq then=$a.pc10000.o
@a.pb10000.i ui.doc.pk10000 box=?cid d=?d
@a.pb10000.o ui.doc.pb10000 box=?cid d=?m
@act.prefix.best.10000 core.aggregate over=$a.pb10000.i by=?cid max=?m args=?d then=$a.pb10000.o
@a.pn10000.s ui.doc.ps10000 box=?cid a=?a b=?b base=?base
@a.pn10000.b ui.doc.pb10000 box=?cid d=?d
@a.pn10000.m core.calc out=?m fn=mul args=?d args=10000
@a.pn10000.c core.calc out=?c fn=add args=?base args=?m
@a.pn10000.o ui.doc.ps1000 box=?cid a=?a b=?b base=?c
@act.prefix.next.10000 core.rule when=$a.pn10000.s when=$a.pn10000.b with=$a.pn10000.m with=$a.pn10000.c then=$a.pn10000.o
@act.t.ps1000 core.type of=ui.doc.ps1000
@act.t.pk1000 core.type of=ui.doc.pk1000
@act.t.pb1000 core.type of=ui.doc.pb1000
@a.pc1000.s ui.doc.ps1000 box=?cid a=?a b=?b base=?base
@a.pc1000.d ui.doc.digit d=?d
@a.pc1000.m core.calc out=?m fn=mul args=?d args=1000
@a.pc1000.c core.calc out=?c fn=add args=?base args=?m
@a.pc1000.pat core.calc out=?pat fn=concat args="^([\\s\\S]{" args=?c args="})"
@a.pc1000.pa core.calc out=?pa fn=matches args=?a args=?pat args=1
@a.pc1000.pb core.calc out=?pb fn=matches args=?b args=?pat args=1
@a.pc1000.eq core.check fn=eq args=?pa args=?pb
@a.pc1000.o ui.doc.pk1000 box=?cid d=?d
@act.prefix.candidate.1000 core.rule when=$a.pc1000.s when=$a.pc1000.d with=$a.pc1000.m with=$a.pc1000.c with=$a.pc1000.pat with=$a.pc1000.pa with=$a.pc1000.pb if=$a.pc1000.eq then=$a.pc1000.o
@a.pb1000.i ui.doc.pk1000 box=?cid d=?d
@a.pb1000.o ui.doc.pb1000 box=?cid d=?m
@act.prefix.best.1000 core.aggregate over=$a.pb1000.i by=?cid max=?m args=?d then=$a.pb1000.o
@a.pn1000.s ui.doc.ps1000 box=?cid a=?a b=?b base=?base
@a.pn1000.b ui.doc.pb1000 box=?cid d=?d
@a.pn1000.m core.calc out=?m fn=mul args=?d args=1000
@a.pn1000.c core.calc out=?c fn=add args=?base args=?m
@a.pn1000.o ui.doc.ps100 box=?cid a=?a b=?b base=?c
@act.prefix.next.1000 core.rule when=$a.pn1000.s when=$a.pn1000.b with=$a.pn1000.m with=$a.pn1000.c then=$a.pn1000.o
@act.t.ps100 core.type of=ui.doc.ps100
@act.t.pk100 core.type of=ui.doc.pk100
@act.t.pb100 core.type of=ui.doc.pb100
@a.pc100.s ui.doc.ps100 box=?cid a=?a b=?b base=?base
@a.pc100.d ui.doc.digit d=?d
@a.pc100.m core.calc out=?m fn=mul args=?d args=100
@a.pc100.c core.calc out=?c fn=add args=?base args=?m
@a.pc100.pat core.calc out=?pat fn=concat args="^([\\s\\S]{" args=?c args="})"
@a.pc100.pa core.calc out=?pa fn=matches args=?a args=?pat args=1
@a.pc100.pb core.calc out=?pb fn=matches args=?b args=?pat args=1
@a.pc100.eq core.check fn=eq args=?pa args=?pb
@a.pc100.o ui.doc.pk100 box=?cid d=?d
@act.prefix.candidate.100 core.rule when=$a.pc100.s when=$a.pc100.d with=$a.pc100.m with=$a.pc100.c with=$a.pc100.pat with=$a.pc100.pa with=$a.pc100.pb if=$a.pc100.eq then=$a.pc100.o
@a.pb100.i ui.doc.pk100 box=?cid d=?d
@a.pb100.o ui.doc.pb100 box=?cid d=?m
@act.prefix.best.100 core.aggregate over=$a.pb100.i by=?cid max=?m args=?d then=$a.pb100.o
@a.pn100.s ui.doc.ps100 box=?cid a=?a b=?b base=?base
@a.pn100.b ui.doc.pb100 box=?cid d=?d
@a.pn100.m core.calc out=?m fn=mul args=?d args=100
@a.pn100.c core.calc out=?c fn=add args=?base args=?m
@a.pn100.o ui.doc.ps10 box=?cid a=?a b=?b base=?c
@act.prefix.next.100 core.rule when=$a.pn100.s when=$a.pn100.b with=$a.pn100.m with=$a.pn100.c then=$a.pn100.o
@act.t.ps10 core.type of=ui.doc.ps10
@act.t.pk10 core.type of=ui.doc.pk10
@act.t.pb10 core.type of=ui.doc.pb10
@a.pc10.s ui.doc.ps10 box=?cid a=?a b=?b base=?base
@a.pc10.d ui.doc.digit d=?d
@a.pc10.m core.calc out=?m fn=mul args=?d args=10
@a.pc10.c core.calc out=?c fn=add args=?base args=?m
@a.pc10.pat core.calc out=?pat fn=concat args="^([\\s\\S]{" args=?c args="})"
@a.pc10.pa core.calc out=?pa fn=matches args=?a args=?pat args=1
@a.pc10.pb core.calc out=?pb fn=matches args=?b args=?pat args=1
@a.pc10.eq core.check fn=eq args=?pa args=?pb
@a.pc10.o ui.doc.pk10 box=?cid d=?d
