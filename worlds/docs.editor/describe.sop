@describe.docs.editor.countTasksDone core.describe
    op=doc.countTasks
    intent=query
    emit="@{_} core.request action=doc.countTasks arg.state=done"
    frames=ask
    priority=12
    effect="counts the checked tasks"

@describe.docs.editor.countTasksLeft core.describe
    op=doc.countTasks
    intent=query
    emit="@{_} core.request action=doc.countTasks arg.state=left"
    frames=ask
    priority=12
    effect="counts the tasks that are not checked"

@describe.docs.editor.stats core.describe
    op=doc.stats
    intent=query
    emit="@{_} core.request action=doc.stats"
    frames=ask
    frames=qnoun
    frames=tell
    frames=rev
    priority=12
    bareVerb=true
    effect="answers the word, sentence and block counts"

@describe.docs.editor.readDoc core.describe
    op=doc.read
    intent=command
    emit="@{_} core.request action=doc.read"
    frames=imp
    frames=wish
    frames=ind
    frames=can
    priority=12
    effect="reads the whole document aloud"

@describe.docs.editor.readOrd core.describe
    op=doc.read
    intent=command
    emit="@{_} core.request action=doc.read arg.ord={ord} arg.kind={kind}"
    frames=imp
    frames=wish
    frames=ind
    frames=can
    priority=12
    effect="reads the block aloud"

@describe.docs.editor.readNum core.describe
    op=doc.read
    intent=command
    emit="@{_} core.request action=doc.read arg.n={n} arg.kind={kind}"
    frames=imp
    frames=wish
    frames=ind
    frames=can
    priority=12
    effect="reads the numbered block aloud"

@describe.docs.editor.readBare core.describe
    op=doc.read
    intent=command
    emit="@{_} core.request action=doc.read arg.n=1 arg.kind={kind}"
    frames=imp
    frames=wish
    frames=ind
    frames=can
    priority=11
    effect="reads the first block of that kind aloud"

