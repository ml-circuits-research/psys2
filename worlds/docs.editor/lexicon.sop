@lex.docs.editor.values core.lexicon
    class=modifier
    doc="Values the attributes take (from schema.sop; a colour attribute with no listed values takes the shared colour lexicon)"
    extends=$lex.lang.colour
    open=colour
    word=bold
    word=italic
    word=underline
    word=underlined
    word=strike
    word=strikethrough
    word=highlight
    word=bolden
    word=italicize
    word=italicise
    word=code
    word=plain
    word=bulleted
