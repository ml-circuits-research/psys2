    word=justified
    word=top
    word=end
    word=up
    word=down
    word=beginning
    word=bottom
    word=on
    word=off

@lex.docs.editor.more core.lexicon
    class=modifier
    doc="Comparatives that mean more of an attribute"
    word=bigger

@lex.docs.editor.less core.lexicon
    class=modifier
    doc="Comparatives that mean less of an attribute"
    word=smaller

@lex.docs.editor.nouns core.lexicon
    class=modifier
    doc="The words for the whole thing the world holds (the picture, the drawing)"
    word=document
    word=doc
    word=docs
    word=notes
    word=file

@lex.docs.editor.factor core.lexicon
    class=modifier
    doc="Factors of a size (twice as big)"
    word=twice
    word=double
    word=triple
    word=thrice
    word=half
    word=two_times
    word=three_times
    word=four_times
    word=ten_times

