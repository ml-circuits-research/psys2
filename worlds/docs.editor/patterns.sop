@pat.docs.editor.make.doc2 core.pattern
    canonical="Make a document with the text We go to the sea."
    match="[$lang.lead.filler|pls|plz]? [$docs.editor.g21_can_u]? [start|create|make|write|begin|open]? [a|an]? [new]? [document|doc] [with_the_text|with_text|saying|that_says|containing|reading|with_the_words|:] {c:rest(quotes)}"
    emit="@{_} core.request action=doc.make arg.content=\"{c}\""
    kind=request
    priority=13
    tabPriority=29
    example="Make a document saying We go to the sea."
    doc="The act make-document: the content in one request, the title left as it is."

@pat.docs.editor.read.thing core.pattern
    canonical="Read the second paragraph."
    match="[$lang.lead.filler|pls|plz]? [$docs.editor.g21_can_u]? [read|read_me|read_out|say|speak|recite] [me|out]? [the|my]? {t:rest}"
    emit="@{_} core.request action=doc.read arg.t=\"{t}\""
    kind=request
    priority=10
    tabPriority=20
    example="Read the second paragraph."

@pat.docs.editor.read.after core.pattern
    match="[$lang.lead.filler|pls|plz]? [the|my]? {t:words} [read|say|speak|read_out] [it]? [out_loud|aloud]? [please|pls]?"
    emit="@{_} core.request action=doc.read arg.t=\"{t}\""
    kind=request
    priority=8
    tabPriority=14
    example="Second paragraph read please."

@pat.docs.editor.table.fill core.pattern
    canonical="Fill the table with sea animals."
    match="[$lang.lead.filler|pls|plz]? [$docs.editor.g21_can_u]? [fill|populate|complete|fill_in|fill_up] [the]? table [in]? [with|using|from]? {t:rest}"
    emit="@{_} core.request action=doc.fillTable arg.topic=\"{t}\""
    kind=request
    priority=13
    tabPriority=29
    example="Fill the table with sea animals."
