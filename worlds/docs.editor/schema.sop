@doc acts.schema
    noun="document"
    doc="A document as a schema (spec 21): a document holds a title and blocks (sections, paragraphs, headings, lists with items, tables with cells); a block has a text, a style (marks and list styles), a level, a colour or highlight, an alignment and an order. The editor engine (editor.mjs, TipTap in the tab) keeps the state; the schema only says what is said. A view of the session things with the textual aspect (spec 23)."
    hooks=hooks.mjs
    own=dictate:doc.dictate
    own=dictateStop:doc.dictateStop
    own=read:doc.read
    own=download:doc.download
    own=stats:doc.stats
    own=mentions:doc.mentions
    own=isEmpty:doc.isEmpty
    own=whatIs:doc.whatIs
    own=say:doc.say
    own=fromList:doc.fromList
    own=report:doc.report
    own=whatSelected:doc.whatSelected
    own=fillTable:doc.fillTable
    own=checkTask:doc.checkTask
    own=countTasks:doc.countTasks
    own=listTasks:doc.listTasks
    own=holdings:doc.holdings
    own=addHeading:doc.addHeading
    own=addList:doc.addList
    own=addParagraph:doc.addParagraph
    own=docUndo:doc.undo
    own=docRedo:doc.redo
    own=view:docs.editor.view
    own=adopt:docs.editor.adopt
    own=makeDocument:doc.make
    sample=document
    list=yes
    say=yes
    scale=yes
    clear=yes
    none=yes
    opencolour=yes
    valued=yes
    ordered=yes
    textual=yes
    acts=make
    acts=remove
    acts=change
    acts=place
    acts=group
    acts=copy
    acts=pick
    acts=ask
    acts=send
    acts=save
    acts=undo
    acts=redo
    limit.items=500
    limit.history=50

@doc.document acts.kind
    plural=documents
    word=doc
    word=docs
    word=notes
    word=file

