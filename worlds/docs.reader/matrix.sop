# docs.reader as a matrix: which documents are open, which one is read and where the reader is, as wires; and the rules of what exists.
#
# The text engine stays in analyze.mjs, text.mjs, lang.mjs and ops.mjs (parsing, entities, events, co-reference, TF-IDF, BM25, search, summaries, the answers); it
# keeps working on the session state and the library takes the state over as wires after each operation (fns.mjs, `adopt`; `toState` is the way back). The facts of
# a document (sentences, entities, events, speech, relations: docs.reader.document / sentence / entity / event / said / relation) are told to the instance as the
# operations emit them, with core.source, so "why?" quotes the sentence.
#   docs.reader.shelf   one: which document is open (active), how many there are, the rest of the state as JSON (the last answer for "tell me more", the section
#                       being read, what was wired, the Documents tab's flags)
#   docs.reader.open    one for each document on the shelf: did, title, words, sentences, paras, sections and json (the analysis the engine works on)
#   docs.reader.focus   one: where the reader is: the document, the highest sentence number cited, how many are cited, JSON (cited sentences, entities, terms)
#   docs.reader.search  one while a search is on: the document, the hit the reader is at (pos, from 0), how many hits there are, JSON (query, terms, hits)
# A request that names a sentence, a paragraph or a section is asked to the rules as a docs.reader.want wire (fns.mjs, `guard`).

@dr.seq core.sequence key=core.seq

@dr.k.sactive core.slot of=docs.reader.shelf key=active kind=atom
@dr.k.sopen core.slot of=docs.reader.shelf key=open kind=integer required=true
@dr.k.srest core.slot of=docs.reader.shelf key=rest kind=string required=true
@dr.k.odid core.slot of=docs.reader.open key=did kind=atom required=true
@dr.k.on core.slot of=docs.reader.open key=n kind=integer required=true
@dr.k.otitle core.slot of=docs.reader.open key=title kind=string required=true
@dr.k.owords core.slot of=docs.reader.open key=words kind=integer
@dr.k.osent core.slot of=docs.reader.open key=sentences kind=integer required=true
@dr.k.opara core.slot of=docs.reader.open key=paras kind=integer required=true
@dr.k.osec core.slot of=docs.reader.open key=sections kind=integer required=true
@dr.k.ojson core.slot of=docs.reader.open key=json kind=string required=true
@dr.k.fdoc core.slot of=docs.reader.focus key=doc kind=atom
@dr.k.fupto core.slot of=docs.reader.focus key=upto kind=integer required=true
@dr.k.fcites core.slot of=docs.reader.focus key=cites kind=integer required=true
@dr.k.fjson core.slot of=docs.reader.focus key=json kind=string required=true
@dr.k.qdoc core.slot of=docs.reader.search key=doc kind=atom required=true
@dr.k.qpos core.slot of=docs.reader.search key=pos kind=integer required=true
@dr.k.qhits core.slot of=docs.reader.search key=hits kind=integer required=true
@dr.k.qjson core.slot of=docs.reader.search key=json kind=string required=true
@dr.k.wkind core.slot of=docs.reader.want key=kind kind=atom enum=sentence enum=paragraph enum=section enum=any required=true
@dr.k.wn core.slot of=docs.reader.want key=n kind=integer
@dr.k.word core.slot of=docs.reader.want key=ord kind=atom

# ---- what the state may be: the open document is on the shelf, a cited sentence is in the document, the search is at one of its hits
@dr.ia docs.reader.shelf active=?a
@dr.io docs.reader.open did=?a
@dr.d.active core.deny when=$dr.ia not=$dr.io why="The document ?a is not on the shelf."
@dr.cf docs.reader.focus doc=?d upto=?u
@dr.cd docs.reader.open did=?d sentences=?s
@dr.t.cite core.check fn=gt args=?u args=?s
@dr.d.cite core.deny when=$dr.cf when=$dr.cd if=$dr.t.cite why="Sentence ?u is cited, but the document has only ?s sentences."
@dr.sq docs.reader.search doc=?d pos=?p hits=?h
@dr.sd docs.reader.open did=?d
@dr.t.pos core.check fn=gte args=?p args=?h
@dr.t.some core.check fn=gt args=?h args=0
@dr.d.search core.deny when=$dr.sq when=$dr.sd if=$dr.t.pos if=$dr.t.some why="The search is at hit ?p but there are only ?h hits."

# ---- what a request may target: there is a document, and it has that sentence, paragraph or section (asked by `guard`; the want wire is never kept)
@dr.w0 docs.reader.want kind=?k
@dr.sa docs.reader.shelf active=?a
@dr.d.nodoc core.deny when=$dr.w0 not=$dr.sa why="There is no document open. Drop a .md, .txt, .pdf or .docx file on the Documents tab, or say \"load the sample\"."
@dr.ws docs.reader.want kind=sentence n=?n
@dr.wsa docs.reader.shelf active=?a
@dr.wso docs.reader.open did=?a sentences=?c
@dr.t.over core.check fn=gt args=?n args=?c
@dr.d.sentence core.deny when=$dr.ws when=$dr.wsa when=$dr.wso if=$dr.t.over why="There is no sentence ?n; the document has ?c sentences."
@dr.wp docs.reader.want kind=paragraph n=?n ord=?o
@dr.wpa docs.reader.shelf active=?a
@dr.wpo docs.reader.open did=?a paras=?c
@dr.d.para core.deny when=$dr.wp when=$dr.wpa when=$dr.wpo if=$dr.t.over why="There is no ?o paragraph; the document has ?c."
@dr.wc docs.reader.want kind=section n=?n ord=?o
@dr.wca docs.reader.shelf active=?a
@dr.wco docs.reader.open did=?a sections=?c
@dr.d.section core.deny when=$dr.wc when=$dr.wca when=$dr.wco if=$dr.t.over why="There is no ?o section; the document has ?c."
