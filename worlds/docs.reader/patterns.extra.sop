    match="[$lang.lead.polite|hey|pls|plz|wanna]? [what|which] [$docs.reader.g4_documents] [do|did|have|are|can|could|would|will|might|may|must|shall|should|does|is|am|was|were|been] [i|we|you|they|there|it|any|some|all|none|many|much|few|several] [have|got|own|keep|hold|store|save|add|added|open|opened|load|loaded|use|used|see|read|upload|uploaded|import|imported|create|created|make|made|write|wrote|written|get|gotten|had|has|having|here|available|there|around|saved|stored|loaded]? [here|open|loaded|added|saved|stored|available|now|right_now|currently|at_the_moment|so_far|in_here|in_there|in_total|altogether|in_all|overall|around|there|in_the_library|in_the_list|in_the_tab|in_the_app|in_the_reader|in_the_workspace]? [$docs.reader.g2_pls]?"
    emit="@{_} core.request action=docr.list"
    kind=question
    priority=9
    example="What files do I have here?"

@pat.docs.reader.sw.list.howmany core.pattern
    match="how many [$docs.reader.g4_documents] [$docs.reader.g5_do_i_have] [$docs.reader.g2_pls]?"
    emit="@{_} core.request action=docr.list"
    kind=question
    priority=9
    example="How many files do I have?"

@pat.docs.reader.sw.read.ord core.pattern
    canonical="Show me the third paragraph."
    match="[$lang.lead.polite|hey|pls|plz|wanna]? [$docs.reader.g6_read] [me|out|aloud]? [the|this|that]? [number|no]? {o:lex.docs.reader.ordinals} {u:lex.docs.reader.parts} [$lang.tail.filler|aloud|out_loud|loudly|out]? [$docs.reader.g2_pls]?"
    emit="@{_} core.request action=docr.read arg.ord={o} arg.u={u}"
    kind=request
    priority=15
    tabPriority=23
    example="Show me the third paragraph."
    example="Narrate the last section"

@pat.docs.reader.sw.read.n core.pattern
    match="[$lang.lead.polite|hey|pls|plz|wanna]? [$docs.reader.g6_read] [me|out|aloud]? [the|this|that]? {u:lex.docs.reader.parts} [number|no|nr|num|n|#]? {n:number} [$lang.tail.filler|aloud|out_loud|loudly|out]? [$docs.reader.g2_pls]?"
    emit="@{_} core.request action=docr.read arg.u={u} arg.n={n}"
    kind=request
    priority=15
    tabPriority=23
    example="Go to section 2."
    example="Please read paragraph number 3 to me"

@pat.docs.reader.sw.read.n.noun core.pattern
    match="[$lang.lead.polite|hey|pls|plz|wanna]? [$docs.reader.g6_read] [me|out|aloud]? [the|this|that]? [number|no|nr|num|n|#]? {n:number} {u:lex.docs.reader.parts} [$lang.tail.filler|aloud|out_loud|loudly|out]? [$docs.reader.g2_pls]?"
    emit="@{_} core.request action=docr.read arg.u={u} arg.n={n}"
    kind=request
    priority=15
    tabPriority=23
    example="Read number two paragraph pls"

@pat.docs.reader.sw.read.all core.pattern
    canonical="Narrate the story to me."
    match="[$lang.lead.polite|hey|pls|plz|wanna]? [$docs.reader.g62_read] [me|out|aloud]? [the|this|that|my]? [whole|entire|full|complete|all_of_the|all_of|everything_in_the]? {d:lex.docs.reader.docs} [aloud|out_loud|to_me|from_start_to_finish|from_beginning_to_end|from_the_start|from_the_beginning|pls|plz|now|for_me|thanks|thx|again|loudly|out|all_of_it|in_full|completely|entirely|top_to_bottom|from_top_to_bottom|start_to_finish|beginning_to_end]? [$docs.reader.g2_pls]?"
