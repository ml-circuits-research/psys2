@pat.docs.reader.summary.sec core.pattern
    match="[can_you|could_you|please_can_you]? [summarize|summarise|recap] [the]? [section|chapter] {n:number}"
    emit="@{_} core.request action=docr.summary arg.n={n}"
    kind=request
    priority=12
    example="Summarize section 2."

@pat.docs.reader.summary.sec.ord core.pattern
    match="[can_you|could_you|please_can_you]? [summarize|summarise|recap] [the]? {o:lex.docs.reader.ordinals} [section|chapter]"
    emit="@{_} core.request action=docr.summary arg.ord={o}"
    kind=request
    priority=12
    example="Summarize the last section."

@pat.docs.reader.summary.sec.about core.pattern
    match="what is [section|chapter] {n:number} about"
    emit="@{_} core.request action=docr.summary arg.n={n}"
    kind=question
    priority=12
    example="What is section 3 about?"

@pat.docs.reader.summary.sec.about.ord core.pattern
