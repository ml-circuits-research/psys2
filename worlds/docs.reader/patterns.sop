@pat.docs.reader.describe core.pattern
    match="[can_you|could_you|please_can_you]? [describe|introduce|analyse|analyze|profile|inspect] [the|this|that|my]? {d:lex.docs.reader.docs}"
    emit="@{_} core.request action=docr.describe"
    kind=request
    priority=15
    example="Describe the story."
    example="Analyze the file."

@pat.docs.reader.describe.know core.pattern
    match="what do you know about [the|this|that|my] {d:lex.docs.reader.docs}"
    emit="@{_} core.request action=docr.describe"
    kind=question
    priority=15
    example="What do you know about the file?"

@pat.docs.reader.summary.about core.pattern
    match="what is [the|this|that|my] {d:lex.docs.reader.docs} [all_about|about]"
    emit="@{_} core.request action=docr.summary"
    kind=question
    priority=15
    example="What is the story about?"

@pat.docs.reader.summary.do core.pattern
    match="[can_you|could_you|please_can_you]? [summarize|summarise|recap|sum_up] [the|this|that|my]? {d:lex.docs.reader.docs?} [for_me]?"
    emit="@{_} core.request action=docr.summary"
    kind=request
    priority=12
    example="Summarize the story."

@pat.docs.reader.summary.k core.pattern
    match="[can_you|could_you|please_can_you]? [summarize|summarise|recap] [the|this|that|my]? {d:lex.docs.reader.docs?} in {k:number} [sentences|sentence]"
    emit="@{_} core.request action=docr.summary arg.k={k}"
    kind=request
    priority=12
    example="Summarize the story in 3 sentences."

@pat.docs.reader.summary.give core.pattern
    match="[can_you|could_you|please_can_you]? [give_me|show_me|tell_me|write] [a|the]? [short|brief|quick]? [summary|recap|gist|synopsis] [of]? [the|this|that|my]? {d:lex.docs.reader.docs?}"
    emit="@{_} core.request action=docr.summary"
