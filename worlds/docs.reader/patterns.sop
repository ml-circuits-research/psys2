@pat.docs.reader.read.n core.pattern
    match="[can_you|could_you|please_can_you]? read [me]? [the]? {u:lex.docs.reader.parts} {n:number} [aloud|out_loud]?"
    emit="@{_} core.request action=docr.read arg.u={u} arg.n={n}"
    kind=request
    priority=12
    example="Read section 2."

@pat.docs.reader.read.all core.pattern
    match="[can_you|could_you|please_can_you]? read [me]? [the]? [whole|entire|full]? {d:lex.docs.reader.docs} [aloud|out_loud|to_me]?"
    emit="@{_} core.request action=docr.read arg.all=true"
    kind=request
    priority=15
    example="Read the story aloud."

@pat.docs.reader.read.ends core.pattern
    match="[can_you|could_you|please_can_you]? read [me]? [the]? {u:lex.docs.reader.ends} [aloud|out_loud]?"
    emit="@{_} core.request action=docr.read arg.u={u}"
    kind=request
    priority=12
    example="Read me the ending."

@pat.docs.reader.list core.pattern
    match="[can_you|could_you|please_can_you]? [what|which] {d:lex.docs.reader.docs} [do_i_have|have_i_added|are_open|are_loaded|do_you_have|are_there]"
    emit="@{_} core.request action=docr.list"
    kind=question
    priority=15
    example="Which documents do I have?"

@pat.docs.reader.list.show core.pattern
    match="[can_you|could_you|please_can_you]? [list|show] [me]? [my|all]? [the]? {d:lex.docs.reader.docs}"
    emit="@{_} core.request action=docr.list"
    kind=request
    priority=15
    example="List my documents."

@pat.docs.reader.open.title core.pattern
    match="[can_you|could_you|please_can_you]? [switch_to|work_with|talk_about|let_us_talk_about|go_to|open|pick|choose|select|use] [the|my]? {t:words(8)} [file|story|document|text|book|tale]"
    emit="@{_} core.request action=docr.open arg.t=\"{t}\""
    kind=request
    priority=12
    example="Open the fairy tale story."
    example="Switch to the second document."

@pat.docs.reader.open.called core.pattern
    match="[can_you|could_you|please_can_you]? [open|switch_to|go_to|use|pick] [the]? {d:lex.docs.reader.docs} [called|named|titled] {t:words(8)}"
    emit="@{_} core.request action=docr.open arg.t=\"{t}\""
    kind=request
    priority=15
    example="Open the file called Bees."

@pat.docs.reader.close.title core.pattern
    match="[can_you|could_you|please_can_you]? [close|remove|delete|discard|unload] [the]? {t:words(8)} [file|story|document|text|book|tale]"
    emit="@{_} core.request action=docr.close arg.t=\"{t}\""
    kind=request
    priority=6
    example="Close the bees file."

@pat.docs.reader.close core.pattern
    match="[can_you|could_you|please_can_you]? [close|remove|delete|discard|unload] [the|this|that]? [current|open]? {d:lex.docs.reader.docs}"
    emit="@{_} core.request action=docr.close"
    kind=request
    priority=15
    example="Close the file."

@pat.docs.reader.sample core.pattern
    match="[can_you|could_you|please_can_you]? [load|open|add|use|restore|show|start_with] [me]? [the|a]? [sample|example|demo|test|bundled] [story|document|file|text|tale|book]?"
    emit="@{_} core.request action=docr.loadSample"
    kind=request
    priority=12
    example="Load the sample story."

@pat.docs.reader.ask.say core.pattern
    match="what does [the|this|that]? {d:lex.docs.reader.docs} [say|tell|mention] [about]? {q:rest}"
    emit="@{_} core.request action=docr.ask arg.q=\"{q}\""
    kind=question
    priority=15
    example="What does the story say about the moon?"

