    match="[can_you|could_you|please_can_you]? [read|read_out] [me]? [that|this|the_same|the_current] [section|chapter] [again|aloud|out_loud]?"
    emit="@{_} core.request action=docr.read arg.rel=same"
    kind=request
    priority=12
    example="Read that section again."

@pat.docs.reader.sec.go.next core.pattern
    match="[can_you|could_you|please_can_you]? [read|go_to|show|open|move_to|continue_with|skip_to] [me]? [the]? [next|following|subsequent] [section|chapter]"
    emit="@{_} core.request action=docr.read arg.rel=next"
    kind=request
    priority=13
    example="Go to the next section."

@pat.docs.reader.sec.go.prev core.pattern
    match="[can_you|could_you|please_can_you]? [read|go_to|show|open|move_to|go_back_to|skip_back_to] [me]? [the]? [previous|preceding|prior|earlier] [section|chapter]"
    emit="@{_} core.request action=docr.read arg.rel=prev"
    kind=request
    priority=13
    example="Go to the previous section."

@pat.docs.reader.sec.bare.ordone core.pattern
    match="[and|what_about|how_about|now|and_now|then|ok_and|ok|okay]? [the]? {o:lex.docs.reader.ordinals} [one|result|hit|match]"
    emit="@{_} core.request action=docr.pick arg.ord={o}"
    kind=request
    priority=16
    tabOnly=true
    example="And the last one?"

@pat.docs.reader.sec.read.which core.pattern
    match="[can_you|could_you|please_can_you]? [read|read_out] [me]? [a|any|some|one|the]? [section|chapter] [aloud|out_loud|to_me|please]?"
    emit="@{_} core.request action=docr.read arg.u=section"
    kind=request
    priority=12
    example="Read a section aloud."

@pat.docs.reader.ext.which core.pattern
    match="which section is the {e:lex.docs.reader.extremes}"
    emit="@{_} core.request action=docr.sectionExtreme arg.e={e}"
    kind=question
    priority=15
    example="Which section is the longest?"

@pat.docs.reader.ext.what core.pattern
    match="what is the {e:lex.docs.reader.extremes} section"
    emit="@{_} core.request action=docr.sectionExtreme arg.e={e}"
    kind=question
    priority=15
    example="What is the longest section?"

@pat.docs.reader.stats.sec core.pattern
    match="how many {u:lex.docs.reader.units} [are_there|are|does]? [in|has|have]? [section|chapter] {n:number} [have]?"
    emit="@{_} core.request action=docr.stats arg.u={u} arg.n={n}"
    kind=question
    priority=15
    example="How many words are in section 2?"
    example="How many sentences does section 3 have?"

@pat.docs.reader.stats.that core.pattern
    match="how many {u:lex.docs.reader.units} [are_there|are]? in [that|this|the_same] [one|section]"
    emit="@{_} core.request action=docr.stats arg.u={u} arg.n=0"
    kind=question
    priority=15
    example="How many words in that one?"
