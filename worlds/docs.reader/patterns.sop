    match="[does|did] [the|this|that]? {d:lex.docs.reader.docs} [say|mention|state|explain|tell] {q:rest}"
    emit="@{_} core.request action=docr.ask arg.q=\"{q}\""
    kind=question
    priority=15
    example="Does the story mention a dragon?"

@pat.docs.reader.ask.according.end core.pattern
    match="{q:words(20)} according to [the|this|that]? {d:lex.docs.reader.docs}"
    emit="@{_} core.request action=docr.ask arg.q=\"{q}\""
    kind=question
    priority=15
    example="Why is the sky blue according to the story?"

