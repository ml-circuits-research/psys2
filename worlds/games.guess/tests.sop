@t.games.guess.m01 core.test
    session=gm1
    input="I am thinking of an animal."
    expect="Question 1: Does it have 4 legs?"
    expectState="phase=asking"
    expectState="candidates.67=worm"
    doc="SOPWORLD stage 2: the phase, the animals still possible and the questions left are rules; a reply that does not fit the phase is refused with the rule's words; undo goes through the library"
    reasoner=matrix

