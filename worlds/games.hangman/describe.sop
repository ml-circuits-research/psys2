@describe.hm.letter.guess core.describe
    op=hm.letter
    intent=command
    emit="@{_} core.request action=hm.letter arg.letter={l}"
    kind=request
    priority=12
    bareVerb=true
    frames=imp
    frames=wish
    frames=ind
    frames=can
    frames=short
    effect="guesses one letter"

