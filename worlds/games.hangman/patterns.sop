@pat.games.hangman.letter core.pattern
    match="[uh|hm|hmm|hey|ah|oh|wait|yeah]? [is_there|was_there|any|got|got_any|do_you_have|have_you_got|is|are_there|does_it_have|does_the_word_have|does_the_word_contain|does_it_contain|do_you_see|there_is]? [a|an|any|the]? [letter]? {l:lex.games.hangman.letters} [in_it|in_the_word|in_there|in_that|in_this|there|in_this_word]? [right|then|pls|plz|lol|rn|now]?"
    emit="@{_} core.request action=hm.letter arg.letter={l}"
    kind=request
    priority=12
    example="Is there an E?"
    example="Is there a letter R?"
    example="Hey is there an e in there."

