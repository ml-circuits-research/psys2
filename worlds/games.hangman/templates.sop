@tpl.games.hangman.hm_new core.template
    for=action.hm.new
    text="{value}"

@tpl.games.hangman.hm_new.unsupported core.template
    for=action.hm.new
    status=unsupported
    text="{note}"

@tpl.games.hangman.hm_new.missing core.template
    for=action.hm.new
    status=missing
    text="{note}"

