@tpl.games.hangman.hm_new core.template
    for=action.hm.new
    text="{value}"

@tpl.games.hangman.hm_letter core.template
    for=action.hm.letter
    text="{value}"

@tpl.games.hangman.hm_word core.template
    for=action.hm.word
    text="{value}"

@tpl.games.hangman.hm_hint core.template
    for=action.hm.hint
    text="{value}"

@tpl.games.hangman.hm_giveup core.template
    for=action.hm.giveup
    text="{value}"

@tpl.games.hangman.hm_status core.template
    for=action.hm.status
    text="{value}"
