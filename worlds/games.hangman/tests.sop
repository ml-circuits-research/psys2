@t.games.hangman.n01 core.test
    input="Is there an E?"
    expectStatus=missing
    session=a

@t.games.hangman.n02 core.test
    input="Play hangman with the word zebra"
    expect="Hangman"
    expectState="word=zebra"
    expectState="status=playing"
    expectState="wrongLeft=6"
    expectState="masked=_ _ _ _ _"
    session=a

@t.games.hangman.n03 core.test
    input="Is there an E?"
    expect="Yes"
    expectState="masked=_ e _ _ _"
    expectState="guessed.0=e"
    session=a

