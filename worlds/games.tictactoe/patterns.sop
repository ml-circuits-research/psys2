    priority=12
    example="Hint pls where should I put my mark."

@shape.games.tictactoe.move core.shape
    family=do
    verb="play|take|mark|place|put_it_in|go_to|choose|pick"
    obj="pos:lex.games.tictactoe.positions"
    det="the"
    extra="[square|cell|corner|spot|box|tile]?"
    forms=imp,wish,ind,q
    sample="pos=center"
