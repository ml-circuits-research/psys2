@pat.games.tictactoe.sw.giveupf core.pattern
    canonical="You win, I quit."
    canonical="I am done, you win."
    match="[$lang.lead.filler|umm|ooh|wait|right]? [ugh|argh|damn|dang|sigh|oh_no|aw|aww|oof|meh|geez|jeez|man|dude|bro|sorry|sadly|fine|nope|nah]? [i_give_up|i_quit|i_surrender|i_resign|i_forfeit|i_am_done|im_done|i_am_out|im_out|you_win|you_won|you_got_me|you_beat_me|i_lose|i_lost|i_cant_win|forget_it|enough|thats_enough|im_through|end_the_game|end_game|finish_the_game|stop_the_game|stop_playing|i_want_to_stop|i_wanna_stop|i_want_to_quit|i_wanna_quit|call_it_a_day|time_to_stop|im_giving_up|i_am_giving_up|giving_up|im_resigning|i_concede|concede|i_admit_defeat|uncle|mercy|i_cant_do_this] [you_win|you_won|i_quit|i_give_up|im_done|i_surrender|i_lose|pls|plz|now|thanks]?"
    emit="@{_} core.request action=ttt.giveup"
