@pat.games.tictactoe.last core.pattern
    match="[where_did_you_play|where_did_you_go|what_was_your_move|what_was_your_last_move|which_square_did_you_take|what_did_you_play|where_was_your_move|where_was_your_last_move|what_did_you_just_play|which_square_did_you_pick|which_square_did_you_play|where_did_you_just_play|what_was_your_last_play|which_square_did_you_choose|where_did_you_put_your_o|what_square_did_you_take|what_did_you_pick|where_did_you_move]"
