    priority=6
    example="Ugh, I give up."
    example="You win, I quit."
    example="I am done, you win."

@pat.games.tictactoe.x2.undo core.pattern
    canonical="Undo."
    match="[$lang.lead.filler|pls|plz|wait]? [undo|undo_that|undo_it|undo_my_move|undo_the_last_move|take_that_back|take_it_back|take_back_my_move|take_my_move_back|revert|revert_that|go_back|step_back|cancel_that|cancel_my_move|reverse_that|let_me_redo_that|i_want_to_undo|i_changed_my_mind|can_i_undo|can_i_take_that_back|let_me_take_that_back|i_take_it_back|back_up] [pls|plz|thanks|now|one_move|a_move|one_step]?"
    emit="@{_} core.request action=ttt.undo"
    kind=request
    priority=9
    example="Undo."
    example="Take that back."
    example="Oops, undo my move."

@pat.games.tictactoe.x2.undo.two core.pattern
    canonical="Undo the last move."
    match="[pls|plz|hey]? [undo|take_back|revert] [the_last|my_last]? [move|turn|go|mark|play]"
    emit="@{_} core.request action=ttt.undo"
    kind=request
    priority=9
    example="Undo the last move."

@pat.games.tictactoe.x2.hint.where core.pattern
    match="[hint|tip|clue|help|advice|suggestion|suggest|any_hint|a_hint|some_help|a_tip] [pls|plz|me|thanks]? [where_should_i|where_do_i|where_can_i|where_to|where_would_you|what_should_i|which_square_should_i|which_place_should_i|what_is_my_best|whats_my_best|which_is_the_best] {r:rest?}"
    emit="@{_} core.request action=ttt.hint"
