@pat.games.tictactoe.count core.pattern
    match="how_many [moves|tries|turns|plays|goes|marks|attempts] [have_we_made|have_we_played|have_been_made|have_been_played|did_we_make|did_we_play|have_i_made|have_i_had|have_you_made|have_you_played|were_made|were_played|are_there|have_we_had|have_i_played|have_i_taken|have_we_taken|have_i_used|have_we_done|has_each_player_made|did_i_make|did_you_make]? [so_far|now|already|in_total|altogether]?"
    emit="@{_} core.request action=ttt.count"
    kind=request
    priority=12
    example="How many moves have we made?"
    example="How many tries have I had?"

@pat.games.tictactoe.level.q core.pattern
    match="[what_level|which_level|how_hard] [are_you|is_it|are_we_playing|is_the_game|is_this]?"
    emit="@{_} core.request action=ttt.level"
    kind=request
    priority=12
    example="What level is it?"

@pat.games.tictactoe.hint core.pattern
    match="[what_should_i_play|where_should_i_play|where_should_i_go|what_is_my_best_move|what_is_a_good_move|what_move_should_i_make|suggest_a_move|what_should_i_do|which_move_is_best|where_should_i_move|give_me_a_tip|what_is_the_best_move|which_square_should_i_take|which_square_should_i_play|which_square_is_best|what_is_the_best_square|what_square_should_i_take|which_place_should_i_take|where_should_i_put_my_x|give_me_a_hint_for_the_move|what_is_a_good_square|what_would_you_play|what_would_you_do|help_me_choose]"
