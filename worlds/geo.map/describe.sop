@describe.geo.map.capital core.describe
    op=geo.capital
    intent=query
    emit="@{_} core.request action=geo.capital arg.c={c}"
    arg="c:lex.geo.map.places"
    noun="capital|capital_city"
    frames=qnoun,tell,poss,rev
    priority=12
    shortPriority=10
    sample="c=Japan"
    example="What is the capital of Japan?"
    effect="answers the capital of a country"

@describe.geo.map.population core.describe
    op=geo.population
    intent=query
    emit="@{_} core.request action=geo.population arg.p={p}"
    arg="p:lex.geo.map.places"
    noun="population|number_of_people|number_of_inhabitants"
    ask="how_many_people_live_in|how_many_people_are_in|how_many_inhabitants_does_have"
    frames=qnoun,tell,poss,rev,ask
    priority=12
    shortPriority=10
    sample="p=Brazil"
    example="What is the population of Brazil?"
    effect="answers the population of a place"

