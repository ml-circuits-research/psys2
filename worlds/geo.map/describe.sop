@describe.geo.map.where core.describe
    op=geo.where
    intent=query
    emit="@{_} core.request action=geo.where arg.p={p}"
    arg="p:lex.geo.map.places"
    noun="location|position"
    ask="where_is|where_s|wheres|where_are|where_can_i_find|where_can_i_see"
    rest="on_the_map|located"
    frames=ask,qnoun,rev
    priority=13
    shortPriority=11
    sample="p=Paris"
    example="Where is Paris?"
    effect="shows the place on the map and says where it is"

@describe.geo.map.distance core.describe
    op=geo.distance
    intent=query
    emit="@{_} core.request action=geo.distance arg.a={a} arg.b={b}"
    arg="a:lex.geo.map.places;prep=from|between|of|to"
    arg="b:lex.geo.map.places;prep=to|and|from|between"
    noun="distance|length|km|kilometres"
    ask="how_far_is|how_far_are|how_far_apart_are|how_far_it_is_from|how_many_kilometres_are_there_between|how_many_km_between"
    verb="measure|draw|trace|connect|link|join"
    rest="apart|away|in_km"
    frames=ask,qnoun,tell,rev,bare,imp,wish,ind,can
    priority=12
    shortPriority=10
    sample="a=Paris;b=Rome"
    example="How far is Paris from Rome?"
    effect="draws a line and answers the distance"

@describe.geo.map.compare core.describe
    op=geo.compare
    intent=command
    emit="@{_} core.request action=geo.compare arg.a={a} arg.b={b}"
    arg="a:lex.geo.map.places;prep=with|between|against"
    arg="b:lex.geo.map.places;prep=and|with|against|vs|versus|to"
    verb="compare|match_up|contrast"
    rest="side_by_side|please"
    frames=imp,wish,ind,can,short
    priority=12
    shortPriority=10
    sample="a=Spain;b=Italy"
    example="Compare Spain and Italy."
    effect="compares two places by area, population and borders"

@describe.geo.map.show core.describe
    op=geo.show
    intent=command
    emit="@{_} core.request action=geo.show arg.a={a} arg.b={b} arg.c={c} arg.d={d} arg.e={e}"
    arg="a:lex.geo.map.places;prep=of|at|on|to|in"
    arg="b:lex.geo.map.places?;prep=and|,"
    arg="c:lex.geo.map.places?;prep=and|,"
    arg="d:lex.geo.map.places?;prep=and|,"
    arg="e:lex.geo.map.places?;prep=and|,"
    verb="show|show_me|display|find|locate|focus_on|look_at|go_to|fly_to|take_me_to|zoom_to|center_on|centre_on|navigate_to|jump_to|open|visit|bring_up|see|view|pull_up|let_me_see|i_want_to_see"
    rest="on_the_map|on_map|in_the_map|for_me"
    frames=imp,wish,ind,can,short
    priority=14
    shortPriority=6
    sample="a=Bucharest"
    example="Show me Bucharest."
    effect="centres the map on the places and fits them"

