@describe.geo.map.isIn core.describe
    op=geo.isIn
    intent=query
    emit="@{_} core.request action=geo.isIn arg.p={p} arg.q={q}"
    arg="p:lex.geo.map.places"
    arg="q:lex.geo.map.places;prep=in|inside|within"
    ask="is|are|does"
    frames=ask,last
    priority=12
    sample="p=Paris;q=France"
    example="Is Paris in France?"
    effect="answers yes or no: the place is inside the other one"
