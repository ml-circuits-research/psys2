    op=geo.layer
    intent=command
    emit="@{_} core.request action=geo.layer arg.l={l}"
    arg="l:lex.geo.map.layers;prep=to|into"
    verb="switch_to|use|go_back_to|change_the_map_to|change_to|show_me|give_me|i_want"
