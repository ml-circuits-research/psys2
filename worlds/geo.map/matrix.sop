# geo.map as a matrix: the state of the map view is wires, what the knowledge base says about places is rules, and what cannot be is refused with the reason.
#
# The state of the view (where it looks, markers, highlighted countries, distance lines, the last place talked about, where the user is) is wires the library
# takes over after every operation (fns.mjs, `adopt`; `toState` is the way back): geo.map.view (one), geo.map.marker, geo.map.highlight, geo.map.line,
# geo.map.focus, geo.map.me, geo.map.clicked, and geo.map.dialog (the bookkeeping the operations keep: nextId, pending, undo and redo history). Each wire
# carries the keys the rules read (name, lat, lon, km ...) and `obj`, the exact object of the state, so the state is derived without loss.
# The knowledge base (kb.sop: 1,250 countries, cities and regions) is NOT loaded into the instance (`kb=lookup`, the library copies a world of that size on every first
# write after a fork: a turn took 37 ms instead of 6); the action that judges a claim tells the rules the few wires of the knowledge base the claim needs, and the denies
# below decide. The drawing, the geometry (fitting the view, distances), the number
# formatting and the words of the replies stay in the operations (ops.mjs) and fns.mjs.

@gm.seq core.sequence key=core.seq

# ---- the state as wires
@gm.k.v.lat core.slot of=geo.map.view key=lat kind=number required=true
@gm.k.v.lon core.slot of=geo.map.view key=lon kind=number required=true
@gm.k.v.zoom core.slot of=geo.map.view key=zoom kind=number required=true
@gm.k.v.layer core.slot of=geo.map.view key=layer kind=atom enum=offline enum=osm required=true
@gm.k.v.bs core.slot of=geo.map.view key=bs kind=number
@gm.k.v.bw core.slot of=geo.map.view key=bw kind=number
@gm.k.v.bn core.slot of=geo.map.view key=bn kind=number
@gm.k.v.be core.slot of=geo.map.view key=be kind=number
@gm.k.v.obj core.slot of=geo.map.view key=obj kind=blob required=true
@gm.k.m.i core.slot of=geo.map.marker key=i kind=integer required=true
@gm.k.m.mid core.slot of=geo.map.marker key=mid kind=string required=true
@gm.k.m.name core.slot of=geo.map.marker key=name kind=string required=true
@gm.k.m.lat core.slot of=geo.map.marker key=lat kind=number required=true
@gm.k.m.lon core.slot of=geo.map.marker key=lon kind=number required=true
@gm.k.m.obj core.slot of=geo.map.marker key=obj kind=blob required=true
@gm.k.h.i core.slot of=geo.map.highlight key=i kind=integer required=true
@gm.k.h.cc core.slot of=geo.map.highlight key=cc kind=atom
@gm.k.h.name core.slot of=geo.map.highlight key=name kind=string required=true
@gm.k.h.obj core.slot of=geo.map.highlight key=obj kind=blob required=true
@gm.k.l.i core.slot of=geo.map.line key=i kind=integer required=true
@gm.k.l.lid core.slot of=geo.map.line key=lid kind=string required=true
@gm.k.l.fname core.slot of=geo.map.line key=fname kind=string required=true
@gm.k.l.flat core.slot of=geo.map.line key=flat kind=number required=true
@gm.k.l.flon core.slot of=geo.map.line key=flon kind=number required=true
@gm.k.l.tname core.slot of=geo.map.line key=tname kind=string required=true
@gm.k.l.tlat core.slot of=geo.map.line key=tlat kind=number required=true
@gm.k.l.tlon core.slot of=geo.map.line key=tlon kind=number required=true
@gm.k.l.km core.slot of=geo.map.line key=km kind=number required=true
@gm.k.l.obj core.slot of=geo.map.line key=obj kind=blob required=true
@gm.k.f.name core.slot of=geo.map.focus key=name kind=string required=true
@gm.k.f.kind core.slot of=geo.map.focus key=kind kind=atom
@gm.k.f.lat core.slot of=geo.map.focus key=lat kind=number
@gm.k.f.lon core.slot of=geo.map.focus key=lon kind=number
@gm.k.f.obj core.slot of=geo.map.focus key=obj kind=blob required=true
@gm.k.me.lat core.slot of=geo.map.me key=lat kind=number required=true
@gm.k.me.lon core.slot of=geo.map.me key=lon kind=number required=true
@gm.k.me.obj core.slot of=geo.map.me key=obj kind=blob required=true
@gm.k.ck.lat core.slot of=geo.map.clicked key=lat kind=number required=true
@gm.k.ck.lon core.slot of=geo.map.clicked key=lon kind=number required=true
@gm.k.ck.obj core.slot of=geo.map.clicked key=obj kind=blob required=true
@gm.k.d.rest core.slot of=geo.map.dialog key=rest kind=blob required=true

# ---- the view looks at a point of the Earth, at a zoom the map has
@gm.v geo.map.view lat=?lat lon=?lon zoom=?z layer=?ly
@gm.vlat core.calc out=?al fn=abs args=?lat
@gm.vlon core.calc out=?ol fn=abs args=?lon
@gm.t.lat core.check fn=gt args=?al args=90
@gm.t.lon core.check fn=gt args=?ol args=180
@gm.t.zlow core.check fn=lt args=?z args=1
@gm.t.zhigh core.check fn=gt args=?z args=18
@gm.t.zoff core.check fn=gt args=?z args=12
@gm.d.vlat core.deny when=$gm.v with=$gm.vlat if=$gm.t.lat why="Latitude must be between -90 and 90, not ?lat."
@gm.d.vlon core.deny when=$gm.v with=$gm.vlon if=$gm.t.lon why="Longitude must be between -180 and 180, not ?lon."
@gm.d.zlow core.deny when=$gm.v if=$gm.t.zlow why="The zoom level must be between 1 and 18, not ?z."
@gm.d.zhigh core.deny when=$gm.v if=$gm.t.zhigh why="The zoom level must be between 1 and 18, not ?z."
@gm.vo geo.map.view zoom=?z layer=offline
@gm.d.zoff core.deny when=$gm.vo if=$gm.t.zoff why="The offline country map zooms in to 12 at most, not ?z. Say \"street map\" to zoom closer."

# ---- a marker is a point of the Earth
@gm.m geo.map.marker name=?mn lat=?mlat lon=?mlon
@gm.mlat core.calc out=?mal fn=abs args=?mlat
@gm.mlon core.calc out=?mol fn=abs args=?mlon
@gm.t.mlat core.check fn=gt args=?mal args=90
@gm.t.mlon core.check fn=gt args=?mol args=180
@gm.d.mlat core.deny when=$gm.m with=$gm.mlat if=$gm.t.mlat why="A marker cannot be at latitude ?mlat: ?mn."
@gm.d.mlon core.deny when=$gm.m with=$gm.mlon if=$gm.t.mlon why="A marker cannot be at longitude ?mlon: ?mn."

# ---- a line joins two different places
@gm.ln geo.map.line fname=?lf flat=?la flon=?lo tname=?lf tlat=?la tlon=?lo
@gm.d.line core.deny when=$gm.ln why="A line needs two different places, not ?lf twice."

# ---- what is on the map: counts and the length of the lines, derived (the anchor is the view)
@gm.vv geo.map.view
@gm.om geo.map.marker
@gm.oh geo.map.highlight
@gm.ol geo.map.line km=?lk
@gm.nm core.calc out=?nm fn=count over=$gm.om
@gm.nh core.calc out=?nh fn=count over=$gm.oh
@gm.nl core.calc out=?nl fn=count over=$gm.ol
@gm.sk core.calc out=?sk fn=sum over=$gm.ol args=?lk
@gm.k.r.m core.slot of=geo.map.onmap key=markers kind=integer
@gm.k.r.h core.slot of=geo.map.onmap key=highlights kind=integer
@gm.k.r.l core.slot of=geo.map.onmap key=lines kind=integer
@gm.k.r.k core.slot of=geo.map.onmap key=km kind=number
@gm.on geo.map.onmap markers=?nm highlights=?nh lines=?nl km=?sk
@gm.r.on core.rule when=$gm.vv with=$gm.nm with=$gm.nh with=$gm.nl with=$gm.sk then=$gm.on

# ---- how a country is called in a sentence: "the" before the names that take it
@gm.k.the.name core.slot of=geo.map.the key=name kind=string
@gm.k.the.shown core.slot of=geo.map.the key=shown kind=string
@gm.k.the.cap core.slot of=geo.map.the key=cap kind=string
@gm.the.1 geo.map.the name="United States" shown="the United States" cap="The United States"
@gm.the.2 geo.map.the name="United Kingdom" shown="the United Kingdom" cap="The United Kingdom"
@gm.the.3 geo.map.the name="Netherlands" shown="the Netherlands" cap="The Netherlands"
@gm.the.4 geo.map.the name="Philippines" shown="the Philippines" cap="The Philippines"
@gm.the.5 geo.map.the name="Bahamas" shown="the Bahamas" cap="The Bahamas"
@gm.the.6 geo.map.the name="Gambia" shown="the Gambia" cap="The Gambia"
@gm.the.7 geo.map.the name="United Arab Emirates" shown="the United Arab Emirates" cap="The United Arab Emirates"
@gm.the.8 geo.map.the name="DR Congo" shown="the DR Congo" cap="The DR Congo"
@gm.the.9 geo.map.the name="Republic of the Congo" shown="the Republic of the Congo" cap="The Republic of the Congo"
@gm.the.10 geo.map.the name="Maldives" shown="the Maldives" cap="The Maldives"
@gm.the.11 geo.map.the name="Comoros" shown="the Comoros" cap="The Comoros"
@gm.the.12 geo.map.the name="Seychelles" shown="the Seychelles" cap="The Seychelles"
@gm.the.13 geo.map.the name="Marshall Islands" shown="the Marshall Islands" cap="The Marshall Islands"
@gm.the.14 geo.map.the name="Solomon Islands" shown="the Solomon Islands" cap="The Solomon Islands"
@gm.the.15 geo.map.the name="Cayman Islands" shown="the Cayman Islands" cap="The Cayman Islands"
@gm.the.16 geo.map.the name="Central African Republic" shown="the Central African Republic" cap="The Central African Republic"
@gm.the.17 geo.map.the name="Dominican Republic" shown="the Dominican Republic" cap="The Dominican Republic"
@gm.the.18 geo.map.the name="Czech Republic" shown="the Czech Republic" cap="The Czech Republic"
@gm.the.19 geo.map.the name="Faroe Islands" shown="the Faroe Islands" cap="The Faroe Islands"
@gm.the.20 geo.map.the name="Cook Islands" shown="the Cook Islands" cap="The Cook Islands"
@gm.the.21 geo.map.the name="Virgin Islands" shown="the Virgin Islands" cap="The Virgin Islands"
@gm.k.sh.cc core.slot of=geo.map.shown key=cc kind=atom
@gm.k.sh.shown core.slot of=geo.map.shown key=shown kind=string
@gm.k.sh.cap core.slot of=geo.map.shown key=cap kind=string
@gm.sh1 geo.map.country cc=?c name=?n
@gm.sh2 geo.map.the name=?n shown=?s cap=?k
@gm.sh3 geo.map.shown cc=?c shown=?s cap=?k
@gm.r.sh1 core.rule when=$gm.sh1 when=$gm.sh2 then=$gm.sh3
@gm.sh4 geo.map.shown cc=?c shown=?n cap=?n
@gm.r.sh2 core.rule when=$gm.sh1 not=$gm.sh2 then=$gm.sh4

# ---- what the user says about places, checked against the knowledge base (the wires it needs are told with the claim). The actions geo.isIn, geo.isCapital and geo.borderYN (fns.mjs) ask whether the claim
# could stand: nothing is told, a claim that could not is refused with the reason, which is the answer's "No, ...". The words are those of the operations.
@gm.k.cl.kind core.slot of=geo.map.claim key=kind kind=atom enum=city_in enum=country_in_continent enum=country_in_region enum=city_in_continent enum=borders enum=capital required=true
@gm.k.cl.a core.slot of=geo.map.claim key=a kind=atom required=true
@gm.k.cl.b core.slot of=geo.map.claim key=b kind=atom required=true

# a city is in a country: no city of that name is in it
@gm.c1 geo.map.claim kind=city_in a=?a b=?b
@gm.c1a geo.map.city key=?a cc=?ac name=?an
@gm.c1b geo.map.country key=?b cc=?bc
@gm.c1ok geo.map.city key=?a cc=?bc
@gm.c1as geo.map.shown cc=?ac shown=?as
@gm.c1bs geo.map.shown cc=?bc shown=?bs
@gm.d.c1 core.deny when=$gm.c1 when=$gm.c1a when=$gm.c1b when=$gm.c1as when=$gm.c1bs not=$gm.c1ok why="?an is not in ?bs; it is in ?as."

# a country is in a continent: it lists another one
@gm.c2 geo.map.claim kind=country_in_continent a=?a b=?b
@gm.c2a geo.map.country key=?a cont=?ac name=?an
@gm.c2b geo.map.region key=?b kind=continent name=?bn
@gm.c2ok geo.map.country key=?a cont=?b
@gm.c2r geo.map.region key=?ac kind=continent name=?arn
@gm.d.c2 core.deny when=$gm.c2 when=$gm.c2a when=$gm.c2b when=$gm.c2r not=$gm.c2ok why="?an is not in ?bn; it is in ?arn."

# a country is in a region of the world (a UN subregion): it lists another one (and says which continent it is in)
@gm.c3 geo.map.claim kind=country_in_region a=?a b=?b
@gm.c3a geo.map.country key=?a cont=?ac sub=?asub name=?an
@gm.c3b geo.map.region key=?b kind=subregion name=?bn
@gm.c3ok geo.map.country key=?a sub=?bn
@gm.c3r geo.map.region key=?ac kind=continent name=?arn
@gm.d.c3 core.deny when=$gm.c3 when=$gm.c3a when=$gm.c3b when=$gm.c3r not=$gm.c3ok why="?an is not in ?bn; it is in ?arn."

# a city is in a continent: its country is in another one (the reason names the country)
@gm.c4 geo.map.claim kind=city_in_continent a=?a b=?b
@gm.c4a geo.map.city key=?a cc=?ac name=?an
@gm.c4b geo.map.region key=?b kind=continent name=?bn
@gm.c4ok geo.map.country cc=?ac cont=?b
@gm.c4as geo.map.shown cc=?ac shown=?as
@gm.d.c4 core.deny when=$gm.c4 when=$gm.c4a when=$gm.c4b when=$gm.c4as not=$gm.c4ok why="?an is not in ?bn; it is in ?as."

# a country borders another: it does not list it
@gm.c5 geo.map.claim kind=borders a=?a b=?b
@gm.c5a geo.map.country key=?a cc=?ac
@gm.c5b geo.map.country key=?b cc=?bc
@gm.c5ok geo.map.country key=?a nb=?bc
@gm.c5as geo.map.shown cc=?ac shown=?as
@gm.c5bs geo.map.shown cc=?bc shown=?bs
@gm.d.c5 core.deny when=$gm.c5 when=$gm.c5a when=$gm.c5b when=$gm.c5as when=$gm.c5bs not=$gm.c5ok why="?as and ?bs do not share a border."

# a city is the capital of a country: the country has another capital
@gm.c6 geo.map.claim kind=capital a=?a b=?b
@gm.c6a geo.map.city key=?a name=?an
@gm.c6b geo.map.country key=?b cc=?bc capital=?cap
@gm.c6ok geo.map.country key=?b capital=?an
@gm.c6bs geo.map.shown cc=?bc shown=?bs
@gm.d.c6 core.deny when=$gm.c6 when=$gm.c6a when=$gm.c6b when=$gm.c6bs not=$gm.c6ok why="the capital of ?bs is ?cap."

# ---- the actions (fns.mjs); everything else the operations do (ops.mjs), and the library takes the state over after them
@gm.a.isin core.action name=geo.isIn fn=gmIsIn
@gm.a.iscap core.action name=geo.isCapital fn=gmIsCapital
@gm.a.bord core.action name=geo.borderYN fn=gmBorderYN
@gm.a.onmap core.action name=geo.onmap fn=gmOnMap
