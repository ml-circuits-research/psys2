@describe.sound core.describe
    op=kids.animals.animal
    intent=query
    emit="@{_} core.question type=kids.animals.animal seek=sound where.name={a}"
    frames=ask
    skip=short
    priority=10
    effect="answers the sound an animal makes"

@describe.sound.a core.describe.arg
    of=$describe.sound
    name=a
    class=noun

@describe.sound.en core.describe.words
    of=$describe.sound
    lang=en
    tverb=$w.en.say.kids.animals.animal
    tverb=$w.en.sound_like.kids.animals.animal
    tverb=$w.en.sound.kids.animals.animal
    tverb=$w.en.make.kids.animals.animal
    ask=$w.en.what_does.kids.animals.animal
    ask=$w.en.what_do.kids.animals.animal
    ask=$w.en.how_does.kids.animals.animal
    ask=$w.en.how_do.kids.animals.animal
    ask=$w.en.what_noise_does.kids.animals.animal
    ask=$w.en.what_sound_does.kids.animals.animal
    det.a=$w.en.a.kids.animals.animal.a
    det.a=$w.en.an.kids.animals.animal.a
    det.a=$w.en.the.kids.animals.animal.a
    sample.a=dog
    example="What does a dog say?"

