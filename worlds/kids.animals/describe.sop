
@describe.pet.called core.describe
    op=kids.animals.pet
    intent=query
    emit="@{_} core.question type=kids.animals.pet seek=called where.owner=$e.user where.kind={k}"
    frames=ask
    skip=short
    priority=10
    effect="answers the name of the pet of a kind that the user has"

@describe.pet.called.k core.describe.arg
    of=$describe.pet.called
    name=k
    class=lex.kids.animals.names

@describe.pet.called.en core.describe.words
    of=$describe.pet.called
    lang=en
    tverb=$w.en.called.kids.animals.pet
    ask=$w.en.what_is_my.kids.animals.pet
    ask=$w.en.what_are_my.kids.animals.pet
    ask=$w.en.what_is_the_name_of_my.kids.animals.pet
    sample.k=dog
    example="What is my dog called?"

@describe.pet.list core.describe
    op=kids.animals.pet
    intent=query
    emit="@{_} core.question type=kids.animals.pet seek=called where.owner=$e.user"
    frames=ask
    skip=short
    priority=10
    effect="lists the names of the pets the user has"

@describe.pet.list.en core.describe.words
    of=$describe.pet.list
    lang=en
    ask=$w.en.what_pets_do_i_have.kids.animals.pet
    ask=$w.en.which_pets_do_i_have.kids.animals.pet
    ask=$w.en.what_are_my_pets_called.kids.animals.pet
    ask=$w.en.what_is_my_pet_called.kids.animals.pet
    ask=$w.en.what_are_my_pets.kids.animals.pet
    example="What pets do I have?"

@describe.pet.kind core.describe
    op=kids.animals.pet
    intent=query
    emit="@{_} core.question type=kids.animals.pet seek=kind where.called={n}"
    frames=ask
    skip=short
    priority=10
    effect="answers what kind of pet a name belongs to"

@describe.pet.kind.n core.describe.arg
    of=$describe.pet.kind
    name=n
    class=agent

@describe.pet.kind.en core.describe.words
    of=$describe.pet.kind
    lang=en
    ask=$w.en.who_is.kids.animals.pet
    sample.n=Rex
    example="Who is Rex?"
@w.en.called.kids.animals.pet core.word text=called means=kids.animals.pet
@w.en.what_is_my.kids.animals.pet core.word text="what is my" means=kids.animals.pet
@w.en.what_are_my.kids.animals.pet core.word text="what are my" means=kids.animals.pet
@w.en.what_is_the_name_of_my.kids.animals.pet core.word text="what is the name of my" means=kids.animals.pet
@w.en.what_pets_do_i_have.kids.animals.pet core.word text="what pets do i have" means=kids.animals.pet
@w.en.which_pets_do_i_have.kids.animals.pet core.word text="which pets do i have" means=kids.animals.pet
@w.en.what_are_my_pets_called.kids.animals.pet core.word text="what are my pets called" means=kids.animals.pet
@w.en.what_is_my_pet_called.kids.animals.pet core.word text="what is my pet called" means=kids.animals.pet
@w.en.what_are_my_pets.kids.animals.pet core.word text="what are my pets" means=kids.animals.pet
@w.en.who_is.kids.animals.pet core.word text="who is" means=kids.animals.pet
