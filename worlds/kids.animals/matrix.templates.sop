@tpl.kids.animals.m.can_fly.yes core.template
    for=kids.animals.animal.can_fly
    when="value=true"
    text="Yes, {name:a} can fly."

@tpl.kids.animals.m.can_fly.no core.template
    for=kids.animals.animal.can_fly
    when="value=false"
    text="No, {name:a} cannot fly."

@tpl.kids.animals.m.can_swim.yes core.template
    for=kids.animals.animal.can_swim
    when="value=true"
    text="Yes, {name:a} can swim."

@tpl.kids.animals.m.can_swim.no core.template
    for=kids.animals.animal.can_swim
    when="value=false"
    text="No, {name:a} cannot swim."
