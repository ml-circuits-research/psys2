@pat.kids.animals.x2.legs.count core.pattern
    match="[tell_me|can_you_tell_me|do_you_know|i_wonder|i_want_to_know] [the|how_many]? [number_of]? legs [that|does|do]? [a|an|the]? {a:noun} [has|have|walks_on|stands_on|walk_on|have_got]"
    emit="@{_} core.question type=kids.animals.animal seek=legs where.name={a}"
    kind=question
    priority=11
    example="Tell me the number of legs a spider has."

@pat.kids.animals.ask.legs core.pattern
    match="how_many legs"
    emit="@{_} core.request action=chat.ask arg.q=\"Which animal do you mean?\" arg.template=\"how many legs does <x> have\" arg.world=\"kids.animals\""
    kind=request
    priority=11
    example="How many legs?"
    doc="Clarification (spec 11 section 3): the question lacks its subject; asks for it and completes the sentence with the next utterance."

@pat.kids.animals.ask.sound core.pattern
    match="what sound [does|do|did] [it|that|that_one|this_one] make"
    emit="@{_} core.request action=chat.ask arg.q=\"Which animal do you mean?\" arg.template=\"what sound does <x> make\" arg.world=\"kids.animals\""
    kind=request
    priority=11
    example="What sound does it make?"
    doc="Clarification (spec 11 section 3): the question lacks its subject; asks for it and completes the sentence with the next utterance."

@pat.kids.animals.ask.eat core.pattern
    match="what [does|do|did] [it|that|that_one|this_one] eat"
    emit="@{_} core.request action=chat.ask arg.q=\"Which animal do you mean?\" arg.template=\"what does <x> eat\" arg.world=\"kids.animals\""
    kind=request
    priority=11
    example="What does it eat?"
    doc="Clarification (spec 11 section 3): the question lacks its subject; asks for it and completes the sentence with the next utterance."

@pat.kids.animals.ask.live core.pattern
    match="where [does|do|did] [it|that|that_one|this_one] live"
    emit="@{_} core.request action=chat.ask arg.q=\"Which animal do you mean?\" arg.template=\"where does <x> live\" arg.world=\"kids.animals\""
    kind=request
    priority=11
    example="Where does it live?"
    doc="Clarification (spec 11 section 3): the question lacks its subject; asks for it and completes the sentence with the next utterance."

@shape.kids.animals.sound core.shape
    family=ask.value
    obj="a:noun"
    noun="sound|noise"
    verb="make|produce|give"
    det="a|an|the"
    sample="a=cow"
    emit="@{_} core.question type=kids.animals.animal seek=sound where.name={a}"
    priority=10
    skip=short
    example="What sound does a cow make?"

@shape.kids.animals.legs core.shape
    family=ask.count
    noun="legs"
    cont="a:noun"
    verb="have|has"
    det="a|an|the"
    sample="a=spider"
    emit="@{_} core.question type=kids.animals.animal seek=legs where.name={a}"
    priority=10
    skip=short,imp
    example="How many legs does a spider have?"
