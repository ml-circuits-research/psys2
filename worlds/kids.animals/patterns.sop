@pat.kids.animals.x2.alt.breathe core.pattern
    canonical="Do dolphins breathe air or are they fish?"
    match="[do|does|did] [a|an|the]? {a:noun} [breathe|breath|breathe_in|breath_in|live_on_land|have_gills|have_lungs|have_fur|have_feathers|lay_eggs] [air|water|under_water|underwater]? or [are|is|do|does] [they|it|he|she|a|an]? [a|an]? {c1:lex.kids.animals.classes}"
    emit="@{_} core.question type=kids.animals.animal seek=class where.name={a}"
    kind=question
    priority=11
    example="Do dolphins breathe air or are they fish?"


@pat.kids.animals.x2.alt.what core.pattern
    match="[what|which] is [a|an|the]? {a:noun} [a|an]? {c1:lex.kids.animals.classes} or [a|an]? {c2:lex.kids.animals.classes}"
    emit="@{_} core.question type=kids.animals.animal seek=class where.name={a}"
    kind=question
    priority=11
