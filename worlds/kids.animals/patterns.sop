@pat.kids.animals.x2.legs.walkon core.pattern
    match="how_many legs [does|do|did] [a|an|the]? {a:noun} [walk|stand|run|move|crawl|go] on"
    emit="@{_} core.question type=kids.animals.animal seek=legs where.name={a}"
    kind=question
    priority=11
    example="How many legs does a spider walk on?"

@pat.kids.animals.x2.legs.number core.pattern
    match="[what|whats|what_is] the number of legs [that]? [a|an|the]? {a:noun} [has|have|owns|uses|walks_on|stands_on]"
    emit="@{_} core.question type=kids.animals.animal seek=legs where.name={a}"
    kind=question
    priority=11
    example="What is the number of legs a spider has?"

@pat.kids.animals.x2.legs.number.of core.pattern
    match="[what|whats|what_is] the number of legs [of|on|for] [a|an|the]? {a:noun}"
