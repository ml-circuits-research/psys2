@pat.kids.animals.legs4 core.pattern
    canonical="Does a dog have 4 legs?"
    match="[does|do|did] [a|an|the]? {a:noun} have {n:number} legs"
    emit="@{_} core.question type=kids.animals.animal seek=legs mode=exists where.name={a} where.legs={n}"
    kind=question
    priority=10
    example="Does a dog have 4 legs?"

