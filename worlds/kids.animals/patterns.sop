
@pat.kids.animals.tl core.pattern
    canonical="A zebra has 4 legs."
    match="[$kids.animals.g2_remember]? [a|an|the]? {a:noun} [has|have] {n:number} legs"
    emit="@{_} kids.animals.animal name={a} legs={n}"
    kind=statement
    priority=12
    example="A zebra has 4 legs."

@pat.kids.animals.te core.pattern
    match="[$kids.animals.g2_remember]? [a|an|the]? {a:noun} [eats|eat] {f:word}"
    emit="@{_} kids.animals.animal name={a} food={f}"
    kind=statement
    priority=12
    example="Zebras eat grass."

@pat.kids.animals.te2 core.pattern
    match="[$kids.animals.g2_remember]? [a|an|the]? {a:noun} [eats|eat] {f:word} and {g:word}"
    emit="@{_} kids.animals.animal name={a} food={f}\n@{_1} kids.animals.animal name={a} food={g}"
    kind=statement
    priority=13
    example="Zebras eat grass and leaves."

@pat.kids.animals.tc core.pattern
    match="[$kids.animals.g2_remember]? [a|an|the]? {a:noun} [is|are] [a|an]? {c:lex.kids.animals.classes}"
