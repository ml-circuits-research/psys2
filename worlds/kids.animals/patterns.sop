@pat.kids.animals.pet1 core.pattern
    canonical="My dog is called Rex."
    match="my {k:noun} is [called|named] {n:agent}"
    emit="@{_} kids.animals.pet owner=$e.user kind={k} called={n}"
    kind=statement
    priority=12
    example="My dog is called Rex."

