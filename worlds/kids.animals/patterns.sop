@pat.kids.animals.x3.pet.kitty2 core.pattern
    match="[$kids.animals.g7_remember]? [my|our|the]? [kitty|kitties|kitty_cat|kitten] [is|was|be]? [called|named|known_as|nicknamed|goes_by] {n:agent} [$lang.tail.filler|$kids.animals.g37_by_the_way]?"
    emit="@{_} kids.animals.pet owner=$e.user kind=cat called={n}"
    kind=statement
    priority=13
    example="My kitty is named Tom"

@pat.kids.animals.x3.pet.doggy2 core.pattern
    match="[$kids.animals.g7_remember]? [my|our|the]? [doggy|doggie|doggo|pup|puppy] [is|was|be]? [called|named|known_as|nicknamed|goes_by] {n:agent} [$lang.tail.filler|$kids.animals.g37_by_the_way]?"
    emit="@{_} kids.animals.pet owner=$e.user kind=dog called={n}"
    kind=statement
    priority=13
    example="My doggy is named Rex"
