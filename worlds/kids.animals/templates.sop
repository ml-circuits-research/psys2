
@tpl.kids.animals.t39 core.template
    for=kids.animals.pet.called
    text="Your {kind} is called {value}."

@tpl.kids.animals.t40 core.template
    for=kids.animals.pet.called
    text="Your pet is called {value}."

@tpl.kids.animals.t41 core.template
    for=kids.animals.pet.called
    status=conflicting
    text="You told me about more than one pet: {alternatives:list}."

@tpl.kids.animals.t42 core.template
    for=kids.animals.pet.called
    status=missing
    text="I don't know what your {kind} is called. You can tell me: My {kind} is called Rex."

@tpl.kids.animals.t43 core.template
    for=kids.animals.pet.called
    status=missing
    text="I don't know your pet's name yet. You can tell me: My dog is called Rex."

@tpl.kids.animals.t44 core.template
    for=kids.animals.pet.kind
    text="{called} is your {value}."

@tpl.kids.animals.t45 core.template
    for=kids.animals.pet.kind
    status=missing
    text="I don't know who {called} is yet. You can tell me: My dog is called {called}."

@tpl.kids.animals.t46 core.template
    for=kids.animals.pet.kind
    mode=list
    text="You have {values:a:list}."

@tpl.kids.animals.t47 core.template
    for=kids.animals.pet.kind
    status=missing
    mode=list
    text="You have not told me about any pets yet. You can say: I have a cat called Tom."

@tpl.kids.animals.t48 core.template
    for=kids.animals.pet.kind
    mode=exists
    text="Yes, you have {kind:a}."

@tpl.kids.animals.t49 core.template
    for=kids.animals.pet.kind
    status=missing
    mode=exists
    text="I don't know whether you have {kind:a}. You can tell me: I have {kind:a} called Rex."

@tpl.kids.animals.t50 core.template
    for=ack.kids.animals.animal
    text="OK, {name:a} has {legs} legs."

@tpl.kids.animals.t51 core.template
    for=ack.kids.animals.animal
    text="OK, {name:plural} eat {food}."

@tpl.kids.animals.t52 core.template
    for=ack.kids.animals.animal
    text="OK, {name:a} is {class:a}."

@tpl.kids.animals.t53 core.template
    for=ack.kids.animals.animal
    text="OK, {name:a} is {diet:a}."

@tpl.kids.animals.t54 core.template
    for=ack.kids.animals.animal
    text="OK, I will remember where {name:plural} live: {habitat}."

@tpl.kids.animals.t55 core.template
    for=ack.kids.animals.animal
    text="OK, {name:a} goes {sound}."

@tpl.kids.animals.t56 core.template
    for=ack.kids.animals.animal
    text="OK, a baby {name} is called {baby:a}."

@tpl.kids.animals.t57 core.template
    for=ack.kids.animals.animal
    text="OK, I will remember what covers {name:plural}: {covering}."

@tpl.kids.animals.t58 core.template
    for=ack.kids.animals.animal
    text="OK, I will remember that about {name:plural}."

@tpl.kids.animals.t59 core.template
    for=ack.kids.animals.pet
    text="Nice! Your {kind} is called {called}."
