@t.animals.m01 core.test
    session=kam1
    input="A zebra can swim."
    expect="I will remember that about zebras."
    reasoner=matrix
    doc="SOPWORLD stage 2: what a child teaches is a wire of the library"

@t.animals.m03 core.test
    session=kam1
    input="undo that"
    expect="OK, I forgot what you taught me about zebras."
    doc="undo goes back through the library and says it in the world's words"
    reasoner=matrix

