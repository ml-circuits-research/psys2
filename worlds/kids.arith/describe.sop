    class=number

@describe.receive.omit.item core.describe.arg
    of=$describe.receive.omit
    name=item
    class=recent(lex.kids.arith.items,who)

@describe.receive.omit.en core.describe.words
    of=$describe.receive.omit
    lang=en
    nosubject=true
    verb=$w.en.gets.kids.arith.receive
    verb=$w.en.got.kids.arith.receive
    verb=$w.en.receives.kids.arith.receive
    verb=$w.en.received.kids.arith.receive
    verb=$w.en.find.kids.arith.receive
    verb=$w.en.finds.kids.arith.receive
    verb=$w.en.found.kids.arith.receive
    unit.n=$w.en.more.kids.arith.receive.n
    unit.n=$w.en.new.kids.arith.receive.n
    sample.who=Tom
    sample.n=3
    sample.item=apple
    example="Tom gets 3 more."

