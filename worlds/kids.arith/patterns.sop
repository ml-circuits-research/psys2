@pat.kids.arith.q.count core.pattern
    match="how_many {item:lex.kids.arith.items} [does|do|did|will] {who:agent} have [now|left|left_over|today|at_the_end|then]?"
    emit="@{_} core.question type=kids.arith.holding seek=count where.owner={who} where.item={item}"
    kind=question
    priority=9
    example="How many apples does Tom have?"

@pat.kids.arith.q.count.got core.pattern
    match="how_many {item:lex.kids.arith.items} [has|have] {who:agent} got [now|left]?"
    emit="@{_} core.question type=kids.arith.holding seek=count where.owner={who} where.item={item}"
    kind=question
    priority=10
    example="How many apples has Tom got?"

