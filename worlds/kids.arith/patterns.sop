    emit="@{_} kids.arith.give who={who} to={to} count=1 item={item}"
    kind=statement
    priority=10
    example="Ana gave an apple to Tom."

@pat.kids.arith.give.of core.pattern
    match="{who:agent} [gives|gave|give] {n:number} of [his|her|their|my|the]? {item:lex.kids.arith.items} to {to:agent}"
    emit="@{_} kids.arith.give who={who} to={to} count={n} item={item}"
    kind=statement
    priority=10
    example="Ana gave 2 of her apples to Tom."

