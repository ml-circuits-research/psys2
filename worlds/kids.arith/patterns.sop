@pat.kids.arith.lose.away core.pattern
    match="[just|then|also|already|now|later|again]? {who:agent} [just|then|also|already|now|later|again]? [$kids.arith.g16_gives_away] {n:number} [more]? {item:lex.kids.arith.items} [of_them|in_total]?"
    emit="@{_} kids.arith.lose who={who} count={n} item={item}"
    kind=statement
    priority=13
    example="Ben gives away 6 apples."

@pat.kids.arith.lose.away.a core.pattern
    match="[just|then|also|already|now|later|again]? {who:agent} [just|then|also|already|now|later|again]? [$kids.arith.g16_gives_away] [a|an|one] {item:lex.kids.arith.items}"
    emit="@{_} kids.arith.lose who={who} count=1 item={item}"
    kind=statement
    priority=13
    example="Ben gave away an apple."

@pat.kids.arith.lose.away.omit core.pattern
    match="[just|then|also|already|now|later|again]? {who:agent} [just|then|also|already|now|later|again]? [$kids.arith.g16_gives_away] {n:number} [more]? {item:recent(lex.kids.arith.items,who)} [of_them|of_his|of_her|of_the_ones|in_total]?"
    emit="@{_} kids.arith.lose who={who} count={n} item={item}"
    kind=statement
    priority=13
    example="Ben gives away 6."
    example="Ben gave away 6 of them."

@pat.kids.arith.lose.away.after core.pattern
    match="[just|then|also|already|now|later|again]? {who:agent} [just|then|also|already|now|later|again]? [$kids.arith.g40_gives] {n:number} {item:lex.kids.arith.items} [away|out]"
    emit="@{_} kids.arith.lose who={who} count={n} item={item}"
    kind=statement
    priority=13
    example="Ben gave 6 apples away."

@pat.kids.arith.lose.away.after.omit core.pattern
    match="[just|then|also|already|now|later|again]? {who:agent} [just|then|also|already|now|later|again]? [$kids.arith.g40_gives] {n:number} {item:recent(lex.kids.arith.items,who)} [away|out]"
    emit="@{_} kids.arith.lose who={who} count={n} item={item}"
    kind=statement
    priority=13
    example="Ben gave 6 away."

@pat.kids.arith.has.and.omit core.pattern
    match="{who:agent} [has|have|had] [got]? {n:number} {item:lex.kids.arith.items} [and|while|but|whereas] {who2:agent} [has|have|had] [got]? {m:number} [too|also|more]?"
    emit="@{_} kids.arith.holding owner={who} count={n} item={item}\n@{_1} kids.arith.holding owner={who2} count={m} item={item}"
    kind=statement
    priority=12
    example="Tom has 2 apples and Ana has 3."

@pat.kids.arith.has.and.omit.b core.pattern
    match="{who:agent} [has|have|had] [got]? {n:number} {item:lex.kids.arith.items} [and|while|but|whereas] {who2:agent} [got]? {m:number}"
