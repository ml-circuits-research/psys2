@pat.kids.arith.q.total.bare core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [$lang.lead.question]? how_many {item:lex.kids.arith.items} [altogether|in_total|in_all|all_together|together|all_together_now|combined] [$lang.tail.filler]?"
    emit="@{_} core.question type=kids.arith.total seek=count where.item={item}"
    kind=question
    priority=10
    example="How many apples altogether?"

@pat.kids.arith.q.left.name core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [$lang.lead.question]? [what|whats|what_is|how_much|how_many] [is|are]? [left|remaining|left_over] [for|with|over_for|of]? {who:agent} {item:recent(lex.kids.arith.items,who)} [$lang.tail.filler]?"
    emit="@{_} core.question type=kids.arith.holding seek=count where.owner={who} where.item={item}"
    kind=question
    priority=10
    example="whats left for Mia"

@pat.kids.arith.q.count.omit core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [$lang.lead.question]? how_many [does|do|did|will] {who:agent} have {item:recent(lex.kids.arith.items,who)} [$lang.tail.filler|left|left_over|at_the_end|altogether]? [$lang.tail.filler]?"
    emit="@{_} core.question type=kids.arith.holding seek=count where.owner={who} where.item={item}"
    kind=question
