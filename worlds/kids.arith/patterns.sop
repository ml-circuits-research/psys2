@shape.kids.arith.holding core.shape
    family=ask.count
    obj="item:lex.kids.arith.items"
    cont="who:agent"
    verb="has|have|got|own|owns|hold|holds|holding"
    det="the"
    objdet=none
    sample="item=apples;who=Tom"
    emit="@{_} core.question type=kids.arith.holding seek=count where.owner={who} where.item={item}"
    priority=10
    skip=short
    example="How many apples does Tom have?"
