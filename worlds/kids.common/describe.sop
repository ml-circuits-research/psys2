@describe.greet core.describe
    op=chat.greet
    intent=command
    emit="@{_} core.request action=chat.greet"
    frames=phr

@describe.greet.en core.describe.words
    of=$describe.greet
    lang=en
    phrase=$phrase.lang.intent.greet

@describe.name core.describe
    op=chat.name
    intent=query
    emit="@{_} core.request action=chat.name"
    priority=14
    frames=phr

@describe.name.en core.describe.words
    of=$describe.name
    lang=en
    phrase=$phrase.lang.intent.assistantname

