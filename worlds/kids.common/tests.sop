@t.kids.common.n1 core.test
    input="Hello!"
    expect="Hello"

@t.kids.common.n2 core.test
    input="What is your name?"
    expect="My name is PSys2."

@t.kids.common.n3 core.test
    input="Who are you?"
    expect="I am PSys2"

@t.kids.common.n4 core.test
    input="Thank you!"
    expect="You are welcome"

@t.kids.common.n5 core.test
    input="Goodbye"
    expect="Goodbye"

@t.kids.common.n7 core.test
    input="Please, hi there"
    expect="Hello"

@t.kids.common.n8 core.test
    input="Zorb flimbles quickly"
    expectStatus=unparsed

@t.kids.common.w01 core.test
    input="Hello friend"
    expect="Hello"
    doc="wording variant (widened phrasing)"

@t.kids.common.w02 core.test
    input="thx"
    expect="You are welcome"
    doc="wording variant (widened phrasing)"

@t.kids.common.w03 core.test
    input="my name's ben. whats my name again?"
    expect="Your name is Ben."
    doc="wording variant (widened phrasing)"

@t.kids.common.w04 core.test
    input="Ben is my name. do u know who i am?"
    expect="Your name is Ben."
    doc="wording variant (widened phrasing)"

@t.kids.common.w05 core.test
    input="cya bot"
    expect="Goodbye"
    doc="wording variant (widened phrasing)"
