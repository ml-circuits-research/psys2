@pat.kids.shapes.w.thingcolor.f2 core.pattern
    canonical="A lemon is which colour?"
    match="[a|an|the|every|any|all|each]? {t:lex.kids.shapes.things} [is|are]? [what|which] [color|colour] [$kids.shapes.g13_usually]? [$lang.tail.filler|$kids.shapes.g3_if_you_know]?"
    emit="@{_} core.question type=kids.shapes.thing seek=color where.name={t}"
    kind=question
    priority=10
    example="A lemon is which colour?"

@shape.kids.shapes.thingcolor core.shape
    family=ask.value
    obj="t:lex.kids.shapes.things"
    noun="color|colour|shade|hue"
    det="a|an|the|every|any|all|each"
    poss=true
    sample="t=banana"
    emit="@{_} core.question type=kids.shapes.thing seek=color where.name={t}"
    priority=10
    skip=short
    example="What color is a banana?"
