
@pat.kids.shapes.tsides core.pattern
    canonical="A rhombus has 4 sides."
    match="[$kids.shapes.g2_remember]? [a|an|the]? {s:noun} [has|have] {n:number} {p:lex.kids.shapes.parts}"
    emit="@{_} kids.shapes.shape name={s} {p}s={n}"
    kind=statement
    priority=12
    example="A rhombus has 4 sides."

@pat.kids.shapes.tcol core.pattern
    match="[$kids.shapes.g2_remember]? [a|an|the]? {t:noun} [is|are] {c:lex.kids.shapes.colors}"
    emit="@{_} kids.shapes.thing name={t} color={c}"
    kind=statement
    priority=12
    example="A strawberry is red."

@pat.kids.shapes.tcol2 core.pattern
    canonical="Zebras are black and white."
    match="[$kids.shapes.g2_remember]? [a|an|the]? {t:noun} [is|are] {c:lex.kids.shapes.colors} and {d:lex.kids.shapes.colors}"
    emit="@{_} kids.shapes.thing name={t} color={c}\n@{_1} kids.shapes.thing name={t} color={d}"
    kind=statement
    priority=13
    example="Zebras are black and white."

@pat.kids.shapes.tshape core.pattern
    canonical="A ruler is a rectangle."
    match="[$kids.shapes.g2_remember]? [a|an|the]? {t:noun} [is|are] [a|an|the]? {s:lex.kids.shapes.shapes}"
    emit="@{_} kids.shapes.thing name={t} shape={s}"
    kind=statement
    priority=12
    example="A ruler is a rectangle."

@pat.kids.shapes.tmix core.pattern
    canonical="Black and red make brown."
    match="[$kids.shapes.g2_remember]? {a:lex.kids.shapes.colors} and {b:lex.kids.shapes.colors} make {r:lex.kids.shapes.colors}"
    emit="@{_} kids.shapes.mix first={a} second={b} result={r}"
    kind=statement
    priority=12
    example="Black and red make brown."

@pat.kids.shapes.x.tcol.x core.pattern
    match="[$kids.shapes.g2_remember]? [a|an|the]? {t:noun} [color|colour|colors|colours|is_colored|is_coloured|are_colored|are_coloured|is_painted|are_painted|is_usually|are_usually|turns|turn|looks|look|appears|appear|comes_in|come_in|gets|get|becomes|become|is_always|are_always|goes|go|is_normally|are_normally|is_typically|are_typically|is_really|are_really|is_actually|are_actually|=|:]? [is|are|be|was|were|=]? {c:lex.kids.shapes.colors}"
    emit="@{_} kids.shapes.thing name={t} color={c}"
    kind=statement
    priority=6
    example="Banana yellow"
    example="Remember banana color is yellow"

@pat.kids.shapes.x.tshape.x core.pattern
    match="[$kids.shapes.g2_remember]? [a|an|the]? {t:noun} [is_shaped_like|are_shaped_like|looks_like|look_like|has_the_shape_of|have_the_shape_of|is_like|are_like|looks_like_a|resembles|resemble|is_in_the_shape_of|has_the_form_of|is_formed_like|is_a_kind_of|is_kind_of|shape_is|shape_is_a|is_in_shape_of|are_in_shape_of|has_a_shape_of|have_a_shape_of|has_a|have_a|is_the_shape_of|are_the_shape_of|is_formed_as|are_formed_as|is_made_like|are_made_like|is_built_like|are_built_like|has_shape|have_shape|is_round_like|are_round_like] [a|an|the]? {s:lex.kids.shapes.shapes}"
    emit="@{_} kids.shapes.thing name={t} shape={s}"
    kind=statement
    priority=11
    example="A ball looks like a circle"

@pat.kids.shapes.x.tsides.x core.pattern
    match="[$kids.shapes.g2_remember]? [a|an|the]? {s:noun} [has|have|got|has_got|have_got|had|get|gets|with|is_with|equals|contains|contain|includes|include|is_made_of|are_made_of|is_formed_by|are_formed_by|is_built_from|are_built_from|consists_of|consist_of|made_of|has_exactly|have_exactly]? {n:number} {p:lex.kids.shapes.parts}"
    emit="@{_} kids.shapes.shape name={s} {p}s={n}"
    kind=statement
    priority=6
    example="Remember a hexagon has six sides"
    example="Hexagon 6 sides"

@pat.kids.shapes.x.tmix.x core.pattern
    match="[$kids.shapes.g2_remember]? [mix|mixing|combine|combining|blend|blending|add|adding|put|putting|mixed|combined|blended|if_you_mix|if_you_combine|if_you_blend|when_you_mix|when_you_combine|when_you_blend|if_i_mix|when_i_mix|if_we_mix|when_we_mix|mixing_up]? {c:lex.kids.shapes.colors} [and|with|plus|mixed_with|combined_with|blended_with|n|x|added_to|added_with|put_with|merged_with|stirred_with|joined_with|together_with|then] {b:lex.kids.shapes.colors} [make|makes|gives|give|is|equals|become|becomes|turn_into|turns_into|produce|produces|create|creates|result_in|results_in|get|gets|form|forms|yield|yields|are|should_be|will_be|would_be|gets_you|will_make|will_give|would_make|would_give|=|is_equal_to|come_out_as|comes_out_as|end_up_as|ends_up_as|make_a|makes_a|give_a|gives_a|get_a|gets_a]? [the]? [color|colour]? {r:lex.kids.shapes.colors}"
    emit="@{_} kids.shapes.mix first={c} second={b} result={r}"
    kind=statement
    priority=11
    example="Remember red plus blue is purple"
    example="Mixing red and blue gives purple"
