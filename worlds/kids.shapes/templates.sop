
@tpl.kids.shapes.t48 core.template
    for=ack.kids.shapes.shape
    text="OK, {name:a} has {sides} sides."

@tpl.kids.shapes.t49 core.template
    for=ack.kids.shapes.shape
    text="OK, {name:a} has {corners} corners."

@tpl.kids.shapes.t50 core.template
    for=ack.kids.shapes.thing
    text="OK, {name:a} is {color}."

@tpl.kids.shapes.t51 core.template
    for=ack.kids.shapes.thing
    text="OK, {name:a} looks like {shape:a}."

@tpl.kids.shapes.t52 core.template
    for=ack.kids.shapes.mix
    text="OK, {first} and {second} make {result}."

@tpl.kids.shapes.t53 core.template
