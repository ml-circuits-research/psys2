@t.shapes.n1 core.test
    input="How many sides does a hexagon have?"
    expect="A hexagon has 6 sides."

@t.shapes.n2 core.test
    input="How many corners does a pentagon have?"
    expect="A pentagon has 5 corners."

@t.shapes.n3 core.test
    input="How many sides do triangles have?"
    expect="A triangle has 3 sides."

@t.shapes.n4 core.test
    input="How many sides does an octagon have?"
    expect="An octagon has 8 sides."

@t.shapes.n5 core.test
    input="Which shape has 3 sides?"
    expect="These shapes have 3 sides: triangle."

@t.shapes.n6 core.test
    input="Name a shape with 4 corners."
    expect="square"
    expect="rectangle"

@t.shapes.n7 core.test
    input="Which shapes have no corners?"
    expect="circle"
    expect="oval"

@t.shapes.n8 core.test
    input="Does a pentagon have 5 sides?"
    expect="Yes, a pentagon has 5 sides."

@t.shapes.n9 core.test
    input="Does a pentagon have 6 sides?"
    expect="I don't know whether a pentagon has 6 sides."
    expectStatus=missing
    doc="a different number is not refuted by an explicit statement, so it is unknown"

@t.shapes.n10 core.test
    input="What is a hexagon?"
    expect="A hexagon is a flat shape with 6 sides and 6 corners."

@t.shapes.n11 core.test
    input="What is a circle?"
    expect="A circle is a round shape with no sides and no corners."

@t.shapes.n12 core.test
    input="Is a square a rectangle?"
    expect="Yes, a square is a rectangle."

@t.shapes.n13 core.test
    input="Is a rectangle a square?"
    expect="No, a rectangle is not a square."
    expect="only when all four sides are equal"

@t.shapes.n14 core.test
    input="Is a triangle a polygon?"
    expect="Yes, a triangle is a polygon."

@t.shapes.n15 core.test
    input="Is a circle a polygon?"
    expect="No, a circle is not a polygon."

@t.shapes.n16 core.test
    input="Is a circle round?"
    expect="Yes, a circle is a round shape."

@t.shapes.n17 core.test
    input="Is a square round?"
    expect="No, a square is not a round shape."

@t.shapes.n18 core.test
    input="Is an oval a circle?"
    expectStatus=missing
    doc="oval has no relation facts: unknown"

@t.shapes.n19 core.test
    input="Is a unicorn a polygon?"
    expectStatus=missing

@t.shapes.n20 core.test
    input="What do red and yellow make?"
    expect="Red and yellow make orange."

@t.shapes.n21 core.test
    input="What color do you get if you mix blue and yellow?"
    expect="Blue and yellow make green."

@t.shapes.n22 core.test
    input="What do yellow and red make?"
    expect="Yellow and red make orange."
    doc="order does not matter"

@t.shapes.n23 core.test
    input="What do red and black make?"
    expectStatus=missing

@t.shapes.n24 core.test
    input="How do I make purple?"
    expect="Purple is made by mixing red and blue."

@t.shapes.n25 core.test
    input="Is red a primary color?"
    expect="Yes, red is a primary color."

@t.shapes.n26 core.test
    input="Is orange a primary color?"
    expect="No, orange is not a primary color. It is a secondary color."

@t.shapes.n27 core.test
    input="Is pink a primary color?"
    expectStatus=missing
    doc="pink has no kind in the knowledge base"

@t.shapes.n28 core.test
    input="What kind of color is green?"
    expect="Green is a secondary color."

@t.shapes.n29 core.test
    input="Which colors are primary?"
    expect="The primary colors are red, yellow and blue."

@t.shapes.n30 core.test
    input="How many secondary colors are there?"
    expect="There are 3 secondary colors."

@t.shapes.n31 core.test
    input="What color is the sky?"
    expect="The sky is usually blue."

@t.shapes.n32 core.test
    input="What color is grass?"
    expect="Grass is usually green."

@t.shapes.n33 core.test
    input="What color is a banana?"
    expect="A banana is usually yellow."

@t.shapes.n34 core.test
    input="What color are apples?"
    expect="An apple is usually red and green."

@t.shapes.n35 core.test
    input="Is a banana yellow?"
    expect="Yes, a banana is usually yellow."

@t.shapes.n36 core.test
    input="Is a banana red?"
    expect="No, a banana is not red. It is usually yellow."

@t.shapes.n37 core.test
    input="What color is a dragon?"
    expectStatus=missing

