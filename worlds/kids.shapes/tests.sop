
@t.shapes.n23 core.test
    input="What do red and black make?"
    expectStatus=missing

@t.shapes.n43 core.test
    session=teach
    input="A trapezium has 4 sides."
    expect="OK, a trapezium has 4 sides."

@t.shapes.n47 core.test
    session=conflict
    input="A square has 5 sides."
    expect="OK, a square has 5 sides."

@t.shapes.n51 core.test
    session=colors
    input="Zebras are black and white."
    expect="OK, a zebra is black."

@t.shapes.n55 core.test
    session=mixing
    input="What do black and red make?"
    expectStatus=missing

@t.shapes.n56 core.test
    session=mixing
    input="Black and red make brown."
    expect="OK, black and red make brown."

@t.shapes.n60 core.test
    session=shapeof
    input="A ruler is a rectangle."
    expect="OK, a ruler looks like a rectangle."

@t.kids.shapes.m02 core.test
    session=ksm1
    input="A trapezium has 4 sides."
    expect="OK, a trapezium has 4 sides."
    reasoner=matrix

@t.kids.shapes.m04 core.test
    session=ksm1
    input="undo"
    expect="OK, I took that back"
    expectStatus=supported
    reasoner=matrix
