@t.shapes.n47 core.test
    session=conflict
    input="A square has 5 sides."
    expect="OK, a square has 5 sides."

@t.shapes.n48 core.test
    session=conflict
    input="How many sides does a square have?"
    expect="4"
    expect="5"
    expectStatus=conflicting

