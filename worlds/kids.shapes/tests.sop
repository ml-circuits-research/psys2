    expect="coin"

@t.shapes.n41 core.test
    input="What shape is a cloud?"
    expectStatus=missing

@t.shapes.n42 core.test
    session=teach
    input="How many sides does a trapezium have?"
    expectStatus=missing

@t.shapes.n43 core.test
    session=teach
    input="A trapezium has 4 sides."
    expect="OK, a trapezium has 4 sides."

@t.shapes.n44 core.test
    session=teach
    input="How many sides does a trapezium have?"
    expect="A trapezium has 4 sides."

@t.shapes.n45 core.test
    session=teach
    input="Which shape has 4 sides?"
    expect="square"
    expect="trapezium"

@t.shapes.n46 core.test
    session=teach
    input="How many corners does a trapezium have?"
    expectStatus=missing
