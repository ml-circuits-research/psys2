@describe.kids.shop.money core.describe
    op=kids.shop.money
    intent=statement
    emit="@{_} kids.shop.money count={n} unit=leu"
    effect="sets the amount of money the user has"

@describe.kids.shop.money.n core.describe.arg
    of=$describe.kids.shop.money
    name=n
    class=number

@describe.kids.shop.money.en core.describe.words
    of=$describe.kids.shop.money
    lang=en
