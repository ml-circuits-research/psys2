@lex.kids.shop.units core.lexicon
    class=unit
    doc="The money unit: one leu, many lei"
    word=leu
    word=lei
    plural=leu:lei

@lex.kids.shop.triggers core.lexicon
    class=trigger
    word=cost word=costs word=price word=lei word=leu word=buy word=bought word=change word=afford word=money word=how_much word=enough
