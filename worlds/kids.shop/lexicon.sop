    word=pen
    word=eraser
    word=ruler
    word=notebook
    word=sticker
    word=book
    word=backpack
    word=apple
    word=banana
    word=orange
    word=pear
    word=bread
    word=milk
    word=juice
    word=water
    word=biscuit
    word=chocolate
    word=ice_cream
    word=sandwich
    word=toy_car
    word=doll
    word=kite
