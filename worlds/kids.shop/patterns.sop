    match="[$kids.shop.g1_i_need_to_find_out]? [$kids.shop.g1_i_need_to_find_out]? {m:number} [lei_each|lei|leu|ron]? [if_i_buy|after_i_buy|when_i_buy|after_i_get|to_buy|to_get|spent_on|spent_for|paid_for|gone_on|gone_for|after_buying|after_getting|and|plus|with|for|on|buying|getting|minus|less|-|spent|paid|gone|after]? {n1:number} {i1:lex.kids.shop.items} [along_with|together_with|plus_a|and_a|with_a|and_also|and_then|and_one|and_maybe|and_perhaps|and|plus|with|also|n|&|then|or]? [a|an|the|one]? {i2:lex.kids.shop.items} [,|:|-|then|so|and]? [$kids.shop.g110_what_will_be]? [$kids.shop.g2_how_much_money_do_i_have_left] [$kids.shop.g24_do_i_get]? [pls|then|exactly|really|actually]? [$lang.tail.filler|$kids.shop.g4_exactly]? [$lang.tail.filler|$kids.shop.g4_exactly]?"
