@shape.kids.shop.price core.shape
    family=ask.value
    obj="item:lex.kids.shop.items"
    noun="price|cost|prices|costs"
    det="the|a|an|one"
    sample="item=pen"
    emit="@{_} core.question type=kids.shop.price seek=cost where.item={item}"
    priority=10
    example="What is the price of a pen?"

@pat.kids.shop.q.change.want.a core.pattern
    canonical="I want a puzzle and I pay 10 lei. What is the change?"
    match="[$lang.shop.want] [a|an] {i1:lex.kids.shop.items} [$lang.shop.payment] {m:number} [lei|leu]? [$lang.q.change]"
    emit="@{_} core.question type=kids.shop.change seek=amount where.paid={m} where.item={i1} where.count=1"
    kind=question
    priority=11
    example="I want a puzzle and I pay 10 lei. What is the change?"

@pat.kids.shop.q.change.want.b core.pattern
    match="[$lang.shop.want] {n1:number} {i1:lex.kids.shop.items} [$lang.shop.payment] {m:number} [lei|leu]? [$lang.q.change]"
    emit="@{_} core.question type=kids.shop.change seek=amount where.paid={m} where.item={i1} where.count={n1}"
    kind=question
    priority=11
    example="I want 2 pencils and I pay 10 lei. How much change do I get?"

@pat.kids.shop.q.change.want.c core.pattern
    match="[$lang.shop.want] [a|an] {i1:lex.kids.shop.items} and [a|an] {i2:lex.kids.shop.items} [$lang.shop.payment] {m:number} [lei|leu]? [$lang.q.change]"
    emit="@{_} core.question type=kids.shop.change seek=amount where.paid={m} where.item={i1} where.count=1 where.item2={i2} where.count2=1"
    kind=question
    priority=11
    example="I want a ball and a pencil and I pay 20 lei. What is the change?"

@pat.kids.shop.revise.count core.pattern
    match="{n:number} [of_them|of_those|of_these|of_it]"
    emit="@{_} core.request action=shop.reviseLast arg.count={n}"
    kind=request
    priority=11
    example="Three of them."
    doc="SOPWORLD-1b: the count of the last purchase is revised (the first count was only assumed to be 1)."

@pat.kids.shop.buy.something core.pattern
    canonical="I buy something."
    match="[$lang.shop.want|i_want_to_buy|i_will_buy|i_buy|i_bought|i_am_buying|i_ll_buy|i_d_like_to_buy] [$lang.quant.something]"
    emit="@{_} core.request action=chat.ask arg.q=\"What do you want to buy?\" arg.template=\"i buy <x>\" arg.world=\"kids.shop\""
    kind=request
    priority=12
    example="I buy something."
    doc="The item is not said: ask for it (a question back), buy nothing and guess nothing."
