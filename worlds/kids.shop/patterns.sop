@pat.kids.shop.money core.pattern
    match="i [only]? have [got]? {n:number} [lei|leu] [now|left|today|in_my_wallet|in_my_piggy_bank|with_me|to_spend]?"
    emit="@{_} kids.shop.money count={n} unit=leu"
    kind=statement
    priority=10
    example="I have 20 lei."

@pat.kids.shop.money.start core.pattern
    match="i [start|started|begin|began] with {n:number} [lei|leu]"
    emit="@{_} kids.shop.money count={n} unit=leu"
    kind=statement
    priority=10
    example="I start with 30 lei."

@pat.kids.shop.money.wallet core.pattern
    match="my [wallet|piggy_bank|purse|money_box] [has|had|holds|contains] {n:number} [lei|leu]"
    emit="@{_} kids.shop.money count={n} unit=leu"
    kind=statement
    priority=10
    example="My wallet has 15 lei."

@pat.kids.shop.income core.pattern
    match="i [get|got|find|found|receive|received|earn|earned|win|won|save|saved] {n:number} [more]? [lei|leu]"
    emit="@{_} kids.shop.income count={n} unit=leu"
    kind=statement
    priority=10
    example="I found 5 lei."

@pat.kids.shop.income.from core.pattern
    match="[my]? [mom|mum|dad|mother|father|grandma|grandpa|grandmother|grandfather|aunt|uncle|friend|teacher|sister|brother]? {g:agent?} [gives|gave|give] me {n:number} [more]? [lei|leu]"
    emit="@{_} kids.shop.income count={n} unit=leu"
    kind=statement
    priority=10
    example="Ana gives me 10 lei."

@pat.kids.shop.expense core.pattern
    match="i [spend|spent|lose|lost|pay|paid|give_away|gave_away] {n:number} [lei|leu]"
    emit="@{_} kids.shop.expense count={n} unit=leu"
    kind=statement
    priority=10
    example="I spent 5 lei."

@pat.kids.shop.buy.a core.pattern
    match="i [buy|bought|purchase|purchased|will_buy|am_buying|am_going_to_buy] {n1:number} {i1:lex.kids.shop.items}"
    emit="@{_} kids.shop.purchase item={i1} count={n1}"
    kind=statement
    priority=12
    example="I buy 3 pencils."

@pat.kids.shop.buy.b core.pattern
    match="i [buy|bought|purchase|purchased|will_buy|am_buying|am_going_to_buy] [a|an] {i1:lex.kids.shop.items}"
    emit="@{_} kids.shop.purchase item={i1} count=1"
    kind=statement
    priority=12
    example="I buy a ball."

@pat.kids.shop.buy.c core.pattern
    match="i [buy|bought|purchase|purchased|will_buy|am_buying|am_going_to_buy] {n1:number} {i1:lex.kids.shop.items} and {n2:number} {i2:lex.kids.shop.items}"
    emit="@{_} kids.shop.purchase item={i1} count={n1}\n@{_1} kids.shop.purchase item={i2} count={n2}"
    kind=statement
    priority=12
    example="I buy 2 balls and 3 pencils."

@pat.kids.shop.buy.d core.pattern
    match="i [buy|bought|purchase|purchased|will_buy|am_buying|am_going_to_buy] [a|an] {i1:lex.kids.shop.items} and {n2:number} {i2:lex.kids.shop.items}"
    emit="@{_} kids.shop.purchase item={i1} count=1\n@{_1} kids.shop.purchase item={i2} count={n2}"
    kind=statement
    priority=12
    example="I buy a ball and 2 pencils."

@pat.kids.shop.buy.e core.pattern
    match="i [buy|bought|purchase|purchased|will_buy|am_buying|am_going_to_buy] {n1:number} {i1:lex.kids.shop.items} and [a|an] {i2:lex.kids.shop.items}"
    emit="@{_} kids.shop.purchase item={i1} count={n1}\n@{_1} kids.shop.purchase item={i2} count=1"
    kind=statement
    priority=12
    example="I buy 3 pencils and a ball."

@pat.kids.shop.buy.f core.pattern
    match="i [buy|bought|purchase|purchased|will_buy|am_buying|am_going_to_buy] [a|an] {i1:lex.kids.shop.items} and [a|an] {i2:lex.kids.shop.items}"
    emit="@{_} kids.shop.purchase item={i1} count=1\n@{_1} kids.shop.purchase item={i2} count=1"
    kind=statement
    priority=12
    example="I buy a ball and a pencil."

@pat.kids.shop.price.costs core.pattern
    match="[a|an|the|one]? {item:noun} [costs|cost] {n:number} [lei|leu] [each|now|today]?"
    emit="@{_} kids.shop.price item={item} cost={n}"
    kind=statement
    priority=10
    example="A ball costs 7 lei."

@pat.kids.shop.price.is core.pattern
    match="[a|an|the|one]? {item:lex.kids.shop.items} [is|are] {n:number} [lei|leu] [each|now|today]?"
    emit="@{_} kids.shop.price item={item} cost={n}"
    kind=statement
    priority=10
    example="The pencil is 3 lei."

@pat.kids.shop.price.of core.pattern
    match="the [price|cost] of [a|an|the|one]? {item:noun} is {n:number} [lei|leu]"
    emit="@{_} kids.shop.price item={item} cost={n}"
    kind=statement
    priority=10
    example="The price of a kite is 9 lei."

@pat.kids.shop.q.price.cost core.pattern
    match="how_much [does|do|did|will]? [a|an|the|one]? {item:noun} cost [each|now|today]?"
    emit="@{_} core.question type=kids.shop.price seek=cost where.item={item}"
    kind=question
    priority=9
    example="How much does a ball cost?"

@pat.kids.shop.q.price.is core.pattern
    match="how_much [is|are|was] [a|an|the|one]? {item:noun} [each|now|today]?"
    emit="@{_} core.question type=kids.shop.price seek=cost where.item={item}"
    kind=question
    priority=9
    example="How much is the notebook?"

