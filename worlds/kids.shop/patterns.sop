    match="[$kids.shop.g1_i_need_to_find_out]? [$kids.shop.g1_i_need_to_find_out]? [$kids.shop.g22_just_so_you_know]? [i|we] [just|also|then|now|today|again|even|already|finally|only]? [pick_up|picked_up|take_in|took_in|am_given|was_given|am_gifted|was_gifted|got_given|have_received|have_got|have_earned|have_found|have_won|have_made|have_collected|ve_received|ve_earned|ve_found|ve_won|ve_made|ve_collected|did_get|did_receive|did_earn|did_find|did_win|did_make|did_collect|get|got|receive|received|earn|earned|find|found|win|won|make|made|collect|collected|gain|gained] [$kids.shop.g109_an_extra]? {n:number} [lei|leu] [from_my_mom|from_my_dad|from_my_grandma|from_my_grandpa|as_a_gift|as_pocket_money|for_my_birthday|just_now|from_mom|from_dad|from_grandma|from_grandpa|more|extra|today|now|again|too]? ... [$lang.tail.filler|$kids.shop.g4_exactly]? [$lang.tail.filler|$kids.shop.g4_exactly]?"
    emit="@{_} kids.shop.income count={n} unit=leu"
    kind=statement
    priority=12
    example="I just found 5 lei."
    example="I earned 5 lei from grandma."

