@tpl.kids.shop.price core.template
    for=kids.shop.price.cost
    text="{note} {value} {unit:plural}."

@tpl.kids.shop.total core.template
    for=kids.shop.total.total
    text="{note} {value} {unit:plural}."

@tpl.kids.shop.balance core.template
    for=kids.shop.balance.amount
    text="You have {value} {unit:plural} {note}."

@tpl.kids.shop.balance.conflicting core.template
    for=kids.shop.balance.amount
    status=conflicting
    text="That does not add up. {note}"

@tpl.kids.shop.afford core.template
    for=kids.shop.affordability.answer
    text="{value:cap}. {note}."

@tpl.kids.shop.afford.conflicting core.template
    for=kids.shop.affordability.answer
    status=conflicting
    text="That does not add up. {note}"

@tpl.kids.shop.change core.template
    for=kids.shop.change.amount
    text="Your change from {paid} lei is {value} {unit:plural}."

@tpl.kids.shop.change.conflicting core.template
    for=kids.shop.change.amount
    status=conflicting
    text="{note}"

@tpl.kids.shop.ack.money core.template
    for=ack.kids.shop.money
    text="OK, you have {count} {unit:plural}."

@tpl.kids.shop.ack.income core.template
    for=ack.kids.shop.income
    text="OK, you got {count} {unit:plural}."

@tpl.kids.shop.ack.expense core.template
    for=ack.kids.shop.expense
    text="OK, you spent {count} {unit:plural}."

@tpl.kids.shop.ack.purchase core.template
    for=ack.kids.shop.purchase
    text="OK, you bought {count} {item:plural}."

@tpl.kids.shop.ack.price core.template
    for=ack.kids.shop.price
    text="OK, one {item} costs {cost} lei."

@tpl.kids.shop.leftafter core.template
    for=kids.shop.leftafter.amount
    text="You would have {value} {unit:plural} left."

@tpl.kids.shop.leftafter.conflicting core.template
    for=kids.shop.leftafter.amount
    status=conflicting
    text="{note}"

@tpl.kids.shop.reviseLast core.template
    for=action.shop.reviseLast
    text="OK, that makes {value} {unit:plural}."

@tpl.kids.shop.reviseLast.conflicting core.template
    for=action.shop.reviseLast
    status=conflicting
    text="That does not add up. {note}"

@tpl.kids.shop.reviseLast.missing core.template
    for=action.shop.reviseLast
    status=missing
    text="I have no purchase to change yet."

@tpl.kids.shop.ack.negated.spend core.template
    for=ack.kids.shop.negated
    when="verb=spend"
    text="OK, you did not spend {count} lei. Nothing changes."

@tpl.kids.shop.ack.negated.get core.template
    for=ack.kids.shop.negated
    when="verb=get"
    text="OK, you did not get {count} lei. Nothing changes."

@tpl.kids.shop.ack.negated.give core.template
    for=ack.kids.shop.negated
    when="verb=give"
    text="OK, you did not give {count} lei. Nothing changes."

@tpl.kids.shop.ack.negated.n core.template
    for=ack.kids.shop.negated
    when="count!=none"
    text="OK, you did not {verb} {count} {item:plural}. Nothing changes."

@tpl.kids.shop.ack.negated core.template
    for=ack.kids.shop.negated
    text="OK, you did not {verb} the {item}. Nothing changes."
