@describe.add.list core.describe
    op=tasks.add
    intent=command
    emit="@{_} core.request action=tasks.add arg.item=\"{item}\" arg.list=\"{list}\""
    skip=short
    priority=10
    effect="adds an item to a named list"

@describe.add.list.item core.describe.arg
    of=$describe.add.list
    name=item
    class=words

@describe.add.list.list core.describe.arg
    of=$describe.add.list
    name=list
    class=lex.kids.tasks.listnames

@describe.add.list.en core.describe.words
    of=$describe.add.list
    lang=en
    nosubject=true
    verb=$w.en.add.tasks.add
    verb=$w.en.put.tasks.add
    verb=$w.en.write.tasks.add
    verb=$w.en.append.tasks.add
    verb=$w.en.include.tasks.add
    verb=$w.en.insert.tasks.add
    verb=$w.en.stick.tasks.add
