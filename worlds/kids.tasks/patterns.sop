    kind=request
    priority=13
    example="Write call grandma on my to-do list."

@pat.kids.tasks.add8 core.pattern
    match="i want to add {item:words} to [my|the|our]? {list:words} list"
    emit="@{_} core.request action=tasks.add arg.item=\"{item}\" arg.list=\"{list}\""
    kind=request
    priority=13
    example="I want to add eggs to my shopping list."

@pat.kids.tasks.add.and core.pattern
    match="[$lang.lead.polite]? add {a:words} to [my|the|our]? list and add {b:words} to [my|the|our]? list"
    emit="@{_} core.request action=tasks.add arg.item=\"{a}\" arg.list=to-do\n@{_1} core.request action=tasks.add arg.item=\"{b}\" arg.list=to-do"
    kind=request
    priority=14
    example="Add bread to my list and add milk to my list."

@pat.kids.tasks.add.and.list core.pattern
    match="[$lang.lead.polite]? add {a:words} to [my|the|our]? {la:words} list and add {b:words} to [my|the|our]? {lb:words} list"
    emit="@{_} core.request action=tasks.add arg.item=\"{a}\" arg.list=\"{la}\"\n@{_1} core.request action=tasks.add arg.item=\"{b}\" arg.list=\"{lb}\""
    kind=request
    priority=14
    example="Add bread to my shopping list and add a book to my homework list."

@pat.kids.tasks.neg.done core.pattern
    canonical="I didn't buy milk."
    match="i [did_not|have_not|had_not|never] [finish|finished|complete|completed|buy|bought|do|done] {item:words}"
    emit="@{_} core.request action=tasks.notDone arg.item=\"{item}\""
    kind=request
    priority=12
    example="I didn't buy milk."
    example="I have not finished my homework."

