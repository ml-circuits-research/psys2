@pat.kids.tasks.add1 core.pattern
    canonical="Add milk to my list."
    match="[$lang.lead.polite]? add {item:words} to [my|the|our]? list"
    emit="@{_} core.request action=tasks.add arg.item=\"{item}\" arg.list=to-do arg.assumed=true"
    kind=request
    priority=13
    example="Add milk to my list."

@pat.kids.tasks.add2 core.pattern
    match="[$lang.lead.polite]? add {item:words} to [my|the|our]? {list:words} list"
    emit="@{_} core.request action=tasks.add arg.item=\"{item}\" arg.list=\"{list}\""
    kind=request
    priority=13
    example="Add milk to my shopping list."

@pat.kids.tasks.add3 core.pattern
    canonical="Put bread on my list."
    match="put {item:words} on [my|the|our]? list"
    emit="@{_} core.request action=tasks.add arg.item=\"{item}\" arg.list=to-do arg.assumed=true"
    kind=request
    priority=13
    example="Put bread on my list."

@pat.kids.tasks.add4 core.pattern
    match="put {item:words} on [my|the|our]? {list:words} list"
    emit="@{_} core.request action=tasks.add arg.item=\"{item}\" arg.list=\"{list}\""
    kind=request
    priority=13
    example="Put bread on my shopping list."

@pat.kids.tasks.add5 core.pattern
    match="i [need_to|have_to|must|want_to] buy {item:words}"
    emit="@{_} core.request action=tasks.add arg.item=\"{item}\" arg.list=shopping"
    kind=request
    priority=11
    example="I need to buy milk."

@pat.kids.tasks.add6 core.pattern
    match="i [need_to|have_to|must|should] {item:words}"
