    emit="@{_} core.question type=kids.time.gap seek=count where.from={from} where.to={to}"
    kind=question
    priority=11
    example="How many days until Friday if today is Monday?"

@pat.kids.time.q.gap.from core.pattern
    match="how_many days [are_there|is_it|are|is]? [from|between] {from:lex.kids.time.days} [to|and] {to:lex.kids.time.days}"
    emit="@{_} core.question type=kids.time.gap seek=count where.from={from} where.to={to}"
    kind=question
    priority=11
    example="How many days from Monday to Friday?"

@pat.kids.time.q.gap.today core.pattern
    match="how_many days [are_there|is_it|are|is]? [until|till|to|before] {to:lex.kids.time.days}"
    emit="@{_} core.question type=kids.time.gap seek=count where.from=today where.to={to}"
    kind=question
    priority=10
    example="How many days until Saturday?"

@pat.kids.time.q.gap.if core.pattern
    match="[if|when] today is {from:lex.kids.time.days} how_many days [are_there|is_it|are|is]? [until|till|to|before] {to:lex.kids.time.days}"
    emit="@{_} core.question type=kids.time.gap seek=count where.from={from} where.to={to}"
    kind=question
    priority=11
    example="If today is Monday, how many days until Friday?"

@pat.kids.time.q.hours.gap core.pattern
