@pat.media.music.x2.note.beats core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite|i_d_like_to_hear]? [$media.music.g75_play] [a|the|an]? {reg:lex.media.music.registers?} [note]? {note:lex.media.music.notes} {oct:number?} {inst:lex.media.music.instruments?} [$media.music.g68_for] {n:number} [beats|beat|counts|count|bars_of_beats]"
