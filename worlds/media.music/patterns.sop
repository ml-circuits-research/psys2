@pat.media.music.play.bare core.pattern
    match="[$lang.lead.polite|pls]? [play|play_me|put_on|sing] [pls]?"
    emit="@{_} core.request action=music.askWhat"
    kind=request
    priority=11
    example="Play."
    doc="A play command with nothing to play: asks what to play and expects the answer as the next utterance (discourse pending, spec 11). On other tabs a game may claim a bare play."

@pat.media.music.song.weak core.pattern
    canonical="Give me Ode to Joy."
    match="{pre:lex.media.music.polite?} {v:lex.media.music.playverbs.weak} [a|an|the|some|that|this|my|your]? [song|tune|melody|piece|nursery_rhyme]? {title:lex.media.music.songtitles}"
    emit="@{_} core.request action=music.playAny arg.title=\"{title}\""
    kind=request
    priority=10
    example="Give me Ode to Joy."
    example="Put on Happy Birthday."

@pat.media.music.song.weak.long core.pattern
    match="{pre:lex.media.music.polite?} {v:lex.media.music.playverbs.weak} [a|an|the|some|that|this|my|your]? [song|tune|melody|piece|nursery_rhyme]? {t1:lex.media.music.songstarts} {rest:words(5)}"
    emit="@{_} core.request action=music.playAny arg.title=\"{t1} {rest}\""
