    example="Give me twinkle twinkle little star."

@pat.media.music.song.weak.start core.pattern
    match="{pre:lex.media.music.polite?} {v:lex.media.music.playverbs.weak} [a|an|the|some|that|this|my|your]? [song|tune|melody|piece|nursery_rhyme]? {t1:lex.media.music.songstarts}"
