    emit="@{_} core.request action=music.frequency arg.reg={reg} arg.note={note} arg.oct={oct}"
    kind=request
    priority=12
    example="How many hertz is middle C?"

@pat.media.music.q.enh core.pattern
    match="[what_is|what_are|tell_me] [another|the_other|an_alternative|the_enharmonic|the_alternate|the_equivalent|an_other] [name|names|spelling|note]? [for|of] {note:lex.media.music.notes}"
    emit="@{_} core.request action=music.enharmonic arg.note={note}"
    kind=request
    priority=12
    example="What is another name for C sharp?"
    example="What is the enharmonic of A flat?"

@pat.media.music.s.tempo core.pattern
    match="[what_is|what_was|tell_me|show_me|what_are] [the|your|my|our]? [tempo|bpm|beats_per_minute]"
    emit="@{_} core.request action=music.status arg.what=tempo"
    kind=request
    priority=12
    example="What is the tempo?"
    example="Tell me the bpm."

@pat.media.music.s.tempo2 core.pattern
    match="[how_fast|how_slow] [is|are_you_playing|is_it|is_the_music|are_we_playing|is_the_tempo]"
    emit="@{_} core.request action=music.status arg.what=tempo"
    kind=request
    priority=12
    example="How fast is it?"

@pat.media.music.s.inst core.pattern
    match="[what|which] [instrument|sound] [is|are|am|do] [this|that|it|you_using|you_playing|selected|being_used|in_use|used|set|do_you_use|are_we_using|i_using|playing|you_use]"
    emit="@{_} core.request action=music.status arg.what=instrument"
    kind=request
    priority=12
    example="What instrument is this?"
    example="Which instrument are you using?"

@pat.media.music.s.volume core.pattern
    match="[how_loud|what_is_the_volume|what_volume|how_loud_is_it|how_loud_is_the_music|what_is_the_volume_level|what_is_the_current_volume|how_loud_are_you]"
    emit="@{_} core.request action=music.status arg.what=volume"
    kind=request
    priority=12
    example="How loud is it?"

@pat.media.music.s.key core.pattern
    match="what key [are_we_in|am_i_in|are_you_in|are_we_playing_in|is_selected|is_set|are_we_using|do_we_have]"
    emit="@{_} core.request action=music.status arg.what=key"
    kind=request
    priority=12
    example="What key are we in?"

@pat.media.music.s.key2 core.pattern
    match="[what_is|which_is|tell_me] [the|our|my]? [key|current_key]"
    emit="@{_} core.request action=music.status arg.what=key"
    kind=request
    priority=12
    example="What is the key?"

@pat.media.music.s.playing core.pattern
    match="[what_is_playing|what_are_you_playing|what_are_you_playing_now|what_did_you_play|what_did_you_just_play|what_was_that|what_is_this_song|what_is_this_tune|what_song_is_this|what_song_is_that|what_is_that_song|what_am_i_hearing|what_is_playing_now|what_are_we_listening_to|what_is_this_melody|what_is_the_current_melody]"
    emit="@{_} core.request action=music.status arg.what=playing"
    kind=request
    priority=12
    example="What is playing?"
    example="What are you playing?"

@pat.media.music.s.isplaying core.pattern
    match="[is|are] [the_music|you|it|anything|something|the_piano] [playing|looping|on]"
    emit="@{_} core.request action=music.status arg.what=isplaying"
    kind=request
    priority=12
    example="Is the music playing?"
    example="Are you playing?"

@pat.media.music.s.loop core.pattern
    match="[is_loop_on|is_the_loop_on|is_it_looping|are_you_looping|is_looping_on|am_i_looping|is_it_on_repeat|is_the_loop_active]"
    emit="@{_} core.request action=music.status arg.what=loop"
    kind=request
    priority=12
    example="Is the loop on?"

@pat.media.music.song.who core.pattern
    match="[who_wrote|who_composed|who_is_the_composer_of|who_is_the_author_of|who_made|who_created|who_is_the_writer_of|who_came_up_with|who_composed_the_music_of|who_wrote_the_music_for|who_is_the_composer_of_the_song|who_wrote_the_song] [the|this|that|a|an]? [song|tune|melody|piece]? {title:words(8)}"
    emit="@{_} core.request action=music.songInfo arg.title=\"{title}\" arg.what=composer"
    kind=request
    priority=12
    example="Who wrote Ode to Joy?"
    example="Who composed Brahms Lullaby?"
    example="Who wrote this song?"

@pat.media.music.song.key core.pattern
    match="[what|which] key [is|was] [the|this|that]? [song|tune|melody]? {title:words(8)} [in|written_in|played_in|set_in]"
    emit="@{_} core.request action=music.songInfo arg.title=\"{title}\" arg.what=key"
    kind=request
    priority=12
    example="What key is Twinkle Twinkle in?"
    example="Which key is it in?"

@pat.media.music.song.tempo core.pattern
    match="[what_is|what_was|how_fast_is] [the]? [tempo|speed|bpm] [of|for] [the]? [song|tune|melody]? {title:words(8)}"
    emit="@{_} core.request action=music.songInfo arg.title=\"{title}\" arg.what=tempo"
    kind=request
    priority=12
    example="What is the tempo of Jingle Bells?"

@pat.media.music.song.about core.pattern
    match="[tell_me_about|what_do_you_know_about|describe|info_about|tell_me_more_about|what_can_you_tell_me_about|tell_me_something_about] [the|this|that]? [song|tune|melody]? {title:words(8)}"
    emit="@{_} core.request action=music.songInfo arg.title=\"{title}\" arg.what=about"
    kind=request
    priority=9
    example="Tell me about Happy Birthday."
    example="What do you know about Frere Jacques?"

@pat.media.music.song.long core.pattern
    match="[how_long_is|how_long_does_it_take_to_play|how_many_seconds_is] [the]? [song|tune|melody]? {title:words(8)}"
    emit="@{_} core.request action=music.songInfo arg.title=\"{title}\" arg.what=length"
    kind=request
    priority=9
    example="How long is Ode to Joy?"
