@music acts.schema
    noun="music"
    doc="Music as a schema (spec 21): a song, a melody the user composes, a note, a chord, a scale; they are played with an instrument, a tempo, a volume, a key, in a loop or not. The synth and the sheet music are drawn by the tab (Tone.js, abcjs); the player state, the note readers and the music theory (theory.mjs, abc.mjs, vendored tonal) are the world's own code in music.mjs. The schema only says what is said."
    hooks=hooks.mjs
    own=melodyShow:music.melodyShow
    own=showNotes:music.showNotes
    own=showScore:music.showScore
    own=listSongs:music.listSongs
    own=listInstruments:music.listInstruments
    own=listTypes:music.listTypes
    own=scaleNotes:music.scaleNotes
    own=chordNotes:music.chordNotes
    own=chordName:music.chordName
    own=keySig:music.keySig
    own=keyWith:music.keyWith
    own=interval:music.interval
    own=above:music.above
    own=relative:music.relative
    own=keyChords:music.keyChords
    own=frequency:music.frequency
    own=enharmonic:music.enharmonic
    own=status:music.status
    own=songInfo:music.songInfo
    own=askWhat:music.askWhat
    own=instrument:music.instrument
    own=key:music.key
    own=melodySet:music.melodySet
    own=octave:music.octave
    own=playAny:music.playAny
    own=playNote:music.playNote
    own=playScale:music.playScale
    own=random:music.random
    own=replay:music.replay
    own=stop:music.stop
    own=tempo:music.tempo
    own=transpose:music.transpose
    own=transposeTo:music.transposeTo
    own=volume:music.volume
    sample=song
    playable=yes
    valued=yes
    scale=yes
    acts=make
    acts=remove
    acts=change
    acts=pick
    acts=ask
    acts=undo
    acts=redo

@music.song acts.kind
    plural=songs
    named=yes
    word=tune
    word=tunes
    word=track
    word=tracks
    word=piece
    word=pieces

@music.melody acts.kind
    plural=melodies
    word=composition
    word=compositions

@music.note acts.kind
    plural=notes
    word=pitch
    word=pitches

@music.chord acts.kind
    plural=chords
    word=triad
    word=triads
    word=arpeggio
    word=arpeggios

@music.scale acts.kind
    plural=scales

@music.tempo acts.attr
    of=song
    of=melody
    type=number
    min=30
    max=240
    default=100
    more=faster
    more=quicker
    less=slower
    word=speed
    word=bpm
    word=pace

@music.volume acts.attr
    of=song
    of=melody
    of=note
    of=chord
    of=scale
    type=number
    min=0
    max=100
    default=70
    more=louder
    less=quieter
    less=softer
    word=loudness
    word=sound_level

@music.instrument acts.attr
    of=song
    of=melody
    of=note
    of=chord
    of=scale
    type=enum
    values=piano
    values=keyboard
    values=grand_piano
    values=electric_piano
    values=organ
    values=church_organ
    values=flute
    values=whistle
    values=recorder
    values=string
    values=strings
    values=violin
    values=cello
    values=fiddle
    values=orchestra
    values=bell
    values=bells
    values=glockenspiel
    values=chime
    values=celesta
    values=bass
    values=bass_guitar
    values=double_bass
    values=marimba
    values=xylophone
    values=vibraphone
    word=sound

@music.key acts.attr
    of=song
    of=melody
    type=text

@music.loop acts.attr
    of=song
    of=melody
    of=note
    of=chord
    of=scale
    type=bool
    word=repeat
    word=repeating
    word=looping
    word=loops

@music.pitch acts.attr
    of=song
    of=melody
    of=note
    type=number
    min=-36
    max=36
    default=0
    more=higher
    less=lower
    word=octave

@music.duration acts.attr
    of=note
    type=number
    min=1
    max=16
    default=2
    more=longer
    less=shorter
    word=length
