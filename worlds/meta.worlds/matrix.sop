# meta.worlds as a matrix: which world should take a message, by rules with reasons (spec 19). Nothing here is a list of phrases and nothing is per message.
#
# The cards (kb.sop, generated) say what each world is. The host tells, per turn, what is live (`meta.worlds.live`, `.scene`) and what the message is made of
# (`.msg`: its words, its word pairs and triples joined with _, and whether it is a piece without a verb of its own), and optionally the encoder's points as a
# prior (`.prior`). The rules derive votes (a reason with points: rule, world, the word it rests on) and blocks (a reason a world cannot take the message).
# The host adds the points of the votes per world, drops the blocked worlds, and says the reasons in plain words (the `rule` names are the keys of the words).
#
# Points: naming a world 100; an action a world has been asked for by name ("open the chess tab") 130; a question the world asked 90 (answering) or 25
# (anything); a follow-up piece of the world of the last action 80; a thing the message names that is in a scene 70; an action word and a kind of thing of
# the same world 45; one of them alone 25 (10 for an action word and 6 for a thing that three or four worlds share; five or more worlds: not on the card); a question frame 30;
# a thing of the knowledge catalog for a world that takes any 8; the open tab 12; a world that answered lately 8. The encoder is one prior (at most its weight, 30 by default): it never reaches a referent or
# a running game, and a block is not a vote: nothing outvotes it.

# ---- facts about words
@mw.sw.play meta.worlds.start word=play
@mw.sw.start meta.worlds.start word=start
@mw.sw.new meta.worlds.start word=new
@mw.sw.begin meta.worlds.start word=begin
@mw.sw.restart meta.worlds.start word=restart
@mw.sw.again meta.worlds.start word=again
@mw.any.shell meta.worlds.anywhere world=ui.shell
@mw.any.help meta.worlds.anywhere world=ui.help
@mw.any.common meta.worlds.anywhere world=kids.common

# ---- patterns
@mw.m.any meta.worlds.msg word=?x
@mw.m.y meta.worlds.msg word=?y
@mw.m.frag meta.worlds.msg frag=yes
@mw.m.cat meta.worlds.msg catalog=?x
@mw.s.word meta.worlds.start word=?x
@mw.c.name meta.worlds.card id=?w name=?x
@mw.c.act meta.worlds.card id=?w act=?x
@mw.c.acty meta.worlds.card id=?w act=?x
@mw.c.actshared meta.worlds.card id=?w actshared=?x
@mw.c.thing meta.worlds.card id=?w thing=?x
@mw.c.thingy meta.worlds.card id=?w thing=?y
@mw.c.thingshared meta.worlds.card id=?w thingshared=?x
@mw.c.frame meta.worlds.card id=?w frame=?x
@mw.c.catalog meta.worlds.card id=?w catalog=yes
@mw.c.nav meta.worlds.card id=?n navact=?x
@mw.c.run meta.worlds.card id=?w run=needs
@mw.c.id meta.worlds.card id=?w
@mw.sc meta.worlds.scene world=?w thing=?x
@mw.l.asked meta.worlds.live world=?w asked=yes
@mw.l.last meta.worlds.live world=?w last=yes
@mw.l.lastany meta.worlds.live last=yes
@mw.l.active meta.worlds.live world=?w active=yes
@mw.l.running meta.worlds.live world=?w running=yes
@mw.l.recent meta.worlds.live world=?w recent=yes
@mw.l.notab meta.worlds.live notab=yes
@mw.p.prior meta.worlds.prior world=?w pts=?p
@mw.a.any meta.worlds.anywhere world=?w
@mw.st meta.worlds.starts yes=yes
@mw.v.named.o meta.worlds.vote world=?o rule=named
@mw.v.named.w meta.worlds.vote world=?w rule=named
@mw.v.ref.w meta.worlds.vote world=?w rule=referent

# ---- the message starts something (a game, a new picture)
@mw.r.starts core.rule when=$mw.m.any when=$mw.s.word then=$mw.st

# ---- votes
@mw.o.named meta.worlds.vote world=?w rule=named weight=100 via=?x
@mw.r.named core.rule when=$mw.c.name when=$mw.m.any then=$mw.o.named
@mw.o.nav meta.worlds.vote world=?n rule=nav weight=130 via=?x
@mw.r.nav core.rule when=$mw.c.nav when=$mw.m.any when=$mw.v.named.o then=$mw.o.nav
@mw.o.asked meta.worlds.vote world=?w rule=asked weight=90 via=answer
@mw.r.asked core.rule when=$mw.l.asked when=$mw.m.frag then=$mw.o.asked
@mw.o.askedany meta.worlds.vote world=?w rule=askedany weight=25 via=question
@mw.r.askedany core.rule when=$mw.l.asked then=$mw.o.askedany
@mw.o.followup meta.worlds.vote world=?w rule=followup weight=80 via=last
@mw.r.followup core.rule when=$mw.l.last when=$mw.m.frag then=$mw.o.followup
@mw.o.fragrun meta.worlds.vote world=?w rule=fragrun weight=60 via=running
@mw.r.fragrun core.rule when=$mw.l.running when=$mw.m.frag then=$mw.o.fragrun
@mw.o.fragtab meta.worlds.vote world=?w rule=fragtab weight=50 via=tab
@mw.r.fragtab core.rule when=$mw.l.active when=$mw.m.frag then=$mw.o.fragtab
@mw.o.referent meta.worlds.vote world=?w rule=referent weight=70 via=?x
@mw.r.referent core.rule when=$mw.sc when=$mw.m.any then=$mw.o.referent
@mw.o.actthing meta.worlds.vote world=?w rule=actthing weight=45 via=?x
@mw.r.actthing core.rule when=$mw.c.acty when=$mw.m.any when=$mw.c.thingy when=$mw.m.y then=$mw.o.actthing
@mw.o.act meta.worlds.vote world=?w rule=act weight=25 via=?x
@mw.r.act core.rule when=$mw.c.act when=$mw.m.any then=$mw.o.act
@mw.o.thing meta.worlds.vote world=?w rule=thing weight=25 via=?x
@mw.r.thing core.rule when=$mw.c.thing when=$mw.m.any then=$mw.o.thing
@mw.o.actshared meta.worlds.vote world=?w rule=actshared weight=10 via=?x
@mw.r.actshared core.rule when=$mw.c.actshared when=$mw.m.any then=$mw.o.actshared
@mw.o.thingshared meta.worlds.vote world=?w rule=thingshared weight=6 via=?x
@mw.r.thingshared core.rule when=$mw.c.thingshared when=$mw.m.any then=$mw.o.thingshared
@mw.o.frame meta.worlds.vote world=?w rule=frame weight=30 via=?x
@mw.r.frame core.rule when=$mw.c.frame when=$mw.m.any then=$mw.o.frame
@mw.o.catalog meta.worlds.vote world=?w rule=catalog weight=8 via=?x
@mw.r.catalog core.rule when=$mw.c.catalog when=$mw.m.cat then=$mw.o.catalog
@mw.o.active meta.worlds.vote world=?w rule=active weight=12 via=tab
@mw.r.active core.rule when=$mw.l.active then=$mw.o.active
@mw.o.recent meta.worlds.vote world=?w rule=recent weight=8 via=recent
@mw.r.recent core.rule when=$mw.l.recent then=$mw.o.recent
@mw.o.prior meta.worlds.vote world=?w rule=encoder weight=?p via=encoder
@mw.r.prior core.rule when=$mw.p.prior then=$mw.o.prior

# ---- blocks
# a world that needs something running, with nothing running, not the open tab (and some tab is open: with none, a move is how a game starts), not named, and a message that does not start anything
@mw.o.notrunning meta.worlds.block world=?w rule=notrunning
@mw.r.notrunning core.rule when=$mw.c.run not=$mw.l.running not=$mw.l.active not=$mw.l.notab not=$mw.st not=$mw.v.named.w then=$mw.o.notrunning
# a piece without a verb of its own is taken by the world of the last action, the open tab, a running game or the world that asked; another world cannot take it
# unless the piece names a thing of its scene or names it (SCENE-NATURAL P1)
@mw.o.nocont meta.worlds.block world=?w rule=nocontinuation
@mw.r.nocont core.rule when=$mw.c.id when=$mw.m.frag when=$mw.l.lastany not=$mw.l.notab not=$mw.a.any not=$mw.l.last not=$mw.l.active not=$mw.l.running not=$mw.l.asked not=$mw.v.ref.w not=$mw.v.named.w then=$mw.o.nocont

# ---- the reasons in plain words (the trace says these)
@mw.say.named meta.worlds.say rule=named text="you named the {name} ({via})"
@mw.say.nav meta.worlds.say rule=nav text="you asked to go to another tab ({via})"
@mw.say.asked meta.worlds.say rule=asked text="the {name} asked a question and this answers it"
@mw.say.askedany meta.worlds.say rule=askedany text="the {name} asked a question last turn"
@mw.say.followup meta.worlds.say rule=followup text="it continues the last thing we did in the {name}"
@mw.say.fragrun meta.worlds.say rule=fragrun text="a game is running in the {name} and this is a piece of it"
@mw.say.fragtab meta.worlds.say rule=fragtab text="it is a piece of a request and the {name} is open"
@mw.say.referent meta.worlds.say rule=referent text="the {via} is in your {name}"
@mw.say.actthing meta.worlds.say rule=actthing text="{via} and the thing you named both belong to the {name}"
@mw.say.act meta.worlds.say rule=act text="{via} is something you do in the {name}"
@mw.say.thing meta.worlds.say rule=thing text="a {via} is something the {name} holds"
@mw.say.actshared meta.worlds.say rule=actshared text="{via} can be done in the {name} (among others)"
@mw.say.thingshared meta.worlds.say rule=thingshared text="a {via} can be in the {name} (among others)"
@mw.say.frame meta.worlds.say rule=frame text="the question ({via}) is one the {name} answers"
@mw.say.catalog meta.worlds.say rule=catalog text="the {name} takes any thing we know about ({via})"
@mw.say.active meta.worlds.say rule=active text="the {name} is open"
@mw.say.recent meta.worlds.say rule=recent text="the {name} answered lately"
@mw.say.encoder meta.worlds.say rule=encoder text="the model's first guess"
@mw.say.notrunning meta.worlds.say rule=notrunning text="nothing is running in the {name}, so it cannot take this"
@mw.say.nocontinuation meta.worlds.say rule=nocontinuation text="a piece without a verb of its own does not continue anything in the {name}"
