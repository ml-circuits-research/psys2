@gen.plan.timeline.note core.note
    text="Generated from schema.sop by scripts/build-schema-world.mjs (spec 21). Never edited by hand; tests/acts.test.mjs fails when it is stale."

@op.plan.timeline.view core.operation
    impl=view
    semantics=action
    action=plan.timeline.view
    doc="The declaration of this world as a view of the session things (spec 23): its aspects and words."

@op.plan.timeline.adopt core.operation
    impl=adopt
    semantics=action
    action=plan.timeline.adopt
    doc="Takes a thing of the session store into this world: the act make, then change for each attribute (spec 23)."

@op.plan.timeline.make core.operation
    impl=make
    semantics=action
    action=plan.timeline.make
    doc="The act 'make' (spec 21), applied by the generic executor to this world's schema."

