@gen.plan.timeline.note core.note
    text="Generated from schema.sop by scripts/build-schema-world.mjs (spec 21). Never edited by hand; tests/acts.test.mjs fails when it is stale."

@pat.plan.timeline.make core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [$acts.verb.make] [$acts.det]? {thing:rest} [$lang.tail.filler|from_now_on|from_now|from_today|from_here_on|please]?"
    emit="@{_} core.request action=plan.timeline.make arg.thing=\"{thing}\" arg.text=\"{segment}\""
    kind=request
    priority=10
    tabPriority=18
    tabOnly=true
    example="Add a table."

