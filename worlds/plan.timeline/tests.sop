@t.timeline.n0 core.test
    session=tl
    input="Open the timeline tab."
    expectState="ui.shell:activeTab=timeline"

@t.timeline.n1 core.test
    session=tl
    input="add an event called Monday"
    expect="I added event Monday."

@t.timeline.n2 core.test
    session=tl
    input="add an event called Ann"
    expect="I added event Ann."

@t.timeline.n3 core.test
    session=tl
    input="set Monday time to 2"
    expect="Monday"
