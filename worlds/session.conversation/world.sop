    imports=world.kids.common
    formalization=rules
    reasoner=matrix
    compose=world.kids.shop
    compose=world.kids.arith
    compose=world.kids.tasks
    compose=world.kids.time
    compose=world.kids.animals
    compose=world.kids.shapes
    compose=world.user.profile
    language=en
