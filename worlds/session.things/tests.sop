# Ported from kids.shapes (deleted 2026-11-14, plan H3: statements read by type). Wording changes only; with the catalog loaded, a mix not taught is the catalog's (maroon), a taught one wins.

@t.session.things.shapes.n23 core.test
    input="What do red and black make?"
    expect="Red and black make maroon."


@t.session.things.shapes.n43 core.test
    session=shapes.teach
    input="A trapezium has 4 sides."
    expect="OK, a trapezium has 4 sides."


@t.session.things.shapes.n47 core.test
    session=shapes.conflict
    input="A square has 5 sides."
    expect="OK, a square has 5 sides."


@t.session.things.shapes.n51 core.test
    session=shapes.colors
    input="Zebras are black and white."
    expect="OK, zebras are black and white."


@t.session.things.shapes.n55 core.test
    session=shapes.mixing
    input="What do black and red make?"
    expect="Black and red make maroon."


@t.session.things.shapes.n56 core.test
    session=shapes.mixing
    input="Black and red make brown."
    expect="OK, black and red make brown."


@t.session.things.shapes.n60 core.test
