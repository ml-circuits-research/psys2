    canonical="What colour is a banana?"
    match="[$lang.lead.filler|right|also|hi|pls|plz]? [$lang.talk.wh] {a:words(1)} [$lang.talk.isq] [$lang.know.det]? {o:words(3,noun)} [$lang.tail.filler|i_guess|ish|yes|ya|k]?"
