# time.calendar (kids plan, ADR-011): the rows of kids.time, ported when kids.time was switched off (expectations, not wording: "From today (Friday) to Tuesday",
# the host's today and clock where kids.time asked to be told, the seven days of the week where it said the school days), and the rows of the general world.

@t.time.calendar.n1 core.test
    session=g1
    input="Today is Friday."
    expect="OK, today is Friday."

@t.time.calendar.n2 core.test
    session=g1
    doc="The library's cycleAdd round k.time's week from the stated day."
    input="What day is it in 3 days?"
    expect="In 3 days it will be Monday."

@t.time.calendar.n3 core.test
    session=g1
    input="How many days until Wednesday?"
    expect="From today (Friday) to Wednesday is 5 days."

@t.time.calendar.n4 core.test
    input="Which season is March in?"
    expect="March is in spring."

@t.time.calendar.n5 core.test
    session=g2
    doc="A clock phrase of k.time (K7 clock words), read by the library's readClock."
    input="It is half past three."
    expect="OK, it is half past 3."

@t.time.calendar.n6 core.test
    session=g2
    input="What time will it be in 2 hours?"
    expect="It will be half past 5."

@t.time.calendar.n7 core.test
    doc="Nothing stated: the host's clock (the device)."
    input="What time is it?"
    expectStatus=supported

@t.time.calendar.n9 core.test
    input="How many weeks are in a month?"
    expect="There are about 4 weeks in a month."

@t.time.calendar.n10 core.test
    input="It is 30 o'clock."
    expectStatus=conflicting

@t.time.calendar.k.announce core.test
    input="I should tell you, today is Friday. What day is tomorrow?"
    expect="Tomorrow is Saturday."

@t.time.calendar.k.m01 core.test
    input="It is 30 o'clock."
    expect="That does not add up. That is not an hour on a clock: 30 o'clock."
    expectStatus=conflicting

