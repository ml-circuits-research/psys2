# The Avatar tab as a SOP area (read by worlds/sop-area.mjs). The instance is a w.face world drawn from k.faces;
# the act rules compile every native command and the projection derives what is drawn and observed.
@area.types core.type of=app.area
@area.rules.type core.type of=app.area.rules
@area.make.type core.type of=app.area.make
@area.command.type core.type of=app.area.command
@area.choice.type core.type of=app.area.choice
@area.constant.type core.type of=app.area.constant
@area.draw.type core.type of=app.area.draw
@area.offline.type core.type of=app.area.offline

@avatar.area app.area world=ui.avatar instance=w.face knowledge=k.faces knowledge=k.values knowledge=k.parts scope="ui.avatar" frame.w=100 frame.h=100
# The Avatar is a view of one person of the Drawing tab's model: the look projection, the look edit rules and the
# person composition are the Drawing tab's (art.draw), so every garment, face part or trait the people's knowledge and
# rules gain reaches this tab too; view-projection.sop frames that person on the face.
@area.subset.type core.type of=app.area.subset
@area.lookup.type core.type of=app.area.lookup
@avatar.subset.parts app.area.subset area=$avatar.area world=k.parts prefix="names" prefix="psys2" strict=true
@avatar.lookup.person app.area.lookup area=$avatar.area world=k.objects value=person
@avatar.rules.1 app.area.rules area=$avatar.area world=art.draw file="look-projection.sop" n=1
@avatar.rules.2 app.area.rules area=$avatar.area file="view-projection.sop" n=2
@avatar.rules.3 app.area.rules area=$avatar.area world=art.draw file="look-rules.sop" n=3
@avatar.rules.4 app.area.rules area=$avatar.area world=art.draw file="person-rules.sop" n=4
@avatar.rules.5 app.area.rules area=$avatar.area file="act-rules.sop" n=5
@avatar.make app.area.make area=$avatar.area kind=w.face.face name="Avatar" style=plain
@avatar.start app.area.command area=$avatar.area sop="@start avatar.face.preset preset=\"girl\""
@avatar.offline app.area.offline area=$avatar.area prefix="plain-" prefix="figure-"
@avatar.draw app.area.draw area=$avatar.area draw=ui.avatar.view fill=ui.avatar.fill point=ui.avatar.point orient=ui.avatar.orient select=slot

# The interface's open choices, read from the same world.
@avatar.choice.kinds app.area.choice area=$avatar.area input="avatar.characterKinds" type=k.faces.preset key=kind style=plain
@avatar.choice.presets app.area.choice area=$avatar.area input="avatar.presets" type=k.faces.preset key=name style=plain
@avatar.choice.expressions app.area.choice area=$avatar.area input="avatar.expressions" type=k.faces.expression key=name style=plain
@avatar.choice.slots app.area.choice area=$avatar.area input="avatar.visibleSlots" type=w.face.slot key=slot
@avatar.choice.variants app.area.choice area=$avatar.area input="avatar.variants" type=ui.avatar.variantChoice key=name
@avatar.choice.colours app.area.choice area=$avatar.area input="avatar.colours" type=k.faces.colour key=name
@avatar.choice.sizes app.area.choice area=$avatar.area input="avatar.sizes" type=ui.avatar.size key=grade
@avatar.choice.directions app.area.choice area=$avatar.area input="avatar.directions" type=ui.avatar.step key=place
# The features a part can be given (act-rules.sop: ui.avatar.feature, from the plain-word features of the variants).
@avatar.choice.features app.area.choice area=$avatar.area input="avatar.features" type=ui.avatar.feature key=property style=plain
@avatar.choice.featureValues app.area.choice area=$avatar.area input="avatar.featureValues" type=ui.avatar.feature key=value style=plain
@avatar.choice.resizeRelated app.area.choice area=$avatar.area input="avatar.resizeRelated" type=ui.avatar.size key=none
@avatar.choice.sizeRelated app.area.choice area=$avatar.area input="avatar.sizeRelated" type=ui.avatar.size key=none
@avatar.min app.area.constant area=$avatar.area input="avatar.minScale" value=0.6
@avatar.max app.area.constant area=$avatar.area input="avatar.maxScale" value=1.5

# The controls of the tab's inspector. A view builds them generically: each sends its operation with the chosen
# option as `param`; `target=selected` adds the selected object (as `list` when declared; `except` names selections it does not apply to), `when` limits a
# control to a selected object that exists or not. Options come from app.observe.option facts.
@area.control.type core.type of=app.area.control
@avatar.control.preset app.area.control area=$avatar.area n=1 label="Composition" operation="avatar.face.preset" param=preset options=preset
@avatar.control.expression app.area.control area=$avatar.area n=2 label="Emotion" operation="avatar.face.expression" param=expression options=expression
@avatar.control.ids app.area.control area=$avatar.area n=3 label="Object IDs" operation="avatar.ids.show" param=mode options=idsMode
@avatar.control.select app.area.control area=$avatar.area n=4 label="Selection" operation="avatar.part.select" param=id options=object
@avatar.control.variant app.area.control area=$avatar.area n=5 label="Look" operation="avatar.part.change" param=variant options=selected target=selected except=face list=ids when=present
@avatar.control.add app.area.control area=$avatar.area n=6 label="Add" operation="avatar.part.add" param=variant options=selected target=selected except=face list=id when=absent
@avatar.control.size app.area.control area=$avatar.area n=7 label="Size" operation="avatar.part.change" param=size options=size target=selected except=face list=ids when=present
@avatar.control.colour app.area.control area=$avatar.area n=8 label="Colour" operation="avatar.part.change" param=colour options=colour target=selected except=face list=ids when=present
@avatar.control.move app.area.control area=$avatar.area n=9 label="Move" operation="avatar.part.move" param=place options=place target=selected except=face list=ids when=present
@avatar.control.remove app.area.control area=$avatar.area n=10 label="Delete" operation="avatar.parts.remove" target=selected except=face list=ids when=present
