@gen.ui.avatar core.note
    text="Generated by scripts/legend-from-dicebear.mjs from DiceBear 10.7.0 (styles 10.6.0); do not edit by hand"

@legend.ui.avatar core.legend
    namespace=ui.avatar
    version=0.2.0
    imports=core
    imports=kids.common
    doc="The avatar: a character drawn by DiceBear (robot = voxel-bot, person = open-peeps, emoji = moods). The types, keys and variants below are the style definitions of the library."

@ui.avatar.character core.type
    extends=core.state
    doc="Which character is shown, its name and the seed that drew it. The world state holds character, name, seed and one object per character style."
    example="Become a person."

@ui.avatar.character.active core.key
    value=atom
    card=one
    ask="Which character are you (robot, person, emoji)?"
    doc="One of: robot, person, emoji."

@ui.avatar.character.name core.key
    value=string
    card=one
    ask="What is your name?"

@ui.avatar.character.seed core.key
    value=string
    card=one
    ask="Which seed drew you?"

@ui.avatar.robot core.type
    extends=core.state
    doc="The robot (DiceBear style voxel-bot, CC0 1.0, by DiceBear). Components: chest, eyes, mouth, top. Colors: background, body, accent, screen, glow."
    example="Make your eyes round."

@ui.avatar.robot.chest core.key
    value=atom
    card=one
    ask="What do you have on your chest?"
    doc="One of: none, buttons, vents, screen, heart, dial, slot."

@ui.avatar.robot.eyes core.key
    value=atom
    card=one
    ask="Which eyes do you have?"
    doc="One of: round, square, visor, cyclops, happy, sleepy, plus."

@ui.avatar.robot.mouth core.key
    value=atom
    card=one
    ask="Which mouth do you have?"
    doc="One of: grill, speaker, line, smile, zigzag."

@ui.avatar.robot.top core.key
    value=atom
    card=one
    ask="What do you have on top?"
    doc="One of: none, antenna, twin, dish, fin, lightbar, studs, siren."

@ui.avatar.robot.backgroundColor core.key
    value=atom
    card=one
    ask="Which color is your background?"
    doc="A 6-digit hex entry of the style palette: b6e3f4, c0aede, d1d4f9, ffd5dc, ffdfbf."

@ui.avatar.robot.bodyColor core.key
    value=atom
    card=one
    ask="Which color is your body?"
    doc="A 6-digit hex entry of the style palette: e9ecef, aeb8c2, 74c0fc, 63e6be, ffd43b, ff9d9d, b6a6f5, 69db7c."

@ui.avatar.robot.accentColor core.key
    value=atom
    card=one
    ask="Which color is your accent?"
    doc="A 6-digit hex entry of the style palette: 343a40, 495057, 2f3b4c, 5f6b7a, 7a4a2d, 243b53."

@ui.avatar.robot.screenColor core.key
    value=atom
    card=one
    ask="Which color is your screen?"
    doc="A 6-digit hex entry of the style palette: 161a21, 101c17, 1a1430, 211016."

@ui.avatar.robot.glowColor core.key
    value=atom
    card=one
    ask="Which color is your glow?"
    doc="A 6-digit hex entry of the style palette: 3bc9db, 69db7c, ffd43b, ff6b6b, e599f7, 74c0fc, fff3bf; never equal to the body color."

@ui.avatar.person core.type
    extends=core.state
    doc="The person (DiceBear style open-peeps, CC0 1.0, by Pablo Stanley). Components: accessories, expression, facialHair, head, mask. Colors: clothing, headContrast, skin."
    example="Make your eyes round."

@ui.avatar.person.accessories core.key
    value=atom
    card=one
    ask="Which accessory do you wear?"
    doc="One of: none, eyepatch, glasses, glasses2, glasses3, glasses4, glasses5, sunglasses, sunglasses2."

@ui.avatar.person.expression core.key
    value=atom
    card=one
    ask="Which expression do you have?"
    doc="One of: angryWithFang, awe, blank, calm, cheeky, concerned, concernedFear, contempt, cute, cyclops, driven, eatingHappy, explaining, eyesClosed, fear, hectic, lovingGrin1, lovingGrin2, monster, old, rage, serious, smile, smileBig, smileLOL, smileTeethGap, solemn, suspicious, tired, veryAngry."

