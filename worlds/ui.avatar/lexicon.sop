    word=mood
    word=look
    word=feeling
    word=variant
    word=kind
    word=type
    word=colour
    word=color
    word=coloured
    word=colored
    word=size
    word=big
    word=small
    word=bigger
    word=smaller
    word=larger
    word=x
    word=left
    word=right
    word=sideways
    word=closer
    word=apart
    word=y
    word=up
    word=down
    word=higher
    word=lower
    word=raise

@lex.ui.avatar.values core.lexicon
    class=modifier
    doc="Values the attributes take (from schema.sop; a colour attribute with no listed values takes the shared colour lexicon)"
    extends=$lex.lang.colour


@lex.ui.avatar.more core.lexicon
    class=modifier
    doc="Comparatives that mean more of an attribute"
    word=bigger
    word=larger
    word=longer
    word=wider

@lex.ui.avatar.less core.lexicon
    class=modifier
    doc="Comparatives that mean less of an attribute"
    word=smaller
    word=tinier
    word=shorter
    word=narrower
