@lex.ui.avatar.attrs core.lexicon
    class=modifier
    doc="Attributes (from schema.sop)"
    word=style
    word=drawn
    word=preset
    word=character
    word=start_from
    word=skin
    word=skin_colour
    word=skin_color
    word=complexion
    word=hair_colour
    word=hair_color
