@lex.ui.avatar.anims core.lexicon
    class=noun
    doc="Little moments (effects, not stored state)."
    word=wink
    word=nod
    word=dance
    word=wave
    word=spin
    word=jump
    word=bounce
    word=wiggle
    word=blink

@lex.ui.avatar.grow core.lexicon
    class=noun
    doc="Size comparatives: bigger, larger, longer, wider = bigger; the rest = smaller (the generic resize operation)."
    word=bigger
    word=larger
    word=longer
    word=wider
    word=smaller
    word=tinier
    word=shorter
    word=narrower

@lex.ui.avatar.moves core.lexicon
    class=noun
    doc="Directions of a move of a part (the SPACE module's words): closer together, apart, higher, lower."
    word=closer
    word=closer_together
    word=together
    word=apart
    word=further_apart
    word=wider_apart
    word=higher
    word=lower
    word=up
    word=down
    word=left
    word=right
