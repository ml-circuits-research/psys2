# ui.avatar as a matrix: how the avatar looks (the character, its parts, its colors) is wires, and the rules say which combinations can exist.
#
# The operations (ops.mjs: the DiceBear characters, the resolution of words to parts, the moods, the offers to become another character) keep working on the
# session state; the library takes the state over as wires after each of them (fns.mjs, `adopt`; `toState` is the way back), so "undo" goes back through the
# library, in the world's words. What the characters can have (which parts and colors each has, every variant and palette entry, the names of colors, which
# spoken part names which color) is the knowledge base (kb.sop, generated by scripts/gen-ui-kb.mjs from the DiceBear lexicons and the tables of ops.mjs).
#   ui.avatar.look    one, once the avatar changed: character (the one that is shown), name, seed, rest (the other keys of the state as JSON: the chips and the
#                     caption the host shows, an offer that waits for a yes, the last look before each change for "why did you turn into ...?")
#   ui.avatar.part    one for each part of each character that was shown or changed: ch, key (eyes, mouth, hair ...), value (a variant id, or none), n (its place)
#   ui.avatar.color   one for each color of such a character: ch, key (body, glow, skin ...), hex, n
# A request that names a color or the color of a part is asked to the rules as a ui.avatar.want wire (fns.mjs, `guard`).

@av.seq core.sequence key=core.seq

@av.k.l.character core.slot of=ui.avatar.look key=character kind=atom required=true
@av.k.l.name core.slot of=ui.avatar.look key=name kind=string required=true
@av.k.l.seed core.slot of=ui.avatar.look key=seed kind=string required=true
@av.k.l.rest core.slot of=ui.avatar.look key=rest kind=blob required=true
@av.k.l.char core.slot of=ui.avatar.look key=char type=ui.avatar.char required=true
@av.k.p.ch core.slot of=ui.avatar.part key=ch kind=atom required=true
@av.k.p.key core.slot of=ui.avatar.part key=key kind=atom required=true
@av.k.p.value core.slot of=ui.avatar.part key=value kind=atom kind=string required=true
@av.k.p.n core.slot of=ui.avatar.part key=n kind=integer required=true
@av.k.p.slot core.slot of=ui.avatar.part key=slot type=ui.avatar.slot required=true
@av.k.c.ch core.slot of=ui.avatar.color key=ch kind=atom required=true
@av.k.c.key core.slot of=ui.avatar.color key=key kind=atom required=true
@av.k.c.hex core.slot of=ui.avatar.color key=hex kind=atom kind=string required=true
@av.k.c.n core.slot of=ui.avatar.color key=n kind=integer required=true
@av.k.w.kind core.slot of=ui.avatar.want key=kind kind=atom enum=colorname enum=paint enum=paintlist required=true
@av.k.w.ch core.slot of=ui.avatar.want key=ch kind=atom
@av.k.w.part core.slot of=ui.avatar.want key=part kind=atom
@av.k.w.key core.slot of=ui.avatar.want key=key kind=atom
@av.k.w.name core.slot of=ui.avatar.want key=name kind=atom
@av.k.w.word core.slot of=ui.avatar.want key=word kind=string

# ---- what the state may be: a character that exists, with the parts and colors it has (a part names the variant of its character and the slot it fills, a color the
# ---- palette entry: the slots of the wires are references, so a look that names something the knowledge base does not have is refused); none only where the
# ---- character can do without it; the glow of a robot is not the color of its body
@av.p3 ui.avatar.part ch=?c key=?k value=none
@av.s3 ui.avatar.slot ch=?c key=?k optional=false
@av.ch3 ui.avatar.char id=?c cap=?cap
@av.d.none core.deny when=$av.p3 when=$av.s3 when=$av.ch3 why="?cap always has something for ?k."

@av.g1 ui.avatar.color ch=?c key=glow hex=?h
@av.g2 ui.avatar.color ch=?c key=body hex=?h
@av.d.glow core.deny when=$av.g1 when=$av.g2 why="The glow of the ?c cannot be the color of its body."

# ---- what a request may name: a color that has a name; a part that has a color to change (asked by `guard`; the want wire is never kept)
@av.w1 ui.avatar.want kind=colorname name=?n word=?w
@av.cn ui.avatar.colorname name=?n
@av.d.colorname core.deny when=$av.w1 not=$av.cn why="I do not know the color ?w."

@av.w2 ui.avatar.want kind=paint part=?p word=?w
@av.pn ui.avatar.partname word=?p
@av.d.partname core.deny when=$av.w2 not=$av.pn why="I do not know what my ?w color is."

@av.w3 ui.avatar.want kind=paintlist ch=?c part=?p word=?w key=?k
@av.pn3 ui.avatar.partname word=?p
@av.pa3 ui.avatar.paint part=?p ch=?c
@av.cp3 ui.avatar.partname word=?p core=true
@av.ch4 ui.avatar.char id=?c cap=?cap
@av.op3 ui.avatar.slot ch=?c key=?k nouns=?n list=?l
@av.d.nocolor.list core.deny when=$av.w3 when=$av.pn3 when=$av.ch4 when=$av.op3 not=$av.pa3 not=$av.cp3 why="?cap has no ?w color. ?n can be ?l."

@av.w4 ui.avatar.want kind=paint ch=?c part=?p word=?w
@av.pn4 ui.avatar.partname word=?p
@av.pa4 ui.avatar.paint part=?p ch=?c
@av.cp4 ui.avatar.partname word=?p core=true
@av.ch5 ui.avatar.char id=?c cap=?cap
@av.d.nocolor core.deny when=$av.w4 when=$av.pn4 when=$av.ch5 not=$av.pa4 not=$av.cp4 why="?cap has no ?w color."
