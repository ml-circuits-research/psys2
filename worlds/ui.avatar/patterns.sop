@pat.ui.avatar.x.name.ask core.pattern
    canonical="What name do you go by?"
    match="[$lang.lead.filler|pls|plz]? [what|wat|whats|what_is|what_are|tell_me|remind_me|remind_me_what|may_i_know|can_i_know|do_you_have|do_u_have|got|have_you_got|how_do_i_call|how_should_i_call|how_do_i_address|how_should_i_address|how_do_people_call|what_do_people_call|so_what_do_people_call|and]? [a|an|the|your|ur|you|u|me]? [name|names|nickname|called|go_by|you_go_by|you_called|are_you_called|r_u_called|people_call_you|address_you|call_you] [again|you|u|go_by|you_go_by|do_you_go_by|is_it|have|you_have|you_got]? [$lang.tail.filler]?"
