@pat.ui.avatar.x.name.set3 core.pattern
    match="[$lang.lead.filler|pls|plz]? [from_now_on|from_today]? {name:word} [is|will_be|shall_be|be] [now]? [your|ur] [new]? [name|nickname] [$lang.tail.filler]?"
