    kind=question
    priority=7
    example="Name?"
    example="Do u have a name?"
    example="How do I call you?"
    example="What name do you go by?"

# ---- ONE AVATAR: the generic operations over the slots of the face (facelogic.mjs). No part is named in a pattern: the words after the verb are read over the data of the catalog.
# On the Avatar tab (tabOnly) the verb alone is enough; anywhere else the sentence must address the avatar ("your", "yourself", "the avatar").

@pat.ui.avatar.add core.pattern
    canonical="Put on a hat."
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [wear|put_on] [me|yourself|myself]? [a|an|the|some|my|your|ur]? {w:rest} [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.add arg.words=\"{w}\""
    kind=request
    tabOnly=true
    tabClaim=true
    priority=6
    example="Add glasses."
    example="Wear a hat."
    example="Give me a beard."
    example="I want sunglasses."

@pat.ui.avatar.add.you core.pattern
    canonical="Give yourself a hat."
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [give_yourself|give_urself|put_on_yourself|dress_yourself_with|grow_yourself|wear|put_on] [a|an|the|some]? {w:rest} [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.add arg.words=\"{w}\""
    kind=request
    priority=9
    example="Give yourself a hat."
    example="Give yourself a beard."

@pat.ui.avatar.add.on core.pattern
    canonical="Put a hat on yourself."
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [put|place|add|stick|draw] [a|an|the|some]? {w:words(4)} [on_yourself|on_your_face|on_your_head|to_yourself|to_your_face|on_the_avatar|on_the_face|to_the_avatar|on_you|on_ur_face]"
    emit="@{_} core.request action=avatar.add arg.words=\"{w}\""
    kind=request
    priority=10
    example="Put a hat on yourself."
    example="Add glasses to your face."

@pat.ui.avatar.remove core.pattern
    canonical="Take off the glasses."
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [take_off|take_out] [your|the|my|that|a|an|ur]? {w:rest} [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.remove arg.words=\"{w}\""
    kind=request
    tabOnly=true
    tabClaim=true
    priority=7
    example="Remove the hat."
    example="Take off the glasses."
    example="Get rid of the beard."

