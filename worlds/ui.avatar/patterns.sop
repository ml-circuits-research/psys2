    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [$lang.lead.polite|i_wish|i_prefer|make_sure]? [the|your|my|ur]? {p:lex.ui.avatar.colorparts} [color|colour]? [should_be|must_be|needs_to_be|need_to_be|has_to_be|have_to_be|to_be|will_be|shall_be|can_be|could_be|should_become|to_become|should_turn|to_turn|should_go|to_go|should_look|is|are|be|becomes|turns|goes]? [a|an]? {c:lex.ui.avatar.colors} [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.setColor arg.part={p} arg.color={c}"
    kind=request
    priority=13
    example="Body color should be red."
    example="I want the body colour to be blue."
    example="Your background must be dark gray."
    example="Hair colour green."

@pat.ui.avatar.color.adj core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [give_yourself|give_me|have|get|wear|use|show_me|pick|choose|i_want|i_would_like|try|make|make_yourself|make_me|i_need|gimme|i_wanna|i_wana]? [a|an|the|your|my|ur]? {c:lex.ui.avatar.colors} {p:lex.ui.avatar.colorparts} [color|colour]? [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.setColor arg.part={p} arg.color={c}"
    kind=request
    priority=14
    example="Give yourself a light green screen."
    example="Red body colour."
    example="I want a blue background colour."
    example="Blue eyes."
    example="I want a dark gray background."

@pat.ui.avatar.x.color.partfirst core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite|can|could]? [make|turn|paint|color|colour|set]? [your|ur|the]? {p:lex.ui.avatar.colorparts} [color|colour]? [to|into|be|become|go|in|a|an|to_be|looking]? {c:lex.ui.avatar.colors} [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.setColor arg.part={p} arg.color={c}"
    kind=request
