    priority=12
    example="You are called Ziggy."

@pat.ui.avatar.anim core.pattern
    canonical="Can you dance?"
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? {a:lex.ui.avatar.anims} [$lang.tail.filler|at_me|a_little|twice]? [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.animate arg.anim={a}"
    kind=request
    priority=11
    example="Wave at me."
    example="Can you dance?"
    example="Wink."

@pat.ui.avatar.anim.give core.pattern
