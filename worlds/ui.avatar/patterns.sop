    canonical="Take off your glasses."
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [remove|take_off|take_away|take_out|lose|drop|hide|get_rid_of|ditch] [your|ur|yourself_of_your] {w:rest} [$lang.tail.filler]?"
