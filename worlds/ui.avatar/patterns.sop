@pat.ui.avatar.x.color.ask3 core.pattern
    match="[$lang.lead.filler|pls|plz]? {p:lex.ui.avatar.colorparts} [color|colour|shade] [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.askColor arg.part={p}"
    kind=question
    priority=8
    example="Body colour pls."

@pat.ui.avatar.setpart.noun_first core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite|u_should|u_can|you_can]? [$lang.lead.polite|gimme]? [your|the|my|ur|a|an]? {p:lex.ui.avatar.parts} [to|as|into|like|be|should_be|to_be|with]? [a|an|the]? {v:lex.ui.avatar.options} {n:number?} [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.setPart arg.part={p} arg.value={v} arg.n={n} arg.text=\"{v}\""
    kind=request
    priority=11
    example="Mouth grill please."
    example="I want your mouth as a grill."
    example="Eyes visor."

@shape.ui.avatar.colour core.shape
    family=set
    verb="make|turn|paint|color|colour|change|set|dye|tint"
    obj="p:lex.ui.avatar.colorparts"
    val="c:lex.ui.avatar.colors"
    noun="color|colour"
    emit="@{_} core.request action=avatar.setColor arg.part={p} arg.color={c}"
    det="your|the|ur|my"
    objmod="whole|entire|full|complete"
    sample="p=eyes;c=blue"
    priority=14
    example="Make your eyes blue."

@shape.ui.avatar.colour.ask core.shape
    family=ask.value
    obj="p:lex.ui.avatar.colorparts"
    noun="color|colour|shade|tint|hue"
    emit="@{_} core.request action=avatar.askColor arg.part={p}"
    det="your|the|ur|my"
    sample="p=eyes"
    priority=12
    example="What colour are your eyes?"

@shape.ui.avatar.size core.shape
    family=set
    verb="make|turn|get|have"
    obj="p:lex.ui.avatar.parts"
    val="s:lex.ui.avatar.size"
    emit="@{_} core.request action=avatar.resizePart arg.part={p} arg.dir={s}"
    det="your|the|ur|my"
    mod="$ui.avatar.g11_a_bit"
    sample="p=eyes;s=bigger"
    priority=13
    example="Make your eyes bigger."

@shape.ui.avatar.part core.shape
    family=set
    verb="change|make|set|switch|turn|swap|wear|put_on|use|try"
    obj="p:lex.ui.avatar.parts"
    val="v:lex.ui.avatar.options"
    extra="n:number?"
    emit="@{_} core.request action=avatar.setPart arg.part={p} arg.value={v} arg.n={n} arg.text=\"{v}\""
    det="your|the|ur|my"
    sample="p=antenna;v=dish"
    priority=12
    example="Change your antenna to a dish."

@shape.ui.avatar.gender core.shape
    family=set
    verb="make|turn|transform|change|convert|morph|switch|set|turn_into|change_into|transform_into"
    obj="o:lex.ui.avatar.self"
    val="g:lex.ui.avatar.gender"
    link="to|into|be|as|in|like|to_be"
    emit="@{_} core.request action=avatar.setCharacter arg.who=person arg.kind={g}"
    det="the|your|my|ur|this"
    forms="imp,wish,ind"
    sample="o=avatar;g=woman"
    priority=15
    example="Make the avatar a woman."

@pat.ui.avatar.gender.be core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [become|be|turn_into|change_into|transform_into|switch_to|morph_into|look_like|i_want_to_be|i_wanna_be|i_want_you_to_be|you_should_be|be_like|show_me|i_want_to_see|make_me|make_yourself|give_me|i_want] [a|an|the]? {m:lex.ui.avatar.moods?} {g:lex.ui.avatar.gender} [avatar|face|character|look|version]? [$lang.tail.filler|instead|again]? [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.setCharacter arg.who=person arg.kind={g} arg.mood={m}"
    kind=request
    priority=15
    example="Become a woman."
    example="I want to be a happy man."

@pat.ui.avatar.gender.make core.pattern
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [make|create|build|give|get|turn|show|let_me_see] [me|us|yourself|the_avatar|my_avatar]? [a|an|the|my|your|ur]? {m:lex.ui.avatar.moods?} {g:lex.ui.avatar.gender} [avatar|face|character|version|one]? [$lang.tail.filler|instead]? [$lang.tail.filler]?"
    emit="@{_} core.request action=avatar.setCharacter arg.who=person arg.kind={g} arg.mood={m}"
    kind=request
    priority=15
    tabOnly=true
    example="Make a happy man."

@shape.ui.avatar.reset core.shape
    family=do
    verb="reset|restore|clear"
    obj="p:lex.ui.avatar.parts"
    det="your|the|ur"
    forms=imp,wish,ind,q
    sample="p=eyes"
    emit="@{_} core.request action=avatar.resetPart arg.part={p}"
    priority=12
    example="Reset your eyes."

@shape.ui.avatar.has core.shape
    family=ask.exists
    verb="have|got|wearing|wear|sporting"
    pron="you|u|ya"
    obj="v:lex.ui.avatar.options"
    sample="v=glasses"
    emit="@{_} core.request action=avatar.hasThing arg.value={v} arg.text=\"{v}\""
    priority=12
    skip=short
    example="Do you have glasses?"
