@pat.ui.avatar.name.set core.pattern
    canonical="Rename yourself to Pixel."
    match="[$lang.lead.filler|pls|plz]? [$lang.lead.polite]? [call_yourself|rename_yourself|name_yourself|rename_yourself_to|name_yourself_as|rename_yourself_as] {name:rest} [$lang.tail.filler|from_now_on|from_now|from_today|from_here_on|please]?"
    emit="@{_} core.request action=avatar.setName arg.name=\"{name}\""
    kind=request
    priority=12
    example="Call yourself Robi."
    example="Rename yourself to Pixel."

@pat.ui.avatar.name.set2 core.pattern
    canonical="I will call you Robi."
    match="[$lang.lead.filler|pls|plz]? [i_will_call_you|i_am_calling_you|i_call_you|we_will_call_you|i_am_going_to_call_you|from_now_on_i_will_call_you|call_you] {name:rest} [$lang.tail.filler|from_now_on|from_now|from_today|from_here_on|please]?"
    emit="@{_} core.request action=avatar.setName arg.name=\"{name}\""
    kind=request
    priority=12
    example="I will call you Robi."

@pat.ui.avatar.name.set3 core.pattern
    match="[$lang.lead.filler|pls|plz]? [from_now_on]? [your|ur] name [is|will_be|shall_be] {name:rest} [$lang.tail.filler|from_now_on|from_now|from_today|from_here_on|please]?"
    emit="@{_} core.request action=avatar.setName arg.name=\"{name}\""
    kind=request
    priority=12
    example="Your name is Robi."
    example="From now on your name is Pixel."

@pat.ui.avatar.name.set4 core.pattern
    match="[$lang.lead.filler|pls|plz]? [from_now_on]? [you|u] [are|r] [called|named] {name:rest} [$lang.tail.filler|from_now_on|from_now|from_today|from_here_on|please]?"
