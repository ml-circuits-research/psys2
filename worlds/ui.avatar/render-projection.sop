# ui.avatar render projection (authored). Derives drawing primitives from the live w.face instance and the
# k.faces geometry: the shown variant (an expression replaces mouth, eyebrows and eyes), the slot box transform,
# mirrored slots, polygon points, one fill per primitive and arc/triangle orientation. A renderer draws these
# facts as they are; it makes no decision of its own.
@draw.type core.type of=ui.avatar.draw
@shown.type core.type of=ui.avatar.shown
@override.type core.type of=ui.avatar.override
@point.type core.type of=ui.avatar.point
@fill.type core.type of=ui.avatar.fill
@colour.type core.type of=ui.avatar.colour
@base.type core.type of=ui.avatar.base
@named.type core.type of=ui.avatar.named

# Expression variants replace the part's own variant while the face holds the expression.
@ov.face w.face.face expression=?e style=?style
@ov.mouth.part w.face.mouth face=$ov.face
@ov.mouth.k k.faces.expression name=?e style=?style mouth=?v
@ov.mouth.o ui.avatar.override part=$ov.mouth.part variant=?v
@ov.mouth core.rule when=$ov.face when=$ov.mouth.part when=$ov.mouth.k then=$ov.mouth.o
@ov.brows.part w.face.eyebrows face=$ov.face
@ov.brows.k k.faces.expression name=?e style=?style eyebrows=?v
@ov.brows.o ui.avatar.override part=$ov.brows.part variant=?v
@ov.brows core.rule when=$ov.face when=$ov.brows.part when=$ov.brows.k then=$ov.brows.o
@ov.eyes.part w.face.eyes face=$ov.face
@ov.eyes.k k.faces.expression name=?e style=?style eyes=?v
@ov.eyes.o ui.avatar.override part=$ov.eyes.part variant=?v
@ov.eyes core.rule when=$ov.face when=$ov.eyes.part when=$ov.eyes.k then=$ov.eyes.o

# The variant shown for each part, with its placement keys.
@sh.face w.face.face style=?style
@sh.part w.face.part kind=?kind variant=?own size=?k x=?dx y=?dy face=$sh.face
@sh.slot w.face.slot part=?kind slot=?slot
@sh.over ui.avatar.override part=$sh.part variant=?v
@sh.overAny ui.avatar.override part=$sh.part
@sh.own.o ui.avatar.shown part=$sh.part slot=?slot style=?style variant=?own k=?k dx=?dx dy=?dy
@sh.over.o ui.avatar.shown part=$sh.part slot=?slot style=?style variant=?v k=?k dx=?dx dy=?dy
@shown.own core.rule when=$sh.face when=$sh.part when=$sh.slot not=$sh.overAny then=$sh.own.o
@shown.over core.rule when=$sh.face when=$sh.part when=$sh.slot when=$sh.over then=$sh.over.o

# Primitives: each shape of the shown variant, scaled about its slot box centre and moved.
@pr.shown ui.avatar.shown part=?part slot=?slot style=?style variant=?v k=?k dx=?dx dy=?dy
@pr.box k.faces.slot style=?style name=?slot x=?sx y=?sy w=?sw h=?sh z=?order
@pr.kp k.faces.part slot=?slot of=?v shape=?shape x=?x y=?y w=?w h=?h z=?z
@pr.hw core.calc out=?hw fn=div args=?sw args=2
@pr.hh core.calc out=?hh fn=div args=?sh args=2
@pr.cx core.calc out=?cx fn=add args=?sx args=?hw
@pr.cy core.calc out=?cy fn=add args=?sy args=?hh
@pr.tx core.calc out=?tx fn=add args=?cx args=?dx
@pr.ty core.calc out=?ty fn=add args=?cy args=?dy
@pr.o ui.avatar.draw part=?part source=$pr.kp slot=?slot order=?order z=?z shape=?shape x=?x y=?y w=?w h=?h cx=?cx cy=?cy tx=?tx ty=?ty scale=?k side=left
@project core.rule when=$pr.shown when=$pr.box when=$pr.kp with=$pr.hw with=$pr.hh with=$pr.cx with=$pr.cy with=$pr.tx with=$pr.ty then=$pr.o
# A mirrored slot draws the same shapes a second time, flipped about the face's middle.
@mi.box k.faces.slot style=?style name=?slot x=?sx y=?sy w=?sw h=?sh z=?order mirror=true
@mi.o ui.avatar.draw part=?part source=$pr.kp slot=?slot order=?order z=?z shape=?shape x=?x y=?y w=?w h=?h cx=?cx cy=?cy tx=?tx ty=?ty scale=?k side=right
@project.mirror core.rule when=$pr.shown when=$mi.box when=$pr.kp with=$pr.hw with=$pr.hh with=$pr.cx with=$pr.cy with=$pr.tx with=$pr.ty then=$mi.o

# Points of polygons and lines.
@pt.draw ui.avatar.draw source=?src
@pt.k k.faces.point part=?src n=?n x=?x y=?y
@pt.o ui.avatar.point source=?src n=?n x=?x y=?y
@points core.rule when=$pt.draw when=$pt.k then=$pt.o

# Colours. A tinted shape takes the face colour its tint names; a part colour the shape offers comes next;
# otherwise the shape's own rgb, else its first colour name.
@co.skin.kp k.faces.part tint=skin
@co.skin.draw ui.avatar.draw part=?part source=$co.skin.kp
@co.skin.face w.face.face skin=?n
@co.skin.c k.faces.colour of=skin name=?n rgb=?rgb
@co.skin.o ui.avatar.colour source=$co.skin.kp part=?part fill=?rgb
@fill.skin core.rule when=$co.skin.kp when=$co.skin.draw when=$co.skin.face when=$co.skin.c then=$co.skin.o
@co.skin_shade.kp k.faces.part tint=skin_shade
@co.skin_shade.draw ui.avatar.draw part=?part source=$co.skin_shade.kp
@co.skin_shade.face w.face.face skin=?n
@co.skin_shade.c k.faces.colour of=skin name=?n shade=?rgb
@co.skin_shade.o ui.avatar.colour source=$co.skin_shade.kp part=?part fill=?rgb
@fill.skin_shade core.rule when=$co.skin_shade.kp when=$co.skin_shade.draw when=$co.skin_shade.face when=$co.skin_shade.c then=$co.skin_shade.o
@co.hair.kp k.faces.part tint=hair
@co.hair.draw ui.avatar.draw part=?part source=$co.hair.kp
@co.hair.face w.face.face hair_colour=?n
@co.hair.c k.faces.colour of=hair name=?n rgb=?rgb
@co.hair.o ui.avatar.colour source=$co.hair.kp part=?part fill=?rgb
@fill.hair core.rule when=$co.hair.kp when=$co.hair.draw when=$co.hair.face when=$co.hair.c then=$co.hair.o
@co.hair_shade.kp k.faces.part tint=hair_shade
@co.hair_shade.draw ui.avatar.draw part=?part source=$co.hair_shade.kp
@co.hair_shade.face w.face.face hair_colour=?n
@co.hair_shade.c k.faces.colour of=hair name=?n shade=?rgb
@co.hair_shade.o ui.avatar.colour source=$co.hair_shade.kp part=?part fill=?rgb
@fill.hair_shade core.rule when=$co.hair_shade.kp when=$co.hair_shade.draw when=$co.hair_shade.face when=$co.hair_shade.c then=$co.hair_shade.o
@co.eyes.kp k.faces.part tint=eyes
@co.eyes.draw ui.avatar.draw part=?part source=$co.eyes.kp
@co.eyes.face w.face.face eye_colour=?n
@co.eyes.c k.faces.colour of=eyes name=?n rgb=?rgb
@co.eyes.o ui.avatar.colour source=$co.eyes.kp part=?part fill=?rgb
@fill.eyes core.rule when=$co.eyes.kp when=$co.eyes.draw when=$co.eyes.face when=$co.eyes.c then=$co.eyes.o
@co.clothes.kp k.faces.part tint=clothes
@co.clothes.draw ui.avatar.draw part=?part source=$co.clothes.kp
@co.clothes.face w.face.face clothes=?n
@co.clothes.c k.faces.colour of=clothes name=?n rgb=?rgb
@co.clothes.o ui.avatar.colour source=$co.clothes.kp part=?part fill=?rgb
@fill.clothes core.rule when=$co.clothes.kp when=$co.clothes.draw when=$co.clothes.face when=$co.clothes.c then=$co.clothes.o
@co.clothes_shade.kp k.faces.part tint=clothes_shade
@co.clothes_shade.draw ui.avatar.draw part=?part source=$co.clothes_shade.kp
@co.clothes_shade.face w.face.face clothes=?n
@co.clothes_shade.c k.faces.colour of=clothes name=?n shade=?rgb
@co.clothes_shade.o ui.avatar.colour source=$co.clothes_shade.kp part=?part fill=?rgb
@fill.clothes_shade core.rule when=$co.clothes_shade.kp when=$co.clothes_shade.draw when=$co.clothes_shade.face when=$co.clothes_shade.c then=$co.clothes_shade.o
@co.paint.kp k.faces.part colour=?c
@co.paint.part w.face.part colour=?c
@co.paint.draw ui.avatar.draw part=$co.paint.part source=$co.paint.kp
@co.paint.o ui.avatar.colour source=$co.paint.kp part=$co.paint.part fill=?c
@fill.paint core.rule when=$co.paint.kp when=$co.paint.part when=$co.paint.draw then=$co.paint.o
@co.own.kp k.faces.part rgb=?rgb
@co.own.draw ui.avatar.draw part=?part source=$co.own.kp
@co.own.chosen ui.avatar.colour source=$co.own.kp part=?part
@co.own.o ui.avatar.base source=$co.own.kp part=?part fill=?rgb
@fill.own core.rule when=$co.own.kp when=$co.own.draw not=$co.own.chosen then=$co.own.o
@co.name.kp k.faces.part colour=?c
@co.name.draw ui.avatar.draw part=?part source=$co.name.kp
@co.name.chosen ui.avatar.colour source=$co.name.kp part=?part
@co.name.base ui.avatar.base source=$co.name.kp part=?part
@co.name.o ui.avatar.named source=$co.name.kp part=?part fill=?c
@fill.name core.rule when=$co.name.kp when=$co.name.draw not=$co.name.chosen not=$co.name.base then=$co.name.o
@co.pick.c ui.avatar.colour source=?src part=?part fill=?f
@co.pick.o ui.avatar.fill source=?src part=?part fill=?f
@fill.chosen core.rule when=$co.pick.c then=$co.pick.o
@co.pick.b ui.avatar.base source=?src part=?part fill=?f
@fill.base core.rule when=$co.pick.b then=$co.pick.o
@co.pick.n ui.avatar.named source=?src part=?part fill=?f
@fill.named core.rule when=$co.pick.n then=$co.pick.o

# Orientation of arcs and triangles, when the shape declares one.
@or.type core.type of=ui.avatar.orient
@or.kp k.faces.part opens=?o
@or.draw ui.avatar.draw source=$or.kp
@or.o ui.avatar.orient source=$or.kp opens=?o
@orient.opens core.rule when=$or.kp when=$or.draw then=$or.o
@or.pt.kp k.faces.part pointing=?p
@or.pt.draw ui.avatar.draw source=$or.pt.kp
@or.pt.o ui.avatar.orient source=$or.pt.kp pointing=?p
@orient.pointing core.rule when=$or.pt.kp when=$or.pt.draw then=$or.pt.o
