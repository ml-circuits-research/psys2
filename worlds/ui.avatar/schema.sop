    word=rima_oris

@face.moustache acts.kind
    plural=moustaches
    word=mustache

@face.nose acts.kind
    plural=noses
    word=olfactory_organ

@face.eyes acts.kind
    plural=eyes
    word=eye

@face.eyebrows acts.kind
    plural=eyebrows
    word=eyebrow

@face.glasses acts.kind
    plural=glasses
    word=sunglasses
    word=spectacles
