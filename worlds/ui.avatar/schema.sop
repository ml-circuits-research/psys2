@face acts.schema
    noun="face"
    doc="The avatar's face: one kind per slot of the knowledge world k.faces, generated by scripts/build-avatar-schema.mjs. The effects (variants, presets, expressions, size and place) are the face logic over the catalog (hooks.mjs)."
    hooks=hooks.mjs
    acts=make
    acts=remove
    acts=change
    acts=place
    acts=ask
    acts=undo
    acts=redo
    acts=save
    acts=load
    own=animate:avatar.animate
    own=setName:avatar.setName
    own=askName:avatar.askName
    own=nameOf:avatar.nameOf
    own=setPartUnknown:avatar.setPartUnknown
    sample=hat
    self=yes
    be=yes
    has=yes
    dir=yes
    bare=yes
    name=yes
    limit.items=40
    limit.history=40

@face.hair_back acts.kind
    plural=hair_backs
    word=hair
    word=long_hair

@face.shoulders acts.kind
    plural=shoulders
    word=clothes

@face.neck acts.kind
    plural=necks
    word=cervix

@face.ears acts.kind
    plural=ears
    word=ear

@face.head acts.kind
    plural=heads
    word=head_shape
    word=caput

@face.cheeks acts.kind
    plural=cheeks
    word=blush
    word=freckles

@face.beard acts.kind
    plural=beards
    word=face_fungus
    word=whiskers

@face.mouth acts.kind
