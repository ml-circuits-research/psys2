    word=eyeglasses

@face.hair_front acts.kind
    plural=hair_fronts
    word=hair
    word=fringe

@face.earrings acts.kind
    plural=earrings
    word=earring

@face.hat acts.kind
    plural=hats
    word=cap
    word=crown
    word=helmet
    word=chapeau
    word=lid

@face.moment acts.kind
    plural=moments
    word=wink
    word=nod
    word=dance
    word=wave
    word=spin
    word=jump
    word=bounce
    word=wiggle
    word=blink

@face.colour acts.attr
    of=hair_back
    of=shoulders
    of=neck
    of=ears
    of=head
    of=cheeks
    of=beard
    of=mouth
    of=moustache
    of=nose
    of=eyes
    of=eyebrows
    of=glasses
    of=hair_front
    of=earrings
    of=hat
    type=colour
    word=color

@face.size acts.attr
    of=hair_back
    of=shoulders
    of=neck
    of=ears
    of=head
    of=cheeks
    of=beard
    of=mouth
    of=moustache
    of=nose
    of=eyes
    of=eyebrows
    of=glasses
    of=hair_front
    of=earrings
    of=hat
    type=number
    min=0.6
    max=1.5
    default=1
    more=bigger
    more=larger
    more=longer
    more=wider
    less=smaller
    less=tinier
    less=shorter
    less=narrower
