@gen.ui.avatar.note core.note
    text="Generated from schema.sop by scripts/build-schema-world.mjs (spec 21). Never edited by hand; tests/acts.test.mjs fails when it is stale."

@tpl.ui.avatar.make core.template
    for=action.ui.avatar.make
    text="{note}"

@tpl.ui.avatar.remove core.template
    for=action.ui.avatar.remove
    text="{note}"

@tpl.ui.avatar.change core.template
    for=action.ui.avatar.change
    text="{note}"

@tpl.ui.avatar.place core.template
    for=action.ui.avatar.place
    text="{note}"

@tpl.ui.avatar.send core.template
    for=action.ui.avatar.send
    text="{note}"

@tpl.ui.avatar.pick core.template
    for=action.ui.avatar.pick
    text="{note}"

@tpl.ui.avatar.copy core.template
    for=action.ui.avatar.copy
    text="{note}"

@tpl.ui.avatar.ask core.template
    for=action.ui.avatar.ask
    text="{note}"

@tpl.ui.avatar.undo core.template
    for=action.ui.avatar.undo
    text="{note}"

@tpl.ui.avatar.redo core.template
    for=action.ui.avatar.redo
    text="{note}"

@tpl.ui.avatar.save core.template
    for=action.ui.avatar.save
    text="{note}"

@tpl.ui.avatar.load core.template
    for=action.ui.avatar.load
    text="{note}"
