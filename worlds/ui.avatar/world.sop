@world.ui.avatar core.world
    namespace=ui.avatar
    version=0.3.0
    legend=$legend.ui.avatar
    imports=world.core
    imports=world.kids.common
    formalization=rules
    ambient=true
    undo=ui.avatar.undo
    redo=ui.avatar.redo
    imports=world.acts
    imports=world.lang.common
    source="how I look"
    language=en
    status=fixture
    title="Avatar"
    tab=avatar
    tabTitle="Avatar"
    tabOrder=100
    summary="change my face"
    doc="The fifth permanent editor tab: one face drawn from knowledge-world parts, variants, presets and expressions. A full canvas and inspector expose native part, size, position, colour and expression tools; keyboard and mouse address the same ui.avatar instance. Shared colour roles explicitly name every affected part. The slot and variant vocabulary comes from the loaded catalog; unsupported drawings are not offered. Native controls capture typed SOP intent and actual effects without a language-parser fallback. Platform fixture, not produced by the C1 workflow."

# Typed needs (sopworld 0.39.0, std.schema.needs): what the catalog must have loaded before an operation of this world runs. The host loads them (src/dialog/knowledge-lookup.mjs, needsOf) before the operations of a reading.
@need.ui.avatar.faces std.schema.needs
    of=ui.avatar
    type=k.faces.variant
    from=k.faces
