@describe.capabilities core.describe
    op=chat.capabilities
    intent=command
    emit="@{_} core.request action=chat.capabilities"
    priority=14
    kind=question
    frames=phr
    frames=imp

@describe.capabilities.en core.describe.words
    of=$describe.capabilities
    lang=en
    phrase=$phrase.lang.intent.capabilities
    verb=$w.en.show.chat.capabilities
    verb=$w.en.list.chat.capabilities
    verb=$w.en.tell.chat.capabilities
    noun=$w.en.abilities.chat.capabilities
    noun=$w.en.capabilities.chat.capabilities
    noun=$w.en.skills.chat.capabilities
    noun=$w.en.features.chat.capabilities

