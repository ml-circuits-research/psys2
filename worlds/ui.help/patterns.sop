    example="How to play?"
    example="Explain the rules."

@pat.ui.help.game3 core.pattern
    canonical="How do I play hangman?"
    match="how [do|can|would|should] [i|we|you] play [the|a|some|an]? {g:lex.ui.help.games} [game]?"
    emit="@{_} core.request action=ui.helpGame arg.game={g}"
    kind=question
    priority=13
    example="How do I play hangman?"
    example="How do I play tic tac toe?"
    example="How can I play chess?"

@pat.ui.help.game4 core.pattern
    canonical="Explain the rules of chess."
    match="[what_are|tell_me|explain|show_me|what_is_the_goal_of|how_does_it_work_in] [the]? [rules|rules_of|rules_for|goal_of|game] [of|for]? [the]? {g:lex.ui.help.games} [game]?"
