@tpl.ui.help.capabilities core.template
    for=action.chat.capabilities
    text="I can {value}. Ask me \"what can I say here?\" for examples."

@tpl.ui.help.capabilities.unsupported core.template
    for=action.chat.capabilities
    status=unsupported
    text="{note}"

@tpl.ui.help.capabilities.missing core.template
    for=action.chat.capabilities
    status=missing
    text="{note}"

