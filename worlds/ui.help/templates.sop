@tpl.ui.help.capabilities core.template
    for=action.chat.capabilities
    text="I can {value}. Ask me \"what can I say here?\" for examples."

@tpl.ui.help.help core.template
    for=action.ui.help
    text="{value}"

@tpl.ui.help.helpMe core.template
    for=action.ui.helpMe
    text="{value}"

@tpl.ui.help.helpMore core.template
    for=action.ui.helpMore
    text="{value}"

@tpl.ui.help.helpAbout core.template
    for=action.ui.helpAbout
    text="{value}"

@tpl.ui.help.helpGame core.template
    for=action.ui.helpGame
    text="{value}"

@tpl.ui.help.helpHow core.template
    for=action.ui.helpHow
    text="{value}"

@tpl.ui.help.helpWhy core.template
    for=action.ui.helpWhy
    text="{value}"
