@lex.ui.shell.declaredtabs core.lexicon
    class=noun
    doc="Names and aliases of the tabs that other worlds declare in their manifests (spec 07 section 6); the shell opens them by name. Unknown names are refused politely by ui.openTab."
    word=chess
    word=chess_board
    word=chessboard
    word=chess_game
    word=drawing
    word=drawing_board
    word=paint
    word=reader
    word=document_reader
    word=my_documents
    word=library
    word=picture
    word=canvas
    word=chart
    word=graph
    word=map
    word=world_map
    word=atlas
    word=music
    word=piano
    word=keyboard
    word=sheet_music
    word=profile
    word=my_profile
    word=about_me
    word=cv
    word=resume
    word=my_cv

@lex.ui.shell.playtabs core.lexicon
    class=noun
    doc="Declared tabs that can be started with play: the chess game and the drawing, charts and map tabs (music and piano belong to the music world: play piano plays notes)."
    word=chess
    word=chess_board
    word=chessboard
    word=chess_game
    word=drawing
    word=drawing_board
    word=paint
    word=picture
    word=canvas
    word=chart
    word=graph
    word=map
    word=world_map
    word=atlas

@lex.ui.shell.langs core.lexicon
    class=noun
    word=english
    word=romanian

@lex.ui.shell.triggers core.lexicon
    class=trigger
    word=tab
    word=speaker
    word=listening
    word=hands-free
    word=slower
    word=faster
    word=microphone
    word=mute

@lex.ui.shell.gametabs core.lexicon
    class=noun
    doc="Game tabs that a bare game name (hangman pls, hangman game) starts. Same entries as the game words of ui.shell.tabs."
    word=hangman
    plural=hangman:hangmen
    word=tic_tac_toe
    word=tictactoe
    word=tic-tac-toe
    word=noughts_and_cross
    word=guess
    word=guess_the_animal
    word=guessing_game
