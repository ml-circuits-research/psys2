@pat.ui.shell.open core.pattern
    match="[can_you|could_you|will_you|would_you|please_can_you]? [open|show|display|bring_up|go_to|switch_to|take_me_to|jump_to|select|view|show_me|open_up] [me]? [the|my|your]? {tab:lex.ui.shell.tabs} [tab|page|screen|panel|window]?"
    emit="@{_} core.request action=ui.openTab arg.tab={tab}"
    kind=request
    priority=10
    example="Open the editor."
    example="Show me the robot."
    example="Go to the hangman tab."

@pat.ui.shell.play core.pattern
    match="[let_us|i_want_to|i_would_like_to|can_we|could_we|shall_we|we_could|can_you|could_you|will_you|i_wanna|lets]? [play|start|begin|launch|have] [a|an|the|some|a_game_of|a_round_of|the_game_of|another_game_of]? {tab:lex.ui.shell.tabs} [game|again]?"
    emit="@{_} core.request action=ui.playGame arg.tab={tab}"
    kind=request
    priority=11
    example="Let's play tic tac toe."
    example="Play hangman."
    example="Can we play twenty questions?"

@pat.ui.shell.play20 core.pattern
    match="[let_us|i_want_to|i_would_like_to|can_we|could_we|shall_we|we_could|can_you|could_you|will_you|i_wanna|lets]? [play|start|begin|have] [a|the|a_game_of|the_game_of]? 20 [questions|question] [game]?"
    emit="@{_} core.request action=ui.playGame arg.tab=guess"
    kind=request
    priority=11
    example="Can we play twenty questions?"

@pat.ui.shell.open20 core.pattern
