@pat.ui.shell.settings.close core.pattern
    canonical="Close settings."
    match="[$lang.lead.filler|pls|plz]? [$ui.shell.g5_can_u]? [close|hide|dismiss|exit|leave|shut|shut_down] [the|my]? [settings|preferences] [dialog|window|panel|screen|page]? [$ui.shell.g4_pls]?"
    emit="@{_} core.request action=ui.settings arg.what=close"
    kind=request
    priority=14
    example="Close settings."
    example="Please close the settings window."

@pat.ui.shell.lis.off5 core.pattern
    canonical="Stop microphone."
    match="[$lang.lead.filler|pls|plz]? [$ui.shell.g5_can_u]? [$lang.stop.mic] [$ui.shell.g4_pls]?"
    emit="@{_} core.request action=ui.listening arg.on=false"
    kind=request
    priority=12
    example="Stop the mic."
    example="Mic off."
    example="That's all."
