    input="Open the editor"
    expectState="activeTab=editor"
    session=s3

@t.ui.shell.n22 core.test
    input="What can I say here?"
    expect="On the Editor tab"
    session=s3

@t.ui.shell.n23 core.test
    input="Open the hangman tab"
