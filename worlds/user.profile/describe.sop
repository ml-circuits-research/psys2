@describe.start core.describe
    op=prof.start
    intent=command
    emit="@{_} core.request action=prof.start"
    frames=ask
    skip=short
    priority=12
    kind=request
    effect="starts or resumes the get-to-know-me interview"

@describe.start.en core.describe.words
    of=$describe.start
    lang=en
    ask=$w.en.interview_me.prof.start
    ask=$w.en.ask_me_something.prof.start
    ask=$w.en.ask_me_a_question.prof.start
    ask=$w.en.ask_me_anything.prof.start
    ask=$w.en.ask_me_some_questions.prof.start
    ask=$w.en.get_to_know_me.prof.start
    ask=$w.en.lets_get_to_know_me.prof.start
    ask=$w.en.start_the_interview.prof.start
    ask=$w.en.begin_the_interview.prof.start
    ask=$w.en.resume_the_interview.prof.start
    ask=$w.en.play_the_get_to_know_me_game.prof.start
    example="Interview me."

