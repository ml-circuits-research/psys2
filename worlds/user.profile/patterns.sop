@pat.user.profile.role.org core.pattern
    match="[$user.profile.g4_i_am] [a|an]? {r:lex.user.profile.roles} [at|for|with] {o:words(4)}"
    emit="@{_} core.request action=prof.tell arg.kind=role arg.role={r} arg.org=\"{o}\""
    kind=request
    priority=10
    example="I am a software engineer at Acme."
    example="I work as a nurse for the city hospital."

@pat.user.profile.role core.pattern
    canonical="I work as a designer."
    match="[$user.profile.g4_i_am] [a|an]? {r:lex.user.profile.roles}"
    emit="@{_} core.request action=prof.tell arg.kind=role arg.role={r}"
    kind=request
    priority=10
    example="I am a nurse."
    example="My job is teacher."
    example="I work as a designer."

@pat.user.profile.rolefield core.pattern
