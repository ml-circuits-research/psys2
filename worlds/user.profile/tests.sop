@t.user.profile.m01 core.test
    session=pm1
    input="I am 12 years old."
    expect="12 years old"
    expectState="fields.age.v=12"
    reasoner=matrix
    doc="SOPWORLD stage 2: the facts are wires of the library; facts that cannot both be true are refused with the reason and the user is asked which is right"

@t.user.profile.m02 core.test
    session=pm1
    input="I've been teaching for 20 years."
    expect="That does not add up. You said you are 12 years old, but also that you have been working for 20 years. Which one is right?"
    expectStatus=conflicting
    expectState="fields.age.v=12"
    expectState="counts.known=1"
    reasoner=matrix

